commands:
{
    cm = tools:/scripts/cm
    gnss = tools:/bin/gnss
    fwupdate = tools:/bin/fwupdate
    pm = tafTools:/bin/pm
}

bindings:
{
    <c2c>.taf_update -> tafUpdateSvc.taf_update
    <c2c>.taf_appMgmt -> tafUpdateSvc.taf_appMgmt
    <c2c>.taf_fwupdate -> tafUpdateSvc.taf_fwupdate
    <c2c>.taf_dcs -> tafDataCallSvc.taf_dcs
}

interfaceSearch:
{
    $TELAF_ROOT/interfaces
    $TELAF_ROOT/interfaces/tafVNW
    $TELAF_ROOT/apps/tafMngdServices/interfaces
    interfaces/positioning
    $LEGATO_ROOT/apps/sample/voiceCallApp
    // $TELAF_ROOT/apps/test/tafPMTest/tafPMIntgTest
}

cflags:
{
    -DTARGET_SA525M
}

cxxflags:
{
    -DTARGET_SA525M
}
