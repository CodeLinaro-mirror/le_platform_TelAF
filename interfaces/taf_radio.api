);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for cell info change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER CellInfoChangeHandler
(
    CellInfoStatus cellStatus IN,  ///< Cell change enum for serving / neighbor / both.
    uint8 phoneId IN               ///< Phone ID.
);

