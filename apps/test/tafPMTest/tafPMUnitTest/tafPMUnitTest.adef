sandboxed: false
executables:
{
    tafPMUnitTest = ( tafPMUnitTestComp )
    pmTest = ( ctrlCmdComp )
}


processes:
{
    run:
    {
        (tafPMUnitTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafPMUnitTest.tafPMUnitTestComp.taf_pm -> tafPMSvc.taf_pm
    pmTest.ctrlCmdComp.ctrlCmd -> tafPMUnitTest.tafPMUnitTestComp.ctrlCmd
}
