//-------------------------------------------------------------------------------------------------
/**
 * Maximum size of payload in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_PAYLOAD_SIZE = 4095;

//-------------------------------------------------------------------------------------------------
/**
 * Maximum size of interface name in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_INTERFACE_NAME_LEN = 30;

//-------------------------------------------------------------------------------------------------
/**
 * Enumeration of supported logical target address types.
 */
//-------------------------------------------------------------------------------------------------
ENUM TaType
{
    TA_TYPE_PHYSICAL   = 0x00,    ///< Physical addressing.
    TA_TYPE_FUNCTIONAL = 0x01     ///< Functional addressing.
};

//-------------------------------------------------------------------------------------------------
/**
* Logical address information structure in UDS communication.
*/
//-------------------------------------------------------------------------------------------------
STRUCT AddrInfo
{
    uint16 sa;                                ///< Source address of message senders.
    uint16 ta;                                ///< Target address of message recipients.
    TaType taType;                            ///< Target address type of message recipients.
    uint16 vlanId;                            ///< VLAN ID = 0, if it is not vlan interface.
    string ifName[MAX_INTERFACE_NAME_LEN];    ///< Interface name.
};

//-------------------------------------------------------------------------------------------------
/**
* Error code for Diagnostic service.
*/
//-------------------------------------------------------------------------------------------------
ENUM ErrorCode
{
    NO_ERROR = 0,                    ///< Success.
    CONDITIONS_NOT_CORRECT = 0x22    ///< Condition is not correct.
};

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the Diagnostic received request message.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE DiagInf;

//-------------------------------------------------------------------------------------------------
/**
 * Handler for a received service request message.
 *
 * @param[in] ref        Service reference.
 * @param[in] addrInfo   Diagnostic message pointer.
 * @param[in] serviceID  Service ID.
 * @param[in] msg        Data RequestMsg.
 * @param[in] contextPtr Context pointer.
 */
//-------------------------------------------------------------------------------------------------
HANDLER DiagHandler
(
    DiagInf ref   IN,                  ///< Service reference.
    AddrInfo addrInfo   IN,            ///< Diagnostic message pointer.
    uint8 serviceID     IN,            ///< Service ID.
    uint8 msg[MAX_PAYLOAD_SIZE]  IN    ///< Data RequestMsg.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information about the received Service message.
 */
//-------------------------------------------------------------------------------------------------
EVENT DiagEvent
(
    DiagHandler handler    ///< Handler
);

//-------------------------------------------------------------------------------------------------
 /**
 * Sends a Response.
 *
 * @return
 *  - LE_OK             Function success.
 *  - LE_BAD_PARAMETER  Invalid parameter.
 *  - LE_COMM_ERROR     Sending message error.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendResp
(
    DiagInf ref   IN,                   ///< Reference.
    AddrInfo addrInfo IN,               ///< Diagnostic message pointer.
    uint8 serviceID   IN,               ///< Service ID.
    uint8 errCode  IN,                  ///< Error code type.
    uint8 data[MAX_PAYLOAD_SIZE]  IN    ///< Data payload.
);
