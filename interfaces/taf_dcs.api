    DataBearerTechnology ulDataBearerTechPtr OUT  ///< The uplink data bearer technology.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data profile structure.
 *
 * @struct taf_dcs_ProfileInfo_t
 * @var taf_dcs_ProfileInfo_t::index
 * The profile index.
 * @var taf_dcs_ProfileInfo_t::tech
 * The profile technology type.
 * @var taf_dcs_ProfileInfo_t::name
 * The profile name.
 *
 */
//--------------------------------------------------------------------------------------------------
STRUCT ProfileInfo
{
    uint32 index;                           ///< The profile index.
    Tech tech;                              ///< The profile technology type.
    string name[NAME_MAX_LEN];              ///< The profile name.
};

//--------------------------------------------------------------------------------------------------
/**
 * The handler of the requesting data profile list.
 *
 * @param[in] result      The result.
 * @param[in] profileList The profile list information.
 * @param[in] contextPtr  The context provided by the application when adding the event handler.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER ProfileListHandler
(
    le_result_t  result                                 IN, ///< The result.
    ProfileInfo  profileList[PROFILE_LIST_MAX_ENTRY]    IN  ///< The profile list information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile list.
 *
 * @b NOTE: For Dual Sim-Single Active (DSSA) mode and Dual Sim-Dual Active (DSDA) mode, this API gets
 * the data profile list with phone ID 1.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_FAULT -- Failed.
 */
FUNCTION le_result_t GetProfileList
(
    ProfileInfo profileList[PROFILE_LIST_MAX_ENTRY]  OUT    ///< The profile list information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile list with the specified phone ID.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_FAULT -- Failed.
 */
FUNCTION le_result_t GetProfileListEx
(
    uint8 phoneId                                    IN,    ///< The phone ID.
    ProfileInfo profileList[PROFILE_LIST_MAX_ENTRY]  OUT    ///< The profile list information.
);

