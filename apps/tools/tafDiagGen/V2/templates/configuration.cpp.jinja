        // Try to find the record in the map
        auto it = diagConf.routine_parameters_all.find(recordName);
        if (it != diagConf.routine_parameters_all.end()) {
            size_t size = static_cast<size_t>(it->second.size);
            LE_DEBUG("Record '%s' found with size: %zu", recordName.c_str(), size);
            return size;
        }

        LE_WARN("Record '%s' not found in routine_parameters_all map", recordName.c_str());
        return 0;
    }
    catch (const std::exception& e)
    {
        LE_ERROR("Exception in get_routine_record_size for '%s': %s",
                recordName.c_str(), e.what());
        return 0;
    }
}

EXPORT_SYM const EnableConditionData& get_routine_enable_conditions(uint16_t routineId)
{
    LE_DEBUG("get_routine_enable_conditions: Looking up routine 0x%x (decimal: %d)",
             routineId, routineId);

    // Search in routines_all by identifier
    for (auto const& [key, entry] : diagConf.routines_all)
    {
        if (entry.identifier == (int)routineId)
        {
            const EnableConditionData& cond = entry.data_enable_condition;
            LE_DEBUG("get_routine_enable_conditions: Found routine 0x%x - "
                     "AND: %zu, OR: %zu",
                     routineId,
                     cond.and_conditions.size(),
                     cond.or_conditions.size());
            return cond;
        }
    }

    // Not found - return empty condition (no enable condition restriction)
    LE_DEBUG("get_routine_enable_conditions: Routine 0x%x not found - "
             "no enable condition defined", routineId);
    return s_emptyEnableCondition;
}

