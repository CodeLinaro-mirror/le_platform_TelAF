/**
 * @page c_tafDiagRoutineCtrl Diag Routine Control Service
 *
 * @rst :ref:`API reference <File taf_diagRoutineCtrl_interface.h>` @endrst
 *
 * <HR>
 *
 * The Diag Routine Control service APIs are used by applications to handle routine control(0x31)
 * requests from UDS clients.
 *
 * @section c_taf_diagRoutineCtrl_binding IPC interfaces binding
 *
 * All functions of this API are provided by the @b tafDiagSvc platform service.
 *
 * The following example illustrates how to bind to the diag routine control service.
 *
 * @verbatim
   bindings:
   {
        clientExe.clientComponent.taf_diagRoutineCtrl -> tafDiagSvc.taf_diagRoutineCtrl
   }
   @endverbatim
 *
 * @section c_taf_diag_routine_ctrl_handle Routine control
 *
 * A diag routine control service reference can be retrieved using taf_diagRoutineCtrl_GetService()
 * with the identifier passed as a parameter.
 *
 * @code
   diagRoutineCtrlSvcRef = taf_diagRoutineCtrl_GetService(identifier);
   if (diagRoutineCtrlSvcRef == NULL)
   {
        LE_ERROR("Fail to get routine control reference.");
        return;
   }
   @endcode
 *
 * @section c_taf_diag_routine_ctrl_Set_VlanId Set and Get VLAN ID
 *
 * After getting a service reference, an application can set the VLAN ID to the service to filter
 * routine control requests using taf_diagRoutineCtrl_SetVlanId(). It shall be called before
 * registering the handler for the RoutineControl(0x31) request message. An application can get the
 * VLAN ID of the request message using taf_diagRoutineCtrl_GetVlanIdFromMsg().
 *
 * - taf_diagRoutineCtrl_SetVlanId() -- Sets the VLAN ID.
 * - taf_diagRoutineCtrl_GetVlanIdFromMsg() -- Gets the VLAN ID of the request message.
 *
 * @section c_taf_diag_routine_control(0x31) Routine control service
 *
 * After getting a reference, an application registers a message handler using
 * taf_diagRoutineCtrl_AddRxMsgHandler(). Once a routine control request message is received, the
 * handler will be called indicating the new message.
 *
 * @code
   diagRoutineCtrlMsgRef = taf_diagRoutineCtrl_AddRxMsgHandler(diagRoutineCtrlSvcRef,
            (taf_diagRoutineCtrl_RxMsgHandlerFunc_t)routineCtrl_MsgHandler, NULL);
   @endcode
 *
 * An application can send a response by using taf_diagRoutineCtrl_SendResp().
 *
 * @code
   result = taf_diagRoutineCtrl_SendResp(rxMsgRef, TAF_DIAGROUTINECTRL_NO_ERROR, NULL, 0);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to send response.");
        return result;
   }
   @endcode
 *
 * The following APIs are provided for diag routine control service.
 *
 * - taf_diagRoutineCtrl_GetService() -- Gets the reference to a RoutineControl service.
 * - taf_diagRoutineCtrl_AddRxMsgHandler() -- Adds a handler function for the specified event.
 * - taf_diagRoutineCtrl_RemoveRxMsgHandler() -- Removes a handler function for the specified event.
 * - taf_diagRoutineCtrl_GetRoutineCtrlRec() -- Gets the RoutineControl option record of the Rx
 *                                              RoutineControl message.
 * - taf_diagRoutineCtrl_RemoveSvc() -- Removes the RoutineControl server service.
 * - taf_diagRoutineCtrl_SendResp() -- Sends a response to a RoutineControl request message.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the payload data in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_PAYLOAD_SIZE = 4095;

//-------------------------------------------------------------------------------------------------
/**
 * RoutineControl type.
 */
//-------------------------------------------------------------------------------------------------
ENUM Type
{
    START_ROUTINE = 0x01,       ///< Start the routine.
    STOP_ROUTINE,               ///< Stop the routine.
    REQUEST_ROUTINE_RESULTS     ///< Return result values of the routine.
};

//-------------------------------------------------------------------------------------------------
/**
 * Error code for RoutineControl.
 */
//-------------------------------------------------------------------------------------------------
ENUM ErrorCode
{
    NO_ERROR = 0,                       ///< Success.
    BUSY_REPEAT_REQ = 0x21,             ///< Resouce is temporarily busy.
    CONDITIONS_NOT_CORRECT = 0x22,      ///< Condition is not correct.
    REQUEST_SEQUENCE_ERROR = 0x24,      ///< Sequence error.
    GENERAL_PROGRAMMING_FAILURE = 0x72  ///< Programming failure.
};

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the RoutineControl service.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE Service;

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the RoutineControl received request message.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE RxMsg;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the reference to a RoutineControl service, if there's no RoutineControl service,
 * a new one will be created.
 *
 * @return
 *     - Reference to the service instance.
 *     - NULL if not allowed to create the service.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION Service GetService
(
    uint16 identifier   ///< Routine identifier.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets VLAN ID to the service to filter ReadDID and WriteDID requests.
 * If the VLAN ID is not found or does not existed, it will return an error.
 * This function shall be called before registering RxMsgHandler.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_UNSUPPORTED -- VLAN ID is unknown.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetVlanId
(
    Service svcRef IN,      ///< Service reference.
    uint16 vlanId IN        ///< VLAN ID.
);

//-------------------------------------------------------------------------------------------------
/**
 * Handler for a Rx RoutineControl message.
 */
//-------------------------------------------------------------------------------------------------
HANDLER RxMsgHandler
(
    RxMsg rxMsgRef  IN,          ///< Received message reference.
    Type routineCtrlType  IN,    ///< RoutineControl type.
    uint16 identifier  IN        ///< Routine identifier.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information on Rx RoutineControl message.
 */
//-------------------------------------------------------------------------------------------------
EVENT RxMsg
(
    Service svcRef IN,      ///< Service reference.
    RxMsgHandler handler
);

//-------------------------------------------------------------------------------------------------
/**
 * Gets the RoutineControl option record of the Rx RoutineControl message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRoutineCtrlRec
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint8 optionRec[MAX_PAYLOAD_SIZE]  OUT    ///< RoutineControl option record.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN ID of the Rx RoutineControl message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- VLAN ID not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVlanIdFromMsg
(
    RxMsg rxMsgRef  IN,    ///< Receive message reference.
    uint16 vlanId   OUT    ///< VLAN ID.
);

//-------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the Rx RoutineControl message.
 *
 * @b NOTE: This function must be called to send a response if receiving a message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendResp
(
    RxMsg rxMsgRef  IN,                  ///< Received message reference.
    uint8 errCode  IN,               ///< Error code type.
    uint8 data[MAX_PAYLOAD_SIZE]  IN     ///< Payload data.
);

//-------------------------------------------------------------------------------------------------
/**
 * Removes the RoutineControl server service.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid svcRef.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveSvc
(
    Service svcRef  IN    ///< Service reference.
);