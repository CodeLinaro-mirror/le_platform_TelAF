sandboxed: false

executables:
{
    tafCanUnitTest = ( $TELAF_ROOT/apps/test/tafCanTest/tafCanUnitTest/tafCanUnitTestComp )
}

processes:
{
    run:
    {
        (tafCanUnitTest)
    }

    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }

    faultAction: stopApp
}

start: manual

bindings:
{
    tafCanUnitTest.tafCanUnitTestComp.taf_can -> tafCanSvc.taf_can
}