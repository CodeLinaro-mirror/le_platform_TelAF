//--------------------------------------------------------------------------------------------------
// Sample system definition that includes essential modem and positioning services.
//
//
//--------------------------------------------------------------------------------------------------

#include "$LEGATO_ROOT/legatoTargetConfig.sinc"

apps:
{
    // Platform services.
    $LEGATO_ROOT/apps/platformServices/audioService
    $LEGATO_ROOT/apps/platformServices/cellNetService
    $LEGATO_ROOT/apps/platformServices/fwupdateService
    $LEGATO_ROOT/apps/platformServices/modemService
    $LEGATO_ROOT/apps/platformServices/powerMgr
    $LEGATO_ROOT/apps/platformServices/secStore
    $TELAF_ROOT/apps/tafServices/tafVoiceCallSvc
    $TELAF_ROOT/apps/tafServices/tafSimCardSvc
    $TELAF_ROOT/apps/tafServices/tafRadioSvc
    $TELAF_ROOT/apps/tafServices/tafAudioSvc
    $TELAF_ROOT/apps/tafServices/tafLocationSvc
    $TELAF_ROOT/apps/tafServices/tafSMSSvc
    $TELAF_ROOT/apps/tafServices/tafDataCallSvc
    $TELAF_ROOT/apps/tafServices/tafRemoteSimSvc
    $TELAF_ROOT/apps/tafServices/tafPMSvc
    $TELAF_ROOT/apps/tafServices/tafUpdateSvc
#if ${TARGET} = sa515m
    $TELAF_ROOT/apps/tafServices/tafMRCSvc
#endif

    // Command-line tools.
    $LEGATO_ROOT/apps/tools/tools

    // test apps
    $TELAF_ROOT/apps/test/tafDataCallTest/tafDataCallUnitTest/tafDataCallUnitTest
    $TELAF_ROOT/apps/test/tafVoiceCallTest/tafVoiceCallUnitTest/tafVoiceCallUnitTest
    $TELAF_ROOT/apps/test/tafRadioTest/tafRadioUnitTest/tafRadioUnitTest
    $LEGATO_ROOT/apps/sample/voiceCallApp/voiceCallApp
    $TELAF_ROOT/apps/test/tafSimTest/tafSimIntegrationTest/tafSimIntgTest
    $TELAF_ROOT/apps/test/tafSmsTest/tafSMSUnitTest
    $TELAF_ROOT/apps/test/tafRSimTest/tafRSimUnitTest/tafRSimUnitTest
    $TELAF_ROOT/apps/test/tafRSimTest/tafSAPServerUnitTest/tafSAPServerUnitTest
    $TELAF_ROOT/apps/test/tafSimTest/tafRSPUnitTest/tafRSPUnitTest
    $TELAF_ROOT/apps/sample/remoteSim/tafRSimApp
    $TELAF_ROOT/apps/sample/sapCard/tafSAPProviderApp
    $TELAF_ROOT/apps/test/tafUpdateTest/tafUpdateUnitTest/tafUpdateTestApp
    $TELAF_ROOT/apps/sample/rsp/tafRSPApp
#if ${TARGET} = sa515m
    $TELAF_ROOT/apps/test/tafMrcTest/tafMRCUnitTest/tafMRCUnitTest
#endif
}

commands:
{
    cm = tools:/scripts/cm
    fwupdate = tools:/bin/fwupdate
    secstore = tools:/bin/secstore
    gnss = tools:/bin/gnss
}

bindings:
{
    <root>.le_fwupdate -> fwupdateService.le_fwupdate
    <root>.taf_update -> tafUpdateSvc.taf_update
}

interfaceSearch:
{
    $TELAF_ROOT/interfaces
    interfaces/modemServices
    interfaces/positioning
    $LEGATO_ROOT/apps/sample/voiceCallApp
}

cflags:
{
    #if ${TARGET} = sa515m
        -DTARGET_SA515M
    #elif ${TARGET} = sa415m
        -DTARGET_SA415M
    #endif
}

cxxflags:
{
    #if ${TARGET} = sa515m
        -DTARGET_SA515M
    #elif ${TARGET} = sa415m
        -DTARGET_SA415M
    #endif
}
