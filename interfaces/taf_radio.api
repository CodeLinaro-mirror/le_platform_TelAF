//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafRadio Radio Service
 *
 * @ref taf_radio_interface.h "API Reference"
 *
 * <HR>
 *
 * The Radio Service APIs contain phone and network functions and is applied to configure and
 * obtain wireless cellular network information. By default, the radio service is powered on and
 * available by the system.
 *
 * @section taf_radio_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafRadioSvc service.
 *
 * The following example illustrates how to bind to the Radio service.
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_radio -> tafRadioSvc.taf_radio
   }
 *
   @endverbatim
 *
 * @section c_taf_radio_power Power Management
 *
 * Users can power on or power off the radio, but by default it is powered on.
 *
 * - taf_radio_SetRadioPower() / taf_radio_GetRadioPower() -- Sets/gets radio power status.
 *
 * The following example illustrates powering on the radio.
 *
 * @code
 *
   le_onoff_t power = LE_OFF;

   if (taf_radio_SetRadioPower(LE_ON, slotId) != LE_OK)
       LE_ERROR("Fail to set radio power.");

   if (taf_radio_GetRadioPower(&power, slotId) != LE_OK)
       LE_ERROR("Fail to get radio power status.");

   if (power != LE_ON)
       LE_ERROR("Unexpected power status.");
 *
   @endcode
 *
 * @section c_taf_radio_registartion Network Registration
 *
 * Users can register with the network automatically or manually with specific MCC and MNC.
 *
 *  - taf_radio_SetAutomaticRegisterMode() -- Registers with a network automatically.
 *
 *  - taf_radio_SetManualRegisterMode() -- Registers with a network with MCC and MNC manually.
 *
 *  - taf_radio_GetRegisterMode() -- Gets the network register mode.
 *
 *  - taf_radio_SetManualRegisterModeAsync() -- Registers with a network asynchronously with a handler.
 *
 *  - taf_radio_AddNetRegRejectHandler() / taf_radio_RemoveNetRegRejectHandler() -- Adds/removes
 *    handler for network registration rejection.
 *
 *  - taf_radio_GetPlatformSpecificRegistrationErrorCode() -- Gets the network registration error code. 
 *
 * The following example illustrates network registration.
 *
 * @code
 *
   if (taf_radio_SetManualRegisterMode(mccStr1, mncStr1, slotId) == LE_OK)
       LE_ERROR("Fail to set manual register mode.");

   LE_INFO("Platform registration error code: %d.", taf_radio_GetPlatformSpecificRegistrationErrorCode());

   bool isManualMode = false;
   if (taf_radio_GetRegisterMode(&isManualMode, mccStr2, TAF_RADIO_MCC_BYTES, mncStr2,
       TAF_RADIO_MNC_BYTES, slotId) != LE_OK)
       LE_ERROR("Fail to get register mode.");

   if (!isManualMode)
       LE_ERROR("Unexpected register mode.");

   if (strcmp(mccStr1, mccStr2) != 0)
       LE_ERROR("Unexpected MCC.");

   if (strcmp(mncStr1, mncStr2) != 0)
       LE_ERROR("Unexpected MNC.");
 *
   @endcode
 *
 * @section c_taf_radio_preferred_operator Preferred Operators
 *
 * Users can configure the preferences of operators and get the configuration details
 * with a list.
 *
 *  - taf_radio_GetPreferredOperatorsList() / taf_radio_DeletePreferredOperatorsList() -- Creates/deletes
 *    a preferred operator list reference.
 *
 *  - taf_radio_AddPreferredOperator() / taf_radio_RemovePreferredOperator() -- Adds/removes a
 *    preferred operator.
 *
 *  - taf_radio_GetFirstPreferredOperator() / taf_radio_GetNextPreferredOperator() -- Gets the
 *    first/next preferred operator reference.
 *
 *  - taf_radio_GetPreferredOperatorDetails() -- Gets the operator details.
 *
 * The following example illustrates preferred operator list management.
 *
 * @code
 *
   // Add preference.
   for (int i = 0; i < PREFERRED_OPERATOR_NUM; i++) {
       taf_radio_AddPreferredOperator(prefMccStr[i], prefMncStr[i], prefRatMask, slotId);
   }

   // Create list.
   listRef = taf_radio_GetPreferredOperatorsList(slotId);

   // Traverse list
   opRef = taf_radio_GetFirstPreferredOperator(listRef);
   while (opRef != nullptr) {
       taf_radio_GetPreferredOperatorDetails(opRef, mccStr, TAF_RADIO_MCC_BYTES, mncStr,
           TAF_RADIO_MNC_BYTES, &ratMask);

       // Do something with the operator details.

       opRef = taf_radio_GetNextPreferredOperator(listRef);
   }

   // Delete list.
   taf_radio_DeletePreferredOperatorsList(listRef);

   // Remove preference.
   for (int i = 0; i < PREFERRED_OPERATOR_NUM; i++) {
       taf_radio_RemovePreferredOperator(prefMccStr[i], prefMncStr[i], slotId);
   }
 *
   @endcode
 *
 * @section c_taf_radio_rat Radio Access Technology
 *
 * Users can get RAT in use, and configure RAT preferences.
 *
 *  - taf_radio_GetRadioAccessTechInUse() -- Gets radio access technology in use.
 *
 *  - taf_radio_AddRatChangeHandler() / taf_radio_RemoveRatChangeHandler() -- Adds/removes
 *    RAT change handler.
 *
 *  - taf_radio_SetRatPreferences() / taf_radio_GetRatPreferences() -- Sets/gets RAT peferences.
 *
 * The following example illustrates RAT change indication.
 *
 * @code
 *
   // RAT change indication handler.
   static void RatChangeHandler(const taf_radio_RatChangeInd_t* indPtr, void* contextPtr)
   {
       LE_INFO("RAT: %d", indPtr->rat);
   }

   // Add handler for RAT change.
   handlerRef = taf_radio_AddRatChangeHandler((taf_radio_RatChangeHandlerFunc_t)RatChangeHandler, NULL);

   // RAT change in some cases.
 *
   @endcode
 *
 * @section c_taf_radio_cs_ps Circuit-Switched and Packet-Switched State
 *
 * Users can get the circuit-switched (CS) and packet-switched (PS) state.
 *
 * - taf_radio_GetPacketSwitchedState() -- Gets the CS and PS state.
 *
 * - taf_radio_AddPacketSwitchedChangeHandler() / taf_radio_RemovePacketSwitchedChangeHandler() -- Adds/removes
 *   CS/PS change handler.
 *
 * The following example illustrates the CS/PS change indication.
 *
 * @code
 *
   // CS/PS change indication handler.
   static void CsPsChangeHandler(const taf_radio_ServiceDomainState_t state, void* contextPtr)
   {
       LE_INFO("CS/PS state: %d", state);
   }

   // Add handler for CS/PS change.
   handlerRef = taf_radio_AddPacketSwitchedChangeHandler(
      (taf_radio_PacketSwitchedChangeHandlerFunc_t)CsPsChangeHandler, NULL);

   // CS/PS change in some cases.
 *
   @endcode
 *
 * @section c_taf_radio_signal_metrics Signal Metrics
 *
 * Users can measure signal and get metrics for different RATs.
 *
 *  - taf_radio_GetSignalQual() -- Gets the highest signal strength level.
 *
 *  - taf_radio_MeasureSignalMetrics() / taf_radio_DeleteSignalMetrics() -- Creates/deletes the signal
 *    metrics reference.
 *
 *  - taf_radio_GetRatOfSignalMetrics() -- Gets cell RATs.
 *
 *  - taf_radio_GetGsmSignalMetrics() / taf_radio_GetUmtsSignalMetrics() / taf_radio_GetLteSignalMetrics() /
 *    taf_radio_GetCdmaSignalMetrics() -- Gets GSM/UMTS/LTE/CDMA signal metrics.
 *
 *  - taf_radio_AddSignalStrengthChangeHandler() / taf_radio_RemoveSignalStrengthChangeHandler() -- Adds/removes
 *    signal strength change handler.
 *
 * The following example illustrates getting LTE signal metrics.
 *
 * @code
 *
   metricRef = taf_radio_MeasureSignalMetrics(slotId);
   ratMask = taf_radio_GetRatOfSignalMetrics(metricRef);
   if (ratMask & TAF_RADIO_CELL_RAT_MASK_LTE) {
       if (taf_radio_GetLteSignalMetrics(metricsRef, &ss, &rsrq, &rsrp, &snr) == LE_OK) {
           LE_INFO("LTE signal strength in dBm: %d\n", ss);
           LE_INFO("LTE reference signal receive quality in dB : %d\n", rsrq);
           LE_INFO("LTE reference signal receive power in dBm : %d\n", rsrp);
           LE_INFO("LTE signal-to-noise ratio in dB : %d\n", snr);
       } else {
           LE_ERROR("Fail to get LTE signal metrics.");
       }
   }
 *
   @endcode
 *
 * @section c_taf_radio_serving_cell Serving Cellular Network Information
 *
 * Users can get serving cellular network information.
 *
 *  - taf_radio_GetServingCellId() -- Gets the cell ID.
 * @warning Only applicable for GSM/LTE/WCDMA/TDSCDMA.
 *
 *  - taf_radio_GetServingCellLocAreaCode() -- Gets the location area code.
 * @warning Only applicable for  GSM/WCDMA/TDSCDMA.
 *
 *  - taf_radio_GetServingCellLteTracAreaCode() -- Gets the tracking area code.
 * @warning Only applicable for LTE.
 *
 *  - taf_radio_GetServingCellEarfcn() -- Gets the E-UTRA absolute radio frequency channel number.
 * @warning Only applicable for LTE.
 *
 *  - taf_radio_GetServingCellTimingAdvance() -- Gets the timing advance.
 * @warning Only applicable for GSM/LTE.
 *
 *  - taf_radio_GetPhysicalServingLteCellId() -- Gets the physical cell ID.
 * @warning Only applicable for LTE.
 *
 *  - taf_radio_GetServingCellGsmBsic() -- Gets the base station ID.
 * @warning Only applicable for GSM.
 *
 *  - taf_radio_GetServingCellScramblingCode() -- Gets the primary scrambling code.
 * @warning Only applicable for WCDMA.
 *
 * @section c_taf_radio_network Network Information
 *
 * Users can use the following APIs to get the current network and discover nearby networks
 * by scanning.
 *
 *  - taf_radio_GetCurrentNetworkName() -- Gets the current network name.
 *
 *  - taf_radio_GetCurrentNetworkMccMnc() -- Gets the current network MCC and MNC.
 *
 *  - taf_radio_PerformCellularNetworkScan() / taf_radio_DeleteCellularNetworkScan() -- Creates/deletes
 *    a list reference for network scanning.
 *
 *  - taf_radio_PerformCellularNetworkScanAsync() -- Asynchronously performs a network scan with a handler.
 *
 *  - taf_radio_GetFirstCellularNetworkScan() / taf_radio_GetNextCellularNetworkScan() -- Gets
 *    the first/next operator reference in the network scan list.
 *
 *  - taf_radio_GetCellularNetworkMccMnc() -- Gets MCC and MNC of a network scan operator.
 *
 *  - taf_radio_GetCellularNetworkName() -- Gets the name of a network scan operator.
 *
 *  - taf_radio_IsCellularNetworkInUse() -- Checks if using the network scan operator's network.
 *
 *  - taf_radio_IsCellularNetworkAvailable() -- Checks if the network is available.
 *
 *  - taf_radio_IsCellularNetworkHome() -- Checks if it is the home network.
 *
 *  - taf_radio_IsCellularNetworkForbidden() -- Checks if the network is forbidden.
 *
 * When users fail to register to the current network, they may scan and find the nearby networks, and register to
 * an available network with MCC and MNC manually. The following example illustrates network scanning.
 *
 * @code
 *
   // Create list and perform network scan.
   listRef = taf_radio_PerformCellularNetworkScan(slotId);

   // Traverse list
   opRef = taf_radio_GetFirstCellularNetworkScan(listRef);
   while (opRef != nullptr) {
       if (taf_radio_GetCellularNetworkName(opRef, name, TAF_RADIO_NETWORK_NAME_MAX_LEN) != LE_OK) {
           LE_ERROR("Fail to get network name.");
           break;
       }

       if (taf_radio_GetCellularNetworkMccMnc(opRef, mcc, TAF_RADIO_MCC_BYTES,
           mnc, TAF_RADIO_MNC_BYTES) != LE_OK) {
           LE_ERROR("Fail to get network MCC and MNC.");
           break;
       }

       inUse = taf_radio_IsCellularNetworkInUse(opRef);
       available = taf_radio_IsCellularNetworkAvailable(opRef);
       fobbiden = taf_radio_IsCellularNetworkForbidden(opRef);
       home = taf_radio_IsCellularNetworkHome(opRef);

       // Do something with the network scan information.

       opRef = taf_radio_GetNextCellularNetworkScan(listRef);
   }

   // Delete list.
   taf_radio_DeleteCellularNetworkScan(listRef);
 *
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Mobile Country Code (MCC) length without null characters.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MCC_LEN = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Mobile Network Code (MNC) minimum length without null characters.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MNC_MIN_LEN = 2;

//--------------------------------------------------------------------------------------------------
/**
 * MNC maximum length without null characters.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MNC_MAX_LEN = 3;

//--------------------------------------------------------------------------------------------------
/**
 * MCC length with null characters.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MCC_BYTES = (MCC_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * MNC maximum length with null characters.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MNC_BYTES = (MNC_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * Network maximum name length without null characters.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NETWORK_NAME_MAX_LEN = 100;

//--------------------------------------------------------------------------------------------------
/**
 * The preferred operator list reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE PreferredOperatorList;

//--------------------------------------------------------------------------------------------------
/**
 * The preferred operator reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE PreferredOperator;

//--------------------------------------------------------------------------------------------------
/**
 * The signal metrics reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Metrics;

//--------------------------------------------------------------------------------------------------
/**
 * The network scan information list reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE ScanInformationList;

//--------------------------------------------------------------------------------------------------
/**
 * The network scan information reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE ScanInformation;

//--------------------------------------------------------------------------------------------------
/**
 * Radio Access Technology (RAT).
 */
//--------------------------------------------------------------------------------------------------
ENUM Rat
{
    RAT_UNKNOWN,  ///< Unknown RAT.
    RAT_GPRS,     ///< General packet radio service.
    RAT_EDGE,     ///< Enhanced data rate for GSM evolution.
    RAT_UMTS,     ///< Universal mobile telecommunications system.
    RAT_IS95A,    ///< A standard in CDMA.
    RAT_IS95B,    ///< A standard in CDMA.
    RAT_1xRTT,    ///< A 2.5G technology in CDMA.
    RAT_EVDO_0,   ///< Evolution data only Rev.0 in CDMA.
    RAT_EVDO_A,   ///< Evolution data only Rev.A in CDMA.
    RAT_HSDPA,    ///< High speed downlink packet access in WCDMA.
    RAT_HSUPA,    ///< High speed uplink packet access in WCDMA.
    RAT_HSPA,     ///< High speed packet access in WCDMA.
    RAT_EVDO_B,   ///< Evolution data only Rev.B in CDMA.
    RAT_EHRPD,    ///< Evolved high rate package data.
    RAT_LTE,      ///< Long term evolution.
    RAT_HSPAP,    ///< A 3.5G technology in WCDMA.
    RAT_GSM,      ///< A 3.5G technology in WCDMA.
    RAT_TD_SCDMA, ///< Time division-synchronous code division multiple access.
    RAT_IWLAN,    ///< Industrial wireless local area networks.
    RAT_LTE_CA,   ///< Long term evolution carrier aggregation.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network reject cause.
 */
//--------------------------------------------------------------------------------------------------
ENUM NetRejCause
{
    NET_REJ_CAUSE_UNDEFINED = -1,                    ///< Undefined.
    NET_REJ_CAUSE_GENERAL,                           ///< General.
    NET_REJ_CAUSE_AUTH_FAILURE,                      ///< Authentication failure.
    NET_REJ_CAUSE_IMSI_UNKNOWN,                      ///< IMSI unknown in HLR.
    NET_REJ_CAUSE_ILLEGAL_MS,                        ///< Illegal Mobile Station (MS); network refuses 
                                                     ///  service to the MS either because an identity 
                                                     ///  of the MS is not acceptable to the network 
                                                     ///  or because the MS does not pass the 
                                                     ///  authentication check.
    NET_REJ_CAUSE_IMSI_UNKNOWN_VLR,                  ///< IMSI unknown in Visitors Location Register (VLR).
    NET_REJ_CAUSE_IMEI_NOT_ACCEPTED,                 ///< Network does not accept emergency call 
                                                     ///  establishment using an IMEI or not accept 
                                                     ///  attach procedure for emergency services using 
                                                     ///  an IMEI.
    NET_REJ_CAUSE_ILLEGAL_ME,                        ///< ME used is not acceptable to the network.
    NET_REJ_CAUSE_GPRS_SERVICES_NOT_ALLOWED,         ///< Not allowed to operate GPRS services.
    NET_REJ_CAUSE_GPRS_NON_GPRS_NOT_ALLOWED,         ///< Not allowed to operate either GPRS or 
                                                     ///  non-GPRS services.
    NET_REJ_CAUSE_MS_IDENTITY_FAILED,                ///< The network cannot derive the MS's identity 
                                                     ///  from the P-TMSI/GUTI.
    NET_REJ_CAUSE_IMPLICITLY_DETACHED,               ///< Network has implicitly detached the MS.
    NET_REJ_CAUSE_PLMN_NOT_ALLOWED,                  ///< If the network initiates a detach request or 
                                                     ///  UE requests a services, in a PLMN where the MS, 
                                                     ///  by subscription or due to operator determined 
                                                     ///  barring is not allowed to operate.
    NET_REJ_CAUSE_LOCATION_AREA_NOT_ALLOWED,         ///< Network initiates a detach request, in a 
                                                     ///  location area where the HPLMN determines that 
                                                     ///  the MS, by subscription, is not allowed to operate 
                                                     ///  or roaming subscriber the subscriber is denied 
                                                     ///  service even if other PLMNs are available on 
                                                     ///  which registration was possible.
    NET_REJ_CAUSE_ROAMING_NOT_ALLOWED,               ///< Roaming not allowed in this Location Area.
    NET_REJ_CAUSE_GPRS_NOT_ALLOWED_IN_PLMN,          ///< GPRS services not allowed in this PLMN.
    NET_REJ_CAUSE_NO_SUITABLE_CELLS,                 ///< No Suitable Cells in this Location Area.
    NET_REJ_CAUSE_MSC_TEMPORARILY_NOT_REACHABLE,     ///< MSC temporarily not reachable.
    NET_REJ_CAUSE_NETWORK_FAILURE,                   ///< Network Failure.
    NET_REJ_CAUSE_MAC_FAILURE = 20,                  ///< MAC failure.
    NET_REJ_CAUSE_SYNC_FAILURE,                      ///< USIM detects that the SQN in the AUTHENTICATION REQUEST 
                                                     ///  or AUTHENTICATION_AND_CIPHERING REQUEST message is 
                                                     ///  out of range.
    NET_REJ_CAUSE_CONGESTION,                        ///< Network cannot serve a request from the MS because 
                                                     ///  of congestion.
    NET_REJ_CAUSE_GSM_AUTHENTICATION_UNACCEPTABLE,   ///< GSM authentication unacceptable.
    NET_REJ_CAUSE_NOT_AUTHORIZED = 25,               ///< Not authorized for this CSG.
    NET_REJ_CAUSE_SMS_PROVIDED_VIA_GPRS = 28,        ///< SMS provided via GPRS in this routing area.
    NET_REJ_CAUSE_SERVICE_OPTION_NOT_SUPPORTED = 32, ///< Service option not supported.
    NET_REJ_CAUSE_SERVICE_OPTION_NOT_SUBCRIBED,      ///< Requested service option not subscribed.
    NET_REJ_CAUSE_SERVICE_OPTION_OUT_OF_ORDER,       ///< Service option temporarily out of order.
    NET_REJ_CAUSE_CALL_NOT_IDENTIFIED = 38,          ///< Call cannot be identified.
    NET_REJ_CAUSE_NO_PDP_CONTEXT_ACTIVATED = 40,     ///< No PDP context activated.
    NET_REJ_CAUSE_RETRY_FOR_NEW_CELL = 48,           ///< Retry upon entry into a new cell.
    NET_REJ_CAUSE_INCORRECT_MESSAGE = 95,            ///< Semantically incorrect message.
    NET_REJ_CAUSE_INVALID_INFO,                      ///< Invalid mandatory information.
    NET_REJ_CAUSE_MSG_TYPE_NOT_IMPLEMENTED,          ///< Message type non-existent or not implemented.
    NET_REJ_CAUSE_MSG_NOT_COMPATIBLE,                ///< Message not compatible with protocol state.
    NET_REJ_CAUSE_INFO_NOT_IMPLEMENTED,              ///< Information element non-existent or not implemented.
    NET_REJ_CAUSE_CONDITIONAL_IE_ERROR,              ///< Conditional IE error.
    NET_REJ_CAUSE_PROTOCOL_ERROR_UNSPECIFIED = 111   ///< Protocol error; unspecified.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network registration state.
 */
//--------------------------------------------------------------------------------------------------
ENUM NetRegState
{
    NET_REG_STATE_NOT_REG_AND_NOT_SEARCHING,                         ///< Not registered and not searching.
    NET_REG_STATE_REG_HOME,                                          ///< Home registered.
    NET_REG_STATE_NOT_REG_AND_SEARCHING,                             ///< Not registered and searching.
    NET_REG_STATE_REG_DENIED,                                        ///< Registered denied.
    NET_REG_STATE_UNKNOWN,                                           ///< Unknown state.
    NET_REG_STATE_REG_ROAMING,                                       ///< Roaming registered.
    NET_REG_STATE_RSV_6,                                             ///< Reserved 6 register state.
    NET_REG_STATE_RSV_7,                                             ///< Reserved 7 register state.
    NET_REG_STATE_RSV_8,                                             ///< Reserved 8 register state.
    NET_REG_STATE_RSV_9,                                             ///< Reserved 9 register state.
    NET_REG_STATE_NOT_REG_AND_EMERGENCY_AVAILABLE_AND_NOT_SEARCHING, ///< Not registered and not searching, 
                                                                     ///  but emergency available.
    NET_REG_STATE_RSV_11,                                            ///< Reserved 11 register state.
    NET_REG_STATE_NOT_REG_AND_EMERGENCY_AVAILABLE_AND_SEARCHING,     ///< Not registered and searching, 
                                                                     ///  but emergency available.
    NET_REG_STATE_REG_DENIED_AND_EMERGENCY_AVAILABLE,                ///< Registered denied, but emergency 
                                                                     ///  available.
    NET_REG_STATE_UNKNOWN_AND_EMERGENCY_AVAILABLE                    ///< Unknown state, but emergency 
                                                                     ///  available.
};

//--------------------------------------------------------------------------------------------------
/**
 * Service domain state.
 */
//--------------------------------------------------------------------------------------------------
ENUM ServiceDomainState
{
    SERVICE_DOMAIN_STATE_UNKNOWN = -1, ///< Unknown state.
    SERVICE_DOMAIN_STATE_CS_ONLY,      ///< CS only.
    SERVICE_DOMAIN_STATE_PS_ONLY,      ///< PS only.
    SERVICE_DOMAIN_STATE_CS_AND_PS     ///< CS and PS.
};

//--------------------------------------------------------------------------------------------------
/**
 * RAT bitmask.
 */
//--------------------------------------------------------------------------------------------------
BITMASK RatBitMask
{
    RAT_BIT_MASK_RSV_0,  ///< Reserved 0 bitmask.
    RAT_BIT_MASK_RSV_1,  ///< Reserved 1 bitmask.
    RAT_BIT_MASK_RSV_2,  ///< Reserved 2 bitmask.
    RAT_BIT_MASK_RSV_3,  ///< Reserved 3 bitmask.
    RAT_BIT_MASK_RSV_4,  ///< Reserved 4 bitmask.
    RAT_BIT_MASK_RSV_5,  ///< Reserved 5 bitmask.
    RAT_BIT_MASK_RSV_6,  ///< Reserved 6 bitmask.
    RAT_BIT_MASK_GSM,    ///< GSM bitmask.
    RAT_BIT_MASK_RSV_8,  ///< Reserved 8 bitmask.
    RAT_BIT_MASK_RSV_9,  ///< Reserved 9 bitmask.
    RAT_BIT_MASK_RSV_10, ///< Reserved 10 bitmask.
    RAT_BIT_MASK_NR5G,   ///< NR5G bitmask.
    RAT_BIT_MASK_RSV_12, ///< Reserved 12 bitmask.
    RAT_BIT_MASK_RSV_13, ///< Reserved 13 bitmask.
    RAT_BIT_MASK_LTE,    ///< LTE bitmask.
    RAT_BIT_MASK_UMTS,   ///< UMTS bitmask.
    RAT_BIT_MASK_ALL     ///< All (GSM + NR5G + LTE + UMTS) bitmask.
};

//--------------------------------------------------------------------------------------------------
/**
 * RAT preference bitmask.
 */
//--------------------------------------------------------------------------------------------------
BITMASK RatPrefMask
{
    RAT_PREF_MASK_CDMA_1X,   ///< CDMA_1X bitmask.
    RAT_PREF_MASK_CDMA_EVDO, ///< CDMA_EVDO bitmask.
    RAT_PREF_MASK_GSM,       ///< GSM bitmask.
    RAT_PREF_MASK_WCDMA,     ///< WCDMA bitmask.
    RAT_PREF_MASK_LTE,       ///< LTE bitmask.
    RAT_PREF_MASK_TDSCDMA,   ///< TD-SCDMA bitmask.
    RAT_PREF_MASK_NR5G,      ///< NR5G bitmask.
    RAT_PREF_MASK_ALL        ///< All (CDMA + GSM + WCDMA + LTE + TD-SCDMA + NR5G) bitmask.
};

//--------------------------------------------------------------------------------------------------
/**
 * Cell RAT bitmask.
 */
//--------------------------------------------------------------------------------------------------
BITMASK CellRatMask
{
    CELL_RAT_MASK_GSM,     ///< GSM bitmask.
    CELL_RAT_MASK_CDMA,    ///< CDMA bitmask.
    CELL_RAT_MASK_LTE,     ///< LTE bitmask.
    CELL_RAT_MASK_WCDMA,   ///< WCDMA bitmask.
    CELL_RAT_MASK_TDSCDMA, ///< TDSCDMA bitmask.
    CELL_RAT_MASK_UNKNOWN  ///< UNKNOWN bitmask.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network rejection indication structure.
 */
//--------------------------------------------------------------------------------------------------
STRUCT NetRegRejInd
{
    NetRejCause cause; ///< Network rejection cause.
    uint8 phoneId;     ///< Slot ID.
};

//--------------------------------------------------------------------------------------------------
/**
 * RAT change indication structure.
 */
//--------------------------------------------------------------------------------------------------
STRUCT RatChangeInd
{
    Rat rat;       ///< RAT.
    uint8 phoneId; ///< Slot ID.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network registration state indication structure.
 */
//--------------------------------------------------------------------------------------------------
STRUCT NetRegStateInd
{
    NetRegState state; ///< Network registration state.
    uint8 phoneId;     ///< Slot ID.
};

//--------------------------------------------------------------------------------------------------
/**
 * Handler for manual selection.
 */
//--------------------------------------------------------------------------------------------------
HANDLER ManualSelectionHandler
(
    le_result_t result IN ///< Result of manual selection.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for network registration rejection.
 */
//--------------------------------------------------------------------------------------------------
HANDLER NetRegRejectHandler
(
    NetRegRejInd rejInd IN ///< Network rejection indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for RAT change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RatChangeHandler
(
    RatChangeInd ratChangeInd IN ///< RAT change indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for network registration state.
 */
//--------------------------------------------------------------------------------------------------
HANDLER NetRegStateHandler
(
    NetRegStateInd stateInd IN ///< Network registration state indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for CS and PS changes.
 */
//--------------------------------------------------------------------------------------------------
HANDLER PacketSwitchedChangeHandler
(
    ServiceDomainState state IN ///< Service domain state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for signal strength change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER SignalStrengthChangeHandler
(
    int32 ss IN ///< The signal strength.
);

/**
 * Handler for network scan.
 */
HANDLER CellularNetworkScanHandler
(
    ScanInformationList listRef IN ///< The network scan information list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report network registration rejection.
 */
//--------------------------------------------------------------------------------------------------
EVENT NetRegReject
(
    NetRegRejectHandler handler ///< Handler for network registration rejection.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report RAT change.
 */
//--------------------------------------------------------------------------------------------------
EVENT RatChange
(
    RatChangeHandler handler ///< Handler for RAT change.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report network registration state.
 */
//--------------------------------------------------------------------------------------------------
EVENT NetRegStateEvent
(
    NetRegStateHandler handler ///< Handler for network registration state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report CS and PS changes.
 */
//--------------------------------------------------------------------------------------------------
EVENT PacketSwitchedChange
(
    PacketSwitchedChangeHandler handler ///< Handler for CS and PS changes.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report signal strength change.
 */
//--------------------------------------------------------------------------------------------------
EVENT SignalStrengthChange
(
    CellRatMask ratMask IN,             ///< Cell RAT mask.
    SignalStrengthChangeHandler handler ///< Handler for signal strength change.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the radio power state.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetRadioPower
(
    le_onoff_t power IN, ///< Power state.
    uint8 phoneId IN     ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the radio power state.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRadioPower
(
    le_onoff_t power OUT, ///< Power state.
    uint8 phoneId IN      ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Registers to network using automatic mode.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response time out.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAutomaticRegisterMode
(
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Registers to network using manual mode.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response time out.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetManualRegisterMode
(
    string mcc[MCC_LEN] IN,     ///< MCC. 
    string mnc[MNC_MAX_LEN] IN, ///< MNC.
    uint8 phoneId IN            ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Registers to network asynchronously using manual mode.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION SetManualRegisterModeAsync
(
    string mcc[MCC_LEN] IN,         ///< MCC.
    string mnc[MNC_MAX_LEN] IN,     ///< MNC.
    ManualSelectionHandler handler, ///< Handler for manual selection.
    uint8 phoneId IN                ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the network registration mode.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response time out.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRegisterMode
(
    bool isManualPtr OUT,           ///< True if manual, false if automatic.
    string mccPtr[MCC_LEN] OUT,     ///< MCC.
    string mncPtr[MNC_MAX_LEN] OUT, ///< MNC.
    uint8 phoneId IN                ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets platform-specific network registration error code.
 *
 * @return
 * Platform-specific network registration error code.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION int32 GetPlatformSpecificRegistrationErrorCode
(
);

//--------------------------------------------------------------------------------------------------
/**
 *  Adds a preferred operator.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_DUPLICATE -- Duplicate preferred operator.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddPreferredOperator
(
    string mcc[MCC_LEN] IN,     ///< MCC.
    string mnc[MNC_MAX_LEN] IN, ///< MNC.
    RatBitMask ratMask IN,      ///< RAT bitmask.
    uint8 phoneId IN            ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Removes a preferred operator.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_NOT_FOUND -- Preferred operator not found.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemovePreferredOperator
(
    string mcc[MCC_LEN] IN,     ///< MCC.
    string mnc[MNC_MAX_LEN] IN, ///< MNC.
    uint8 phoneId IN            ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Deletes the preferred operators list.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Preferred operator not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeletePreferredOperatorsList
(
    PreferredOperatorList preferredOperatorListRef IN ///< The preferred operators list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Creates a preferred operators list.
 *
 * @return
 *  - Non-null pointer -- The preferred operators list reference.
 *  - Null pointer -- Internal error or no preferred operators list.
 *
 * @note At most 1 preferred operator list per slot.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION PreferredOperatorList GetPreferredOperatorsList
(
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the first preferred operator.
 *
 * @return
 *  - Non-null pointer -- The first preferred operator reference.
 *  - Null pointer -- Internal error or empty list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION PreferredOperator GetFirstPreferredOperator
(
    PreferredOperatorList  preferredOperatorListRef IN ///< The preferred operators list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the next preferred operator based on the current position in the list.
 *
 * @return
 *  - Non-null pointer -- The next preferred operator reference.
 *  - Null pointer -- Internal error or empty list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION PreferredOperator GetNextPreferredOperator
(
    PreferredOperatorList  preferredOperatorListRef IN ///< The preferred operators list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the details of the given preferred operator.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Preferred operator not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPreferredOperatorDetails
(
    PreferredOperator preferredOperatorRef IN, ///< The preferred operator reference.
    string mccPtr[MCC_LEN] OUT,                ///< MCC.
    string mncPtr[MNC_MAX_LEN] OUT,            ///< MNC.
    RatBitMask ratMask OUT                     ///< RAT bitmask.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the RAT in use.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRadioAccessTechInUse
(
    Rat rat OUT,     ///< RAT in use.
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Sets the RAT preferences.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetRatPreferences
(
    RatPrefMask ratMask IN, ///< Bitmask for RAT prefences.
    uint8 phoneId IN        ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the RAT preferences.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRatPreferences
(
    RatPrefMask ratMaskPtr OUT, ///< Bitmask for RAT prefences.
    uint8 phoneId IN            ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the network registration state.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNetRegState
(
    NetRegState state OUT, ///< Network registration state.
    uint8 phoneId IN       ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the CS and PS state.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPacketSwitchedState
(
    ServiceDomainState state OUT, ///< CS and PS state.
    uint8 phoneId IN              ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the signal quality.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 * @note This function gets the highest signal strength level of RATs.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSignalQual
(
    uint32 quality OUT, ///< Signal qulity level, range is 0 to 5.
    uint8 phoneId IN    ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Creates signal metrics.
 *
 * @return
 *  - Non-null pointer -- The signal metrics reference.
 *  - Null pointer -- Internal error.
 *
 * @note At most 1 signal metrics reference per slot. taf_radio_DeleteSignalMetrics() releases
 *       signal metrics reference before measuring.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Metrics MeasureSignalMetrics
(
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Deletes signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Preferred operator not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteSignalMetrics
(
    Metrics MetricsRef IN ///< The signal metrics reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets cell RAT bitmask of signal metrics.
 *
 * @return
 *  - TAF_RADIO_CELL_RAT_MASK_UNKNOWN -- Internal error.
 *  - Others -- Cell RAT bitmask of signal metrics.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION CellRatMask GetRatOfSignalMetrics
(
    Metrics MetricsRef IN ///< The signal metrics reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets GSM signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 *  - LE_UNAVAILABLE -- GSM unavailable.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetGsmSignalMetrics
(
    Metrics MetricsRef IN, ///< The signal metrics reference.
    int32 rssi OUT,        ///< Signal strength.
    uint32 ber OUT         ///< Bit error rate.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets UMTS signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 *  - LE_UNAVAILABLE -- UMTS unavailable.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetUmtsSignalMetrics
(
    Metrics MetricsRef IN, ///< The signal metrics reference.
    int32 ss OUT,          ///< Signal strength, only applicable for WCDMA.
    uint32 ber OUT,        ///< Bit error rate, only applicable for WCDMA.
    int32 rscp OUT         ///< Reference signal code power in dBm, only applicable for TD-SCDMA.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets LTE signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 *  - LE_UNAVAILABLE -- LTE unavailable.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetLteSignalMetrics
(
    Metrics MetricsRef IN, ///< The signal metrics reference.
    int32 ss OUT,          ///< Signal strength.
    int32 rsrq OUT,        ///< Reference signal receive quality in dB.
    int32 rsrp OUT,        ///< Reference signal receive power in dBm.
    int32 snr OUT          ///< Signal-to-noise ratio in dB.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets CDMA signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 *  - LE_UNAVAILABLE -- CDMA unavailable.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCdmaSignalMetrics
(
    Metrics MetricsRef IN, ///< The signal metrics reference.
    int32 ss OUT,          ///< Signal strength in dBm.
    int32 ecio OUT,        ///< CDMA Ec/Io in dB.
    int32 snr OUT,         ///< Signal-to-noise ratio in dB.
    int32 io OUT           ///< EV-DO Ec/Io in dB.
);

