 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCdmaSignalMetrics
(
    Metrics MetricsRef IN, ///< The signal metrics reference.
    int32 ss OUT,          ///< Signal strength in dBm.
    int32 ecio OUT,        ///< CDMA Ec/Io in dB.
    int32 snr OUT,         ///< EVDO signal-to-noise ratio in dB.
    int32 io OUT           ///< EVDO Ec/Io in dB.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets NR5G signal metrics.
 *
