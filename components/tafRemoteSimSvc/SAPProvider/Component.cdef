provides:
{
    api:
    {
        taf_simSap.api
    }
}

requires:
{
    component:
    {
        $LEGATO_ROOT/components/watchdogChain
    }

    lib:
    {
        libComponent_taf_pa_sap.so
        libComponent_taf_pa_sapDef.so
    }
    api:
    {
        taf_sim.api
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -I$TELAF_PA_DEFAULT/include
    -I$TELAF_ROOT/../telaf-pa/include
    -std=c++17
    -DTAFPA_ENABLE_LEGACY_MACROS=1
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
}

ldflags:
{
    -L$TELAF_DEFAULT_PA_LIB_DIR/lib
}

sources:
{
    tafSAPImpl.cpp
    tafSAP.cpp
}

