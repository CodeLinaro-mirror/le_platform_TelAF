//-------------------------------------------------------------------------------------------------
/**
 * @page c_tafrsp Remote SIM Profile
 *
 * @ref taf_rsp_interface.h "API Reference"
 *
 * <HR>
 *
 * The remote SIM profile is a profile of a SIM card placed remotely. User can manage
 * the profile of remote SIM using this service and interface between the application and
 * the RSIM service based on the SIM Access Profile (SAP) specification.
 * A remote SIM profile is needed for applications that want to add, delete, enable, disable
 * SIM profile locally or remotely.
 *
 * @section taf_rsp_binding IPC interfaces binding
 *
 * All the functions of this API are provided by the @b tafRSP application service.
 *
 * Here's a sample of how to bind to Remote SIM Profile service:
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_rsp -> tafSimCardSvc.taf_rsp
   }
   @endverbatim
 *
 * @section c_taf_rsp_AddProfile Adding a SIM profile
 *
 * A SIM profile can be added remotely by using taf_rsp_AddProfile() with slotId, activationCode,
 * confirmationCode and userConsentSupported passed as parameters.
 * @verbatim
   #define SLOT_ID  TAF_SIM_EXTERNAL_SLOT_1
   #define ACTIVATION_CODE "LPA:1$mc4-poc5.otlabs.fr$333353014959437" //This is for test, dummy activation code
   le_result_t res = taf_rsp_AddProfile((taf_sim_Id_t) TAF_SIM_EXTERNAL_SLOT_1, ACTIVATION_CODE,"",false);
   LE_ASSERT(res == LE_OK);
   @endverbatim
 *
 * Before the SIM profile download is started, an application registers a state change handler
 * using taf_rsp_AddProfileDownloadHandler(). Once the profile download is completed, the handler
 * will be called indicating it's now completed. If profile downloading failed or the downloading state
 * changed, then the handler will be called with the error code or new state.
 * @verbatim
   taf_rsp_ProfileDownloadHandlerRef_t pdHandlerRef = taf_rsp_AddProfileDownloadHandler(ProfileDownloadHandler, NULL);
   @endverbatim
 *
 * To enable a SIM profile, an application can use @ref taf_rsp_SetProfile() with the slotId, profileId
 * and enable flag passed as parameters.
 * To delete a SIM profile, an application can use @ref taf_rsp_DeleteProfile() with the slotId and
 * profileId passed as parameters.
 *
 * Application must use @ref taf_rsp_RemoveProfileDownloadHandler() to release @ref taf_rsp_ProfileDownloadHandlerRef_t
 * download handler reference object when it is no more used.
 *
 * <HR>
 *
 */
//------------------------------------------------------------------------------------------------


USETYPES taf_sim.api;

DEFINE  EID_LEN    = (32);
DEFINE  EID_BYTES  = (EID_LEN+1);
DEFINE  MAX_PROFILE = (32);
DEFINE  NAME_LEN    = (64);
DEFINE  NAME_BYTES  = (NAME_LEN+1);
DEFINE  SPN_LEN    = (32);
DEFINE  SMDP_LEN   = (1024);
DEFINE  NICKNAME_LEN    = (64);
DEFINE  NICKNAME_BYTES  = (NICKNAME_LEN+1);
DEFINE  ACTIVATION_CODE_LEN    = (256);
DEFINE  ACTIVATION_CODE_BYTES  = (ACTIVATION_CODE_LEN+1);
DEFINE  CODE_LEN    = (256);
DEFINE  CODE_BYTES  = (CODE_LEN+1);


/**
 * Indicates profile type of card
 */
ENUM ProfileType
{
    UNKNOWN = -1,
    REGULAR = 0,    ///< Regular profile
    EMERGENCY,      ///< Emergency profile
};

/**
 * Indicates profile icon type.
 */
ENUM IconType
{
    NONE = 0,       ///< No icon information
    JPEG,           ///< JPEG icon
    PNG,            ///< PNG icon
};

/**
 * Indicates profile class.
 */
ENUM ProfileClass
{
    TEST = 0,        ///< Test profile
    PROVISIONING,    ///< Provisioning profile
    OPERATIONAL      ///< Operational  profile
};

/**
 * Defines profile policy rules(PPR). Each value represents
 * corresponding bit for PprMask bitset.
 */
ENUM PolicyRuleType
{
    PROFILE_DISABLE_NOT_ALLOWED,     ///< Disabling of the profile is not allowed
    PROFILE_DELETE_NOT_ALLOWED,      ///< Deletion of the profile is not allowed
    PROFILE_DELETE_ON_DISABLE,       ///< Deletion of the profile is required on successful disabling
};

/**
 * Indicates profile download status.
 */
ENUM DownloadStatus
{
    DOWNLOAD_ERROR = 0,                  ///< Profile download error
    DOWNLOAD_INSTALLATION_COMPLETE,      ///< Profile download and installation is complete
};

/**
 * Indicates profile download error cause.
 */
ENUM DownloadErrorCause
{
    GENERIC = 1,                      ///< Generic error
    SIM,                              ///< Error from the SIM card
    NETWORK,                          ///< Error from the network
    MEMORY,                           ///< Error due to no memory
    UNSUPPORTED_PROFILE_CLASS,        ///< Unsupported profile class
    PPR_NOT_ALLOWED,                  ///< Profile policy rules not allowed
    END_USER_REJECTION,               ///< End user rejection
    END_USER_POSTPONED,               ///< End user postponed
};

/**
 * Indicates user consent reason type.
 */
ENUM UserConsentReasonType
{
    USER_REJECTION = 0,          ///< End user rejection
    USER_POSTPONED               ///< End user postponed
};

/**
 * Structure of Sim Profile Info.
 */
STRUCT SimProfileInfo
{
    uint32         profileId;
    ProfileType    profileType;
    string         iccid[taf_sim.ICCID_LEN];
    bool           isActive;
    string         nickName[NICKNAME_LEN];
    string         name[NAME_LEN];
    string         spn[SPN_LEN];
    IconType       iconType;
    ProfileClass   profileClass;
    uint8          mask;
};

//-------------------------------------------------------------------------------------------------
/**
 * Handler for profile download.
 */
//-------------------------------------------------------------------------------------------------
HANDLER  ProfileDownloadHandler
(
    taf_sim.Id         slotId  IN,            ///< SIM slot id
    DownloadStatus     downloadStatus IN,     ///< Downlpoad status
    DownloadErrorCause errorCause IN          ///< Download error cause
);

//-------------------------------------------------------------------------------------------------
/**
 * Event for profile download.
 */
//-------------------------------------------------------------------------------------------------
EVENT  ProfileDownload
(
    ProfileDownloadHandler handler    ///< Handler for profile download
);

//-------------------------------------------------------------------------------------------------
/**
 * Handler for consent of profile management.
 */
//-------------------------------------------------------------------------------------------------
HANDLER  ProfileUserConsentHandler
(
    taf_sim.Id         slotId  IN,              ///< SIM slot id
    bool               userConsentRequired IN,  ///< user consent require or not
    uint8              mask                     ///< Mask
);

//-------------------------------------------------------------------------------------------------
/**
 * User consent of profile management.
 */
//-------------------------------------------------------------------------------------------------
EVENT  ProfileUserConsent
(
    ProfileUserConsentHandler handler    ///< Handler of user consent
);

//-------------------------------------------------------------------------------------------------
/**
 * Handler for confirmation code of profile.
 */
//-------------------------------------------------------------------------------------------------
HANDLER  ProfileConfirmationCodeHandler
(
    taf_sim.Id         slotId  IN,            ///< SIM slot id
    string             profileName[NAME_LEN]  ///< Profile name
);

//-------------------------------------------------------------------------------------------------
/**
 * Event for confirmation code of profile.
 */
//-------------------------------------------------------------------------------------------------
EVENT  ProfileConfirmationCode
(
    ProfileConfirmationCodeHandler handler    ///< Handler of profile confirmation code
);

//-------------------------------------------------------------------------------------------------
/**
 * Request eUICC identifier(EID) for the slot.
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEID
(
    taf_sim.Id       slotId IN,                 ///< SIM slot id
    string           eid[EID_LEN] OUT           ///< EID as output
);

//-------------------------------------------------------------------------------------------------
/**
 * Add new profile to eUICC card and download and install the profile on eUICC.
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddProfile
(
    taf_sim.Id       slotId IN,                                 ///< SIM slot id
    string           activationCode[ACTIVATION_CODE_LEN] IN,    ///< Activation code
    string           confirmationCode[CODE_LEN] IN,             ///< Confirmation code
    bool             userConsentSupported IN                    ///< user consent supported or not
);

//-------------------------------------------------------------------------------------------------
/**
 *  Delete profile from eUICC card.
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteProfile
(
    taf_sim.Id       slotId IN,      ///< SIM slot id
    uint32           profileId IN    ///< Profile id
);

//-------------------------------------------------------------------------------------------------
/**
 *   Enable or disable profile which allows to switch to other profile on eUICC card.
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetProfile
(
    taf_sim.Id       slotId IN,     ///< SIM slot id
    uint32           profileId IN,  ///< Profile id
    bool             enable    IN   ///< Whether enable
);

//-------------------------------------------------------------------------------------------------
/**
 *  Update nick name of the profile
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t UpdateNickName
(
    taf_sim.Id       slotId IN,                  ///< SIM slot id
    uint32           profileId IN,               ///< Profile id
    string           nickName[NICKNAME_LEN] IN   ///< Nick name
);

//-------------------------------------------------------------------------------------------------
/**
 *  Request list of profiles supported by the eUICC card.
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetProfileList
(
    taf_sim.Id        slotId IN,                      ///< SIM slot id
    SimProfileInfo    profileList[MAX_PROFILE] OUT    ///< Profile List as output
);

//-------------------------------------------------------------------------------------------------
/**
 * Set Subscription Manager Data Preparation (SM-DP+) address on the eUICC. If SMDP+
 * address length is zero then the existing SM-DP+ address on the eUICC is removed
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetServerAddress
(
    taf_sim.Id       slotId IN,                ///< SIM slot id
    string           smdpAdress[SMDP_LEN] IN   ///< SMDP address
);

//-------------------------------------------------------------------------------------------------
/**
 * Get Subscription Manager Data Preparation (SM-DP+) address and the Subscription Manager
 * Discovery Server (SMDS) address configured on the eUICC.
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetServerAddress
(
    taf_sim.Id           slotId IN,                   ///< SIM slot id
    string               smdpAdress[SMDP_LEN]  OUT,   ///< SMDP address
    string               smdsdress[SMDP_LEN] OUT      ///< SMDS address
);

//-------------------------------------------------------------------------------------------------
/**
 * Provide user consent required for downloading and installing profile.
 * This API should be called in response to ProfileUserConsent event
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t ProvideUserConsent
(
    taf_sim.Id              slotId IN,       ///< SIM slot id
    bool                    userConsent IN,  ///< User consent
    UserConsentReasonType   reason           ///< User consent reason
);

//-------------------------------------------------------------------------------------------------
/**
 * Provide confirmation code required for downloading and installing profile.
 * This API should be called in response to ProfileConfirmationCode event
 *
 * @return
 *      - LE_OK on success
 *      - LE_FAULT on failure
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t ProvideConfirmationCode
(
    taf_sim.Id              slotId IN,          ///< SIM slot id
    string                  code[CODE_LEN] IN   ///< Confirmation code
);
