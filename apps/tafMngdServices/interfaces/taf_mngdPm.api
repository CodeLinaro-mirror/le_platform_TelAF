    SHUTDOWN_REASON_VENDOR_11,          ///< Tier-1 product specific Shutdown Reason.
    SHUTDOWN_REASON_VENDOR_12,          ///< Tier-1 product specific Shutdown Reason.
    SHUTDOWN_REASON_VENDOR_13,          ///< Tier-1 product specific Shutdown Reason.
    SHUTDOWN_REASON_VENDOR_14,          ///< Tier-1 product specific Shutdown Reason.
    SHUTDOWN_REASON_VENDOR_15,          ///< Tier-1 product specific Shutdown Reason.
    SHUTDOWN_REASON_VENDOR_16           ///< Tier-1 product specific Shutdown Reason.
};

/**
 * Wake source option for calling stay awake and relax.
 */
ENUM WsOpt
{
    WS_OPT_DEFAULT    ///< With same wake source ref, StayAwake and relax must be called in pairs.
                      ///< Can be called multiple times.
};

/**
 * Information data report ID.
 */
ENUM InfoDataId
{
    INFO_REPORT_BUB    ///< Info report for BUB.
};
/**
 * Bit Mask for the information data report.
 */
BITMASK InfoReportBitMask
{
    INFO_REPORT_BIT_MASK_BUB_STATUS
};
/**
 * Bub Status for INFO_REPORT_BUB_STATUS InfoDataId.
 */
ENUM BubStatus
{
    BUB_STATUS_UNKNOWN =  -1,
    BUB_STATUS_NOT_IN_USE,
    BUB_STATUS_IN_USE
};
DEFINE WSREF_MAXLEN   = (32);

BITMASK NodePowerStateChangeBitMask
{
    NODE_STATE_BIT_MASK_SHUTDOWN_PREPARE,
    NODE_STATE_BIT_MASK_RESTART_PREPARE,
    NODE_STATE_BIT_MASK_SUSPEND_PREPARE,
    NODE_STATE_BIT_MASK_RESUME
};

ENUM NodeClientAck
{
   CLIENT_NOT_READY = -1,
   CLIENT_READY
};

ENUM NodePowerState
{
   NODE_STATE_SHUTDOWN_PREPARE,
   NODE_STATE_RESTART_PREPARE,
   NODE_STATE_SUSPEND_PREPARE,
   NODE_STATE_RESUME
};

