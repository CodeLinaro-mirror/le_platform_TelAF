policy_module(tafCanSvc, 1.0)

gen_require(`
  type sysfs_t;
')

# Framework definition for telaf
type telaf_tafCanSvc_exec_t;
files_type(telaf_tafCanSvc_exec_t);

type telaf_tafCanSvc_t;

type telaf_tafCanSvc_data_t;
files_type(telaf_tafCanSvc_data_t);

init_telaf_app_domain(telaf_tafCanSvc_t,telaf_tafCanSvc_exec_t)

# Allow service to manage its own data directory; registers with admin domain.
telaf_manage_app_data_files(telaf_tafCanSvc_t, telaf_tafCanSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafCanSvc_exec_t)

# allow can_socket operation for sa525m
ifdef(`sa525m',`
    allow telaf_tafCanSvc_t self: can_socket { create ioctl bind write read setopt };
')
