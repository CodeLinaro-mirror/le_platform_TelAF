maxThreads: 600
sandboxed: false
executables:
{
    tafECallRefApp = ( eCallAppComp )
    ecallctl       = ( ctrlComponent )
}


processes:
{
    run:
    {
        (tafECallRefApp)
    }
    envVars:
    {
        LE_LOG_LEVEL = INFO
    }
}

start: manual

bindings:
{
    tafECallRefApp.eCallAppComp.taf_ecall -> tafECallSvc.taf_ecall
    tafECallRefApp.eCallAppComp.taf_locGnss -> tafLocationSvc.taf_locGnss
    tafECallRefApp.eCallAppComp.taf_gpio -> tafGpioSvc.taf_gpio
    tafECallRefApp.eCallAppComp.taf_audio -> tafAudioSvc.taf_audio
    tafECallRefApp.eCallAppComp.taf_mngdPm -> tafMngdPMSvc.taf_mngdPm
    tafECallRefApp.eCallAppComp.taf_diagDataID -> tafDiagSvc.taf_diagDataID
    tafECallRefApp.eCallAppComp.taf_diagDTC -> tafDiagSvc.taf_diagDTC
    tafECallRefApp.eCallAppComp.taf_diagEvent -> tafDiagSvc.taf_diagEvent
    tafECallRefApp.eCallAppComp.taf_diag -> tafDiagSvc.taf_diag
    tafECallRefApp.eCallAppComp.taf_hms -> tafHMSvc.taf_hms
    tafECallRefApp.eCallAppComp.taf_sim -> tafSimCardSvc.taf_sim
    tafECallRefApp.eCallAppComp.taf_radio -> tafRadioSvc.taf_radio
    tafECallRefApp.eCallAppComp.le_cfg -> <tafcore>.le_cfg

    // ecall command-line tool -> eCallApp IPC service
    ecallctl.ctrlComponent.ctrlEcall -> tafECallRefApp.eCallAppComp.ctrlEcall
}

