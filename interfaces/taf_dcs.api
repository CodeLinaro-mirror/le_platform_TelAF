//--------------------------------------------------------------------------------------------------
/**
 * Additional state information.
 *
 * @struct taf_dcs_StateInfo_t
 * @var taf_dcs_StateInfo_t::ipType
 * The pdp type of this event, e.g., which pdp (IPv4/IPv6) is supported on a CONNECTED event.
 *
 */
//--------------------------------------------------------------------------------------------------
STRUCT StateInfo
{
    Pdp      ipType;                     ///< The IP type of this event.
};

//--------------------------------------------------------------------------------------------------
/**
 * The roaming status indication.
 *
 * @struct taf_dcs_RoamingStatusInd_t
 * @var taf_dcs_RoamingStatusInd_t::phoneId
 * The phone ID.
 * @var taf_dcs_RoamingStatusInd_t::isRoaming
 * True means that roaming is on.<br>
 * False means that roaming is off.
 * @var taf_dcs_RoamingStatusInd_t::type
 * The roaming type. Valid only if roaming is on.
 *
 */
//--------------------------------------------------------------------------------------------------
STRUCT RoamingStatusInd
{
    uint8 phoneId;                         ///< The phone ID.
    bool isRoaming;                        ///< True means that roaming is on; False means that
                                           ///  roaming is off.
    RoamingType type;                      ///< The roaming type. Valid only if roaming is on.
};

//--------------------------------------------------------------------------------------------------
/**
 * Starts a synchronous data cellular session for the given profile reference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Parameter is invalid or couldn't create the data call.
 *  - LE_OUT_OF_RANGE -- PDP type is unknown.
 *  - LE_DUPLICATE -- If the data session is already connected for the given profile.
 *  - LE_IN_PROGRESS -- The profile is in use and a data call is in progress.
 *  - LE_TIMEOUT -- Timed out when attempting to make the data call.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartSession
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * The handler for asynchronous session start or stop result response.
 *
 * @param[in] profileRef The profile reference.
 * @param[in] result     The result of starting or stopping the data session.<br>
 *                       LE_OK           -- Succeeded.<br>
 *                       LE_NOT_POSSIBLE -- The data profile is not yet created.<br>
 *                       Others          -- Failed.
 * @param[in] contextPtr The context provided by the application when adding the event handler.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncSessionHandler
(
    Profile      profileRef                 IN, ///< The profile reference.
    le_result_t  result                     IN  ///< The result of starting or stopping session.
);

//--------------------------------------------------------------------------------------------------
/**
 * Starts (asynchronously) a cellular data session for the given profile reference.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION StartSessionAsync
(
    Profile profileRef                      IN, ///< The profile reference.
    AsyncSessionHandler handler             IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Stops (synchronously) a cellular data session for the given profile reference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Can't find a data call.
 *  - LE_OUT_OF_RANGE -- PdpType type is unknown.
 *  - LE_BAD_PARAMETER -- Call context is NULL.
 *  - LE_TIMEOUT -- Timeout to stop a data call.
 *  - LE_IN_PROGRESS -- The profile is in use and a data call is in progress.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StopSession
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Stops (asynchronously) a cellular data session for the given profile reference.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION StopSessionAsync
(
    Profile profileRef                      IN, ///< The profile reference.
    AsyncSessionHandler handler             IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets a connected data call interface name.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_NOT_POSSIBLE -- Invalid status.
 *  - LE_NOT_FOUND -- Cannot find the interface name.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceName
(
    Profile profileRef                      IN, ///< The profile reference.
    string  ifName[NAME_MAX_LEN]            OUT ///< The interface name.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data call session handler.
 *
 * @param[in] profileRef The profile reference.
 * @param[in] state      The connection state.
 * @param[in] info       The connection information.
 * @param[in] contextPtr The context provided by the application when adding the event handler.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER SessionStateHandler
(
    Profile      profileRef                 IN, ///< The profile reference.
    ConState     state                      IN, ///< The connection state.
    StateInfo    info                       IN  ///< The connection information.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data call session event.
 */
//--------------------------------------------------------------------------------------------------
EVENT SessionState
(
    Profile             profileRef, ///< The profile reference.
    SessionStateHandler handler     ///< The event handler reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for roaming status.
 *
 * @param[in] roamingStatusInd Roaming status indication.
 * @param[in] contextPtr The context provided by the application when adding the event handler.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER RoamingStatusHandler
(
    RoamingStatusInd roamingStatusInd IN    ///< Roaming status indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report roaming status.
 */
//--------------------------------------------------------------------------------------------------
EVENT RoamingStatus
(
    RoamingStatusHandler handler            ///< Handler for roaming status.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for throttled status.
 *
 * @param[in] profileRef  The profile reference.
 * @param[in] isThrottled True when APN is throttled. False when APN is unthrottled.
 * @param[in] ipv4RemainingTime The remaining ipv4 throttled time if isThrottled is True;
 * otherwise 0.
 * @param[in] ipv6RemainingTime The remaining ipv6 throttled time if isThrottled is True;
 * otherwise 0.
 * Later remaining time can be fetched by using taf_dcs_GetAPNThrottledStatus()
 *
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER ThrottledStatusHandler
(
    Profile    profileRef        IN, ///< The profile reference.
    bool       isThrottled       IN, ///< True when APN is throttled. False when APN is unthrottled.
    uint32     ipv4RemainingTime IN, ///< The remaining IPv4 throttled time in milliseconds.
    uint32     ipv6RemainingTime IN  ///< The remaining IPv6 throttled time in milliseconds.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report APN throttled status. The handler will be called separately for every APN
 * that is throttled or unthrottled.
 *
 */
//--------------------------------------------------------------------------------------------------
EVENT ThrottledStatus
(
    Profile                profileRef,         ///< The profile reference.
    ThrottledStatusHandler handler             ///< Handler for throttled status.
);


//--------------------------------------------------------------------------------------------------
/**
 * Handler for QOS status.
 *
 * @instaging
 *
 * @param[in] profileRef The profile reference.
 * @param[in] qosState   The QOS state.
 * @param[in] qosFlowRef The QOS flow reference.
 *
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER QosStatusHandler
(
    QosFlow qosFlowRef IN,     ///< The QOS flow reference.
    QosFlowState qosState IN   ///< QOS state.
);

//--------------------------------------------------------------------------------------------------
/**
 * The QOS flow change event.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
EVENT QosStatus
(
    Profile profileRef,      ///< The profile reference.
    QosStatusHandler handler ///< Handler for QOS flow status.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for hardware acceleration state change events.
 *
 * @instaging
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER HwAccelerationStateHandler
(
    Profile             profileRef IN, ///< The profile reference.
    HwAccelerationState state      IN  ///< The hardware acceleration state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report when a change occurs in hardware acceleration state.<br>
 * If reported state is TAF_DCS_HW_ACCELERATION_INACTIVE: Data calls will take software
 * acceleration path.<br>
 * If reported state is TAF_DCS_HW_ACCELERATION_ACTIVE: Data calls that are started after
 * this event invocation will be hardware accelerated. Data calls that are already started will
 * continue without hardware acceleration. Clients could stop and restart active data calls in
 * order to use hardware acceleration.
 *
 * @instaging
 *
 */
//--------------------------------------------------------------------------------------------------
EVENT HwAccelerationState
(
    Profile profileRef,                            ///< The profile reference.
    HwAccelerationStateHandler handler             ///< Handler for hardware acceleration state.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the roaming status.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters.
