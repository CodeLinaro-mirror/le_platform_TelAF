provides:
{
    api:
    {
        taf_sim.api
        taf_simRsp.api
    }
}

requires:
{
    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        $TELAF_ROOT/components/stub/taf_pa_sim
    }

    lib:
    {
        lib/libtelux_tel.so
        lib/libtelux_common.so
    }

    api:
    {
        taf_pm.api
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -I$TELAF_ROOT/components/stub/taf_pa_sim
    -ltelux_tel
    -ltelux_common
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    //-DLEGATO_API_COMPAT
}

sources:
{
    tafSimCardImpl.cpp
    tafSimCardSvc.cpp
    tafRSP.cpp
    tafRSPImpl.cpp
}
