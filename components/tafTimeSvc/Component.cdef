cxxflags:
{
    -I$TELAF_ROOT/include
    -I$LEGATO_ROOT/components/watchdogChain
    -I$LEGATO_BUILD/framework/libjansson/include
    -I$TELAF_ROOT/components/tafHalComp
    -I$TELAF_ROOT/include/vhal
    -I$TELAF_ROOT/components/tafGptpLibrary
    -I$TELAF_PA_DEFAULT/include
    -O
    -Wno-error
    -DTAFPA_ENABLE_LEGACY_MACROS=1
}

ldflags:
{
    -L$TELAF_DEFAULT_PA_LIB_DIR/lib
}

sources:
{
    tafTimeSvc.cpp
    tafTimeImpl.cpp
}

requires:
{
    component:
    {
        $TELAF_ROOT/components/tafHalComp
        $TELAF_ROOT/components/tafGptpLibrary
    }

    api:
    {
        taf_mngdStorSecData.api [optional]
        taf_pm.api              [optional]
        le_appInfo.api
    }

    lib:
    {
        libComponent_taf_pa_time.so
        libComponent_taf_pa_timeDef.so
    }
}
provides:
{
    api:
    {
         taf_time.api  [manual-start]
    }
}

ldflags:
 {
     -ljansson
 }

bundles:
{
    file:
    {
        [r] tafTimeSvc.json   /
    }
}
