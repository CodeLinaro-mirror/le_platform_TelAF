externalBuild:
{
    "capicxx-core-gen -sk $TELAF_ROOT/apps/ivss/fidl/LocationSvc/LocationSvc.fidl"
    "capicxx-core-gen -sk $TELAF_ROOT/apps/ivss/fidl/LocationSvc/LocationSvc.fdepl"
    "capicxx-someip-gen $TELAF_ROOT/apps/ivss/fidl/LocationSvc/LocationSvc.fdepl"

    "bash $TELAF_ROOT/apps/ivss/common/make.sh LocationSvc"
}

bundles:
{
    file:
    {
        $BUILDDIR/build/libLocationSvc-someip.so   /lib/
    }
}

provides:
{
    headerDir:
    {
        $BUILDDIR/src-gen
    }
}
