maxThreads: 300

username: telaf

startGroup: 1

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
        tafSimCardSvc = ( $TELAF_ROOT/components/tafSimCardSvc )
}
start: auto

processes:
{
        run:
        {
                (tafSimCardSvc)
        }

        maxFileBytes: 8192K
        faultAction: restart
}

bindings:
{
}

extern:
{
        tafSimCardSvc.tafSimCardSvc.taf_sim
        tafSimCardSvc.tafSimCardSvc.taf_rsp
}

