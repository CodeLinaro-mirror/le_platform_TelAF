/**
 * This function performs a "WARM" restart of the GNSS device.
 *
 * @return
 *  - LE_FAULT         On failure.
 *  - LE_NOT_PERMITTED If the GNSS device state is not enabled or not started.
 *  - LE_OK            On Success.
 *
 * @note This API has a platform dependent feature.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ForceWarmRestart
(
);

//--------------------------------------------------------------------------------------------------
/**
 * This function performs a "COLD" restart of the GNSS device.
 *
 * @return
 *  - LE_FAULT         On failure.
 *  - LE_NOT_PERMITTED If the GNSS device state is not enabled or not started.
 *  - LE_OK            On success.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ForceColdRestart
(
);

//--------------------------------------------------------------------------------------------------
/**
 * This function performs a "FACTORY" restart of the GNSS device.
 *
 * @return
 *  - LE_FAULT         On failure.
 *  - LE_NOT_PERMITTED If the GNSS device state is not enabled or not started.
 *  - LE_OK            On Success.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ForceFactoryRestart
(
);

//--------------------------------------------------------------------------------------------------
/**
 * This function performs a "HOT" restart of the GNSS device.
 *
 * @return
 *  - LE_FAULT         On failure.
 *  - LE_NOT_PERMITTED If the GNSS device state is not enabled or not started.
 *  - LE_OK            On Success.
 *
 * @note This API can be used to restart the GNSS device. It is equivalent calling taf_gnss_Stop()
 *       and taf_gnss_Start().
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ForceHotRestart
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Returns a bitmask containing all satellite constellations supported on this platform
 *
 * @return LE_OK               On Success.
 * @return LE_UNSUPPORTED      Not supported on this platform.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSupportedConstellations
(
 ConstellationBitMask constellationMask  OUT  ///< Supported GNSS constellations
);

//--------------------------------------------------------------------------------------------------
/**
 * This function sets the GNSS minimum elevation.
 *
 * @return
 *  - LE_OK           On Success
 *  - LE_FAULT        On Failure
 *  - LE_OUT_OF_RANGE if the minimum elevation value is above the range
 *  - LE_UNSUPPORTED  Not supported
 *
 * @warning The settings are platform dependent.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMinElevation
(
 uint8 minElevation IN  ///< Minimum elevation in degrees
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the GNSS minimum elevation.
 *
 * @return
 *  - LE_OK          On Success
 *  - LE_FAULT       On Failure
 *  - LE_UNSUPPORTED Not supported
 *
 * @note If the caller is passing n null pointer to this function, it is a fatal error, the
 *       function will not return.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMinElevation
(
 uint8  minElevationPtr OUT  ///< Minimum elevation in degrees [range 0 to 90]
);

//--------------------------------------------------------------------------------------------------
/**
 * This function sets the enabled NMEA sentences using a bit mask.
 *
 * @return
 *  - LE_OK             On Success
 *  - LE_BAD_PARAMETER  Bit mask exceeds the maximal value
 *  - LE_FAULT          On Failure
 *  - LE_BUSY           Service is busy
 *  - LE_TIMEOUT        Timeout occurred
 *  - LE_NOT_PERMITTED  GNSS device state is not in "ready".
 *
 * @warning This function may be subject to limitations depending on the platform.
 *
 * @note Some NMEA sentences are unsupported depending on the platform.
 * Setting an unsuported NMEA sentence will report an error.
 *
 * LE_GNSS_NMEA_MASK_PQXFI is deprecated to be used. LE_GNSS_NMEA_MASK_PTYPE should be used instead.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNmeaSentences
(
 NmeaBitMask nmeaMask      IN  ///< Bit mask for enabled NMEA sentence types.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the bit mask for the enabled NMEA sentences.
 *
 * @return
 *  - LE_OK             On Success
 *  - LE_FAULT          On Failure
 *  - LE_BUSY           Service is busy
 *  - LE_TIMEOUT        Timeout occurred
 *  - LE_NOT_PERMITTED  GNSS device state is not in "ready"
 *
 * @note If the caller is passing a null pointer to this function, it is a fatal error, the
 *       function will not return.
 *
 * @note Some NMEA sentences are unsupported depending on the platform.
 * The bit mask for an unset or unsupported NMEA sentence is zero.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNmeaSentences
(
 NmeaBitMask nmeaMaskPtr     OUT  ///< Bit mask for enabled NMEA sentence types.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function Set the Dead Reckoning configuration Parameters
 *
 * @return
 *  - LE_OK             On Success
 *  - LE_FAULT          On Failure
 *  - LE_BUSY           Service is busy
 *  - LE_TIMEOUT        Timeout occurred
 *  - LE_NOT_PERMITTED  GNSS device state is not in "ready"
 *
 * @note If the caller is passing a null pointer to this function, it is a fatal error, the
 *       function will not return.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDRConfig
(
 DrParams drParamsPtr  IN ///<The structure reference which passes Dead Reckoning parameters
);

