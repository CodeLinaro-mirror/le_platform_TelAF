provides:
{
    api:
    {
        taf_voicecall.api
    }
}

requires:
{
    api:
    {
        taf_ecall.api [optional]
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        $TELAF_PA_DEFAULT/component/taf_pa_voicecallDef
        // stub component only for build purpose
        $LEGATO_BUILD/stub/component/taf_pa_voicecall
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
	-I$TELAF_PA_DEFAULT/include
}

sources:
{
    tafVoiceCallImpl.cpp
    tafVoiceCallSvr.cpp
}

