provides:
{
    api:
    {
        taf_diagDidStore.api [manual-start]
    }
}

requires:
{
    component:
    {
        $TELAF_ROOT/components/tafHalComp
        $TELAF_ROOT/components/tafDataAccessComp/tafDIDDataAccessComp
    }
    api:
    {
        taf_diagDataID.api [manual-start]
        le_appInfo.api
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -I$TELAF_ROOT/components/tafHalComp
    -I$TELAF_ROOT/include/plugin
    -I${LEGATO_ROOT}/framework/liblegato
    -I $TELAF_ROOT/components/tafDataAccessComp/tafDIDDataAccessComp

}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -I $TELAF_ROOT/components/tafDataAccessComp/tafDIDDataAccessComp
}

sources:
{
        tafDidStoreSvc.cpp
        tafDidStoreImpl.cpp
}

bundles:
{
    file:
    {
        // Include a default DID config file
        [r] tafDidStore.json   /
    }
}
