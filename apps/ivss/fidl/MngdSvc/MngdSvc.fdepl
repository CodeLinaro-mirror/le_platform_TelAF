import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "platform:/plugin/org.genivi.commonapi.core/deployment/CommonAPI_deployment_spec.fdepl"
import "MngdSvc.fidl"
import "../common/CommonTypes.fdepl"

define org.genivi.commonapi.core.deployment for interface com.qualcomm.qti.modem.MngdSvc
{
    DefaultEnumBackingType = UInt32
}

define org.genivi.commonapi.someip.deployment for interface com.qualcomm.qti.modem.MngdSvc
{
    SomeIpServiceID = 0xED83
}

define org.genivi.commonapi.someip.deployment for provider as Service
{
    instance com.qualcomm.qti.modem.MngdSvc
    {
        InstanceId = "modem.MngdSvc"

        SomeIpInstanceID = 1
    }
}
