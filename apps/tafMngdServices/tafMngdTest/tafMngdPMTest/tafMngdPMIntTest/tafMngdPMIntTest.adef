maxThreads: 600
sandboxed: false

executables:
{
    tafMngdPMIntTest = (
      $TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdPMTest/tafMngdPMIntTest/tafMngdPMIntTestComponent )
    tafMngdPMIntTestHelper = (
      $TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdPMTest/tafMngdPMIntTest/tafMngdPMIntTestComponent )
}

start: manual

processes:
{
    run:
    {
        (tafMngdPMIntTest)
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafMngdPMIntTest.tafMngdPMIntTestComponent.taf_mngdPm -> tafMngdPMSvc.taf_mngdPm
    tafMngdPMIntTestHelper.tafMngdPMIntTestComponent.taf_mngdPm -> tafMngdPMSvc.taf_mngdPm
}
