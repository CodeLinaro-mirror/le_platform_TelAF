maxThreads: 600
sandboxed: false
executables:
{
    tafAudioUnitTest = ( tafAudioUnitTestComp )
}

processes:
{
     run:
    {
        ( tafAudioUnitTest )
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafAudioUnitTest.tafAudioUnitTestComp.taf_audio -> tafAudioSvc.taf_audio
}
