/**
 * @page c_tafDataCallSvc Data Call Service
 *
 * @ref taf_dcs_interface.h "API Reference"
 *
 * <HR>
 *
 * The Data Call service API is used for applications to manage data calls and data profiles.
 * It provides APIs over a mobile network.
 *
 * @section c_taf_dcs_binding IPC interfaces binding
 *
 * All functions of this API are provided by the @b tafDataCallSvc application service.
 *
 * The following example illustrates how to bind to the data call service.
 *
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_dcs -> tafDataCallSvc.taf_dcs
   }
   @endverbatim
 *
 * @section c_taf_dcs_start_data_call Starting a data call
 *
 * A synchronous data call can be started using taf_dcs_StartSession() with the profile 
 * reference passed as parameters.
 *
 * @verbatim
   result = taf_dcs_StartSession(profileReference);
   if (result != LE_OK)
   {
      LE_ERROR("Fail to start data call.");
      return result;
   }
   @endverbatim
 *
 * An asynchronous data call can be started using taf_dcs_StartSessionAsync() with the profile
 * reference passed as parameters.
 *
 * @verbatim
   result = taf_dcs_StartSessionAsync(profileReference);
   if (result != LE_OK)
   {
      LE_ERROR("Fail to start data call.");
      return result;
   }
   @endverbatim
 *
 * Before starting an asynchronous data call, an application registers a state handler using
 * taf_dcs_AddSessionStateHandler(). Once the data call state changes the handler will be called
 * indicating the new state.
 *
 * @verbatim
   sessionStateRef = taf_dcs_AddSessionStateHandler(profileReference,
                    (taf_dcs_SessionStateHandlerFunc_t)data_event_handler, NULL);
   @endverbatim
 *
 * An application can stop a synchronous data call by using taf_dcs_StopSession() and stop an
 * asynchronous data call by using taf_dcs_StopSessionAsync(). To stop an asynchronous data
 * call, an application needs to invoke taf_dcs_RemoveSessionStateHandler() to remove the session
 * handler.
 *
 * @note When an application starts a data call using taf_dcs_StartSession() or
 * taf_dcs_StartSessionAsync() and the application loses the connection with the data call service,
 * the data call will be automatically stopped by the data call service.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * The common name (string) maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NAME_MAX_LEN = 64;

//--------------------------------------------------------------------------------------------------
/**
 * The common name (string) maximum Bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NAME_MAX_BYTES = (NAME_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of call contexts.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_CALL_OBJ = 32;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of session references.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_SESSION_REF = 32;

//--------------------------------------------------------------------------------------------------
/**
 * The APN name (string) maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE APN_NAME_MAX_LEN = NAME_MAX_LEN;

//--------------------------------------------------------------------------------------------------
/**
 * The APN name (string) maximum Bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE APN_NAME_MAX_BYTES = (APN_NAME_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * The authorized username (string) maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  USER_NAME_MAX_LEN = NAME_MAX_LEN;

//--------------------------------------------------------------------------------------------------
/**
 * The authorized user's password (string) maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  PASSWORD_NAME_MAX_LEN = NAME_MAX_LEN;

//--------------------------------------------------------------------------------------------------
/**
 * The authorized user's username (string) maximum Bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  USER_NAME_MAX_BYTES  = (USER_NAME_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * The authorized user's password (string) maximum Bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  PASSWORD_NAME_MAX_BYTES  = (PASSWORD_NAME_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * The IPv4 address maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IPV4_ADDR_MAX_LEN = 16;

//--------------------------------------------------------------------------------------------------
/**
 * The IPv6 address ("ffff:ffff:ffff:ffff:ffff:ffff:255:255:255:255") maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IPV6_ADDR_MAX_LEN = 46;

//--------------------------------------------------------------------------------------------------
/**
 * The default cellular profile index.
 */
//--------------------------------------------------------------------------------------------------
DEFINE DEFAULT_PROFILE = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the cellular profile context.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Profile;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the data call session context.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Call;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of entries for cellular profiles.
 */
//--------------------------------------------------------------------------------------------------
DEFINE PROFILE_LIST_MAX_ENTRY = 32;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of mappings for a handler session.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_ASYNC_HANDLER_MAPPING = 20;

//--------------------------------------------------------------------------------------------------
/**
 * The squash gateway addresses used by net APIs
 */
//--------------------------------------------------------------------------------------------------
STRUCT DefaultGatewayAddresses
{
    string  ipv4Addr[IPV4_ADDR_MAX_LEN];    ///< The IPv4 address.
    string  ipv6Addr[IPV6_ADDR_MAX_LEN];    ///< The IPv6 address.
};

//--------------------------------------------------------------------------------------------------
/**
 * The squash DNS addresses used by net APIs.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DnsServerAddresses
{
    string  ipv4Addr1[IPV4_ADDR_MAX_LEN];   ///< The primary IPv4 DNS address.
    string  ipv4Addr2[IPV4_ADDR_MAX_LEN];   ///< The secondary IPv4 DNS address.
    string  ipv6Addr1[IPV6_ADDR_MAX_LEN];   ///< The primary IPv6 DNS address.
    string  ipv6Addr2[IPV6_ADDR_MAX_LEN];   ///< The secondary IPv6 DNS address.
};

//--------------------------------------------------------------------------------------------------
/**
 * The supported data bearer technology.
 */
//--------------------------------------------------------------------------------------------------
ENUM DataBearerTechnology
{
    // CDMA related
    DATA_BEARER_TECHNOLOGY_UNKNOWN,               ///< Unknown.
    DATA_BEARER_TECHNOLOGY_CDMA2000_1X,           ///< CDMA 1XF.
    DATA_BEARER_TECHNOLOGY_CDMA2000_EVDO,         ///< CDMA Rev 0.
    DATA_BEARER_TECHNOLOGY_CDMA2000_EVDO_REVA,    ///< CDMA Rev A.
    DATA_BEARER_TECHNOLOGY_CDMA2000_EVDO_REVB,    ///< CDMA Rev B.
    DATA_BEARER_TECHNOLOGY_CDMA2000_EHRPD,        ///< CDMA EHPRD.
    DATA_BEARER_TECHNOLOGY_CDMA2000_HRPD,         ///< CDMA HPRD.
    DATA_BEARER_TECHNOLOGY_CDMA_EVDO_FMC,         ///< CDMA FMC.
    DATA_BEARER_TECHNOLOGY_3GPP2_WLAN,            ///< IWLAN.
    //UMTS related
    DATA_BEARER_TECHNOLOGY_WCDMA,                 ///< WCDMA (UMTS).
    DATA_BEARER_TECHNOLOGY_GPRS,                  ///< GPRS.
    DATA_BEARER_TECHNOLOGY_HSDPA,                 ///< HSDPA.
    DATA_BEARER_TECHNOLOGY_HSUPA,                 ///< HSUPA.
    DATA_BEARER_TECHNOLOGY_EDGE,                  ///< EDGE.
    DATA_BEARER_TECHNOLOGY_LTE,                   ///< LTE.
    DATA_BEARER_TECHNOLOGY_HSDPA_PLUS,            ///< HSDPA_PLUS.
    DATA_BEARER_TECHNOLOGY_DC_HSDPA_PLUS,         ///< DC_HSDPA_PLUS.
    DATA_BEARER_TECHNOLOGY_HSPA,                  ///< HSPA.
    DATA_BEARER_TECHNOLOGY_64_QAM,                ///< 64 QAM.
    DATA_BEARER_TECHNOLOGY_TD_SCDMA,              ///< TDS-CDMA.
    DATA_BEARER_TECHNOLOGY_GSM,                   ///< GSM.
    DATA_BEARER_TECHNOLOGY_3GPP_WLAN,             ///< IWLAN.
    DATA_BEARER_TECHNOLOGY_5G,                    ///< NR5G.
};

//--------------------------------------------------------------------------------------------------
/**
 * The supported data cellular call connection event.
 */
//--------------------------------------------------------------------------------------------------
ENUM ConState
{
    DISCONNECTED,                           ///< Disconnected state.
    CONNECTING,                             ///< Connecting state.
    CONNECTED,                              ///< Connected state.
    DISCONNECTING,                          ///< Disconnecting state.
};

//--------------------------------------------------------------------------------------------------
/**
 * The data profile PDP type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Pdp
{
    PDP_UNKNOWN,                            ///< Unknown.
    PDP_IPV4,                               ///< IPv4.
    PDP_IPV6,                               ///< IPv6.
    PDP_IPV4V6                              ///< IPv4 and IPv6.
};

//--------------------------------------------------------------------------------------------------
/**
 * The data profile authentication type.
 */
//--------------------------------------------------------------------------------------------------
BITMASK Auth
{
    AUTH_NONE,                              ///< None.
    AUTH_PAP,                               ///< PAP.
    AUTH_CHAP                               ///< CHAP.
};

//--------------------------------------------------------------------------------------------------
/**
 * The data profile technology type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Tech
{
    TECH_UNKNOWN,                           ///< Unknown.
    TECH_3GPP,                              ///< 3GPP.
    TECH_3GPP2,                             ///< 3GPP2.
    TECH_ANY                                ///< Any.
};

//--------------------------------------------------------------------------------------------------
/**
 * Additional state information.
 * IP: The IP Type of this event, e.g.,
 *     which interface (IPv4/IPv6) is supported on a CONNECTED event.
 */
//--------------------------------------------------------------------------------------------------
STRUCT StateInfo
{
    Pdp      ipType;
};

//--------------------------------------------------------------------------------------------------
/**
 * Starts a synchronous data cellular session for the given profile reference.
 *
 * @return
 * - LE_OK                           Succeessfully started the data call.
 * - LE_NOT_FOUND                    Parameter is invalid or couldn't create the data call.
 * - LE_OUT_OF_RANGE                 PDP type is unknown.
 * - LE_DUPLICATE                    If the data session is already connected for the given profile.
 * - LE_IN_PROGRESS                  The profile is in use and data call is in progress.
 * - LE_TIMEOUT                      Timed out when attempting to make the data call.
 * - LE_FAULT                        Failed to make the data call.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartSession
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  The handler for asynchronous session start or stop result response.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncSessionHandler
(
    Profile      profileRef                 IN, ///< The profile reference.
    le_result_t  result                     IN  ///< The result of starting or stopping session.
);

//--------------------------------------------------------------------------------------------------
/**
 * Starts (asynchronously) a cellular data session for the given profile reference.
 *
 * @return None.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION StartSessionAsync
(
    Profile profileRef                      IN, ///< The profile reference.
    AsyncSessionHandler handler             IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Stops (synchronously) a cellular data session for the given profile reference.
 *
 * @return
 * - LE_OK                           Successfully stopped the data call.
 * - LE_NOT_FOUND                    Can't find a data call.
 * - LE_OUT_OF_RANGE                 PdpType type is unknown.
 * - LE_BAD_PARAMETER                Call context is NULL.
 * - LE_TIMEOUT                      Timeout to stop a data call.
 * - LE_IN_PROGRESS                  The profile is in use and data call is in progress.
 * - LE_FAULT                        Failed to stop a data call.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StopSession
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Stops (asynchronously) a cellular data session for the given profile reference.
 *
 * @return None.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION StopSessionAsync
(
    Profile profileRef                      IN, ///< The profile reference.
    AsyncSessionHandler handler             IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets a connected data call interface name.
 *
 * @return
 * - LE_OK                           Successfully retrieved the interface name.
 * - LE_NOT_POSSIBLE                 Invalid status.
 * - LE_NOT_FOUND                    Failed to get the interface name.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceName
(
    Profile profileRef                      IN, ///< The profile reference.
    string  ifName[NAME_MAX_LEN]            OUT ///< The interface name.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data call session handler.
 */
//--------------------------------------------------------------------------------------------------
HANDLER SessionStateHandler
(
    Profile      profileRef                 IN, ///< The profile reference.
    ConState     state                      IN, ///< The connection state.
    StateInfo    info                       IN  ///< The connection information.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data call session event.
 */
//--------------------------------------------------------------------------------------------------
EVENT SessionState
(
    Profile             profileRef, ///< The profile reference.
    SessionStateHandler handler     ///< The event handler reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv4 address.
 *
 * @return
 * - LE_OK                           Successfully retrieved the IPv4 address.
 * - LE_NOT_FOUND                    Failed to get the IPv4 address.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv4Address
(
    Profile profileRef,                     ///< The profile reference.
    string  ipAddr[IPV4_ADDR_MAX_LEN] OUT   ///< The IPv4 address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv4 gateway address.
 *
 * @return
 * - LE_OK                           Successfully retrieved the IPv4 gateway address.
 * - LE_NOT_FOUND                    Failed to get the IPv4 gateway address.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv4GatewayAddress
(
    Profile profileRef                      IN,  ///< The profile reference.
    string  gatewayAddr[IPV4_ADDR_MAX_LEN]  OUT  ///< The IPv4 gateway address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session primary and secondary DNS IPv4 addresses.
 *
 * @return
 * - LE_OK                           Successfully retrieved the IPv4 DNS address.
 * - LE_NOT_FOUND                    Failed to get the IPv4 DNS address.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv4DNSAddresses
(
    Profile profileRef                     IN,  ///< The profile reference.
    string  dns1AddrStr[IPV4_ADDR_MAX_LEN] OUT, ///< The IPv4 primary DNS address.
    string  dns2AddrStr[IPV4_ADDR_MAX_LEN] OUT  ///< The IPv4 secondary DNS address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv6 address.
 *
 * @return
 * - LE_OK                           Successfully retrieved the IPv6 address.
 * - LE_NOT_FOUND                    Failed to get the IPv6 address.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv6Address
(
    Profile profileRef                      IN, ///< The profile reference.
    string  ipAddr[IPV6_ADDR_MAX_LEN]       OUT ///< The IPv6 address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv6 gateway address.
 *
 * @return
 * - LE_OK                           Successfully retrieved the IPv6 gateway address.
 * - LE_NOT_FOUND                    Failed to get IPv6 gateway address.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv6GatewayAddress
(
    Profile profileRef                      IN, ///< The profile reference.
    string  gatewayAddr[IPV6_ADDR_MAX_LEN] OUT  ///< The IPv6 gateway address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session primary and secondary DNS IPv6 addresses.
 *
 * @return
 * - LE_OK                           Successfully retrieved the IPv6 DNS address.
 * - LE_NOT_FOUND                    Failed to get IPv6 DNS address.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv6DNSAddresses
(
    Profile profileRef                      IN, ///< The profile reference.
    string  dns1AddrStr[IPV6_ADDR_MAX_LEN] OUT, ///< The IPv6 primary DNS address.
    string  dns2AddrStr[IPV6_ADDR_MAX_LEN] OUT  ///< The IPv6 secondary DNS address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data session's current state.
 *
 * @return
 * - LE_OK                           Successfully retrieved the session state.
 * - LE_NOT_FOUND                    Failed to get the session state.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSessionState
(
    Profile       profileRef                IN, ///< The profile reference.
    ConState      connectionState           OUT ///< The connection state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Checks if the data session is IPv4.
 *
 * @return
 * - True         IPv4.
 * - False        Not IPv4 or the profile reference is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsIPv4
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Checks if the data session is IPv6.
 *
 * @return
 * - True         IPv6.
 * - False        Not IPv6 or the profile reference is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsIPv6
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session data bearer technology.
 *
 * @return
 * - LE_OK                           Successfully retrieved the data bearer technology.
 * - LE_NOT_FOUND                    Failed to get the data bearer technology.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDataBearerTechnology
(
    Profile profileRef                       IN,  ///< The profile reference.
    DataBearerTechnology dlDataBearerTechPtr OUT, ///< The downlink data bearer technology.
    DataBearerTechnology ulDataBearerTechPtr OUT  ///< The uplink data bearer technology.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data profile structure.
 */
//--------------------------------------------------------------------------------------------------
STRUCT ProfileInfo
{
    uint32 index;                           ///< The profile index.
    Tech   tech;                            ///< The technology.
    string name[NAME_MAX_LEN];              ///< The profile name.
};

//--------------------------------------------------------------------------------------------------
/**
 * The handler of the requesting data profile list.
 */
//--------------------------------------------------------------------------------------------------
HANDLER ProfileListHandler
(
    le_result_t  result                                 IN, ///< The result.
    ProfileInfo  profileList[PROFILE_LIST_MAX_ENTRY]    IN  ///< The profile list information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile list.
 *
 * @return
 * - LE_OK                           Successfully retrieved the profile list.
 * - LE_FAULT                        Failed to get the profile list.
 */
FUNCTION le_result_t GetProfileList
(
    ProfileInfo profileList[PROFILE_LIST_MAX_ENTRY]  OUT    ///< The profile list information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the default profile index.
 *
 * @return uint32                          The profile index.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION uint32 GetDefaultProfileIndex
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the default profile index corresponding to the specified profile index.
 *
 * @return
 * - LE_OK                           Successfully set the default data profile index.
 * - LE_FAULT                        Failed to set the default data profile index.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDefaultProfileIndex
(
    uint32 profileId                        IN ///< The profile index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the profile reference for the given profile index.
 *
 * @return
 * - NULL                            Error. 
 * - Others                          The profile reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Profile GetProfile
(
    uint32 profileId                        IN ///< The profile index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the profile index for the given profile reference.
 *
 * @return uint32                          The profile index.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION uint32 GetProfileIndex
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the data profile APN name.
 *
 * @return
 * - LE_OK                           Successfully set the APN.
 * - LE_NOT_FOUND                    Profile reference was not found.
 * - LE_FAULT                        Failed to set the APN.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAPN
(
    Profile profileRef                      IN, ///< The profile reference.
    string  apnName[APN_NAME_MAX_LEN]       IN  ///< The APN name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile APN name.
 *
 * @return
 * - LE_OK                           Successfully retrieved the APN.
 * - LE_NOT_FOUND                    Failed to get the APN.
 * - LE_OVERFLOW                     Apn size is smaller than APN_NAME_MAX_BYTES.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAPN
(
    Profile profileRef                      IN, ///< The profile reference.
    string  apnName[APN_NAME_MAX_LEN]       OUT ///< The APN name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the data profile PDP type.
 *
 * @return
 * - LE_OK                           Successfully set the PDP type.
 * - LE_NOT_FOUND                    Profile reference was not found.
 * - LE_FAULT                        Failed to set the PDP type.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPDP
(
    Profile profileRef                      IN, ///< The profile reference.
    Pdp     pdp                             IN  ///< The PDP type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile PDP type.
 *
 * @return taf_dcs_Pdp_t                   PDP type.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Pdp GetPDP
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set the data profile authentication type and username/password.
 *
 * @return
 * - LE_OK                           Successfully set the authentication type, username, and password.
 * - LE_NOT_FOUND                    Parameter error or couldn't retrieve the profile information.
 * - LE_FAULT                        Failed to set authentication type, username, and password.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAuthentication
(
    Profile profileRef                      IN, ///< The profile reference.
    Auth    auth                            IN, ///< The authentication type.
    string  userName[USER_NAME_MAX_LEN]     IN, ///< The username.
    string  password[PASSWORD_NAME_MAX_LEN] IN  ///< The password.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile authentication type and username/password.
 *
 * @return
 * - LE_OK                           Succesfully retrieved the authentication information.
 * - LE_NOT_FOUND                    Failed to get the authentication information.
 * - LE_OUT_OF_RANGE                 The size of username or password is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAuthentication
(
    Profile profileRef                      IN,  ///< The profile reference.
    Auth    auth                            OUT, ///< The authentication type.
    string  userName[USER_NAME_MAX_LEN]     OUT, ///< The username.
    string  password[PASSWORD_NAME_MAX_LEN] OUT  ///< The password.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile ID by the interface name.
 *
 * @return
 * - LE_OK                           Successfully retrieved the profile ID.
 * - LE_NOT_FOUND                    Failed to retrieve the profile ID.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetProfileIdByInterfaceName
(
    string        ifName[NAME_MAX_LEN]      IN, ///< The interface name.
    uint32        profileId                 OUT ///< The profile ID.
);
