sandboxed: false

executables:
{
        tafSimCardSvc = ( $TELAF_ROOT/components/tafSimCardSvc )
}
start: auto

processes:
{
        run:
        {
                (tafSimCardSvc)
        }

        faultAction: restart
}

bindings:
{
}

extern:
{
        tafSimCardSvc.tafSimCardSvc.taf_sim
        tafSimCardSvc.tafSimCardSvc.taf_rsp
}

