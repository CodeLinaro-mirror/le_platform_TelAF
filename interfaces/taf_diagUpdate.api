/**
 * @page c_tafDiagUpdate Diag Update Service
 *
 * @rst :ref:`API reference <File taf_diagUpdate_interface.h>` @endrst
 *
 * <HR>
 *
 * The diag update service APIs are used by applications to handle transfer requests from UDS
 * clients. The diag update service includes the TransferData(0x36), RequestTransferExit(0x37), and
 * RequestFileTransfer(0x38) services.
 *
 * @section c_taf_diagUpdate_binding IPC interfaces binding
 *
 * All functions of this API are provided by the @b tafDiagSvc platform service.
 *
 * The following example illustrates how to bind to the diag update service.
 *
 * @verbatim
   bindings:
   {
        clientExe.clientComponent.taf_diagUpdate -> tafDiagSvc.taf_diagUpdate
   }
   @endverbatim
 *
 * @section c_taf_diagUpdate_server_API Server-service APIs
 *
 * A diag update service reference can be got using taf_diagUpdate_GetService().
 * Use the returned reference for subsequent operations.
 *
 * The following example illustrates how to set up a diag update server-service-instance.
 *
 * @code
   taf_diagUpdate_ServiceRef_t diagUpdateSvcRef;    // Service reference

   // Get the service reference.
   diagUpdateSvcRef = taf_diagUpdate_GetService();
   LE_ASSERT(svcRef != NULL);
   @endcode
 *
 * @section c_taf_diag_update_Set_VlanId Set/get VLAN ID
 *
 * After getting a service reference, an application can set VLAN ID to the service to filter
 * RequestFileTransfer/TransferData/RequestTransferExit requests using taf_diagUpdate_SetVlanId().
 * It shall be called before registering the handler for the TransferData(0x36),
 * RequestTransferExit(0x37), and RequestFileTransfer(0x38) request messages. An application can
 * get the VLAN ID of the request message using taf_diagUpdate_GetVlanIdFromMsg().
 *
 * - taf_diagUpdate_SetVlanId() -- Sets the VLAN ID.
 * - taf_diagUpdate_GetVlanIdFromMsg() -- Gets the VLAN ID of the request message.
 *
 * @section c_taf_diag_update_file_transfer Request file transfer
 *
 * After getting a reference, an application registers a file transfer handler using
 * taf_diagUpdate_AddRxFileXferMsgHandler(). Once a file transfer request message is received, the
 * handler will be called indicating the new message.
 *
 * @code
   diagFileXferMsgRef = taf_diagUpdate_AddRxFileXferMsgHandler( diagUpdateSvcRef,
            fileXferMsgHandler, NULL );
   @endcode
 *
 * An application can get a file path and name, and length by using
 * taf_diagUpdate_GetFilePathAndName().
 *
 * @code
   result = taf_diagUpdate_GetFilePathAndName( rxMsgRef,
            (uint8_t *)filePathAndName, &fileLen );
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get file path and name, and length.");
        return result;
   }
   @endcode
 *
 * An application can set the file position by using taf_diagUpdate_SetFilePosition().
 *
 * @code
   result = taf_diagUpdate_SetFilePosition(rxMsgRef, sizeOfFilePosition);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to set file position as response: %d", result);
        return result;
   }
   @endcode
 *
 * An application can set the file size or directory information length
 * by using taf_diagUpdate_SetFileSizeOrDirInfoLength().
 *
 * @code
   result = taf_diagUpdate_SetFileSizeOrDirInfoLength(rxMsgRef,
                                                      fileSizeUncompressedOrDirInfoLength,
                                                      fileSizeCompressed);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to set file size or dir info len as response: %d", result);
        return result;
   }
   @endcode
 *
 * An application can send a file transfer response by using taf_diagUpdate_SendFileXferResp().
 *
 * @code
   result = taf_diagUpdate_SendFileXferResp(rxMsgRef, TAF_DIAGUPDATE_FILE_XFER_NO_ERROR);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to send response.");
        return result;
   }
   @endcode
 *
 * The following APIs are provided for request file transfer.
 *
 * - taf_diagUpdate_AddRxFileXferMsgHandler() -- Adds a handler function for the specified event.
 * - taf_diagUpdate_RemoveRxFileXferMsgHandler() -- Removes a handler function for the specified event.
 * - taf_diagUpdate_GetFilePathAndName() -- Gets the file path and name.
 * - taf_diagUpdate_GetDataFormatID() -- Gets the data format ID.
 * - taf_diagUpdate_GetUnCompFileSize() -- Gets the size of the uncompressed file.
 * - taf_diagUpdate_GetCompFileSize() -- Gets the size of the compressed file.
 * - taf_diagUpdate_SetFilePosition() -- Set the file position into a response message.
 * - taf_diagUpdate_SetFileSizeOrDirInfoLength() -- Set the file size or directory info length
 *                                                  into a response message.
 * - taf_diagUpdate_SendFileXferResp() -- Sends a response message for the file transfer message.

 * @section c_taf_diag_update_transfer_data Transfer data
 *
 * An application registers a transfer data handler using taf_diagUpdate_AddRxXferDataMsgHandler().
 * Once a transfer data request message is received, the handler will be called indicating the new
 * message.
 *
 * @code
   diagXferDataMsgRef = taf_diagUpdate_AddRxXferDataMsgHandler( diagUpdateSvcRef,
            xferDataMsgHandler, NULL );
   @endcode
 *
 * An application can get the data length and payload by using
 * taf_diagUpdate_GetXferDataParamRecLen() and taf_diagUpdate_GetXferDataParamRec() referring to the
 * following sample code snippets.
 *
 * @code
   result = taf_diagUpdate_GetXferDataParamRecLen( rxMsgRef, (uint16_t *)&xferDataLen);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get data length.");
        return result;
   }
   @endcode
 *
 * @code
   result = taf_diagUpdate_GetXferDataParamRec( rxMsgRef, xferData, &xferDataLen);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get data payload.");
        return result;
   }
   @endcode
 *
 * An application can send a transfer data response by using taf_diagUpdate_SendXferDataResp().
 *
 * @code
   result = taf_diagUpdate_SendXferDataResp( rxMsgRef, TAF_DIAGUPDATE_XFER_DATA_NO_ERROR , NULL, 0);
   if (result != LE_OK)
   {
      LE_ERROR("Fail to send response.");
      return result;
   }
   @endcode
 *
 * The following APIs are provided for transfer data.
 *
 * - taf_diagUpdate_AddRxXferDataMsgHandler() -- Adds a handler function for the specified event.
 * - taf_diagUpdate_RemoveRxXferDataMsgHandler() -- Removes a handler function for the specified event.
 * - taf_diagUpdate_GetblockSeqCount() -- Gets the block sequence counter.
 * - taf_diagUpdate_GetXferDataParamRecLen() -- Gets the data length.
 * - taf_diagUpdate_GetXferDataParamRec() -- Gets the data payload.
 * - taf_diagUpdate_SendXferDataResp() -- Sends a response message for the transfer data message.
 *
 * @section c_taf_diag_update_transfer_exit Request transfer exit
 *
 * An application registers a transfer exit handler using taf_diagUpdate_AddRxXferExitMsgHandler().
 * Once a transfer exit request message is received, the handler will be called indicating the new
 * message.
 *
 * @code
   diagXferExitMsgRef = taf_diagUpdate_AddRxXferExitMsgHandler( diagUpdateSvcRef,
            xferExitMsgHandler, NULL );
   @endcode
 *
 * An application can send a transfer exit response by using taf_diagUpdate_SendXferDataResp().
 *
 * @code
   result = taf_diagUpdate_SendXferExitResp( rxMsgRef, TAF_DIAGUPDATE_XFER_EXIT_NO_ERROR, NULL, 0 );
   if (result != LE_OK)
   {
        LE_ERROR("Fail to send response.");
        return result;
   }
   @endcode
 *
 * The following APIs are provided for request transfer exit.
 *
 * - taf_diagUpdate_AddRxXferExitMsgHandler() -- Adds a handler function for the specified event.
 * - taf_diagUpdate_RemoveRxXferExitMsgHandler() -- Removes a handler function for the specified event.
 * - taf_diagUpdate_GetXferExitParamRec() -- Gets the transfer request parameter record.
 * - taf_diagUpdate_SendXferExitResp() -- Sends a response message for the transfer exit message.
 *
 * The following APIs are provided for service reference.
 *
 * - taf_diagUpdate_GetService() -- Gets the reference to a diag update service.
 * - taf_diagUpdate_RemoveSvc() -- Removes the daig update service.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum size of the payload data in bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_PAYLOAD_SIZE = 4095;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum size of the FilePathAndName.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_PATH_AND_NAME_SIZE = 1024;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum size of the transferRequestParameterRecord.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_XFER_PARAM_REC_SIZE = 4089;

//--------------------------------------------------------------------------------------------------
/**
 * The fixed size for the filePosition
 */
//--------------------------------------------------------------------------------------------------
DEFINE FILE_POSITION_SIZE = 8;


//--------------------------------------------------------------------------------------------------
/**
 * The maximum size of the file size or directory information length (2 ^ (4 * 8) = 4G).
 */
//--------------------------------------------------------------------------------------------------
DEFINE FILE_SIZE_OR_DIR_INFO_LEN = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Request file transfer mode of operationType.
 */
//--------------------------------------------------------------------------------------------------
ENUM ModeOfOpsType
{
    ADD_FILE     = 0x01,  ///< Add a file.
    DELETE_FILE  = 0x02,  ///< Delete a file.
    REPLACE_FILE = 0x03,  ///< Replace a file.
    READ_FILE    = 0x04,  ///< Read a file.
    READ_DIR     = 0x05,  ///< Read a directory.
    RESUME_FILE  = 0x06   ///< Resume a file.
};

//--------------------------------------------------------------------------------------------------
/**
 * Error code for RequestFileTransfer.
 */
//--------------------------------------------------------------------------------------------------
ENUM FileXferErrorCode
{
    FILE_XFER_NO_ERROR = 0,                         ///< Success.
    FILE_XFER_BUSY_REPEAT_REQ = 0x21,               ///< Busy repeat request.
    FILE_XFER_CONDITIONS_NOT_CORRECT = 0x22,        ///< Condition is not correct.
    FILE_XFER_REQUEST_SEQUENCE_ERROR = 0x24,        ///< Request sequence error.
    FILE_XFER_REQUEST_OUT_OF_RANGE = 0x31,          ///< Request out of range.
    FILE_XFER_UPLOAD_DOWNLOAD_NOT_ACCEPTED = 0x70   ///< Operation is not accepted.
};

//--------------------------------------------------------------------------------------------------
/**
 * Error code for TransferData.
 */
//--------------------------------------------------------------------------------------------------
ENUM XferDataErrorCode
{
    XFER_DATA_NO_ERROR = 0,                         ///< Success.
    XFER_DATA_BUSY_REPEAT_REQ = 0x21,               ///< Busy repeat request.
    XFER_DATA_REQUEST_OUT_OF_RANGE = 0x31,          ///< Request out of range.
    XFER_DATA_TRANSFER_DATA_SUSPENDED = 0x71,       ///< Transfer data suspended.
    XFER_DATA_GENERAL_PROGRAMMING_FAILURE = 0x72,   ///< Programming failure.
    XFER_DATA_WRONG_BLOCK_SEQUENCE_COUNTER = 0x73,  ///< Wrong block sequence counter.
    XFER_DATA_VOLTAGE_TOO_HIGH = 0x92,              ///< Voltage is too high.
    XFER_DATA_VOLTAGE_TOO_LOW = 0x93                ///< Voltage is too low.
};

//--------------------------------------------------------------------------------------------------
/**
 * Error code for RequestTransferExit.
 */
//--------------------------------------------------------------------------------------------------
ENUM XferExitErrorCode
{
    XFER_EXIT_NO_ERROR = 0,                         ///< Success.
    XFER_EXIT_BUSY_REPEAT_REQ = 0x21,               ///< Busy repeat request.
    XFER_EXIT_REQUEST_SEQUENCE_ERROR = 0x24,        ///< Request sequence error.
    XFER_EXIT_REQUEST_OUT_OF_RANGE = 0x31,          ///< Request out of range.
    XFER_EXIT_GENERAL_PROGRAMMING_FAILURE = 0x72    ///< Programming failure.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the update service.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Service;

//-------------------------------------------------------------------------------------------------
/**
 * A base reference to the RequestFileTransfer/TransferData/RequestTransferExit
 * received request message.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE RxMsg;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the RequestFileTransfer received message.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE RxFileXferMsg;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the RequestFileTransfer received message.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE RxXferDataMsg;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the RequestFileTransfer received message.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE RxXferExitMsg;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference to a Diag update service, if there's no Diag update service,
 * a new one will be created.
 *
 * @return
 *     - Reference to the service instance.
 *     - NULL if not allowed to create the service.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Service GetService
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets VLAN ID to the service to filter RequestFileTransfer/TransferData/
 * RequestTransferExit requests.
 * If the VLAN ID is not found or does not existed, it will return an error.
 * This function shall be called before registering RxFileXferMsgHandler,
 * RxXferDataMsgHandler and RxXferExitMsgHandler.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_UNSUPPORTED -- VLAN ID is unknown.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetVlanId
(
    Service svcRef IN,      ///< Service reference.
    uint16 vlanId IN        ///< VLAN ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for a RequestFileTransfer message.
 *
 * @param[in] rxMsgRef   Received message reference.
 * @param[in] modeOfOps  Mode of operation.
 * @param[in] contextPtr Context pointer.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RxFileXferMsgHandler
(
    RxFileXferMsg rxMsgRef IN,     ///< Received message reference.
    ModeOfOpsType modeOfOps IN     ///< Mode of operation.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on RequestFileTransfer message.
 */
//--------------------------------------------------------------------------------------------------
EVENT RxFileXferMsg
(
    Service svcRef IN,              ///< Service reference.
    RxFileXferMsgHandler handler    ///< Received message handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the file path and name of the Rx RequestFileTransfer message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OVERFLOW -- Payload size is too small.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFilePathAndName
(
    RxFileXferMsg rxMsgRef                  IN,    ///< Receive message reference.
    uint8 fileName[MAX_PATH_AND_NAME_SIZE]  OUT    ///< File path and name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data format ID of the Rx RequestFileTransfer message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDataFormatID
(
    RxFileXferMsg rxMsgRef  IN,    ///< Receive message reference.
    uint8 dataFormatID      OUT    ///< Data format ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the size of the uncompressed file of the Rx RequestFileTransfer message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetUnCompFileSize
(
    RxFileXferMsg rxMsgRef  IN,    ///< Received message reference.
    uint32 unCompFileSize   OUT    ///< Size of the uncompressed file.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the size of the compressed file of the Rx RequestFileTransfer message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCompFileSize
(
    RxFileXferMsg rxMsgRef  IN,    ///< Received message reference.
    uint32 compFileSize     OUT    ///< Size of the compressed file.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the file position into RequestFileTransfer response message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef or wrong modeOfOperation.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetFilePosition
(
    RxFileXferMsg rxMsgRef IN,  ///< Received message reference.
    uint64 filePosition    IN   ///< Specifies the byte position for downloading file resume.
);


//--------------------------------------------------------------------------------------------------
/**
 * Sets the fileSizeUncompressedOrDirInfoLength and fileSizeCompressed
 * into RequestFileTransfer response message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef or wrong modeOfOperation.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OVERFLOW -- file size more than UINT32_MAX.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetFileSizeOrDirInfoLength
(
    RxFileXferMsg rxMsgRef                     IN, ///< Received message reference.
    uint64 fileSizeUncompressedOrDirInfoLength IN, ///< Specifies the size of the uncompressed file to be uploaded or the length of the directory information to be read in bytes.
    uint64 fileSizeCompressed                  IN  ///< Specifies the size of the compressed file in bytes.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the Rx RequestFileTransfer message.
 *
 * @b NOTE: This function must be called to send a response
 *       if receiving a RequestFileTransfer message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendFileXferResp
(
    RxFileXferMsg rxMsgRef       IN,    ///< Received message reference.
    FileXferErrorCode errCode    IN     ///< Error code type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for a TransferData message.
 *
 * @param[in] rxMsgRef   Received message reference.
 * @param[in] contextPtr Context pointer.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RxXferDataMsgHandler
(
    RxXferDataMsg rxMsgRef IN    ///< Received message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on TransferData message.
 */
//--------------------------------------------------------------------------------------------------
EVENT RxXferDataMsg
(
    Service svcRef IN,              ///< Service reference.
    RxXferDataMsgHandler handler    ///< Received message handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the block sequence counter of the Rx TransferData message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetblockSeqCount
(
    RxXferDataMsg rxMsgRef IN,    ///< Received message reference.
    uint8 count            OUT    ///< Block sequence counter.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the the data request record length of the Rx TransferData message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetXferDataParamRecLen
(
    RxXferDataMsg rxMsgRef    IN,    ///< Received message reference.
    uint16 xferDataRecLen     OUT    ///< Transfer data request parameter record length.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the transfer data request record of the Rx TransferData message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_OVERFLOW -- Payload size is too small.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetXferDataParamRec
(
    RxXferDataMsg rxMsgRef                      IN,    ///< Received message reference.
    uint8 xferDataRec[MAX_XFER_PARAM_REC_SIZE]  OUT    ///< Transfer data request parameter record.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the Rx TransferData message.
 *
 * @b NOTE: This function must be called to send a response
 *       if receiving a TransferData message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendXferDataResp
(
    RxXferDataMsg rxMsgRef        IN,    ///< Received message reference.
    XferDataErrorCode errCode     IN,    ///< Error code type.
    uint8 data[MAX_PAYLOAD_SIZE]  IN     ///< Payload data.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for a RequestTransferExit message.
 *
 * @param[in] rxMsgRef   Received message reference.
 * @param[in] contextPtr Context pointer.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RxXferExitMsgHandler
(
    RxXferExitMsg rxMsgRef IN    ///< Received message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on RequestTransferExit message.
 */
//--------------------------------------------------------------------------------------------------
EVENT RxXferExitMsg
(
    Service svcRef IN,              ///< Service reference.
    RxXferExitMsgHandler handler    ///< Received message handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the length of the received RequestTransferExit message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetXferExitParamRecLen
(
    RxXferExitMsg rxMsgRef    IN,    ///< Received message reference.
    uint16 exitDataRecLen     OUT    ///< Transfer exit request parameter record length.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the transfer exit request parameter record of the Rx RequestTransferExit message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_OVERFLOW -- Payload size is too small.
 *     - LE_NOT_FOUND -- Reference not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetXferExitParamRec
(
    RxXferExitMsg rxMsgRef                      IN,    ///< Received message reference.
    uint8 exitDataRec[MAX_XFER_PARAM_REC_SIZE]  OUT    ///< Transfer exit request parameter record.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the Rx RequestTransferExit message.
 *
 * @b NOTE: This function must be called to send a response
 *       if receiving a RequestTransferExit message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendXferExitResp
(
    RxXferExitMsg rxMsgRef        IN,    ///< Received message reference.
    XferExitErrorCode errCode     IN,    ///< Error code type.
    uint8 data[MAX_PAYLOAD_SIZE]  IN     ///< Payload data.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN ID of the Request RequestFileTransfer/TransferData/RequestTransferExit message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- VLAN ID not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVlanIdFromMsg
(
    RxMsg rxMsgRef  IN,         ///< Received message reference.
    uint16 vlanId   OUT         ///< VLAN ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes the Update server service.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid svcRef.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveSvc
(
    Service svcRef  IN    ///< Service reference.
);
