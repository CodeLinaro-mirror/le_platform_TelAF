maxThreads: 300

username: telaf

startGroup: 5

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafDataCallSvc = ( $TELAF_ROOT/components/tafDataCallSvc )
}

start: auto

processes:
{
    run:
    {
        (tafDataCallSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
    tafDataCallSvc.tafDataCallSvc.taf_pm -> tafPMSvc.taf_pm
}

extern:
{
    tafDataCallSvc.tafDataCallSvc.taf_dcs
    tafDataCallSvc.tafDataCallSvc.taf_mdc
}
