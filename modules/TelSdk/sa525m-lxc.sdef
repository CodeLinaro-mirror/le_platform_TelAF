//--------------------------------------------------------------------------------------------------
// TelSDK sa525m system definition that includes essential services.
//--------------------------------------------------------------------------------------------------

#include "$LEGATO_ROOT/legatoTargetConfig.sinc"

apps:
{
    // Sample Applications
    //$LEGATO_ROOT/apps/sample/helloWorld/helloWorld.adef

    // Platform Services
    $TELAF_ROOT/apps/tafServices/tafSomeipGWSvc

    // RPC proxy
    $TELAF_ROOT/apps/rpc/rpcProxy/tafRpcProxy

     // eCall Application
    $TELAF_ROOT/apps/sample/eCallDemo/tafECallAppLxc.adef
}

bindings:
{
    <telaf>.sdirTool -> <root>.sdirTool
}

interfaceSearch:
{
    $TELAF_ROOT/interfaces
    $TELAF_ROOT/interfaces/someipGW
}

cflags:
{
    -DTARGET_SA525M
}

cxxflags:
{
    -DTARGET_SA525M
}
