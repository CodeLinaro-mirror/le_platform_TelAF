//--------------------------------------------------------------------------------------------------
/**
 * Returns whether the APN is throttled or unthrottled.
 * It gets the remaining throttled time for IPv4 and IPv6 in milliseconds if isThrottled is true
 * otherwise returns 0.
 * If profile belongs to only one ipType then FFFF is returned for not supported ipType.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not created.
 *  - LE_UNAVAILABLE  -- Data profile is not throttled.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAPNThrottledStatus
(
    Profile    profileRef        IN,  ///< The profile reference.
    bool       isThrottled       OUT, ///< True when APN is throttled. False when APN is unthrottled.
    uint32     ipv4RemainingTime OUT, ///< The remaining IPv4 throttled time in milliseconds.
    uint32     ipv6RemainingTime OUT  ///< The remaining IPv6 throttled time in milliseconds.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the PLMN on which the APN is throttled.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not created.
 *  - LE_UNAVAILABLE  -- Data profile is not throttled.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAPNThrottledPLMN
(
    Profile    profileRef             IN,  ///< The profile reference.
    bool       areAllPLMNsThrottled   OUT, ///< True if APN is throttled on all PLMNs.
    string mcc[MCC_BYTES] OUT, ///< MCC of the PLMN on which the APN is throttled.
    string mnc[MNC_BYTES] OUT  ///< MNC of the PLMN on which the APN is throttled.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the maximum Tx and Rx data bit rates for an active data call.
 *
 * @return
 *  - LE_OK            -- Succeeded.
 *  - LE_BAD_PARAMETER -- Parameter error.
 *  - LE_NOT_POSSIBLE  -- Data profile is not created.
 *  - LE_UNAVAILABLE   -- Data call is not active.
 *  - LE_NOT_FOUND     -- Internal context cannot be found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMaxDataBitRates
(
    Profile    profileRef             IN,  ///< The profile reference.
    uint64     maxRxBitRate           OUT, ///< The maximum receive data rate in bits/second.
    uint64     maxTxBitRate           OUT  ///< The maximum transmit data rate in bits/second.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the call end reason. This API can be used to get the extended call end reason after a data
 * connection is disconnected.
 *
 * This API takes profile reference and TAF_DCS_PDP_IPV4 or TAF_DCS_PDP_IPV6 as parameters and
 * returns the relevant call end reason type and code respectively.
 *
 * @return
 *  - LE_OK            -- Succeeded.
 *  - LE_BAD_PARAMETER -- Parameter error.
 *  - LE_NOT_POSSIBLE  -- Data profile is not created.
 *  - LE_UNAVAILABLE   -- Data call is still active.
 *  - LE_NOT_FOUND     -- Internal context cannot be found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCallEndReason
(
    Profile           profileRef        IN,  ///< The profile reference.
    Pdp               pdpType           IN,  ///< The packet data protocol type.
    CallEndReasonType callEndReasonType OUT, ///< The call end reason type.
    int32             callEndReason     OUT  ///< The call end reason.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session MTU.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 *  - LE_OVERFLOW -- IOCTL interface name is smaller than profile interface name.
 *  - LE_IO_ERROR -- IOCTL operation failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMtu
(
    Profile profileRef                      IN,  ///< The profile reference.
    uint16  mtu                             OUT  ///< The MTU value.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the QOS flow ID.
 *
 * @instaging
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- QOS flow not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetQosId
(
    QosFlow qosFlowRef IN,           ///< The QOS flow reference.
    uint32 qosFlowId OUT             ///< QOS ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the details of the given QOS flow parameter mask.
 *
 * @instaging
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- QOS flow not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetQosParameterMask
(
    QosFlow qosFlowRef IN,                     ///< The QOS flow reference.
    QosFlowBitMask qosFlowMask OUT             ///< QOS flow bitmask.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the profile reference associated with the QOS flow.
 *
 * @instaging
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- QOS flow not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetQosProfile
(
    QosFlow qosFlowRef IN,                     ///< The QOS flow reference.
    Profile profileRef OUT
);
