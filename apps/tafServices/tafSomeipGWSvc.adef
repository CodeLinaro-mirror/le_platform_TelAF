sandboxed: false

start: auto

maxThreads: 300

username: telaf

startGroup: 0

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_RAW
    CAP_IPC_LOCK
    CAP_SYS_NICE
    CAP_SYS_RESOURCE
    CAP_NET_ADMIN
    CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
    CAP_DAC_READ_SEARCH
    CAP_DAC_OVERRIDE
#endif
}

executables:
{
    tafSomeipGWSvc = ( $TELAF_ROOT/components/tafSomeipGWSvc )
}

processes:
{
    envVars:
    {
        VSOMEIP_CONFIGURATION = tafSomeipGWSvc.json
    }

    run:
    {
        ( tafSomeipGWSvc )
    }

    faultAction: restart
}

bindings:
{
}

extern:
{
    tafSomeipGWSvc.tafSomeipGWSvc.taf_someipSvr
    tafSomeipGWSvc.tafSomeipGWSvc.taf_someipClnt
}

