//------------------------------------------------------------------------------------------------
/**
* @page c_tafwlan Wireless LAN Device Management Service
*
* @ref taf_wlan_interface.h "API Reference"
*
* <HR>
*
* Wireless LAN(WLAN) Management Service provides APIs for applications to manage the WLAN
* chipset. Before a WLAN access point or station can be started, this service's APIs should be used
* to enable and configure the WLAN chipset for proper use.
*
* @section taf_wlan_binding IPC interfaces binding
*
* The functions of this service are provided by the @b tafWlanSvc application service.
*
 * The following example illustrates how to bind to the WLAN service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_wlan -> tafWlanSvc.taf_wlan
   }
   @endverbatim
 *
*/
//--------------------------------------------------------------------------------------------------

//-------------------------------------------------------------------------------------------------
/**
 * WLAN Device state.
 */
//-------------------------------------------------------------------------------------------------
ENUM DeviceState
{
    OFF,          ///< WLAN device is OFF.
    ON,           ///< WLAN device is ON.
    UNAVAILABLE   ///< WLAN device state is not availble.
};

//-------------------------------------------------------------------------------------------------
/**
 * Supported WLAN Device modes.
 */
//-------------------------------------------------------------------------------------------------
ENUM DeviceMode
{
    MODE_UNSUPPORTED = -1,  ///< Unsupported mode.
    MODE_AP=0               ///< Single access point.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the WLAN manager.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Wlan;

//-------------------------------------------------------------------------------------------------
/*
 * Events avaiable in WLAN Device Management service.
 */
//-------------------------------------------------------------------------------------------------

//-------------------------------------------------------------------------------------------------
/*
 * The WLAN device state event handler.
 */
//-------------------------------------------------------------------------------------------------
HANDLER DeviceStateHandler
(
    Wlan WlanRef      IN, ///< The WLAN reference. Set to NULL. Reserved for future use.
    DeviceState state IN
);

//-------------------------------------------------------------------------------------------------
/*
 * Event to report the WLAN device state.
 */
//-------------------------------------------------------------------------------------------------
EVENT DeviceState
(
    Wlan WlanRef               IN, ///< The WLAN reference. Reserved for future use.
    DeviceStateHandler handler IN
);

//-------------------------------------------------------------------------------------------------
/*
 * APIs avaiable in WLAN Device Management service.
 */
//-------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Turns WLAN device ON. This action brings up the respective WLAN host interface.
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t TurnOn
(
    Wlan WlanRef      IN ///< The WLAN reference. Reserved for future use.
);

//--------------------------------------------------------------------------------------------------
/**
 * Turns WLAN device OFF. This action removes the respective WLAN host interface.
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t TurnOff
(
    Wlan WlanRef      IN ///< The WLAN reference. Reserved for future use.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the WLAN Device state.
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetState
(
    Wlan WlanRef      IN,     ///< The WLAN reference. Reserved for future use.
    DeviceState state OUT     ///< WLAN device state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the WLAN operating mode. Mode changes will take effect after a device off/on.
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMode
(
    Wlan WlanRef         IN, ///< The WLAN reference. Reserved for future use.
    DeviceMode wlanMode  IN  ///< The WLAN device mode.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the WLAN operating mode
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMode
(
    Wlan WlanRef         IN,  ///< The WLAN reference. Reserved for future use.
    DeviceMode wlanMode  OUT  ///< The WLAN device mode.
);