sandboxed: false

start: auto

maxThreads: 600

username: telaf

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
}

executables:
{
    tafDiagSvc = ( $TELAF_ROOT/components/tafDiagSvc )
}

groups:
{
}

processes:
{
    run:
    {
        (tafDiagSvc)
    }

    faultAction: restart
}

bindings:
{
}

extern:
{
    tafDiagSvc.tafDiagSvc.taf_diagReset
    tafDiagSvc.tafDiagSvc.taf_diagRoutineCtrl
    tafDiagSvc.tafDiagSvc.taf_diagUpdate
    tafDiagSvc.tafDiagSvc.taf_diagSecurity
    tafDiagSvc.tafDiagSvc.taf_diagDataID
    tafDiagSvc.tafDiagSvc.taf_diagEvent
}
