provides:
{
    api:
    {
        taf_mrc.api
    }
}

requires:
{
    component:
    {
        $LEGATO_ROOT/components/watchdogChain
    }

    lib:
    {
        lib/libtelux_platform.so
        libComponent_taf_pa_mrc.so
        libComponent_taf_pa_mrcDef.so
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -ltelux_platform
    -I$TELAF_PA_DEFAULT/include
    -std=c++17
    -DTAFPA_ENABLE_LEGACY_MACROS=1
}

ldflags:
{
    -L$TELAF_DEFAULT_PA_LIB_DIR/lib
}

sources:
{
    tafMrcSvc.cpp
    tafMrcImpl.cpp
}

