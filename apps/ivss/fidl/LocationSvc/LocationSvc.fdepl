import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "platform:/plugin/org.genivi.commonapi.core/deployment/CommonAPI-4_deployment_spec.fdepl"
import "LocationSvc.fidl"

define org.genivi.commonapi.core.deployment for typeCollection com.qualcomm.qti.telephony.LocationSvcTypes
{
    enumeration TelephonyResultT
    {
        EnumBackingType = UInt8
    }

    enumeration LocationCapabilityBitMaskT
    {
        EnumBackingType = UInt64
    }
}

define org.genivi.commonapi.someip.deployment for interface com.qualcomm.qti.telephony.LocationSvc
{
    SomeIpServiceID = 0xED84

    method GetCapabilities
    {
        SomeIpMethodID = 701
    }
}

define org.genivi.commonapi.someip.deployment for provider as Service
{
    instance com.qualcomm.qti.telephony.LocationSvc
    {
        InstanceId = "telephony.LocationSvc"

        SomeIpInstanceID = 1
    }
}