//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafwlansta Wireless LAN Station Management Service
 *
 * @rst :ref:`API reference <File taf_wlanSta_interface.h>` @endrst
 *
 * <HR>
 *
 * Wireless LAN(WLAN) Station(STA) Management Service provides APIs for applications to manage
 * station that allow the WLAN device to connect to WLAN access points. Before a WLAN
 * STA can be started, the WLAN device should be properly configured using the WLAN Management
 * Service's APIs.
 *
 * @section taf_wlansta_binding IPC interfaces binding
 *
 * The functions of this service are provided by the @b tafWlanSvc application service.
 *
 * The following example illustrates how to bind to the WLAN Station service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_wlanSta -> tafWlanSvc.taf_wlanSta
   }
   @endverbatim
 *
 */
//--------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;

USETYPES taf_wlan.api;
USETYPES taf_net.api;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum number of AP scan results that will be returned.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_APSCAN_RESULT_NUM = 24;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum number of clients that can register for connected AP signal strength events.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_CONNECTED_AP_SIGNAL_STRENGTH_CLIENTS = 2;

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA status.
 */
//--------------------------------------------------------------------------------------------------
ENUM State
{
    STATE_UNKNOWN,              ///< Station interface is unknown.
    STATE_CONNECTING,           ///< Station interface is connecting.
    STATE_CONNECTED,            ///< Station interface is connected.
    STATE_DISCONNECTED,         ///< Station interface is disconnected.
    STATE_ASSOCIATION_FAILED,   ///< Station is unable to associate with AP.
    STATE_IP_ASSIGNMENT_FAILED, ///< Station is unable to get IP address via DHCP.
    STATE_SCAN_STARTED,         ///< Available access points scan started.
    STATE_SCAN_COMPLETED,       ///< Available access points scan is complete.
    STATE_SCAN_FAILED,          ///< Available access points scan failed.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM Mode
{
    MODE_UNKNOWN=-1,   ///< To skip setting encryption method, pass UNKNOWN.
    MODE_ROUTER,       ///< Router mode.
    MODE_BRIDGE        ///< Bridge mode.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA IP address type.
 */
//--------------------------------------------------------------------------------------------------
ENUM IPType
{
    IPTYPE_UNKNOWN=-1,   ///< To skip setting encryption method, pass UNKNOWN.
    IPTYPE_DYNAMIC,      ///< Station is configured with dynamic IP.
    IPTYPE_STATIC        ///< Station is configured with Static IP.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA IP configuration.
 */
//--------------------------------------------------------------------------------------------------
STRUCT IPConfig
{
    string IPv4Addr[taf_net.IPV4_ADDR_MAX_LEN];    ///< IPv4 address to be assigned.
    string GWAddr[taf_net.IPV4_ADDR_MAX_LEN];      ///< IPv4 address of the gateway.
    string DNSAddr[taf_net.IPV4_ADDR_MAX_LEN];     ///< DNS IPv4 address.
    string NetMask[taf_net.IPV4_ADDR_MAX_LEN];     ///< Subnet mask.
};

//--------------------------------------------------------------------------------------------------
/**
 * Information about available Access Points that were found during a scan.
 */
//--------------------------------------------------------------------------------------------------
STRUCT APInfo
{
    string  BSSID[taf_wlan.MAX_BSSID_LENGTH];              ///< BSSID of the AP.
    string  SSID[taf_wlan.MAX_SSID_LENGTH];                ///< SSID of the AP.
    int16 SignalLevel;                                     ///< Signal level in dBm.
    uint16 Frequency;                                      ///< Frequency in MHz.
    taf_wlan.ServiceSet SS;                                ///< Service Set.
    taf_wlan.SecurityMode secMode;                         ///< Security Mode.
    taf_wlan.SecurityAuthMethod secAuthMethod;             ///< Security Authentication Method.
    taf_wlan.SecurityEncryptionMethod secEncryptionMethod; ///< Security Encryption Method.
    bool WPSEnabled;                                       ///< TRUE - WPS is enabled.
                                                           ///< FALSE - WPS is not enabled.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA reference to be used with WLAN STA service functions.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE WlanSTA;

//--------------------------------------------------------------------------------------------------
/**
 * The WLAN STA event handler.
 *
 * @param[in] wlanSTARef   The WLAN STA reference.
 * @param[in] staState     The WLAN STA state.
 *
 * @instaging
 *
 * @param[in] wlanSTARef The WLAN STA reference.
 * @param[in] staState   WLAN STA states.
 * @param[in] contextPtr Context pointer.
 */
//--------------------------------------------------------------------------------------------------
HANDLER Handler
(
    WlanSTA wlanSTARef IN, ///< The WLAN STA reference.
    State staState     IN  ///< The WLAN STA state.
);

//--------------------------------------------------------------------------------------------------
/*
 * STA events to report.
 *
 * @instaging
 *
 */
//--------------------------------------------------------------------------------------------------
EVENT Event
(
    WlanSTA wlanSTARef IN, ///< The WLAN STA reference.
    Handler handler IN
) = (0,1);

//--------------------------------------------------------------------------------------------------
/**
 * Connected AP signal strength event handler.
 *
 * @param[in] wlanSTARef         The WLAN STA reference.
 * @param[in] signalStrength     The signal strength in dBm.
 *
 * @instaging
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER ConnectedApSignalStrengthHandler
(
    WlanSTA  wlanSTARef     IN,  ///< The WLAN STA reference.
    int16    signalStrength IN   ///< The signal strength in dBm.
);

//--------------------------------------------------------------------------------------------------
/**
 * Connected AP signal strength event. When STA is connected to an AP, clients can register to this
 * event to receive the signal strength of the connected AP.
 *
 * The handler will be called when the signal strength of the connected AP drops below the
 * configured threshold at the configured frequency. The service will not trigger the event after
 * the signal strength goes above the threshold.
 *
 * If bAverage is true, the average of signal strength over the frequency is reported. The service
 * uses the average signal strength to stop triggering the event once the events are triggered.
 *
 * If bAverage is false, the most recent signal strength value is reported.
 *
 * The maximum number of clients that can register for this event is controlled by
 * TAF_WLANSTA_MAX_CONNECTED_AP_SIGNAL_STRENGTH_CLIENTS. The default value is 2.
 *
 * @instaging
 *
 */
//--------------------------------------------------------------------------------------------------
EVENT ConnectedApSignalStrength
(
    WlanSTA  wlanSTARef      IN,  ///< The WLAN STA reference.
    int16    signalThreshold IN,  ///< The signal threshold below which the handler will be called.
                                  ///< Values outside 0 and -100, will default to -70.
    uint16   frequency       IN,  ///< The frequency, in seconds, at which the handler will be
                                  ///< called.
                                  ///< The default minimum frequency is 5 sec and maximum is
                                  ///<  300 sec. Any other value will be set to the default.
    bool     bAverage        IN,  ///< If true, averages the signal strength values over frequency.
                                  ///< If false, reports the most recent signal strength value.
    ConnectedApSignalStrengthHandler handler IN ///< The event handler.
) = (2,3);

//--------------------------------------------------------------------------------------------------
/*
 * APIs available in WLAN Access Point Management service.
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Returns the WLAN STA reference.
 *
 * @instaging
 *
 * @return
 * - Valid reference on success.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION WlanSTA GetWlanSTA
(
    taf_wlan.STAid STAid IN,                                ///< STA identifier.
    string STAIntfName[taf_net.INTERFACE_NAME_MAX_LEN] IN   ///< STA associated host interface name.
) = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Starts the specified station.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Start
(
    WlanSTA wlanSTARef   IN     ///< The WLAN STA reference.
) = 5;

//--------------------------------------------------------------------------------------------------
/**
 * Stops the specified station.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Stop
(
    WlanSTA wlanSTARef   IN     ///< The WLAN STA reference.
) = 6;

//--------------------------------------------------------------------------------------------------
/**
 * Restarts the specified station.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Restart
(
    WlanSTA wlanSTARef   IN     ///< The WLAN STA reference.
) = 7;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the station to Bridged or Router mode.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMode
(
    WlanSTA wlanSTARef   IN,     ///< The WLAN STA reference.
    Mode    StaMode      IN      ///< The WLAN STA mode to set.
) = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the station mode.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMode
(
    WlanSTA wlanSTARef   IN,     ///< The WLAN STA reference.
    Mode    StaMode      OUT     ///< The WLAN STA mode that is set.
) = 9;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the IP configuration of the station.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetIPConfig
(
    WlanSTA        wlanSTARef         IN,     ///< The WLAN STA reference.
    IPType         StaIPType          IN,     ///< Dynamic or static IP address.
    IPConfig       StaIPConfig        IN      ///< IP address to set for static IP address mode.
) = 10;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the IP configuration of the station.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPConfig
(
    WlanSTA        wlanSTARef         IN,     ///< The WLAN STA reference.
    IPType         StaIPType          OUT,    ///< Dynamic or Static IP address.
    IPConfig       StaStaticIPConfig  OUT     ///< Details of static IP configuration.
) = 11;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the station state.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetStatus
(
    WlanSTA wlanSTARef                                IN,  ///< The WLAN STA reference.
    State   staState                                  OUT, ///< Station state.
    string  IntfName[taf_net.INTERFACE_NAME_MAX_LEN]  OUT, ///< Associated host interface name.
    string  IPv4Address[taf_net.IPV4_ADDR_MAX_LEN]    OUT, ///< Associated IPv4 address.
    string  IPv6Address[taf_net.IPV6_ADDR_MAX_LEN]    OUT, ///< Associated IPv6 address.
    string  MACAddress[taf_net.MAC_ADDR_MAX_LEN]      OUT  ///< Associated MAC address.
) = 12;

//--------------------------------------------------------------------------------------------------
/**
 * Scan for available access points. This is an asynchronous operation and will trigger event
 * STATE_SCAN_COMPLETE on completion.
 * Use GetAPScanResults to get the results of the scan.
 * When a scan is started, it will clear the results from earlier scans.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DoAPScan
(
    WlanSTA wlanSTARef IN                               ///< The WLAN STA reference.
) = 13;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the list of scanned access points. This list is updated after every call to DoScan.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAPScanResults
(
    WlanSTA wlanSTARef IN,                      ///< The WLAN STA reference.
    uint16  numAP      OUT,                     ///< Number of APs found in the scan.
    APInfo  apInfo[MAX_APSCAN_RESULT_NUM] OUT   ///< Available AP information.
) = 14;

//--------------------------------------------------------------------------------------------------
/**
 * Sets WPA2 PSK for an access point that the WLAN station should connect with.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetWpa2Psk
(
    WlanSTA wlanSTARef IN,                              ///< The WLAN STA reference.
    APInfo  apInfo IN,                                   ///< AP for which PSK needs to be set.
    string Wpa2Psk[taf_wlan.MAX_PASSPHRASE_LENGTH] IN   ///< PSK to use for authentication.
) = 15;

//--------------------------------------------------------------------------------------------------
/**
 * Connects to an AP. This is an asynchronous operation and will trigger event STATE_CONNECTED
 * on successful connection or STATE_ASSOCIATION_FAILED if association fails.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Connect
(
    WlanSTA wlanSTARef IN,                              ///< The WLAN STA reference.
    APInfo  apInfo IN                                    ///< The AP to connect to.
) = 16;

//--------------------------------------------------------------------------------------------------
/**
 * Disconnects from an AP. This is an asynchronous operation and will trigger event
 * STATE_DISCONNECTED on completion.
 *
 * @instaging
 *
 * @return
 * - LE_OK  -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Disconnect
(
    WlanSTA wlanSTARef IN,                              ///< The WLAN STA reference.
    APInfo  apInfo IN                                   ///< The AP to disconnect from.
) = 17;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the latest signal strength of the connected AP in dBm.
 *
 * @instaging
 *
 * @return
 * - LE_OK           -- Succeeded.
 * - LE_UNAVAILABLE  -- The STA is not connected to an access point.
 * - Others          -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetConnectedApSignalStrength
(
    WlanSTA wlanSTARef         IN,   ///< The WLAN STA reference.
    int16   signalStrength     OUT  ///< The signal strength of the connected AP in dBm.
) = 18;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the estimated throughput of an access point.
 *
 * @instaging
 *
 * @return
 * - LE_OK           -- Succeeded.
 * - LE_NOT_FOUND    -- The specified AP was not found in scan results.
 * - LE_UNAVAILABLE  -- Throughput information is not available for the AP.
 * - Others          -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAPEstimatedThroughput
(
    WlanSTA wlanSTARef IN,                       ///< The WLAN STA reference.
    string  BSSID[taf_wlan.MAX_BSSID_LENGTH] IN, ///< BSSID of the AP.
    uint32  estimatedThroughput OUT,             ///< Estimated throughput in Kbps.
    int32   age OUT                              ///< Age of the measured value in seconds.
                                                 ///< A negative age indicates it's not available.
) = 19;
