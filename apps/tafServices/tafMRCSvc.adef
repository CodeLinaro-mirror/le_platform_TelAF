maxThreads: 600

username: telaf

startGroup: 23

capability:
{
        CAP_WAKE_ALARM
        CAP_SYS_BOOT
        CAP_SYS_RESOURCE

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafMRCSvc = ( $TELAF_ROOT/components/tafMRCSvc )
}

start: auto

processes:
{
    run:
    {
        (tafMRCSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
}

extern:
{
    tafMRCSvc.tafMRCSvc.taf_mrc
}
