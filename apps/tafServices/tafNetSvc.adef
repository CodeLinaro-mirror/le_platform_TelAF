sandboxed: false

executables:
{
        tafNetSvc = ( $TELAF_ROOT/components/tafNetSvc/tafNetwork)
}
start: auto

processes:
{
        run:
        {
                (tafNetSvc)
        }

        maxFileBytes: 8192K
        faultAction: restart

}

bindings:
{
    tafNetSvc.tafNetwork.taf_dcs -> tafDataCallSvc.taf_dcs
}
extern:
{
       tafNetSvc.tafNetwork.taf_net
}
