    SBAS_CORRECTION_DGNSS,    ///< Specify whether SBAS DGNSS correction is used.
    SBAS_CORRECTION_RTK,      ///< Specify whether SBAS RTK correction is used.
    SBAS_CORRECTION_PPP,      ///< Specify whether SBAS PPP correction is used.
    SBAS_CORRECTION_RTK_FIXED,///< Specify whether SBAS RTK fixed correction
                              ///  is used.
    SBAS_CORRECTED_SV_USED,   ///< Specify only SBAS corrected SV is used
    SBAS_COUNT                ///< Bitset.
};

//--------------------------------------------------------------------------------------------------
/**
