sources:
{
    devManager.cpp
    $LEGATO_ROOT/framework/daemons/linux/common/frameworkWdog.c
}

provides:
{
    api:
    {
        deviceManagerWdog = watchdog/frameworkWdog.api [manual-start]
    }
}

requires:
{
    lib:
    {
    #if ${LE_CONFIG_ENABLE_SELINUX} =y
        lib/libselinux.so.1
    #endif
    }
}

cxxflags:
{
    -I$TELAF_ROOT/include
}

cflags:
{
    -DFRAMEWORK_WDOG_NAME=deviceManagerWdog
}
