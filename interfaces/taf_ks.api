//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafKeyStore Key Store Service
 *
 * @rst :ref:`API reference <File taf_ks_interface.h>` @endrst
 *
 * <HR>
 * Key Store is an access control-based service with access to trusted hardware bound
 * cryptography. It ensures that all cryptographic keys generated are bound to the device
 * cryptographically and all cryptographic operations run in a trusted execution environment.
 *
 * Key Store service provides APIs to applications for key management, key access control, and
 * cryptographic operations. It has a built-in reliable and secure backend storage to save cryptographic
 * keys created by client applications. It also supports client authentication which means only the key
 * owner has the permission to access or use the key for certain purposes.
 *
 * @section taf_ks_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafKeyStoreSvc application service.
 *
 * The following example illustrates how to bind to the Key Store service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_ks -> tafKeyStoreSvc.taf_ks
   }
   @endverbatim
 *
 * @section c_taf_ks_key_management Key management
 *
 * The key is identified by key ID which is a unique string within an application. Key ID shall follow
 * POSIX portable file name format, that is only characters in [A-Za-z0-9._-] are allowed to be used.
 *
 * A new key can be created using API taf_ks_CreateKey() with the desired key ID and key usage as
 * input parameters. A key reference is then returned to the calling application for subsequent
 * operations.
 *
 * The key name passed to API taf_ks_GetKey() shall follow the format of "[appName::]<keyId>", where
 * the "[appName::]" is optional and only needed when the calling application wants to get another
 * application's key if the key owner application has shared that key to the calling application.
 * For example, if the calling application gets its own key ID "myKey1", the key name is "myKey1".
 * If the calling application gets the Key ID "myKey2" of TelAF application "app2", the key name is
 * "app2::myKey2". If the calling application gets the Key ID "myKey3" of the legacy application
 * "/bin/app3", the key name is "/bin/app3::myKey3".
 *
 * New keys initially have no value and cannot be used for any cryptographic operations. Applications
 * shall call taf_ks_ProvisionXXX() API to provision or import the key value and save the key into backend
 * storage. The following key provision/import APIs are supported.
 * - taf_ks_ProvisionRsaEncKeyValue() -- Provisions or imports a RSA encryption key value.
 * - taf_ks_ProvisionRsaSigKeyValue() -- Provisions or imports a RSA signing key value.
 * - taf_ks_ProvisionAesKeyValue() -- Provisions or imports an AES key value.
 * - taf_ks_ProvisionEcdsaKeyValue() -- Provisions or imports an ECDSA key value.
 * - taf_ks_ProvisionHmacKeyValue() -- Provisions or imports a HMAC key value.
 *
 * The following example illustrates how to create and provision an AES GCM key.
 * @code
    const char keyId[] = "MyAesGcmKey";
    taf_ks_KeyRef_t keyRef;
    if (LE_NOT_FOUND == taf_ks_GetKey(keyId, &keyRef))
    {
        if (LE_OK == taf_ks_CreateKey(keyId,TAF_KS_AES_ENCRYPT_DECRYPT, &keyRef))
        {
            if (LE_OK != taf_ks_ProvisionAesKeyValue(keyRef,
                                                     TAF_KS_AES_SIZE_256,
                                                     TAF_KS_AES_MODE_GCM,
                                                     NULL, 0))
            {
                // Error handling for unsucessful taf_ks_ProvisionAesKeyValue call
            }
        }
        else
        {
            // Error handling for unsuccessful taf_ks_CreateKy call
        }
    }
    @endcode
 *
 * @b NOTE: A key only allows one-shot provisioning after creation.
 *
 * Call taf_ks_GetKey() to get a key reference by the key name and call taf_ks_GetKeyUsage() to get the key
 * usage by the key reference.
 *
 * @b NOTE: taf_ks_GetKey() returns LE_NOT_FOUND if the key is created but not provisioned.
 *
 * Call taf_ks_ExportKey() to export the x.509 DER format public key.
 *
 * Call taf_ks_DeleteKey() to delete a key from the backend storage.
 *
 * @section c_taf_ks_crypto_operation Cryptographic operation
 *
 * The typical use cases are data encryption/decryption and message signing/verification. Each
 * cryptographic operation must be processed within a context. A cryptographic session bound to the
 * context must be created to use a key for certain cryptographic operations.
 *
 * @subsection c_taf_ks_create_session Create and start context session
 * Call taf_ks_CryptoSessionCreate() to create a session and get the session reference for subsequent
 * operations.
 *
 * Call taf_ks_CryptoSessionSetAesNonce() to set the NONCE specifically for the AES CBC/CTR/GCM key.
 *
 * Call taf_ks_CryptoSessionStart() to start the session.
 *
 * The following example illustrates how to create a cryptographic session and start the session for
 * data encryption.
 * @code
    taf_ks_CryptoSessionRef_t sessionRef;
    const uint8_t nonce[12] = {"abcdefghijk"}; // Shall be customized and filled by application.
    if (LE_OK == taf_ks_CryptoSessionCreate(keyRef, &sessionRef))
    {
        if (LE_OK == taf_ks_CryptoSessionSetAesNonce(sessionRef, nonce, sizeof(nonce)))
        {
            if (LE_OK != taf_ks_CryptoSessionStart(sessionRef, TAF_KS_CRYPTO_ENCRYPT))
            {
                // Error handling for unsucessful taf_ks_CryptoSessionStart call
            }
        }
        else
        {
            // Error handling for unsucessful CryptoSessionSetAesNonce call
        }
    }
    else
    {
        // Error handling for unsucessful taf_ks_CryptoSessionCreate call
    }
    @endcode
 *
 * @subsection c_taf_ks_process_session Process data within the session
 * Call taf_ks_CryptoSessionProcess() to process the input data and get the output data in a running
 * crypto session started with taf_ks_CryptoSessionStart(). It shall be called for multiple times if
 * the input data size is greater than TAF_KS_MAX_PACKET_SIZE, which means the input data shall be
 * split into small pieces with the size of each piece less than TAF_KS_MAX_PACKET_SIZE.
 *
 * @b NOTE: For AES GCM keys, taf_ks_CryptoSessionProcessAead() must be called one or multiple
 * times to pass the AEAD before calling taf_ks_CryptoSessionProcess(). taf_ks_CryptoSessionAbort()
 * is used to abort a running session, if needed.
 *
 * Call taf_ks_CryptoSessionEnd() to normally finish the cryptographic operation in the running
 * session after all input data is processed by taf_ks_CryptoSessionProcess().
 *
 * The following example illustrates how to process the input plain text and get the encrypted data, the
 * encrypted data will be saved in the byte array of @b encryptedData with size of @b totalEncSize.
 * @code
    const uint8_t plainText[] = "Keystore service for AES GCM test messages.";
    uint8_t encryptedData[TAF_KS_MAX_PACKET_SIZE] = {0};
    size_t encryptedDataSize = sizeof(encryptedData);
    const uint8_t aead[] = {"123456789"}; // Shall be customized and filled by application.
    if (LE_OK == taf_ks_CryptoSessionProcessAead(sessionRef, aead, sizeof(aead)))
    {
        if (LE_OK == taf_ks_CryptoSessionProcess(sessionRef,
                                                 plainText,
                                                 sizeof(plainText),
                                                 encryptedData,
                                                 &encryptedDataSize))
        {
            size_t totalEncSize = encryptedDataSize;
            encryptedDataSize = sizeof(encryptedData) - totalEncSize;
            if (LE_OK == taf_ks_CryptoSessionEnd(sessionRef,
                                                 NULL, 0,
                                                 encryptedData + totalEncSize,
                                                 &encryptedDataSize))
            {
                totalEncSize = totalEncSize + encryptedDataSize;
            }
            else
            {
                // Error handling for unsucessful taf_ks_CryptoSessionEnd call
            }
        }
        else
        {
            // Error handling for unsucessful taf_ks_CryptoSessionProcess call
        }
    }
    else
    {
        // Error handling for unsucessful taf_ks_CryptoSessionProcessAead call
    }
    @endcode
 *
 * @b NOTE: The crypto session is automatically deleted after taf_ks_CryptoSessionAbort() or
 * taf_ks_CryptoSessionEnd() is called, or when any error occurs in taf_ks_CryptoSessionStart() and
 * taf_ks_CryptoSessionProcess().
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum size of the key name in bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_KEY_ID_SIZE = 256;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum size of the app name in bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_APP_NAME_SIZE = 128;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum size of the secure label in bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_SEC_LABEL_SIZE = 256;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum size of the data packet in bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_PACKET_SIZE = 4096;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum nonce or IV size for AES GCM, CBC, or CTR in bytes.
 *
 * AES GCM nonce size must be fixed length of 12 bytes. AES CBC/CTR IV size must be fixed length of
 * 16 bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_AES_NONCE_SIZE = 16;

//--------------------------------------------------------------------------------------------------
/**
 * The minimum and maximum size for HMAC key in bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MIN_HMAC_KEY_SIZE = 8;
DEFINE MAX_HMAC_KEY_SIZE = 128;

//--------------------------------------------------------------------------------------------------
/**
 * Capabilities shared to the application.
 */
//--------------------------------------------------------------------------------------------------
BITMASK AppCapMask
{
    CAP_DELETE_KEY,    ///< Shared app can delete the key.
    CAP_EXPORT_KEY,    ///< Shared app can export the key.
    CAP_GET_APP_LIST,  ///< Shared app can get shared application list of the key.
};

//--------------------------------------------------------------------------------------------------
/**
 * Key sharing state enum
 */
//--------------------------------------------------------------------------------------------------
ENUM SharingState
{
    SHARING_DISABLED,  ///< Key sharing is disabled.
    SHARING_ENABLED,   ///< key sharing is enabled.
    SHARING_UPDATED,   ///< key sharing is updated.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the supported RSA key size.
 */
//--------------------------------------------------------------------------------------------------
ENUM RsaKeySize
{
    RSA_SIZE_1024 = 1, ///< RSA key size is 1024 bit.
    RSA_SIZE_2048,     ///< RSA key size is 2048 bit.
    RSA_SIZE_3072,     ///< RSA key size is 3072 bit.
    RSA_SIZE_4096,     ///< RSA key size is 4096 bit.
    RSA_SIZE_MAX,      ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the supported AES key size.
 */
//--------------------------------------------------------------------------------------------------
ENUM AesKeySize
{
    AES_SIZE_128 = 1,  ///< AES key size is 128 bit.
    AES_SIZE_192,      ///< AES key size is 192 bit.
    AES_SIZE_256,      ///< AES key size is 256 bit.
    AES_SIZE_MAX,      ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the supported ECC key size.
 */
//--------------------------------------------------------------------------------------------------
ENUM EccKeySize
{
    ECC_SIZE_224 = 1,  ///< NIST/SECG curve over a 224 bit prime field.
    ECC_SIZE_256,      ///< NIST/SECG curve over a 256 bit prime field.
    ECC_SIZE_384,      ///< NIST/SECG curve over a 384 bit prime field.
    ECC_SIZE_521,      ///< NIST/SECG curve over a 521 bit prime field.
    ECC_SIZE_MAX,      ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the key usage.
 */
//--------------------------------------------------------------------------------------------------
ENUM KeyUsage
{
    RSA_ENCRYPT_DECRYPT,    ///< RSA key for encryption and decryption.
    RSA_ENCRYPT_ONLY,       ///< RSA key for encryption only.
    RSA_DECRYPT_ONLY,       ///< RSA key for decryption only.
    RSA_SIGN_VERIFY,        ///< RSA key for signing and verification.
    RSA_SIGN_ONLY,          ///< RSA key for signing only.
    RSA_VERIFY_ONLY,        ///< RSA key for verification only.
    AES_ENCRYPT_DECRYPT,    ///< AES key for encryption and decryption.
    AES_ENCRYPT_ONLY,       ///< AES key for encryption only.
    AES_DECRYPT_ONLY,       ///< AES key for decryption only.
    ECDSA_SIGN_VERIFY,      ///< ECDSA key for signing and verification.
    ECDSA_SIGN_ONLY,        ///< ECDSA key for signing only.
    ECDSA_VERIFY_ONLY,      ///< ECDSA key for verfication only.
    HMAC_SIGN_VERIFY,       ///< HMAC for signing and verification.
    HMAC_SIGN_ONLY,         ///< HMAC for signing only.
    HMAC_VERIFY_ONLY,       ///< HMAC for verification only.
    KEYUSAGE_MAX,           ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the purpose for a cryptographic operation session.
 */
//--------------------------------------------------------------------------------------------------
ENUM CryptoPurpose
{
    CRYPTO_ENCRYPT,         ///< Crypto operation for encryption.
    CRYPTO_DECRYPT,         ///< Crypto operation for decryption.
    CRYPTO_SIGN,            ///< Crypto operation for signing.
    CRYPTO_VERIFY,          ///< Crypto operation for verify.
    CRYPTO_MAX,             ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the digest algorithms used by RSA, ECC and HMAC.
 */
//--------------------------------------------------------------------------------------------------
ENUM Digest
{
    DIGEST_MD5 = 1,         ///< MD5.
    DIGEST_SHA1,            ///< SHA1.
    DIGEST_SHA2_224,        ///< SHA2-224.
    DIGEST_SHA2_256,        ///< SHA2-256.
    DIGEST_SHA2_384,        ///< SHA2-384.
    DIGEST_SHA2_512,        ///< SHA2-512.
    DIGEST_MAX,             ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the padding type for RSA encryption keys.
 *
 * The specified hash function used in MFG1 is only for OAEP padding.
 */
//--------------------------------------------------------------------------------------------------
ENUM RsaEncPadding
{
    RSA_ENC_PAD_NONE,            ///< No padding
    RSA_ENC_PAD_PKCS1_V15,       ///< PKCS1 V1.5 padding
    RSA_ENC_PAD_OAEP_MD5,        ///< OAEP with MD5 padding
    RSA_ENC_PAD_OAEP_SHA1,       ///< OAEP with SHA1 padding
    RSA_ENC_PAD_OAEP_SHA2_224,   ///< OAEP with SHA2-224 padding
    RSA_ENC_PAD_OAEP_SHA2_256,   ///< OAEP with SHA2-256 padding
    RSA_ENC_PAD_OAEP_SHA2_384,   ///< OAEP with SHA2-384 padding
    RSA_ENC_PAD_OAEP_SHA2_512,   ///< OAEP with SHA2-512 padding
    RSA_ENC_PAD_MAX,             ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the padding type for RSA signature keys.
 *
 * The specified hash function used in MFG1 is for both PSS padding and digest to sign.
 */
//--------------------------------------------------------------------------------------------------
ENUM RsaSigPadding
{
    RSA_SIG_PAD_NONE,               ///< No padding
    RSA_SIG_PAD_PKCS1_V15_MD5,      ///< PKCS1 V1.5 padding, digest is MD5.
    RSA_SIG_PAD_PKCS1_V15_SHA1,     ///< PKCS1 V1.5 padding, digest is SHA1.
    RSA_SIG_PAD_PKCS1_V15_SHA2_224, ///< PKCS1 V1.5 padding, digest is SHA2-224.
    RSA_SIG_PAD_PKCS1_V15_SHA2_256, ///< PKCS1 V1.5 padding, digest is SHA2-256.
    RSA_SIG_PAD_PKCS1_V15_SHA2_384, ///< PKCS1 V1.5 padding, digest is SHA2-384.
    RSA_SIG_PAD_PKCS1_V15_SHA2_512, ///< PKCS1 V1.5 padding, digest is SHA2-512.
    RSA_SIG_PAD_PSS_MD5,            ///< PSS with MD5 padding, digest is MD5.
    RSA_SIG_PAD_PSS_SHA1,           ///< PSS with SHA1 padding, digest is SHA1.
    RSA_SIG_PAD_PSS_SHA2_224,       ///< PSS with SHA2-224 padding, digest is SHA2-224.
    RSA_SIG_PAD_PSS_SHA2_256,       ///< PSS with SHA2-256 padding, digest is SHA2-256.
    RSA_SIG_PAD_PSS_SHA2_384,       ///< PSS with SHA2-384 padding, digest is SHA2-384.
    RSA_SIG_PAD_PSS_SHA2_512,       ///< PSS with SHA2-512 padding, digest is SHA2-512.
    RSA_SIG_PAD_PKCS1_V15_AND_PSS_MD5, ///< Support both PKCS1 V1.5 and PSS with MD5.
    RSA_SIG_PAD_PKCS1_V15_AND_PSS_SHA1, ///< Support both PKCS1 V1.5 and PSS with SHA1.
    RSA_SIG_PAD_PKCS1_V15_AND_PSS_SHA2_224, ///< Support both PKCS1 V1.5 and PSS with SHA2_224.
    RSA_SIG_PAD_PKCS1_V15_AND_PSS_SHA2_256, ///< Support both PKCS1 V1.5 and PSS with SHA2_256.
    RSA_SIG_PAD_PKCS1_V15_AND_PSS_SHA2_384, ///< Support both PKCS1 V1.5 and PSS with SHA2_384.
    RSA_SIG_PAD_PKCS1_V15_AND_PSS_SHA2_512, ///< Support both PKCS1 V1.5 and PSS with SHA2_512.
    RSA_SIG_PAD_MAX,                ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines general padding type for RSA signature keys.
 */
//--------------------------------------------------------------------------------------------------
ENUM RsaPaddingType
{
    RSA_PKCS1_V15,            ///< PKCS1_V1.5 padding
    RSA_PSS,                  ///< PSS padding
};

//--------------------------------------------------------------------------------------------------
/**
 * Defines the AES block mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM AesBlockMode
{
    AES_MODE_ECB_PAD_NONE,  ///< AES ECB mode without padding.
    AES_MODE_ECB_PAD_PKCS7, ///< AES ECB mode with PKCS7 padding.
    AES_MODE_CBC_PAD_NONE,  ///< AES CBC mode without padding.
    AES_MODE_CBC_PAD_PKCS7, ///< AES CBC mode with PKCS7 padding.
    AES_MODE_CTR,           ///< AES CTR mode.
    AES_MODE_GCM,           ///< AES GCM mode.
    AES_MODE_MAX            ///< Indicates the maximum value.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference for key object.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Key;

//--------------------------------------------------------------------------------------------------
/**
 * Reference for cryptographic operation session.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE CryptoSession;

//--------------------------------------------------------------------------------------------------
/**
 * Creates a new key.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_PERMITTED -- Key already exists.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CreateKey
(
    string   keyId[MAX_KEY_ID_SIZE]   IN, ///< Key ID.
    KeyUsage keyUsage                 IN, ///< Key usage.
    Key      keyRef                   OUT ///< Key reference.
) = 0;

//--------------------------------------------------------------------------------------------------
/**
 * Gets a key by key name.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- The key does not exist, is not provisioned or is not shared to the
 *       calling application.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetKey
(
    string keyName[MAX_KEY_ID_SIZE] IN, ///< Key name.
    Key    keyRef                   OUT ///< Key reference.
) = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Deletes a key by key reference.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key has running cryptography sessions or calling application is not
 *       the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteKey
(
    Key    keyRef                   IN  ///< Key reference.
) =  2;

//--------------------------------------------------------------------------------------------------
/**
 * Gets a key's usage.
 *
 * For the calling application's own key, returns the real key usage. For shared key from another
 * application, returns the key capability that is shared to the calling application.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Calling application is not the key owner or the key is not shared to
 *       the calling application.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetKeyUsage
(
    Key       keyRef                      IN, ///< Key reference.
    KeyUsage  keyUsage                    OUT ///< Key usage.
) = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the maximum number of times a key may be used between system reboots.
 *
 * This API is not implemented yet.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetKeyMaxUsesPerBoot
(
    Key    keyRef        IN,  ///< Key reference.
    uint32 value         IN   ///< Uses per boot.
) = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the minimum amount of time that elapses between allowed operations using a key.
 *
 * This API is not implemented yet.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetKeyMinSecondsBetweenOps
(
    Key    keyRef        IN,  ///< Key reference.
    uint32 value         IN   ///< Seconds interval between allowed operations.
) = 5;

//--------------------------------------------------------------------------------------------------
/**
 * Sets application data to the key.
 *
 * This API is not implemented yet.
 *
 * When this attribute is provided to the key, the same data must be also provided through
 * taf_ks_CryptoSessionSetAppData() for each cryptographic operation using the key.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetKeyAppData
(
    Key   keyRef                IN,  ///< Key reference.
    uint8 data[MAX_PACKET_SIZE] IN   ///< Data buffer to hold the application data.
) = 6;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the date and time at which the key becomes active. Any attempt to use the key
 * prior to this time will fail.
 *
 * This API is not implemented yet.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetKeyActiveDateTime
(
    Key    keyRef        IN,  ///< Key reference.
    uint64 value         IN   ///< Milliseconds since January 1, 1970.
) = 7;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the date and time at which the key expires for signing and encryption. Any attempt to use
 * a key for signing or encryption after this time will fail.
 *
 * This API is not implemented yet.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetKeyOriginationExpireDateTime
(
    Key    keyRef        IN,  ///< Key reference.
    uint64 value         IN   ///< Milliseconds since January 1, 1970.
) = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the date and time at which the key expires for verification and decryption.
 * Any attempt to use a key for verification and decryption after this time will fail.
 *
 * This API is not implemented yet.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetKeyUsageExpireDateTime
(
    Key    keyRef        IN,  ///< Key reference.
    uint64 value         IN   ///< Milliseconds since January 1, 1970.
) = 9;

//--------------------------------------------------------------------------------------------------
/**
 * Provisons or imports a RSA encryption key value to the newly created key.
 *
 * The impData parameter, if provided, shall hold PKCS#8 DER format of RSA key data for import.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned, is not suitable for this
 *       provision or calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ProvisionRsaEncKeyValue
(
    Key              keyRef                   IN, ///< Key reference.
    RsaKeySize       keySize                  IN, ///< Key size. Shall match the import key size if
                                                  ///< impData is provided.
    RsaEncPadding    padding                  IN, ///< Padding type of RSA encryption key.
    uint8            impData[MAX_PACKET_SIZE] IN  ///< Imported key data.
) = 10;

//--------------------------------------------------------------------------------------------------
/**
 * Provisions or imports a RSA signing key value to the newly created key.
 *
 * The impData parameter, if provided, shall hold PKCS#8 DER format of RSA key data for import.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned, is not suitable for this
 *       provision or calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ProvisionRsaSigKeyValue
(
    Key              keyRef                   IN, ///< Key reference.
    RsaKeySize       keySize                  IN, ///< Key size. Shall match the import key size if
                                                  ///< impData is provided.
    RsaSigPadding    padding                  IN, ///< Padding type of RSA signing key.
    uint8            impData[MAX_PACKET_SIZE] IN  ///< Imported key data.
) = 11;

//--------------------------------------------------------------------------------------------------
/**
 * Provisions or imports an ECDSA key value to the newly created key.
 *
 * The impData parameter, if provided, shall hold PKCS#8 DER format of ECDSA key data for import.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned, is not suitable for this
 *       provision or calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ProvisionEcdsaKeyValue
(
    Key              keyRef                   IN, ///< Key reference.
    EccKeySize       keySize                  IN, ///< Key size. Shall match the import key size if
                                                  ///< impData is provided.
    Digest           digest                   IN, ///< Digest.
    uint8            impData[MAX_PACKET_SIZE] IN  ///< Imported key data.
) = 12;

//--------------------------------------------------------------------------------------------------
/**
 * Provisions or imports an AES key value to the newly created key.
 *
 * The impData parameter, if provided, shall hold the AES raw key data for import.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned, is not suitable for this
 *       provision or calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ProvisionAesKeyValue
(
    Key              keyRef                   IN, ///< Key reference.
    AesKeySize       keySize                  IN, ///< Key size. Shall match the import key size if
                                                  ///< impData is provided.
    AesBlockMode     mode                     IN, ///< AES block mode.
    uint8            impData[MAX_PACKET_SIZE] IN  ///< Imported key data.
) = 13;

//--------------------------------------------------------------------------------------------------
/**
 * Provisions or imports a HMAC key value to the newly created key.
 *
 * The impData parameter, if provided, shall hold the HMAC raw key data for import.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is already provisioned, is not suitable for this
 *       provision or calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ProvisionHmacKeyValue
(
    Key              keyRef                   IN, ///< Key reference.
    uint32           keySize                  IN, ///< Key size. Shall match the import key size if
                                                  ///< impData is provided.
    Digest           digest                   IN, ///< Digest.
    uint8            impData[MAX_PACKET_SIZE] IN  ///< Imported key data.
) = 14;

//--------------------------------------------------------------------------------------------------
/**
 * Exports a key into the specified key data format.
 *
 * For asymmetric key exports the x.509 DER format (SubjectPublicKeyInfo) public key. Currently
 * symmetric key exports are not supported.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameter(s).
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is not provisioned, is not shared to the calling application or
 *       calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ExportKey
(
    Key    keyRef                         IN, ///< Key reference.
    uint8  appData[MAX_PACKET_SIZE]       IN, ///< Data buffer to hold the application data.
    uint8  expData[MAX_PACKET_SIZE]       OUT ///< Exported key data.
) = 15;

//--------------------------------------------------------------------------------------------------
/**
 * Shares a key to another application to use. Key sharing is persistent until cancelled by API
 * taf_ks_CancelKeySharing().
 *
 * The keyCap provides the key capability that is shared to use. It must match the real key usage
 * of the key. For example if real key usage is "TAF_KS_RSA_ENCRYPT_DECRYPT", then the capability
 * of "TAF_KS_RSA_ENCRYPT_DECRYPT", "TAF_KS_RSA_ENCRYPT_ONLY" or "TAF_KS_RSA_DECRYPT_ONLY"
 * is allowed to share. If the real key usage is "TAF_KS_RSA_DECRYPT_ONLY", then only capability
 * "TAF_KS_RSA_DECRYPT_ONLY" is allowed to share.
 *
 * The appCap provides additional privileges for the shared app to use the key like deleting key
 * and exporting key if needed.
 *
 * Only the key owner app can share the key after provisioning. One key can be shared to at most
 * 12 applications to use.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameter(s).
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is not provisioned or calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ShareKey
(
    Key    keyRef                         IN, ///< Key reference.
    string appName[MAX_APP_NAME_SIZE]     IN, ///< Shared application name.
    KeyUsage keyCap                       IN, ///< Shared key capability.
    AppCapMask appCap                     IN  ///< Shared application capability.
) = 16;

//--------------------------------------------------------------------------------------------------
/**
 * Cancels the key sharing. Only the key owner app can cancel the key sharing.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameter(s).
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is not provisioned, is not shared to the given application before,
 *       calling application is not the key owner, or the shared application has running crypto
 *       sessions for the key.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CancelKeySharing
(
    Key    keyRef                         IN, ///< Key reference.
    string appName[MAX_APP_NAME_SIZE]     IN  ///< Name of the app that the key is shared to before.
) = 17;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the application name of the calling client. It returns app name for a TelAF application
 * or returns the full path of the executable for a legacy application.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCallingAppName
(
    string appName[MAX_APP_NAME_SIZE]     OUT ///< Application name.
) = 18;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the first application that the key is shared to.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameter(s).
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is not provisioned or calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFirstSharedApp
(
    Key    keyRef                         IN,  ///< Key reference.
    string appName[MAX_APP_NAME_SIZE]     OUT, ///< Shared application name.
    KeyUsage keyCap                       OUT, ///< Shared key capability.
    AppCapMask appCap                     OUT  ///< Shared application capability.
) = 19;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the next application that the key is shared to.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameter(s).
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is not provisioned or calling application is not the key owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNextSharedApp
(
    Key    keyRef                         IN,  ///< Key reference.
    string appName[MAX_APP_NAME_SIZE]     OUT, ///< Shared application name.
    KeyUsage keyCap                       OUT, ///< Shared key capability.
    AppCapMask appCap                     OUT  ///< Shared application capability.
) = 20;

//--------------------------------------------------------------------------------------------------
/**
 * Handler for key sharing assignment.
 *
 * @param[in] keyId      Key ID.
 * @param[in] appName    Key owner application name.
 * @param[in] state      Sharing state.
 * @param[in] contextPtr Context pointer.
 */
//--------------------------------------------------------------------------------------------------
HANDLER KeySharingHandler
(
    string keyId[MAX_KEY_ID_SIZE]          IN, ///< Key ID.
    string appName[MAX_APP_NAME_SIZE]      IN, ///< Key owner application name.
    SharingState state                     IN  ///< Sharing state.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information when a key of another application is shared to the calling
 * application.
 *
 * The handler will be also triggered on registration if the required key is already shared to the
 * calling application before or the key capability shared is updated.
 *
 */
//--------------------------------------------------------------------------------------------------
EVENT KeySharing
(
    string keyId[MAX_KEY_ID_SIZE]          IN,  ///< Key ID.
    string appName[MAX_APP_NAME_SIZE]      IN,  ///< Key owner app.
    KeySharingHandler handler              IN   ///< Handler is called when the required key of the
                                                ///< application shared to the calling application.
) = (21,22);

//--------------------------------------------------------------------------------------------------
/**
 * Creates a cryptographic operation session for a key.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Key does not exist.
 *     - LE_NOT_PERMITTED -- Key is not provisioned, is not shared to the calling application or
 *       calling application is not key owner.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionCreate
(
    Key           keyRef      IN,     ///< Key to use for this cryptographic session.
    CryptoSession sessionRef  OUT     ///< Session reference.
) = 23;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the nonce or IVs for AES GCM, CBC, CTR for a cryptographic session. For AES GCM the nonce
 * size must be 12 bytes, for AES CBC, CTR the IV must be 16 bytes.
 *
 * This API must be called before taf_ks_CryptoSessionStart().
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Session does not exist.
 *     - LE_NOT_PERMITTED -- Session is already started or calling application is not session owner.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionSetAesNonce
(
    CryptoSession   sessionRef     IN,  ///< Session reference.
    uint8 data[MAX_AES_NONCE_SIZE] IN   ///< Data buffer to hold the nonce or IV.
) = 24;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the general padding type used for a RSA signing/verification cryptographic session.
 * By default RSA_PKCS1_V15 is used if this API is not called.
 *
 * This API must be called before taf_ks_CryptoSessionStart().
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Session does not exist.
 *     - LE_NOT_PERMITTED -- Session is already started or calling application is not session owner.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionSetRsaPadding
(
    CryptoSession   sessionRef     IN,  ///< [IN] Session reference for a RSA signing key.
    RsaPaddingType  paddingType    IN   ///< [IN] General padding type.
) = 25;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the application data for a cryptographic session.
 *
 * This API must be called before taf_ks_CryptoSessionStart() if the key has set the attribute of
 * application data by taf_ks_SetKeyAppData().
 *
 * This API is not implemented yet.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Session does not exist.
 *     - LE_NOT_PERMITTED -- Session is already started or calling application is not session owner.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionSetAppData
(
    CryptoSession   sessionRef     IN,  ///< Session reference.
    uint8 data[MAX_PACKET_SIZE]    IN   ///< Data buffer to hold the application data.
) =26;

//--------------------------------------------------------------------------------------------------
/**
 * Starts the cryptographic session for the given operation. The cryptographic session is
 * automatically deleted if an error occurs.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Session does not exist.
 *     - LE_NOT_PERMITTED -- Calling application is not session owner.
 *     - LE_DUPLICATE -- Session is already started.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionStart
(
    CryptoSession sessionRef         IN,  ///< Session reference.
    CryptoPurpose cryptoPurpose      IN   ///< Cryptographic operation purpose.
) =27;

//--------------------------------------------------------------------------------------------------
/**
 * Provides AEAD to an AES GCM crypto session started with taf_ks_CryptoSessionStart().
 * This API can be called multiple times before taf_ks_CryptoSessionProcess() and the cryptographic
 * session will be automatically deleted if an error occurs.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Session does not exist.
 *     - LE_NOT_PERMITTED -- Session is not started or calling application is not session owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionProcessAead
(
    CryptoSession   sessionRef     IN,  ///< Session reference.
    uint8 data[MAX_PACKET_SIZE]    IN   ///< Data buffer to hold the AEAD data.
) =28;

//--------------------------------------------------------------------------------------------------
/**
 * Provides data to, and possibly receives output from, a running cryptographic session started with
 * taf_ks_CryptoSessionStart(). It can be called multiple times before taf_ks_CryptoSessionEnd()
 * is called. The crypto session is automatically deleted if an error occurs.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Session does not exist.
 *     - LE_NOT_PERMITTED -- Session is not started or calling application is not session owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionProcess
(
    CryptoSession sessionRef               IN, ///< Session reference.
    uint8   inputData[MAX_PACKET_SIZE]     IN, ///< InputData can be one of the following cases.
                                               ///< 1. Plain text for encryption session.
                                               ///< 2. Cipher text for decryption session.
                                               ///< 3. Message to sign for signing session.
                                               ///< 4. Message to verify for verification session.
    uint8   outputData[MAX_PACKET_SIZE]    OUT ///< OutputData can be one of the following cases.
                                               ///< 1. Encrypted data for encryption session.
                                               ///< 2. Decrypted data for decryption session.
                                               ///< 3. Shall set NULL for signing and verification
                                               ///<    sessions.
) =29;

//--------------------------------------------------------------------------------------------------
/**
 * Finalizes the cryptographic session started with taf_ks_CryptoSessionStart().
 * This API shall be called once all input data is processed by taf_ks_CryptoSessionProcess().
 * The cryptographic session will be deleted automatically.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Session does not exist.
 *     - LE_NOT_PERMITTED -- Session is not started or calling application is not session owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionEnd
(
    CryptoSession sessionRef               IN, ///< Session reference.
    uint8   inputData[MAX_PACKET_SIZE]     IN, ///< Signature to verify for verification session
                                               ///< and shall set to NULL for other sessions.
    uint8   outputData[MAX_PACKET_SIZE]    OUT ///< OutputData can be one of the following cases.
                                               ///< 1. Encrypted data for encryption session.
                                               ///< 2. Decrypted data for decryption session.
                                               ///< 3. Signature for signing session.
                                               ///< 4. Shall set to NULL for verfication session.
) =30;

//--------------------------------------------------------------------------------------------------
/**
 * Aborts the cryptographic session started with taf_ks_CryptoSessionStart().
 * The cryptographic session will be deleted automatically.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Session does not exist.
 *     - LE_NOT_PERMITTED -- Session is not started or calling application is not session owner.
 *     - LE_FAULT -- Error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CryptoSessionAbort
(
    CryptoSession sessionRef               IN  ///< Session reference.
) =31;
