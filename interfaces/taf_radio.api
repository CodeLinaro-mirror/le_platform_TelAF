 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRatPreferences
(
    RatPrefMask ratMaskPtr OUT, ///< Bit mask for RAT prefences.
    uint8 phoneId IN            ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets network registration state.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNetRegState
(
    NetRegState state OUT, ///< Network registration state.
    uint8 phoneId IN       ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets circuit and packet switched state.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPacketSwitchedState
(
    ServiceDomainState state OUT, ///< Circuit and packet switched state.
    uint8 phoneId IN              ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets signal quality.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 *
 * @note This function gets the highest signal strength level of RATs.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSignalQual
(
    uint32 quality OUT, ///< Signal qulity level, range from 0 to 5.
    uint8 phoneId IN    ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function creates signal metrics.
 *
 * @return
 *  - Non-null pointer : The reference of signal metrics.
 *  - Null pointer : Internal error.
 *
 * @note At most 1 signal metrics reference per slot. taf_radio_DeleteSignalMetrics() help to release
 *       the reference of signal metrics before measuring.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Metrics MeasureSignalMetrics
(
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function deletes signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Preferred operator not found.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteSignalMetrics
(
    Metrics MetricsRef IN ///< The reference of signal metrics.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets cell RAT bitmask of signal metrics.
 *
 * @return
 *  - TAF_RADIO_CELL_RAT_MASK_UNKNOWN : Internal error.
 *  - Others : Cell Rat bitmask of signal metrics.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION CellRatMask GetRatOfSignalMetrics
(
    Metrics MetricsRef IN ///< The reference of signal metrics.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets GSM signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Reference not found.
 *  - LE_UNAVAILABLE : GSM unavailable.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetGsmSignalMetrics
(
    Metrics MetricsRef IN, ///< The reference of signal metrics.
    int32 rssi OUT,        ///< Signal Strength.
    uint32 ber OUT         ///< Bit Error Rate.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets UMTS signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Reference not found.
 *  - LE_UNAVAILABLE : UMTS unavailable.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetUmtsSignalMetrics
(
    Metrics MetricsRef IN, ///< The reference of signal metrics.
    int32 ss OUT,          ///< Signal Strength, only applicatable for WCDMA.
    uint32 ber OUT,        ///< Bit Error Rate, only applicatable for WCDMA.
    int32 rscp OUT         ///< Reference Signal Code Power in dBm, only applicatable for TD-SCDMA.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets LTE signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Reference not found.
 *  - LE_UNAVAILABLE : LTE unavailable.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetLteSignalMetrics
(
    Metrics MetricsRef IN, ///< The reference of signal metrics.
    int32 ss OUT,          ///< Signal Strength.
    int32 rsrq OUT,        ///< Reference Signal Receive Quality in dB.
    int32 rsrp OUT,        ///< Reference Signal Receive Power in dBm.
    int32 snr OUT          ///< Signal-to-Noise Ratio in dB.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets CDMA signal metrics.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Reference not found.
 *  - LE_UNAVAILABLE : CDMA unavailable.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCdmaSignalMetrics
(
    Metrics MetricsRef IN, ///< The reference of signal metrics.
    int32 ss OUT,          ///< Signal Strength in dBm.
    int32 ecio OUT,        ///< CDMA Ec/Io in dB.
    int32 snr OUT,         ///< Signal-to-Noise Ratio in dB.
    int32 io OUT           ///< EVDO Ec/Io in dB.
);

