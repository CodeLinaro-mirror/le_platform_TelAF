maxThreads: 600

username: telaf

startGroup: 18

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafVoiceCallSvc = ( $TELAF_ROOT/components/tafVoiceCallSvc )
}

start: auto

processes:
{
    run:
    {
        (tafVoiceCallSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
}

extern:
{
    tafVoiceCallSvc.tafVoiceCallSvc.taf_voicecall
}
