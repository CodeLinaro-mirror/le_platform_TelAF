//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafvoicecall Voice Call Service
 *
 * @ref taf_voicecall_interface.h "API Reference"
 *
 * <HR>
 *
 * A voice call is needed for applications that want to establish voice communication with
 * a remote party. The voice call can be over a mobile network or over VoIP.
 *
 * @section taf_voicecall_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafVoiceCallSvc application service.
 *
 * The following example illustrates how to bind to the Voice Call service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_voicecall -> tafVoiceCallSvc.taf_voicecall
   }
   @endverbatim
 *
 * @section c_taf_vaoicecall_outgoing Starting a voice call
 *
 * A voice call can be started using taf_voicecall_Start() with the destination identifier and 
 * SIM slot number passed as parameters.
 * @verbatim
   myTafCallRef = taf_voicecall_Start(DestinationNum, Slot);
   if (!myTafCallRef)
   {
      res = taf_voicecall_GetEndCause(myTafCallRef, &reason);
      LE_ASSERT(res == LE_OK);
      LE_INFO("taf_voicecall_GetEndCause %d", reason);
      return LE_FAULT;
   }
   @endverbatim
 *
 * Before the voice call is started, an application registers a state handler using
 * taf_voicecall_AddStateHandler(). Once the voice call is established, the handler will be called 
 * indicating it's now connected. If the state of the voice call changes, the handler will be
 * called with the new state.
 *
 * @verbatim
   tafVoiceCallHandlerRef = taf_voicecall_AddStateHandler((taf_voicecall_StateHandlerFunc_t)MyCallEventHandler, NULL);
   @endverbatim
 *
 * To hang up a voice call, an application can use taf_voicecall_End().
 *
 * Applications must use taf_voicecall_Delete() to release the @ref taf_voicecall_CallRef_t voice call
 * reference object when it is no longer used.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------


USETYPES taf_types.api;

//-------------------------------------------------------------------------------------------------
/**
 * Uses the call reference returned from start defined in le_voicecall.api
 */
//-------------------------------------------------------------------------------------------------
REFERENCE Call;

//-------------------------------------------------------------------------------------------------
/**
 * Legacy event suppport.
 */
//-------------------------------------------------------------------------------------------------
DEFINE EVENT_CONNECTED = 2 ;
DEFINE EVENT_TERMINATED = 3;
DEFINE EVENT_BUSY = 5;

//-------------------------------------------------------------------------------------------------
/**
 * Legacy term support.
 */
//-------------------------------------------------------------------------------------------------
DEFINE TERM_NETWORK_FAIL = 1 ;
DEFINE TERM_BAD_ADDRESS = 2 ;
DEFINE TERM_BUSY = 3 ;
DEFINE TERM_LOCAL_ENDED = 4 ;
DEFINE TERM_REMOTE_ENDED = 5 ;
DEFINE TERM_UNDEFINED = 6 ;

//-------------------------------------------------------------------------------------------------
/**
 * Call events.
 */
//-------------------------------------------------------------------------------------------------
ENUM Event
{
    EVENT_ALERTING = 1,             ///< Alerting call; MO only.
    EVENT_ACTIVE = 2 ,              ///< Active call; map to legacy connected.
    EVENT_ENDED = 3 ,               ///< Call end.
    EVENT_OFFLINE = 4 ,             ///< Not supported.
    EVENT_WAITING = 5,              ///< Waiting call; map to legacy busy.
    EVENT_RESOURCE_BUSY = 6,        ///< Not supported.
    EVENT_CALL_END_FAILED = 7,      ///< Call end failed.
    EVENT_CALL_ANSWER_FAILED = 8,   ///< Call answer failed.
    EVENT_INCOMING = 9,             ///< Incoming call; not answered yet.
    EVENT_ONHOLD = 10,              ///< On hold call.
    EVENT_DIALING = 11,             ///< MO call; dialing.
    EVENT_CALL_HOLD_FAILED = 12,    ///< Call hold failed.
    EVENT_CALL_RESUME_FAILED = 13,  ///< Call resume failed.
    EVENT_CALL_SWAP_FAILED = 14,    ///< Call swap failed.
};

//-------------------------------------------------------------------------------------------------
/**
 * Call end causes.
 */
//-------------------------------------------------------------------------------------------------
ENUM CallEndCause
{
    END_NORMAL = 0,                 ///< Normal call end.
    END_NETWORK_FAIL = 1,           ///< Map to legacy network fail.
    END_UNOBTAINABLE_NUMBER = 2,    ///< Map to legacy bad address.
    END_BUSY = 3,                   ///< Remote busy.
    END_LOCAL = 4,                  ///< Not supported.
    END_REMOTE = 5,                 ///< Not supported.
    END_UNDEFINED = 6,              ///< End cause undefined for TelAF.
    END_REJECTED = 7,               ///< Call rejected.
    END_NORESPONSE = 8,             ///< No remote response.

};


//-------------------------------------------------------------------------------------------------
/*
 * New APIs Avaiable in TelAF services.
 */
//-------------------------------------------------------------------------------------------------

//-------------------------------------------------------------------------------------------------
/*
 * The user event handler.
 */
//-------------------------------------------------------------------------------------------------
HANDLER StateHandler
(
    Call reference IN,
    string identifer[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN,
    Event event IN
);

EVENT State
(
    StateHandler handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Starts a call according to a given phone number and slot ID.
 *
 * @return
 * - Reference to the voice call.
 * - NULL if the voice call can not be processed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Call Start
(
    string destinationID[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN, ///< Destination phone number for
                                                                   ///  call establishment.
    uint8 phoneId                                                  ///< SIM slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Stops a call according to the given reference ID.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t End
(
    Call reference IN                                              ///< The call reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes a call according to the given call reference.
 *
 * @return
 * - LE_OK -- Succeeded. 
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Delete
(
    Call reference IN                                              ///< The call reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Answers an incoming or a waiting call. The call reference can be retrieved from the call state
 * handler.If a Waiting call is being answered and the existing call is Active, then existing call
 * will move to Hold state.If the existing call is on Hold already, then it will remain on Hold.
 * The waiting call state transition from Waiting to Active. If a Waiting call is being answered
 * and the existing call is Active, then existing call will move to Hold state.If the existing call
 * is on Hold already, then it will remain on Hold. The waiting call state transition from Waiting
 * to Active.
 *
 * @return
 * - LE_OK -- Succeeded. 
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Answer
(
    Call reference IN                                              ///< The call reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the call end reason according to the call reference. This call should be in the END state.
 * The call should be in the idle state when calling this API.
 *
 * @return
 * - LE_OK -- Succeeded. 
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEndCause
(
    Call reference IN,                                             ///< The call reference.
    CallEndCause cause OUT                                         ///< The end cause enumeration.
);

//--------------------------------------------------------------------------------------------------
/**
 * Holds the active call. This call should be in the ACTIVE state.
 *
 * @return
 * - LE_OK -- Succeeded. 
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Hold
(
    Call reference IN                                              ///< The call reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Resumes the holding call. This call should be in the HOLD state.
 *
 * @return
 * - LE_OK -- Succeeded. 
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Resume
(
    Call reference IN                                              ///< The call reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Swaps calls to make one active and put the another on hold.
 * This should be two calls and one is on holding state and the another is on active state.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Swap
(
    Call reference IN                                              ///< The call reference.
);


