    HAS_NAV_SOLUTION_MASK,             ///< Valid navSolutionMask.
    HAS_POS_TECH_MASK,                 ///< Valid locGnssTechMask
                                       ///  via @ref taf_locGnss_GetPositionTechnology
    HAS_SV_SOURCE_INFO,                ///< Valid LocSvInfoSource.
    HAS_POS_DYNAMICS_DATA,             ///< Valid position dynamics data.
    HAS_EXT_DOP,                       ///< Valid GDOP and TDOP.
    HAS_NORTH_STD_DEV,                 ///< Valid North standard deviation
                                       ///  via @ref taf_locGnss_GetStdDeviationAzimuthInfo
    HAS_EAST_STD_DEV,                  ///< Valid East standard deviation
                                       ///  via @ref taf_locGnss_GetStdDeviationAzimuthInfo
    HAS_NORTH_VEL,                     ///< Valid North Velocity
                                       /// via @ref taf_locGnss_GetVRPBasedVelocity
    HAS_EAST_VEL,                      ///< Valid East Velocity
                                       ///  via @ref taf_locGnss_GetVRPBasedVelocity
    HAS_UP_VEL,                        ///< Valid Up Velocity
                                       ///  via @ref taf_locGnss_GetVRPBasedVelocity
    HAS_NORTH_VEL_UNC,                 ///< Valid North Velocity Uncertainty.
    HAS_EAST_VEL_UNC,                  ///< Valid East Velocity Uncertainty.
    HAS_UP_VEL_UNC,                    ///< Valid Up Velocity Uncertainty.
    HAS_LEAP_SECONDS,                  ///< Valid leap seconds information
                                       ///  via @ref taf_locGnss_GetGpsLeapSeconds
    HAS_TIME_UNC,                      ///< Valid timeUncMs
                                       ///  via @ref taf_locGnss_GetTimeAccuracy
    HAS_NUM_SV_USED_IN_POSITION,       ///< Valid number of SV used
                                       ///  via @ref taf_locGnss_GetSvUsedInPosition
    HAS_CALIBRATION_CONFIDENCE_PERCENT,///< Valid sensor calibrationConfidencePercent
                                       ///  via @ref taf_locGnss_GetCalibrationData
    HAS_CALIBRATION_STATUS,            ///< Valid sensor calibrationConfidence
                                       ///  via @ref taf_locGnss_GetCalibrationData
    HAS_OUTPUT_ENG_TYPE,               ///< Valid output engine type
                                       ///  via @ref taf_locGnss_GetLocationOutputEngParams
    HAS_OUTPUT_ENG_MASK,               ///< Valid output engine mask.
                                       ///  via @ref taf_locGnss_GetLocationOutputEngParams
    HAS_CONFORMITY_INDEX_FIX,          ///< Valid conformity index
                                       ///  via @ref taf_locGnss_GetConformityIndex
    HAS_LLA_VRP_BASED,                 ///< Valid LLA VRP based
                                       ///  via @ref taf_locGnss_GetVRPBasedLLA
    HAS_ENU_VELOCITY_VRP_BASED,        ///< Valid ENU VRP based
                                       ///  via @ref taf_locGnss_GetVRPBasedVelocity
    HAS_ALTITUDE_TYPE,                 ///< Valid altitude type
                                       ///  via @ref taf_locGnss_AltType
    HAS_REPORT_STATUS,                 ///< Valid report status
                                       ///  via @ref taf_locGnss_GetReportStatus
    HAS_INTEGRITY_RISK_USED,           ///< Valid integrity risk.
    HAS_PROTECT_LEVEL_ALONG_TRACK,     ///< Valid protect level along track.
    HAS_PROTECT_LEVEL_CROSS_TRACK,     ///< Valid protect level cross track.
    HAS_PROTECT_LEVEL_VERTICAL,        ///< Valid protect level vertical.
    HAS_SOLUTION_STATUS,               ///< Valid DR Solution status.
    HAS_LEAP_SECONDS_UNC               ///< Valid leap seconds uncertainty.
                                       ///< via @ref taf_locGnss_GetLeapSecondsUncertainty
};

//--------------------------------------------------------------------------------------------------
/**
 * Type of positioning engine.
 */
//--------------------------------------------------------------------------------------------------
BITMASK EngineMask
{
    STANDARD_POSITIONING_ENGINE,      ///< For standard GNSS position engines.
    DEAD_RECKONING_ENGINE,            ///< For dead reckoning position engines.
    PRECISE_POSITIONING_ENGINE,       ///< For precise position engines.
    VP_POSITIONING_ENGINE             ///< For VP position engine.
};

//--------------------------------------------------------------------------------------------------
/**
 * Type of location engine.
 */
//--------------------------------------------------------------------------------------------------
ENUM LocationAggregationType
{
    LOC_OUTPUT_ENGINE_FUSED,        ///< This is the propagated/aggregated report
                                    /// from the fixes of all engines running on the
                                    /// system (e.g., DR/SPE/PPE).
    LOC_OUTPUT_ENGINE_SPE,          ///< This fix is the unmodified fix from modem GNSS engine.
    LOC_OUTPUT_ENGINE_PPE,          ///< This is the unmodified fix from PPP engine.
    LOC_OUTPUT_ENGINE_VPE           ///< This is the unmodified fix from VPE engine.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reliability of the horizontal and vertical positions.
 */
//--------------------------------------------------------------------------------------------------
ENUM LocationReliability
{
    RELIABILITY_UNKNOWN  = -1,    ///< Unknown location reliability.
    RELIABILITY_NOT_SET  = 0,     ///< Location reliability is not set. The reliability
                                  /// of this position report could not be determined.
                                  /// It could be unreliable/reliable.
    RELIABILITY_VERY_LOW = 1,     ///< Location reliability is very low.
                                  ///  Use it at your own risk.
    RELIABILITY_LOW = 2,          ///< Location reliability is low, little, or no
                                  ///  cross-checking is possible.
    RELIABILITY_MEDIUM = 3,       ///< Location reliability is medium, limited cross-check passed.
    RELIABILITY_HIGH = 4          ///< Location reliability is high, strong cross-check passed.
};

//--------------------------------------------------------------------------------------------------
/**
 * Type of location technology.
 */
//--------------------------------------------------------------------------------------------------
BITMASK LocationTechnologyType
{
    LOC_GNSS,                     ///< Location was calculated using GNSS-based technology.
    LOC_CELL,                     ///< Location was calculated using Cell-based technology.
    LOC_WIFI,                     ///< Location was calculated using WiFi-based technology.
    LOC_SENSORS,                  ///< Location was calculated using Sensors-based technology.
    LOC_REFERENCE_LOCATION,       ///< Location was calculated using Reference location.
    LOC_INJECTED_COARSE_POSITION, ///< Location was calculated using Coarse position injected
                                  ///  into the location engine.
    LOC_AFLT,                     ///< Location was calculated using AFLT.
    LOC_HYBRID,                   ///< Location was calculated using GNSS and
                                  ///  network-provided measurements.
    LOC_PPE,                      ///< Location was calculated using Precise position engine.
    LOC_VEH,                      ///< Location was calculated using Vehicular data.
    LOC_VIS,                      ///< Location was calculated using Visual data.
    LOC_PROPAGATED                ///< Location was calculated using Propagation logic,
                                  ///  which uses cached measurements.
};

//------------------------------------------------------------------------------------------------
/**
 * Specify the GnssDataValidityType mask.
 */
//------------------------------------------------------------------------------------------------
BITMASK GnssDataValidityType
{
    HAS_JAMMER,   ///< Jammer Indicator is available.
    HAS_AGC       ///< AGC is available.
};

//------------------------------------------------------------------------------------------------
/**
 * Specify the different types of constellation supported.
 */
//------------------------------------------------------------------------------------------------
ENUM GnssSystem {
  LOC_SV_SYSTEM_UNKNOWN = -1,  ///< UNKNOWN satellite.
  LOC_SV_SYSTEM_GPS = 1,       ///< GPS satellite.
  LOC_SV_SYSTEM_GALILEO = 2,   ///< GALILEO satellite.
  LOC_SV_SYSTEM_SBAS = 3,      ///< SBAS satellite.
  LOC_SV_SYSTEM_COMPASS = 4,   ///< COMPASS satellite. This is not supported.
  LOC_SV_SYSTEM_GLONASS = 5,   ///< GLONASS satellite.
  LOC_SV_SYSTEM_BDS = 6,       ///< BDS satellite
  LOC_SV_SYSTEM_QZSS = 7,      ///< QZSS satellite.
  LOC_SV_SYSTEM_NAVIC = 8      ///< NAVIC satellite.
};

//------------------------------------------------------------------------------------------------
/** Specify GNSS signal type and RF Band used in struct GnssMeasurementInfo
 *  and ISVInfo class.
 */
//------------------------------------------------------------------------------------------------
ENUM GnssSignalType {
  UNKNOWN_SIGNAL_MASK = 0,     ///< GNSS signal type is unknown.
  GPS_L1CA = 1,                ///< GNSS signal is of GPS L1CA RF Band.
  GPS_L1C = 2,                 ///< GNSS signal is of GPS L1C RF Band.
  GPS_L2 = 4,                  ///< GNSS signal is of GPS L2 RF Band.
  GPS_L5 = 8,                  ///< GNSS signal is of GPS L5 RF Band.
  GLONASS_G1 = 16,             ///< GNSS signal is of GLONASS G1 (L1OF) RF Band.
  GLONASS_G2 = 32,             ///< GNSS signal is of GLONASS G2 (L2OF) RF Band.
  GALILEO_E1 = 64,             ///< GNSS signal is of GALILEO E1 RF Band.
  GALILEO_E5A = 128,           ///< GNSS signal is of GALILEO E5A RF Band.
  GALILIEO_E5B = 256,          ///< GNSS signal is of GALILEO E5B RF Band.
  BEIDOU_B1 = 512,             ///< GNSS signal is of BEIDOU B1 RF Band.
  BEIDOU_B2 = 1024,            ///< GNSS signal is of BEIDOU B2 RF Band.
  QZSS_L1CA = 2048,            ///< GNSS signal is of QZSS L1CA RF Band.
  QZSS_L1S = 4096,             ///< GNSS signal is of QZSS L1S RF Band.
  QZSS_L2 = 8192,              ///< GNSS signal is of QZSS L2 RF Band
  QZSS_L5 = 16384,             ///< GNSS signal is of QZSS L5 RF Band.
  SBAS_L1 = 32768,             ///< GNSS signal is of SBAS L1 RF Band.
  BEIDOU_B1I = 65536,          ///< GNSS signal is of BEIDOU B1I RF Band.
  BEIDOU_B1C = 131072,         ///< GNSS signal is of BEIDOU B1C RF Band.
  BEIDOU_B2I = 262144,         ///< GNSS signal is of BEIDOU B2I RF Band.
  BEIDOU_B2AI = 524288,        ///< GNSS signal is of BEIDOU B2AI RF Band.
  NAVIC_L5 = 1048576,          ///< GNSS signal is of NAVIC L5 RF Band.
  BEIDOU_B2AQ = 2097152,       ///< GNSS signal is of BEIDOU B2A_Q RF Band.
  BEIDOU_B2BI = 4194304,       ///< GNSS signal is of BEIDOU B2B_I RF band.
  BEIDOU_B2BQ = 8388608,       ///< GNSS signal is of BEIDOU B2B_Q RF band.
  NAVIC_L1 = 16777216          ///< GNSS signal is of NAVIC L1 RF band.
};

//------------------------------------------------------------------------------------------------
/** Specify GNSS signal type and RF band for jammer info and automatic
 *  gain control metric in GnssData.
 */
//------------------------------------------------------------------------------------------------
ENUM GnssDataSignalTypes {
  DATA_SIGNAL_TYPE_GPS_L1CA = 0,      ///< GPS L1CA RF Band.
  DATA_SIGNAL_TYPE_GPS_L1C = 1,       ///< GPS L1C RF Band.
  DATA_SIGNAL_TYPE_GPS_L2C_L = 2,     ///< GPS L2 RF Band.
  DATA_SIGNAL_TYPE_GPS_L5_Q = 3,      ///< GPS L5 RF Band.
  DATA_SIGNAL_TYPE_GLONASS_G1 = 4,    ///< GLONASS G1 (L1OF) RF Band.
  DATA_SIGNAL_TYPE_GLONASS_G2 = 5,    ///< GLONASS G2 (L2OF) RF Band.
  DATA_SIGNAL_TYPE_GALILEO_E1_C = 6,  ///< GALILEO E1 RF Band.
  DATA_SIGNAL_TYPE_GALILEO_E5A_Q = 7, ///< GALILEO E5A RF Band.
  DATA_SIGNAL_TYPE_GALILEO_E5B_Q = 8, ///< GALILEO E5B RF Band.
  DATA_SIGNAL_TYPE_BEIDOU_B1_I = 9,   ///< BEIDOU B1_I RF Band.
  DATA_SIGNAL_TYPE_BEIDOU_B1C = 10,   ///< BEIDOU B1C RF Band.
  DATA_SIGNAL_TYPE_BEIDOU_B2_I = 11,  ///< BEIDOU B2_I RF Band.
  DATA_SIGNAL_TYPE_BEIDOU_B2A_I = 12, ///< BEIDOU B2A_I RF Band.
  DATA_SIGNAL_TYPE_QZSS_L1CA = 13,    ///< QZSS L1CA RF Band.
  DATA_SIGNAL_TYPE_QZSS_L1S = 14,     ///< QZSS L1S RF Band.
  DATA_SIGNAL_TYPE_QZSS_L2C_L = 15,   ///< QZSS L2C_L RF Band.
  DATA_SIGNAL_TYPE_QZSS_L5_Q = 16,    ///< QZSS L5_Q RF Band.
  DATA_SIGNAL_TYPE_SBAS_L1_CA = 17,   ///< SBAS L1_CA RF Band.
  DATA_SIGNAL_TYPE_NAVIC_L5 = 18,     ///< NAVIC L5 RF Band.
  DATA_SIGNAL_TYPE_BEIDOU_B2A_Q = 19, ///< BEIDOU B2A_Q RF Band.
  DATA_SIGNAL_TYPE_BEIDOU_B2BI = 20,  ///< BEIDOU B2BI RF Band.
  DATA_SIGNAL_TYPE_BEIDOU_B2BQ = 21,  ///< BEIDOU B2BQ RF Band.
  DATA_SIGNAL_TYPE_NAVIC_L1 = 22      ///< NAVIC L1 RF Band.
};

//------------------------------------------------------------------------------------------------
/**
 * Specify the status of the report.
 */
//------------------------------------------------------------------------------------------------
ENUM ReportStatus {
    REPORT_STATUS_UNKNOWN = -1,      ///< Report status is unknown.
    REPORT_STATUS_SUCCESS = 0,       ///< Report status is successful. The engine is able to calculate the desired fix.
                                     ///  Most of the fields in position sample will be valid.
    REPORT_STATUS_INTERMEDIATE = 1,  ///< Report is still in progress. The engine has not completed its
                                     ///  calculations when this report was generated. Accuracy of various
                                     ///  fields is non-optimal. Only some of the fields in position sample
                                     ///  will be valid.
    REPORT_STATUS_FAILURE = 2        ///< Report status has failed. The engine is not able to calculate the fix.
                                     ///  Most of the fields in position sample
                                     ///  will be invalid.
};

//------------------------------------------------------------------------------------------------
/**
 * Specify the status of the previously downloaded XTRA data.
 */
//------------------------------------------------------------------------------------------------
ENUM XtraDataStatus
{
    XTRA_DATA_STATUS_UNKNOWN,   ///< If XTRA feature is disabled or if XTRA feature is enabled,
                                ///  but XTRA daemon has not yet retrieved the assistance data status
                                ///  from modem on early stage of device bootup, XTRA data status
                                ///  will be unknown.
    XTRA_DATA_STATUS_NOT_AVAIL, ///< If XTRA feature is enabled, but XTRA data is not present
                                ///  on the device.
    XTRA_DATA_STATUS_NOT_VALID, ///< If XTRA feature is enabled, but XTRA data is not valid.
    XTRA_DATA_STATUS_VALID      ///< If XTRA feature is enabled, XTRA data has been downloaded,
                                ///  and is currently valid.
};

//------------------------------------------------------------------------------------------------
/**
 * Specify the valid mask for the configuration parameters of dead reckoning position engine.
 */
//------------------------------------------------------------------------------------------------
BITMASK DRConfigValidityType
{
    BODY_TO_SENSOR_MOUNT_PARAMS_VALID,    ///< Validity of body to sensor mount parameters.
    VEHICLE_SPEED_SCALE_FACTOR_VALID,     ///< Validity of vehicle speed scale factor.
    VEHICLE_SPEED_SCALE_FACTOR_UNC_VALID, ///< Validity of vehicle speed scale factor uncertainty.
    GYRO_SCALE_FACTOR_VALID,              ///< Validity of gyro scale factor.
    GYRO_SCALE_FACTOR_UNC_VALID           ///< Validity of gyro scale factor uncertainty.
};

//--------------------------------------------------------------------------------------------------
/**
 * Dead reckoning configuration parameters.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DrParams
{
    double rollOffset;    ///< The misalignment of the sensor board along the horizontal plane of
                          ///  the vehicle chassis measured looking from the vehicle to forward
                          ///  direction. In unit of degrees. Range is -180.0 to 180.0.
    double yawOffset;     ///< The misalignment along the horizontal plane of the vehicle chassis
                          ///  measured looking from the vehicle to the right side. Positive pitch
                          ///  indicates vehicle is inclined such that the forward wheels are at
                          ///  higher elevation than the rear wheels. In unit of degrees.
                          ///  Range is -180.0 to 180.0.
    double pitchOffset;   ///< The angle between the vehicle forward direction and the sensor
                          ///  axis as seen from the top of the vehicle, and measured in
                          ///  counterclockwise direction. In unit of degrees.
                          ///  Range is -180.0 to 180.0.
    double offsetUnc;     ///< Single uncertainty number that may be the largest of the
                          ///  uncertainties for roll offset, pitch offset, and yaw offset.
                          ///  In unit of degrees. Range is -180.0 to 180.0.
    double speedFactor;   ///< Vehicle speed scale factor configuration input for the
                          ///  dead reckoning positioning engine. The multiplicative scale factor is
                          ///  applied to the received vehicle speed value (in meters/second) to
                          ///  obtain the true vehicle speed. Range is 0.9 to 1.1.
                          ///  @b NOTE: The scale factor is specific to a given vehicle make and model.
    double speedFactorUnc;///< Vehicle speed scale factor uncertainty (68% confidence) configuration
                          ///  input for the dead reckoning positioning engine. Range is 0.0 to 0.1.
                          ///  @b NOTE: The scale factor uncertainty is specific to a given
                          ///  vehicle make and model.
    double gyroFactor;    ///< Gyroscope scale factor configuration input for the dead reckoning
                          ///  positioning engine.The multiplicative scale factor is applied
                          ///  to received gyroscope value to obtain the true value. Range is
                          ///  0.9 to 1.1. @b NOTE: The scale factor is specific to the Gyroscope
                          ///  sensor and typically derived from either the sensor's data sheet
                          ///  or from actual calibration.
    double gyroFactorUnc; ///< Gyroscope scale factor uncertainty (68% confidence) configuration
                          ///  input for the dead reckoning positioning engine. Range is 0.0 to 0.1.
                          ///  @b NOTE: The scale factor uncertainty is specific to the Gyroscope
                          ///  sensor and typically derived from either the sensor's data sheet
                          ///  or from actual calibration.
};

//--------------------------------------------------------------------------------------------------
/**
 * Lever arm configuration parameters.
 */
//--------------------------------------------------------------------------------------------------
STRUCT LeverArmParams
{
    double forwardOffsetMeters;  ///< Offset along the vehicle forward axis, in unit of meters.
    double sidewaysOffsetMeters; ///< Offset along the vehicle starboard axis, in unit of meters.
                                 /// Left side offset is negative, and right side offset is positive.
    double upOffsetMeters;       /// Offset along the vehicle up axis, in unit of meters.
    uint8 levArmType;            /// Type of lever arm parameter.
};

//--------------------------------------------------------------------------------------------------
/**
 * Kinematics related information related to device body frame parameters.
 */
//--------------------------------------------------------------------------------------------------
STRUCT KinematicsData
{
    uint64 bodyFrameDataMask; ///< The valid bits of the body frame data
                              /// via @ref taf_locGnss_GetBodyFrameData
    double longAccel;         ///< Forward acceleration in body frame (meter/second^2).
    double latAccel;          ///< Sideward acceleration in body frame (meter/second^2).
    double vertAccel;         ///< Vertical acceleration in body frame (meter/second^2).
    double yawRate;           ///< Heading rate (rad/sec).
    double pitch;             ///< Body pitch (radians).
    double longAccelUnc;      ///< Uncertainty of forward acceleration in body frame (meter/second^2).
                              ///  Uncertainty is defined with 68% confidence level.
    double latAccelUnc;       ///< Uncertainty of side-ward acceleration in body frame (meter/second^2).
                              ///  Uncertainty is defined with 68% confidence level.
    double vertAccelUnc;      ///< Uncertainty of vertical acceleration in body frame (meter/second^2).
                              ///  Uncertainty is defined with 68% confidence level.
    double yawRateUnc;        ///< Uncertainty of heading rate (rad/second).
                              ///  Uncertainty is defined with 68% confidence level.
    double pitchUnc;          ///< Uncertainty of body pitch (radians).
                              ///  Uncertainty is defined with 68% confidence level.
    double pitchRate;         ///< Body pitch rate, in unit of rad/sec.
    double pitchRateUnc;      ///< Uncertainty of pitch rate, in unit of rad/sec.
                              ///  Uncertainty is defined with 68% confidence level.
    double roll;              ///< Roll of the body frame, clockwise is positive, in unit of radian.
    double rollUnc;           ///< Uncertainty of roll, in unit of radian.
                              ///  Uncertainty is defined with 68% confidence level.
    double rollRate;          ///< Roll rate of the body frame, clockwise is positive,
                              ///  in unit of rad/sec.
    double rollRateUnc;       ///< Uncertainty of roll rate, in unit of rad/sec.
                              ///  Uncertainty is defined with 68% confidence level.
    double yaw;               ///< Yaw of the body frame, clockwise is positive, in unit of radian.
    double yawUnc;            ///< Uncertainty of yaw, in unit of radian.
                              ///  Uncertainty is defined with 68% confidence level.
};

//--------------------------------------------------------------------------------------------------
/**
 * Set of SVs that are used to calculate position.
 */
//--------------------------------------------------------------------------------------------------
STRUCT SvUsedInPosition
{
    uint64 gps;    ///< Specify the set of SVs from GPS constellation that are used to compute the position.
                   ///  Bit 0 to Bit 31 corresponds to GPS SV ID 1 to 32.
    uint64 glo;    ///< Specify the set of SVs from GLONASS constellation that are used to compute the position.
                   ///  Bit 0 to Bit 31 corresponds to GLO SV ID 65 to 96.
    uint64 gal;    ///< Specify the set of SVs from GALILEO constellation that are used to compute the position.
                   ///  Bit 0 to Bit 35 corresponds to GAL SV ID 301 to 336.
    uint64 bds;    ///< Specify the set of SVs from BEIDOU constellation that are used to compute the position.
                   ///  Bit 0 to Bit 62 corresponds to BDS SV ID 201 to 263.
    uint64 qzss;   ///< Specify the set of SVs from QZSS constellation that are used to compute the position.
                   ///  Bit 0 to Bit 4 corresponds to QZSS SV ID 193 to 197.
    uint64 navic;  ///< Specify the set of SVs from NAVIC constellation that are used to compute the position.
                   ///  Bit 0 to Bit 13 corresponds to NAVIC SV ID 401 to 414.
};

//------------------------------------------------------------------------------------------------
/** Specify the satellite vehicle measurements that are used
 *  to calculate location in @ref taf_locGnss_GetMeasurementUsageInfo.
 */
//------------------------------------------------------------------------------------------------
STRUCT GnssMeasurementInfo {
  uint32 gnssSignalType;        ///< @ref taf_locGnss_GetMeasurementUsageInfo
  GnssSystem gnssConstellation; ///< Specifies GNSS Constellation Type

  uint16 gnssSvId;              ///< GNSS SV ID
                                /// For SV ID information, refer to @SvUsedInPosition.
};

//------------------------------------------------------------------------------------------------
/**
 * Jammer and AGC GNSS Data parameters.
 */
//------------------------------------------------------------------------------------------------
STRUCT GnssData
{
  uint32 gnssDataMask; ///< bitwise OR of GnssDataValidityType
  double jammerInd;    ///< Each index represents the signal type in @ref GnssDataSignalTypes.
  double agc;          ///< Automatic gain control for each signal type. Each index
                       ///  corresponds to the signal type in @ref GnssDataSignalTypes.
};


STRUCT XtraStatusParams
{
    uint8 featureEnabled;     ///< XTRA assistance data and NTP time
                              ///  download is enabled or disabled.
    uint32 xtraDataStatus;    ///< XTRA assistance data status.
                              ///  If XTRA assistance data download is not enabled,
                              ///  this field will be set to TAF_LOCGNSS_XTRA_DATA_STATUS_UNKNOWN.
    uint32 xtraValidForHours; ///< Number of hours that XTRA assistance data will
                              ///  remain valid. This field will be valid when xtraDataStatus
                              ///  is set to TAF_LOCGNSS_XTRA_DATA_STATUS_VALID. For all other
                              ///  XtraDataStatus, this field will be set to 0.
};

//-------------------------------------------------------------------------------------------------
/**
 * Handler for NMEA event notification.
 */
//-------------------------------------------------------------------------------------------------
HANDLER NmeaHandler
(
    uint64 timestamp                    IN,    ///< The timestamp.
    string nmeaMask[NMEA_STRING_MAX]    IN     ///< The NMEA string.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information about NMEA.
 */
//-------------------------------------------------------------------------------------------------
EVENT Nmea
(
    NmeaHandler handler      ///< NMEA handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the status of the Location service per client session.
 *
 * @return
 * - TAF_LOCGNSS_STATE_ACTIVE   The Location service is active when the GNSS session is started.
 * - TAF_LOCGNSS_STATE_READY    The Location service is ready when the GNSS session is stopped.
 * - TAF_LOCGNSS_STATE_DISABLED The Location service is disabled.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION State GetState
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Get Satellite Vehicle status per client session.
 *
 * @return
 *  - LE_FAULT         Failed to find the positionSample.
 *  - LE_OUT_OF_RANGE  At least one of the retrieved parameters is invalid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: In case the function returns LE_OUT_OF_RANGE, some of the retrieved parameters may be
 *       valid. Compare them with UINT8_MAX.
 *
 * @b NOTE: If the caller passes an invalid position sample reference to this function,
 *       it is a fatal error and the client will be killed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSatellitesStatus
(
    Sample        positionSampleRef IN,     ///< Position sample reference.
    uint8         satsInViewCount OUT,      ///< Number of satellites in view.
    uint8         satsTrackingCount OUT,    ///< Number of satellites in view when tracking GNSS.
    uint8         satsUsedCount OUT         ///< Number of satellites in view used for
                                            ///  GNSS navigation.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get location acquisition rate per client session.
 *
 * @return
 *  - LE_OK            Succeeded.
 *  - LE_FAULT         Failed.
 *  - LE_NOT_PERMITTED The Location service state is not ready.
 *
 * @b NOTE: If the caller passes a null pointer to this function, it is a fatal error and the
 *       client will be killed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAcquisitionRate
(
    uint32 rate      OUT  ///< Acquisition rate in milliseconds for GNSS.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the TTFF in milliseconds per client session.
 *
 * @return
 *  - LE_BUSY          Not fixed position and TTFF cannot be measured.
 *  - LE_NOT_PERMITTED The Location service state is not enabled or not started.
 *  - LE_OK            Succeeded.
 *  - LE_FAULT         Failed.
 *
 * @b NOTE: This API is intended exclusively for testing purposes.
 *
 *       Please follow these steps before initiating the tests:
 *       1.Set the AUTO_START_GNSS parameter in the /etc/gps.conf file to zero and reboot the device
 *       to apply the changes.
 *       2.Ensure all other GNSS clients are disabled.
 *
 *       The TTFF in these cases would be precise. The TTFF accuracy is lower with higher acquisition
 *       rate and is the most precise acquisition at 100ms (10Hz).
 *
 *       In case of start and hot start, the TTFF only represents the time between starting or
 *       restarting to receive the reports and receiving first fix reports since these APIs do not
 *       restart the underlying GNSS engine.
 *
 * @b NOTE: If the caller passes a null pointer to this function, it is a fatal error and the
 *       client will be killed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTtff
(
    uint32 ttff                     OUT ///< TTFF in milliseconds.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the satellite's vehicle information per client session.
 * This API provides information about SVs in view.
 *
 * @return
 *  - LE_FAULT         Failed in finding the positionSample.
 *  - LE_OUT_OF_RANGE  At least one of the retrieved parameters is invalid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: satId[] can be set to 0 if that information list index is not configured, so
 *       all satellite parameters (satConst[], satSnr[], satAzim[], satElev[]) are fixed to 0.
 *
 * @b NOTE: For LE_OUT_OF_RANGE returned code, invalid value depends on the field type:
 * UINT16_MAX for satId, TAF_LOCGNSS_SV_CONSTELLATION_UNDEFINED for satConst, false for satUsed,
 * UINT8_MAX for satSnr, UINT16_MAX for satAzim, and UINT8_MAX for satElev.
 *
 * @b NOTE: In case the function returns LE_OUT_OF_RANGE, some of the retrieved parameters may be
 *       valid.
 *
 * @b NOTE: If the caller passes an invalid position sample reference to this function,
 *       it is a fatal error and the client will be killed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSatellitesInfo
(
    Sample        positionSampleRef IN,             ///< Position sample reference.
    uint16        satId[SV_INFO_MAX_LEN] OUT,       ///< IDs of satellites in view.
    Constellation satConst[SV_INFO_MAX_LEN] OUT,    ///< GNSS constellation of the SV.
    bool          satUsed[SV_INFO_MAX_LEN] OUT,     ///< True if SV is used for computing position.
    uint8         satSnr[SV_INFO_MAX_LEN] OUT,      ///< Signal-to-noise ratio.Units in dB-Hz.
    uint16        satAzim[SV_INFO_MAX_LEN] OUT,     ///< Azimuth; range is 0
                                                    ///  to 360 degrees.
    uint8         satElev[SV_INFO_MAX_LEN] OUT      ///< Elevation; range is 0
                                                    ///  to 90 degrees.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's time accuracy per client session.
 *
 * @return
 *  - LE_FAULT         Failed.
 *  - LE_OUT_OF_RANGE  The retrieved time accuracy is invalid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: If the caller passes an invalid position sample reference or a null pointer to this
 *       function, it is a fatal error and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTimeAccuracy
(
    Sample positionSampleRef  IN,       ///< Position sample reference.
    uint32 timeAccuracy OUT             ///< Time accuracy in nanoseconds. For PVT report from SPE
                                        ///  engine, confidence level is at 99%.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the position sample's epoch time per client session.
 *
 * @return
 *  - LE_FAULT         Failed to get the epoch time.
 *  - LE_OK            Succeeded.
 *  - LE_OUT_OF_RANGE  The retrieved time is invalid.
 *
 * @b NOTE: The epoch time is the number of seconds elapsed.
 *
 * @b NOTE: If the caller passes an invalid position sample reference or a null pointer to this
 *       function, it is a fatal error and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEpochTime
(
    Sample positionSampleRef  IN, ///< Position sample reference.
    uint64 milliseconds OUT       ///< Epoch time in milli seconds since Jan 1, 1970.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the resolution for the DOP parameters per client session.
 *
 * @return LE_OK               Succeeded.
 * @return LE_BAD_PARAMETER    Invalid parameter provided.
 * @return LE_FAULT            Failed.
 *
 * @b NOTE: The function sets the same resolution to all DOP values returned by
 *       taf_locGnss_GetDilutionOfPrecision(). The resolution setting takes effect immediately.
 *
 * @b NOTE: The resolution setting is done per client session.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDopResolution
(
    Resolution resolution    IN   ///< DOP resolution.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the DOP parameters for the fixed position per client session.
 *
 * @return
 *  - LE_FAULT         Failed to find the DOP value.
 *  - LE_OUT_OF_RANGE  The retrieved parameter is invalid (set to UINT16_MAX).
 *  - LE_OK            Succeeded.
 *
 *
 * @b NOTE: The DOP value is given with 3 decimal places by default, i.e., DOP value 2200 = 2.200
 *       The resolution can be modified by calling the @c taf_locGnss_SetDopResolution() function.
 *
 * @b NOTE: If the caller passes an invalid position sample reference to this function,
 *       it is a fatal error and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDilutionOfPrecision
(
    Sample positionSampleRef IN,           ///< Position sample reference.
    DopType dopType IN,                    ///< DOP type.
    uint16 dop OUT                         ///< DOP corresponding to the dopType
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets leap second information per client session.
 *
 * @return
 *  - LE_OK            Succeeded.
 *  - LE_FAULT         Failed to get the data.
 *
 * @b NOTE: Insertion of each UTC leap second is usually decided about six months in advance by the
 *       International Earth Rotation and Reference Systems Service (IERS).
 *
 * @b NOTE: If the caller passes a null pointer to this function, it is considered a fatal
 *       error and the client will be killed.
 *
 * @b NOTE: If the return value of a parameter is INT32_MAX/UINT64_MAX, the parameter is not valid.
 *
 * @b NOTE: Currently the API is not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetLeapSeconds
(
    uint64 gpsTime OUT,              ///< The number of milliseconds of GPS time.
    int32 currentLeapSeconds OUT,    ///< Current UTC leap seconds value in milliseconds.
    uint64 changeEventTime OUT,      ///< The number of milliseconds.
    int32  nextLeapSeconds OUT       ///< UTC leap seconds value to be applied in milliseconds.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's GPS time per client session.
 *
 * @return
 *  - LE_FAULT         Failed to get the time.
 *  - LE_OUT_OF_RANGE  The retrieved time is invalid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: If the caller passes an invalid position sample reference or null pointers to this
 *       function, it is a fatal error and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetGpsTime
(
    Sample positionSampleRef  IN, ///< Position sample reference.
    uint32 gpsWeek OUT,           ///< GPS week number.
    uint32 gpsTimeOfWeek OUT      ///< Time in to the current week in ms.
);

