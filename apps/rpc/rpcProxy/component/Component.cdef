sources:
{
    rpcProxy.c
    rpcProxyConfig.c
    rpcClientProxy.c
    rpcServerProxy.c
    rpcProxyMessaging.c
}

requires:
{
    api:
    {
        $TELAF_ROOT/interfaces/someipGW/taf_someipClnt.api
        $TELAF_ROOT/interfaces/someipGW/taf_someipSvr.api
        le_instStat.api
    }
}

cflags:
{
    -I${LEGATO_ROOT}/framework/liblegato
    -I${LEGATO_ROOT}/framework/liblegato/linux
    -I${LEGATO_ROOT}/framework/daemons/linux/serviceDirectory
    -I${LEGATO_BUILD}/framework/libjansson/include
}

ldflags:
{
    -ljansson
}

bundles:
{
    // Bundle a reference JSON file. The valid JSON file
    // name shall be "taf_rpc.json".
    file:
    {
        #if ${LE_CONFIG_FLAVOR_LXC} = y
        [rw] taf_rpcLXC.json  /taf_rpc.json
        #else
        [rw] taf_rpc_sample.json   /
        [rw] taf_rpc.json   /
        #endif
    }
}
