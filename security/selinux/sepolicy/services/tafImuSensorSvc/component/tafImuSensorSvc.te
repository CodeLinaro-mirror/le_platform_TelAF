policy_module(tafImuSensorSvc, 1.0)

# Framework definition for telaf
type telaf_tafImuSensorSvc_exec_t;
files_type(telaf_tafImuSensorSvc_exec_t);

type telaf_tafImuSensorSvc_t;

type telaf_tafImuSensorSvc_data_t;
files_type(telaf_tafImuSensorSvc_data_t);

init_telaf_app_domain(telaf_tafImuSensorSvc_t,telaf_tafImuSensorSvc_exec_t)

# Allow service to manage its own data directory; registers with admin domain.
telaf_manage_app_data_files(telaf_tafImuSensorSvc_t, telaf_tafImuSensorSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafImuSensorSvc_exec_t)

ifdef(`sa525m',`
telux_allow_sensor(telaf_tafImuSensorSvc_t)
telux_allow_sensor_data_read(telaf_tafImuSensorSvc_t)
telux_allow_sensor_privileged_ops(telaf_tafImuSensorSvc_t)
allow telaf_tafImuSensorSvc_t self:capability { sys_resource };
')