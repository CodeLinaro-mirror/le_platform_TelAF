maxThreads: 600
sandboxed: true

executables:
{
    tafWlanInteractiveTest = ( wlanInteractiveTestComponent )
}

start: manual

processes:
{
    run:
    {
        (tafWlanInteractiveTest)
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafWlanInteractiveTest.wlanInteractiveTestComponent.taf_wlan -> tafWlanSvc.taf_wlan
    tafWlanInteractiveTest.wlanInteractiveTestComponent.taf_wlanAp -> tafWlanSvc.taf_wlanAp
    tafWlanInteractiveTest.wlanInteractiveTestComponent.taf_wlanSta -> tafWlanSvc.taf_wlanSta
}
