	<**
		@description : A broadcast event of type uint8 triggered on triggerEventUINT8 method request.
	**>
	broadcast TestEventUINT8 {
		out {
			<**
				@description : An uint8 parameter.
			**>
			UInt8 uINT8Value
		}
	}

