/**
 * @page c_tafNetwork Network Service
 *
 * @ref taf_net_interface.h "API Reference"
 *
 * <HR>
 *
 * The Network service APIs unified TelAF networking APIs for configuration.
 *
 * Network service provides APIs for applications to manage route, gateway, DNS, NAT, GSB, VLAN,
 * Socksv5, L2tp, filter, and firewall.
 *
 * @section c_taf_net_binding IPC interfaces binding
 *
 * All functions of this API are provided by the @b tafNetSvc application service.
 *
 * The following example shows how to bind to the network service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_net -> tafNetSvc.taf_net
   }
   @endverbatim
 *
 * @section c_taf_net_route_management Route management
 *
 * Routes can be changed using taf_net_ChangeRoute with the interface name, destination address,
 * prefix length, metric, and isAdd passed as parameters.
 *
 * The following example shows how to change a route. This example adds a route with interface
 * "eth0", destination address "192.168.10.0", subnet mask "255.255.255.0", and metric 0.
 * @verbatim
   result=taf_net_ChangeRoute("eth0","192.168.10.0",24,0,TAF_NET_ADD);
   @endverbatim
 *
 * Before changing the route, an application can register a state handler using
 * taf_net_AddRouteChangeHandler(). Once the route is changed, the handler will be called.
 * @verbatim
   routeChangeHandlerRef = taf_net_AddRouteChangeHandler(
                           (taf_net_RouteChangeHandlerFunc_t)NetRouteChangeHandlerFunc, NULL);
   @endverbatim
 *
 * To remove the handler, an application can use
 * taf_net_RemoveRouteChangeHandler(routeChangeHandlerRef);
 *
 * @section c_taf_net_gateway_management Gateway management
 *
 * Gateway management provides APIs to set, backup, restore system default gateway, and query
 * interface gateway, including IPv4 and IPv6 addresses.
 *
 * The default gateway can be set using taf_net_SetDefaultGW with the interface name passed as a parameter.
 * The gateway addresses of the interface will be retrieved and set into the system.
 *
 * The following example shows how to set the default gateway. This example sets the system default gateways
 * with gateway addresses from interface "rmnet_data1", including IPv4 and IPv6 gateways.
 * @verbatim
   result=taf_net_SetDefaultGW("rmnet_data1");
   @endverbatim
 *
 * Before setting the default gateway, an application can register a state handler using
 * taf_net_AddGatewayChangeHandler(). Once the default gateway is set, the handler will be called.
 * @verbatim
   gatewayChangeHandlerRef = taf_net_AddGatewayChangeHandler(
                           (taf_net_GatewayChangeHandlerFunc_t)NetGatewayChangeHandlerFunc, NULL);
   @endverbatim
 *
 * To remove the handler, an application can use
 * taf_net_RemoveGatewayChangeHandler(gatewayChangeHandlerRef);
 *
 * The following APIs are supported for gateway management
 *
 * - taf_net_SetDefaultGW() -- Sets the system's default gateway.
 * - taf_net_GetInterfaceGW() -- Gets the interface gateway.
 * - taf_net_BackupDefaultGW() -- Backs up the system gateway.
 * - taf_net_RestoreDefaultGW() -- Restores the system gateway.
 * - taf_net_AddGatewayChangeHandler() -- Adds a handler for gateway changes.
 * - taf_net_RemoveGatewayChangeHandler() -- Removes a handler for gateway changes.
 *
 * @section c_taf_net_DNS_management DNS management
 *
 * DNS can be set using taf_net_SetDNS with the interface name passed as the parameter.
 * The DNS addresses of the interface will be retrieved and set into the system including
 * the primary IPv4 and IPv6 addresses and secondary IPv4 and IPv6 addresses.
 *
 * The following example shows how to set DNS. This example sets the system DNS addresses with DNS
 * addresses from interface "rmnet_data1", including IPv4 and IPv6 DNS addresses.
 * @verbatim
   result=taf_net_SetDNS("rmnet_data1");
   @endverbatim
 *
 * Before setting the DNS, an application can register a state handler using
 * taf_net_AddDNSChangeHandler(). Once the DNS is set, the handler will be called.
 * @verbatim
   DNSChangeHandlerRef = taf_net_AddDNSChangeHandler(
                           (taf_net_DNSChangeHandlerFunc_t)NetDNSChangeHandlerFunc, NULL);
   @endverbatim
 *
 * To remove the handler, an application can use
 * taf_net_RemoveDNSChangeHandler(DNSChangeHandlerRef).
 *
 * taf_net_GetInterfaceDNS() can be used to query the interface DNS addresses, including the
 * primary IPv4 and IPv6 addresses and secondary IPv4 and IPv6 addresses.
 *
 * @section c_taf_net_DestNat_management Static destination NAT management
 *
 * Static destination NAT can be added, removed, and retrieved for the default PDN and on-demand PDN.
 *
 * Static destination NAT can be added using taf_net_AddDestNatEntryOnDefaultPdn with the
 * private IP address, private port, global port, and IP protocol type passed as parameters.
 * The destination NAT will be added into iptables if the default PDN is brought up.
 *
 * The following example shows how to add a static destination NAT entry on the default PDN. This example
 * adds a static destination NAT entry on the default PDN with private IP address
 * "192.168.225.30", private port 5000, global port 5000 and TCP protocol type.
 * @verbatim
   result=taf_net_AddDestNatEntryOnDefaultPdn("192.168.225.30", 5000, 5000, TAF_NET_TCP);
   @endverbatim
 *
 * The following APIs are supported for NAT management
 *
 * - taf_net_AddDestNatEntryOnDefaultPdn() -- Adds destination NAT for default PDN.
 * - taf_net_RemoveDestNatEntryOnDefaultPdn() -- Removes destination NAT for default PDN.
 * - taf_net_AddDestNatEntryOnDemandPdn() -- Adds destination NAT for on-demand PDN.
 * - taf_net_RemoveDestNatEntryOnDemandPdn() -- Removes destination NAT for on-demand PDN.
 * - taf_net_GetDestNatEntryListOnDefaultPdn() -- Gets the reference of destination NAT entry list for the default PDN.
 * - taf_net_GetDestNatEntryListOnDemandPdn() -- Gets the reference of destination NAT entry list for an on-demand PDN.
 * - taf_net_GetFirstDestNatEntry() -- Gets the reference of the first destination NAT entry.
 * - taf_net_GetNextDestNatEntry() -- Gets the reference of the next destination NAT entry.
 * - taf_net_GetDestNatEntryDetails() -- Gets the details of destination NAT entry.
 * - taf_net_DeleteDestNatEntryList() -- Deletes the reference of destination NAT entry list.
 * - taf_net_AddDestNatChangeHandler() -- Adds a handler for NAT changes.
 * - taf_net_RemoveDestNatChangeHandler() -- Removes a handler for NAT changes.

 * @note When adding a static destination NAT entry, and changing the default profile ID the
 *       static destination NAT entry will be changed accordingly.
 *
 * @note After binding VLAN with the profile ID, the corresponding destination NAT for
 *       on-demand PDN can be added into iptables.
 *
 * @section c_taf_net_Vlan_management VLAN management
 *
 * VLAN management provides APIs for VLAN creation, VLAN binding, and VLAN information querying.
 *
 * VLAN can be created using taf_net_CreateVlan with VLAN ID and isAccelerated passed as parameters.
 * After VLAN is created, the application can use taf_net_AddVlanInterface to add VLAN
 * interface and then use taf_net_BindVlanWithProfile to bind VLAN with profile.
 *
 * The following example shows how to create a VLAN. This example creates a VLAN with VLAN ID 5,
 * and the VLAN will not be accelerated. The return value is the VLAN reference.
 * @verbatim
   vlanReference = taf_net_CreateVlan(5, false);
   if (!vlanReference)
   {
      LE_INFO("isAccelerated conflicts with old value");
      return LE_FAULT;
   }
   @endverbatim
 *
 * The following APIs are supported for VLAN
 *
 * - taf_net_CreateVlan()       -- Creates a VLAN.
 * - taf_net_RemoveVlan()       -- Removes a VLAN.
 * - taf_net_GetVlanById()      -- Gets a VLAN reference.

 * A VLAN interface can be added using taf_net_AddVlanInterface with VLAN reference and interface
 * type passed as parameters.
 *
 * The following example shows how to add a VLAN interface. This example adds a VLAN interface
 * into VLAN with interface type TAF_NET_ETH.
 * @verbatim
   result = taf_net_AddVlanInterface(vlanReference, TAF_NET_ETH);
   @endverbatim
 *
 * The following APIs are supported for VLAN interface
 *
 * - taf_net_AddVlanInterface()        -- Adds a VLAN interface.
 * - taf_net_RemoveVlanInterface()     -- Removes a VLAN interface.
 * - taf_net_GetVlanInterfaceList()    -- Gets the reference of the VLAN interface list.
 * - taf_net_GetFirstVlanInterface()   -- Gets the reference of the first VLAN interface.
 * - taf_net_GetNextVlanInterface()    -- Gets the reference of the next VLAN interface.
 * - taf_net_DeleteVlanInterfaceList() -- Deletes the reference of the VLAN interface list.
 * - taf_net_GetVlanInterfaceType()    -- Gets the VLAN interface type.
 *
 * @note When adding or deleting a VLAN interface for a VLAN with isAccelerated as true, if the interface is
 *       the first added or last deleted for the interface type in the system, the system will automatically 
 *       reboot after 5 seconds.
 *
 *
 * The following APIs are supported for VLAN information retrieval.
 *
 * - taf_net_GetVlanEntryList()       -- Gets the reference of the VLAN entry list.
 * - taf_net_GetFirstVlanEntry()      -- Gets the reference of the first VLAN entry.
 * - taf_net_GetNextVlanEntry()       -- Gets the reference of the next VLAN entry.
 * - taf_net_DeleteVlanEntryList()    -- Deletes the reference of the VLAN entry list.
 * - taf_net_GetVlanId()              -- Gets the VLAN ID.
 * - taf_net_IsVlanAccelerated()      -- Checks if the VLAN is accelerated.
 * - taf_net_GetVlanBoundProfileId()  -- Gets the profile ID bound with this VLAN.
 *
 * VLAN can be bound with a profile using taf_net_BindVlanWithProfile with the VLAN reference and
 * profile ID passed as parameters.
 *
 * The following example shows how to bind VLAN with a profile. This example binds VLAN with
 * profile ID 5.
 * @verbatim
   result = taf_net_BindVlanWithProfile(vlanReference, 5);
   @endverbatim
 *
 * The API taf_net_UnbindVlanFromProfile can be used to unbind VLAN from a profile.
 *
 * @note If binding VLAN with the default profile ID, the system will automatically reboot after 5 seconds.
 *
 * @note If unbinding VLAN from default profile id, the system will automatically reboot after 5 seconds.
 *
 * @section c_taf_net_L2TP_management L2TP management
 *
 * L2TP management provides APIs for enabling and disabling L2TP, creating and removing tunnels,
 * adding and removing sessions, setting UDP ports, starting and stopping tunnels, and querying L2TP
 * information.
 *
 * Tunnels can be created using taf_net_CreateTunnel. After creating a tunnel, the application can
 * use taf_net_SetTunnelUdpPort to set the UDP port for UDP encapsulation protocol, taf_net_AddSession
 * to add a session to the tunnel, and then taf_net_StartTunnel to start the tunnel.
 *
 * The following example shows how to create a tunnel. This example creates a tunnel with IP
 * encapsulation protocol, local tunnel ID 1, peer tunnel ID 1, peer IP address fd53:7cb8:383:5::2,
 * and interface name eth0.5. The return value is the tunnel reference.
 * @verbatim
   tunnelReference = taf_net_CreateTunnel(TAF_NET_L2TP_IP, 1, 1, "fd53:7cb8:383:5::2", "eth0.5");
   if (!tunnelReference)
   {
      LE_INFO("Failed to create a tunnel");
      return LE_FAULT;
   }
   @endverbatim
 *
 * An application can synchrounously start a tunnel using taf_net_StartTunnel with the tunnel
 * reference passed as a parameter.
 *
 * @verbatim
   result = taf_net_StartTunnel(tunnelReference);
   if (result != LE_OK)
   {
      LE_INFO("Failed to start a tunnel");
      return LE_FAULT;
   }
   @endverbatim
 *
 * An application can asynchrounously start a tunnel using taf_net_StartTunnelAsync with the tunnel
 * reference and handler function passed as parameters.
 *
 * @verbatim
   taf_net_StartTunnelAsync(tunnelRef,StartTunnelAsyncHandlerFunc,NULL);
   @endverbatim
 *
 * Before asynchrounously starting a tunnel, an application defines a handler function. Once the
 * tunnel is started, the handler function will be called.
 *
 * @verbatim
   void StartTunnelAsyncHandlerFunc(taf_net_TunnelRef_t tunnelRef,
                                    le_result_t result,
                                    void* contextPtr)
   {
       LE_INFO("**** Handler for Start Tunnel Asynchronously (Begin)****");
       LE_INFO("tunnelRef= %p, result: %d", tunnelRef, result);
       LE_INFO("**** Handler for Start Tunnel Asynchronously (End)****");
   }
   @endverbatim
 *
 * The following APIs are supported for tunnel configuration.
 *
 * - taf_net_CreateTunnel()       -- Creates a tunnel.
 * - taf_net_RemoveTunnel()       -- Removes a tunnel.
 * - taf_net_SetTunnelUdpPort()   -- Sets UDP port for a tunnel.
 * - taf_net_AddSession()         -- Adds a session to a tunnel.
 * - taf_net_RemoveSession()      -- Removes a session from a tunnel.
 * - taf_net_StartTunnel()        -- Synchronously starts a tunnel.
 * - taf_net_StartTunnelAsync()   -- Asynchronously starts a tunnel.
 * - taf_net_StopTunnel()         -- Synchronously stops a tunnel.
 * - taf_net_StopTunnelAsync()    -- Asynchronously stops a tunnel.
 * - taf_net_GetTunnelRefById()   -- Gets a tunnel reference.
 *
 * The following APIs are supported for tunnel information retrieval.
 *
 * - taf_net_GetTunnelEntryList()       -- Gets the reference of the tunnel entry list.
 * - taf_net_GetFirstTunnelEntry()      -- Gets the reference of the first tunnel entry.
 * - taf_net_GetNextTunnelEntry()       -- Gets the reference of the next tunnel entry.
 * - taf_net_DeleteTunnelEntryList()    -- Deletes the reference of the tunnel entry list.
 * - taf_net_GetTunnelEncapProto()      -- Gets the encapsulation protocol of a tunnel.
 * - taf_net_GetTunnelLocalId()         -- Gets the local ID of a tunnel.
 * - taf_net_GetTunnelPeerId()          -- Gets the peer ID of a tunnel.
 * - taf_net_GetTunnelLocalUdpPort()    -- Gets the local UDP port of a tunnel.
 * - taf_net_GetTunnelPeerUdpPort()     -- Gets the peer UDP port of a tunnel.
 * - taf_net_GetTunnelPeerIpv6Addr()    -- Gets the peer IPv6 address of a tunnel.
 * - taf_net_GetTunnelPeerIpv4Addr()    -- Gets the peer IPv4 address of a tunnel.
 * - taf_net_GetTunnelInterfaceName()   -- Gets the interface name of a tunnel.
 * - taf_net_GetTunnelIpType()          -- Gets the IP type of a tunnel.
 * - taf_net_GetSessionConfig()         -- Gets the session configuration of a tunnel.
 *
 * @section c_taf_net_SOCKS_management SOCKS management
 *
 * Socket Secure (SOCKS) management provides APIs for enabling and disabling SOCKS, setting and getting SOCKS
 * authentication method type, setting and getting LAN interface, and adding and removing SOCKS
 * associations between usernames and profile IDs.
 *
 * SOCKS can be enabled using taf_net_EnableSocks. After setting the authentication method type 
 * and LAN interface, and adding the association the application can enable SOCKS.
 *
 * The following example shows how to enable SOCKS. This example starts a SOCKS application which
 * listens on port 1080.
 *
 * @verbatim
   result = taf_net_EnableSocks();
   if (result != LE_OK)
   {
      LE_INFO("Failed to enable SOCKS");
      return LE_FAULT;
   }
   @endverbatim
 *
 * An application can asynchrounously enable SOCKS using taf_net_EnableSocksAsync with a handler
 * function passed as a parameter.
 *
 * @verbatim
   taf_net_EnableSocksAsync(StartSocksAsyncHandlerFunc,NULL);
   @endverbatim
 *
 * Before asynchrounously enabling SOCKS, an application defines a handler function. Once SOCKS is
 * enabled, the handler function will be called.
 *
 * @verbatim
    static void StartSocksAsyncHandlerFunc
    (
        le_result_t result, void* contextPtr
    )
    {
        LE_INFO("**** Handler for start socks Asynchronously (Begin)****");
        LE_INFO("result: %d", result);
        LE_INFO("**** Handler for start socks Asynchronously (End)****");
    }
   @endverbatim
 *
 * The following APIs are supported for SOCKS management.
 *
 * - taf_net_SetSocksAuthMethod()       -- Sets SOCKS authentication method.
 * - taf_net_GetSocksAuthMethod()       -- Gets SOCKS authentication method.
 * - taf_net_SetSocksLanInterface()     -- Sets SOCKS LAN interface.
 * - taf_net_GetSocksLanInterface()     -- Gets SOCKS LAN interface.
 * - taf_net_AddSocksAssociation()      -- Adds SOCKS association.
 * - taf_net_RemoveSocksAssociation()   -- Deletes SOCKS association.
 * - taf_net_EnableSocks()              -- Synchronously enables SOCKS.
 * - taf_net_DisableSocks()             -- Synchronously disables SOCKS.
 * - taf_net_EnableSocksAsync()         -- Asynchronously enables SOCKS.
 * - taf_net_DisableSocksAsync()        -- Asynchronously disables SOCKS.
 *
 * @note If changing the SOCKS authentication method or association, the application needs to disable and
 *       enable SOCKS to use the new method or username.
 *
 * @section c_taf_net_GSB_management GSB management
 *
 * Generic software bridge (GSB) management provides APIs for enabling and disabling GSB, adding and
 * removing GSB, and querying GSB information. GSB enables hardware IP acceleration (IPA) for 
 * traffic on physical interfaces corresponding to the NON-QTI WLAN and ethernet chips.
 *
 * @note GSB APIs are not supported on SA515M.
 * The following example shows how to add GSB. This example adds an interface named "wlan0", 
 * of TAF_NET_GSB_WLAN_AP type, and with 800 Mbps bandwidth.
 *
 * @verbatim
   result = taf_net_AddGsb("wlan0", TAF_NET_GSB_WLAN_AP, 900);
   if (result != LE_OK)
   {
      LE_INFO("Failed to add GSB");
      return LE_FAULT;
   }
   @endverbatim
 *
 * An application can enable GSB using taf_net_EnableGsb after adding GSB. The following example
 * shows how to enable GSB.
 *
 * @verbatim
   result = taf_net_EnableGsb();
   if (result != LE_OK)
   {
      LE_INFO("Failed to enable GSB");
      return LE_FAULT;
   }
   @endverbatim
 *
 * The following APIs are supported for GSB management.
 *
 * - taf_net_AddGsb()               -- Adds GSB.
 * - taf_net_RemoveGsb()            -- Removes GSB.
 * - taf_net_EnableGsb()            -- Enables GSB.
 * - taf_net_DisableGsb()           -- Disables GSB.
 * - taf_net_GetGsbList()           -- Gets the reference of the GSB list.
 * - taf_net_GetFirstGsb()          -- Gets the reference of the first GSB.
 * - taf_net_GetNextGsb()           -- Gets the reference of the next GSB.
 * - taf_net_DeleteGsbList()        -- Deletes the reference of the GSB list.
 * - taf_net_GetGsbInterfaceName()  -- Gets the interface name of the GSB.
 * - taf_net_GetGsbInterfaceType()  -- Gets the interface type of the GSB.
 * - taf_net_GetGsbBandWidth()      -- Gets the bandwidth of the GSB.
 *
 * @section c_taf_net_support_phone_id phone ID support.
 *
 * Network service provides APIs with phone ID as one of the input parameters in the DSSA/DSDA mode.
 * The application can call these APIs on the wanted phone ID
 *
 * @verbatim
   profileReference = BindVlanWithProfileEx(vlanReference, 2, 5);
   @endverbatim
 *
 * The following APIs are added for supporting phone ID selection.
 *
 * - taf_net_BindVlanWithProfileEx() -- Binds a VLAN with the specified phone ID and profile index.
 * - taf_net_GetVlanBoundPhoneId() -- Gets the phone ID bound with this VLAN.
 *
 * @section c_taf_net_support_vlan_priority VLAN priority.
 *
 * Network service provides APIs to support VLAN priority.
 *
 * The following example shows how to create a VLAN and set the VLAN priority. This example creates
 * a VLAN with VLAN ID 5 and priority 6.
 *
 * @verbatim
   vlanReference = taf_net_CreateVlan(5, false);
   if (!vlanReference)
   {
      LE_INFO("isAccelerated conflicts with old value");
      return LE_FAULT;
   }
   result = taf_net_SetVlanPriority(vlanReference, 6);
   @endverbatim
 *
 * The following APIs are added for supporting VLAN priority.
 *
 * - taf_net_SetVlanPriority() -- Sets VLAN priority.
 * - taf_net_GetVlanPriority() -- Gets VLAN priority.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * The interface name maximum number.
 */
//--------------------------------------------------------------------------------------------------
DEFINE INTERFACE_NAME_MAX_NUM = 36;

//--------------------------------------------------------------------------------------------------
/**
 * The interface name maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE INTERFACE_NAME_MAX_LEN = 30;

//--------------------------------------------------------------------------------------------------
/**
 * The IPv4 address maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IPV4_ADDR_MAX_LEN = 16;

//--------------------------------------------------------------------------------------------------
/**
 * The IPv6 address maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IPV6_ADDR_MAX_LEN = 46;

//--------------------------------------------------------------------------------------------------
/**
 * The IP address maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IP_ADDR_MAX_LEN = IPV6_ADDR_MAX_LEN;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of entries in the NAT memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_NAT_ENTRY = (50);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum entry for VLAN memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_VLAN_ENTRY = (100);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum entry list for VLAN memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_VLAN_ENTRY_LIST = (2);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum interface for VLAN memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_VLAN_INTERFACE = (5);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum tunnel number.
 */
//--------------------------------------------------------------------------------------------------
DEFINE L2TP_MAX_TUNNEL_NUMBER = 2;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum session per tunnel.
 */
//--------------------------------------------------------------------------------------------------
DEFINE L2TP_MAX_SESSION_NUMBER_PER_TUNNEL = 3;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum SOCKS username length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE SOCKSV5_MAX_USERNAME_LEN = 255;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum SOCKS mapping pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE SOCKSV5_MAX_MAPPING_POOL = 2;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum list for GSB memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_GSB_LIST_NUM = (2);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number for GSB memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_GSB_NUM = (10);

//--------------------------------------------------------------------------------------------------
/**
 * IP protocol.
 */
//--------------------------------------------------------------------------------------------------
ENUM IpProto
{
    TCP = 6,                    ///< TCP.
    UDP = 17                    ///< UDP.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network action.
 */
//--------------------------------------------------------------------------------------------------
ENUM NetAction
{
    DELETE,                     ///< Deletion operation.
    ADD                         ///< Addition operation.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network IP type.
 */
//--------------------------------------------------------------------------------------------------
ENUM NetIpType
{
    IPV4,                       ///< IPv4.
    IPV6                        ///< IPv6.
};

//--------------------------------------------------------------------------------------------------
/**
 * The technology.
 */
//--------------------------------------------------------------------------------------------------
ENUM TechType
{
    TECH_CELLULAR,              ///< Cellular.
    TECH_WIFI,                  ///< Wi-Fi.
    TECH_ETHERNET               ///< Ethernet.
};

//--------------------------------------------------------------------------------------------------
/**
 * The state.
 */
//--------------------------------------------------------------------------------------------------
ENUM State
{
    STATE_DOWN,                 ///< Down.
    STATE_UP                    ///< Up.
};

//--------------------------------------------------------------------------------------------------
/**
 * L2TP encapsulation protocols.
 */
//--------------------------------------------------------------------------------------------------
ENUM L2tpEncapProtocol
{
    L2TP_NONE,
    L2TP_IP,                      // IP protocol used for encapsulation.
    L2TP_UDP                      // UDP protocol used for encapsulation.
};

//--------------------------------------------------------------------------------------------------
/**
 * Preferred IP family for the connection.
 */
//--------------------------------------------------------------------------------------------------
ENUM IpFamilyType
{
    L2TP_UNKNOWN = -1,
    L2TP_IPV4 = 0x04,             // IPv4 data connection.
    L2TP_IPV6 = 0x06,             // IPv6 data connection.
    L2TP_IPV4V6 = 0x0A,           // IPv4 and IPv6 data connection.
};

//--------------------------------------------------------------------------------------------------
/**
 * The VLAN interface type.
 */
//--------------------------------------------------------------------------------------------------
ENUM VlanIfType
{
    IFACE_UNKNOWN,              ///< Unknown interface.
    WLAN,                       ///< Wireless local area network (WLAN).
    ETH,                        ///< Ethernet (ETH).
    ECM,                        ///< Ethernet control model (ECM).
    RNDIS,                      ///< Remote network driver interface specification (RNDIS).
    MHI                         ///< Modem host interface (MHI).
};

//--------------------------------------------------------------------------------------------------
/**
 * Binding action.
 */
//--------------------------------------------------------------------------------------------------
ENUM BindingAction
{
    BIND,                       ///< Bind.
    UNBIND                      ///< Unbind.
};

//--------------------------------------------------------------------------------------------------
/**
 * The device mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM DeviceMode
{
    DEVICE_UNKNOWN = -1,        ///< Unknown.
    DEVICE_NONE,                ///< None.
    DEVICE_L2L,                 ///< Device LAN-to-LAN mode.
    DEVICE_E2E                  ///< Device end-to-end mode.
};

//--------------------------------------------------------------------------------------------------
/**
 * The SOCKS authentication type.
 */
//--------------------------------------------------------------------------------------------------
ENUM AuthMethod
{
    SOCKS_UNKNOWN = -1,        ///< Unknown.
    SOCKS_NONE,                ///< No authentication.
    SOCKS_USER_PASSWD          ///< Username and password.
};

//--------------------------------------------------------------------------------------------------
/**
 * The GSB interface type.
 */
//--------------------------------------------------------------------------------------------------
ENUM GsbIfType
{
    GSB_UNKNOWN,                      // Unknown.
    GSB_WLAN_AP,                      // WLAN AP.
    GSB_WLAN_STA,                     // WLAN station.
    GSB_ETH                           // Ethernet.
};

//--------------------------------------------------------------------------------------------------
/**
 * The destination NAT change indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DestNatChangeInd
{
    uint32  profileId;                        ///< Profile ID.
    NetAction action;                         ///< Add or delete.
};

//--------------------------------------------------------------------------------------------------
/**
 * The interface information.
 */
//--------------------------------------------------------------------------------------------------
STRUCT InterfaceInfo
{
    string       interfaceName[INTERFACE_NAME_MAX_LEN];   ///< The interface name.
    TechType     tech;                                    ///< The technology.
    State        state;                                   ///< The state.
};

//--------------------------------------------------------------------------------------------------
/**
 * The DNS server addresses.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DnsServerAddresses
{
    string   ipv4Addr1[IPV4_ADDR_MAX_LEN];    ///< The first IPv4 DNS address.
    string   ipv4Addr2[IPV4_ADDR_MAX_LEN];    ///< The second IPv4 DNS address.
    string   ipv6Addr1[IPV6_ADDR_MAX_LEN];    ///< The first IPv6 DNS address.
    string   ipv6Addr2[IPV6_ADDR_MAX_LEN];    ///< The second IPv6 DNS address.
};

//--------------------------------------------------------------------------------------------------
/**
 * The route change indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT RouteChangeInd
{
    string interfaceName[INTERFACE_NAME_MAX_LEN];      ///< The interface name.
    string destAddr[IP_ADDR_MAX_LEN];                  ///< Destination IP address.
    string prefixLength[IP_ADDR_MAX_LEN];              ///< Destination's subnet mask or length.
    uint16 metric;                                     ///< Metric.
    NetAction action;                                  ///< Add or delete.
};

//--------------------------------------------------------------------------------------------------
/**
 * The gateway change indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT GatewayChangeInd
{
    string interfaceName[INTERFACE_NAME_MAX_LEN];      ///< The interface name.
    string gatewayAddr[IP_ADDR_MAX_LEN];               ///< Destination IP address.
    NetIpType ipType;                                  ///< IP type.
};

//--------------------------------------------------------------------------------------------------
/**
 * The DNS change indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DNSChangeInd
{
    string ipAddr1[IP_ADDR_MAX_LEN];          ///< The first DNS address.
    string ipAddr2[IP_ADDR_MAX_LEN];          ///< The second DNS address.
    NetIpType ipType;                         ///< IP type.
};

//--------------------------------------------------------------------------------------------------
/**
 * L2TP tunnel session configuration.
 */
//--------------------------------------------------------------------------------------------------
STRUCT L2tpSessionConfig
{
    uint32 locId;                       ///< Local session ID.
    uint32 peerId;                      ///< Peer session ID.
};

//--------------------------------------------------------------------------------------------------
/**
 * Destination NAT entry list reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE DestNatEntryList;

//--------------------------------------------------------------------------------------------------
/*
 * Destination NAT entry reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE DestNatEntry;

//--------------------------------------------------------------------------------------------------
/**
 * VLAN reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Vlan;

//--------------------------------------------------------------------------------------------------
/**
 * VLAN entry list reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VlanEntryList;

//--------------------------------------------------------------------------------------------------
/**
 * VLAN entry reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VlanEntry;

//--------------------------------------------------------------------------------------------------
/**
 * VLAN interface list reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VlanIfList;

//--------------------------------------------------------------------------------------------------
/**
 * VLAN interface reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VlanIf;

//--------------------------------------------------------------------------------------------------
/**
 * Tunnel entry list reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE TunnelEntryList;

//--------------------------------------------------------------------------------------------------
/**
 * Tunnel entry reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE TunnelEntry;

//--------------------------------------------------------------------------------------------------
/**
 * Tunnel reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Tunnel;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a GSB list.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE GsbList;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a GSB.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Gsb;

//--------------------------------------------------------------------------------------------------
/**
 * Handler for route changes.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RouteChangeHandler
(
    RouteChangeInd routeInd IN                ///< Route indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report route changes.
 */
//--------------------------------------------------------------------------------------------------
EVENT RouteChange
(
    RouteChangeHandler handler                ///< Handler for route changes.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for gateway changes.
 */
//--------------------------------------------------------------------------------------------------
HANDLER GatewayChangeHandler
(
    GatewayChangeInd gatewayInd IN            ///< Gateway indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report gateway changes.
 */
//--------------------------------------------------------------------------------------------------
EVENT GatewayChange
(
    GatewayChangeHandler handler              ///< Handler for gateway changes.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for DNS changes.
 */
//--------------------------------------------------------------------------------------------------
HANDLER DNSChangeHandler
(
    DNSChangeInd DNSInd IN                    ///< DNS indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report DNS changes.
 */
//--------------------------------------------------------------------------------------------------
EVENT DNSChange
(
    DNSChangeHandler handler                  ///< Handler for DNS changes.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for destination NAT changes.
 */
//--------------------------------------------------------------------------------------------------
HANDLER DestNatChangeHandler
(
    DestNatChangeInd destNatInd IN            ///< Destination NAT indication.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Handler for asynchronous starting or stopping tunnel result response.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncTunnelHandler
(
    Tunnel       tunnelRef                    IN,  ///< Tunnel reference.
    le_result_t  result                       IN   ///< The result of starting or stopping tunnel.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Handler for asynchronous enabling or disabling L2TP result response.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncL2tpHandler
(
    le_result_t  result                       IN   ///< The result of enabling or disabling L2TP.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Handler for asynchronous enabling or disabling SOCKS result response.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncSocksHandler
(
    le_result_t  result                       IN   ///< The result of enabling or disabling SOCKS.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report destination NAT change.
 */
//--------------------------------------------------------------------------------------------------
EVENT DestNatChange
(
    DestNatChangeHandler handler              ///< Handler for destination NAT changes.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the interface information list.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceList
(
    InterfaceInfo ifInfoList[INTERFACE_NAME_MAX_NUM]  OUT ///< Interface information list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Adds or removes a route.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ChangeRoute
(
    string interfaceName[INTERFACE_NAME_MAX_LEN]      IN, ///< The interface name.
    string destAddr[IP_ADDR_MAX_LEN]                  IN, ///< Destination IP address.
    string subnetMask[IP_ADDR_MAX_LEN]                IN, ///< Destination's subnet mask or length string.
    uint16 metric                                     IN, ///< Metric.
    NetAction isAdd                                   IN  ///< Add or delete.
);

//--------------------------------------------------------------------------------------------------
/**
 * Backs up the current default gateway of the system into DB, including both IPv4 and IPv6.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- No default gateway.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t BackupDefaultGW
(
);

//--------------------------------------------------------------------------------------------------

/**
 * Restores the default gateway of the system from the last backed up one, including IPv4 and/or IPv6.
 * Only gateways backed up and set by the same client session can be restored.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- No backup.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RestoreDefaultGW
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the default gateway address received from the interface into the system.
 *
 * @return
 *   - LE_OK -- Succeded.
 *   - LE_NOT_FOUND -- No gateway address from the interface.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDefaultGW
(
    string  ifName[INTERFACE_NAME_MAX_LEN]    IN ///< The interface from which to get the default gateway addresses.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the gateway addresses from the specified interface.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- No gateway address from the interface.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceGW
(
    string  ifName[INTERFACE_NAME_MAX_LEN]           IN,  ///< Interaface name to get the gateway.
    string  ipv4Addr[IPV4_ADDR_MAX_LEN]              OUT, ///< IPv4 address.
    string  ipv6Addr[IPV6_ADDR_MAX_LEN]              OUT  ///< IPv6 address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the DNS addresses received from the interface into the system.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- No DNS addresses from the interface.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDNS
(
    string  ifName[INTERFACE_NAME_MAX_LEN]    IN ///< The interface from which to get the DNS addresses.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the DNS addresses from the interface, including IPv4 and IPv6 addresses.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Not found DNS addresses from the interface.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceDNS
(
    string  ifName[INTERFACE_NAME_MAX_LEN]    IN, ///< The interface name from which to get the DNS addresses.
    DnsServerAddresses  dnsServerAddresses    OUT ///< DNS addresses structure.
);

//--------------------------------------------------------------------------------------------------
/**
 * Adds a destination NAT entry on the default PDN.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddDestNatEntryOnDefaultPdn
(
    string privateIpAddr[IP_ADDR_MAX_LEN]     IN, ///< Private IP address.
    uint16 privatePort                        IN, ///< Private port.
    uint16 globalPort                         IN, ///< Global port.
    IpProto ipProto                           IN  ///< IP protocol number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes a destination NAT entry on the default PDN.
 *
 * @return
 *   - LE_OK -- Success
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveDestNatEntryOnDefaultPdn
(
    string privateIpAddr[IP_ADDR_MAX_LEN]     IN, ///< Private IP address.
    uint16 privatePort                        IN, ///< Private port.
    uint16 globalPort                         IN, ///< Global port.
    IpProto ipProto                           IN  ///< IP protocol number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Adds a destination NAT entry to the specified PDN.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddDestNatEntryOnDemandPdn
(
    uint32 profileId                          IN, ///< Profile ID.
    string privateIpAddr[IP_ADDR_MAX_LEN]     IN, ///< Private IP address.
    uint16 privatePort                        IN, ///< Private port.
    uint16 globalPort                         IN, ///< Global port.
    IpProto ipProto                           IN  ///< IP protocol number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes a destination NAT entry from the specified PDN.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveDestNatEntryOnDemandPdn
(
    uint32 profileId                          IN, ///< Profile ID.
    string privateIpAddr[IP_ADDR_MAX_LEN]     IN, ///< Private IP address.
    uint16 privatePort                        IN, ///< Private port.
    uint16 globalPort                         IN, ///< Global port.
    IpProto ipProto                           IN  ///< IP protocol number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference to the destination NAT entry list on the default PDN.
 *
 * @return
 *   - NULL -- If there was some other error.
 *   - Others -- The reference to the destination NAT entry list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION DestNatEntryList GetDestNatEntryListOnDefaultPdn
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference to the destination NAT entry list on the specified PDN.
 *
 * @return
 *   - NULL -- If there was some other error.
 *   - Others -- The reference to the destination NAT entry list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION DestNatEntryList GetDestNatEntryListOnDemandPdn
(
    uint32 profileId                          IN ///< The profile ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference to the first destination NAT entry with a list reference.
 *
 * @return
 *   - NULL -- Error.
 *   - Others -- The reference to the first destination NAT entry.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION DestNatEntry GetFirstDestNatEntry
(
    DestNatEntryList  destNatEntryListRef     IN ///< The reference of a destination entry list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference to the next destination NAT entry with a list reference.
 *
 * @return
 *   - NULL -- Error.
 *   - Others -- The reference of the next destination NAT entry.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION DestNatEntry GetNextDestNatEntry
(
    DestNatEntryList  destNatEntryListRef     IN ///< The reference of a destination entry list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the information of a destination NAT entry with an entry reference.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDestNatEntryDetails
(
    DestNatEntry destNatEntryRef              IN,  ///< Entry reference.
    string privateIpAddr[IP_ADDR_MAX_LEN]     OUT, ///< Private IP address.
    uint16 privatePort                        OUT, ///< Private port.
    uint16 globalPort                         OUT, ///< Global port.
    IpProto ipProto                           OUT  ///< IP protocol number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the reference to the destination NAT entry list.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteDestNatEntryList
(
    DestNatEntryList  destNatEntryListRef     IN ///< The reference of a destination entry list.
);


//--------------------------------------------------------------------------------------------------
/**
 * Creates a VLAN.
 *
 * @note To use VLAN bridge and VLAN binding features, set device mode with value 0 first.
 *
 *
 * @return
 *   - NULL -- Failure.
 *   - Others -- The reference of VLAN.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Vlan CreateVlan
(
    uint16 vlanId                             IN, ///< VLAN identifier, i.e., 1-4094.
    bool isAccelerated                        IN  ///< Is acceleration allowed.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the priority to a VLAN.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN was not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetVlanPriority
(
    Vlan vlanRef                              IN, ///< VLAN reference.
    uint8 priority                            IN  ///< Priority.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes a VLAN. 
 *
 * @note The system is not allowed to remove a VLAN if the VLAN interface list is not empty.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN was not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveVlan
(
    Vlan vlanRef                              IN ///< VLAN reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets VLAN by the VLAN ID.
 *
 * @return
 *   - NULL -- Not found.
 *   - Others -- The VLAN reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Vlan GetVlanById
(
    uint16 vlanId                             IN ///< VLAN ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Adds a VLAN interface into the VLAN interface list.
 *
 * @note Adding the first interface into the VLAN interface list with the same interface type
 *       triggers a system reboot if VLAN acceleration is enabled.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN was not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_DUPLICATE -- ifType already added into the VLAN.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddVlanInterface
(
    Vlan vlanRef                              IN, ///< VLAN reference.
    VlanIfType ifType                         IN  ///< Interface type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes a VLAN interface from the VLAN interface list.
 *
 * @note Removing the last interface from the VLAN interface list with the same interface type
 *       triggers a system reboot if VLAN acceleration is enabled.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN was not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveVlanInterface
(
    Vlan vlanRef                              IN, ///< VLAN reference.
    VlanIfType ifType                         IN  ///< Interface type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN interface list.
 *
 * @return
 *   - NULL -- If the VLAN was not found or the VLAN interface list is empty.
 *   - Others -- The VLAN interface list reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanIfList GetVlanInterfaceList
(
    Vlan vlanRef                              IN ///< VLAN reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the first VLAN interface reference with a list.
 *
 * @return
 *   - NULL -- The interface list doesn't exist.
 *   - Others -- The first VLAN interface reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanIf GetFirstVlanInterface
(
    VlanIfList  vlanIfListRef                 IN ///< Reference of a VLAN interface list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the next VLAN interface reference with a list.
 *
 * @return
 *   - NULL -- The VLAN interface list or the next interface doesn't exist.
 *   - Others -- The next VLAN interface reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanIf GetNextVlanInterface
(
    VlanIfList  vlanIfListRef                 IN ///< Reference of a VLAN interface list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the VLAN interface list.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN interface list was not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteVlanInterfaceList
(
    VlanIfList  vlanIfListRef                 IN ///< Reference of a VLAN interface list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the interface type of a VLAN interface.
 *
 * @return
 *   - taf_net_VlanIfType_t -- VLAN interface type.
 *   - TAF_NET_IFACE_UNKNOWN -- VLAN interface was not found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanIfType GetVlanInterfaceType
(
    VlanIf vlanIfRef                          IN ///< VLAN interface reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN priority of a VLAN interface.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN was not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVlanPriority
(
    VlanIf vlanIfRef                          IN, ///< VLAN interface reference.
    uint8 priority                            OUT ///< Priority.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN entry list.
 *
 * @return
 *   - NULL -- The VLAN entry list is empty.
 *   - Others -- The VLAN entry list reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanEntryList GetVlanEntryList
(

);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference of the first VLAN entry with a list.
 *
 * @return
 *   - NULL -- The VLAN entry list doesn't exist.
 *   - Others -- The first VLAN entry reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanEntry GetFirstVlanEntry
(
    VlanEntryList  vlanEntryListRef           IN ///< Reference of a VLAN entry list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference of the next VLAN entry with a list.
 *
 * @return
 *   - NULL -- The VLAN entry list or the next VLAN doesn't exist.
 *   - Others -- The reference of the next VLAN entry.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanEntry GetNextVlanEntry
(
    VlanEntryList  vlanEntryListRef           IN ///< Reference of a VLAN entry list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the VLAN entry list.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Failed to delete the reference.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteVlanEntryList
(
    VlanEntryList  vlanEntryListRef           IN ///< Reference of a VLAN entry list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN ID by the VLAN entry reference.
 *
 * @return
 *   - 1-4094 -- Succeeded.
 *   - others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION int16 GetVlanId
(
    VlanEntry vlanEntryRef                    IN ///< VLAN entry reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Determines if the VLAN is accelerated or not by the VLAN entry reference.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN was not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t IsVlanAccelerated
(
    VlanEntry vlanEntryRef                    IN, ///< VLAN entry reference.
    bool isAccelerated                        OUT  ///< Is accelerated or not.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the profile ID bound with a VLAN by the VLAN entry reference.
 *
 * @return
 *   - Others -- Succeeded.
 *   - -1 -- No binding.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION int32 GetVlanBoundProfileId
(
    VlanEntry vlanEntryRef                    IN ///< VLAN entry reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the phone ID bound with a VLAN by the VLAN entry reference.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN was not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVlanBoundPhoneId
(
    VlanEntry vlanEntryRef                    IN,  ///< VLAN entry reference.
    uint8 phoneId                             OUT  ///< Phone ID for VLAN association.
);

//--------------------------------------------------------------------------------------------------
/**
 * Binds a VLAN with a specified profile ID.
 * 
 * @note Binding VLAN with the default profile ID results in the system automatically rebooting
 *       after 5 seconds.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN wass not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t BindVlanWithProfile
(
    Vlan vlanRef                              IN, ///< VLAN reference.
    uint32 profileId                          IN  ///< Profile ID for VLAN association.
);

//--------------------------------------------------------------------------------------------------
/**
 * Binds a VLAN with a specified phone ID and profile index.
 *
 * @note Binding a VLAN with the default profile ID results in the system automatically rebooting
 *       after 5 seconds.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN wass not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t BindVlanWithProfileEx
(
    Vlan vlanRef                              IN, ///< VLAN reference.
    uint8 phoneId                             IN, ///< Phone for VLAN association.
    uint32 profileId                          IN  ///< Profile ID for VLAN association.
);

//--------------------------------------------------------------------------------------------------
/**
 * Unbinds a VLAN from previous profile ID.
 *
 * @note Unbinding VLAN from the default profile ID results in the system automatically rebooting
 *       after 5 seconds.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- VLAN wass not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UnbindVlanFromProfile
(
    Vlan vlanRef                              IN ///< VLAN reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Enables (synchronously) L2TP for unmanaged tunnel state.
 *
 * @note To use the L2TP feature set device mode with value 1 first.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t EnableL2tp
(
    bool enableMss                       IN,///< Enable TCP MSS to be clamped on L2TP interfaces.
    bool enableMtu                       IN,///< Enable MTU size to be set on underlying interfaces.
    uint32 mtuSize                       IN ///< Optional MTU size in bytes; default is 1422.
);

//--------------------------------------------------------------------------------------------------
/**
 * Enables (asynchronously) L2TP for unmanaged tunnel state.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION EnableL2tpAsync
(
    bool enableMss                       IN,///< Enable TCP MSS to be clamped on L2TP interfaces.
    bool enableMtu                       IN,///< Enable MTU size to be set on underlying interfaces.
    uint32 mtuSize                       IN, ///< optional MTU size in bytes; default is 1422.
    AsyncL2tpHandler handler             IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Disables (synchronously) L2TP for unmanaged tunnel state.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DisableL2tp
(
);

/**
 * Disables (asynchronously) L2TP for unmanaged tunnel state.
 *
 * @return None.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION DisableL2tpAsync
(
    AsyncL2tpHandler handler                IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Determines if L2TP is enabled.
 *
 * @return
 *   - false -- L2TP is disabled.
 *   - true -- L2TP is enabled.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsL2tpEnabled
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Determines if maximum segment size (MSS) is enabled.
 *
 * @return
 *   - false -- MSS is disabled for L2TP.
 *   - true -- MSS is enabled for L2TP.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsL2tpMssEnabled
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Determines if maximum transmission unit (MTU) is enabled.
 *
 * @return
 *   - false -- MTU is disabled for L2TP.
 *   - true -- MTU is enabled for L2TP.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsL2tpMtuEnabled
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets L2TP MTU size.
 *
 * @return
 *   - 0 -- Failed.
 *   - Others -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION uint32 GetL2tpMtuSize
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Creates an L2TP tunnel.
 *
 * @return
 *   - NULL -- Failed.
 *   - Others -- The tunnel reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Tunnel CreateTunnel
(
    L2tpEncapProtocol encaProto               IN, ///< Encapsulation protocol, UDP or IP.
    uint32 locId                              IN, ///< Local tunnel ID.
    uint32 peerId                             IN, ///< Peer tunnel ID.
    string peerIpAddr[IPV6_ADDR_MAX_LEN]      IN, ///< Peer IP address.
    string ifName[INTERFACE_NAME_MAX_LEN]     IN  ///< Interface name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes an L2TP tunnel.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveTunnel
(
    Tunnel tunnelRef                          IN ///< Tunnel reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets UDP ports for a tunnel.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetTunnelUdpPort
(
    Tunnel tunnelRef                          IN, ///< Tunnel reference.
    uint32 localUdpPort                       IN, ///< Local UDP port, if UDP encapsulation is used.
    uint32 peerUdpPort                        IN  ///< Peer UDP port, if IP encapsulation is used.
);

//--------------------------------------------------------------------------------------------------
/**
 * Adds a session into a tunnel.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddSession
(
    Tunnel tunnelRef                          IN, ///< Tunnel reference.
    uint32 locId                              IN, ///< Local session ID.
    uint32 peerId                             IN  ///< Peer session ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes a session from a tunnel.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveSession
(
    Tunnel tunnelRef                          IN, ///< Tunnel reference.
    uint32 locId                              IN, ///< Local session ID.
    uint32 peerId                             IN  ///< Peer session ID.
);

/**
 * Starts (synchronously) a tunnel.
 *
 * @return
 *   - LE_OK -- Succeeded.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
