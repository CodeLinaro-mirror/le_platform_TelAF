#!/usr/bin/env sh

# Copyright (c) 2023 Qualcomm Innovation Center, Inc. All rights reserved.
# SPDX-License-Identifier: BSD-3-Clause-Clear

# system/bin and /sbin should be in the path.
# Search for the installed TelAF system bin first.
export PATH=/legato/systems/current/bin:/mnt/legato/system/bin:/sbin:$PATH

TELAF_INSTALLED_VERSION=/legato/systems/current/version

xPS=
if ls -l $(which ps) | grep busybox > /dev/null
then
    if [ -n "${TELAF_IN_CONTAINER}" ]; then
        # For LXC container
        xPS="ps -w"
    else
        # For PVM
        xPS="ps -e"
    fi
else
    # For Docker container
    xPS="ps -aux"
fi

TelafPrintUsage()
{
    echo "NAME"
    echo "  TelAF -> TelAF tool to be used to control the TelAF Application Framework."
    echo "OVERVIEW"
    echo "  telaf [start|stop|restart|status|version|storage|security|help]"
    echo "HELP MENU"
    echo "  telaf start"
    echo "    :Starts the TelAF Application Framework."
    echo "  telaf stop"
    echo "    :Stops the TelAF Application Framework."
    echo "  telaf restart"
    echo "    :Restarts the TelAF Application Framework."
    echo "  telaf status"
    echo "    :Displays the current running state."
    echo "  telaf version"
    echo "    :Displays the currently installed TelAF version."
    echo "  telaf help"
    echo "    :Displays TelAF usage help."
    echo "  telaf storage"
    echo "    :Shows type and the disk/flash usage of telaf."
    echo "  telaf memory"
    echo "    :Shows the memory usage of the telaf."
    echo "  telaf security"
    echo "    :Shows the list of telaf selinux modules."
}

IsSystemInstalled()
{
    if [ -e "${TELAF_INSTALLED_VERSION}" ]
    then
        return 0
    else
        return 1
    fi
}

IsFrameworkRunning()
{
    ${xPS} | grep $(cat ${TELAF_INSTALLED_VERSION} | sed 's/_modified$//') | grep -v grep > /dev/null
}

TelafStatus()
{
    if ! IsSystemInstalled
    then
        echo "TelAF systems are not installed"
        exit 1
    fi

    echo "TelAF Systems were installed"
    echo -n "TelAF framework is "
    if IsFrameworkRunning
    then
        echo "running"
        exit 0
    else
        echo "not running"
        exit 1
    fi
}
StartTelafService()
{
    if ! IsSystemInstalled
    then
        echo "TelAF systems are not installed"
        return 1
    fi

    # If TelAF is already running.
    if IsFrameworkRunning
    then
        echo "The TelAF Supervisor is already running"
        return 0
    fi

    echo "Starting TelAF service..."

    if [ -n "${TELAF_IN_CONTAINER}" ]; then
        # In LXC & Docker containers, don't use systemd
        /mnt/legato/start
    else
        systemctl start telaf
    fi
    if [ $? -ne 0 ] ; then
        echo "Start TelAF service failed"
        return 1
    fi

    echo "TelAF service is started"
    return 0
}

StartTelafAppGroup()
{
    if [ -n "${TELAF_IN_CONTAINER}" ]; then
        # In LXC & Docker containers, don't use systemd
        /legato/systems/current/bin/app startGroup
    else
        systemctl start telaf.app
    fi
    if [ $? -ne 0 ] ; then
        echo "Start TelAF App group failed"
        return 1
    fi

    echo "Start TelAF APP group successful"
    return 0
}

StopTelafAppGroup()
{

    systemctl stop telaf.app
    if [ $? -ne 0 ] ; then
        echo "Start TelAF App group failed"
        return 1
    fi

    echo "Start TelAF APP group successful"
    return 0
}

StartTelaf()
{
    StartTelafService
    if [ $? -ne 0 ] ; then
        exit 1
    fi

    StartTelafAppGroup
    if [ $? -ne 0 ] ; then
        exit 1
    fi

    echo "TelAF is started"
}

StopTelaf()
{
    if ! IsSystemInstalled
    then
        echo "TelAF systems are not installed"
        exit 1
    fi

    # Stop telaf App group first
    StopTelafAppGroup

    if IsFrameworkRunning
    then
        # StopTelafTimeout will be scaled according to the number of running TelAF services.
        # Estimation of 5 seconds for the TelAF framework itself, and 3 seconds per TelAF service to
        # shutdown.
        StopTelafTimeout=$(( 5 + $(app status | grep running | wc -l) * 3 ))

        echo -n "Stopping TelAF "

        # Direct the Supervisor to shutdown TelAF.
        app "stopLegato" 2> /dev/null &

        # wait for TelAF supervisor to shutdown
        telafcountDown=$StopTelafTimeout
        while [ $telafcountDown -ne 0 ]
        do
            if IsFrameworkRunning
            then
                echo -n "."
                sleep 1
            else
                break
            fi
            telafcountDown=`expr $telafcountDown - 1`
        done
        echo

        # If TelAF is still running
        if IsFrameworkRunning
        then
            echo "TelAF may still be alive after an attempt of hard-kill, rebooting the system"
            reboot
        fi
    else
        echo "TelAF wasn't running"
        return
    fi

    SupervisorPID=$(${xPS} | grep /legato/systems/current/bin/supervisor \
                           | grep `cat ${TELAF_INSTALLED_VERSION} | sed 's/_modified$//'` \
                           | grep -v grep | awk '{print $1}')

    for SdirPID in `pidof serviceDirectory`
    do
        FatherPID=$(awk '{print $4}' /proc/${SdirPID}/stat)
        if [ "$FatherPID" == "$SupervisorPID" ]
        then
            echo "serviceDirectory may still be alive, hard-kill it"
            kill -9 $SdirPID
        fi
    done

    echo "TelAF is stopped"
}

RestartTelaf()
{
    if ! IsSystemInstalled
    then
        echo "TelAF systems are not installed"
        exit 1
    fi

    if IsFrameworkRunning
    then
        echo "Restarting TelAF ..."

        # Direct the Supervisor to restart TelAF.
        app "restartLegato" 2> /dev/null

    else
        StopTelaf
        StartTelaf
    fi
}

TelafStorage()
{
    echo "TelAF type :"
    mount | grep telaf | grep squashfs
    echo
    echo "Disk/Flash usage of TelAF:"
    df app
}

TelafMemory()
{
    echo "TelAF memory -> to be implemented"
}

TelafSecurity()
{
    echo "TelAF SELinux modules list :"
    semodule -l | grep taf | grep -v staff
}

TelafVersion()
{
    if [ -f $TELAF_INSTALLED_VERSION ]
    then
        cat $TELAF_INSTALLED_VERSION
    else
        echo "Unknown VERSION"
        exit 1
    fi
}

TELAF_ACTION=$1

case "$TELAF_ACTION" in
    start)
        StartTelaf
        ;;

    stop)
        StopTelaf
        ;;

    restart)
        RestartTelaf
        ;;

    status)
        TelafStatus
        ;;

    storage)
        TelafStorage
        ;;

    memory)
        TelafMemory
        ;;

    security)
        TelafSecurity
        ;;

    help|--help|-h)
        TelafPrintUsage
        ;;

    version|--version|-v)
        TelafVersion
        ;;

    *)
        TelafPrintUsage
        exit 1
        ;;
esac

exit 0
