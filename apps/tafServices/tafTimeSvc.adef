maxThreads: 600

username: telaf

capability:
{
        CAP_WAKE_ALARM
        CAP_BLOCK_SUSPEND
        CAP_SYS_TIME
        CAP_DAC_OVERRIDE
        CAP_SYS_ADMIN
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

executables:
{
        tafTimeSvc = ( $TELAF_ROOT/components/tafTimeSvc )
}

start: auto

processes:
{
        run:
        {
            (tafTimeSvc)
        }

        maxFileBytes: 8192K
        faultAction: restart
}

sandboxed: false

bindings:
{
    tafTimeSvc.tafTimeSvc.taf_pm -> tafPMSvc.taf_pm
    tafTimeSvc.tafTimeSvc.le_appInfo -> <root>.le_appInfo
    tafTimeSvc.tafTimeSvc.taf_mngdStorSec ->  tafMngdStorageSvc.taf_mngdStorSec
}

extern:
{
        tafTimeSvc.tafTimeSvc.taf_time
}
