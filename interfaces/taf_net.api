 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteVlanEntryList
(
    VlanEntryList  vlanEntryListRef           IN ///< Reference of a VLAN entry list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN Id by the VLAN entry reference.
 *
 * @return
 *   - 1-4094 -- Success.
 *   - others -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION int16 GetVlanId
(
    VlanEntry vlanEntryRef                    IN ///< VLAN entry reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Is VLAN accelerated or not by a VLAN entry reference.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- VLAN is not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 */
//--------------------------------------------------------------------------------------------------
