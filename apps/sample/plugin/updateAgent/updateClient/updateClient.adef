username: telaf
start: manual

sandboxed: false

executables:
{
    updateClient = (clientComp)
    updateCtrl = (ctrlComp)
}

processes:
{
    run:
    {
        (updateClient)
    }
}

bundles:
{
    file:
    {
        [r] config/default.conf    /
    }
}

bindings:
{
    updateCtrl.ctrlComp.ctrlUpdate -> updateClient.clientComp.ctrlUpdate
    updateClient.clientComp.taf_update -> tafUpdateSvc.taf_update
}
