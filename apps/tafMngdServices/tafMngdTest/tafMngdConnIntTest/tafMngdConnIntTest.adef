username: telaf
maxThreads: 600
sandboxed: false

executables:
{
  tafMngdConnIntTest =
   (tafMngdConnIntTestComponent)
}

start: manual

processes:
{
    run:
    {
        (tafMngdConnIntTest)
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
  tafMngdConnIntTest.tafMngdConnIntTestComponent.taf_mngdConn -> tafMngdConnSvc.taf_mngdConn
}