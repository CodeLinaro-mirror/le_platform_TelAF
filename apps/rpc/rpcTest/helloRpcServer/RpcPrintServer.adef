username: telaf
maxThreads: 600
sandboxed: false
start: manual
executables:
{
    exe_RpcPrintServer = (printServer)
}

processes:
{
    run:
    {
        RpcPrintServer = (exe_RpcPrintServer)
    }
}

extern:
{
    tafRpcPrinter = exe_RpcPrintServer.printServer.tafRpcPrinter
}

bindings:
{
    exe_RpcPrintServer.printServer.taf_someipClnt -> tafSomeipGWSvc.taf_someipClnt
}
