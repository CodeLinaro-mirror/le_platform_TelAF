sandboxed: false

executables:
{
    tafMngdConnUnitTest = (
     $TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdConnUnitTest/tafMngdConnUnitTestComponent )
}

start: manual

processes:
{
    run:
    {
        (tafMngdConnUnitTest)
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafMngdConnUnitTest.tafMngdConnUnitTestComponent.taf_mngd_Conn -> tafMngdConnSvc.taf_mngd_Conn
}
