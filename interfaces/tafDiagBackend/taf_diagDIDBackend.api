//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the ReadDID payload in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE READ_DID_PAYLOAD_SIZE = 4094;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the ReadDID request data identifier in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE READ_DID_SIZE = 2046;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the WriteDID request data record in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE WRITE_DID_DATA_RECORD_SIZE = 4092;

//-------------------------------------------------------------------------------------------------
/**
 * Error code for ReadDID.
 */
//-------------------------------------------------------------------------------------------------
ENUM ReadDIDErrorCode
{
    READ_DID_NO_ERROR = 0,
    READ_DID_RESPONSE_TOO_LONG = 0x14,
    READ_DID_CONDITIONS_NOT_CORRECT = 0x22,
    READ_DID_REQUEST_OUT_OF_RANGE = 0x31
};

//-------------------------------------------------------------------------------------------------
/**
 * Error code for WriteDID.
 */
//-------------------------------------------------------------------------------------------------
ENUM WriteDIDErrorCode
{
    WRITE_DID_NO_ERROR = 0,
    WRITE_DID_CONDITIONS_NOT_CORRECT = 0x22,
    WRITE_DID_REQUEST_OUT_OF_RANGE = 0x31,
    WRITE_DID_GENERAL_PROGRAMMING_FAILURE = 0x72
};

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the ReadDID request message.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE ReadDID;

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the WriteDID request message.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE WriteDID;

//-------------------------------------------------------------------------------------------------
/**
 * Handler for a received ReadDID message.
 */
//-------------------------------------------------------------------------------------------------
HANDLER ReadDIDHandler
(
    ReadDID readDIDRef  IN,               ///< ReadDID message reference.
    uint16 dataId  IN                     ///< Data identifier.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information about the received ReadDID message.
*/
//-------------------------------------------------------------------------------------------------
EVENT ReadDID
(
    ReadDIDHandler handler    ///< ReadDID message handler.
);

//-------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the received ReadDID message.
 *
 * @note This function must be called to send a response if receiving a message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 * @note The process exits if an invalid reference is passed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendReadDIDResp
(
    ReadDID readDIDRef  IN,                  ///< ReadDID message reference.
    ReadDIDErrorCode errCode  IN,            ///< Error code type.
    uint8 data[READ_DID_PAYLOAD_SIZE]  IN    ///< Data payload.
);

//-------------------------------------------------------------------------------------------------
/**
 * Handler for a WriteDID message.
 */
//-------------------------------------------------------------------------------------------------
HANDLER WriteDIDHandler
(
    WriteDID rxMsgRef  IN,                         ///< Received message reference.
    uint16 dataId  IN,                             ///< Data identifier.
    uint8 dataRecord[WRITE_DID_DATA_RECORD_SIZE]   ///< Data record.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information about the received ReadDID message.
 */
//-------------------------------------------------------------------------------------------------
EVENT WriteDID
(
    WriteDIDHandler handler    ///< Received message handler.
);

//-------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the WriteDID message.
 *
 * @note This function must be called to send a response if receiving a message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 * @note The process exits if an invalid reference is passed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendWriteDIDResp
(
    WriteDID rxMsgRef  IN,            ///< Received message reference.
    WriteDIDErrorCode errCode  IN,    ///< Error code type.
    uint16 dataId  IN                 ///< data identifier.
);