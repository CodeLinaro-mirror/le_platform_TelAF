/**
 * @page c_taflocGnss Location Service
 *
 * @rst :ref:`API reference <File taf_locGnss_interface.h>` @endrst
 *
 * <HR>
 *
 * This service provides API to acquire location data and control location service configurations.
 *
 * GNSS is a satellite navigation system with global coverage.
 *
 * This API provides function to configure the Location service and retrieve position information.
 *
 * @section taf_locGnss_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafLocationSvc application service.
 *
 * The following example illustrates how to bind to the Location service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_locGnss -> tafLocationSvc.taf_locGnss
   }
   @endverbatim
 *
 * The location service provides multi-client safe APIs. An API call from a client thread
 * (main or sub thread) will be treated a new session in location service. The client needs
 * to connect the location service by API taf_locGnss_ConnectService(), setting specific settings
 * if required (else default settings will be applied), starting the engine report by the API
 * taf_locGnss_Start(), and adding handler by taf_locGnss_AddPositionHandler(). Then client can get the
 * GNSS data/information and the engine reports in the same thread until the client disconnects
 * from the location service. The previous settings and data shall not persist for next
 * run/iteration if the client thread exits. Note that each time a client creates a new thread, it
 * needs to connect, call, and set APIs, taf_locGnss_Start(), taf_locGnss_AddPositionHandler() for the
 * new session to set up.
 *
 * @section taf_locGnss_ControlApi GNSS Control APIs
 *
 * @subsection taf_locGnss_EnableDisable Enable or Disable Location service
 *
 * The taf_locGnss_Enable API initializes the Location Service and prepares the TelAF
 * location service to serve further requests after setting up internal states.
 *
 * Through the taf_locGnss_Disable API, the Location Service is de-initialized and location
 * service disallows any further requests until it is enabled again via taf_locGnss_Enable.
 *
 * By default, when the service starts up, the Location Service is initialized
 * and is ready to serve incoming requests.
 * @verbatim
   if(taf_locGnss_Enable() == LE_OK)
   {
     // Process after successfully initializing the location service.
   }
   @endverbatim
 * @verbatim
   if(taf_locGnss_Disable() == LE_OK)
   {
     // Process after successfully de-initializing the location service.
   }
   @endverbatim
 *
 * @subsection taf_locGnss_StartStop  Start or Stop Location service
 *
 * taf_locGnss_Start and taf_locGnss_Stop can be used to control the location service.
 * @verbatim
   if(taf_locGnss_Start() == LE_OK)
   {
     // Process after successfully starting the Location session
   }
   @endverbatim
 * @verbatim
   if(taf_locGnss_Stop() == LE_OK)
   {
     // Process after successfully stopping the Location session
   }
   @endverbatim
 *
 * The handler can be managed using taf_locGnss_AddPositionHandler()
 * and taf_locGnss_RemovePositionHandler().
 * When a position is computed, the handler is called.
 *
 * @verbatim
   static void PositionHandlerFunction
   (
      taf_locGnss_SampleRef_t positionSampleRef,
      void* contextPtr
   )
   {
      int32_t latitude, longitude, horizontalAccuracy;
      LE_ASSERT_OK(taf_locGnss_GetLocation(positionSampleRef, &latitude,
                                             &longitude, &horizontalAccuracy));
      taf_locGnss_ReleaseSampleRef(positionSampleRef);
   }
   static taf_locGnss_PositionHandlerRef_t positionHandlerRef = NULL;
   positionHandlerRef = taf_locGnss_AddPositionHandler(PositionHandlerFunction, NULL);
   LE_ASSERT(NULL != positionHandlerRef);
   taf_locGnss_RemovePositionHandler(positionHandlerRef);
   @endverbatim
 *
 * The application has to release each position sample object received by the handler,
 * using the taf_locGnss_ReleaseSampleRef() triggered inside the PositionHandlerFunction() function.
 * @verbatim
   taf_locGnss_ReleaseSampleRef(positionSampleRef);
   @endverbatim
 *
 * @subsubsection taf_locGnss_startMode Start location data session in the specified starting mode
 *
 * In HOT mode, no data is cleared and the location session is started with its available data.
 * In WARM mode, location session is started after the ephemeris is cleared.
 * In COLD and FACTORY mode, location session is started after all data is cleared except almanac.
 *
 * @subsubsection taf_locGnss_ForceHotRestart Restart location session
 *
 * The taf_locGnss_ForceHotRestart() function performs a "HOT" restart of the location session.
 * The current GNSS session is restarted.
 * @verbatim
   if(taf_locGnss_ForceHotRestart() == LE_OK)
   {
     // Process after successfully restarting the location session.
   }
   @endverbatim
 *
 * @subsubsection taf_locGnss_ForceWarmRestart Restart location session in WARM mode
 *
 * The taf_locGnss_ForceWarmRestart() function performs a "WARM" restart of the location session.
 * @verbatim
   if(taf_locGnss_ForceWarmRestart() == LE_OK)
   {
     // Process after successfully restarting location session in "WARM" mode.
   }
   @endverbatim
 *
 * @subsubsection taf_locGnss_ForceColdRestart Restart the Location service in COLD mode
 *
 * The taf_locGnss_ForceColdRestart() function performs a "COLD" restart of the Location session.
 * The current GNSS session is stopped and then started with GNSS data is cleared.
 * @verbatim
   if(taf_locGnss_ForceColdRestart() == LE_OK)
   {
     // Process after successfully deleting the aiding data and restarting the location session.
   }
   @endverbatim
 *
 * The taf_locGnss_DeleteDRSensorCalData() function deletes Dead Reckoning sensor calibration data.
 * @verbatim
   if(taf_locGnss_DeleteDRSensorCalData() == LE_OK)
   {
     // Process after successfully deleting the Dead Reckoning sensor aiding data.
   }
   @endverbatim
 *
 * @subsubsection taf_locGnss_TTFF Obtain Time To First Fix (TTFF)
 *
 * The taf_locGnss_GetTtff() function provides the TTFF
 * @verbatim
   uint32_t ttff = 0;
   if(taf_locGnss_GetTtff(&ttff) == LE_OK)
   {
     // Process after successfully getting the time of computing the first GNSS fix
   }
   @endverbatim
 *
 * The GNSS fix position is calculated by the GNSS engine. Its state can be retrieved with the
 * taf_locGnss_GetPositionState() function. The GNSS fix position states are given by the taf_locGnss_FixState_t
 * enum. The API is triggered inside the PositionHandlerFunction() function to get fix state
 * from the position sample reference.
 * @verbatim
   taf_locGnss_FixState_t fixState;
   if(taf_locGnss_GetPositionState(positionSampleRef,&fixState)== LE_OK)
   {
     // Process after successfully getting the position state.
   }
   @endverbatim
 *
 * @subsection taf_locGnss_AcquisitionRate Set/Get location acquisition rate
 *
 * The acquisition rate defines the time interval that must elapse between
 * two location reports.
 * The default aquisition rate is 1 sec.
 * The application can configure or retreive the Location service acquisition rate with the
 * taf_locGnss_SetAcquisitionRate() or taf_locGnss_GetAcquisitionRate() functions.
 * @verbatim
   if(taf_locGnss_SetAcquisitionRate(3000)== LE_OK)
   {
     // Process after successfully setting the acquisition rate to 3 seconds.
   }
   @endverbatim
 * @verbatim
   uint32_t acqRate = 0;
   if(taf_locGnss_GetAcquisitionRate(&acqRate)== LE_OK)
   {
     // Process after successfully getting the acquisition rate
   }
   @endverbatim
 *
 * @subsection taf_locGnss_SetGetConstellation Control GNSS constellation blacklisting
 *
 * The taf_locGnss_SetConstellation() function blacklists some constellations from
 * being used by the GNSS standard position engine (SPE).
 * @verbatim
   taf_locGnss_ConstellationBitMask_t constellationMask;
   constellationMask = TAF_LOCGNSS_CONSTELLATION_GPS;
   if(taf_locGnss_SetConstellation(constellationMask)== LE_FAULT)
   {
     // Process after successfully blacklisting GPS constellation.
   }

   constellationMask = TAF_LOCGNSS_CONSTELLATION_SBAS | taf_locGnss_CONSTELLATION_BEIDOU;
   if(taf_locGnss_SetConstellation(constellationMask)== LE_OK)
   {
     // Process after successfully blacklisting SBAS and BEIDOU.
   }

   constellationMask = TAF_LOCGNSS_CONSTELLATION_DEFAULT;
   if(taf_locGnss_SetConstellation(constellationMask)== LE_OK)
   {
     // Process after successfully configuring constellations to device default.
   }
   @endverbatim
 *
 *
 * @b WARNING: Some constellation types are unsupported depending on the platform.
 *
 * The taf_locGnss_GetConstellation() function gets the blacklisted GNSS constellation(s).
 * @verbatim
   taf_locGnss_ConstellationBitMask_t constellationMask;
   if(taf_locGnss_GetConstellation(&constellationMask)== LE_OK)
   {
     // Process after successfully getting the blacklisted constellation type.
   }
   @endverbatim
 *
 * The taf_locGnss_GetSupportedConstellations() function gets a bitmask of the constellations
 * supported on the platform.
 * @verbatim
   taf_locGnss_ConstellationBitMask_t supportedConstellations;
   if(taf_locGnss_GetSupportedConstellations(&supportedConstellations)== LE_OK)
   {
     // Process after successfully getting the list of supported constellations.
   }
   @endverbatim
 *
 * @subsection taf_locGnss_SetGetMinElevation GNSS minimum elevation selection
 *
 * The taf_locGnss_SetMinElevation() function sets the GNSS minimum elevation.
 * Satellites with elevation lower than the minimum elevation will will not be used in computation of position.
 * @verbatim
   uint8_t  minElevation;
   minElevation = 40;
   if(taf_locGnss_SetMinElevation(minElevation)== LE_OK)
   {
     // Process after successfully setting the minimum elevation.
   }
   @endverbatim
 *
 * The taf_locGnss_GetMinElevation() function gets the GNSS minimum elevation.
 * @verbatim
   uint8_t  minElevation;
   if(taf_locGnss_GetMinElevation(&minElevation)== LE_OK)
   {
     // Process after successfully getting the minimum elevation.
   }
   @endverbatim
 *
 * @subsection taf_locGnss_NmeaSentences APIs to control NMEA sentences
 * A handler function should be registered for NMEA sentences notifications.
 * @ref taf_locGnss_AddNmeaHandler() allows users to register a NMEA handler.
 *
 * The handler function is invoked whenever new NMEA sentences are available.
 *
 * The handler must follow the below prototype:
 *
 * @verbatim
   static void NmeaHandlerFunction
   (
       uint64_t timestamp,
       char nmeaInfo[TAF_LOCGNSS_NMEA_STRING_MAX],
       void* contextPtr
   )
   {
      // Process the NMEA sentence type received in the handler function.
   }
   @endverbatim
 *
 * @b NOTE: If many applications register handlers for NMEA notifications, they
 *          will all receive it.
 *
 * An application may unregister a NMEA handler by calling @ref taf_locGnss_RemoveNmeaHandler().
 *
 * The National Marine Electronics Association (NMEA) standard defines an electrical interface
 * and data protocol for communications between marine instrumentation.
 * $GP (Global Positioning System),
 * $GL (GLONASS)
 * and $GN (combination of navigation systems).
 * The taf_locGnss_SetNmeaSentences() function selects the enabled NMEA sentences
 * with a bitmask. The supported values are listed in @ref taf_locGnss_NmeaBitMask_t.
 * @verbatim
   taf_locGnss_NmeaBitMask_t nmeaMask;
   nmeaMask = TAF_LOCGNSS_NMEA_MASK_GPGGA;
   if(taf_locGnss_SetNmeaSentences(nmeaMask)== LE_OK)
   {
     // Process after successfully setting a NMEA sentence type.
   }
   @endverbatim
 *
 * @b NOTE: This function may be subject to limitations depending on the platform.
 *
 *
 * @b WARNING: Some NMEA sentences are unsupported depending on the platform.
 *
 * @b NOTE: All supported NMEA sentences are enabled by default.
 *
 * The taf_locGnss_GetNmeaSentences() function gets the bitmask which are configured by the API taf_locGnss_SetNmeaSentences.
 * @verbatim
   taf_locGnss_NmeaBitMask_t nmeaMask;
   if(taf_locGnss_GetNmeaSentences(&nmeaMask)== LE_OK)
   {
     // Process after successfully getting a NMEA sentence type.
   }
   @endverbatim
 *
 * The taf_locGnss_GetSupportedNmeaSentences() function gets a bitmask of the NMEA sentences supported
 * on the platform.
 * @verbatim
   taf_locGnss_NmeaBitMask_t supportedNmeaSentences;
   if(taf_locGnss_GetSupportedNmeaSentences(&supportedNmeaSentences)== LE_OK)
   {
     // Process after successfully getting a list of supported NMEA sentence types.
   }
   @endverbatim
 *
 * @subsection taf_locGnss_GetInfo Get position information
 *
 * The position information is referenced to a position sample object.
 *
 * An application can register a handler to be notified of the
 * updated position at a rate configured using @ref taf_locGnss_AcquisitionRate, returning a position sample object.
 *
 * The GNSS information commonly used, such as
 * state, position, time and date, satellite information and accuracy
 * can be queried using the following functions.
 * - taf_locGnss_GetState()
 * @verbatim
   if(taf_locGnss_GetState()== TAF_LOCGNSS_STATE_READY)
   {
     // Process after successfully getting the status.
   }
   @endverbatim
 *
 * - taf_locGnss_GetPositionState() -- Triggered inside PositionHandlerFunction() function
 *   to get fix state from the position sample reference.
 * @verbatim
   taf_locGnss_FixState_t state;
   if(taf_locGnss_GetPositionState(positionSampleRef,&state)
   {
     // Process after successfully getting fix state.
   }
   @endverbatim
 *
 * - taf_locGnss_GetLocation() -- Triggered inside PositionHandlerFunction() function
 *   to get longitude, latitude, and horizontal accuracy from the position sample reference.
 * @verbatim
   int32_t     latitude;
   int32_t     longitude;
   int32_t     hAccuracy;
   if(taf_locGnss_GetLocation(positionSampleRef,&latitude,&longitude,&hAccuracy) == LE_OK)
   {
     // Process after successfully getting the location information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetAltitude() -- Triggered inside PositionHandlerFunction() function
 *   to get altitude and vertical accuracy from the position sample reference.
 * @verbatim
   int32_t     altitude;
   int32_t     vAccuracy;
   if(taf_locGnss_GetAltitude(positionSampleRef,&altitude,&vAccuracy) == LE_OK)
   {
     // Process after successfully getting the altitude.
   }
   @endverbatim
 *
 * - taf_locGnss_GetDate() -- Triggered inside PositionHandlerFunction() function
 *   to get date information from the position sample reference.
 * @verbatim
   uint16_t year;
   uint16_t month;
   uint16_t day;
   if(taf_locGnss_GetDate(positionSampleRef,&year,&month, &day) == LE_OK)
   {
     // Process after successfully getting the date information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetTime() -- Triggered inside PositionHandlerFunction() function
 *   to get time information from the position sample reference.
 * @verbatim
   uint16_t hours;
   uint16_t minutes;
   uint16_t seconds;
   uint16_t milliseconds;
   if(taf_locGnss_GetTime(positionSampleRef,&hours,&minutes, &seconds, &milliseconds) == LE_OK)
   {
     // Process after successfully getting the time information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetGpsTime() -- Triggered inside PositionHandlerFunction() function
 *   to get GPS time from the position sample reference.
 * @verbatim
   uint32_t gpsWeek;
   uint32_t gpsTimeOfWeek;
   if(taf_locGnss_GetGpsTime(positionSampleRef,&gpsWeek,&gpsTimeOfWeek) == LE_OK)
   {
     // Process after successfully getting the GPS time information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetGpsLeapSeconds() -- Triggered inside PositionHandlerFunction() function
 *   to get GPS leap seconds from the position sample reference.
 * @verbatim
   uint8_t leapSeconds = 0;
   if(taf_locGnss_GetGpsLeapSeconds(positionSampleRef,&leapSeconds) == LE_OK)
   {
     // Process after successfully getting the GPS leap second information
   }
   @endverbatim
 *
 * - taf_locGnss_GetEpochTime() -- Triggered inside PositionHandlerFunction() function
 *   to get epoch time from the position sample reference.
 * @verbatim
   uint64_t epochTime;
   if(taf_locGnss_GetEpochTime(positionSampleRef,&epochTime) == LE_OK)
   {
     // Process after successfully getting the Epoch time.
   }
   @endverbatim
 *
 * - taf_locGnss_GetTimeAccuracy() -- Triggered inside PositionHandlerFunction() function
 *   to get time accuracy from the position sample reference.
 * @verbatim
   uint32_t TimeAccuracy=0;
   if(taf_locGnss_GetTimeAccuracy(positionSampleRef,&TimeAccuracy) == LE_OK)
   {
     // Process after successfully getting the time accuracy.
   }
   @endverbatim
 *
 * - taf_locGnss_GetHorizontalSpeed() -- Triggered inside PositionHandlerFunction() function
 *   to get horizontal speed and its accuracy from the position sample reference.
 * @verbatim
   uint32_t hSpeed;
   uint32_t hSpeedAccuracy;
   if(taf_locGnss_GetHorizontalSpeed(positionSampleRef,&hSpeed,&hSpeedAccuracy) == LE_OK)
   {
     // Process after successfully getting the horizontal speed
   }
   @endverbatim
 *
 * - taf_locGnss_GetVerticalSpeed() -- Triggered inside PositionHandlerFunction() function
 *   to get vertical speed and its accuracy from the position sample reference.
 * @verbatim
   int32_t vSpeed = 0;
   int32_t vSpeedAccuracy = 0;
   if(taf_locGnss_GetVerticalSpeed(positionSampleRef,&vSpeed,&vSpeedAccuracy) == LE_OK)
   {
     // Process after successfully getting the vertical speed.
   }
   @endverbatim
 *
 * - taf_locGnss_GetDirection() -- Triggered inside PositionHandlerFunction() function
 *   to get direction and its accuracy from the position sample reference.
 * @verbatim
   uint32_t direction = 0;
   uint32_t directionAccuracy = 0;
   if(taf_locGnss_GetDirection(positionSampleRef,&direction,&directionAccuracy) == LE_OK)
   {
     // Process after successfully getting the direction information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetSatellitesInfo() -- Triggered inside PositionHandlerFunction() function
 *   to get satellites information from the position sample reference.
 * @verbatim
   uint16_t satIdPtr[TAF_LOCGNSS_SV_INFO_MAX_LEN];
   size_t satIdNumElements = NUM_ARRAY_MEMBERS(satIdPtr);
   taf_locGnss_Constellation_t satConstPtr[TAF_LOCGNSS_SV_INFO_MAX_LEN];
   size_t satConstNumElements = NUM_ARRAY_MEMBERS(satConstPtr);
   bool satUsedPtr[TAF_LOCGNSS_SV_INFO_MAX_LEN];
   size_t satUsedNumElements = NUM_ARRAY_MEMBERS(satUsedPtr);
   uint8_t satSnrPtr[TAF_LOCGNSS_SV_INFO_MAX_LEN];
   size_t satSnrNumElements = NUM_ARRAY_MEMBERS(satSnrPtr);
   uint16_t satAzimPtr[TAF_LOCGNSS_SV_INFO_MAX_LEN];
   size_t satAzimNumElements = NUM_ARRAY_MEMBERS(satAzimPtr);
   uint8_t satElevPtr[TAF_LOCGNSS_SV_INFO_MAX_LEN];
   size_t satElevNumElements = NUM_ARRAY_MEMBERS(satElevPtr);
   if(taf_locGnss_GetSatellitesInfo(positionSampleRef,satIdPtr,&satIdNumElements
                                                  ,satConstPtr,&satConstNumElements
                                                  ,satUsedPtr,&satUsedNumElements
                                                  ,satSnrPtr,&satSnrNumElements
                                                  ,satAzimPtr,&satAzimNumElements
                                                  ,satElevPtr,&satElevNumElements) == LE_OK)
   {
     // Process after successfully getting the satellite information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetSatellitesStatus() -- Triggered inside PositionHandlerFunction() function
 *   to get satellites status from the position sample reference.
 * @verbatim
   uint8_t satsInViewCount;
   uint8_t satsTrackingCount;
   uint8_t satsUsedCount;
   if(taf_locGnss_GetSatellitesStatus(positionSampleRef,&satsInViewCount,&satsTrackingCount,&satsUsedCount) == LE_OK)
   {
     // Process after successfully getting the satellite status information.
   }
   @endverbatim
 *
 * - taf_locGnss_ConfigureEngineState() -- Triggered to set the engine state for the given engine type.
 * @verbatim
   if(taf_locGnss_ConfigureEngineState(TAF_LOCGNSS_ENGINE_TYPE_SPE,TAF_LOCGNSS_ENGINE_STATE_SUSPENDED) == LE_OK)
   {
     // Process after successfully configuring Engine state for the given Engine type
   }
   @endverbatim
 *
 * - taf_locGnss_ConfigureRobustLocation() -- Triggered to enable or disable robust location while device is on E911.
 * @verbatim
   int enable = (1<<(TAF_LOCGNSS_SB_CONSTELLATION_GPS-1));
   int enabled911 =1;
   if(taf_locGnss_ConfigureRobustLocation(enable,enabled911) == LE_OK)
   {
     // Process after successfully configuring configuring robust location.
   }
   @endverbatim
 *
 * - taf_locGnss_RobustLocationInformation() -- Get robust location status and version.
 * @verbatim
   uint8_t enable;
   uint8_t enabled911;
   uint8_t majorVersion;
   uint8_t minorVersion;
   if(taf_locGnss_RobustLocationInformation(&enable,&enabled911, &majorVersion,&minorVersion) == LE_OK)
   {
     // Process after successfully getting Robust location information for Enable/Disable, 911 enable or disable, major and minor version numbers
   }
   @endverbatim
 *
 * - taf_locGnss_DefaultSecondaryBandConstellations() -- Triggered to set the default secondary band constellations.
 * @verbatim
   if(taf_locGnss_DefaultSecondaryBandConstellations() == LE_OK)
   {
     // Process after successfully setting default secondary Band constellations
   }
   @endverbatim
 *
 * - taf_locGnss_RequestSecondaryBandConstellations() -- Triggered to get the secondary band constellations set.
 * @verbatim
   int32_t constellationSb=0;
   if(taf_locGnss_RequestSecondaryBandConstellations(&constellationSb)==LE_OK)
   {
     // Process after successfully getting secondary band constellations set
   }
   @endverbatim
 *
 * - taf_locGnss_ConfigureSecondaryBandConstellations() -- Triggered to set the secondary band constellation using a bitmask.
 * @verbatim
   uint32_t constellationSb = 1;
   if(taf_locGnss_ConfigureSecondaryBandConstellations(constellationSb)==LE_OK)
   {
     // Process after successfully configuring secondary Band constellations
   }
   @endverbatim
 *
 * - taf_locGnss_GetDilutionOfPrecision() -- Triggered inside PositionHandlerFunction() function
 *   to get DOP from the position sample reference.
 * @verbatim
   uint16_t dop;
   taf_locGnss_DopType_t dopType = TAF_LOCGNSS_PDOP;
   if(taf_locGnss_GetDilutionOfPrecision(positionSampleRef,dopType,&dop) == LE_OK)
   {
     // Process after successfully getting the dilute of precision for dilute of precision type.
   }
   @endverbatim
 *
 * - taf_locGnss_GetMagneticDeviation() -- Triggered inside the PositionHandlerFunction() function to
 *                                       get magnetic deviation from the position sample reference.
 * @verbatim
   int32_t magneticDeviation;
   if(taf_locGnss_GetMagneticDeviation(positionSampleRef,&magneticDeviation) == LE_OK)
   {
     // Process after successfully getting the magnetic deviation.
   }
   @endverbatim
 *
 * - taf_locGnss_GetEllipticalUncertainty() -- Triggered inside the PositionHandlerFunction()
 *                                          function to get semi major and semi minor from positionSampleRef.
 * @verbatim
   uint32_t SemiMajor;
   uint32_t SemiMinor;
   if(taf_locGnss_GetEllipticalUncertainty(positionSampleRef,&SemiMajor, &SemiMinor) == LE_OK)
   {
     // Process after successfully getting the elliptical uncertainty values.
   }
   @endverbatim
 *
 * - taf_locGnss_SetDRConfig() -- Triggered to configure the dead reckoning parameters.
 *                             By default all DRE parameters mask get enabled.
 * @verbatim
   taf_locGnss_DrParams_t *drParamsPtr;
   static le_mem_PoolRef_t DrFramePool = NULL;
   DrFramePool = le_mem_CreatePool("DrframePool", sizeof(taf_locGnss_DrParams_t));
   drParamsPtr = (taf_locGnss_DrParams_t*) le_mem_ForceAlloc(DrFramePool);
   drParamsPtr->rollOffset = 1.2;
   drParamsPtr->yawOffset = 2.3;
   drParamsPtr->pitchOffset = 3.4;
   drParamsPtr->offsetUnc = 180.0;
   drParamsPtr->speedFactor = 1.0;
   drParamsPtr->speedFactorUnc = 0.0;
   drParamsPtr->gyroFactor = 1.0;
   drParamsPtr->gyroFactorUnc = 0.0;
   if(taf_locGnss_SetDRConfig(drParamsPtr) == LE_OK)
   {
     // Process after successfully configuring the dead reckoning parameters with the default mask enabled.
   }
   le_mem_Release(drParamsPtr);
   @endverbatim
 *
 * - taf_locGnss_SetLeverArmConfig() -- Triggered to configure the lever arm parameters.
 * @verbatim
   taf_locGnss_LeverArmParams_t *leverArmParamsPtr;
   static le_mem_PoolRef_t LevArmFramePool = NULL;
   LevArmFramePool = le_mem_CreatePool("LevArmFramePool", sizeof(taf_locGnss_LeverArmParams_t));
   leverArmParamsPtr = (taf_locGnss_LeverArmParams_t*) le_mem_ForceAlloc(LevArmFramePool);
   leverArmParamsPtr->forwardOffsetMeters = 5.5;
   leverArmParamsPtr->sidewaysOffsetMeters = 1.2;
   leverArmParamsPtr->upOffsetMeters = 1.0;
   leverArmParamsPtr->levArmType = TAF_LOCGNSS_LEVER_ARM_TYPE_GNSS_TO_VRP;
   if(taf_locGnss_SetLeverArmConfig(leverArmParamsPtr) == LE_OK)
   {
     // Process after successfully configuring the lever arm parameters.
   }
   le_mem_Release(leverArmParamsPtr);
   @endverbatim
 *
 * - taf_locGnss_SetEngineType() -- Triggered to set an engine type.
 * @verbatim
   taf_locGnss_EngineReportsType_t EngineType;
   EngineType = TAF_LOCGNSS_ENGINE_REPORT_TYPE_FUSED;
   if(taf_locGnss_SetEngineType(EngineType) == LE_OK)
   {
     // Process after successfully setting an engine type.
   }
   @endverbatim
 *
 * - taf_locGnss_GetConformityIndex() -- Triggered inside the PositionHandlerFunction()
 *                                    function to get conformity index from the position sample reference.
 * @verbatim
   double indexPtr;
   if(taf_locGnss_GetConformityIndex(positionSampleRef,&indexPtr) == LE_OK)
   {
     // Process after successfully getting the conformity index.
   }
   @endverbatim
 *
 * - taf_locGnss_GetCalibrationData() -- Triggered inside the PositionHandlerFunction()
 *                                    function to get calibration data from the position sample reference.
 * @verbatim
   uint32 calibPtr;
   uint8_t percentPtr;
   if(taf_locGnss_GetCalibrationData(positionSampleRef,&calibPtr,&percentPtr) == LE_OK)
   {
     // Process after successfully getting the calibration status and confidence percentage.
   }
   @endverbatim
 *
 * - taf_locGnss_GetDRSolutionStatus() -- Triggered inside the PositionHandlerFunction()
 *                                    function to get dead reckoning solution status from the position sample reference.
 * @verbatim
   uint32 solutionStatusPtr;
   if(taf_locGnss_GetDRSolutionStatus(positionSampleRef,&solutionStatusPtr) == LE_OK)
   {
     // Process after successfully getting the dead reckoning solution status.
   }
   @endverbatim
 *
 * - taf_locGnss_GetBodyFrameData() -- Triggered inside the PositionHandlerFunction()
 *                                  function to get body frame data from the positionSampleRef.
 * @verbatim
   taf_locGnss_KinematicsData_t *bodyFrameData;
   le_mem_PoolRef_t bodyFramePool = NULL;
   bodyFramePool = le_mem_CreatePool("bodyFramePool", sizeof(taf_locGnss_KinematicsData_t));
   bodyFrameData = (taf_locGnss_KinematicsData_t*) le_mem_ForceAlloc(bodyFramePool);
   if(taf_locGnss_GetBodyFrameData(positionSampleRef,bodyFrameData) == LE_OK)
   {
     // Process after successfully getting the body frame parameters.
   }
   @endverbatim
 *
 * - taf_locGnss_GetVRPBasedLLA() -- Triggered inside the PositionHandlerFunction()
 *                                function to get VRP based LLA from the position sample reference.
 * @verbatim
   double vrpLatitude;
   double vrpLongitude;
   double vrpAltitude;
   if(taf_locGnss_GetVRPBasedLLA(positionSampleRef, &vrpLatitude,&vrpLongitude,&vrpAltitude) == LE_OK)
   {
     // Process after successfully getting VRP based latitude, longitude, and altitude information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetVRPBasedVelocity() -- Triggered inside the PositionHandlerFunction()
 *                                     function to get VRP based velocity from the position sample reference.
 * @verbatim
   double eastVel;
   double northVel;
   double upVel;
   if(taf_locGnss_GetVRPBasedVelocity(positionSampleRef, &eastVel,&northVel,&upVel) == LE_OK)
   {
     // Process after successfully getting VRP based east, north, and up velocity information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetSvUsedInPosition() -- Triggered inside the PositionHandlerFunction()
 *                                     function to get SV used in position from the position sample reference.
 * @verbatim
   taf_locGnss_SvUsedInPosition_t *svData;
   le_mem_PoolRef_t svFramePool = NULL;
   svFramePool = le_mem_CreatePool("svFramePool", sizeof(taf_locGnss_SvUsedInPosition_t));
   svData = (taf_locGnss_SvUsedInPosition_t*) le_mem_ForceAlloc(svFramePool);
   if(taf_locGnss_GetSvUsedInPosition(positionSampleRef, svData) == LE_OK)
   {
     // Process after successfully getting set of SVs that are used to calculate position.
   }
   @endverbatim
 *
 * - taf_locGnss_GetSbasCorrection() -- Triggered inside the PositionHandlerFunction()
 *                                   function to get SBAS correction from the position sample reference.
 * @verbatim
   uint32_t sbasMask;
   if(taf_locGnss_GetSbasCorrection(positionSampleRef, &sbasMask) == LE_OK)
   {
     // Process after successfully getting the mask used to indicate SBAS corrections.
   }
   @endverbatim
 *
 * - taf_locGnss_GetPositionTechnology() -- Triggered inside the PositionHandlerFunction()
 *                                       function to get position technology from the position sample reference.
 * @verbatim
   uint32_t techMask;
   if(taf_locGnss_GetPositionTechnology(positionSampleRef,&techMask) == LE_OK)
   {
     // Process after successfully getting position tech mask
   }
   @endverbatim
 *
 * - taf_locGnss_GetLocationInfoValidity() -- Triggered inside the PositionHandlerFunction()
 *                                         function to get location information validity from the position sample reference.
 * @verbatim
   uint32_t validityMask;
   uint64_t validityExMask;
   if(taf_locGnss_GetLocationInfoValidity(positionSampleRef, &validityMask,&validityExMask) == LE_OK)
   {
     // Process after successfully getting the validity information
   }
   @endverbatim
 *
 * - taf_locGnss_GetLocationOutputEngParams() -- Triggered inside the PositionHandlerFunction()
 *                                           function to get engine output parameters from the position sample reference.
 * @verbatim
   uint16_t engMask;
   uint16_t locationEngType;
   if(taf_locGnss_GetLocationOutputEngParams(positionSampleRef, &engMask,&locationEngType) == LE_OK)
   {
     // Process after successfully getting the location engine mask and engine type parameters.
   }
   @endverbatim
 *
 * - taf_locGnss_GetReliabilityInformation() -- Triggered inside the PositionHandlerFunction()
 *                                           function to get reliablity information from the position sample reference.
 * @verbatim
   uint16_t horireliability;
   uint16_t vertreliability;
   if(taf_locGnss_GetReliabilityInformation(positionSampleRef, &horireliability,&vertreliability) == LE_OK)
   {
     // Process after successfully getting the horizontal and vertical reliability information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetStdDeviationAzimuthInfo() -- Triggered inside the PositionHandlerFunction()
 *                                            function to get standard deviation and azimuth information
 *                                            from the position sample reference.
 * @verbatim
   double azimuth;
   double eastDev;
   double northDev;
   if(taf_locGnss_GetStdDeviationAzimuthInfo(positionSampleRef, &azimuth,&eastDev,&northDev) == LE_OK)
   {
     // Process after successfully getting the azimuth, east, and north deviation information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetRealTimeInformation() -- Triggered inside the PositionHandlerFunction()
 *                                        function to get real time information from the position sample reference.
 * @verbatim
   uint64_t realTime;
   uint64_t realTimeUnc;
   if(taf_locGnss_GetRealTimeInformation(positionSampleRef, &realTime,&realTimeUnc) == LE_OK)
   {
     // Process after successfully getting elapsed real time and its uncertainty.
   }
   @endverbatim
 *
 * - taf_locGnss_GetMeasurementUsageInfo() -- Triggered inside the PositionHandlerFunction()
 *                                         function to get GNSS measurement usage information
 *                                         from the position sample reference.
 * @verbatim
   taf_locGnss_GnssMeasurementInfo_t measInfo[TAF_LOCGNSS_MEASUREMENT_INFO_MAX];
   size_t gnssMeasLen = TAF_LOCGNSS_MEASUREMENT_INFO_MAX;
   if(taf_locGnss_GetMeasurementUsageInfo(positionSampleRef, measInfo, &gnssMeasLen) == LE_OK)
   {
     // Process after successfully getting GNSS measurement information.
   }
   @endverbatim
 *
 * - taf_locGnss_GetReportStatus() -- Triggered inside the PositionHandlerFunction()
 *                                 function to get status of report in terms of how optimally
 *                                 the report was calculated by the engine from the position sample reference.
 * @verbatim
   int32_t reportStatus = -1;
   if(taf_locGnss_GetReportStatus(positionSampleRef, &reportStatus) == LE_OK)
   {
     // Process after successfully getting the report status.
   }
   @endverbatim
 *
 * - taf_locGnss_GetAltitudeMeanSeaLevel() -- Triggered inside the PositionHandlerFunction() function
 *                                         to get altitude with respect to mean sea level in meters
 *                                         from the position sample reference.
 * @verbatim
   double altMSeaLevel;
   if(taf_locGnss_GetAltitudeMeanSeaLevel(positionSampleRef, &altMSeaLevel) == LE_OK)
   {
     // Process after successfully getting the mean sea level.
   }
   @endverbatim
 *
 * - taf_locGnss_GetSVIds() -- Triggered inside the PositionHandlerFunction() function
 *                          to get GNSS Satellite Vehicles used in position data from the position sample reference.
 * @verbatim
   uint16_t svIds[TAF_LOCGNSS_MEASUREMENT_INFO_MAX];
   size_t svIdsLen = TAF_LOCGNSS_MEASUREMENT_INFO_MAX;
   if(taf_locGnss_GetSVIds(positionSampleRef, svIds, &svIdsLen) == LE_OK)
   {
     // Process after successfully getting the GNSS Satellite Vehicles used in position data.
   }
   @endverbatim
 *
 * - taf_locGnss_GetDilutionOfPrecision() -- Gets the Dilution of Precision (DOP) paramters with a
 * resolution of 3 decimal places by default. This resolution can be modified by calling the
 * @c taf_locGnss_SetDopResolution() function first.
 *
 * - taf_locGnss_SetDopResolution() -- Sets the resolution per client session.
 * @verbatim
   static taf_locGnss_Resolution_t DopRes = TAF_LOCGNSS_RES_ONE_DECIMAL;
   if(taf_locGnss_SetDopResolution(DopRes) == LE_OK)
   {
     // Process after successfully setting the dilute of precision resolution
   }
   @endverbatim
 *
 * taf_locGnss_SetDopResolution() and @c taf_locGnss_GetDilutionOfPrecision() functions should be called
 * in the same thread or client session.
 *
 * - taf_locGnss_SetMinGpsWeek() -- Sets the minimum GPS week used by the modem GNSS standard
 * position engine (SPE). This API shall not be called when GNSS state is ACTIVE.
 * Behavior is not defined if client issues a second request of SetMinGpsWeek without waiting
 * for the previous SetMinGpsWeek to finish. Additionally minimum GPS week number shall NEVER
 * be in the future of the current GPS Week.
 * @verbatim
   uint16        minGpsWeek = 1;
   if(taf_locGnss_SetMinGpsWeek(minGpsWeek) == LE_OK)
   {
     // Process after succesfully setting the minimum GPS week.
   }
   @endverbatim
 *
 * - taf_locGnss_GetMinGpsWeek() -- Gets the minimum GPS week used by the modem GNSS standard
 * position engine (SPE).
 * @verbatim
   uint16        minGpsWeek;
   if(taf_locGnss_GetMinGpsWeek(&minGpsWeek) == LE_OK)
   {
     // Process after succesfully getting the minimum GPS week.
   }
   @endverbatim
 *
 * A handler function should be registered for location capability notification.
 * @ref taf_locGnss_AddCapabilityChangeHandler() allows users to register a location capability handler.
 *
 * When the capability of the GNSS stack changes, the handler is invoked to notify
 * the client about the update.
 *
 * The handler must follow the below prototype:
 *
 * @verbatim
   static void CapabilityHandlerFunction
   (
       taf_locGnss_LocCapabilityType_t locCapability,
       void* contextPtr
   )
   {
       // Process the location capability received in the handler function.
   }
 * @endverbatim
 *
 * @b NOTE: If many applications register handlers for capability notifications, they
 *          will all receive it.
 *
 * An application may unregister a capability handler by calling @ref taf_locGnss_RemoveCapabilityChangeHandler().
 *
 * - taf_locGnss_GetCapabilities() -- Gets the GNSS capability information.
 * @verbatim
   uint64  locCapability;
   if(taf_locGnss_GetCapabilities(&locCapability) == LE_OK)
   {
     // Process after succesfully getting the GNSS capability information.
   }
   @endverbatim
 *
 * - taf_locGnss_SetNmeaConfiguration() -- Sets the configuration for NMEA sentences that will be
 * received by the clients via @ref NmeaHandler.
 *
 * Without prior invocation to this API, all NMEA sentences supported in the system will get generated and delivered to all the
 * clients that register to receive NMEA sentences. The configuration is common
 * across all clients and updating it will affect all clients.
 *
 * @verbatim
   taf_locGnss_NmeaBitMask_t nmeaMask = TAF_LOCGNSS_NMEA_MASK_GPGGA | TAF_LOCGNSS_NMEA_MASK_GPGNS;
   taf_locGnss_GeodeticDatumType_t datumType = TAF_LOCGNSS_GEODETIC_TYPE_WGS_84;
   taf_locGnss_LocEngineType engineType = TAF_LOCGNSS_LOC_REQ_ENGINE_FUSED_BIT
   if(taf_locGnss_SetNmeaConfiguration(nmeaMask, datumType, engineType) == LE_OK)
   {
     // Process after succesfully getting the the NMEA sentences.
   }
   @endverbatim
 *
 * @b NOTE: This API call is not incremental and the new NMEA configuration will completely overwrite
 *          the previous call to this API.
 *
 * - taf_locGnss_GetXtraStatus() -- Gets whether the XTRA feature is enabled or not,
 * XTRA data status, and the valid time in hours.
 *
 * @verbatim
   taf_locGnss_XtraStatusParams_t *XtraParamsPtr;
   le_result_t result = LE_FAULT;
   le_mem_PoolRef_t XtraFramePool = NULL;
   XtraFramePool = le_mem_CreatePool("XtraFramePool", sizeof(taf_locGnss_XtraStatusParams_t));
   XtraParamsPtr = (taf_locGnss_XtraStatusParams_t*) le_mem_ForceAlloc(XtraFramePool);
   if(XtraParamsPtr != NULL)
   {
       if(taf_locGnss_GetXtraStatus(XtraParamsPtr) == LE_OK)
       {
         // Process after successfully getting the XTRA data parameters.
       }
   }
   le_mem_Release(XtraParamsPtr);
   @endverbatim
 *
 * - taf_locGnss_GetGnssData() -- Gets GNSS data for data mask, jammer indication, and
 *   Automatic Gain Control (AGC) information.
 *
 * @verbatim
   size_t maxSigTypes = TAF_LOCGNSS_NUMBER_OF_SIGNAL_TYPES_MAX;
   taf_locGnss_GnssData_t gnssDataPtr[TAF_LOCGNSS_NUMBER_OF_SIGNAL_TYPES_MAX];
   if(taf_locGnss_GetGnssData(positionSampleRef, gnssDataPtr, &maxSigTypes))
   {
     // Process after successfully getting data mask, jammer, and AGC information.
   }
   @endverbatim
 *
 *
 * - taf_locGnss_SetDRConfigValidity() -- Sets the dead reckoning parameters validity mask.
 * @verbatim
   taf_locGnss_DRConfigValidityType_t drParamsMask;
   taf_locGnss_DrParams_t *drParamsPtr;
   drParamsMask |= TAF_LOCGNSS_BODY_TO_SENSOR_MOUNT_PARAMS_VALID;
   drParamsMask |= TAF_LOCGNSS_VEHICLE_SPEED_SCALE_FACTOR_VALID;
   drParamsMask |= TAF_LOCGNSS_VEHICLE_SPEED_SCALE_FACTOR_UNC_VALID;
   drParamsMask |= TAF_LOCGNSS_GYRO_SCALE_FACTOR_VALID;
   drParamsMask |= TAF_LOCGNSS_GYRO_SCALE_FACTOR_UNC_VALID;
   static le_mem_PoolRef_t DrFramePool = NULL;
   DrFramePool = le_mem_CreatePool("DrframePool", sizeof(taf_locGnss_DrParams_t));
   drParamsPtr = (taf_locGnss_DrParams_t*) le_mem_ForceAlloc(DrFramePool);
   drParamsPtr->rollOffset = 1.2;
   drParamsPtr->yawOffset = 2.3;
   drParamsPtr->pitchOffset = 3.4;
   drParamsPtr->offsetUnc = 180.0;
   drParamsPtr->speedFactor = 1.0;
   drParamsPtr->speedFactorUnc = 0.0;
   drParamsPtr->gyroFactor = 1.0;
   drParamsPtr->gyroFactorUnc = 0.0;
   if(taf_locGnss_SetDRConfigValidity(drParamsMask) == LE_OK)
   {
     // Process after successfully setting the dead reckoning parameters validity mask.
   }
   if(taf_locGnss_SetDRConfig(drParamsPtr) == LE_OK)
   {
     // Process after successfully configuring the dead reckoning parameters with the mask enabled.
   }
   le_mem_Release(drParamsPtr);
   @endverbatim
 *
 * - taf_locGnss_GetGptpTime() -- Gets Gptp time and its uncertainty
 *
 * @verbatim
   uint64_t gPtpTime;
   uint64_t gPtpTimeUnc;
   if(taf_locGnss_GetGptpTime(positionSampleRef,&gPtpTime,&gPtpTimeUnc))
   {
     // Process after successfully getting Gptp time information.
   }
   @endverbatim
 *
 * @subsection taf_locGnss_GetLeapSeconds Get leap seconds event information
 *
 * The leap seconds event information is retrieved by calling taf_locGnss_GetLeapSeconds() API.
 * The result includes the current GPS time, current leap seconds, next leap second event time,
 * and next leap seconds.
 * Insertion of each UTC leap second is usually decided about six months in advance by the
 * International Earth Rotation and Reference Systems Service (IERS).
 * The leap seconds uncertainty value is retrieved by calling taf_locGnss_GetLeapSecondsUncertainty() API.
 *
 * @section taf_locGnss_usage_flow Typical application call flow
 *
 * @rstblock
 * .. image:: /rst/flow_diagrams/location_usage_flow.jpg
 *
 * The Location application locates in NAD device and access the tafLocationSvc on the corresponding NAD device.
 *
 * #0 -- Start GNSS session with the service.
 *
 * #1 -- Add the position handler to be able to receive any GNSS fixes received from the location service.
 *
 * #2 -- Get location information including longitude, latitude and horizontal accuracy.
 *
 * #3 -- Get the altitude information and its accuracy.
 *
 * #4 -- Get the vehicle direction information and its accuracy.
 *
 * #5 -- Get the horizontal speed information and its accuracy.
 *
 * #6 -- Get the vertical speed information and its accuracy.
 *
 * #7 -- Get the position state, ex. 2D, 3D and Estimated Fix.
 *
 * #8 -- When there's no need to receive any GNSS fixes from the application, the registered handler reference can be removed.
 *
 * #9 -- Stop the GNSS session with the service. This will stop receiving fixes at the location service.
 *
 * @endrst
 *
 * <HR>
 *
 */
//-------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 *  GNSS position sample reference type.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Sample;

//--------------------------------------------------------------------------------------------------
/**
 * Defines the maximum length of the satellite vehicle information.
 */
//--------------------------------------------------------------------------------------------------
DEFINE SV_INFO_MAX_LEN = 150;

//--------------------------------------------------------------------------------------------------
/**
 * Defines the maximum length of the satellite vehicle information in a constellation.
 */
//--------------------------------------------------------------------------------------------------
DEFINE SV_INFO_MAX_SATS_IN_CONSTELLATIONS = 40;

//--------------------------------------------------------------------------------------------------
/**
 * Defines the maximum count of the secondary band constellations.
 */
//--------------------------------------------------------------------------------------------------
DEFINE SB_CONST_MAX_LEN = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Defines the maximum bitmask for enabled NMEA sentences.
 *
 * @b NOTE: This value should be coherent with @ref le_gnss_NmeaBitMask_t.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NMEA_SENTENCES_MAX = 0xFFFFFFFF;

//--------------------------------------------------------------------------------------------------
/**
 * TAF_LOCGNSS_NMEA_MASK_PQXFI is deprecated.
 *
 */
//--------------------------------------------------------------------------------------------------
DEFINE NMEA_MASK_PQXFI        = 0x4000;


//--------------------------------------------------------------------------------------------------
/**
 * Maximum value allowed for @ref taf_locGnss_SetMinElevation
 */
//--------------------------------------------------------------------------------------------------
DEFINE MIN_ELEVATION_MAX_DEGREE = 90;

//--------------------------------------------------------------------------------------------------
/**
 * Define the maximum number of measurement usages information.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MEASUREMENT_INFO_MAX = 30;

//--------------------------------------------------------------------------------------------------
/**
 * Define the maximum number of charaters for NMEA string.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NMEA_STRING_MAX = 150;

//--------------------------------------------------------------------------------------------------
/**
 * Define the maximum number of charaters for CA path.
 */
//--------------------------------------------------------------------------------------------------
DEFINE CA_PATH_MAX = 128;

//--------------------------------------------------------------------------------------------------
/**
 * Define the maximum number of charaters for URL path.
 */
//--------------------------------------------------------------------------------------------------
DEFINE URL_PATH_MAX = 128;

//--------------------------------------------------------------------------------------------------
/**
 * Defines the maximum number of GNSS data signal types.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NUMBER_OF_SIGNAL_TYPES_MAX = 23;

//--------------------------------------------------------------------------------------------------
/**
 * Location service states.
 */
//--------------------------------------------------------------------------------------------------
ENUM State
{
    STATE_UNINITIALIZED,    ///< The Location service state is not initialized.
    STATE_READY,            ///< The Location service state is ready.
    STATE_ACTIVE,           ///< The Location service state is active.
    STATE_DISABLED,         ///< The Location service state is disabled.
    STATE_MAX               ///< Do not use this state value.
};

//--------------------------------------------------------------------------------------------------
/**
 *  GNSS constellation type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Constellation
{
    SV_CONSTELLATION_UNDEFINED,        ///< GNSS constellation field is undefined.
    SV_CONSTELLATION_GPS,              ///< Satellite Vehicle of Global Positioning System constellation.
    SV_CONSTELLATION_SBAS,             ///< Satellite Vehicle of SBAS constellation.
    SV_CONSTELLATION_GLONASS,          ///< Satellite Vehicle of GLONASS constellation.
    SV_CONSTELLATION_GALILEO,          ///< Satellite Vehicle of GALILEO constellation.
    SV_CONSTELLATION_BEIDOU,           ///< Satellite Vehicle of BEIDOU constellation.
    SV_CONSTELLATION_QZSS,             ///< Satellite Vehicle of QZSS constellation.
    SV_CONSTELLATION_NAVIC,            ///< Satellite Vehicle of NAVIC constellation.
    SV_CONSTELLATION_MAX               ///< Maximum value of constellation.
};

//--------------------------------------------------------------------------------------------------
/**
 *  GNSS secondary band constellation types.
 */
//--------------------------------------------------------------------------------------------------
ENUM SBConstellation
{
    SB_CONSTELLATION_UNKNOWN = -1,     ///< Unknown secondary band constellation.
    SB_CONSTELLATION_GPS = 1,          ///< GPS secondary band constellation.
    SB_CONSTELLATION_GALILEO = 2,      ///< GALILEO secondary band constellation.
    SB_CONSTELLATION_SBAS = 3,         ///< SBAS secondary band constellation.
    SB_CONSTELLATION_COMPASS = 4,      ///< Not supported.
    SB_CONSTELLATION_GLONASS = 5,      ///< GLONASS secondary band constellation.
    SB_CONSTELLATION_BDS = 6,          ///< BDAS secondary band constellation.
    SB_CONSTELLATION_QZSS = 7,         ///< QZSS secondary band constellation.
    SB_CONSTELLATION_NAVIC = 8         ///< NAVIC secondary band constellation.
};

//--------------------------------------------------------------------------------------------------
/**
 *  GNSS fix position states.
 */
//--------------------------------------------------------------------------------------------------
ENUM FixState
{
    STATE_FIX_NO_POS,          ///< No fixed GNSS fix position.
                               ///  Even for TAF_LOCGNSS_REPORT_STATUS_INTERMEDIATE, this fix
                               ///  state will be returned.
    STATE_FIX_2D,              ///< 2-dimensional position fix
    STATE_FIX_3D,              ///< 3-dimensional position fix.
    STATE_FIX_ESTIMATED        ///< Estimated position fix.
};

//--------------------------------------------------------------------------------------------------
/**
 *  GNSS altitude types.
 */
//--------------------------------------------------------------------------------------------------
ENUM AltType
{
    ALT_TYPE_UNKNOWN,          ///< Unknown altitude type.
    ALT_TYPE_CALCULATED,       ///< Altitude is calculated.
    ALT_TYPE_ASSUMED           ///< Altitude is assumed as there may not be enough satellites to
                               ///  determine the precise altitude.
};

//--------------------------------------------------------------------------------------------------
/**
 * Satellite Vehicle information.
 */
//--------------------------------------------------------------------------------------------------
STRUCT SvInfo
{
    Constellation satConst;    ///< The constellation type in which this satellite vehicle belongs.
    bool satUsed;              ///< The flag to indicate whether the satellite is used in computing the fix.
    bool satTracked;           ///< The flag to indicate whether the satellite is used to track the vehicle. If it's tracked, the satSnr will hold valid value.
    uint8 satSnr;              ///< The signal-to-noise ratio of the signal measured at antenna of the satellite vehicle. Units: dB-Hz
    uint8 satElev;             ///< The satellite vehicle elevation angle. Units: Degrees. Range: 0 to 90.
    uint16 satId;              ///< The GNSS satellite vehicle ID.
    uint16 satAzim;            ///< The satellite vehicle azimuth angle. Units: Degrees. Range: 0 to 360.
    uint32 signalType;         ///< The different types of signal for gps, galileo, beidou etc. @ref GnssSignalType.
    uint16 glonassFcn;         ///< GLONASS frequency channel number in the range [1, 14] which is calculated as FCN [-7, 6] + 8.
    double baseBandCnr;        ///< Carrier-to-noise ratio of the signal measured at baseband. Units: dB-Hz.
};

//------------------------------------------------------------------------------------------------
/**
 * Specify Location Capabilities Type.
 */
//------------------------------------------------------------------------------------------------
BITMASK LocCapabilityType
{
  TIME_BASED_TRACKING,        ///< Time based tracking session is supported.
  DISTANCE_BASED_TRACKING,    ///< Distance based tracking session is supported.
  GNSS_MEASUREMENTS,          ///< Receiving GNSS measurement data is supported.
  CONSTELLATION_ENABLEMENT,   ///< Support to configure constellations available.
  CARRIER_PHASE,              ///< Support for carrier phase for Positioning
                              ///  Measurement Engine (PPME) available.
  QWES_GNSS_SINGLE_FREQUENCY, ///< Supports GNSS Single Frequency feature.
  QWES_GNSS_MULTI_FREQUENCY,  ///< Supports GNSS Multi Frequency feature.
                              ///  This indicates support for
                              ///  GNSS single frequency is also available.
  QWES_VPE,                   ///< Indicates VEPP license bundle is enabled. VEPP bundle include
                              ///  Carrier Phase and SV Polynomial.
  QWES_CV2X_LOCATION_BASIC,   ///< Indicates support for CV2X Location basic features. This bundle
                              ///  includes features for GTS Time & Freq,
                              ///  C-TUNC (Constrained Time uncertainty).
  QWES_CV2X_LOCATION_PREMIUM, ///< Indicates support for CV2X Location premium features. This bundle
                              ///  includes features for CV2X Location Basic features, QDR3 feature,
                              ///  and PACE. (Position Assisted Clock Estimator).
  QWES_PPE,                   ///< Indicates that PPE (Precise Positioning Engine) library
                              ///  is enabled or Precise Positioning Framework (PPF) is available.
                              ///  Framework (PPF) is available. This includes features for
                              ///  Carrier Phase and SV Ephermeris.
  QWES_QDR2,                  ///< Indicates QDR2_C license bundle is enabled.
  QWES_QDR3,                  ///< Indicates QDR3_C license bundle is enabled.
  TIME_BASED_BATCHING,        ///< Time based batching is supported.
  DISTANCE_BASED_BATCHING,    ///< Distance based batching is supported.
  GEOFENCE,                   ///< Geofencing is supported.
  OUTDOOR_TRIP_BATCHING,      ///< Outdoor trip batching is supported.
  SV_POLYNOMIAL,              ///< Support for SV polynomial is available.
  NLOS_ML20                   ///< Indicates presence of ML Inference capability for
                              ///  Pseudo Range Measurements.
};

//--------------------------------------------------------------------------------------------------
/**
 *  Specifies the set of engines
 *
 */
//--------------------------------------------------------------------------------------------------
ENUM LocEngineType
{
    LOC_ENGINE_UNKNOWN,     ///< Unknown engine type bit. Do not use it.
    LOC_ENGINE_FUSED,       ///< Indicate that the fused/default position is needed to be
                            ///  reported back for the tracking sessions. The default position
                            ///  is the propagated/aggregated reports from all engines running
                            ///  on the system (e.g.: DR/SPE/PPE) according to QTI algorithm.
    LOC_ENGINE_SPE,         ///< Indicate that the unmodified SPE position is needed to be
                            ///  reported back for the tracking sessions.
    LOC_ENGINE_PPE,         ///< Indicate that the unmodified PPE position is needed to be
                            ///  reported back for the tracking sessions.
    LOC_ENGINE_VPE          ///< Indicate that the unmodified VPE position is needed to be
                            ///  reported back for the tracking sessions.
};


//--------------------------------------------------------------------------------------------------
/**
 * Handler for position information.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER PositionHandler
(
 Sample positionSampleRef ///< Position sample reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on position.
 *
 */
//--------------------------------------------------------------------------------------------------
EVENT Position
(
 PositionHandler handler
);

//-------------------------------------------------------------------------------------------------
/**
 * Handler for location capability event notification.
 */
//-------------------------------------------------------------------------------------------------
HANDLER CapabilityChangeHandler
(
    LocCapabilityType locCapability    IN     ///< The location capability.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information on location capability.
 */
//-------------------------------------------------------------------------------------------------
EVENT CapabilityChange
(
    CapabilityChangeHandler handler ///< Capability change handler.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Resolutions values.
 */
//--------------------------------------------------------------------------------------------------
ENUM Resolution
{
    RES_ZERO_DECIMAL,          ///< 0 decimal place resolution.
    RES_ONE_DECIMAL,           ///< 1 decimal place resolution.
    RES_TWO_DECIMAL,           ///< 2 decimal place resolution.
    RES_THREE_DECIMAL,         ///< 3 decimal place resolution.
    RES_UNKNOWN                ///< Unknown resolution.
};

//--------------------------------------------------------------------------------------------------
/**
 * Gets the last updated position sample object reference.
 *
 * @return A reference to the last position sample.
 *
 * @b NOTE:
 *      On failure, the process exits.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Sample GetLastSampleRef
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's fix state per client session.
 *
 * @return
 *  - LE_OK    Succeeded.
 *  - LE_FAULT Failed.
 *
 * @b NOTE: If the caller passes an invalid position sample reference or a null pointer to this
 *       function, it is a fatal error and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPositionState
(
    Sample   positionSampleRef IN,          ///< Position sample reference.
    FixState state OUT                      ///< Position fix state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Releases the position sample per client session.
 *
 * @b NOTE: If the caller passes an invalid position sample reference to this function,
 *       it is a fatal error and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ReleaseSampleRef
(
    Sample positionSampleRef IN        ///< Position sample reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the location data (latitude, longitude, horizontal accuracy)
 * per client session.
 *
 * @return
 *  - LE_FAULT         Failed to get the location's data
 *  - LE_OUT_OF_RANGE  At least one of the retrieved parameters is invalid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: latitudePtr, longitudePtr, and hAccuracyPtr can be set to NULL if not needed.
 *
 * @b NOTE: The latitude and longitude values are based on the WGS84 standard coordinate system.
 *
 * @b NOTE: The latitude and longitude values are given in degrees with 6 decimal places like:
 *       Latitude +48858300 = 48.858300 degrees North
 *       Longitude +2294400 = 2.294400 degrees East
 *       The latitude and longitude values are given in degrees, minutes, seconds in NMEA frame.
 *
 * @b NOTE: In case the function returns LE_OUT_OF_RANGE, some of the retrieved parameters may be
 *       valid. Compare them with INT32_MAX.
 *
 * @b NOTE: If the caller passes an invalid position sample reference to this function,
 *       it is a fatal error and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetLocation
(
    Sample positionSampleRef IN, ///< Position sample reference
    int32 latitude OUT,          ///< WGS84 latitude in degrees with 6 decimal places.
    int32 longitude OUT,         ///< WGS84 longitude in degrees with 6 decimal places.
    int32 hAccuracy OUT          ///< Horizontal accuracy in cm. Uncertainty is defined with 68%
                                 ///  confidence level.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample direction as per client session. Direction of movement is the
 * direction that the vehicle or person is actually moving.
 *
 * @return
 *  - LE_FAULT         Failed to get the location's data
 *  - LE_OUT_OF_RANGE  At least one of the retrieved parameters is invalid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: Direction and direction accuracy are given in degrees with 1 decimal place: 1755 = 175.5
 * degrees.
 * Direction ranges from 0 to 359.9 degrees, where 0 is True North.
 *
 * @b NOTE: If the function returns LE_OUT_OF_RANGE, some of the retrieved parameters may be
 *       valid. Compare them with INT32_MAX.
 *
 * @b NOTE: directionPtr and directionAccuracyPtr can be set to NULL if not needed.
 *
 * @b NOTE: If the caller passes an invalid position sample reference to this function,
 *       it is a fatal error and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDirection
(
    Sample  positionSampleRef IN,       ///< Position sample reference.
    uint32  direction OUT,              ///< Direction in degrees with 1 decimal place.
    uint32  directionAccuracy OUT       ///< Direction accuracy estimation in degrees with 1 decimal place.
                                        ///  Uncertainty is defined with 68% confidence level.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's altitude per client session.
 *
 * @return
 *  - LE_FAULT         Failed to get the altitude. Invalid position reference provided.
 *  - LE_OUT_OF_RANGE  At least one of the retrieved parameters is invalid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: For a 2D position fix, the altitude will be indicated as invalid and set to INT32_MAX
 *
 * @b NOTE: In case the function returns LE_OUT_OF_RANGE, some of the retrieved parameters may be
 *       valid. Compare them with INT32_MAX.
 *
 * @b NOTE: If the caller passes an invalid position reference to this function,
 *       it is a fatal error and the client will be killed.
 *
 * @b NOTE: altitudePtr and altitudeAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAltitude
(
    Sample positionSampleRef  IN,   ///< Position sample reference
    int32 altitude OUT,             ///< Altitude in mm above the WGS 84 reference ellipsoid.
    int32 vAccuracy OUT             ///< Vertical uncertainty in dm. Uncertainty is defined with 68% confidence level.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's horizontal speed per client session.
 *
 * @returns
 * - LE_FAULT         Failed to find the positionSample.
 * - LE_OUT_OF_RANGE  At least one of the retrieved parameters is invalid.
 * - LE_OK            Succeeded.
 *
 * @b NOTE: hSpeedPtr and hSpeedAccuracyPtr can be set to NULL if not needed.
 *
 * @b NOTE: Horizontal speed is in meters/second with 2 decimal places (3047 = 30.47 meters/second).
 *
 * @b NOTE: In case the function returns LE_OUT_OF_RANGE, some of the retrieved parameters may be
 *       valid. Compare them with UINT32_MAX.
 *
 * @b NOTE: If the caller passes an invalid position sample reference to this function,
 *       it is a fatal error and the client will be killed.
 *
 *
 * @b WARNING: The horizontal speed accuracy is platform dependent.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetHorizontalSpeed
(
    Sample positionSampleRef IN,        ///< Position sample reference.
    uint32 hspeed OUT,                  ///< Horizontal speed in cm/s.
    uint32 hspeedAccuracy OUT           ///< Horizontal accuracy estimation in dm/sec.
                                        ///  Uncertainty is defined with 68% confidence level.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's vertical speed per client session.
 *
 * @return
 *  - LE_FAULT         Failed to find finding the positionSample.
 *  - LE_OUT_OF_RANGE  At least one of the retrieved parameters is not valid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: vSpeedPtr and vSpeedAccuracyPtr can be set to NULL if not needed.
 *
 * @b NOTE: For a 2D position fix, the vertical speed will be indicated as invalid
 *       and set to INT32_MAX.
 *
 * @b NOTE: In case the function returns LE_OUT_OF_RANGE, some of the retrieved parameters may be
 *       valid. Compare them with INT32_MAX.
 *
 * @b NOTE: If the caller passes an invalid position sample reference to this function,
 *       it is a fatal error and the client will be killed.
 *
 *
 * @b WARNING: The vertical speed accuracy is platform dependent.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVerticalSpeed
(
    Sample positionSampleRef IN,         ///< Position sample reference.
    int32  vspeed OUT,                   ///< Vertical speed in cm/sec.
    int32  vspeedAccuracy OUT            ///< Vertical speed's accuracy estimation in dm/sec.
                                         ///  Uncertainty is defined with 68% confidence level.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's UTC leap seconds in advance per client session.
 *
 * @return
 *  - LE_FAULT         Failed to get the leap seconds.
 *  - LE_OUT_OF_RANGE  The retrieved time accuracy is invalid
 *  - LE_OK            Succeeded.

 *
 * @b NOTE: If the caller passes an invalid position sample reference or a null pointer to this
 *       function, it is a fatal error and the client will be killed.
 *
 *
 * This function is deprecated; le_gnss_GetLeapSeconds should be used instead.
 *
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t  GetGpsLeapSeconds
(
    Sample positionSampleRef  IN,       ///< Position sample reference.
    uint8  leapSeconds OUT              ///< UTC leap seconds in seconds.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's date per client session.
 *
 * @return
 *  - LE_FAULT         Failed to get the date.
 *  - LE_OUT_OF_RANGE  The retrieved date is invalid.
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: If the caller passes an invalid position sample reference or null pointers to this
 *       function, it is a fatal error and the client will be killed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDate
(
    Sample positionSampleRef IN, ///< Position sample reference.
    uint16 year OUT,             ///< UTC year A.D., e.g., 2022.
    uint16 month OUT,            ///< UTC month of the year; range is 1 to 12.
    uint16 day OUT               ///< UTC days of the month; range is 1 to 31.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's time per client session.
 *
 * @return
 *  - LE_FAULT         Failed to get the time.
 *  - LE_OUT_OF_RANGE  The retrieved time is invalid
 *  - LE_OK            Succeeded.
 *
 * @b NOTE: If the caller passes an invalid position sample reference or null pointers to this
 *       function, it is a fatal error and the client will be killed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTime
(
    Sample positionSampleRef  IN, ///< Position sample reference.
    uint16 hours OUT,             ///< UTC hours of the day; range is 0 to 23.
    uint16 minutes OUT,           ///< UTC minutes of the hour; range is 0 to 59.
    uint16 seconds OUT,           ///< UTC seconds of the minute; range is 0 to 59.
    uint16 milliseconds OUT       ///< UTC milliseconds of the second; range is 0 to 999.
);

//--------------------------------------------------------------------------------------------------
/**
 * Enables the Location service with GNSS state per client session.
 *
 * @return
 *  - LE_FAULT         Failed.
 *  - LE_DUPLICATE     The Location service state is already enabled.
 *  - LE_NOT_PERMITTED The Location service state is not initialized.
 *  - LE_OK            Succeeded.
 *
 * @b WARNING: The settings are platform dependent.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Enable
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Starts a GNSS session by triggering engine reports to receive the fixes as per client.
 *
 * @return
 *  - LE_FAULT         Failed.
 *  - LE_DUPLICATE     The Location service state is already started.
 *  - LE_NOT_PERMITTED The Location service state is not initialized or disabled.
 *  - LE_OK            Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Start
(
);

//--------------------------------------------------------------------------------------------------
/**
 * GNSS constellation bitmask used to configure constellations.
 *
 */
//--------------------------------------------------------------------------------------------------
BITMASK ConstellationBitMask
{
    CONSTELLATION_DEFAULT,                  ///< Reset the constellation configuration
                                            ///  to device default,which means constellations
                                            ///  get enabled based on the MBN configuration.
    CONSTELLATION_GPS,                      ///< Global Positioning System constellation.
    CONSTELLATION_GLONASS,                  ///< GLONASS constellation.
    CONSTELLATION_BEIDOU,                   ///< BEIDOU constellation.
    CONSTELLATION_GALILEO,                  ///< GALILEO constellation.
    CONSTELLATION_SBAS,                     ///< SBAS constellation.
    CONSTELLATION_QZSS,                     ///< QZSS constellation.
    CONSTELLATION_NAVIC                     ///< NAVIC constellation.
};

//--------------------------------------------------------------------------------------------------
/**
 * Dilution of precision type.
 */
//--------------------------------------------------------------------------------------------------
ENUM DopType
{
    PDOP,    ///< Position dilution of precision (PDOP).
    HDOP,    ///< Horizontal dilution of precision (HDOP).
    VDOP,    ///< Vertical dilution of precision(VDOP).
    GDOP,    ///< Geometric dilution of precision (GDOP).
    TDOP,    ///< Time dilution of precision (TDOP).
    DOP_LAST
};

//--------------------------------------------------------------------------------------------------
/**
 * Disables the Location service with GNSS state per client session.
 *
 * @return
 *  - LE_FAULT         Failed.
 *  - LE_OK            Succeeded.
 *
 * @b WARNING: The settings are platform dependent.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Disable
(
);

//--------------------------------------------------------------------------------------------------

/**
 * Stops a GNSS session from receiving fixes per client.
 *
 * @return
 *  - LE_FAULT         Failed.
 *  - LE_DUPLICATE     The Location service is already stopped.
 *  - LE_NOT_PERMITTED The Location service state is not initialized or disabled.
 *  - LE_OK            Succeeded.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Stop
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the constellations which need to be blacklisted from being
 * used by the GNSS standard position engine.
 *
 * @return
 *  - LE_FAULT         Failed.
 *  - LE_NOT_PERMITTED The Location service state is not ready or active.
 *  - LE_OK            Succeeded.
 *
 * @b WARNING: Some constellation types are unsupported depending on the platform.
 *
 * @b WARNING: The settings are platform dependent.
 *
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetConstellation
(
    ConstellationBitMask blackListConstellationMask  IN  ///< Bitmask of constellation that needs to be blacklisted.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the constellations that have been blacklisted by the API taf_locGnss_SetConstellation().
 * The API is not persistent after reboots and will return an error if the
 * taf_locGnss_SetConstellation() function is not called again.
 *
 * @return
 *  - LE_OK            Succeeded.
 *  - LE_NOT_PERMITTED The Location service state is not ready or active.
 *  - LE_FAULT         Failed.
 *
 *
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetConstellation
(
    ConstellationBitMask blackListConstellationMask  OUT  ///< Bitmask of constellation that are blacklisted.
);

//--------------------------------------------------------------------------------------------------
/**
 * GNSS constellationArea.
 *
*/
//--------------------------------------------------------------------------------------------------
ENUM ConstellationArea
{
    UNSET_AREA,               ///< Unset area for constellation.
    WORLDWIDE_AREA,           ///< World wide area for constellation.
    OUTSIDE_US_AREA           ///< Outside US area for constellation.
};

//--------------------------------------------------------------------------------------------------
/**
 * Engine states.
 */
//--------------------------------------------------------------------------------------------------
ENUM EngineState
{
    ENGINE_STATE_UNKNOWN,    ///< Unknown engine state.
    ENGINE_STATE_SUSPENDED,  ///< Suspended state.
    ENGINE_STATE_RUNNING     ///< Running State.
};

//--------------------------------------------------------------------------------------------------
/**
 * Engine types.
 */
//--------------------------------------------------------------------------------------------------
ENUM EngineType
{
    ENGINE_TYPE_UNKNOWN,    ///< Unknown engine type.
    ENGINE_TYPE_SPE,        ///< Standard Positioning engine type.
    ENGINE_TYPE_PPE,        ///< Precise Positioning engine type.
    ENGINE_TYPE_DRE,        ///< Dead reckoning engine type.
    ENGINE_TYPE_VPE         ///< Vision positioning engine type.
};

//--------------------------------------------------------------------------------------------------
/**
 * NMEA sentences bitmask indicating the NMEA sentence types enabled.
 *
 * The supported NMEA sentence types depend on the platform.
 *
 * The bitmask values should be coherent with @ref TAF_LOCGNSS_NMEA_SENTENCES_MAX
 */
//--------------------------------------------------------------------------------------------------
BITMASK NmeaBitMask
{
    NMEA_MASK_GPGGA,    ///< GPGGA type enabled -- GPS fix data.Deprecate, use NMEA_MASK_GGA.
                        ///  instead.This is internally mapped to NMEA_MASK_GGA.
    NMEA_MASK_GPRMC,    ///< GPRMC type enabled -- GPS recommended minimum data.
                        ///  Deprecate, use NMEA_MASK_RMC instead.This is internally mapped to
                        ///  NMEA_MASK_RMC.
    NMEA_MASK_GNGSA,    ///< GNGSA type enabled -- GNSS DOP and active satellites.
                        ///  Deprecate, use NMEA_MASK_GSA instead.This is internally mapped to
                        ///  NMEA_MASK_GSA.
    NMEA_MASK_GPVTG,    ///< GPVTG type enabled -- GPS vector track and speed over the ground.
                        ///  Deprecate, use NMEA_MASK_VTG instead.This is internally mapped to
                        ///  NMEA_MASK_VTG
    NMEA_MASK_GPGNS,    ///< GPGNS type enabled -- Fix data for GPS.Deprecate, use NMEA_MASK_GNS.
                        ///  This is internally mapped to NMEA_MASK_GNS.
    NMEA_MASK_GPDTM,    ///< GPDTM type enabled -- Local geodetic datum and datum offset from a
                        ///  reference.Deprecate, use NMEA_MASK_DTM instead.This is internally
                        ///  mapped to NMEA_MASK_DTM.
    NMEA_MASK_GPGSV,    ///< GPGSV type enabled --  GPS satellites in view.
    NMEA_MASK_GLGSV,    ///< GLGSV type enabled --  GLONASS satellites in view.
    NMEA_MASK_GAGSV,    ///< GAGSV type enabled --  Galileo satellites in view.
    NMEA_MASK_GQGSV,    ///< GQGSV type enabled --  NMEA sentence for SVs from QZSS constellation.
    NMEA_MASK_GBGSV,    ///< GBGSV type enabled --  NMEA sentence for SVs from BEIDOU constellation
    NMEA_MASK_GIGSV,    ///< GIGSV type enabled --  NMEA sentence for SVs from NAVIC constellation.
    NMEA_MASK_GPGSA,    ///< Not supported.
    NMEA_MASK_GAGGA,    ///< Not supported.
    NMEA_MASK_GAGSA,    ///< Not supported.
    NMEA_MASK_GARMC,    ///< Not supported.
    NMEA_MASK_GAVTG,    ///< Not supported.
    NMEA_MASK_PSTIS,    ///< Not supported.
    NMEA_MASK_REMOVED,  ///< Not supported.
    NMEA_MASK_PTYPE,    ///< Not supported.
    NMEA_MASK_GPGRS,    ///< Not supported.
    NMEA_MASK_GPGLL,    ///< Not supported.
    NMEA_MASK_DEBUG,    ///< Not supported.
    NMEA_MASK_GAGNS,    ///< Not supported.
    NMEA_MASK_GNGNS,    ///< Not supported.
    NMEA_MASK_GPGST,    ///< Not supported.
    NMEA_MASK_GPZDA,    ///< Not supported.
    NMEA_MASK_GGA,      ///< GGA type enabled -- GNSS fix data.
    NMEA_MASK_RMC,      ///< RMC type enabled -- GNSS recommended minimum data.
    NMEA_MASK_GSA,      ///< GSA type enabled -- GNSS DOP and active satellites.
    NMEA_MASK_VTG,      ///< VTG type enabled -- GNSS vector track and speed over the ground.
    NMEA_MASK_GNS,      ///< GNS type enabled -- Fix data for GNSS.
    NMEA_MASK_DTM       ///< DTM type enabled -- Local geodetic datum and datum offset from a
                        ///  reference.
};

//------------------------------------------------------------------------------------------------
/**
 * Specify the geodetic datum for NMEA sentence types that are generated.
 */
//------------------------------------------------------------------------------------------------
ENUM GeodeticDatumType {
    GEODETIC_TYPE_NONE = -1,  ///< No type.
    GEODETIC_TYPE_WGS_84 = 0, ///< Geodetic datum type to indicate the use of World Geodetic
                              /// System 1984 (WGS84) system.
    GEODETIC_TYPE_PZ_90 = 1   ///< Geodetic datum type to indicate the use of PZ90/GLONASS system.
};

//--------------------------------------------------------------------------------------------------
/**
 * Type of GNSS start.
 */
//--------------------------------------------------------------------------------------------------
ENUM StartMode
{
    HOT_START,         ///< Hot start.
    WARM_START,        ///< Warm start.
    COLD_START,        ///< Cold start.
    FACTORY_START,     ///< Factory start (currently UNSUPPORTED).
    UNKNOWN_START      ///< Unknown start.
};

//--------------------------------------------------------------------------------------------------
/**
 * Type of lever arm.
 */
//--------------------------------------------------------------------------------------------------
ENUM LeverArmType
{
    LEVER_ARM_TYPE_GNSS_TO_VRP = 1,     ///< Vehicle reference point with regard to
                                        ///  the origin(at the GNSS antenna).
    LEVER_ARM_TYPE_DR_IMU_TO_GNSS = 2,  ///< GNSS antenna with regard to the origin at
                                        ///  the IMU for DR Engine.
    LEVER_ARM_TYPE_VPE_IMU_TO_GNSS = 3  ///< GNSS antenna with regard to the origin at
                                        ///  the IMU for VPE.
};

//--------------------------------------------------------------------------------------------------
/**
 * Type of engine.
 */
//--------------------------------------------------------------------------------------------------
ENUM EngineReportsType
{
    ENGINE_REPORT_TYPE_FUSED = 0,   ///< Fused mode supports SPE/DRE/PPE.
    ENGINE_REPORT_TYPE_SPE = 1,     ///< SPE engine type.
    ENGINE_REPORT_TYPE_PPE= 2,      ///< PPE engine type.
    ENGINE_REPORT_TYPE_VPE = 3      ///< VPE engine type.
};

//--------------------------------------------------------------------------------------------------
/**
 * Status of the calibration.
 */
//--------------------------------------------------------------------------------------------------
ENUM CalibrationType {
    DR_ROLL_CALIBRATION_NEEDED,            ///< Indicate that roll calibration is needed.
                                           ///  Need to take more turns on level ground.
    DR_PITCH_CALIBRATION_NEEDED,           ///< Indicate that pitch calibration is needed.
                                           ///  Need to take more turns on level ground.
    DR_YAW_CALIBRATION_NEEDED,             ///< Indicate that yaw calibration is needed.
                                           ///  Need to accelerate in a straight line.
    DR_ODO_CALIBRATION_NEEDED,             ///< Indicate that odo calibration is needed.
                                           ///  Need to accelerate in a straight line.
    DR_GYRO_CALIBRATION_NEEDED,            ///< Indicate that gyro calibration is needed.
                                           ///  Need to take more turns on level ground.
    DR_TURN_CALIBRATION_LOW,               ///< Lot more turns on level ground needed
    DR_TURN_CALIBRATION_MEDIUM,            ///< Some more turns on level ground needed
    DR_TURN_CALIBRATION_HIGH,              ///< Sufficient turns on level ground observed
    DR_LINEAR_ACCEL_CALIBRATION_LOW,       ///< Lot more accelerations in straight line needed
    DR_LINEAR_ACCEL_CALIBRATION_MEDIUM,    ///< Some more accelerations in straight line needed
    DR_LINEAR_ACCEL_CALIBRATION_HIGH,      ///< Sufficient acceleration events in straight line observed
    DR_LINEAR_MOTION_CALIBRATION_LOW,      ///< Lot more motion in straight line needed
    DR_LINEAR_MOTION_CALIBRATION_MEDIUM,   ///< Some more motion in straight line needed
    DR_LINEAR_MOTION_CALIBRATION_HIGH,     ///< Sufficient motion events in straight line observed
    DR_STATIC_CALIBRATION_LOW,             ///< Lot more stationary events on level ground needed
    DR_STATIC_CALIBRATION_MEDIUM,          ///< Some more stationary events on level ground needed
    DR_STATIC_CALIBRATION_HIGH             ///< Sufficient stationary events on level ground observed
};

//--------------------------------------------------------------------------------------------------
/**
 * Status that contributes to the dead reckoning position engine.
 */
//--------------------------------------------------------------------------------------------------
BITMASK drSolutionStatusType {
    VEHICLE_SENSOR_SPEED_INPUT_DETECTED,   ///< Vehicle sensor speed input was detected by
                                           ///< the dead reckoning position engine.
    VEHICLE_SENSOR_SPEED_INPUT_USED,       ///< Vehicle sensor speed input was used by
                                           ///< the dead reckoning position engine.
    WARNING_UNCALIBRATED,                  ///< Dead recokining engine solution disengaged
                                           ///< due to insufficient calibration.
    WARNING_GNSS_QUALITY_INSUFFICIENT,     ///< Dead reckoning engine solution disengaged
                                           ///< due to bad GNSS quality.
    WARNING_FERRY_DETECTED,                ///< Dead reckoning engine solution disengaged
                                           ///< as ferry condition detected.
    ERROR_6DOF_SENSOR_UNAVAILABLE,         ///< Dead reckoning engine solution disengaged
                                           ///< as 6DOF sensor inputs not available.
    ERROR_VEHICLE_SPEED_UNAVAILABLE,       ///< Dead reckoning engine solution disengaged
                                           ///< as vehicle speed inputs not available.
    ERROR_GNSS_EPH_UNAVAILABLE,            ///< Dead reckoning engine solution disengaged
                                           ///< as Ephemeris info not available.
    ERROR_GNSS_MEAS_UNAVAILABLE,           ///< Dead reckoning engine solution disengaged
                                           ///< as GNSS measurement info not available.
    WARNING_INIT_POSITION_INVALID,         ///< Dead reckonign engine solution disengaged due
                                           ///< to non-availability of stored position
                                           ///< from previous session.
    WARNING_INIT_POSITION_UNRELIABLE,      ///< Dead reckoning engine solution disengage due to
                                           ///< vehicle motion detected at session start.
    WARNING_POSITON_UNRELIABLE,            ///< Dead reckoning engine solution disengage due to
                                           ///< unreliable position.
    ERROR_GENERIC,                         ///< Dead reckoning engine solution disengage due
                                           ///< to a generic error.
    WARNING_SENSOR_TEMP_OUT_OF_RANGE,      ///< Dead reckoning engine solution disengage due
                                           ///< to Sensor Temperature being out of range.
    WARNING_USER_DYNAMICS_INSUFFICIENT,    ///< Dead reckoning engine solution disengage due
                                           ///< to insufficient user dynamics.
    WARNING_FACTORY_DATA_INCONSISTENT      ///< Dead reckoning engine solution disengage due
                                           ///< to inconsistent factory data.
};

//--------------------------------------------------------------------------------------------------
/**
 * Type of kinematics data validity.
 */
//--------------------------------------------------------------------------------------------------
ENUM KinematicsDataValidityType {
    HAS_LONG_ACCEL,         ///< Forward acceleration in body frame.
    HAS_LAT_ACCEL,          ///< Sideward acceleration in body frame.
    HAS_VERT_ACCEL,         ///< Vertical acceleration in body frame.
    HAS_YAW_RATE,           ///< Heading rate.
    HAS_PITCH,              ///< Body pitch.
    HAS_LONG_ACCEL_UNC,     ///< Uncertainty of forward acceleration in body frame.
    HAS_LAT_ACCEL_UNC,      ///< Uncertainty of side-ward acceleration in body frame.
    HAS_VERT_ACCEL_UNC,     ///< Uncertainty of vertical acceleration in body frame.
    HAS_YAW_RATE_UNC,       ///< Uncertainty of heading rate.
    HAS_PITCH_UNC,          ///< Uncertainty of body pitch.
    HAS_PITCH_RATE_BIT,     ///< Body pitch rate.
    HAS_PITCH_RATE_UNC_BIT, ///< Uncertainty of pitch rate.
    HAS_ROLL_BIT,           ///< Roll of body frame.
    HAS_ROLL_UNC_BIT,       ///< Uncertainty of roll.
    HAS_ROLL_RATE_BIT,      ///< Roll rate of body frame.
    HAS_ROLL_RATE_UNC_BIT,  ///< Uncertainty of roll rate.
    HAS_YAW_BIT,            ///< Yaw of body frame.
    HAS_YAW_UNC_BIT         ///< Uncertainty of yaw.
};

//--------------------------------------------------------------------------------------------------
/**
 * Type of SBAS correction.
 */
//--------------------------------------------------------------------------------------------------
ENUM SbasBitMask {
    SBAS_CORRECTION_IONO,     ///< Specify whether SBAS ionospheric correction
                              ///  is used.
    SBAS_CORRECTION_FAST,     ///< Specify whether SBAS fast correction is used.
    SBAS_CORRECTION_LONG,     ///< Specify whether SBAS long correction is used.
