policy_module(tafIvssInfoSvc, 1.0)

gen_require(`
  type sysfs_t;
  type systemd_tmpfiles_t;
  type tmp_t;
  type proc_net_t;
  type unreserved_port_t;
  type node_t;
')

# Framework definition for telaf
type telaf_tafIvssInfoSvc_exec_t;
files_type(telaf_tafIvssInfoSvc_exec_t);

type telaf_tafIvssInfoSvc_t;

type telaf_tafIvssInfoSvc_data_t;
files_type(telaf_tafIvssInfoSvc_data_t);

# Run the service in its own confined domain
init_telaf_app_domain(telaf_tafIvssInfoSvc_t,telaf_tafIvssInfoSvc_exec_t)

# Allow update daemon to install/uninstall this service
telaf_admin_manage_all_files_perms(telaf_tafIvssInfoSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafIvssInfoSvc_exec_t)

# Allow systemd to get attribute of /tmp/vsomeip-0
allow systemd_tmpfiles_t tmp_t:sock_file { getattr };

# Allow tafIvssInfoSvc to manipulate dir in tmpfs
allow telaf_tafIvssInfoSvc_t tmp_t:dir manage_dir_perms;

# Allow tafIvssInfoSvc to manipulate file in tmpfs
allow telaf_tafIvssInfoSvc_t tmp_t:file manage_file_perms;

# Allow tafIvssInfoSvc to manipulate sock file in tmpfs
allow telaf_tafIvssInfoSvc_t tmp_t:sock_file manage_sock_file_perms;

# Allow tafIvssInfoSvc to manipulate udp/tcp socket
allow telaf_tafIvssInfoSvc_t self:udp_socket create_socket_perms;
allow telaf_tafIvssInfoSvc_t self:tcp_socket create_stream_socket_perms;

# Allow tafIvssInfoSvc to manipulate netlink_route_socket
allow telaf_tafIvssInfoSvc_t self:netlink_route_socket rw_netlink_socket_perms;

# Allow telaf_tafIvssInfoSvc_t to manipulate capabilites
allow telaf_tafIvssInfoSvc_t self:capability { net_admin };
allow telaf_tafIvssInfoSvc_t self:capability { sys_resource };

# Misc rules for network socket
allow telaf_tafIvssInfoSvc_t proc_net_t:file read_file_perms;
allow telaf_tafIvssInfoSvc_t { unreserved_port_t node_t }:udp_socket { name_bind node_bind };
allow telaf_tafIvssInfoSvc_t { unreserved_port_t node_t }:tcp_socket { name_bind node_bind name_connect };

# Allow telaf_tafIvssInfoSvc_t and telaf_tafSomeipGWSvc_t to connectto unix_stream_socket
telaf_tafSomeipGWSvc_connect(telaf_tafIvssInfoSvc_t)