sandboxed: false

executables:
{
    tafRadioUnitTest = ( $TELAF_ROOT/apps/test/tafRadioTest/tafRadioUnitTest/tafRadioComponent )
}

start: manual

processes:
{
    run:
    {
        (tafRadioUnitTest)
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafRadioUnitTest.tafRadioComponent.taf_radio -> tafRadioSvc.taf_radio
}
