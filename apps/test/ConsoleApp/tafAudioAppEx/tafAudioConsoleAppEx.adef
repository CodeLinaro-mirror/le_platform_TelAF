maxThreads: 600
sandboxed: false

executables:
{
    tafAudioConsoleAppEx =
            ($TELAF_ROOT/apps/test/ConsoleApp/tafAudioAppEx/tafAudioConsoleAppComp)
}

start: manual

processes:
{
    run:
    {
        (tafAudioConsoleAppEx)
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafAudioConsoleAppEx.tafAudioConsoleAppComp.taf_audio -> tafAudioSvc.taf_audio
    tafAudioConsoleAppEx.tafAudioConsoleAppComp.taf_audioVendor -> tafAudioSvc.taf_audioVendor
}
