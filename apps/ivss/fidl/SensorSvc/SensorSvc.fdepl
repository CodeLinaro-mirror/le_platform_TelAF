import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "platform:/plugin/org.genivi.commonapi.core/deployment/CommonAPI-4_deployment_spec.fdepl"
import "SensorSvc.fidl"

define org.genivi.commonapi.core.deployment for typeCollection com.qualcomm.qti.telephony.SensorSvcTypes
{
    enumeration TelephonyResultT
    {
        EnumBackingType = UInt8
    }

    enumeration SensorTypeT
    {
        EnumBackingType = UInt8
    }
}

define org.genivi.commonapi.someip.deployment for interface com.qualcomm.qti.telephony.SensorSvc
{
    SomeIpServiceID = 0xED85

    method GetSensorList
    {
        SomeIpMethodID = 801
    }
}

define org.genivi.commonapi.someip.deployment for provider as Service
{
    instance com.qualcomm.qti.telephony.SensorSvc
    {
        InstanceId = "telephony.SensorSvc"

        SomeIpInstanceID = 1
    }
}