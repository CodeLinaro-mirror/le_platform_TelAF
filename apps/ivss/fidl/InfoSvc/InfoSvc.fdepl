import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "platform:/plugin/org.genivi.commonapi.core/deployment/CommonAPI-4_deployment_spec.fdepl"
import "InfoSvc.fidl"

define org.genivi.commonapi.core.deployment for typeCollection com.qualcomm.qti.telephony.InfoSvcTypes
{
    enumeration TelephonyResultT
    {
        EnumBackingType = UInt8
    }
}

define org.genivi.commonapi.someip.deployment for interface com.qualcomm.qti.telephony.InfoSvc
{
    SomeIpServiceID = 0xED82

    method GetImei
    {
        SomeIpMethodID = 501
    }
}

define org.genivi.commonapi.someip.deployment for provider as Service
{
    instance com.qualcomm.qti.telephony.InfoSvc
    {
        InstanceId = "telephony.InfoSvc"

        SomeIpInstanceID = 1
    }
}