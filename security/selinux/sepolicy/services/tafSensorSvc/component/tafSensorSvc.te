policy_module(tafSensorSvc, 1.0)

# Framework definition for telaf
type telaf_tafSensorSvc_exec_t;
files_type(telaf_tafSensorSvc_exec_t);

type telaf_tafSensorSvc_t;

type telaf_tafSensorSvc_data_t;
files_type(telaf_tafSensorSvc_data_t);

init_telaf_app_domain(telaf_tafSensorSvc_t,telaf_tafSensorSvc_exec_t)

# Allow update daemon to install/uninstall this service
telaf_admin_manage_all_files_perms(telaf_tafSensorSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafSensorSvc_exec_t)

ifdef(`sa525m',`
telux_allow_sensor(telaf_tafSensorSvc_t)
telux_allow_sensor_data_read(telaf_tafSensorSvc_t)
telux_allow_sensor_privileged_ops(telaf_tafSensorSvc_t)
')