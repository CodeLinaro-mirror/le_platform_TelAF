//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafDiagReset Diag Reset Service
 *
 * @rst :ref:`API reference <File taf_diagReset_interface.h>` @endrst
 *
 * <HR>
 *
 * The Reset(0x11) service APIs are part of the diag service. This service requests that the
 * application perform a server reset based on the content of the resetType parameter in the
 * ECUReset request message.
 *
 * @section taf_diagReset_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafDiagSvc platform service.
 *
 * The following example illustrates how to bind to the diag reset service.
 *
 * @verbatim
   bindings:
   {
        clientExe.clientComponent.taf_diagReset -> tafDiagSvc.taf_diagReset
   }
   @endverbatim
 *
 * @section c_taf_diagReset_server_API Server-service APIs
 *
 * A diag reset service reference can be got using taf_diagReset_GetService() with the resetType
 * passed as a parameter. If resetType is equal to 0xFF then application shall do all type of
 * reset requested by client. Use the returned reference for subsequent operations.
 *
 * The following example illustrates how to set up a diag reset server-service-instance.
 *
 * @code
   uint8_t resetType = 0x01;             // Reset type.
   taf_diagReset_ServiceRef_t svcRef;    // Service reference

   // Get the service reference.
   svcRef = taf_diagReset_GetService(resetType);
   LE_ASSERT(svcRef != NULL);
   @endcode
 *
 * @section c_taf_diag_reset_Set_VlanId Set/get VLAN ID
 *
 * After getting a service reference, an application can set the VLAN ID to the service to filter
 * ECU reset requests using taf_diagReset_SetVlanId(). It shall be called before registering the
 * handler for the ECUReset(0x11) request message. An application can get the VLAN ID of the
 * request message using taf_diagReset_GetVlanIdFromMsg().
 *
 * - taf_diagReset_SetVlanId() -- Sets the VLAN ID.
 * - taf_diagReset_GetVlanIdFromMsg() -- Gets the VLAN ID of the request message.
 *
 * @section c_taf_diag_ecu_reset(0x11) Reset service
 *
 * After getting the service reference, an application can call taf_diagReset_AddRxMsgHandler()
 * to register a message handler for that service. Once a diag reset request message is received,
 * the handler will be called with the message reference and received resetType passed as input
 * parameters. The application performs the requested reset operation based on the resetType and
 * uses the message reference to send a response message using taf_diagReset_Send_Resp(). Finally
 * call taf_diagReset_RemoveSvc() to remove the created service.
 *
 * @code
   // Rx message handler function.
   void RxMsgHandler
   (
       taf_diagReset_RxMsgRef_t rxMsgRef,
       uint8_t resetType,
       void* contextPtr
   )
   {
    // Process after succesfully receiving message
   }

   // Register the message handler.
   taf_diagReset_RxMsgHandlerRef_t RxMsgHandlerRef =
       taf_diagReset_AddRxMsgHandler(SvcRef, (taf_diagReset_RxMsgHandlerFunc_t)RxMsgHandler, NULL);
   LE_ASSERT(RxMsgHandlerRef != NULL);

   // To remove the handler function.
   taf_diagReset_RemoveRxMsgHandler(RxMsgHandlerRef);
   @endcode
 *
 * An application can send a response by calling taf_diagReset_SendResp().
 *
 * @code
   le_result_t result = taf_diagReset_SendResp(rxMsgRef, TAF_DIAGRESET_NO_ERROR);
   if (result != LE_OK)
   {
      LE_ERROR("Fail to send response.");
      return result;
   }
   @endcode
 *
 * An application can remove the diag reset server service by calling taf_diagReset_RemoveSvc().
 *
 * @code
   le_result_t result = taf_diagReset_RemoveSvc(svcRef);
   LE_ASSERT(result == LE_OK);
   @endcode
 *
 * <HR>
 *
 */
//-------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * Reset type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Type
{
    HARD_RESET = 0x01,                  ///< Power-on/start-up sequence.
    KEY_OFF_ON_RESET,                   ///< Key-off-on sequence.
    SOFT_RESET,                         ///< Resart application program.
    ENABLE_RAPID_POWER_SHUTDOWN_RESET,  ///< Enable the 'rapid power shut down' function.
    DISABLE_RAPID_POWER_SHUTDOWN_RESET, ///< Disable the 'rapid power shut down' function.
    ALL_RESET = 0xFF                    ///< Include all of the reset types.
};

//--------------------------------------------------------------------------------------------------
/**
 * Error code for Reset.
 */
//--------------------------------------------------------------------------------------------------
ENUM ErrorCode
{
    NO_ERROR = 0,
    BUSY_REPEAT_REQ = 0x21,
    CONDITIONS_NOT_CORRECT = 0x22
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the Reset service.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Service;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the Reset received request message.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE RxMsg;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference to a Reset service, if there's no Reset service, a new one will be created.
 *
 * @return
 *     - Reference to the service instance.
 *     - NULL if not allowed to create the service.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Service GetService
(
    uint8 resetType
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets VLAN ID to the service to filter ECUReset requests.
 * If the VLAN ID is not found or does not existed, it will return an error.
 * This function shall be called before registering RxMsgHandler.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_UNSUPPORTED -- VLAN ID is unknown.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetVlanId
(
    Service svcRef IN,      ///< Service reference.
    uint16 vlanId IN        ///< VLAN ID
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for a Rx Reset message.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RxMsgHandler
(
    RxMsg rxMsgRef  IN,    ///< Received message reference.
    uint8 resetType  IN    ///< Reset type.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on Rx Reset message.
 */
//--------------------------------------------------------------------------------------------------
EVENT RxMsg
(
    Service svcRef IN,      ///< Service reference.
    RxMsgHandler handler    ///< Received message handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN ID of the Rx ECUReset message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- VLAN ID not found.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVlanIdFromMsg
(
    RxMsg rxMsgRef  IN,    ///< Receive message reference.
    uint16 vlanId   OUT    ///< VLAN ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the Rx Reset message.
 *
 * @b NOTE: This function must be called to send a response if receiving a message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendResp
(
    RxMsg rxMsgRef  IN,      ///< Received message reference.
    uint8 errCode  IN        ///< Error code type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes the Reset service.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid svcRef.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveSvc
(
    Service svcRef  IN    ///< Service reference.
);
