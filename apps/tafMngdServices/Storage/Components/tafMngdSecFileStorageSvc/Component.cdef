sources:
{
    tafMngdSecFileStorageImpl.cpp
    tafMngdSecFileStorageSvc.cpp
}

provides:
{
    api:
    {
        $TELAF_ROOT/apps/tafMngdServices/interfaces/staging/taf_mngdStorSecFile.api
    }
}

requires:
{
    api:
    {
        taf_fsc.api
        le_appInfo.api
    }

    component:
    {
        $TELAF_ROOT/components/tafRFSLib
    }
}

cxxflags:
{
    -I$TELAF_ROOT/include
    -I${LEGATO_ROOT}/framework/liblegato
    -I$TELAF_ROOT/include/staging
}

ldflags:
{
   -lssl
   -lcrypto
}