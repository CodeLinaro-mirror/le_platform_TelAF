sources:
{
    tafAudioSvc.cpp
    tafAudioImpl.cpp
    tafAudioVhal.cpp
}

provides:
{
    api:
    {
        taf_audio.api       [manual-start]
        taf_audioVendor.api [manual-start]
    }
}

requires:
{
    api:
    {
        le_cfg.api
        taf_mngdPm.api  [optional]
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        $TELAF_ROOT/components/tafHalComp
    }

    lib:
    {
        lib/libtelux_audio.so
        lib/libtelux_tel.so
    }

}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -ltelux_common
    -ltelux_audio
    -I$TELAF_ROOT/components/tafHalComp
    -I$TELAF_ROOT/include/vhal
    -I$LEGATO_ROOT/components/cfgEntries
}
