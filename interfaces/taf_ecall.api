 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *      - LE_BAD_PARAMETER -- Invalid parameters.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetVIN
(
    string vin[MAX_VIN_LENGTH] IN    ///< Vehicle identification number.
);

/**
 *  Gets the vehicle identification number.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *      - LE_BAD_PARAMETER -- Invalid parameters.
 *
 */
FUNCTION le_result_t GetVIN
(
    string vin[MAX_VIN_BYTES]  OUT    ///< Vehicle identification number as output.
);

//-------------------------------------------------------------------------------------------------
/**
 * Sets the vehicle propulsion storage type.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPropulsionType
(
    PropulsionStorageType propulsionType IN    ///< Vehicle propulsion storage type.
);

//-------------------------------------------------------------------------------------------------
/**
 *  Reads the vehicle propulsion storage type.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPropulsionType
(
    PropulsionStorageType propulsionType OUT    ///< Vehicle propulsion storage type as output.
);

//-------------------------------------------------------------------------------------------------
/**
 *  Sets the MSD transmission mode. The API is not supported on this platform.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *      - LE_UNSUPPORTED -- Not supported.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdTxMode
(
    MsdTransmissionMode mode IN    ///< MSD transmission mode.
);

//-------------------------------------------------------------------------------------------------
/**
 *  Reads the MSD transmission mode. The API is not supported on this platform.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *      - LE_UNSUPPORTED -- Not supported.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMsdTxMode
(
    MsdTransmissionMode mode OUT    ///< MSD transmission mode as output.
);

//-------------------------------------------------------------------------------------------------
/**
 *  Sets the latitude and longitude for MSD transmission.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdPosition
(
    Call  ecallRef   IN,   ///< SIM slot ID.
    bool  isTrusted  IN,   ///< Is trusted or not.
    int32 latitude   IN,   ///< Latitude value in ms.
    int32 longitude  IN,   ///< Longitude value in ms.
    int32 direction  IN    ///< The direction of the vehicle from magnetic north (0
                           ///  to 358, clockwise) in 2-degrees unit. Valid range is
                           ///  0 to 179. If the direction of travel is invalid or
                           ///  unknown, the value 0xFF shall be used.
);

//-------------------------------------------------------------------------------------------------
/**
 * Sets the position delta N-1 for MSD transmission.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdPositionN1
(
    Call  ecallRef   IN,        ///< SIM slot ID.
    int32 latitudeDeltaN1 IN,   ///< First latitude delta.
                                ///< 1 Unit = 100 miliarcseconds, which is approximately 3m
                                ///< maximum value: 511 = 0 0'51.100'' (+- 1580m)
                                ///< minimum value: -512 = -0 0'51.200'' (+- -1583m)
    int32 longitudeDeltaN1 IN   ///< First longitude delta.
                                ///< 1 Unit = 100 miliarcseconds, which is approximately 3m
                                ///< maximum value: 511 = 0 0'51.100'' (+- 1580m)
                                ///< minimum value: -512 = -0 0'51.200'' (+- -1583m)
);

//-------------------------------------------------------------------------------------------------
/**
 * Sets the position delta N-2 for MSD transmission.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdPositionN2
(
    Call  ecallRef   IN,        ///< SIM slot ID.
    int32 latitudeDeltaN2 IN,   ///< Second latitude delta.
                                ///< 1 Unit = 100 miliarcseconds, which is approximately 3m
                                ///< maximum value: 511 = 0 0'51.100'' (+- 1580m)
                                ///< minimum value: -512 = -0 0'51.200'' (+- -1583m)
    int32 longitudeDeltaN2 IN   ///< Second longitude delta.
                                ///< 1 Unit = 100 miliarcseconds, which is approximately 3m
                                ///< maximum value: 511 = 0 0'51.100'' (+- 1580m)
                                ///< minimum value: -512 = -0 0'51.200'' (+- -1583m)
);

//-------------------------------------------------------------------------------------------------
/**
 *  Sets the number of passengers according to the given eCall reference.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdPassengersCount
(
    Call   ecallRef IN,        ///< SIM slot ID.
    uint32 passengersCount IN  ///< Passenger count.
);

//-------------------------------------------------------------------------------------------------
/**
 * Sets the optional additional data for MSD transmission.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdAdditionalData
(
    Call   ecallRef IN,               ///< eCall reference.
    string oid[MAX_OID_LENGTH] IN,    ///< Oid
    uint8  data[MAX_DATA_LENGTH] IN   ///< Data
);


//-------------------------------------------------------------------------------------------------
/**
 * Resets the optional additional data for MSD transmission.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResetMsdAdditionalData
(
    Call  ecallRef IN               ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Sets the location of impact for Euro NCAP additional data.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdEuroNCAPLocationOfImpact
(
    Call  ecallRef IN,               ///< eCall reference.
    IILocations iiLocations IN       ///< Location of impact
);

//-------------------------------------------------------------------------------------------------
/**
 * Sets the rollover detected for Euro NCAP additional data.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdEuroNCAPRolloverDetected
(
    Call  ecallRef IN,               ///< eCall reference.
    bool  rolloverDetected IN        ///< Rollover detected
);

//-------------------------------------------------------------------------------------------------
/**
 * Resets the rollover detected for Euro NCAP additional data.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResetMsdEuroNCAPRolloverDetected
(
    Call  ecallRef IN               ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Sets the IIDeltaV for Euro NCAP additional data.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdEuroNCAPIIDeltaV
(
    Call   ecallRef IN,               ///< eCall reference.
    uint8  rangeLimit IN,             ///< Range limit
    int16  deltaVX IN,                ///< DeltaVX
    int16  deltaVY IN                 ///< DeltaVY
);

//-------------------------------------------------------------------------------------------------
/**
 * Sets the MSD timestamp as the given value according to the given eCall reference.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *      - LE_BUSY -- An eCall session is in progress.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given. This API should be called
 *       before eCall session starts and the same timestamp should be consistently used within
 *       the given incident. The MSD timestamp will be populated using the configured value
 *       during the initial message generation and in all subsequent MSD transmissions within
 *       the given incident.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMsdTimeStamp
(
    Call   ecallRef IN,               ///< eCall reference.
    uint32 timeStamp IN               ///< TimeStamp in unit of seconds.
);

//-------------------------------------------------------------------------------------------------
/**
 * Resets the MSD timestamp to the system time before session start according to the given eCall reference.
 *
 * @return
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_OK -- Succeeded.
 *      - LE_DUPLICATE -- The MSD has already been imported.
 *      - LE_BUSY -- An eCall session is in progress.
 *
 * @b NOTE: The process exits when an invalid eCall reference is given. This API should be called
 *       before eCall session starts and the same timestamp should be consistently used within
 *       the given incident. The eCall service will automatically populate the MSD timestamp with
 *       the current system time of eCall session starts during the initial message generation
 *       and in all subsequent MSD transmissions within the given incident.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResetMsdTimeStamp
(
    Call   ecallRef IN                ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Imports the PDU MSD according to the given eCall reference. The maximum MSD length
 * is 255 bytes for private eCall and 140 bytes for other eCall.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_OVERFLOW -- The size of the MSD buffer is wrong.
 *
 * @b NOTE: The process exits if an invalid eCall reference is passed.
 */
//-------------------------------------------------------------------------------------------------
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t ImportMsd
(
    Call  ecallRef IN,              ///< eCall reference.
    uint8 msd[MAX_MSD_LENGTH] IN    ///< MSD.
);

//-------------------------------------------------------------------------------------------------
/**
 * Exports the PDU MSD according to the given eCall reference.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_OVERFLOW -- The size of the MSD buffer is wrong.
 *      - LE_NOT_FOUND -- The MSD is not found.
 *      - LE_FAULT -- Failed.
 *
 * @b NOTE: The process exits if an invalid eCall reference is passed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t ExportMsd
(
    Call  ecallRef IN,              ///< eCall reference.
    uint8 msd[MAX_MSD_LENGTH] OUT   ///< MSD output.
);

//-------------------------------------------------------------------------------------------------
/**
 *  Updates the eCall MSD in modem to be sent to a Public Safety Answering Point
 * (PSAP) when requested.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendMsd
(
    Call   ecallRef   IN    ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Starts an automatic emergency call with a standard PAN European/KSA/UAE PSAP number(112/911/999)
 * or a voice call with the long PSAP number by taf_ecall_SetPsapNumber() according to the given
 * eCall reference.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_BUSY -- eCall session is already in progress.
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartAutomatic
(
    Call   ecallRef  IN   ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Starts a manual emergency call with a standard PAN European/KSA/UAE PSAP number(112/911/999) or
 * a voice call with the long PSAP number by taf_ecall_SetPsapNumber() according to the given
 * eCall reference.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_BUSY -- eCall session is already in progress.
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartManual
(
    Call ecallRef IN      ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Starts a test eCall with a configured telephone number stored in the USIM or a long PSAP number
 * set by taf_ecall_SetPsapNumber().
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_BUSY -- eCall session is already in progress.
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartTest
(
    Call ecallRef IN      ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Initiates a private eCall.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_BUSY -- eCall session is already in progress.
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *      - LE_FAULT -- Failed.
 *
 * @b NOTE: Currently, only SA525M platform are supported.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartPrivate
(
    Call ecallRef IN,      ///< eCall reference.
    string psap[taf_sim.PHONE_NUM_MAX_LEN] IN,         ///< Public Safely Answering Point number.
    string contentType[CONTENT_TYPE_MAX_LENGTH] IN,    ///< Type of data being transmitted and
                                                       ///  should be filled as per RFC 8147 i.e
                                                       ///  MSD. The maximum length is 128 bytes.
    string acceptInfo[ACCEPT_INFO_MAX_LENGTH]   IN     ///< SIP Accept header. The maximum length
                                                       ///  is 128 bytes.
);

//-------------------------------------------------------------------------------------------------
/**
 *  Ends the ongoing eCall according to the given eCall reference for test purpose.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t End
(
    Call ecallRef IN      ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 *  Answers the incoming eCall according to the given eCall reference.
 *
 * @return
 *      - LE_OK -- Succeeded.
 *      - LE_FAULT -- Failed.
 *      - LE_BAD_PARAMETER -- Bad eCall reference.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t Answer
(
    Call ecallRef IN      ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 *  Gets the currrent eCall state according to the given eCall reference.
 *
 * @return
 *      - The current state of the given eCall.
 *
 * @b NOTE: The process exits if an invalid eCall reference is passed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION State GetState
(
    Call ecallRef IN      ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Gets the current eCall type according to the given eCall reference.
 *
 * @return
 *      - The current type of the given eCall.
 *
 * @b NOTE: Passing a bad or null pointer to this function results in a fatal error and the function
 *       may not return.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION  Type GetType
(
    Call ecallRef IN       ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Gets the platform-specific reason for a recently terminated call according to the given
 * eCall reference.
 *
 * @return
 *      - The platform-specific termination code.
 *
 * @b NOTE: The API is not supported in this platform.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION int32 GetPlatformSpecificTerminationCode
(
    Call ecallRef IN      ///< eCall reference.
);

//-------------------------------------------------------------------------------------------------
/**
 * Gets the end reason for a recently terminated eCall.
 *
 * @return The termination reason.
 *
 * @b NOTE: Passing a bad or null pointer to this function results in a fatal error and the function
 *       may not return.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION TerminationReason GetTerminationReason
(
    Call ecallRef IN        ///< eCall reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the public safely answering point (PSAP) phone number for eCall.
 *
 * @b NOTE: The PSAP number is applicable in manually or automatically dialed eCalls. It is also
 *       applicable to test eCalls that are dialed intentionally for testing, validating,
 *       or certifying.
 *
 * @b WARNING: This function doesn't modify the U/SIM content.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 *
 * @b NOTE: If the PSAP number is empty or too long (max TAF_SIM_PHONE_NUM_MAX_LEN digits), it is a
 *       fatal error and the function will not return.
 */
//--------------------------------------------------------------------------------------------------
 FUNCTION le_result_t SetPsapNumber
 (
     string psap[taf_sim.PHONE_NUM_MAX_LEN] IN ///< Public Safely Answering Point number
 );

//--------------------------------------------------------------------------------------------------
/**
 * Gets the PSAP number set with taf_ecall_SetPsapNumber().
 *
 * @b NOTE: The PSAP number is applicable in manually or automatically dialed eCalls. It is also
 *       applicable to test eCalls that are dialed intentionally for testing, validating,
 *       or certifying.
 *
 * @b WARNING: This function doesn't read the U/SIM content.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed or taf_ecall_SetPsapNumber() has never been called before.
 *  - LE_BAD_PARAMETER -- The PSAP number is null.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPsapNumber
(
    string psap[taf_sim.PHONE_NUM_MAX_LEN] OUT ///< PSAP number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Reads the FDN/SDN numbers from U/SIM to dial a test eCall when the modem is in TAF_ECALL_MODE_ECALL.
 *
 * @b NOTE: If the FDN number is updated with a new number, ensure that the SIM card is refreshed.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UseUSimNumbers
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the eCall deregistration time in NAD. After an emergency call ends
 * the in-vehicle system stays registered with the network for a specific amount of time, defined
 * by the NAD eCall deregistration time.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BUSY -- An eCall session is in progress.
 *  - LE_FAULT -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNadDeregistrationTime
(
    uint16 deregTime IN ///< The eCall deregistration time (in minutes).
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the eCall deregistration time of the NAD.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNadDeregistrationTime
(
    uint16    deregTime  OUT  ///< The eCall deregistration time (in minutes).
);

//--------------------------------------------------------------------------------------------------
/**
 * Disconnects the NAD from the eCall network. After an emergency call ends
 * the in-vehicle system stays registered with the network for a period of time to facilate
 * callback from the PSAP, but when NAD requires to deregister from
 * the network this API can be used.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t TerminateRegistration
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the eCall clear down fallback time of the NAD. If the NAD does not receive a clear
 * down indication from network or a clear down message (AL-ACK) from the PSAP during
 * an ecall, then it will trigger an automatic call end when clear down fallback time out.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BUSY -- An eCall session is in progress.
 *  - LE_FAULT -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNadClearDownFallbackTime
(
    uint16 ccftTime IN ///< The eCall clear down fallback time (in minutes).
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the eCall clear down fallback time of the NAD.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNadClearDownFallbackTime
(
    uint16 ccftTime OUT ///< The eCall clear down fallback time (in minutes).
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the eCall minimum network registration time of the NAD. After an eCall ends, the
 * NAD shall remain registered on the serving network. During this time, the NAD can
 * automatically receive calls from the PSAP.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BUSY -- An eCall session is in progress.
 *  - LE_FAULT -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNadMinNetworkRegistrationTime
(
    uint16 minNwRegTime IN ///< The eCall minimum network registration time (in minutes).
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the eCall minimum network registration time of the NAD.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNadMinNetworkRegistrationTime
(
    uint16 minNwRegTime OUT ///< The eCall minimum network registration time (in minutes).
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the eCall HLAP timer state of the NAD.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 *  - LE_BAD_PARAMETER -- The HLAP timer type is out of range
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetHlapTimerState
(
    HlapTimerType timer IN,          ///<HLAP timer Type.
    HlapTimerStatus timerStatus OUT, ///<The status of the HLAP timer.
    uint16 elapsedTime OUT            ///<The elapsed time of the HLAP timer in unit of seconds.
);

//--------------------------------------------------------------------------------------------------
/**
 * Queries the eCall in progress or not.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t IsInProgress
(
    Call ecallRef IN,       ///< eCall reference.
    bool isInProgress OUT   ///eCall is in progress or not.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the number of dial attempts in case of call initiation failed for Europen regulatory eCall.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 *  - LE_OVERFLOW -- The size of the dial attempt length is wrong.
 *  - LE_BUSY -- An eCall session is in progress.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetInitialDialAttempts
(
    uint8 attempts IN   ///< The number of dial attempts
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the dial interval value between two dial attempts in case of call initiation failed for Europen
 * regulatory eCall.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 *  - LE_BAD_PARAMETER -- Invalid parameters.
 *  - LE_OVERFLOW -- The size of the dial interval length is wrong.
 *  - LE_BUSY -- An eCall session is in progress.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetInitialDialIntervalBetweenDialAttempts
(
    uint16 interval[MAX_DIAL_ATTEMPTS_LENGTH] IN   ///< Interval in unit of seconds.
);
