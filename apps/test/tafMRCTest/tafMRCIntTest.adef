username: telaf
maxThreads: 600
sandboxed: false

maxMemoryBytes: 60000K

executables:
{
    client = ( tafMRCIntTest/client )
    server = ( tafMRCIntTest/server )
}

start: manual

processes:
{
    run:
    {
        (server)
    }
    maxFileBytes: 1048576K
    faultAction: stopApp
}

bindings:
{
    server.server.taf_mrc -> tafMRCSvc.taf_mrc
    client.client.tafMRCIntTest -> server.server.tafMRCIntTest
}
