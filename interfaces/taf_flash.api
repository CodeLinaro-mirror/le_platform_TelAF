//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafFlash Flash Access Service
 *
 * @rst :ref:`API reference <File taf_flash_interface.h>` @endrst
 *
 * <HR>
 *
 * The Flash Access service APIs are applied in Firmware-Over-the-Air (FOTA) to flash MTD partitions
 * or UBI volumes.
 *
 * @section taf_flash_binding IPC interfaces binding
 *
 * All the functions of this API are provided by the @b tafUpdateSvc service.
 *
 * The following sample illustrates how to bind to Flash Access service.
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_flash -> tafUpdateSvc.taf_flash
   }
 *
   @endverbatim
 *
 * @section c_taf_flash_Init Flash access initialization
 *
 * - taf_flash_Init() -- Initiates flash access reference map and memory pool.
 *
 * @section c_taf_flash_Mtd MTD partition Flash Access
 *
 * - taf_flash_MtdOpen() -- Opens MTD partition for read or write.
 *
 * - taf_flash_MtdClose() -- Closes MTD partition.
 *
 * - taf_flash_MtdInformation() -- Gets MTD partition information.
 *
 * - taf_flash_MtdIsBlockGood() -- Checks if an MTD block is good.
 *
 * - taf_flash_MtdEraseBlock() -- Erases an MTD block.
 *
 * - taf_flash_MtdReadPage() -- Reads data from an MTD page.
 *
 * - taf_flash_MtdWritePage() -- Writes the date to an MTD page.
 *
 * The following example illustrates reading an MTD block.
 *
 * @code
 *
   // Open MTD partition.
   taf_flash_MtdOpen(partitionName, TAF_FLASH_READ_WRITE, &partitionRef);

   // Read MTD block.
   taf_flash_MtdReadBlock(partitionRef, blockIndex, data, &dataSize);

   // Close MTD partition.
   taf_flash_MtdClose(partitionRef);
 *
   @endcode
 *
 * @section c_taf_flash_Ubi UBI volume flash access
 *
 * - taf_flash_UbiOpen() -- Opens UBI volume for read or write.
 *
 * - taf_flash_UbiClose() -- Closes UBI volume.
 *
 * - taf_flash_UbiInformation() -- Gets UBI volume information
 *
 * - taf_flash_UbiRead() -- Reads data from UBI volume.
 *
 * - taf_flash_UbiInitWrite() -- Initiates write size of UBI volume.
 *
 * - taf_flash_UbiWrite() -- Writes data to UBI volume.
 *
 * The following example illustrates writing UBI volume.
 *
 * @code
 *
   // Open UBI volume.
   taf_flash_UbiOpen(volumeName, TAF_FLASH_READ_WRITE, &volumeRef);

   // Write UBI volume.
   taf_flash_UbiInitWrite(volumeRef, volumeSize);

   taf_flash_UbiWrite(volumeRef, data, dataSize);

   // Close UBI volume.
   taf_flash_UbiClose(volumeRef);
 *
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Maximum partition name length with null character(s).
 */
//--------------------------------------------------------------------------------------------------
DEFINE PARTITION_NAME_MAX_BYTES = 128;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum byte size for buffer to write data to an MTD page.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MTD_PAGE_MAX_WRITE_SIZE = 4 * 1024;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum byte size for buffer to read data from an MTD page.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MTD_PAGE_MAX_READ_SIZE = 4 * 1024;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum byte size for buffer to read data from MTD partition.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MTD_MAX_READ_SIZE = 16 * 1024;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum byte size for buffer to write data to MTD partition.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MTD_MAX_WRITE_SIZE = 16 * 1024;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum volume name length with null character(s).
 */
//--------------------------------------------------------------------------------------------------
DEFINE VOLUME_NAME_MAX_BYTES = 64;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum volume type length with null character(s).
 */
//--------------------------------------------------------------------------------------------------
DEFINE VOLUME_TYPE_MAX_BYTES = 128;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum byte size for buffer to read data from UBI volume.
 */
//--------------------------------------------------------------------------------------------------
DEFINE UBI_MAX_READ_SIZE = 16 * 1024;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum byte size for buffer to write data to UBI volume.
 */
//--------------------------------------------------------------------------------------------------
DEFINE UBI_MAX_WRITE_SIZE = 16 * 1024;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a partition.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Partition;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a volume.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Volume;

//--------------------------------------------------------------------------------------------------
/**
 * Open mode enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM OpenMode
{
    READ_ONLY = 1, ///< Read-Only mode.
    WRITE_ONLY,    ///< Write-Only mode.
    READ_WRITE     ///< Read and Write mode.
};

//--------------------------------------------------------------------------------------------------
/**
 * Initiates flash access reference map and memory pool.
 *
 * @b NOTE: This function should be called once before calling other flash access APIs.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Init
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Opens an MTD partition for read and write.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdOpen
(
    string partitionName[PARTITION_NAME_MAX_BYTES] IN, ///< MTD partition name.
    OpenMode mode IN,                                  ///< Opening mode.
    Partition partitionRef OUT                         ///< The MTD partition reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Closes an MTD partition.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdClose
(
    Partition partitionRef IN ///< The MTD partition reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets an information about the given MTD partition.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdInformation
(
    Partition partitionRef IN,  ///< The MTD partition reference.
    uint32 blocksNumber OUT,    ///< Total blocks number.
    uint32 badBlocksNumber OUT, ///< Bad blocks number.
    uint32 blockSize OUT,       ///< Block size.
    uint32 pageSize OUT         ///< Page size.
);

//--------------------------------------------------------------------------------------------------
/**
 * Erases an MTD block.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdEraseBlock
(
    Partition partitionRef IN, ///< The MTD partition reference.
    uint32 blockIndex IN       ///< Logical block index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Reads an MTD page.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdReadPage
(
    Partition partitionRef IN,                 ///< The MTD partition reference.
    uint32 pageIndex IN,                       ///< Page index.
    uint8 readData[MTD_PAGE_MAX_READ_SIZE] OUT ///< Buffer read from the MTD page.
);

//--------------------------------------------------------------------------------------------------
/**
 * Writes MTD page.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdWritePage
(
    Partition partitionRef IN,                  ///< The MTD partition reference.
    uint32 pageIndex IN,                        ///< Page index.
    uint8 writeData[MTD_PAGE_MAX_WRITE_SIZE] IN ///< Buffer to be written to the MTD block.
);

//--------------------------------------------------------------------------------------------------
/**
 * Reads an MTD partition.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdRead
(
    Partition partitionRef IN,            ///< The MTD partition reference.
    uint32 offset IN,                     ///< The MTD partition offset.
    uint8 readData[MTD_MAX_READ_SIZE] OUT ///< Buffer read from the MTD page.
);

//--------------------------------------------------------------------------------------------------
/**
 * Writes MTD partition.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdWrite
(
    Partition partitionRef IN,             ///< The MTD partition reference.
    uint32 offset IN,                      ///< The MTD partition offset.
    uint8 writeData[MTD_MAX_WRITE_SIZE] IN ///< Buffer to be written to the MTD block.
);

//--------------------------------------------------------------------------------------------------
/**
 * Erases MTD partition.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t MtdErase
(
    Partition partitionRef IN ///< The MTD partition reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Checks if an MTD block is good.
 *
 * @return
 *  - true -- Good block.
 *  - false -- Bad block.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool MtdIsBlockGood
(
    Partition partitionRef IN, ///< The MTD partition reference.
    uint32 blockIndex IN       ///< Logical block index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Opens UBI volume for read and write.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UbiOpen
(
    string volumeName[VOLUME_NAME_MAX_BYTES] IN, ///< UBI volume name.
    OpenMode mode IN,                            ///< Opening mode.
    Volume volumeRef OUT                         ///< The UBI volume reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Closes UBI volume.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UbiClose
(
    Volume volumeRef IN ///< The UBI volume reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets UBI volume information.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UbiInformation
(
    Volume volumeRef IN,      ///< The UBI volume reference.
    uint32 lebNumber OUT,     ///< Total logical erase blocks number.
    uint32 freeLebNumber OUT, ///< Free logical erase blocks number.
    uint32 volumeSize OUT     ///< Volume size.
);

//--------------------------------------------------------------------------------------------------
/**
 * Reads UBI volume.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UbiRead
(
    Volume volumeRef IN,                  ///< The UBI volume reference.
    uint32 offset IN,                     ///< The UBI volume offset.
    uint8 readData[UBI_MAX_READ_SIZE] OUT ///< Buffer read from UBI volume.
);

/**
 * Initiates write size of UBI volume.
 *
 * @b NOTE: Users should set the number of bytes before subsequent
 *       write operations.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UbiInitWrite
(
    Volume volumeRef IN, ///< The UBI volume reference.
    int64 writeBytes IN  ///< The number of bytes set to write to UBI volume.
);

//--------------------------------------------------------------------------------------------------
/**
 * Writes data to UBI volume.
 *
 * @b NOTE: Users should keep the context of writing UBI volume.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UbiWrite
(
    Volume volumeRef IN,                   ///< The UBI volume reference.
    uint8 writeData[UBI_MAX_WRITE_SIZE] IN ///< Buffer to be written to UBI volume.
);

//--------------------------------------------------------------------------------------------------
/**
 * Erases UBI volume.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UbiErase
(
    Volume volumeRef IN ///< The UBI volume reference.
);
