maxThreads: 300

startGroup: 3

username: telaf

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_BIND_SERVICE
    CAP_NET_ADMIN
    CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
    CAP_DAC_READ_SEARCH
    CAP_DAC_OVERRIDE
#endif
}

groups:
{
    system
    diag
    sensors
    radio
    inet
    locclient
}

executables:
{
    tafImuSensorSvc = ( $TELAF_ROOT/components/tafImuSensorSvc )
}

start: auto

processes:
{
    run:
    {
        (tafImuSensorSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

sandboxed: false

bindings:
{
}
extern:
{
    tafImuSensorSvc.tafImuSensorSvc.taf_imuSensor
}