//-------------------------------------------------------------------------------------------------
/**
 * @page c_tafVerInfo Version Information Service
 *
 * @rst :ref:`API reference <File taf_verInfo_interface.h>` @endrst
 *
 * @rst :ref:`Plugin APIs for hash <File tafPiHash.h>` @endrst
 *
 * @rst :ref:`Plugin APIs for version <File tafPiVersion.h>` @endrst
 *
 * <HR>
 *
 * The Version Information Service can be used to obtain version information (like TelAF)
 * of the software component that runs this service.
 *
 * @section taf_verInfo_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafVerInfoSvc application service.
 *
 * The following example illustrates how to bind to TelAF version information service.
 *
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_verInfo-> tafVerInfoSvc.taf_verInfo
   }
   @endverbatim
 *
 * @section taf_verInfo_GetKernelVersion Get the kernel version
 *
 * - taf_verInfo_GetKernelVersion() -- Gets the kernel version appended with boot version of the
 * device.
 *
 * The following example illustrates how to get the kernel version along with boot version.
 *
 * @code
        char version[TAF_VERINFO_VERSION_MAX_BYTES];
        le_result_t result = taf_verInfo_GetKernelVersion(version, sizeof(version));
        if(result == LE_OK)
        {
            LE_INFO("Kernel version : %s", version);
        }
        else
        {
            LE_ERROR("Get kernel version failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetFirmwareVersion Get the firmware version
 *
 * - taf_verInfo_GetFirmwareVersion() -- Gets the firmware version of device.
 *
 * The following example illustrates how to get the firmware version
 *
 * @code
        char version[TAF_VERINFO_VERSION_MAX_BYTES];
        le_result_t result = taf_verInfo_GetFirmwareVersion(version, sizeof(version));
        if(result == LE_OK)
        {
            LE_INFO("Firmware version: %s", version);
        }
        else
        {
            LE_ERROR("Get firmware version failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetTZVersion Get the TrustZone version
 *
 * - taf_verInfo_GetTZVersion() -- Gets the TZ version of device.
 *
 * The following example illustrates how to get the TZ version of the device
 *
 * @code
        char version[TAF_VERINFO_VERSION_MAX_BYTES];
        le_result_t result = taf_verInfo_GetTZVersion(version, sizeof(version));
        if(result == LE_OK)
        {
            LE_INFO("TZ version: %s", version);
        }
        else
        {
            LE_ERROR("Get TZ version failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetTelafVersion Get the TelAF version
 *
 * - taf_verInfo_GetTelAFVersion() -- Gets the TelAF version.
 *
 * The following example illustrates how to get the TelAF version.
 *
 * @code
        char version[TAF_VERINFO_VERSION_MAX_BYTES];
        le_result_t result = taf_verInfo_GetTelAFVersion(version, sizeof(version));
        if(result == LE_OK)
        {
            LE_INFO("TelAF version: %s", version);
        }
        else
        {
            LE_ERROR("Get TelAF version failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetRootfsVersion Get the root file system version
 *
 * - taf_verInfo_GetRootFSVersion() -- Gets the root file system version.
 *
 * The following example illustrates how to get the root file system version.
 *
 * @code
        char version[TAF_VERINFO_VERSION_MAX_BYTES];
        le_result_t result = taf_verInfo_GetRootFSVersion(version, sizeof(version));
        if(result == LE_OK)
        {
            LE_INFO("RootFS version: %s", version);
        }
        else
        {
            LE_ERROR("Get rootFS version failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetFirmwareHash Get the firmware hash
 *
 * - taf_verInfo_GetFirmwareHash() -- Gets the firmware hash of device.
 *
 * The following example illustrates how to get the firmware hash
 *
 * @code
        char hash[TAF_VERINFO_HASH_MAX_BYTES];
        le_result_t result = taf_verInfo_GetFirmwareHash(hash, sizeof(hash));
        if(result == LE_OK)
        {
            LE_INFO("Firmware hash: %s", hash);
        }
        else
        {
            LE_ERROR("Get Firmware hash failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetTelafHash Get the TelAF hash
 *
 * - taf_verInfo_GetTelAFHash() -- Gets the TelAF hash.
 *
 * The following example illustrates how to get the TelAF hash.
 *
 * @code
        uint8_t hash[TAF_VERINFO_HASH_MAX_BYTES];
        le_result_t result = taf_verInfo_GetTelAFHash(hash, sizeof(hash));
        if(result == LE_OK)
        {
            LE_INFO("TelAF hash: %s", hash);
        }
        else
        {
            LE_ERROR("Get TelAF hash failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetRootfsHash Get the root file system hash
 *
 * - taf_verInfo_GetRootFSHash() -- Gets the root file system hash.
 *
 * The following example illustrates how to get the root file system hash.
 *
 * @code
        uint8_t hash[TAF_VERINFO_HASH_MAX_BYTES];
        le_result_t result = taf_verInfo_GetRootFSHash(hash, sizeof(hash));
        if(result == LE_OK)
        {
            LE_INFO("RootFS hash: %s", hash);
        }
        else
        {
            LE_ERROR("Get rootFS hash failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetBootHash Get the boot hash
 *
 * - taf_verInfo_GetBootHash() -- Gets the boot hash.
 *
 * The following example illustrates how to get the boot hash.
 *
 * @code
        uint8_t hash[TAF_VERINFO_HASH_MAX_BYTES];
        le_result_t result = taf_verInfo_GetBootHash(hash, sizeof(hash));
        if(result == LE_OK)
        {
            LE_INFO("Boot hash: %s", hash);
        }
        else
        {
            LE_ERROR("Get boot hash failed");
        }
   @endcode
 *
 * @section taf_verInfo_GetFirmwareHash Get the firmware hash
 *
 * - taf_verInfo_GetBootHash() -- Gets the firmware hash.
 *
 * The following example illustrates how to get the firmware hash.
 *
 * @code
        uint8_t hash[TAF_VERINFO_HASH_MAX_BYTES];
        le_result_t result = taf_verInfo_GetFirmwareHash(hash, sizeof(hash));
        if(result == LE_OK)
        {
            LE_INFO("Firmware hash: %s", hash);
        }
        else
        {
            LE_ERROR("Get firmware hash failed");
        }
   @endcode
 *
 *
 * <HR>
 *
 */
//------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;


//--------------------------------------------------------------------------------------------------
/**
 * Maximum version length including null termination character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE VERSION_MAX_BYTES = 256;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum hash length including null termination character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE HASH_MAX_BYTES = 256;

//--------------------------------------------------------------------------------------------------
/**
 * Bank enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM Bank
{
    BANK_A,      ///< Bank A in dual system.
    BANK_B,      ///< Bank B in dual system.
    BANK_UNKNOWN ///< Unknown bank.
};

//--------------------------------------------------------------------------------------------------
/**
 * Gets the kernel version.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetKernelVersion
(
    string version[VERSION_MAX_BYTES] OUT    ///< Kernel version
) = 0;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the firmware version.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFirmwareVersion
(
    string version[VERSION_MAX_BYTES] OUT    ///< Firmware version
) = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the TZ version.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTZVersion
(
    string version[VERSION_MAX_BYTES] OUT     ///< TZ version
) = 2;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the TelAF version.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTelAFVersion
(
    string version[VERSION_MAX_BYTES] OUT     ///< TelAF version
) = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the rootFS version.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRootFSVersion
(
    string version[VERSION_MAX_BYTES] OUT     ///< RootFS version
) = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the LXC version.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetLXCVersion
(
    string version[VERSION_MAX_BYTES] OUT     ///< LXC version
) = 5;

//--------------------------------------------------------------------------------------------------
/**
 * Gets TelAF hash.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTelAFHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< TelAF hash
) = 6;

//--------------------------------------------------------------------------------------------------
/**
 * Gets boot hash.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetBootHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< Boot hash
) = 7;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the rootFS hash.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRootFSHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< Rootfs hash
) = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the firmware hash.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFirmwareHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< Firmware hash
) = 9;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the LXC hash.
 *
 * @instaging
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetLXCHash
(
    Bank bank IN,                     ///< Bank
    uint8 hash[HASH_MAX_BYTES] OUT    ///< LXC hash
) = 10;
