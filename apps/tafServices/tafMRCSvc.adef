sandboxed: false

executables:
{
    tafMRCSvc = ( $TELAF_ROOT/components/tafMRCSvc )
}

start: auto

processes:
{
    run:
    {
        (tafMRCSvc)
    }

    faultAction: restart

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
}

extern:
{
    tafMRCSvc.tafMRCSvc.taf_mrc
}
