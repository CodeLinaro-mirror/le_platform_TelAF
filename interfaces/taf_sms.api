//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafsms SMS Service 
 *
 * @ref taf_sms_interface.h "API Reference"
 *
 * <HR>
 *
 * This file contains APIs which can be used to send/receive SMS and access messages from storages.
 * SMS is an easy and fast way to communicate or transmit data between devices in cellular network.
 *
 * @section taf_sms_binding IPC interfaces binding
 *
 * All the functions of this API are provided by the @b tafSMSSvc application service.
 *
 * Here's a sample of how to bind to SMS services:
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_sms -> tafSMSSvc.taf_sms
   }
   @endverbatim
 *
 * @section c_taf_sms_Create Creating a message object
 *
 * Before setting up and sending message via APIs, you need to create a message object by calling taf_sms_Create()
 *
 * - taf_sms_Create() to create a message object
 *
 * @section c_taf_sms_Delete Deleting a message object
 *
 * When a message object is no longer used, call taf_sms_Delete to free the resources and delete the object
 *
 * - taf_sms_Delete() to delete the object
 *
 * @section c_taf_sms_Set Message object parameters configuration
 *
 * - taf_sms_SetDestination() set destination phone number for sending message
 *
 * - taf_sms_SetCallback() set callback function to get result of sending message
 *
 * - taf_sms_SetPhoneId() with dual SIMs in device, set source phone ID for sending message
 *
 * @section c_taf_sms_Set Message content and format configuration
 *
 * There are 3 types of message formats can be assigned, either text messages(7-bit), binary messages(8-bit),
 * or UCS2 messages(16-bit). You can encode message in PDU format directly as well. Message data length is
 * set with these APIs accordingly. For text message, maximum 160 characters is supported. For binary message,
 * maximum 140 bytes is supported. For UCS2 message, maximum 70 characters is supported.
 *
 * - taf_sms_SetText() to set message content as alphabet text
 *
 * - taf_sms_SetBinary() to set message content as binary data
 *
 * - taf_sms_SetUCS2() to set message as UCS2 text
 *
 * - taf_sms_SetPDU() to set message with PDU format
 *
 * Here is the example of creating, setting up and deleting a message object
 *
 * @code

    taf_sms_MsgRef_t    tmpMsg;
    char                text[TAF_SMS_TEXT_BYTES] = {0};

    tmpMsg = taf_sms_Create();

    if(tmpMsg)
    {
        if(taf_sms_SetText(tmpMsg, "test set next") != LE_OK)
        {
            LE_ERROR("set text failed");
        }

        if(taf_sms_SetDestination(tmpMsg, "123456789") != LE_OK)
        {
            LE_ERROR("set destination failed");
        }

        if(taf_sms_SetPhoneId(tmpMsg, 1) != LE_OK);
        {
            LE_ERROR("set phone ID failed");
        }

        taf_sms_Delete(tmpMsg);
    }
    else
    {
        LE_ERROR("tmpMsg is NULL");
    }

 * @endcode
 *
 * @section c_taf_sms_Send Sending a message
 *
 * When message is ready, taf_sms_Send() can be called to send it. taf_sms_Send() is returned with modem
 * feedback, and with maximum 10 seconds timeout.
 *
 * Message object can only be used once for sending, no matter what sending result is, need to be deleted by caller.
 *
 * @section c_taf_sms_Receive Receiving messages
 * To receive incoming messages, register handler function with taf_sms_AddRxMsgHandler() and follow the
 * handler type definition: void (*taf_sms_RxMsgHandlerFunc_t)(taf_sms_MsgRef_t msg)
 *
 * Message object will be created automatically when incoming message is received, the registered handler will be
 * triggered and do further process on the received message.
 *
 * To remove the handler function, call taf_sms_RemoveRxMsgHandler(). Caller have to delete message object
 * when message is no longer needed.
 *
 * @section c_taf_sms_Get Getting content and information of the message object
 *
 * - taf_sms_GetUserdataLen() to get the data length of content
 * - taf_sms_GetText() to get the text content of message
 * - taf_sms_GetUCS2() to get the UCS2 text of message
 * - taf_sms_GetPDU() to get the PDU format of message
 * - taf_sms_GetSendStatus() to get the sending status from TX message
 * - taf_sms_GetReadStatus() to get the read status from RX message
 *
 * @section c_taf_sms_Storage Storage configuration
 * SMS service provides two types of storage to store messages, SIM card and HLOS(high-level OS).
 * HLOS is suggested to use to maintain storage with full-function mechanism, including different type of
 * storage indication, message encryption and storage recycling mechanism.
 *
 * - taf_sms_SetPreferredStorage() to set preferred storage
 * - taf_sms_GetPreferredStorage() to get preferred storage
 *
 * @section c_taf_sms_Storage_Indication Receiving full storage indication
 * To receive storage indication, register handler function with taf_sms_AddFullStorageEventHandler() and follow the
 * handler type definition of @ref taf_sms_FullStorageHandlerFunc_t
 *
 * To remove the handler function, call taf_sms_RemoveFullStorageEventHandler().
 *
 * @section c_taf_sms_RX Manipulating message in storage
 *
 * - taf_sms_DeleteFromStorage() to delete message from its storage location
 * - taf_sms_MarkRead() to mark message status as 'read'
 * - taf_sms_MarkUnread() to mark message status as 'unread'
 *
 * High-level OS storage provides more functions to maintain messsages configurations.
 *
 * - taf_sms_lockFromStorage() to mark message as 'locked' status and the marked message cannot be deleted
 * - taf_sms_unlockFromStorage() to mark message as 'unlocked' status and the marked message available to be deleted
 *
 * @section le_sms_SmsCenter SMS center configuration
 *
 * - taf_sms_GetSmsCenterAddress() to get SMS center address
 * - taf_sms_SetSmsCenterAddress() to set SMS center address
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * SMS center length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  SMSC_ADDR_BYTES = (25);

//--------------------------------------------------------------------------------------------------
/**
 * Time stamp string length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  TIMESTAMP_LEN   = (20);

//--------------------------------------------------------------------------------------------------
/**
 * Time stamp string length (including the null-terminator).
 */
//--------------------------------------------------------------------------------------------------
DEFINE  TIMESTAMP_BYTES = (TIMESTAMP_LEN+1);

//--------------------------------------------------------------------------------------------------
/**
 * The text message length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  TEXT_LEN    = (160);

//--------------------------------------------------------------------------------------------------
/**
 * The text message length (including the null-terminator).
 */
//--------------------------------------------------------------------------------------------------
DEFINE  TEXT_BYTES  = (TEXT_LEN+1);

//--------------------------------------------------------------------------------------------------
/**
 * The binary message length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  BINARY_BYTES  = (140);

//--------------------------------------------------------------------------------------------------
/**
 * The UCS2 message length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  UCS2_BYTES  = (140);

//--------------------------------------------------------------------------------------------------
/**
 * The UCS2 message characters length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  UCS2_CHARS  = (70);

//--------------------------------------------------------------------------------------------------
/**
 * The PDU payload bytes length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  PDU_PAYLOAD = (140);

//--------------------------------------------------------------------------------------------------
/**
 * The PDU message length.
 * 36 bytes heaher.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  PDU_BYTES   = (36+PDU_PAYLOAD);

//--------------------------------------------------------------------------------------------------
/**
 * Message storage type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Storage
{
    STORAGE_NV,      ///< NV storage (not supported).
    STORAGE_SIM,     ///< SIM storage.
    STORAGE_HLOS,    ///< High-level OS storage.
    STORAGE_UNKNOWN, ///< Unknown storage.
};

//--------------------------------------------------------------------------------------------------
/**
 * Full storage indication type.
 *
 * To notify client app with differet storage status, the following notifications will be
 * sent to client with storage full indications
 *
 * When preferred storage is set as HLOS:
 * - FULL_HLOS_ALERT:        means HLOS storage reaches the alert threshold (currently 80%)
 *                           of usage
 * - FULL_HLOS:              means HLOS storage reaches 100% usage, there is no free slot
 * - FULL_HLOS_STORE_TO_SIM: means delivered message is stored to SIM
 * - FULL_BOTH_HLOS_AND_SIM: means both HLOS and SIM storage is run out
 *
 * When preferred storage is set as NV (not supported):
 * - FULL_NV: currently is not supported
 *
 * When preferred storage is set as SIM:
 * - FULL_SIM: means SIM storage is full
 * To notify client app with differet storage status, the following notifications will
 * be sent to client with storage full indications
 * - FULL_STORAGE_HLOS_ALERT: means HLOS storage reaches above 80% usage
 * - FULL_STORAGE_HLOS: means HLOS storage is full, system runs out of all slots
 * - FULL_STORAGE_HLOS_STORE_TO_SIM: means delivered message is stored to SIM
 * - FULL_STORAGE_BOTH_HLOS_AND_SIM: means both HLOS and SIM storage is run out
 * - FULL_STORAGE_NV: currently is not supported
 * - FULL_STORAGE_SIM: means SIM storage is full (when the preferred storage is set as SIM)
*/
//--------------------------------------------------------------------------------------------------
ENUM StorageFullType
{
    FULL_UNKNOWN,           ///< Unknown.
    FULL_HLOS_ALERT,        ///< HLOS storage is going to be full.
    FULL_HLOS,              ///< HLOS storage is full.
    FULL_HLOS_STORE_TO_SIM, ///< HLOS storage is full and message is stored in SIM.
    FULL_BOTH_HLOS_AND_SIM, ///< Both HLOS storage and SIM storage are full.
    FULL_NV,                ///< NV storage is full.
    FULL_SIM                ///< SIM storage is full.
};

//--------------------------------------------------------------------------------------------------
/**
 * Message type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Type
{
    TYPE_TX,     ///< TX message.
    TYPE_RX,     ///< RX message.
    TYPE_UNKNOWN ///< Unknown type.
};

//--------------------------------------------------------------------------------------------------
/**
 * Read status type (for RX message).
 */
//--------------------------------------------------------------------------------------------------
ENUM ReadStatus
{
    RXSTS_READ,   ///< Message is read.
    RXSTS_UNREAD, ///< Message is unread.
    RXSTS_UNKNOWN ///< Unknown status.
};

//--------------------------------------------------------------------------------------------------
/**
 * Send status type (for TX message).
 */
//--------------------------------------------------------------------------------------------------
ENUM SendStatus
{
    TXSTS_UNSENT,          ///< Message is unsent.
    TXSTS_SENDING,         ///< Message is being sent.
    TXSTS_SENT,            ///< Message is sent.
    TXSTS_SENDING_FAILED,  ///< Message is failed to be sent.
    TXSTS_SENDING_TIMEOUT, ///< Message is timeout in sending.
    TXSTS_UNKNOWN          ///< Unknown status.
};

//--------------------------------------------------------------------------------------------------
/**
 * Lock status type (for RX message stored in HLOS).
 */
//--------------------------------------------------------------------------------------------------
ENUM LockStatus
{
    LKSTS_LOCKED,   ///< Locked status.
    LKSTS_UNLOCKED, ///< Unlocked status.
    LKSTS_UNKNOWN   ///< Unknown status.
};

//--------------------------------------------------------------------------------------------------
/**
 * Message format type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Format
{
    FORMAT_TEXT,   ///< Text format.
    FORMAT_BINARY, ///< Binary format.
    FORMAT_UCS2,   ///< UCS2 format.
    FORMAT_PDU,    ///< PDU format.
    FORMAT_UNKNOWN ///< Unknown.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference type for SMS Message objects.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Msg;

//--------------------------------------------------------------------------------------------------
/**
 * Reference type for SMS Message List.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE MsgList;

//--------------------------------------------------------------------------------------------------
/**
 * Create message list for accessing messages.
 * @return
 *      - Reference of the created message list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION MsgList CreateRxMsgList
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Delete message list
 */
//--------------------------------------------------------------------------------------------------
FUNCTION DeleteList
(
    MsgList msgListRef ///< Message list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for sending message
 */
//--------------------------------------------------------------------------------------------------
HANDLER CallbackResult
(
    Msg msgRef,          ///< Message list reference.
    SendStatus status IN ///< Sending status.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for receiving message
 */
//--------------------------------------------------------------------------------------------------
HANDLER RxMsgHandler
(
    Msg  msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event for handler usage
 */
//--------------------------------------------------------------------------------------------------
EVENT RxMsg
(
    RxMsgHandler handler ///< Handler for receiving messages.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for full storage notification
 */
//--------------------------------------------------------------------------------------------------
HANDLER FullStorageHandler
(
    StorageFullType  fullType ///< Full storage indication type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event for information on full storage notification
 */
//--------------------------------------------------------------------------------------------------
EVENT FullStorageEvent
(
    FullStorageHandler handler ///< Handler for full storage indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get first message of list
 * @return
 *      - The first message reference of message list
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Msg GetFirst
(
    MsgList msgListRef ///< Message list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get next message of list
 * @return
 *      - The next message reference from tmp link of the message list
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Msg GetNext
(
    MsgList msgListRef ///< Message list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get send status of message
 * @return
 *      - The sending status of message
 */
//--------------------------------------------------------------------------------------------------
FUNCTION SendStatus GetSendStatus
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get read status of message
 * @return
 *      - The read status of message
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ReadStatus GetReadStatus
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get lock status of message
 * @return
 *      - The lock status of message
 */
//--------------------------------------------------------------------------------------------------
FUNCTION LockStatus GetLockStatus
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Create new message for sending
 * @return
 *      - The reference of created message.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Msg Create
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Set dentination phone number for message
 * @return
 *      - LE_BAD_PARAMETER: Invalid input
 *      - LE_NOT_FOUND: Invalid message
 *      - LE_FAULT: Function failed
 *      - LE_OK: Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDestination
(
    Msg     msgRef,                                       ///< Message reference.
    string  dest[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN ///< Destination number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set text for message
 * @return
 *      - LE_BAD_PARAMETER: Invalid input
 *      - LE_NOT_FOUND: Invalid message
 *      - LE_FAULT: Function failed
 *      - LE_OK: Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetText
(
    Msg     msgRef,           ///< Message reference.
    string  text[TEXT_LEN] IN ///< Text message.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set binary for message
 * @return
 *     - LE_BAD_PARAMETER: Invalid input
 *     - LE_NOT_FOUND: Invalid message
 *     - LE_FAULT: Function failed
 *     - LE_OK: Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetBinary
(
    Msg     msgRef,               ///< Message reference.
    uint8   bin[BINARY_BYTES] IN  ///< Binary data.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set UCS2 for message
 * @return
 *      - LE_BAD_PARAMETER - Invalid input
 *      - LE_NOT_FOUND - Invalid message
 *      - LE_FAULT - Function failed
 *      - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetUCS2
(
    Msg     msgRef,              ///< Message reference.
    uint16  ucs2[UCS2_CHARS] IN  ///< UCS2 message.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set PDU format for message
 * @return
 *      - LE_BAD_PARAMETER - Invalid input
 *      - LE_NOT_FOUND - Invalid message
 *      - LE_FAULT - Function failed
 *      - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPDU
(
    Msg     msgRef,           ///< Message reference.
    uint8   pdu[PDU_BYTES] IN ///< Message in PDU format.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set callback function for message
 * @return
 *      - LE_BAD_PARAMETER - Invalid input
 *      - LE_NOT_FOUND - Invalid message
 *      - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetCallback
(
    Msg     msgRef,        ///< Message reference.
    CallbackResult handler ///< handler for sending message.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set phone ID function for message, phone ID must be 1 or 2 (for DSDA use case)
 * @return
 *      - LE_NOT_FOUND - Invalid message
 *      - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPhoneId
(
    Msg     msgRef,  ///< Message reference.
    uint8   phoneId  ///< phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Delete message from message list, if no message list reference, delete the message from storage
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Delete
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get sender phone number of message
 * @return
 *      - LE_NOT_FOUND - Invalid message
 *      - LE_NOT_PERMITTED - Invalid message type
 *      - LE_FAULT - Invalid input string
 *      - LE_OVERFLOW - String overflow
 *      - LE_OK - Function successful
 */
