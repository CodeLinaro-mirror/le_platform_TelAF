//------------------------------------------------------------------------------------------------
/**
* @page c_tafwlansta Wireless LAN Station Management Service
*
* @ref taf_wlansta_interface.h "API Reference"
*
* <HR>
*
* Wireless LAN(WLAN) Station(STA) Management Service provides APIs for applications to manage
* station that allow the WLAN device to connect to WLAN access points. Before a WLAN
* STA can be started, the WLAN device should be properly configured using the WLAN Management
* Service's APIs.
*
* @section taf_wlansta_binding IPC interfaces binding
*
* The functions of this service are provided by the @b tafWlanSvc application service.
*
 * The following example illustrates how to bind to the WLAN Station service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_wlanSta -> tafWlanSvc.taf_wlanSta
   }
   @endverbatim
 *
*/
//--------------------------------------------------------------------------------------------------
USETYPES taf_wlan.api;
USETYPES taf_net.api;

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA status.
 */
//--------------------------------------------------------------------------------------------------
ENUM State
{
    STATE_UNKNOWN,               ///< Station interface is unknown.
    STATE_CONNECTING ,           ///< Station interface is connecting.
    STATE_CONNECTED,             ///< Station interface is connected.
    STATE_DISCONNECTED,          ///< Station interface is disconnected.
    STATE_ASSOCIATION_FAILED,    ///< Station is unable to associate with AP.
    STATE_IP_ASSIGNMENT_FAILED   ///< Station is unable to get IP address via DHCP.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM Mode
{
    MODE_UNKNOWN=-1,   ///< To skip setting encryption method, pass UNKNOWN.
    MODE_ROUTER,       ///< Router mode.
    MODE_BRIDGE        ///< Bridge mode.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA IP adddress type.
 */
//--------------------------------------------------------------------------------------------------
ENUM IPType
{
    IPTYPE_UNKNOWN=-1,   ///< To skip setting encryption method, pass UNKNOWN.
    IPTYPE_DYNAMIC,      ///< Station is configured with dynamic IP.
    IPTYPE_STATIC        ///< Station is configured with Static IP.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA IP configuration..
 */
//--------------------------------------------------------------------------------------------------
STRUCT IPConfig
{
    string IPv4Addr[taf_net.IPV4_ADDR_MAX_LEN];    ///< IPv4 address to be assigned..
    string GWAddr[taf_net.IPV4_ADDR_MAX_LEN];      ///< IPv4 address of the gateway.
    string DNSAddr[taf_net.IPV4_ADDR_MAX_LEN];     ///< DNS IPv4 address.
    string NetMask[taf_net.IPV4_ADDR_MAX_LEN];     ///< Subnet mask.
};


//--------------------------------------------------------------------------------------------------
/**
 * WLAN STA reference to be used with WLAN STA service functions.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE WlanSTA;

//-------------------------------------------------------------------------------------------------
/*
 * APIs avaiable in WLAN Access Point Management service.
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Starts the specified station.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Start
(
    WlanSTA wlanSTARef   IN     ///< The WLAN STA reference. Reserved for future use.
);

//--------------------------------------------------------------------------------------------------
/**
 * Stops the specified station.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Stop
(
    WlanSTA wlanSTARef   IN     ///< The WLAN STA reference. Reserved for future use.
);

//--------------------------------------------------------------------------------------------------
/**
 * Restarts the specified station.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Restart
(
    WlanSTA wlanSTARef   IN     ///< The WLAN STA reference. Reserved for future use.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the station to Bridged or Router mode.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMode
(
    WlanSTA wlanSTARef   IN,     ///< The WLAN STA reference. Reserved for future use.
    Mode    StaMode      IN      ///< The WLAN STA mode to set.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the station mode.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMode
(
    WlanSTA wlanSTARef   IN,     ///< The WLAN STA reference. Reserved for future use.
    Mode    StaMode      OUT     ///< The WLAN STA mode that is set.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the IP configuration of the station.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetStaticIPConfig
(
    WlanSTA        wlanSTARef         IN,     ///< The WLAN STA reference. Reserved for future use.
    IPConfig       StaIPConfig        IN      ///< IP address to set for static IP address mode.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the IP configuration of the station.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPConfig
(
    WlanSTA        wlanSTARef         IN,     ///< The WLAN STA reference. Reserved for future use.
    IPType         StaIPType          OUT,    ///< Dynamic or Static IP address.
    IPConfig       StaStaticIPConfig  OUT     ///< Details of static IP configuration.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the station state.
 *
 * @return
 * - LE_OK -- Succeeded.
 * - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetStatus
(
    WlanSTA        wlanSTARef              IN, ///< The WLAN STA reference. Reserved for future use.
    State          StaSate                           OUT, ///< Station state.
    string IntfName[taf_net.INTERFACE_NAME_MAX_LEN]  OUT, ///< Assocaited host interface name.
    string IPv4Address[taf_net.IPV4_ADDR_MAX_LEN]    OUT, ///< Assocaited IPv4 address.
    string IPv6Address[taf_net.IPV6_ADDR_MAX_LEN]    OUT, ///< Assocaited IPv6 address.
    string MACAddress[taf_net.MAC_ADDR_MAX_LEN]      OUT  ///< Assocaited MAC address.
);