maxThreads: 600
sandboxed: false
executables:
{
    tafRSimUnitTest = ( tafRSimUnitTestComp )
}


processes:
{
    run:
    {
        (tafRSimUnitTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafRSimUnitTest.tafRSimUnitTestComp.taf_rsim -> tafRemoteSimSvc.taf_rsim
}

