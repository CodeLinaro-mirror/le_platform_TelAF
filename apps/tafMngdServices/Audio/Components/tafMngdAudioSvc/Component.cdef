sources:
{
    tafMngdAudioSvc.cpp
    tafMngdAudioImpl.cpp
    tafMngdAudioVhal.cpp
}

provides:
{
    api:
    {
        $TELAF_ROOT/apps/tafMngdServices/interfaces/staging/taf_mngd_audio.api
        $TELAF_ROOT/apps/tafMngdServices/interfaces/staging/taf_mngd_audioHw.api
    }
}

requires:
{
    api:
    {
        le_cfg.api
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        $TELAF_ROOT/components/tafHalComp
    }

    lib:
    {
        lib/libtelux_audio.so
    }

}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -ltelux_common
    -ltelux_audio
    -I$TELAF_ROOT/components/tafHalComp
    -I$TELAF_ROOT/include/staging/vhal
    -I$LEGATO_ROOT/components/cfgEntries
}