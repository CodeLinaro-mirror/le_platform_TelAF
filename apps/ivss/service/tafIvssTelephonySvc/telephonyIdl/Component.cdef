externalBuild:
{
    "capicxx-core-gen -configuration .capicxx-core-cfg -sk $TELAF_ROOT/apps/ivss/fidl/RadioSvc/RadioSvc.fidl"
    "capicxx-core-gen -configuration .capicxx-core-cfg -sk $TELAF_ROOT/apps/ivss/fidl/RadioSvc/RadioSvc.fdepl"
    "capicxx-someip-gen -configuration .capicxx-someip-cfg $TELAF_ROOT/apps/ivss/fidl/RadioSvc/RadioSvc.fdepl"

    "capicxx-core-gen -configuration .capicxx-core-cfg -sk $TELAF_ROOT/apps/ivss/fidl/SimSvc/SimSvc.fidl"
    "capicxx-core-gen -configuration .capicxx-core-cfg -sk $TELAF_ROOT/apps/ivss/fidl/SimSvc/SimSvc.fdepl"
    "capicxx-someip-gen -configuration .capicxx-someip-cfg $TELAF_ROOT/apps/ivss/fidl/SimSvc/SimSvc.fdepl"

    "capicxx-core-gen -configuration .capicxx-core-cfg -sk $TELAF_ROOT/apps/ivss/fidl/InfoSvc/InfoSvc.fidl"
    "capicxx-core-gen -configuration .capicxx-core-cfg -sk $TELAF_ROOT/apps/ivss/fidl/InfoSvc/InfoSvc.fdepl"
    "capicxx-someip-gen -configuration .capicxx-someip-cfg $TELAF_ROOT/apps/ivss/fidl/InfoSvc/InfoSvc.fdepl"

    "bash $TELAF_ROOT/apps/ivss/common/make.sh Telephony"
}

bundles:
{
    file:
    {
        $BUILDDIR/build/libTelephony-someip.so   /lib/
    }
}

provides:
{
    headerDir:
    {
        $BUILDDIR/src-gen
    }
}
