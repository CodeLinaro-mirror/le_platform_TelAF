maxThreads: 300
groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafMRCSvc = ( $TELAF_ROOT/components/tafMRCSvc )
}

start: auto

processes:
{
    run:
    {
        (tafMRCSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
}

extern:
{
    tafMRCSvc.tafMRCSvc.taf_mrc
}
