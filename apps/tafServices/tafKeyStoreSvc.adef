maxThreads: 600
sandboxed: false

executables:
{
    tafKeyStoreSvc = ( $TELAF_ROOT/components/tafKeyStoreSvc )
    tafFSCryptSvc = ( $TELAF_ROOT/components/tafFSCryptSvc )
}

start: auto

username: telaf

startGroup: 11

capability:
{
        CAP_WAKE_ALARM
        CAP_FOWNER
        CAP_SYS_ADMIN
        CAP_DAC_READ_SEARCH
        CAP_NET_ADMIN
        CAP_DAC_OVERRIDE
        CAP_SYS_PTRACE
}

processes:
{
    run:
    {
        ( tafKeyStoreSvc )
        ( tafFSCryptSvc )
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
    tafKeyStoreSvc.tafKeyStoreSvc.le_appInfo -> <tafcore>.le_appInfo
    tafFSCryptSvc.tafFSCryptSvc.taf_ks -> tafKeyStoreSvc.taf_ks
}

extern:
{
    tafKeyStoreSvc.tafKeyStoreSvc.taf_ks
    tafFSCryptSvc.tafFSCryptSvc.taf_fsc
}
