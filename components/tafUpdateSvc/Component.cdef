provides:
{
    api:
    {
        taf_update.api
        taf_appMgmt.api
        taf_fwupdate.api
    }
}

requires:
{
    api:
    {
        le_update.api

        le_appRemove.api
        le_appCtrl.api
        le_appInfo.api

        le_cfg.api

        taf_mrc.api
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        $TELAF_ROOT/components/stub/taf_lib_flash
        $TELAF_ROOT/components/tafHalComp
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -I$TELAF_ROOT/components/tafHalComp
    -I$TELAF_ROOT/include/staging/plugin
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
}

sources:
{
    tafUpdateSvc.cpp
    tafUpdateImpl.cpp
    tafAppMgmtSvc.cpp
    tafAppMgmtImpl.cpp
    tafFwUpdateSvc.cpp
    tafFwUpdateImpl.cpp
}

bundles:
{
    file:
    {
        [r] tafUpdate.json    /
    }
}
