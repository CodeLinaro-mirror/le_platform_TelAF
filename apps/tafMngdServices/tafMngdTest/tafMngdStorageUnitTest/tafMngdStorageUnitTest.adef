maxThreads: 600
sandboxed: false

executables:
{
    tafMngdSecStorageUnitTest =
            ($TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdStorageUnitTest/tafMngdSecStorageUnitTestComp)

    tafMngdCfgStorageUnitTest =
            ($TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdStorageUnitTest/tafMngdCfgStorageUnitTestComp)
}

start: manual

processes:
{
    run:
    {
        (tafMngdSecStorageUnitTest)
        (tafMngdCfgStorageUnitTest)
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafMngdCfgStorageUnitTest.tafMngdCfgStorageUnitTestComp.taf_mngdStorCfg -> tafMngdStorageSvc.taf_mngdStorCfg
    tafMngdSecStorageUnitTest.tafMngdSecStorageUnitTestComp.taf_mngdStorSecData -> tafMngdStorageSvc.taf_mngdStorSecData
}
