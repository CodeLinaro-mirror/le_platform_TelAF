//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafUpdate Update Service
 *
 * @rst :ref:`API reference <File taf_update_interface.h>` @endrst
 *
 * <HR>
 *
 * The Update Service APIs are designed for over-the-air (OTA) solutions. The OTA package is encapsulated
 * with a QOTA header, which can be uploaded to the cloud server and downloaded to the target device.
 * In a QOTA header, the package can be marked as firmware or application bundle. The Update Service
 * supports installing firmware and applications and it parses the bundle when the OTA package is
 * downloaded on the target device. Users can register a handler to get detailed update progress.
 *
 * @b NOTE: Currently update service does not support firmware and application updates at the same
 *          time. Users should install the OTA package after it's downloaded successfully.
 *
 * @section taf_update_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafUpdateSvc service.
 *
 * The following example illustrates how to bind to the Update Service.
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_update -> tafUpdateSvc.taf_update
   }
 *
   @endverbatim
 *
 * @section c_taf_update_ota_function OTA Functions
 *
 * - taf_update_Download() -- Downloads a package from a cloud server.
 *
 * - taf_update_Install() -- Installs firmware or application on the target device.
 *
 * - taf_update_AddStateHandler() / taf_update_RemoveStateHandler() -- Adds/removes an update states handler.
 *
 *
 * The following example illustrates registering a handler for updated states.
 *
 * Use taf_update_AddStateHandler() to register the handler as a callback for update state and handle
 * the different state when an indication arrives.
 *
 * @code
 *
   void UpdateStateHandler(taf_update_StateInd_t* indication, void* contextPtr)
   {
       switch (indication->state) {
           case TAF_UPDATE_IDLE:

               // Check download consent from user.

               // Start to download.
               taf_update_Download();

               break;
           case TAF_UPDATE_DOWNLOADING:

               // Show download progress.
               LE_INFO("Downloading %d%% .", indication->percent);

               break;
           case TAF_UPDATE_DOWNLOAD_FAIL:

               LE_ERROR("Download fail.");

               break;
           case TAF_UPDATE_DOWNLOAD_SUCCESS:

               // Check install consent from user.

               // Start to install.
               if (indication->ota == TAF_UPDATE_PACKAGE_FOTA) {

                   LE_INFO("Install firmware.");

                   LE_ASSERT(taf_update_Install(TAF_UPDATE_FOTA, indication->name) == LE_OK);

               } else {

                   LE_INFO("Install application.");

                   // Show app name.
                   if (indication->name != NULL) {
                       LE_INFO("App name is %s", indication->name);
                       LE_ASSERT(taf_update_Install(TAF_UPDATE_SOTA, indication->name) == LE_OK);
                   }
               }
               break;
           case TAF_UPDATE_INSTALLING:

               // Show install progress.
               LE_INFO("Installing %d%% .", indication->percent);

               break;
           case TAF_UPDATE_INSTALL_SUCCESS:

               // Reboot to active for firmware upgrade or start app probation.

               break;
           case TAF_UPDATE_PROBATION:

               // Do not perform any OTA operations during probation.

               break;
        }
   }

   // Register handler for update state.
   handlerRef = taf_update_AddStateHandler((taf_update_StateHandlerFunc_t)UpdateStateHandler, NULL);
   LE_ASSERT(handlerRef != NULL);
 *
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Maximum OTA package name length with null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_PKG_NAME_LEN = 48;

//--------------------------------------------------------------------------------------------------
/**
 * File path length with null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE FILE_PATH_LEN = 256;

//--------------------------------------------------------------------------------------------------
/**
 * Session name length with null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE SESSION_NAME_LEN = 32;

//--------------------------------------------------------------------------------------------------
/**
 * Update session reference.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Session;

//--------------------------------------------------------------------------------------------------
/**
 * Update states.
 */
//--------------------------------------------------------------------------------------------------
ENUM State
{
    IDLE,              ///< Idle state; user can download OTA packages.
    DOWNLOADING,       ///< Downloading state, user can query download progress.
    DOWNLOAD_PAUSED,   ///< Download paused state, not supported.
    DOWNLOAD_SUCCESS,  ///< Download success state, OTA package downloaded successfully.
    DOWNLOAD_FAIL,     ///< Download fail state, user can retry the download.
    INSTALLING,        ///< Installing state, user can query installation progress.
    INSTALL_SUCCESS,   ///< Install success state, user can reboot to active if firmware installed
                       ///  or start probation if app installed.
    INSTALL_FAIL,      ///< Install fail state, update service drives to idle state later.
    PROBATION,         ///< Probation state, during probation, update service checks if newly installed
                       ///  firmware or app is stable and drives to idle state later.
    PROBATION_SUCCESS, ///< Probation success state, application or firmware is working properly
                       ///  without errors.
    PROBATION_FAIL,    ///< Probation fail state, update service drives to idle state later.
    ROLLBACK,          ///< Rollback state, rollback to the original system.
    ROLLBACK_SUCCESS,  ///< Rollback success state, rollback to the original system succeeded.
    ROLLBACK_FAIL,     ///< Rollback fail state, rollback to the original system failed.
    SYNCHRONIZING,     ///< Bank synchronization is ongoing.
    SYNC_SUCCESS,      ///< Bank synchronization is successful.
    SYNC_PAUSED,       ///< Bank synchronization is paused.
    SYNC_FAIL,         ///< Bank synchronization is failed.
    REPORTING          ///< Reporting state, update service is reporting state to server.
};

//--------------------------------------------------------------------------------------------------
/**
 * Error codes.
 */
//--------------------------------------------------------------------------------------------------
ENUM Error
{
    NONE,              ///< No errors.
    BAD_PACKAGE,       ///< Bad package.
    INTERNAL_ERROR,    ///< Internal error.
    SECURITY_FAILURE,  ///< Security check failure.
    PACKAGE_NOT_FOUND, ///< Package not found.
    APP_NOT_RUNNING,   ///< App is not in running state.
    IMAGE_NOT_VERFIED  ///< Image not verifed.
};

//--------------------------------------------------------------------------------------------------
/**
 * OTA workflows.
 */
//--------------------------------------------------------------------------------------------------
ENUM OTA
{
    FOTA,    ///< Firmware update workflow.
    SOTA,    ///< Application update workflow.
    NON_QOTA ///< Not QOTA workflow.
};

//--------------------------------------------------------------------------------------------------
/**
 * Update package type.
 */
//--------------------------------------------------------------------------------------------------
ENUM PackageType
{
    PACKAGE_TYPE_QOTA_PACKAGE, ///< Package with QOTA header.
    PACKAGE_TYPE_NAD_ZIP,      ///< Zip file for NAD update.
    PACKAGE_TYPE_TELAF_APP,    ///< TelAF app bundle.
    PACKAGE_TYPE_UAPI_PACKAGE, ///< Package for UA Plug-In update.
    PACKAGE_TYPE_UNKNOWN       ///< Unknown package.
};

//--------------------------------------------------------------------------------------------------
/**
 * Bank enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM Bank
{
    BANK_A,      ///< Bank A in dual system.
    BANK_B,      ///< Bank B in dual system.
    BANK_UNKNOWN ///< Unknown bank.
};

//--------------------------------------------------------------------------------------------------
/**
 * Update state indication structure.
 */
//--------------------------------------------------------------------------------------------------
STRUCT StateInd
{
    State state;                   ///< Update state.
    Error error;                   ///< Error in update progress.
    uint32 percent;                ///< Percentage of progress.
    OTA ota;                       ///< OTA workflow.
    string name[SESSION_NAME_LEN]; ///< Session name.
};

//--------------------------------------------------------------------------------------------------
/**
 * Handler for update state.
 */
//--------------------------------------------------------------------------------------------------
HANDLER StateHandler
(
    StateInd stateInd IN ///< Update state indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report update progress.
 */
//--------------------------------------------------------------------------------------------------
EVENT State
(
    StateHandler handler ///< Handler for update state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Downloads an OTA package from a cloud server.
 *
 * @b NOTE: Update service will parse the download package and remove the QOTA header once the download
         is complete.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Download
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Installs an OTA package on the target device.
 *
 * @b NOTE: QOTA header should be removed before calling this API.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Install
(
    OTA ota IN,                      ///< OTA workflow.
    string name[MAX_PKG_NAME_LEN] IN ///< OTA package name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets download session.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDownloadSession
(
    string cfgFile[FILE_PATH_LEN] IN, ///< Configuration file for download session.
    Session session OUT               ///< Download session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Starts download.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartDownload
(
    Session session IN ///< Download session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Pauses download.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t PauseDownload
(
    Session session IN ///< Download session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Resumes download.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResumeDownload
(
    Session session IN ///< Download session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Cancels download.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CancelDownload
(
    Session session IN ///< Download session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets installation session.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInstallationSession
(
    PackageType pkgType IN,           ///< Package type for installation.
    string cfgFile[FILE_PATH_LEN] IN, ///< Configuration file for installation session.
    Session session OUT               ///< Installation session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Checks prerequisites for installation.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t InstallPreCheck
(
    Session session IN,               ///< Installation session reference.
    string manifest[FILE_PATH_LEN] IN ///< Manifest for pre-check.
);

//--------------------------------------------------------------------------------------------------
/**
 * Start installation.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartInstall
(
    Session session IN,              ///< Installation session reference.
    string pkgPath[FILE_PATH_LEN] IN ///< Package path.
);

//--------------------------------------------------------------------------------------------------
/**
 * Verification post installation, check if flashing properly on inactive bank.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t InstallPostCheck
(
    Session session IN ///< Installation session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the active bank.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetActiveBank
(
    Session session IN, ///< Installation session reference.
    Bank bank OUT       ///< The active bank.
);

//--------------------------------------------------------------------------------------------------
/**
 * Erases a bank.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 * - LE_UNSUPPORTED -- Unsupported.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t EraseBank
(
    Session session IN, ///< Installation session reference.
    Bank bank IN        ///< The bank to be erased.
);

//--------------------------------------------------------------------------------------------------
/**
 * Activation verification, check if each component has the updated version.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t VerifyActivation
(
    Session session IN,               ///< Installation session reference.
    string manifest[FILE_PATH_LEN] IN ///< Manifest for activation verification.
);

//--------------------------------------------------------------------------------------------------
/**
 * Rollback to previous configurations to keep pesistency.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Rollback
(
    Session session IN ///< Installation session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Bank synchronization.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Sync
(
    Session session IN ///< Installation session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Starts AB sync.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartSync
(
    Session session IN ///< Sync session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Pauses AB sync.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t PauseSync
(
    Session session IN ///< Sync session reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Resumes AB sync.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResumeSync
(
    Session session IN ///< Sync session reference.
);
