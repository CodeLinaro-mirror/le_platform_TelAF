maxThreads: 300

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

executables:
{
        tafLocationSvc = ( $TELAF_ROOT/components/tafLocationSvc )
}

start: auto

processes:
{
        run:
        {
            (tafLocationSvc)
        }

        maxFileBytes: 8192K
        faultAction: restart
}

sandboxed: false

bindings:
{
}

extern:
{
        tafLocationSvc.tafLocationSvc.taf_gnss
        tafLocationSvc.tafLocationSvc.taf_pos
        tafLocationSvc.tafLocationSvc.taf_posCtrl
}
