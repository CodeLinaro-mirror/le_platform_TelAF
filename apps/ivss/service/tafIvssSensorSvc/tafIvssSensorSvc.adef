maxThreads: 600
sandboxed: false

start: manual

username: telaf
startGroup: 22

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_RAW
    CAP_IPC_LOCK
    CAP_SYS_NICE
    CAP_SYS_RESOURCE
    CAP_NET_ADMIN
    CAP_DAC_OVERRIDE
#if ${LE_CONFIG_TEST_COVERAGE} = y
    CAP_DAC_READ_SEARCH
#endif
}

executables:
{
    tafIvssSensorSvc = ( sensorSvc )
}

processes:
{
    envVars:
    {
        VSOMEIP_CONFIGURATION = vsomeipRef.json
        COMMONAPI_CONFIG = commonapiRef.ini
    }

    run:
    {
        ( tafIvssSensorSvc )
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
    // IMU sensor service binding (accelerometer/gyroscope data)
    tafIvssSensorSvc.sensorSvc.taf_imuSensor -> tafImuSensorSvc.taf_imuSensor

    // GNSS position service binding (heading sensor, body frame yaw from DR engine)
    tafIvssSensorSvc.sensorSvc.taf_locGnss -> tafLocationSvc.taf_locGnss

    // Note: GPTP timestamps use tafGptpLibrary to read /dev/ptp0 directly
}
