maxThreads: 600

username: telaf

startGroup: 0

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafRadioSvc = ( tafRadioSvc )
}

start: auto

processes:
{
    run:
    {
        (tafRadioSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

extern:
{
    tafRadioSvc.tafRadioSvc.taf_radio
}
