sandboxed: false

executables:
{
    tafSmsUnitTest = ( tafSmsUnitTest )
}

start: manual

processes:
{
    run:
    {
        (tafSmsUnitTest)
    }

    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafSmsUnitTest.tafSmsUnitTest.taf_sms -> tafSMSSvc.taf_sms
}
