//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

USETYPES taf_dcs.api;

//--------------------------------------------------------------------------------------------------
/**
 * Start a permanent synchronous data cellular session by given profile reference
 *
 * @returns LE_OK                           Succeeded to make a data call.
 *          LE_NOT_FOUND                    Parameter is invalid or can't create a data call
 *          LE_OUT_OF_RANGE                 PdpType type is unknown.
 *          LE_BUSY                         Profile is in using
 *          LE_TIMEOUT                      Timeout to make a data call
 *          LE_FAULT                        Failed to make a data call.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartSession
(
    taf_dcs.Profile profileRef                  IN ///< The taf_dcs profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Start a permanent asynchronous data cellular session by given profile reference
 *
 * @returns LE_OK                           Succeeded to make a data call.
 *          LE_NOT_FOUND                    Parameter is invalid or can't create a data call
 *          LE_OUT_OF_RANGE                 PdpType type is unknown.
 *          LE_BUSY                         Profile is in using
 *          LE_TIMEOUT                      Timeout to make a data call
 *          LE_FAULT                        Failed to make a data call.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartSessionAsync
(
    taf_dcs.Profile profileRef                  IN ///< The taf_dcs profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Synchronously stop a permanent data cellular session by given profile reference
 *
 * @returns LE_OK                           Succeeded to stop a data call.
 *          LE_NOT_FOUND                    Can't find a data call.
 *          LE_OUT_OF_RANGE                 PdpType type is unknown.
 *          LE_BAD_PARAMETER                Call context is NULL.
 *          LE_TIMEOUT                      Timeout to stop a data call.
 *          LE_FAULT                        Failed to stop a data call.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StopSession
(
    taf_dcs.Profile profileRef                  IN ///< The taf_dcs profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Asynchronously stop a permanent data cellular session by given profile reference
 *
 * @returns LE_OK                           Succeeded to stop a data call.
 *          LE_NOT_FOUND                    Can't find a data call.
 *          LE_OUT_OF_RANGE                 PdpType type is unknown.
 *          LE_BAD_PARAMETER                Call context is NULL.
 *          LE_TIMEOUT                      Timeout to stop a data call.
 *          LE_FAULT                        Failed to stop a data call.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StopSessionAsync
(
    taf_dcs.Profile profileRef                  IN ///< The taf_dcs profile reference.
);
