menu "TelAF"

### "Hidden" Options ###
config PLATFORM_COMMON_OPTION
  bool
  default n

config TELAF_VERSION
  string "TelAF Version"
  default "$(TELAF_VERSION)" if !$(empty,$(TELAF_VERSION))
  default "telaf.lnx.1.1-xxxxxx"

config AUDIO_MULTI_FORMAT_PB_SUPPORTED
  bool "TelAF multi format playback supported"
  default $(b2k,$(def,$(TELUX_AUDIO_MULTI_FORMAT_PB_SUPPORTED),y))

config REFRESH_AUDIO_SVC
  bool "Telaf refresh audio service enabled"
  default "$(b2k,$(REFRESH_AUDIO_SVC))" if !$(empty,$(REFRESH_AUDIO_SVC))
  default n

menu "apps"
rsource "apps/KConfig"
endmenu # end "apps"

menu "components"
rsource "components/KConfig"
endmenu # end "components"

menu "framework"
rsource "framework/daemons/linux/deviceManager/KConfig"
endmenu # end "framework"

menu "simulation"
rsource "simulation/simulation.kconfig"
endmenu # end "simulation"

endmenu # end "TelAF"
