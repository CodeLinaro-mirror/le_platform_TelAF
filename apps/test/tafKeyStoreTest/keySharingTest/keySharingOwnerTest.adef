username: telaf
sandboxed: false
start: manual
executables:
{
    keySharingOwner = (keyOwnerComp)
}

processes:
{
    run:
    {
        (keySharingOwner)
    }
}

extern:
{
    cryptPrinter = keySharingOwner.keyOwnerComp.cryptPrinter
}

bindings:
{
    keySharingOwner.keyOwnerComp.taf_ks -> tafKeyStoreSvc.taf_ks
}
