//--------------------------------------------------------------------------------------------------
// TelSDK sa525m system definition that includes essential services.
//--------------------------------------------------------------------------------------------------

#include "$LEGATO_ROOT/legatoTargetConfig.sinc"

apps:
{
    // Sample Applications
    //$LEGATO_ROOT/apps/sample/helloWorld/helloWorld.adef

    // Platform Services
    $TELAF_ROOT/apps/tafServices/tafSomeipGWSvc

    // RPC proxy
    $TELAF_ROOT/apps/rpc/rpcProxy/tafRpcProxy

#if ${LE_CONFIG_ENABLE_PVM_LXC_RPC_LATENCY_TEST} = y
    $TELAF_ROOT/apps/rpc/pvm_lxc_test/rpcLatancyClientTest
#endif

    // eCall Application
    $TELAF_ROOT/apps/sample/eCallDemo/tafECallAppLxc.adef
    $TELAF_ROOT/apps/reference/eCallApp/tafECallRefAppLxc.adef
}

commands:
{
    ecallctl = tafECallRefAppLxc:/bin/ecallctl
}

bindings:
{
    <telaf>.sdirTool -> <tafcore>.sdirTool
}

interfaceSearch:
{
    $TELAF_ROOT/interfaces
    $TELAF_ROOT/interfaces/someipGW
    $TELAF_ROOT/apps/tafMngdServices/interfaces
    $TELAF_ROOT/apps/reference/eCallApp
#if ${LE_CONFIG_ENABLE_PVM_LXC_RPC_LATENCY_TEST} = y
    $TELAF_ROOT/apps/rpc/pvm_lxc_test/
#endif
}

cflags:
{
    -DTARGET_SA525M
}

cxxflags:
{
    -DTARGET_SA525M
}
