//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafpm Power Management Service
 *
 * @rst :ref:`API reference <File taf_pm_interface.h>` @endrst
 *
 * <HR>
 *
 * Components need access to the TelAF Power Manager to control the system's wake-up state.
 * Operations that need fast response times (e.g., maintaining call state or playing/recording a
 * media stream) result in high interrupt rates; keeping the system awake results in better
 * performance and power efficiency.
 *
 * TelAF Power Manager keeps the system awake when at least one of the registered components
 * requests a wakeup source to be held. When all wakeup sources are released, the system may enter a
 * suspend state depending on the status of other (unrelated) wakeup sources.
 *
 * @section taf_pm_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafPMSvc application service.
 *
 * The following example illustrates how to bind to PM services.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_pm -> tafPMSvc.taf_pm
   }
   @endverbatim
 *
 * @section taf_pm_request Requesting and releasing a wakeup source
 *
 * TelAF Power Manager service provides basic APIs for requesting and releasing a wakeup source.
 * TelAF Power Manager's clients call taf_pm_NewWakeupSource() to create a wakeup source. This
 * function returns a @ref taf_pm_WakeupSourceRef_t type that can later be used to acquire and
 * release a wakeup source through taf_pm_StayAwake() and taf_pm_Relax(), respectively. Wakeup
 * sources are not reference-counted, which means multiple calls to taf_pm_StayAwake() can be canceled
 * by a single call to taf_pm_Relax().
 *
 * To have a reference-counted wakeup-source, set the TAF_PM_REF_COUNT bit in the opts argument.
 * When this bit is set, each taf_pm_StayAwake() increments a counter and multiple calls to
 * taf_pm_Relax() are necessary to release the wakeup source.
 * @verbatim
   char tag[10];

   snprintf(tag, sizeof(tag), "testpm");
   taf_pm_WakeupSourceRef_t ref = taf_pm_NewWakeupSource(1, tag);

   for(int i = 0; i < 5; i++) {
       tafPMTest_acquire(ref);
   }
   for(int i = 0; i < 5; i++) {
       tafPMTest_release(ref);
   }
   @endverbatim
 *
 * TelAF Power Manager service will automatically release and delete all wakeup sources held on.
 * behalf of an exiting or disconnecting client.
 *
 * Use the StateChange to register a notification callback function to be called before device state
 * triggers.
 * @verbatim
   stateChangehandlerRef = taf_pm_AddStateChangeHandler(TestStateChangeHandler, NULL);
   @endverbatim
 *
 * Use the StateChangeEx to register a notification callback function to be called for every state
 * change trigger.
 * @verbatim
   handlerExRef = taf_pm_AddStateChangeExHandler(TestStateChangeExHandler, NULL);
   @endverbatim
 *
 * @section taf_pm_getMachineList Get available Virtual Machines
 *
 * TelAF Power Manager Service provides APIs to know the available machines on the device.
 * TelAF Power Manager's client calls taf_pm_GetMachineList() to get the machine available reference.
 * This function returns a @ref taf_pm_VMListRef_t that can be later used to get the name of each
 * machine, and also to delete the list reference using taf_pm_DeleteMachineList().
 * @verbatim
   taf_pm_VMListRef_t vmListRef = taf_pm_GetMachineList( );
   char name[32] = {0};
   if(!vmListRef) {
       LE_ERROR("List is null");
   }
   le_result_t res = taf_pm_GetFirstMachineName(vmListRef, name, 32);
   while(res == LE_OK)
   {
       LE_INFO("vm name : %s",name);
       res = taf_pm_GetNextMachineName(vmListRef, name, 32);
   }
   res = taf_pm_DeleteMachineList(vmListRef);
   @endverbatim
 *
 * @section taf_pm_SendStateChangeAck State change acknowledgement notification
 *
 * TelAF Power Manager Service should know the acknowledgement of clients to proceed
 * with the state change.
 * TelAF Power Manager's client calls taf_pm_SendStateChangeAck()
 * to send the acknowledgement for state change.
 * @verbatim
   taf_pm_SendStateChangeAck(powerStateRef, state, TAF_PM_PVM, TAF_PM_READY);
   @endverbatim
 *
 * <HR>
 *
 */
//-------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Maximum string length for a wake-up source tag (not including the null-terminator).
 */
//--------------------------------------------------------------------------------------------------
DEFINE TAG_LEN = 31;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum string length for a wake-up source tag (including the null-terminator).
 */
//--------------------------------------------------------------------------------------------------
DEFINE TAG_LEN_BYTES = TAG_LEN + 1;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum string length for the Virtual Machine name.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MACHINE_NAME_LEN = 32;

//--------------------------------------------------------------------------------------------------
/**
 * Option TAF_PM_REF_COUNT to manage a reference counted wakeup source.
 */
//--------------------------------------------------------------------------------------------------
DEFINE REF_COUNT = 1;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum string length for the client name (not including the null-terminator).
 */
//--------------------------------------------------------------------------------------------------
DEFINE CLNT_NAME_LEN = 31;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum client count for nack or unresponsive clients for consolidated state ack information.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_CLIENT_NUMBER = 20;

//--------------------------------------------------------------------------------------------------
/**
 * System power states.
 */
//--------------------------------------------------------------------------------------------------
ENUM State
{
    STATE_UNKNOWN,                ///< System state is unknown.
    STATE_RESUME,                 ///< System state is resume.
    STATE_SUSPEND,                ///< System state is suspend.
    STATE_SHUTDOWN,               ///< System state is shutdown.
    STATE_RESTART,                ///< System state is restart.
    STATE_ALL_ACKED,              ///< State all clients ACKed.
                                  ///< @b NOTE: This is an internal state between MPMS and PMS.
    STATE_ALL_WAKELOCKS_RELEASED  ///< State all wakelocks released.
                                  ///< @b NOTE: This is an internal state between MPMS and PMS.
};

//--------------------------------------------------------------------------------------------------
/**
 * API processing status codes.
 */
//--------------------------------------------------------------------------------------------------
ENUM Status
{
    SUCCESS,         ///< API processing succeeded.
    FAILED,          ///< API processing failed.
    EXPIRED          ///< Expired.
};

//--------------------------------------------------------------------------------------------------
/**
 * Virtual  Machine ID .
 */
//--------------------------------------------------------------------------------------------------
ENUM NadVm
{
    PVM       ///< Client acknowledged.
};

//--------------------------------------------------------------------------------------------------
/**
 * State change registered clients acknowledgement.
 */
//--------------------------------------------------------------------------------------------------
ENUM ClientAck
{
    READY,           ///< Client acknowledged.
    NOT_READY       ///< Client not acknowledged.
};

//--------------------------------------------------------------------------------------------------
/**
 * System power mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM PowerMode
{
    POWER_MODE_NORMAL,       ///< Normal power mode.
    POWER_MODE_LOW_POWER     ///< Low power mode.
                             ///< Under this mode, wake sources acquired from MPMS only accepted.
};

//--------------------------------------------------------------------------------------------------
/**
 * Bit mask for modem wakeup selection.
 */
//--------------------------------------------------------------------------------------------------
BITMASK NodeModemWsBitMask
{
    NODE_MODEM_WS_BIT_MASK_SMS,        ///< Node Modem Wake Source bit mask for received SMS.
    NODE_MODEM_WS_BIT_MASK_VOICE_CALL, ///< Node Modem Wake Source bit mask for incoming voice call.
    NODE_MODEM_WS_BIT_MASK_REMOTE_SIM_PROFILE_SWAP, ///< Node Modem Wake Source bit mask for remote
                                                    ///< sim profile swapped based SIM refresh
                                                    ///< indication wake up.
    NODE_MODEM_WS_BIT_MASK_NAS_SYS_INFO, ///< Node Modem Wake Source bit mask for NAS system information.
    NODE_MODEM_WS_BIT_MASK_RESERVED_4,   ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_5,   ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_6,   ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_7,   ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_8,   ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_9,   ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_10,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_11,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_12,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_13,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_14,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_15,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_16,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_17,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_18,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_19,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_20,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_21,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_22,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_23,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_24,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_25,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_26,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_27,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_28,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_29,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_30,  ///< Node Modem Wake Source bit mask Reserved.
    NODE_MODEM_WS_BIT_MASK_RESERVED_31   ///< Node Modem Wake Source bit mask Reserved.
};


//--------------------------------------------------------------------------------------------------
/**
 * The struct for the client information.
 */
//--------------------------------------------------------------------------------------------------
STRUCT ClientInfo
{
    string clientName[CLNT_NAME_LEN];
    string machineName[CLNT_NAME_LEN];
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the PowerState.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE PowerState;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to consolidated acknowledgement notification of state change.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE ConsolidatedAckInfo;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to modem wakeup event.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE ModemAwakeEvent;

//--------------------------------------------------------------------------------------------------
/**
 * State change handler.
 */
//--------------------------------------------------------------------------------------------------
HANDLER StateChangeHandler
(
    State state IN  ///< The system state.
);

//--------------------------------------------------------------------------------------------------
/**
 * TCU state change event of the local process.
 */
//--------------------------------------------------------------------------------------------------
EVENT StateChange
(
    StateChangeHandler handler  ///< The state change handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * StateChangeEx change handler.
 *
 * @b NOTE: This is supported only on SA525M.
 */
//--------------------------------------------------------------------------------------------------
HANDLER StateChangeExHandler
(
    PowerState powerStateRef IN,   ///< PowerstateRef for StateChangeExHandler.
    NadVm vm IN,                   ///<The VM ID of the machine.
    State state IN                 ///< The system state.
);

//--------------------------------------------------------------------------------------------------
/**
 * TCU state change event of the local process.
 *
 * @b NOTE: This is supported only on SA525M.
 */
//--------------------------------------------------------------------------------------------------
EVENT StateChangeEx
(
    StateChangeExHandler handler  ///< The PmMasterWake source change handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Reference to wakeup source used by StayAwake and Relax functions.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE WakeupSource;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the list of Virtual Machines.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VMList;

//--------------------------------------------------------------------------------------------------
/**
 * State change ConsolidatedAck Info handler.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
HANDLER ConsolidatedAckInfoHandler
(
    ConsolidatedAckInfo consolidatedAckInfoRef IN,           ///< The reference of the consolidated
                                                             ///< acknowledgement information.
    bool isAllAcked IN,                                      ///< Is all clients acked.
    State state IN                                           ///< The acknowledged PM state.
);

//--------------------------------------------------------------------------------------------------
/**
 * ConsolidatedAckInfo event.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
EVENT ConsolidatedAckInfo
(
    ConsolidatedAckInfoHandler handler  ///< The ConsolidatedAck Info handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for modem awake.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
HANDLER ModemAwakeHandler
(
    ModemAwakeEvent ref,
    NodeModemWsBitMask wsBitmask
);

//--------------------------------------------------------------------------------------------------
/**
 * Modem awake event.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
EVENT ModemAwake
(
    ModemAwakeHandler handler,  ///< The modem awake event handler.
    NodeModemWsBitMask wsBitmask
);

//--------------------------------------------------------------------------------------------------
/**
 * Creates a new wakeup source.
 *
 * @return
 *      - Reference to wakeup source (to be used later for acquiring/releasing).
 *      - Null when attempt failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION WakeupSource NewWakeupSource
(
    uint32 createOpts IN,       ///< Wakeup source options.
    string wsTag[TAG_LEN] IN    ///< Context-specific wakeup source tag.
);

//--------------------------------------------------------------------------------------------------
/**
 * Acquires a passed wakeup source reference.
 *
 * @return
 *     - LE_OK             Wakeup source successfully acquired.
 *     - LE_BAD_PARAMETER  Invalid wakeup source reference.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StayAwake
(
    WakeupSource wsRef IN      ///< Reference to the wakeup source to be acquired.
);

//--------------------------------------------------------------------------------------------------
/**
 * Releases a previously acquired wakeup source.
 *
 * @return
 *     - LE_OK             Wakeup source successfully released.
 *     - LE_BAD_PARAMETER  Invalid wakeup source reference.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Relax
(
    WakeupSource wsRef IN     ///< Reference to the wakeup source to be released.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the current system state of the local process.
 *
 * @return
 * State of the system.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION State GetPowerState
(
);

//--------------------------------------------------------------------------------------------------
/**
* Sets the power state to all the Virtual Machines.
*
* @b NOTE: This is supported only on SA525M.
*
* @instaging
* @return
*     - LE_OK          Successfully changed the state of device.
*     - LE_FAULT       Failed.
*

*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAllVMPowerState
(
    State   state IN                         ///< State to be set.
);

//--------------------------------------------------------------------------------------------------
/**
* Sets the power state to the respective Virtual Machine.
*
* @b NOTE: This is supported only on SA525M.
*
* @instaging
* @return
*     - LE_OK          Successfully changed the state of Virtual Machine.
*     - LE_FAULT       Failed.
*

*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetVMPowerState
(
    State   state IN,                         ///< State to be set.
    string  machineName[MACHINE_NAME_LEN]  IN ///< Virtual Machine name of the state to be changed.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the list of available Virtual Machines.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 * @return
 *     - non-null pointer -- The Virtual Machines List reference.
 *     - null pointer -- Internal error.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VMList GetMachineList
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the first Virtual Machine name.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- Empty list.
 *
 * @b NOTE: This is supported only on SA525M.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFirstMachineName
(
    VMList vmListRef IN,                  ///< Virtual Machine list reference.
    string name[MACHINE_NAME_LEN] OUT     ///< The name of the Virtual Machine.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the next Virtual Machine name based on the current position in the list.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Bad parameters.
 *     - LE_NOT_FOUND -- The end of the list.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNextMachineName
(
    VMList vmListRef IN,                  ///< Virtual Machine list reference.
    string name[MACHINE_NAME_LEN] OUT     ///< The name of the Virtual Machine.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Deletes the Vitual Machine list.
 *
 * @instaging
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_OK -- Succeeded.
 *
 * @b NOTE: This is supported only on SA525M.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteMachineList
(
    VMList vmLsitRef IN                  ///< Virtual Machine list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Receives the acknowledgement from clients for state change.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION SendStateChangeAck
(
    PowerState powerStateRef IN,  ///< Power state reference for statechangehandler.
    State state IN,               ///< The system state.
    NadVm vm IN,                  ///< The VM ID of the machine.
    ClientAck ack IN              ///< The acknowledgement type.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the information of nacked clients for a state change.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNackClientInfo
(
    ConsolidatedAckInfo consolidatedAckInfoRef IN,           ///< The reference of the consolidated
                                                             ///< acknowledgement information.
    ClientInfo nackClients[MAX_CLIENT_NUMBER] OUT            ///< The nacked clients.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the information of unresponsive clients for a state change.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetUnrespClientInfo
(
    ConsolidatedAckInfo consolidatedAckInfoRef IN,           ///< The reference of the consolidated
                                                             ///< acknowledgement information.
    ClientInfo unrespClients[MAX_CLIENT_NUMBER] OUT          ///< The unresponsive clients.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Sets the power mode to facilitate the system level power management.
 *
 * @b NOTE: This is supported only on SA525M.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPowerMode
(
    PowerMode powerMode     ///< to set system power mode when BUB status has changed.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the whitelisted modem wakeup selection.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetModemWakeupSel
(
    NodeModemWsBitMask wsBitmask     ///< Modem wakeup selection to be whitelisted.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the whitelisted modem wakeup selection.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetModemWakeupSel
(
    NodeModemWsBitMask wsBitmask OUT     ///< Modem wakeup selection to be whitelisted.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the last modem wakeup reason.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetModemAwakeReason
(
    NodeModemWsBitMask wsBitmask OUT     ///< Modem wakeup reason.
);