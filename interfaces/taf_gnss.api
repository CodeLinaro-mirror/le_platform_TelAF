REFERENCE Sample;

DEFINE SV_INFO_MAX_LEN = 80;

/**
 * Define the maximal degree for the minimal elevation
 */
DEFINE MIN_ELEVATION_MAX_DEGREE = 90;

/**
 * Enumeration for GNSS device state
 */
ENUM State
{
    STATE_UNINITIALIZED,
    STATE_READY,
    STATE_ACTIVE,
    STATE_DISABLED,
    STATE_MAX
};

/**
 *  GNSS constellation type.
 */
ENUM Constellation
{
    SV_CONSTELLATION_UNDEFINED,
    SV_CONSTELLATION_GPS,
    SV_CONSTELLATION_SBAS,
    SV_CONSTELLATION_GLONASS,
    SV_CONSTELLATION_GALILEO,
    SV_CONSTELLATION_BEIDOU,
    SV_CONSTELLATION_QZSS,
    SV_CONSTELLATION_MAX
};

/**
 *  GNSS fix position states.
 */
ENUM FixState
{
    STATE_FIX_NO_POS,
    STATE_FIX_2D,
    STATE_FIX_3D,
    STATE_FIX_ESTIMATED
};

/**
 * Handler for position information.
 *
 */
HANDLER PositionHandler
(
 Sample positionSampleRef
);

/**
 * This event provides information on position.
 *
 */
EVENT Position
(
 PositionHandler handler
);

/**
 *  Resolutions values.
 */
ENUM Resolution
{
    RES_ZERO_DECIMAL,
    RES_ONE_DECIMAL,
    RES_TWO_DECIMAL,
    RES_THREE_DECIMAL,
    RES_UNKNOWN
};

/**
 * This function gets the last updated position sample object reference.
 *
 */
FUNCTION Sample GetLastSampleRef
(
);

/**
 * This function gets the position sample's fix state
 *
 */
FUNCTION le_result_t GetPositionState
(
 Sample   positionSampleRef IN,
 FixState state OUT
);

/**
 * This function must be called to release the position sample.
 *
 */
FUNCTION ReleaseSampleRef
(
 Sample positionSampleRef IN
);

/**
*  Data types.
*/
ENUM DataType
{
   DATA_VACCURACY,
   DATA_VSPEEDACCURACY,
   DATA_HSPEEDACCURACY,
   DATA_UNKNOWN
};

/**
 * Get the location's data (Latitude, Longitude, Horizontal accuracy).
 *
 */
FUNCTION le_result_t GetLocation
(
 Sample positionSampleRef IN,
 int32 latitude OUT,
 int32 longitude OUT,
 int32 hAccuracy OUT
);

/**
 * Get the position sample's direction. Direction of movement is the direction that the vehicle or
 * person is actually moving.
 *
 */
FUNCTION le_result_t GetDirection
(
 Sample  positionSampleRef IN,
 uint32  direction OUT,
 uint32  directionAccuracy OUT
);

/**
 * Get the position sample's altitude.
 *
 */
FUNCTION le_result_t GetAltitude
(
 Sample positionSampleRef  IN,
 int32 altitude OUT,
 int32 vAccuracy OUT
);

/**
 * Get the position sample's horizontal speed.
 *
  */
FUNCTION le_result_t GetHorizontalSpeed
(
 Sample positionSampleRef IN,
 uint32 hspeed OUT,
 uint32 hspeedAccuracy OUT
);

/**
 * Get the position sample's vertical speed.
 *
*/
FUNCTION le_result_t GetVerticalSpeed
(
 Sample positionSampleRef IN,
 int32  vspeed OUT,
 int32  vspeedAccuracy OUT
);

/**
 * Get the position sample's UTC leap seconds in advance
 *
*/
FUNCTION le_result_t  GetGpsLeapSeconds
(
 Sample positionSampleRef  IN,
 uint8  leapSeconds OUT
);

/**
 * Get the position sample's date.
 *
*/
FUNCTION le_result_t GetDate
(
 Sample positionSampleRef IN,
 uint16 year OUT,
 uint16 month OUT,
 uint16 day OUT
);

/**
 * Get the position sample's time.
 *
*/
FUNCTION le_result_t GetTime
(
 Sample positionSampleRef  IN,
 uint16 hours OUT,
 uint16 minutes OUT,
 uint16 seconds OUT,
 uint16 milliseconds OUT
);

/**
 * This function enables the GNSS device.
 *
*/
FUNCTION le_result_t Enable
(
);

/**
 * This function starts the GNSS device.
 *
*/
FUNCTION le_result_t Start
(
);

/**
 * GNSS constellation Bit Mask (8 bits) indicating the GNSS constellation(s)
 * used in solution.
 *
 */
BITMASK ConstellationBitMask
{
    CONSTELLATION_GPS,
    CONSTELLATION_GLONASS,
    CONSTELLATION_BEIDOU,
    CONSTELLATION_GALILEO,
    CONSTELLATION_SBAS,
    CONSTELLATION_QZSS
};

/**
 * Assisted-GNSS mode
 */
ENUM AssistedMode
{
    STANDALONE_MODE,
    MS_BASED_MODE,
    MS_ASSISTED_MODE
};

/**
 * Dilution of precision type
 */
ENUM DopType
{
    PDOP,
    HDOP,
    VDOP,
    GDOP,
    TDOP,
    DOP_LAST
};

/**
 * This function disable the GNSS device.
 *
*/
FUNCTION le_result_t Disable
(
);

/**
 * This function stops the GNSS device.
 *
*/
FUNCTION le_result_t Stop
(
);

/**
 * Set the GNSS constellation bit mask
 *
*/
FUNCTION le_result_t SetConstellation
(
 ConstellationBitMask constellationMask      IN
);

/**
 * Get the GNSS constellation bit mask
 *
*/
FUNCTION le_result_t GetConstellation
(
 ConstellationBitMask constellationMask  OUT
);

/**
 * GNSS constellationArea
 *
*/
ENUM ConstellationArea
{
    UNSET_AREA,
    WORLDWIDE_AREA,
    OUTSIDE_US_AREA
};

/**
 * Set the area for the GNSS constellation
 *
*/
FUNCTION le_result_t SetConstellationArea
(
Constellation satConstellation        IN,
ConstellationArea constellationArea   IN
);

/**
 * This function returns the status of the GNSS device.
 *
 */
FUNCTION State GetState
(
);

/**
 * Get the Satellites Vehicle status.
 *
*/
FUNCTION le_result_t GetSatellitesStatus
(
 Sample        positionSampleRef IN,
 uint8         satsInViewCount OUT,
 uint8         satsTrackingCount OUT,
 uint8         satsUsedCount OUT
);

/**
 * This function gets the GNSS device acquisition rate.
 *
*/
FUNCTION le_result_t GetAcquisitionRate
(
 uint32 rate      OUT
);

/**
 * Get the area for the GNSS constellation
 *
*/
FUNCTION le_result_t GetConstellationArea
(
 Constellation satConstellation        IN,
 ConstellationArea constellationArea   OUT
);

/**
 * Get the TTFF in milliseconds
 *
*/
FUNCTION le_result_t GetTtff
(
 uint32 ttff                     OUT
);

/**
 * Get the Satellites Vehicle information.
 *
*/
FUNCTION le_result_t GetSatellitesInfo
(
 Sample        positionSampleRef IN,
 uint16        satId[SV_INFO_MAX_LEN] OUT,
 Constellation satConst[SV_INFO_MAX_LEN] OUT,
 bool          satUsed[SV_INFO_MAX_LEN] OUT,
 uint8         satSnr[SV_INFO_MAX_LEN] OUT,
 uint16        satAzim[SV_INFO_MAX_LEN] OUT,
 uint8         satElev[SV_INFO_MAX_LEN] OUT
);

FUNCTION le_result_t GetTimeAccuracy
(
    Sample positionSampleRef  IN,
    uint32 timeAccuracy OUT
);

FUNCTION le_result_t GetEpochTime
(
    Sample positionSampleRef  IN,
    uint64 milliseconds OUT
);

FUNCTION le_result_t SetDopResolution
(
    Resolution resolution    IN
);

FUNCTION le_result_t GetDilutionOfPrecision
(
    Sample positionSampleRef IN,
    DopType dopType IN,
    uint16 dop OUT
);

FUNCTION le_result_t GetLeapSeconds
(
    uint64 gpsTime OUT,
    int32 currentLeapSeconds OUT,
    uint64 changeEventTime OUT,
    int32  nextLeapSeconds OUT
);

FUNCTION le_result_t GetGpsTime
(
    Sample positionSampleRef  IN,
    uint32 gpsWeek OUT,
    uint32 gpsTimeOfWeek OUT
);

FUNCTION le_result_t SetAcquisitionRate
(
    uint32  rate  IN
);

FUNCTION le_result_t ForceWarmRestart
(
);

FUNCTION le_result_t ForceColdRestart
(
);

FUNCTION le_result_t ForceFactoryRestart
(
);

FUNCTION le_result_t ForceHotRestart
(
);

FUNCTION le_result_t GetSupportedConstellations
(
 ConstellationBitMask constellationMask  OUT
);

FUNCTION le_result_t SetMinElevation
(
 uint8 minElevation IN
);

FUNCTION le_result_t GetMinElevation
(
 uint8  minElevationPtr OUT
);
