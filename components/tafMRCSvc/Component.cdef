provides:
{
    api:
    {
        taf_mrc.api
    }
}

requires:
{
    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        $TELAF_ROOT/components/stub/taf_pa_mrc
        $TELAF_ROOT/components/stub/taf_prop_hms
    }

    lib:
    {
        lib/libtelux_platform.so
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -I$TELAF_ROOT/components/stub/taf_pa_mrc
    -I$TELAF_ROOT/components/stub/taf_prop_hms
    -ltelux_platform
}

sources:
{
    tafMrcSvc.cpp
    tafMrcImpl.cpp
}

