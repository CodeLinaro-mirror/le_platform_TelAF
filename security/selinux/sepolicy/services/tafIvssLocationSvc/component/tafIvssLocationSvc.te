policy_module(tafIvssLocationSvc, 1.0)

gen_require(`
  type systemd_tmpfiles_t;
  type tmp_t;
')

# Framework definition for telaf
type telaf_tafIvssLocationSvc_exec_t;
files_type(telaf_tafIvssLocationSvc_exec_t);

type telaf_tafIvssLocationSvc_t;

type telaf_tafIvssLocationSvc_data_t;
files_type(telaf_tafIvssLocationSvc_data_t);

# Run the service in its own confined domain
init_telaf_app_domain(telaf_tafIvssLocationSvc_t,telaf_tafIvssLocationSvc_exec_t)

# Allow service to manage its own data directory; registers with admin domain.
telaf_manage_app_data_files(telaf_tafIvssLocationSvc_t, telaf_tafIvssLocationSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafIvssLocationSvc_exec_t)

# vsomeip network stack: TCP/UDP, netlink, port binding, net_admin, /proc/net.
telaf_use_vsomeip_network(telaf_tafIvssLocationSvc_t)

# sys_resource: allow raising RLIMIT_NOFILE for vsomeip connection pool.
allow telaf_tafIvssLocationSvc_t self:capability { sys_resource };

# Generic /tmp access for vsomeip runtime scratch files.
allow telaf_tafIvssLocationSvc_t tmp_t:dir manage_dir_perms;
allow telaf_tafIvssLocationSvc_t tmp_t:file manage_file_perms;
allow telaf_tafIvssLocationSvc_t tmp_t:sock_file manage_sock_file_perms;

# Allow systemd to inspect /tmp/vsomeip-* socket files.
allow systemd_tmpfiles_t tmp_t:sock_file { getattr };

# Allow telaf_tafIvssLocationSvc_t and telaf_tafSomeipGWSvc_t connect to each other
telaf_tafSomeipGWSvc_connect(telaf_tafIvssLocationSvc_t)

# Allow telaf_tafIvssLocationSvc_t and telaf_tafSomeipGWSvc_t write to each other
telaf_tafSomeipGWSvc_write(telaf_tafIvssLocationSvc_t)