policy_module(telaf, 1.0)

########################################
#
# Declarations
#

## <desc>
## <p>
## Boolean to determine whether external dependencies should be added here
## </p>
## </desc>
gen_bool(telaf_external_dependencies,true)

gen_require(`
  type adbd_t;
  type alogd_t;
  type cgroup_t;
  type debugfs_t;
  type default_context_t;
  type default_t;
  type devlog_t;
  type diag_device_t;
  type dnsmasq_t;
  type etc_t;
  type file_context_t;
  type fixed_disk_device_t;
  type fs_t;
  type http_cache_port_t;
  type ipacm_t;
  type ld_so_cache_t;
  type ldconfig_tmp_t;
  type loc_hald_t;
  type loc_t;
  type loc_etc_t;
  type mnt_t;
  type mount_t;
  type mss_t;
  type node_t;
  type proc_net_t;
  type proc_t;
  type qcmap_cm_t;
  type setfiles_t;
  type loc_socket_t;
  type sysfs_t;
  type syslogd_t;
  type system_dbusd_t;
  type systemd_tmpfiles_t;
  type tftp_server_t;
  type tmpfs_t;
  type tracefs_t;
  type udev_t;
  type var_lock_t;
  type urandom_device_t;
  type var_run_t;
  type init_var_run_t;
  type systemd_resolved_var_run_t;
  type http_port_t;
  type semanage_store_t;
  type semanage_trans_lock_t;
  type var_lib_t;
  type load_policy_exec_t;
  type selinux_config_t;
  type semanage_read_lock_t;
  type security_t;
  type policy_config_t;
  type qcmap_etc_data_t;
  type mount_exec_t;
  type mount_runtime_t;
  type kmsg_device_t;
  type initctl_t;
  type systemd_logind_var_run_t;
  type getty_t;
  type null_device_t;
  type zero_device_t;
  type user_tty_device_t;
  type watchdog_device_t;
  type socket_device_t;
  type persist_t;
  type home_root_t;
  type user_home_dir_t;
  type ping_exec_t;
  type dlt_t;
  type coredump_data_t;
  type pmsg_device_t;
')

########################################
# TelAF framework type declarations
#
# This section declares the framework-wide attributes and file types shared by
# all TelAF services.  Per-service domains are declared in their own modules.
########################################

# Three trust tiers used by TelAF services.
attribute telaf_app_domain;
attribute telaf_core_domain;
attribute telaf_admin_domain;

# Generic executable attribute used by per-service exec types.
attribute telaf_app_exec_attr;

# TelAF framework root and shared runtime file types.
type telaf_fw_t;
files_type(telaf_fw_t);

type telaf_app_bundle_t;
files_type(telaf_app_bundle_t)

type telaf_app_exec_t;
files_type(telaf_app_exec_t)

type telaf_sys_t;
files_type(telaf_sys_t);

type telaf_bin_t;
files_type(telaf_bin_t);

type telaf_lib_t;
files_type(telaf_lib_t);

type telaf_app_rw_t;
files_type(telaf_app_rw_t);

type telaf_app_ro_t;
files_type(telaf_app_ro_t);

type telaf_mod_t;
files_type(telaf_mod_t);

########################################
# Built-in TelAF domains
#
# These are the framework-owned processes started directly by supervisor.
########################################

# Supervisor / admin domain.
type telaf_admin_t;
type telaf_admin_exec_t;
files_type(telaf_admin_exec_t);
init_telaf_admin_domain(telaf_admin_t, telaf_admin_exec_t)

# Log control daemon.
type telaf_logd_t;
type telaf_logd_exec_t;
files_type(telaf_logd_exec_t);
init_telaf_core_domain(telaf_logd_t, telaf_logd_exec_t)
# logCtrlDaemon receives the read end of all app/core stdout/stderr pipes from supervisor
# (via logFd_StdOut/logFd_StdErr in proc.c SendStdPipeToLogDaemon). These pipes are
# labeled telaf_admin_t:fifo_file, so logd needs read access in addition to the write
# access already granted by init_telaf_core_domain().
allow telaf_logd_t telaf_admin_t:fifo_file { read };

# Service directory (TelAF IPC broker).
type telaf_sdir_t;
type telaf_sdir_exec_t;
files_type(telaf_sdir_exec_t);
init_telaf_core_domain(telaf_sdir_t, telaf_sdir_exec_t)

# Service directory CLI tool (sdir load/bind/get/list).
type telaf_sdirtool_t;
type telaf_sdirtool_exec_t;
files_type(telaf_sdirtool_exec_t);
init_telaf_app_domain(telaf_sdirtool_t, telaf_sdirtool_exec_t)
# sdir reads binding config from configTree.
telaf_use_config_tree(telaf_sdirtool_t)
# sdir list passes an output fd (/tmp/sdOutput, tmp_t:file) to serviceDirectory,
# which writes the binding list into it.  Two denials observed in permissive mode:
#   telaf_sdir_t denied { use }   tcontext=telaf_sdirtool_t tclass=fd
#   telaf_sdir_t denied { write } tcontext=tmp_t            tclass=file
allow telaf_sdir_t telaf_sdirtool_t:fd use;
allow telaf_sdir_t tmp_t:file { write getattr };
# sdir is a CLI tool meant to be run from the root shell.
# init_telaf_app_domain only sets up the domain transition from telaf_admin_t.
# Without an explicit transition from the shell domain, sdir stays in the
# caller's domain and cannot connect to telaf_sdir_t:unix_stream_socket, causing:
#   "sdir: Communication with Service Directory failed."
#
# On this platform the root login shell runs as sysadm_t (MLS policy).
# unconfined_t is also covered for permissive/debug builds where the shell
# may run unconfined.
ifdef(`enable_mls',`
    gen_require(`
        type sysadm_t;
        role sysadm_r;
    ')
    domtrans_pattern(sysadm_t, telaf_sdirtool_exec_t, telaf_sdirtool_t)
    role sysadm_r types telaf_sdirtool_t;
')
gen_require(`
    type unconfined_t;
    role unconfined_r;
')
domtrans_pattern(unconfined_t, telaf_sdirtool_exec_t, telaf_sdirtool_t)
role unconfined_r types telaf_sdirtool_t;

# Watchdog daemon.
type telaf_wdog_t;
type telaf_wdog_exec_t;
files_type(telaf_wdog_exec_t);
init_telaf_core_domain(telaf_wdog_t, telaf_wdog_exec_t)
allow telaf_wdog_t watchdog_device_t:chr_file rw_file_perms;

# Configuration tree service.
type telaf_cfgtree_t;
type telaf_cfgtree_exec_t;
files_type(telaf_cfgtree_exec_t);
init_telaf_core_domain(telaf_cfgtree_t, telaf_cfgtree_exec_t)
# cfgtree inspects global process state to resolve app names and process ownership.
domain_read_all_domains_state(telaf_cfgtree_t);
allow telaf_cfgtree_t telaf_cfgtree_t:fifo_file { read getattr write };
corecmd_exec_shell(telaf_cfgtree_t)
allow telaf_cfgtree_t proc_t:file read_file_perms;
allow telaf_cfgtree_t proc_t:dir list_dir_perms;
allow telaf_cfgtree_t mnt_t:dir list_dir_perms;
# dac_read_search lets cfgtree opendir()/lstat() tree files whose DAC owner
# differs from its own (e.g. OEM config files pushed into the update dir).
allow telaf_cfgtree_t self:capability { dac_read_search sys_ptrace sys_resource };
allow telaf_cfgtree_t kernel_t:dir list_dir_perms;
allow telaf_cfgtree_t persist_t:dir { search };
allow telaf_cfgtree_t persist_t:file { read getattr open };
allow telaf_cfgtree_t urandom_device_t:chr_file { read open };
allow telaf_cfgtree_t telaf_app_rw_t:lnk_file { read };
allow telaf_cfgtree_t telaf_app_bundle_t:lnk_file { read };

# Update daemon core process
type telaf_update_t;
type telaf_update_exec_t;
files_type(telaf_update_exec_t);
init_telaf_core_domain(telaf_update_t, telaf_update_exec_t)
typeattribute telaf_update_t telaf_admin_domain;
allow telaf_update_t proc_t:file read_file_perms;
allow telaf_update_t mnt_t:dir search_dir_perms;
corecmd_exec_shell(telaf_update_t)

# Device manager / VHAL plugin host.
type telaf_devmgr_t;
type telaf_devmgr_exec_t;
type telaf_devmgr_data_t;
files_type(telaf_devmgr_exec_t);
files_type(telaf_devmgr_data_t);
init_telaf_core_domain(telaf_devmgr_t, telaf_devmgr_exec_t)
allow telaf_devmgr_t telaf_devmgr_t:process { signal };
allow telaf_devmgr_t telaf_devmgr_t:capability { fowner sys_ptrace kill };
allow telaf_devmgr_t proc_t:file { open read getattr };
allow telaf_devmgr_t telaf_mod_t:dir { manage_dir_perms };
allow telaf_devmgr_t telaf_mod_t:file { relabel_file_perms link manage_file_perms };
allow telaf_devmgr_t user_tmp_t:file { relabel_file_perms link manage_file_perms };
allow telaf_devmgr_t telaf_apptmp_rw_t:dir { relabelfrom relabelto search getattr remove_name };
allow telaf_devmgr_t telaf_apptmp_rw_t:file { relabel_file_perms link manage_file_perms };
allow telaf_devmgr_t telaf_devmgr_data_t:dir { relabel_dir_perms manage_dir_perms };
allow telaf_devmgr_t telaf_devmgr_data_t:file { relabel_file_perms manage_file_perms mmap_rw_file_perms mmap_exec_file_perms };
allow telaf_devmgr_t default_t:dir { search };
allow telaf_devmgr_t tmp_t:file { write link relabelfrom map };
allow telaf_devmgr_data_t fs_t:filesystem { associate };

ifdef(`sa525m',`
    allow telaf_devmgr_t telaf_apptmp_rw_t:file { map };
')

########################################
# Shared privileged admin-domain helpers
#
# telaf_admin_domain includes supervisor and update-related privileged helpers.
# These permissions support uninstall, relabel, mount, and low-level device access.
########################################

allow telaf_admin_domain cgroup_t:dir { manage_dir_perms };
allow telaf_admin_domain { fs_t tmpfs_t }:filesystem { unmount };
allow telaf_admin_domain device_t:chr_file { manage_file_perms relabelfrom relabelto };
allow telaf_admin_domain device_t:dir { manage_dir_perms relabelfrom relabelto };
allow telaf_admin_domain { devlog_t device_t }:sock_file { getattr relabelto relabelfrom write open };
allow telaf_admin_domain { null_device_t urandom_device_t zero_device_t }:chr_file { unlink read open mounton };

# Allow to load sepolicy module
selinux_load_policy(telaf_update_t)
userdom_security_admin_template(telaf_update_t, system_r)
seutil_manage_config(telaf_update_t)
seutil_manage_module_store(telaf_update_t);
seutil_manage_file_contexts(telaf_update_t);
allow telaf_update_t semanage_trans_lock_t:file { getattr read lock open };
allow telaf_update_t semanage_read_lock_t:file { getattr read lock open };
#allow telaf_update_t file_context_t:dir { manage_dir_perms };

########################################
# Generic fallback TelAF app domain
#
# telaf_app_t catches any telaf_bin_t executable that does not yet have a
# dedicated per-tool .te / .fc entry.  Without this fallback, supervisor
# (telaf_admin_t) would exec the binary and the process would stay in
# telaf_admin_t -- which is far more privileged and completely unacceptable.
# The fallback is intentionally kept minimal: init_telaf_app_domain baseline
# only, plus the broad IPC allow that legacy tools may still need.
########################################

type telaf_app_t;
init_telaf_app_domain(telaf_app_t, telaf_bin_t)
init_telaf_app_domain(telaf_app_t, telaf_app_rw_t)

# FIXME: Broad IPC compatibility for tools not yet migrated to explicit telaf_ipc_bind().
allow telaf_app_t telaf_app_domain:unix_stream_socket { connectto read write getopt };

########################################
# TelAF framework CLI tools
########################################

# config: configTree read/write CLI
type telaf_config_tool_t;
type telaf_config_tool_exec_t;
files_type(telaf_config_tool_exec_t);
init_telaf_app_domain(telaf_config_tool_t, telaf_config_tool_exec_t)
telaf_use_config_tree(telaf_config_tool_t)

# log: log control CLI
type telaf_log_tool_t;
type telaf_log_tool_exec_t;
files_type(telaf_log_tool_exec_t);
init_telaf_app_domain(telaf_log_tool_t, telaf_log_tool_exec_t)

# app: app lifecycle management CLI
type telaf_app_tool_t;
type telaf_app_tool_exec_t;
files_type(telaf_app_tool_exec_t);
init_telaf_app_domain(telaf_app_tool_t, telaf_app_tool_exec_t)
corecmd_exec_shell(telaf_app_tool_t)

# cm: data connection / network management CLI (shell script wrapper)
# cm runs as telaf_cm_tool_t (telaf_app_domain)
type telaf_cm_tool_t;
type telaf_cm_tool_exec_t;
files_type(telaf_cm_tool_exec_t);
init_telaf_app_domain(telaf_cm_tool_t, telaf_cm_tool_exec_t)
corecmd_exec_shell(telaf_cm_tool_t)
# scripts/cm (telaf_cm_tool_exec_t) internally calls the cm ELF binary
# (also telaf_cm_tool_exec_t) via $CM variable without a domain transition.
# The shell stays in telaf_cm_tool_t and re-execs the ELF in the same domain,
# so execute_no_trans is required in addition to the execute already granted
# by init_telaf_app_domain -> domain_auto_transition_pattern.
allow telaf_cm_tool_t telaf_cm_tool_exec_t:file { execute_no_trans };
# cm writes connection logs to /var/log.
logging_manage_generic_log_dirs(telaf_cm_tool_t)
logging_manage_generic_logs(telaf_cm_tool_t)
# cm reads /var/log/cm which is a symlink (var_log_t:lnk_file).
allow telaf_cm_tool_t var_log_t:lnk_file { read };
# cm creates lock/pid files in /var/run.
allow telaf_cm_tool_t var_run_t:dir { create_dir_perms rw_dir_perms setattr };
allow telaf_cm_tool_t var_run_t:file { manage_file_perms };
# cm invokes ifconfig and reads network config.
sysnet_exec_ifconfig(telaf_cm_tool_t)
sysnet_read_config(telaf_cm_tool_t)
# cm tests network connectivity via TCP/UDP/ICMP.
allow telaf_cm_tool_t self:udp_socket { create_socket_perms rw_socket_perms };
allow telaf_cm_tool_t self:tcp_socket { create_socket_perms rw_socket_perms accept listen };
allow telaf_cm_tool_t self:netlink_route_socket rw_netlink_socket_perms;
allow telaf_cm_tool_t self:icmp_socket { create setopt getopt write read ioctl };
allow telaf_cm_tool_t http_port_t:tcp_socket all_tcp_socket_perms;
# cm reads TLS certificates for HTTPS connectivity checks.
miscfiles_read_generic_certs(telaf_cm_tool_t)
# cm executes ping for connectivity tests.
allow telaf_cm_tool_t ping_exec_t:file { getattr open read execute execute_no_trans map };
allow telaf_cm_tool_t self:process { getcap setcap };
# cm reads kernel network state (routing table, interfaces).
kernel_read_network_state(telaf_cm_tool_t)
# cm updates DNS settings via systemd-resolved.
allow telaf_cm_tool_t systemd_resolved_var_run_t:file rw_file_perms;
# cm HTTP connectivity test: bind/connect to HTTP and HTTP-cache ports, bind node.
allow telaf_cm_tool_t http_cache_port_t:tcp_socket { name_bind name_connect };
allow telaf_cm_tool_t node_t:tcp_socket node_bind;

# gnss: GNSS control CLI
type telaf_gnss_tool_t;
type telaf_gnss_tool_exec_t;
files_type(telaf_gnss_tool_exec_t);
init_telaf_app_domain(telaf_gnss_tool_t, telaf_gnss_tool_exec_t)
corecmd_exec_shell(telaf_gnss_tool_t)

# fwupdate: firmware update CLI
type telaf_fwupdate_tool_t;
type telaf_fwupdate_tool_exec_t;
files_type(telaf_fwupdate_tool_exec_t);
init_telaf_app_domain(telaf_fwupdate_tool_t, telaf_fwupdate_tool_exec_t)
corecmd_exec_shell(telaf_fwupdate_tool_t)

# update: system update package installer CLI
type telaf_update_tool_t;
type telaf_update_tool_exec_t;
files_type(telaf_update_tool_exec_t);
init_telaf_app_domain(telaf_update_tool_t, telaf_update_tool_exec_t)

# inspect: process/memory inspection CLI
# Needs to read /proc/<pid>/ for all running processes.
type telaf_inspect_tool_t;
type telaf_inspect_tool_exec_t;
files_type(telaf_inspect_tool_exec_t);
init_telaf_app_domain(telaf_inspect_tool_t, telaf_inspect_tool_exec_t)
telaf_app_read_proc_state(telaf_inspect_tool_t)

# xattr: file extended attribute tool
type telaf_xattr_tool_t;
type telaf_xattr_tool_exec_t;
files_type(telaf_xattr_tool_exec_t);
init_telaf_app_domain(telaf_xattr_tool_t, telaf_xattr_tool_exec_t)

# sbtrace: sandbox trace tool
type telaf_sbtrace_tool_t;
type telaf_sbtrace_tool_exec_t;
files_type(telaf_sbtrace_tool_exec_t);
init_telaf_app_domain(telaf_sbtrace_tool_t, telaf_sbtrace_tool_exec_t)

# pm: power management CLI
type telaf_pm_tool_t;
type telaf_pm_tool_exec_t;
files_type(telaf_pm_tool_exec_t);
init_telaf_app_domain(telaf_pm_tool_t, telaf_pm_tool_exec_t)
corecmd_exec_shell(telaf_pm_tool_t)

# _appStopClient: internal app-stop IPC client
type telaf_appstopclient_tool_t;
type telaf_appstopclient_tool_exec_t;
files_type(telaf_appstopclient_tool_exec_t);
init_telaf_app_domain(telaf_appstopclient_tool_t, telaf_appstopclient_tool_exec_t)

# Relabel /dev/log, /dev/null, /dev/zero, /dev/urandom
allow telaf_app_rw_t { device_t }:filesystem { associate };

########################################
# Overlay relabel helper domain
# telaf_overlay_t runs the helper script that prepares the writable overlay and
########################################

type telaf_overlay_t;
type telaf_overlay_exec_t;
init_script_domain(telaf_overlay_t, telaf_overlay_exec_t)
mls_file_read_to_clearance(telaf_overlay_t)
mls_file_write_to_clearance(telaf_overlay_t)
# Object creation may require MLS upgrade checks when setfscreate is used.
mls_file_upgrade(telaf_overlay_t)

allow telaf_overlay_t data_t:dir { read remove_name rmdir relabelfrom write create add_name setattr };
allow telaf_overlay_t default_context_t:file { read getattr };
allow telaf_overlay_t file_context_t:file { read getattr };
allow telaf_overlay_t security_t:file write;
allow telaf_overlay_t security_t:security check_context;
allow telaf_overlay_t kmsg_device_t:chr_file { write open };
allow telaf_overlay_t mount_exec_t:file { read getattr open execute execute_no_trans map };
allow telaf_overlay_t proc_t:file { read getattr open };
allow telaf_overlay_t sysfs_t:dir search;
allow telaf_overlay_t sysfs_t:lnk_file { read getattr };
allow telaf_overlay_t sysfs_t:file { read getattr open };
allow telaf_overlay_t fixed_disk_device_t:blk_file { getattr };
allow telaf_overlay_t fs_t:filesystem { mount unmount relabelfrom getattr };
allow telaf_overlay_t mount_runtime_t:dir { search read write getattr };
allow telaf_overlay_t self:capability { sys_admin dac_override dac_read_search };
allow telaf_overlay_t self:fifo_file { read ioctl };
allow telaf_overlay_t selinux_config_t:dir { rename reparent remove_name mounton relabelfrom relabelto write read create add_name setattr };
allow telaf_overlay_t selinux_config_t:filesystem { relabelfrom relabelto mount };
allow telaf_overlay_t semanage_store_t:dir { rename reparent rmdir getattr relabelfrom relabelto write search mounton create add_name };
allow telaf_overlay_t var_lib_t:dir { search getattr };
allow telaf_overlay_t default_context_t:dir { getattr search };
allow telaf_overlay_t semanage_store_t:dir { read remove_name open setattr };
allow telaf_overlay_t semanage_store_t:filesystem { relabelfrom relabelto mount };
allow telaf_overlay_t file_context_t:dir { search read getattr };
allow telaf_overlay_t selinux_config_t:file { rename create unlink };
allow telaf_overlay_t semanage_read_lock_t:file { read getattr };
allow telaf_overlay_t semanage_store_t:chr_file { rename unlink };
allow telaf_overlay_t semanage_store_t:file { rename write getattr setattr read create unlink };
allow telaf_overlay_t semanage_trans_lock_t:file read;
allow telaf_overlay_t policy_config_t:dir { search read getattr };

########################################
# Admin-domain policy
# supervisor and update-related admin helpers live in this trust tier.
########################################

# Full access to TelAF-owned file types.
admin_pattern(telaf_admin_domain, telaf_fw_t)
admin_pattern(telaf_admin_domain, telaf_app_rw_t)
admin_pattern(telaf_admin_domain, telaf_app_bundle_t)
admin_pattern(telaf_admin_domain, telaf_sys_t)
admin_pattern(telaf_admin_domain, telaf_bin_t)
admin_pattern(telaf_admin_domain, telaf_lib_t)
admin_pattern(telaf_admin_domain, telaf_mod_t)
admin_pattern(telaf_admin_domain, telaf_app_ro_t)
admin_pattern(telaf_admin_domain, telaf_apptmp_rw_t)
admin_pattern(telaf_admin_domain, telaf_sdir_t)
admin_pattern(telaf_admin_domain, telaf_logd_t)
admin_pattern(telaf_admin_domain, telaf_cfgtree_t)
admin_pattern(telaf_admin_domain, telaf_devmgr_t)

# should have execute permission
exec_files_pattern(telaf_admin_domain, telaf_lib_t, telaf_lib_t)
exec_files_pattern(telaf_admin_domain, telaf_bin_t, telaf_bin_t)
exec_files_pattern(telaf_admin_domain, telaf_app_rw_t, telaf_app_rw_t)
exec_files_pattern(telaf_admin_domain, telaf_app_bundle_t, telaf_app_bundle_t)
exec_files_pattern(telaf_admin_domain, telaf_admin_exec_t, telaf_admin_exec_t)

allow telaf_admin_domain devlog_t:sock_file write;
allow telaf_admin_domain self:process setsched;
allow telaf_admin_domain sysfs_t:file { read write open };
allow telaf_admin_t telaf_sdir_t:fd use;
telaf_rw_data_files(telaf_admin_t, adbd_t)
read_lnk_files_pattern(telaf_admin_t, adbd_t, adbd_t)
telaf_rw_data_files(telaf_admin_t, alogd_t)
read_lnk_files_pattern(telaf_admin_t, alogd_t, alogd_t)
telaf_rw_data_files(telaf_admin_t, init_t)
read_lnk_files_pattern(telaf_admin_t, init_t, init_t)
telaf_rw_data_files(telaf_admin_t, kernel_t)
read_lnk_files_pattern(telaf_admin_t, kernel_t, kernel_t)
telaf_rw_data_files(telaf_admin_t, udev_t)
read_lnk_files_pattern(telaf_admin_t, udev_t, udev_t)
telaf_rw_data_files(telaf_admin_t, var_lock_t)
read_lnk_files_pattern(telaf_admin_t, var_lock_t, var_lock_t)
# Supervisor also needs to create cgroup control files such as release_agent and
# notify_on_release when setting up per-app cgroup namespaces.
telaf_rw_data_files(telaf_admin_t, cgroup_t)
allow telaf_admin_t cgroup_t:file { create };
read_lnk_files_pattern(telaf_admin_t, cgroup_t, cgroup_t)
telaf_rw_data_files(telaf_admin_t, proc_t)
telaf_rw_data_files(telaf_admin_t, sysctl_t)
telaf_rw_data_files(telaf_admin_t, sysfs_t)
allow telaf_admin_t cgroup_t:dir { write create add_name mounton search };
allow telaf_admin_t cgroup_t:filesystem { getattr mount remount };
allow telaf_admin_t debugfs_t:dir { write create add_name mounton search };
allow telaf_admin_t debugfs_t:filesystem { getattr mount remount };
allow telaf_admin_t tmpfs_t:dir { write create add_name mounton search };
allow telaf_admin_t tmpfs_t:filesystem { getattr mount remount };

allow telaf_admin_domain telaf_app_rw_t:dir { search_dir_perms mounton };
allow telaf_admin_domain telaf_app_rw_t:file { getattr mounton };

# support relabel and manage access for chr device
manage_chr_files_pattern(telaf_admin_domain, telaf_fw_t, telaf_fw_t)
relabel_chr_files_pattern(telaf_admin_domain, telaf_fw_t, telaf_fw_t)

# allow manage access for chr device (/legato/systems/current/appsWriteable/app/dev/null)
manage_chr_files_pattern(telaf_admin_domain, telaf_app_rw_t, telaf_app_rw_t)

# allow IPC connection - admin domain uses all core services
telaf_use_service_directory(telaf_admin_t)
telaf_use_logd(telaf_admin_t)
telaf_use_config_tree(telaf_admin_t)
telaf_use_device_manager(telaf_admin_t)
# Support putting logs to adbd_t
allow { telaf_admin_domain telaf_app_domain telaf_core_domain } adbd_t:unix_stream_socket { connectto read write getopt getattr };
# Support putting logs to pmsg_device_t
allow { telaf_admin_domain telaf_app_domain telaf_core_domain } pmsg_device_t:chr_file { read write };

allow telaf_admin_domain telaf_overlay_t:dir { search };

# allow to read etc files
files_read_etc_files(telaf_admin_domain)

# allow logging to syslog
logging_send_syslog_msg(telaf_admin_domain)

# allow logging to dlt-daemon
mls_socket_read_to_clearance(dlt_t)
mls_socket_write_to_clearance(dlt_t)

# allow supervisor to send signal to telaf app
allow telaf_admin_domain telaf_app_domain:process signal;
allow telaf_admin_domain telaf_core_domain:process signal;

# fs related permission used by supervisor
dev_getattr_fs(telaf_admin_domain)
term_getattr_pty_fs(telaf_admin_domain)
files_rw_etc_files(telaf_admin_domain)
allow telaf_admin_domain tracefs_t:filesystem getattr;
allow telaf_admin_domain fs_t:filesystem { getattr mount };
allow telaf_admin_domain proc_t:filesystem { getattr };

# For supervisor create, rename and delete the link
allow telaf_admin_t telaf_apptmp_rw_t:chr_file { unlink create link rename };

# should have the permission of tmpfs
files_mounton_non_security(telaf_admin_domain)
files_relabel_all_tmp_dirs(telaf_admin_domain)
files_relabel_all_tmp_files(telaf_admin_domain)
files_manage_generic_tmp_dirs(telaf_admin_domain)
files_manage_generic_tmp_files(telaf_admin_domain)

# user ability and sandbox support
allow telaf_admin_domain self:capability { dac_read_search sys_admin sys_resource sys_nice setgid kill setuid net_admin sys_boot mknod sys_chroot sys_ptrace dac_override };
allow telaf_admin_domain self:capability { chown fowner fsetid setpcap };
allow telaf_admin_domain self:capability2 { block_suspend mac_admin wake_alarm };
allow telaf_admin_domain self:capability2 { syslog };

allow telaf_admin_domain self:process { setsched setrlimit sigkill signal getattr };

allow telaf_admin_domain { telaf_core_domain telaf_app_domain }:process { setrlimit rlimitinh };

# support killall command
domain_read_all_domains_state(telaf_admin_domain);
domain_kill_all_domains(telaf_admin_domain);

# allow to load sepolicy module
selinux_load_policy(telaf_admin_t)
userdom_security_admin_template(telaf_admin_t, system_r)
seutil_manage_config(telaf_admin_t)
seutil_manage_module_store(telaf_admin_t);
seutil_manage_file_contexts(telaf_admin_t);
allow telaf_admin_t semanage_trans_lock_t:file { getattr read lock open };
allow telaf_admin_t semanage_read_lock_t:file { getattr read lock open };
auth_read_shadow(telaf_admin_t)

# support system reboot
allow telaf_admin_domain init_t:file { exec_file_perms };
allow telaf_admin_domain init_t:unix_stream_socket { connectto };
allow telaf_admin_domain systemd_logind_var_run_t:sock_file { open write };
allow telaf_admin_domain init_var_run_t:sock_file { open write };
allow telaf_admin_domain initctl_t:fifo_file { open write };
allow telaf_admin_domain cgroup_t:dir { manage_dir_perms };
allow telaf_admin_domain fs_t:filesystem { unmount };

# access tmpfs_t, e.g sandboxed app appsWriteable/tafDataCallIntTest/tmp/legato/serviceDirectoryServer
allow telaf_admin_domain tmpfs_t:file { create_file_perms read_file_perms write_file_perms };

# Read and write generic kernel sysctls
kernel_rw_kernel_sysctl(telaf_admin_domain)

# Modiry contents of sysctl network files
kernel_rw_net_sysctls(telaf_admin_domain)

# Read and write unix domain by sysctl
kernel_rw_unix_sysctls(telaf_admin_domain)

# saveLogs/start scripts move coredump files from /tmp (coredump_data_t) to
# archive directories.  mv across filesystems calls setfscreate to set the
# target label, and needs relabelfrom/relabelto on the coredump file.
allow telaf_admin_domain self:process { setfscreate };
allow telaf_admin_domain coredump_data_t:file { relabelfrom relabelto };

########################################
# App-domain baseline policy
#
# These are the common permissions shared by all app-tier TelAF services.
# Service-specific .te files should add only the deltas they need.
########################################

# --- TelAF framework file-system baseline for app services ---
#
# telaf_fw_t  : /legato  (single root dir node only)
#   search    : path traversal into /legato/systems/, /legato/apps/ etc.
#   getattr   : stat() the root dir (e.g. statvfs checks)
# manage_dir_perms was too broad -- apps must not create/delete under /legato.
allow telaf_app_domain telaf_fw_t:dir { search_dir_perms };
# telaf_fw_t:file manage_file_perms was also too broad; apps only need to
# read framework-owned regular files (e.g. version, SMACK_DISABLED flag).
allow telaf_app_domain telaf_fw_t:file { read_file_perms };

# telaf_lib_t : /legato/systems/current/lib/
#   Apps load shared libraries from here at startup via the dynamic linker.
#   exec_file_perms = getattr + open + read + execute (triggers domain transition
#   if an exec type is set; harmless if not).
allow telaf_app_domain telaf_lib_t:dir  { list_dir_perms };
allow telaf_app_domain telaf_lib_t:file { read_file_perms exec_file_perms };
allow telaf_app_domain telaf_lib_t:lnk_file { read_file_perms };

# telaf_app_rw_t : /legato/systems/current/appsWriteable/
#   Each app's sandboxed writable area.  Full access is intentional:
#   apps create, read, write, and delete their own runtime state here.
#   sock_file is subsumed by the wildcard below; listed separately only
#   for documentation clarity -- the compiler deduplicates it.
allow telaf_app_domain telaf_app_rw_t:{ file dir lnk_file sock_file } *;

# telaf_app_ro_t : read-only app install files
#   Apps may read their own installed (read-only) files but must not write them.
allow telaf_app_domain telaf_app_ro_t:{ file dir } ~{ write };

# telaf_sys_t : /legato/systems/  +  /data/le_fs/  +  /data/ManagedServices/
#   Apps read system config and le_fs persistent state.  They must NOT be
#   able to create, rename, or delete files in the system tree -- that is
#   exclusively the update daemon's job.
#   lnk_file read covers the current -> <index> symlink traversal.
#
#   FIXME: Temporary workaround -- some services (e.g. tafSMSSvc) use the
#   le_fs API to write persistent data under /data/le_fs/, which is labeled
#   telaf_sys_t.  The correct fix is to label each service's data path with
#   a dedicated type (e.g. telaf_tafSMSSvc_data_t) in the service .fc file.
#   Until that is done, grant write access to the whole app_domain.
allow telaf_app_domain telaf_sys_t:dir  { list_dir_perms search_dir_perms add_name remove_name write create };
allow telaf_app_domain telaf_sys_t:file { read_file_perms create open write setattr unlink rename };
allow telaf_app_domain telaf_sys_t:lnk_file { read_file_perms };

# telaf_bin_t : /legato/systems/current/bin/
#   Apps may read and execute binaries here (supervisor will trigger a domain
#   transition via domain_auto_transition_pattern for known exec types).
#   execute_no_trans is intentionally excluded: unknown binaries must not
#   run in the calling app's domain.
allow telaf_app_domain telaf_bin_t:dir  { list_dir_perms };
allow telaf_app_domain telaf_bin_t:file { read_file_perms exec_file_perms };

# data_t : generic data partition
#   search + read for path traversal and config reads.
#   write is NOT granted here: services that need to write data_t must call
#   manage_user_data_files() (already done in init_telaf_app_domain()).
allow telaf_app_domain data_t:dir { search_dir_perms read };

# self : process's own file descriptors and anonymous files
#   file  : read/write/getattr on self-created anonymous fds (pipes, memfds).
#           execute is excluded -- self-modifying code is not permitted.
#   dir   : getattr only (e.g. fstat on an O_TMPFILE dir fd).
#           No list/write/execute on self:dir.
allow telaf_app_domain self:file { rw_file_perms };
allow telaf_app_domain self:dir  { getattr };
# Base app-domain self unix socket access is narrowed.
# Self-to-self connect/read/write/getopt is granted from init_telaf_app_domain().
# app_domain IPC access to core services is now managed via explicit per-service interfaces:
#   telaf_use_logd(), telaf_use_config_tree(), telaf_use_device_manager()
# These broad domain-wide allows are intentionally removed.
# telaf_apptmp_rw_t : /tmp/legato/<appname>/  (type_transition from telaf_admin_t)
#   Supervisor creates this per-app directory before exec; the app then creates
#   its own IPC socket files and temporary state files inside it.
#   sock_file manage_sock_file_perms : create, stat, write, and unlink IPC sockets.
#   dir   manage_dir_perms           : add/remove entries inside the per-app dir.
#   file  manage_file_perms          : create/read/write/unlink temp state files.
allow telaf_app_domain telaf_apptmp_rw_t:sock_file { manage_sock_file_perms };
allow telaf_app_domain telaf_apptmp_rw_t:dir { manage_dir_perms };
allow telaf_app_domain telaf_apptmp_rw_t:file { manage_file_perms };
logging_send_syslog_msg(telaf_app_domain)
allow telaf_app_domain telaf_admin_t:fd use;
allow telaf_app_domain diag_device_t:chr_file { read write open ioctl };
#   App bundles are read-only install packages; only updateDaemon may modify them.
#   Apps need read access to find their own bundle files at startup.
allow telaf_app_domain telaf_app_bundle_t:dir  { list_dir_perms search_dir_perms };
allow telaf_app_domain telaf_app_bundle_t:file  { read_file_perms };
allow telaf_app_domain telaf_app_bundle_t:lnk_file { read_file_perms };

# wake_alarm / block_suspend:
#   liblegato timer_Init() probes CLOCK_BOOTTIME_ALARM on every service startup,
#   which requires wake_alarm.  The wakelock path in liblegato also triggers
#   block_suspend on every app-domain service at runtime.
#   Grant both to the whole app_domain baseline, symmetric with core_domain.
allow telaf_app_domain self:capability2 { wake_alarm block_suspend };

# FIXME: TLS certificate access: any app-domain service (including unit tests such as
# tafKeyStoreUnitTest that have no dedicated .te and run as telaf_app_t) may
# need to read /etc/ssl/certs (cert_t).
telaf_use_cert_files(telaf_app_domain)
# setsched: liblegato le_thread_SetPriority() calls pthread_setschedparam() to
# set thread scheduling policy/priority, which requires setsched.
# This is a universal liblegato need -- every TelAF app service uses le_thread.
allow telaf_app_domain self:process { signal setsched };

# sys_nice: liblegato PThreadStartRoutine() calls setpriority(PRIO_PROCESS, tid, niceLevel)
# for threads created with LE_THREAD_PRIORITY_HIGH (nice=-10) or LE_THREAD_PRIORITY_LOW
# (nice=10).  Setting a negative nice value requires CAP_SYS_NICE.
allow telaf_app_domain self:capability { sys_nice };
allow telaf_app_domain self:fifo_file { write read };
allow telaf_app_domain socket_device_t:dir search;
allow telaf_app_domain null_device_t:chr_file { read_file_perms };
allow telaf_app_domain self:fd use;
allow telaf_app_domain proc_t:file { read open getattr };

# Manage /tmp/telaf_crash_logs and any other /tmp scratch files.
# telaf_manage_tmp_files() covers both tmp_t and user_tmp_t.
telaf_manage_tmp_files(telaf_app_domain)

# Allow kernel generate and save core dump to "/tmp/coredump"
allow coredump_data_t tmpfs_t:filesystem { associate };
allow data_t tmpfs_t:filesystem { associate };

########################################
# Core-domain baseline policy
#
# These permissions apply to built-in framework daemons such as logd,
# serviceDirectory, configTree, watchdog, updateDaemon, and deviceManager.
########################################

# telaf_fw_t : /legato root dir -- core services only need path traversal.
allow telaf_core_domain telaf_fw_t:dir { search_dir_perms };
# telaf_lib_t : shared libraries -- execute on dir/lnk_file is meaningless in SELinux.
allow telaf_core_domain telaf_lib_t:dir  { list_dir_perms };
allow telaf_core_domain telaf_lib_t:file { read_file_perms exec_file_perms };
allow telaf_core_domain telaf_lib_t:lnk_file { read_file_perms };
# telaf_app_rw_t : appsWriteable/ -- unix_dgram_socket and socket are not
# filesystem objects and cannot appear under this path label.
allow telaf_core_domain telaf_app_rw_t:{ file dir sock_file } *;
allow telaf_core_domain telaf_app_ro_t : { file dir } ~{ write };
allow telaf_core_domain telaf_sys_t : { file dir lnk_file } *;
# telaf_bin_t : bin/ -- execute_no_trans excluded; domain transition must occur.
allow telaf_core_domain telaf_bin_t:dir  { list_dir_perms };
allow telaf_core_domain telaf_bin_t:file { read_file_perms exec_file_perms };
allow telaf_core_domain telaf_app_bundle_t : { file dir } *;
allow telaf_core_domain telaf_admin_t:fd use;
allow telaf_core_domain telaf_sdir_t:fd use;
# Supervisor stdout/stderr pipes for app/core processes are relabeled to telaf_sys_t
# via type_transition so that app_domain and core_domain write to telaf_sys_t:fifo_file
# instead of telaf_admin_t:fifo_file, following least-privilege principle.
type_transition telaf_admin_t telaf_admin_t:fifo_file telaf_sys_t;
allow telaf_admin_t telaf_sys_t:fifo_file { create read write getattr };
allow telaf_core_domain telaf_sys_t:fifo_file { write getattr };
allow telaf_app_domain telaf_sys_t:fifo_file { write getattr };
allow telaf_core_domain telaf_lib_t:dir { search };
allow telaf_core_domain telaf_lib_t:file { read_file_perms mmap_rw_file_perms mmap_exec_file_perms };
logging_send_syslog_msg(telaf_core_domain)
allow telaf_core_domain etc_t:file { read open lock getattr };
allow telaf_core_domain tmp_t:dir { search_dir_perms };
allow telaf_core_domain tmp_t:file { read_file_perms };
allow telaf_core_domain telaf_apptmp_rw_t:dir { search write add_name create open read };
allow telaf_core_domain telaf_apptmp_rw_t:file { create open read write lock };
allow telaf_core_domain telaf_apptmp_rw_t:sock_file { create write };
allow telaf_core_domain telaf_admin_t:process { sigchld };
# dac_override: liblegato le_fs_Init() and le_cfg_Init() access /data/le_fs/
# directories that may be owned by root while core services run as non-root.
allow telaf_core_domain self:capability { dac_override };

# block_suspend / wake_alarm:
#   liblegato timer_Init() probes CLOCK_BOOTTIME_ALARM on every service startup,
#   which requires wake_alarm.  The wakelock path in liblegato also triggers
#   block_suspend on every core daemon (serviceDirector, configTree, logCtrlDaemon,
#   deviceManager, watchdog).  Grant both to the whole core_domain rather than
#   suppressing thousands of AVC denials per boot.
#   AVC evidence (sa525m):
#     telaf_sdir_t   : denied { wake_alarm block_suspend }
#     telaf_logd_t   : denied { wake_alarm }
#     telaf_cfgtree_t: denied { wake_alarm block_suspend }
#     telaf_devmgr_t : denied { block_suspend }
allow telaf_core_domain self:capability2 { wake_alarm block_suspend };

# Core services are mutually trusted and may communicate with each other.
# This covers IPC between sdir, logd, cfgtree, devmgr, wdog, updateDaemon etc.
# Fine-grained per-service isolation within core_domain is a future improvement;
# for now, all core services are allowed to communicate via unix sockets and
# read each other's proc/dir entries.
allow telaf_core_domain telaf_core_domain:unix_stream_socket *;
allow telaf_core_domain telaf_core_domain:dir { search_dir_perms };
# Core services (watchdog, supervisor, updateDaemon, etc.) need to check
# liveness of TelAF app processes by traversing /proc/<pid>/ entries and
# reading /proc/<pid>/cmdline to resolve process names.
# telaf_app_t covers only the generic fallback domain; individual taf service
# domains (telaf_tafMngdPMSvc_t, telaf_tafRadioSvc_t, etc.) are members of
# telaf_app_domain but are NOT telaf_app_t.  Watchdog must be able to probe
# /proc/<pid>/ for every app-domain member, so grant access via the attribute.
allow telaf_core_domain telaf_app_domain:dir { search };
allow telaf_core_domain telaf_app_domain:file { read open getattr };
allow telaf_core_domain telaf_core_domain:file { read_file_perms };

#Support TelAF deprevilege
allow telaf_admin_t self:netlink_audit_socket { nlmsg_relay create_netlink_socket_perms };
su_exec(telaf_admin_t)

# su (invoked by supervisor for deprivilege) performs NSS/resolver initialisation
# which requires network socket access and DNS config reads.
# These are unrelated to the cm tool; cm runs as telaf_cm_tool_t.
telaf_use_network_routing(telaf_admin_t)
telaf_create_stream_sockets(telaf_admin_t)
sysnet_read_config(telaf_admin_t)

# Support Kirkstone Yocto rules
ifdef(`kirkstone',`
    gen_require(`
        type syslogd_runtime_t;
        type init_runtime_t;
        type unconfined_t;
    ')
    # syslogd_runtime_t dir search and sock_file write are covered by
    # logging_send_syslog_msg() called above for app_domain and core_domain.
    allow telaf_app_domain init_runtime_t:dir { search_dir_perms };
    allow telaf_core_domain init_runtime_t:dir { search_dir_perms };
    # A workaround to support .update file instsallation
    allow telaf_update_t unconfined_t:fd { use };
    allow telaf_core_domain unconfined_t:fd { use };

    # Support framework to prepare bind mount or link for the application
    allow telaf_admin_t init_runtime_t:dir { write add_name remove_name };
    allow telaf_admin_t init_runtime_t:file { create read write open setattr rename };
')

########################################
# Local helper types and transitions
########################################

# Temporary runtime directory/socket/file type used by apps under /tmp.
type telaf_apptmp_rw_t;
files_tmp_file(telaf_apptmp_rw_t)
files_tmp_filetrans(telaf_admin_t,telaf_apptmp_rw_t, { file dir })

# Allow mount_t to mount over the TelAF framework root when needed.
allow mount_t telaf_fw_t:dir mounton;

########################################
# External dependency glue
#
# Optional compatibility rules used when building against external Yocto / QTI
# SELinux policy layers.  Keep these isolated here so the core TelAF design is
# easier to review.
########################################

if (telaf_external_dependencies) {
    #============= setfiles_t ==============
    allow setfiles_t ldconfig_tmp_t:file { read open };
    allow setfiles_t { telaf_admin_t telaf_sdir_t telaf_core_domain }:unix_stream_socket { connectto read write };
    allow setfiles_t { telaf_admin_t telaf_sdir_t telaf_core_domain }:unix_dgram_socket { read write };
    allow setfiles_t { telaf_admin_t telaf_sdir_t telaf_core_domain }:fd { use };
    allow setfiles_t { telaf_apptmp_rw_t telaf_app_rw_t telaf_app_bundle_t }:file { rw_file_perms };
    allow setfiles_t self:capability2 { mac_admin };

    #============= load_policy_t ==============
    allow load_policy_t telaf_apptmp_rw_t:file { rw_file_perms };
# load_policy_t <-> telaf_update_t: moved here from tafDiagSvc.te where it
# was misplaced.  load_policy_t needs to communicate with updateDaemon during
# live policy reload triggered by tafUpdateSvc.
allow load_policy_t telaf_update_t:unix_stream_socket { read write };
    allow load_policy_t { telaf_admin_t telaf_sdir_t }:unix_dgram_socket { read write };
    allow load_policy_t { telaf_admin_t telaf_sdir_t }:fd { use };
    allow load_policy_t { telaf_app_rw_t telaf_app_bundle_t }:file { rw_file_perms };
    ifdef(`sa525m',`
        gen_require(`
            type semanage_t;
        ')
        allow semanage_t { telaf_fw_t telaf_app_bundle_t }:dir { search_dir_perms };
        allow semanage_t { telaf_fw_t telaf_app_bundle_t }:file { read_file_perms map };
        allow load_policy_t tty_device_t:chr_file { read write };
        allow load_policy_t selinux_config_t:file { map };
        allow telaf_overlay_t policy_config_t:dir { manage_dir_perms };
        allow setfiles_t selinux_config_t:file { map };
    ')
    #============= syslogd_t ==============
    allow syslogd_t self:sem { create unix_read unix_write read write destroy };
    allow syslogd_t self:shm { create unix_read unix_write read write destroy };

    #============= mount_t ==============
    allow mount_t ld_so_cache_t:file mounton;
    allow mount_t ldconfig_tmp_t:file getattr;

    #============= systemd_tmpfiles_t ==============
    allow systemd_tmpfiles_t proc_net_t:file { read getattr open };
    allow systemd_tmpfiles_t telaf_app_rw_t:lnk_file { getattr unlink };
    allow systemd_tmpfiles_t telaf_apptmp_rw_t:sock_file getattr;
    allow systemd_tmpfiles_t telaf_apptmp_rw_t:dir { rw_dir_perms setattr };

    #============= kernel_t ==============
    allow kernel_t data_t:dir { read write };
    allow kernel_t self:capability2 block_suspend;

    #============ tafservices =============
    allow telaf_admin_domain socket_device_t:dir search;
    allow telaf_admin_domain self:fifo_file *;

    #=========== TelSDK DEBUG =============
    allow telaf_admin_t syslogd_t:sem { read write associate unix_write };
    allow telaf_admin_t syslogd_t:shm { read unix_read associate };
    allow telaf_admin_t telaf_apptmp_rw_t:file { manage_file_perms};

    # The only rule kept on telaf_admin_t is /var/log management, because
    # saveLogs (which runs as telaf_admin_t) also writes to /var/log.
    logging_manage_generic_log_dirs(telaf_admin_t)
    logging_manage_generic_logs(telaf_admin_t)

    #=========== Semodule Dynamic Loading  =============
    allow telaf_admin_t var_lib_t:dir { search getattr };

    #=========== Update Service Command =============
    # telaf_update_t unpacks .update packages into /tmp (tmp_t) and may also
    # encounter user_tmp_t when invoked from a user session (e.g. SSH).
    # telaf_manage_tmp_files() covers both tmp_t and user_tmp_t in one call.
    # The original rule granted this to all three domain attributes -- far too
    # broad.  Only telaf_update_t actually needs it.
    telaf_manage_tmp_files(telaf_update_t)
    # telaf_sdir_t only needs to traverse /tmp to find its apptmp_rw_t socket
    # directory; sock_file create/write is already in the core-domain baseline.
    allow telaf_sdir_t tmp_t:dir { search_dir_perms };

    #============ persist path ==================
    allow telaf_admin_t persist_t:dir { write add_name remove_name create setattr getattr};
    allow telaf_admin_t persist_t:file { write read create open rename setattr getattr unlink};

    #============ allow supervisor to access libcap API ===========
    allow telaf_admin_t self:process { getcap setcap };

    #============ allow to access power service ===========
    ifdef(`sa525m',`
        gen_require(`
            type power_unit_t;
            type boot_kpi_values_t;
            type initrc_t;
        ')
        allow telaf_admin_t proc_t:file { ioctl };
        telaf_control_power_units(telaf_admin_t)
        #=========== To support adding boot KPI marker ==============
        allow telaf_app_domain boot_kpi_values_t:file { write open getattr };
        allow initrc_t boot_kpi_values_t:file { write open getattr };
        allow telaf_admin_t ping_exec_t:file { map };

    ')

    #============ To support telaf restart ===================
    allow telaf_sdir_t telaf_apptmp_rw_t:dir { remove_name };
    allow telaf_sdir_t telaf_apptmp_rw_t:sock_file { unlink };
    allow telaf_sdir_t telaf_app_t:fd use;
    allow telaf_sdir_t telaf_app_t:file { read write getattr };
}



