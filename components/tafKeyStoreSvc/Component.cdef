sources:
{
    tafKeyStoreSvc.c
}

cflags:
{
#if ${LE_CONFIG_TARGET_SIMULATION} = y
    -I$TELAF_ROOT/simulation/stub/keyStore/taf_pa_keystore
#else
    -I$TELAF_PA_DEFAULT/include/keyStore
#endif
    -I$LEGATO_ROOT/framework/liblegato/
}

requires:
{
    api:
    {
        le_appInfo.api
    }

    component:
    {
#if ${LE_CONFIG_TARGET_SIMULATION} = y
        $TELAF_ROOT/simulation/stub/keyStore/taf_pa_keystore
#else
        $TELAF_PA_DEFAULT/component/keyStore/taf_pa_keystore_default
        $LEGATO_BUILD/stub/component/taf_pa_keystore
#endif
    }
}

provides:
{
    api:
    {
        taf_ks.api [manual-start]
    }
}
