username: telaf
sandboxed: false
start: auto
maxThreads: 300

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
}

executables:
{
    tafWlanSvc = ( $TELAF_ROOT/components/tafWlan/tafWlanSvc )
}

processes:
{
    run:
    {
        (tafWlanSvc)
    }
    maxFileBytes: 8192K
    faultAction: stopApp
}

extern:
{
    tafWlanSvc.tafWlanSvc.taf_wlan
    tafWlanSvc.tafWlanSvc.taf_wlanAp
}
