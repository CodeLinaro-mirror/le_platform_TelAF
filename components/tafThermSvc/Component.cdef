ldflags:
{
    -L$TELAF_DEFAULT_PA_LIB_DIR/lib
}

provides:
{
    api:
    {
        taf_therm.api
    }
}

requires:
{
    component:
    {
        $LEGATO_ROOT/components/watchdogChain

    }
    lib:
    {
        libComponent_taf_pa_therm.so
        libComponent_taf_pa_thermDef.so
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -DLE_CONFIG_ENABLE_THERMAL_GET_TRIP_ID
    -DLE_CONFIG_ENABLE_THERMAL_GET_ZONE_ID
    -I$TELAF_PA_DEFAULT/include
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
}

sources:
{
    tafThermSvc.cpp
    tafThermImpl.cpp
}