/**
 * To support legacy states
 */
DEFINE INSERTED = 0;
DEFINE BLOCKED = 3;
DEFINE POWER_DOWN = 8;

/**
 * To support legacy slot Id
 */
DEFINE EXTERNAL_SLOT_1 = 1;
DEFINE EXTERNAL_SLOT_2 = 2;

/**
 * PIN length
 */
DEFINE  PIN_MIN_LEN     = (4);
DEFINE  PIN_MAX_LEN     = (8);
DEFINE  PIN_MAX_BYTES   = (PIN_MAX_LEN+1);

/**
 * PUK length)
 */
DEFINE  PUK_MAX_LEN     = (8);
DEFINE  PUK_MAX_BYTES   = (PUK_MAX_LEN+1);
DEFINE  IMSI_LEN    = (15);
DEFINE  IMSI_BYTES  = (IMSI_LEN+1);
DEFINE  RESPONSE_MAX_BYTES  = (256);
DEFINE  PHONE_NUM_MAX_LEN   = (15+2);
DEFINE  PHONE_NUM_MAX_BYTES = (PHONE_NUM_MAX_LEN+1);

DEFINE  ICCID_LEN    = (20);
DEFINE  ICCID_BYTES  = (ICCID_LEN+1);

DEFINE  EID_LEN    = (32);
DEFINE  EID_BYTES  = (EID_LEN+1);
DEFINE  APDU_MAX_BYTES  = (255);
DEFINE  FILE_ID_LEN  = (4);
DEFINE  FILE_ID_BYTES  = (FILE_ID_LEN+1);
DEFINE  DATA_MAX_BYTES = (100);
DEFINE  PATH_MAX_LEN  = (100);
DEFINE  PATH_MAX_BYTES  = (PATH_MAX_LEN+1);

/**
 * Defines states of SIM card
 */
ENUM States
{
    PRESENT,                   ///< SIM card is present.
    ABSENT,                    ///< SIM card is absent.
    READY,                     ///< SIM card is present and ready to use.
    RESTRICTED,                ///< SIM Card is present but not usable due to carrier restrictions
    BUSY,                      ///< Not supported.
    ERROR,                     ///< SIM card has error, either card is removed or not readable.
    STATE_UNKNOWN,             ///< SIM card state is unknown
    ERROR_UNKNOWN,             ///< Unknown error. Not supported.
    ERROR_POWER_DOWN,          ///< Power down. Not supported.
    ERROR_POLL_ERROR,          ///< Poll error. Not supported.
    ERROR_NO_ATR_RECEIVED,     ///< No ATR received. Not supported.
    ERROR_VOLT_MISMATCH,       ///< Volt mismatch. Not supported.
    ERROR_PARITY_ERROR,        ///< Parity error. Not supported.
    ERROR_POSSIBLY_REMOVED,    ///< Unknown, possibly removed.Not supported.
    ERROR_TECHNICAL_PROBLEMS,  ///< Card returned technical problems. Not supported.
    ERROR_NULL_BYTES,          ///< Card returned NULL bytes. Not supported.
    ERROR_SAP_CONNECTED,       ///< Terminal in SAP mode. Not supported.
    ERROR_CMD_TIMEOUT          ///< Command timeout error. Not supported.
};

/**
 * Defines Slot Id of SIM card
 */
ENUM Id
{
    EMBEDDED,           ///< Not supported
    SLOT_ID_1,          ///< SIM inserted in slot 1.
    SLOT_ID_2,          ///< SIM inserted in slot 2.
    REMOTE,             ///< Not supported.
    UNSPECIFIED,        ///< Slot Id is unspecified use current selected slot Id
    ID_MAX
};

/**
 * Defines all types of card locks which uses in PIN management APIs
 */
ENUM LockType
{
   PIN1 = 0,        ///<Lock type is PIN1
   PIN2 = 1,        ///<Lock type is PIN2
   PUK1 = 2,        ///<Lock type is Pin Unblocking Key1
   PUK2 = 3,        ///<Lock type is Pin Unblocking Key2
   FDN  = 4         ///<Lock type is Fixed Dialing Number
};

ENUM LockResponse
{
    CHANGE_PIN,
    UNLOCK_BY_PIN,
    UNLOCK_BY_PUK,
    SET_LOCK
};

/**
 * Defines all type of UICC application such as SIM, RUIM, USIM, CSIM and ISIM.
 */
ENUM AppType {
   APPTYPE_UNKNOWN = 0, ///< Unknown application type
   APPTYPE_SIM = 1,     ///< UICC application type is SIM
   APPTYPE_USIM = 2,    ///< UICC application type is USIM
   APPTYPE_RUIM = 3,    ///< UICC application type is RSIM
   APPTYPE_CSIM = 4,    ///< UICC application type is CSIM
   APPTYPE_ISIM = 5,    ///< UICC application type is ISIM
};

/**
 * Handler for changes in SIM card state
 */
HANDLER NewStateHandler
(
    Id       slotId IN,
    States   state IN
);

/**
 * SIM card state change event
 */
EVENT NewState
(
    NewStateHandler handler
);

/**
 * Handler for pin puk changes.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AuthenticationResponseHandler
(
    Id             slotId IN,             ///< The SIM identifier.
    LockResponse   responsetype,
    le_result_t    result IN
);
EVENT AuthenticationResponse
(
    AuthenticationResponseHandler handler
);

//--------------------------------------------------------------------------------------------------
/**
 * To check whether SIM card is present or absent
 * @return true SIM card present
 * @return false SIM card absent
 */
FUNCTION bool IsPresent
(
    Id      slotId IN
);

/**
 * Get the state of the SIM card for given slotId
 * @return Current state of SIM card
 */
FUNCTION States GetState
(
    Id slotId IN
);

/**
 * To check whether SIM card is ready or not
 * @return true if SIM card present and ready to use i.e unlocked
 * @return false if SIM card absent or error or restricted to use or locked
 */
FUNCTION bool IsReady
(
    Id slotId IN
);

/**
 * Retrieves the SIM's ICCID
 *
 * @return LE_OK                  ICCID was read successfully.
 * @return LE_OVERFLOW            Buffer size is small.
 * @return LE_BAD_PARAMETER       Invalid parameters.
 * @return LE_FAULT               Failed to retrieve the ICCID.
 *
 */
FUNCTION le_result_t GetICCID
(
    Id        slotId IN,
    string    iccid[ICCID_LEN] OUT
);

/**
 * Retrieves IMSI (International Mobile Subscriber Identity) for the SIM.
 *
 * @return LE_OVERFLOW         Buffer size is small.
 * @return LE_BAD_PARAMETER    Invalid parameters.
 * @return LE_FAULT            Failed to retrieve the IMSI.
 * @return LE_OK               IMSI retrieved successfully.
 *
 */
FUNCTION le_result_t GetIMSI
(
    Id        slotId IN,
    string    imsi[IMSI_LEN] OUT
);

/**
 * Retrieves the name of the carrier on which this subscription is made.
 *
 * @return LE_OVERFLOW         Buffer size is small.
 * @return LE_BAD_PARAMETER    Invalid parameters.
 * @return LE_FAULT            Failed to retrieve the carrier name.
 * @return LE_OK               Carrier name retrieved successfully.
 *
 */
FUNCTION le_result_t GetHomeNetworkOperator
(
    Id        slotId IN,
    string    nameStr[100] OUT
);

/**
 * Retrieves the phone number for the SIM subscription.
 *
 * @return LE_OVERFLOW         Buffer size is small.
 * @return LE_BAD_PARAMETER    Invalid parameters.
 * @return LE_FAULT            Failed to retrieve the phone number.
 * @return LE_OK               phone number retrieved successfully.
 *
 */
FUNCTION le_result_t GetSubscriberPhoneNumber
(
    Id        slotId IN,
    string    phoneNumberStr[PHONE_NUM_MAX_LEN] OUT
);

/**
 * Retrieves the mobile network code(MNC) and mubile country code(MCC) of the carrier
 * to which phone is connected.
 *
 * @return LE_OVERFLOW         Buffer size is small.
 * @return LE_BAD_PARAMETER    Invalid parameters.
 * @return LE_FAULT            Failed to retrieve the phone number.
 * @return LE_OK               phone number retrieved successfully.
 *
 */
FUNCTION le_result_t GetHomeNetworkMccMnc
(
    Id     slotId IN,
    string mccPtr[3] OUT,
    string mncPtr[3] OUT
);

/**
 * Get slotId of current selected SIM card.
 *
 * @return slotId of current selected card.
 */
FUNCTION Id GetSelectedCard
(
);

/**
 * Select a SIM.
 *
 * @return LE_FAULT            Failed to select SIM card.
 * @return LE_OK               SIM card selected successfully.
 *
 */
FUNCTION le_result_t SelectCard
(
    Id    slotId IN
);

/**
 *  Unlock the Sim card for an app by entering PIN.
 *
 * @return LE_BAD_PARAMETER   Invalid SIM slot Id.
 * @return LE_UNDERFLOW       PIN code length is short (min 4 digits).
 * @return LE_FAULT           Failed to send unlock SIM card by PIN request.
 * @return LE_OK              Unlock SIM by password request sent successfully.
 *
 */
FUNCTION le_result_t EnterPIN
(
    Id        slotId IN,           ///< Slot ID of SIM.
    LockType  lockType IN,         ///< Applicable lock types are PIN1 and PIN2.
    string    pin[PIN_MAX_LEN] IN  ///< PIN1/PIN2.
);

/**
 * Change the password used in PIN1/PIN2 lock.
 *
 * @return LE_BAD_PARAMETER   Invalid SIM slot Id.
 * @return LE_UNDERFLOW       PIN code length is short (min 4 digits).
 * @return LE_FAULT           Failed to send change password for lock SIM card request.
 * @return LE_OK              Change SIM lock password request sent successfully.
 *
 */
FUNCTION le_result_t ChangePIN
(
    Id        slotId IN,                  ///< Slot ID of SIM.
    LockType  lockType IN,                ///< Applicable lock types are PIN1 and PIN2.
    string    oldpin[PIN_MAX_LEN] IN,     ///< Old PIN1/PIN2
    string    newpin[PIN_MAX_LEN] IN      ///< New PIN1/PIN2
);

/**
 * Get the available retry count of PIN try.
 *
 * @return LE_BAD_PARAMETER   Invalid SIM slot Id.
 * @return LE_FAULT           Failed to get the number of remaining PIN insertion tries.
 * @return A positive value   Retry count value.
 *
 */
FUNCTION int32 GetRemainingPINTries
(
    Id      slotId IN
);

/**
 * Get the remaining PUK try count.
 *
 * @return LE_BAD_PARAMETER   Invalid SIM slot Id.
 * @return LE_FAULT           Failed to get the number of remaining PUK insertion tries.
 * @return A positive value   Retry count value.
 *
 */
FUNCTION le_result_t GetRemainingPUKTries
(
    Id      slotId                 IN,
    uint32  remainingPukTriesPtr  OUT
);

/**
 * Disables PIN1 or FDN lock.
 *
 * @return LE_BAD_PARAMETER   Invalid SIM slot Id.
 * @return LE_UNDERFLOW       PIN code length is short (min 4 digits).
 * @return LE_FAULT           Failed to send disable lock SIM card request.
 * @return LE_OK              Disable SIM lock request sent successfully.
 *
 */
FUNCTION le_result_t Unlock
(
    Id        slotId IN,           ///< Slot ID of SIM
    LockType  lockType IN,         ///< Applicable lock types are PIN1 and FDN
    string    pin[PIN_MAX_LEN] IN  ///< PIN1/PIN2
);

/**
 * Enables PIN1 or FDN lock.
 *
 * @return LE_BAD_PARAMETER   Invalid SIM slot Id.
 * @return LE_UNDERFLOW       PIN code length is short (min 4 digits).
 * @return LE_FAULT           Failed to send enable lock SIM card request.
 * @return LE_OK              Enable SIM lock request sent successfully.
 *
 */
FUNCTION le_result_t Lock
(
    Id        slotId IN,           ///< Slot ID of SIM.
    LockType  lockType IN,         ///< Applicable lock types are PIN1 and FDN.
    string    pin[PIN_MAX_LEN] IN  ///< PIN1/PIN2.
);

/**
 * Unlock the Sim card for an app by entering PUK and new pin
 *
 * @return LE_BAD_PARAMETER   Invalid SIM slot Id.
 * @return LE_OUT_OF_RANGE    PUK length is not correct (8 digits).
 * @return LE_UNDERFLOW       PIN code length is short (min 4 digits).
 * @return LE_FAULT           Failed to send unlock SIM card request.
 * @return LE_OK              Unlock SIM request sent successfully.
 *
 */
FUNCTION le_result_t Unblock
(
    Id        slotId IN,              ///< Slot ID of SIM.
    LockType  lockType IN,            ///< Applicable lock types are PUK1 and PUK2.
    string    puk[PUK_MAX_LEN] IN,    ///< PUK1/PUK2.
    string    newpin[PIN_MAX_LEN] IN  ///< New PIN1/PIN2.
);

/**
 * Request eUICC identifier(EID) for the slot.
 */
FUNCTION le_result_t GetEID
(
    Id       slotId IN,
    string   eid[EID_LEN] OUT
);

/**
 * Enable or disable the automatic SIM selection.
 */
FUNCTION le_result_t SetAutomaticSelection
(
    bool enable IN
);

/**
 * Get the automatic SIM selection.
 */
FUNCTION le_result_t GetAutomaticSelection
(
    bool enable OUT
);

/**
 *Open a logical channel to the SIM.
 *
 * @return
 *      - LE_OK             Open logical channel request succeessful.
 *      - LE_BAD_PARAMETER  Invalid parameter.
 *      - LE_FAULT          Failed to open logical channel.
 */
FUNCTION le_result_t OpenLogicalChannel
(
     Id slotId IN,
     AppType apptype IN,
     uint8 channelPtr OUT
);

/**
 * Close a previously opened logical channel to the SIM.
 *
 * @return
 *      - LE_OK       Close logical channel succesful.
 *      - LE_FAULT    Failed to send request.
 */
FUNCTION le_result_t CloseLogicalChannel
(
    Id    slotId IN,
    uint8 channel IN      ///<The channel ID to be closed.
);

/**
 *  Transmit an APDU to the ICC card over a logical channel.
 *
 * @return
 *      - LE_OK             Succeeded.
 *      - LE_BAD_PARAMETER  Invalid parameter.
 *      - LE_NOT_FOUND      Failed to select the SIM card.
 *      - LE_FAULT          Failed to transmit APDU.
 */
FUNCTION le_result_t SendApduOnChannel
(
    Id           simId IN,
    uint8        channel IN,
    uint8        commandApdu[APDU_MAX_BYTES] IN,
    uint8        responseApdu[RESPONSE_MAX_BYTES] OUT
);

/**
 * Exchange APDUs with the SIM on a basic channel.
 *
 * @return
 *      - LE_OK             Function succeeded.
 *      - LE_FAULT          Failed to transmit APDU.
 *      - LE_BAD_PARAMETER  Invalid parameter.
 *      - LE_NOT_FOUND      Failed to select the SIM card.
 */
FUNCTION le_result_t SendApdu
(
    Id           simId IN,
    uint8        commandApdu[APDU_MAX_BYTES] IN,
    uint8        responseApdu[RESPONSE_MAX_BYTES] OUT
);
