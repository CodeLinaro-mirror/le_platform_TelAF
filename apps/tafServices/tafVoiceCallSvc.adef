maxThreads: 300
groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafVoiceCallSvc = ( $TELAF_ROOT/components/tafVoiceCallSvc )
}

start: auto

processes:
{
    run:
    {
        (tafVoiceCallSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
}

extern:
{
    tafVoiceCallSvc.tafVoiceCallSvc.taf_voicecall
}
