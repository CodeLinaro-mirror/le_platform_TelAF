username: telaf
maxThreads: 600
sandboxed: false

executables:
{
    tafDevInfoUnitTest = ( tafDevInfoUnitTest )
}

start: manual

processes:
{
    run:
    {
        (tafDevInfoUnitTest)
    }
    faultAction: stopApp
}

bindings:
{
    tafDevInfoUnitTest.tafDevInfoUnitTest.taf_devInfo -> tafDevInfoSvc.taf_devInfo
}
