maxThreads: 300
groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafGpioSvc = ( $TELAF_ROOT/components/tafGpioSvc )
}
start: auto

processes:
{
    run:
    {
        (tafGpioSvc)
    }

    maxFileBytes: 8192K
}

bundles:
{
    file:
    {
        [rw]     $TELAF_ROOT/components/tafGpioSvc/gpioWakeupPin.conf     /
    }
}

bindings:
{
}

extern:
{
    tafGpioSvc.tafGpioSvc.taf_gpio
}
