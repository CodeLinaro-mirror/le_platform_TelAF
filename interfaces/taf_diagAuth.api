//-------------------------------------------------------------------------------------------------
/**
 * @page c_tafDiagAuth Diag Authentication Service
 *
 * @rst :ref:`API reference <File taf_diagAuth_interface.h>` @endrst
 *
 * <HR>
 *
 * The diag Authentication service APIs are part of the diagnostic service. The
 * Authentication(0x29) service is used to secure applicable diagnostic
 * sessions/functions/services. The client request message contains the necessary
 * parameters to reference the communication configuration, certificate, and/or challenge.
 *
 * @section taf_diagAuth_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafDiagSvc platform service.
 *
 * The following example illustrates how to bind to the diag Authentication service.
 *
 * @verbatim
   bindings:
   {
        clientExe.clientComponent.taf_diagAuth -> tafDiagSvc.taf_diagAuth
   }
   @endverbatim
 *
 * @section c_taf_diagAuth_server_API Server-service APIs
 *
 * Get a diag Authentication service reference using taf_diagAuth_GetService().
 * Use the returned reference for subsequent operations.
 *
 * The following example illustrates how to set up a diag Authentication server-service-instance.
 *
 * @code
   taf_diagAuth_ServiceRef_t svcRef;    // Service reference

   // Get the service reference.
   svcRef = taf_diagAuth_GetService();
   LE_ASSERT(svcRef != NULL);
   @endcode
 *
 * @section c_taf_diagAuth_Set_VlanId Set/get VLAN ID
 *
 * After getting a service reference, an application can set the VLAN ID to the service to filter
 * Authentication requests using taf_diagAuth_SetVlanId(). It shall be called before registering
 * the handler for the Authentication(0x29) request message. An application can get the VLAN ID of
 * the request message using taf_diagAuth_GetVlanIdFromMsg().
 *
 * - taf_diagAuth_SetVlanId() -- Sets the VLAN ID.
 * - taf_diagAuth_GetVlanIdFromMsg() -- Gets the VLAN ID of the request message.
 *
 * @section c_taf_diag_authentication Authentication(0x29) service
 *
 * After getting the service reference, an application can call taf_diagAuth_AddRxMsgHandler()
 * to register a message handler for Authentication(0x29) service. Once an Authentication
 * service request message is received, the handler will be called with the message reference,
 * authTaskType passed as input parameters.
 *
 * @code
   le_result_t result;

   // Rx message handler function.
   void RxAuthEventHandler
   (
        taf_diagAuth_RxMsgRef_t rxMsgRef,
        taf_diagAuth_Type_t authTaskType,
        void* contextPtr
   )
   {
        // Process after succesfully receiving message
   }

   // Register the message handler.
   taf_diagAuth_RxMsgHandlerRef_t handlerRef =
       taf_diagAuth_AddRxMsgHandler(svcRef,
            (taf_diagAuth_RxMsgHandlerFunc_t)RxAuthEventHandler, NULL);
   LE_ASSERT(handlerRef != NULL);

   // To get the conmunication configuration.
   uint8_t commConf;
   result = taf_diagAuth_GetCommConf(rxMsgRef, &commConf);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get communication configuration.");
        return result;
   }

   // To get the certificate size.
   uint16_t certSize;
   result = taf_diagAuth_GetCertSize(rxMsgRef, &certSize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get certificate size.");
        return result;
   }

   // To get the certificate.
   uint8_t *certPtr = (uint8_t*)malloc(certSize);
   LE_ASSERT(certPtr != NULL);

   result = taf_diagAuth_GetCert(rxMsgRef, certPtr, &certSize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get certificate.");
        return result;
   }

   // To get the challenge size.
   uint16_t challengeSize;
   result = taf_diagAuth_GetChallengeSize(rxMsgRef, &challengeSize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get certificate.");
        return result;
   }

   // To get the challenge.
   uint8_t *challengePtr = (uint8_t*)malloc(challengeSize);
   LE_ASSERT(challengePtr != NULL);

   result = taf_diagAuth_GetChallenge(rxMsgRef, challengePtr, &challengeSize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get challenge.");
        return result;
   }

   // To get the proof of ownership size.
   uint16_t POWNSize;
   result = taf_diagAuth_GetPOWNSize(rxMsgRef, &POWNSize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get challenge.");
        return result;
   }

   // To get the proof of ownership.
   uint8_t *POWNPtr = (uint8_t*)malloc(POWNSize);
   LE_ASSERT(POWNPtr != NULL);

   result = taf_diagAuth_GetPOWN(rxMsgRef, POWNPtr, &POWNSize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get POWN.");
        return result;
   }

   // To get the ephemeral public key size.
   uint16_t keyize;
   result = taf_diagAuth_GetPublicKeySize(rxMsgRef, &keyize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get public key size.");
        return result;
   }

   // To get the ephemeral public key.
   uint8_t *keyPtr = (uint8_t*)malloc(keyize);
   LE_ASSERT(keyPtr != NULL);

   result = taf_diagAuth_GetPublicKey(rxMsgRef, keyPtr, &keyize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get public key.");
        return result;
   }

   // To set the role.
   result = taf_diagAuth_SetRole(rxMsgRef, roleId);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to set role id.");
        return result;
   }

   // To get the certicicate evaluation id.
   uint16_t evalId;
   result = taf_diagAuth_GetCertEvalId(rxMsgRef, &evalId);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to get evaluation id.");
        return result;
   }

   // To set the challenge for the response message.
   result = taf_diagAuth_SetChallenge(rxMsgRef, challengePtr, challengeSize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to set challenge.");
        return result;
   }

   // To set the ephemeral public key for the response message.
   result = taf_diagAuth_SetPublicKey(rxMsgRef, publicKeyPtr, publicKeySize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to set public key.");
        return result;
   }

   // To set the session key information for the response message.
   result = taf_diagAuth_SetSessKeyInfo(rxMsgRef, sessKeyInfoPtr, sessKeyInfoSize);
   if (result != LE_OK)
   {
        LE_ERROR("Fail to set session key info.");
        return result;
   }

   // To send Authentication response.
   le_result_t result = taf_diagAuth_SendResp(rxMsgRef,
            TAF_DIAGAUTH_NO_ERROR, TAF_DIAGAUTH_REQUEST_ACCEPTED);
   if (result != LE_OK)
   {
      LE_ERROR("Fail to send response.");
      return result;
   }

   // To remove the handler function, when it is not needed.
   taf_diagAuth_RemoveRxMsgHandler(handlerRef);
   @endcode
 *
 * An application can remove the Authentication server service by calling taf_diagAuth_RemoveSvc().
 *
 * @code
   le_result_t result = taf_diagAuth_RemoveSvc(svcRef);
   LE_ASSERT(result == LE_OK);
   @endcode
 *
 * <HR>
 *
 */
//-------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;


USETYPES taf_types.api;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the certificate data in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_CERT_SIZE = 8192;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the challenge data in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_CHALLENGE_SIZE = 8192;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the proof of ownership in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_POWN_SIZE = 8192;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the public key in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_PUBIC_KEY_SIZE = 4096;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the payload data in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_PAYLOAD_SIZE = 10240;

//-------------------------------------------------------------------------------------------------
/**
 * Authentication task type.
 */
//-------------------------------------------------------------------------------------------------
ENUM Type
{
    DEAUTH = 0x00,              ///< Deauthenticate.
    VERIFY_CERT_UNI,            ///< Verify unidirectional certificate.
    PROOF_OF_OWNERSHIP = 0x03,  ///< Proof of ownership.
    TRANSMIT_CERT,              ///< Transmit certificate.
    CONFIG_AUTH = 0x08          ///< Authentication configuration.
};

//-------------------------------------------------------------------------------------------------
/**
 * Authentication return value.
 */
//-------------------------------------------------------------------------------------------------
ENUM RetVal
{
    REQUEST_ACCEPTED = 0x00,    ///< Request was successful.
    GENERAL_REJECT,             ///< Request was not successful.
    AUTH_CONFIG_APCE,           ///< Indicates the provided authentication configuration
                                ///< as Authentication with PKI Certificate Exchange.
    AUTH_CONFIG_ACR_ASYM,       ///< Indicates the provided authentication configuration
                                ///< as Authentication with Challenge-Response (ACR)
                                ///< and asymmetric cryptography.
    AUTH_CONFIG_ACR_SYM,        ///< Indicates the provided authentication configuration
                                ///< as Authentication with Challenge-Response (ACR)
                                ///< and symmetric cryptography.
    DEAUTH_SUCCESS = 0x10,      ///< Deauthentication was successful, server is protected again.
    VERIFICATION_STEP1,         ///< Certificate could be verified in first step,
                                ///< second step is pending.
    VERIFICATION_STEP2,         ///< Proof of Ownership could be verified,
                                ///< Authentication is complete.
    CERT_VERIFIED               ///< Certificate could be verified.
};

//-------------------------------------------------------------------------------------------------
/**
 * Error code for authentication.
 */
//-------------------------------------------------------------------------------------------------
ENUM AuthErrorCode
{
    NO_ERROR = 0,
    INCORRECT_MSG_LEN_OR_INVALID_FORMAT = 0x13,
    CONDITIONS_NOT_CORRECT = 0x22,
    CERTIFICATE_VERIFICATION_INVALID_TIME_PERIOD = 0x50,
    CERTIFICATE_VERIFICATION_INVALID_SIGNATURE = 0x51,
    CERTIFICATE_VERIFICATION_INVALID_CHAIN_OF_TRUST = 0x52,
    CERTIFICATE_VERIFICATION_INVALID_TYPE = 0x53,
    CERTIFICATE_VERIFICATION_INVALID_FORMAT = 0x54,
    CERTIFICATE_VERIFICATION_INVALID_CONTENT = 0x55,
    CERTIFICATE_VERIFICATION_INVALID_SCOPE = 0x56,
    CERTIFICATE_VERIFICATION_INVALID_CERTIFICATE = 0x57,
    OWNERSHIP_VERIFICATION_FAILED = 0x58,
    CHALLENGE_CALCULATION_FAILED = 0x59,
    SETTING_ACCESS_RIGHTS_FAILED = 0x5A,
    SESSION_KEY_CREATION_OR_DERIVATION_FAILED = 0x5B,
    CONFIGURATION_DATA_USAGE_FAILED = 0x5C,
    DEAUTHENTICATION_FAILED = 0x5D
};

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the Authentication service.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE Service;

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the Authentication received request message.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE RxMsg;

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the Authentication expiry notification message.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE StateExpMsg;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the reference to an Authentication service, if there is no Authentication service,
 * a new one will be created.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - Reference to the service instance.
 *     - NULL if not allowed to create the service.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION Service GetService
(
) = 0;

//--------------------------------------------------------------------------------------------------
/**
 * Sets VLAN ID to the service to filter authentication requests.
 * If the VLAN ID is not found or does not exist, it will return an error.
 * This function shall be called before registering RxMsgHandler and AuthStateExpHandler.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid svcRef or vlanId is 0.
 *     - LE_NO_MEMORY -- Memory not allocated.
 *     - LE_UNSUPPORTED -- VLAN ID is unknown.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetVlanId
(
    Service svcRef IN,      ///< Service reference.
    uint16 vlanId IN        ///< VLAN ID
) = 1;

//-------------------------------------------------------------------------------------------------
/**
 * Handler for an Rx Authentication message.
 *
 * @instaging
 *
 * @param[in] rxMsgRef     Received message reference.
 * @param[in] authTaskType Authentication task type.
 * @param[in] contextPtr   Context pointer.
 */
//-------------------------------------------------------------------------------------------------
HANDLER RxMsgHandler
(
    RxMsg rxMsgRef  IN,          ///< Received message reference.
    Type authTaskType  IN        ///< Authentication task type.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information on Rx Authentication message.
 *
 * @instaging
 */
//-------------------------------------------------------------------------------------------------
EVENT RxMsg
(
    Service svcRef IN,      ///< Service reference.
    RxMsgHandler handler
) = (2,3);

//-------------------------------------------------------------------------------------------------
/**
 * Handler for the authentication expiry.
 *
 * @instaging
 *
 * @param[in] expMsg     Authentication expiry notification message.
 * @param[in] vlanId     VLAN ID.
 * @param[in] roleId     Role ID.
 * @param[in] contextPtr Context pointer.
 */
//-------------------------------------------------------------------------------------------------
HANDLER AuthStateExpHandler
(
    StateExpMsg expMsg IN,  ///< Authentication expiry notification message.
    uint16 vlanId IN,       ///< VLAN ID.
    uint64 roleId IN        ///< Role ID.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information on Rx Authentication message.
 *
 * @instaging
 */
//-------------------------------------------------------------------------------------------------
EVENT AuthStateExp
(
    Service svcRef IN,              ///< Service reference.
    AuthStateExpHandler handler
) = (4,5);

//-------------------------------------------------------------------------------------------------
/**
 * Gets the communication configuration of the Rx VERIFY_CERT_UNI
 * Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef or commConf.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- VERIFY_CERT_UNI subfunction is not available.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCommConf
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint8 commConf  OUT                       ///< Communication configuration.
) = 6;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the size of client certificate of the Rx VERIFY_CERT_UNI/TRANSMIT_CERT
 * Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- VERIFY_CERT_UNI or TRANSMIT_CERT subfunction is not available.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCertSize
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint16 size  OUT                          ///< The size of certificate.
) = 7;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the size of client certificate of the Rx VERIFY_CERT_UNI/TRANSMIT_CERT
 * Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- VERIFY_CERT_UNI or TRANSMIT_CERT subfunction is not available.
 *     - LE_OVERFLOW -- Insufficient certificate buffer size.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCert
(
    RxMsg rxMsgRef  IN,                     ///< Received message reference.
    uint8 cert[MAX_CERT_SIZE]  OUT          ///< The client certificate.
) = 8;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the size of client challenge of the Rx VERIFY_CERT_UNI Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- VERIFY_CERT_UNI subfunction is not available.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetChallengeSize
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint16 size  OUT                          ///< The size of client challenge.
) = 9;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the data of client challenge of the Rx VERIFY_CERT_UNI Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- VERIFY_CERT_UNI subfunction is not available.
 *     - LE_OVERFLOW -- Insufficient challenge buffer size.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetChallenge
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint8 challenge[MAX_CHALLENGE_SIZE] OUT   ///< The client challenge.
) = 10;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the size of proof of ownership in the Rx PROOF_OF_OWNERSHIP
 * Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- PROOF_OF_OWNERSHIP subfunction is not available.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPOWNSize
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint16 size  OUT                          ///< The size of proof of ownership.
) = 11;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the data of proof of ownership in the Rx PROOF_OF_OWNERSHIP
 * Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- PROOF_OF_OWNERSHIP subfunction is not available.
 *     - LE_OVERFLOW -- Insufficient proof buffer size.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPOWN
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint8 proof[MAX_POWN_SIZE]  OUT           ///< The data of proof of ownership.
) = 12;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the size of public key of proof of ownership in the Rx PROOF_OF_OWNERSHIP
 * Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- PROOF_OF_OWNERSHIP subfunction is not available.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPublicKeySize
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint16 size  OUT                          ///< The size of ephemeral public key.
) = 13;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the public key of proof of ownership of the Rx PROOF_OF_OWNERSHIP
 * Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- PROOF_OF_OWNERSHIP subfunction is not available.
 *     - LE_OVERFLOW -- Insufficient PublicKey buffer size.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPublicKey
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint8 publicKey[MAX_PUBIC_KEY_SIZE]  OUT  ///< The ephemeral public key.
) = 14;

//-------------------------------------------------------------------------------------------------
/**
 * Sets the role of the Rx PROOF_OF_OWNERSHIP Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- PROOF_OF_OWNERSHIP subfunction is not available.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetRole
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint64 role  IN                           ///< The role of proof of ownership.
) = 15;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the certificate evaluation ID of the Rx TRANSMIT_CERT
 * Authentication message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- TRANSMIT_CERT subfunction is not available.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCertEvalId
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint16 id  OUT                             ///< The certificate evaluation ID.
) = 16;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN ID of the Rx authenticate message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- VLAN ID not found.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVlanIdFromMsg
(
    RxMsg rxMsgRef  IN,    ///< Receive message reference.
    uint16 vlanId   OUT    ///< VLAN ID.
) = 17;

//-------------------------------------------------------------------------------------------------
/**
 * Sets the server challenge for the response of the Rx Authentication VERIFY_CERT_UNI message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- VERIFY_CERT_UNI subfunction is not available.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetChallenge
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint8 challenge[MAX_CHALLENGE_SIZE] IN    ///< The server challenge.
) = 18;

//-------------------------------------------------------------------------------------------------
/**
 * Sets the server public key for the response of the Rx Authentication VERIFY_CERT_UNI message.
 * It shall be called after SetChallenge.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- VERIFY_CERT_UNI subfunction is not available.
 *     - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPublicKey
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint8 publicKey[MAX_PUBIC_KEY_SIZE] IN    ///< The server public key.
) = 19;

//-------------------------------------------------------------------------------------------------
/**
 * Sets the session key information for the response of the Rx Authentication
 * PROOF_OF_OWNERSHIP message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_OUT_OF_RANGE -- PROOF_OF_OWNERSHIP subfunction is not available.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetSessKeyInfo
(
    RxMsg rxMsgRef  IN,                       ///< Received message reference.
    uint8 sessKeyInfo[MAX_PUBIC_KEY_SIZE] IN  ///< The session key information.
) = 20;

//-------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the Rx Authentication message.
 *
 * @b NOTE: This function must be called to send a response if receiving a message.
 *
 * @b NOTE: The process exits if an invalid reference is passed.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendResp
(
    RxMsg rxMsgRef  IN,                  ///< Received message reference.
    uint8 errCode  IN,                   ///< Error code type.
    uint8 retVal  IN                     ///< Authentication result.
) = 21;

//--------------------------------------------------------------------------------------------------
/**
 * Releases an authentication expiry notification message.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ReleaseAuthExpMsg
(
    StateExpMsg expMsg IN    ///< Authentication expiry notification reference.
) = 22;

//-------------------------------------------------------------------------------------------------
/**
 * Removes the Authentication server service.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid svcRef.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveSvc
(
    Service svcRef  IN    ///< Service reference.
) = 23;
