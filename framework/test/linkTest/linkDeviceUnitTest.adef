maxThreads: 600
start: manual
sandboxed: true

username: appdefault
requires:
{
    device:
    {
        [rw] /dev/console /dev/console
        [r]  /dev/urandom /dev/urandom2
    }
}

capability:
{
    CAP_WAKE_ALARM
    CAP_FOWNER
    CAP_SYS_ADMIN
    CAP_BLOCK_SUSPEND
    CAP_DAC_READ_SEARCH
    CAP_DAC_OVERRIDE
}

executables:
{
     linkDeviceUnitTest = (linkDevComponent)
}

processes:
{
    run:
    {
        (linkDeviceUnitTest)
    }
}
