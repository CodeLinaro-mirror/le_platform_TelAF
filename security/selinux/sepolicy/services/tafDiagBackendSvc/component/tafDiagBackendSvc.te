policy_module(tafDiagBackendSvc, 1.0)

# Framework definition for telaf

gen_require(`
  type node_t;
  type unreserved_port_t;
  type telaf_admin_t;
  type kernel_t;
')


type telaf_tafDiagBackendSvc_exec_t;
files_type(telaf_tafDiagBackendSvc_exec_t);

type telaf_tafDiagBackendSvc_t;

type telaf_tafDiagBackendSvc_data_t;
files_type(telaf_tafDiagBackendSvc_data_t);

init_telaf_app_domain(telaf_tafDiagBackendSvc_t,telaf_tafDiagBackendSvc_exec_t)


# Allow service to manage its own data directory; registers with admin domain.
telaf_manage_app_data_files(telaf_tafDiagBackendSvc_t, telaf_tafDiagBackendSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafDiagBackendSvc_exec_t)

# Network routing: netlink_route_socket + net_admin + kernel network state.
telaf_use_network_routing(telaf_tafDiagBackendSvc_t)
# TCP/UDP socket creation.
telaf_create_stream_sockets(telaf_tafDiagBackendSvc_t)
# Bind to unreserved ports and node addresses.
telaf_bind_network_ports(telaf_tafDiagBackendSvc_t)

# Additional socket options not covered by the standard interfaces.
allow telaf_tafDiagBackendSvc_t self:tcp_socket { accept listen shutdown ioctl };
allow telaf_tafDiagBackendSvc_t self:udp_socket { ioctl };
allow telaf_tafDiagBackendSvc_t self:netlink_route_socket { bind nlmsg_read };
allow telaf_tafDiagBackendSvc_t telaf_admin_t:fifo_file { ioctl };
allow telaf_tafDiagBackendSvc_t kernel_t:system { module_request };
