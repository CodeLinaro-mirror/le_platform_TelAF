sandboxed: false

executables:
{
    tafDataAccessTest = ( tafDataAccessTestComp )
}

start: manual

processes:
{
    run:
    {
        (tafDataAccessTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
    faultAction: stopApp

    maxFileBytes: 1048576K
}

// Add SELinux module
components:
{
    $TELAF_ROOT/security/selinux/sepolicy/test/tafDataAccessTest/component
}
