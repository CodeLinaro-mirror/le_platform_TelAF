maxThreads: 600

username: telaf

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
        CAP_FOWNER
        CAP_SYS_ADMIN
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

executables:
{
        tafMngdSecStorageSvc = ( $TELAF_ROOT/apps/tafMngdServices/Storage/Components/tafMngdSecStorageSvc )
        tafMngdCfgStorageSvc = ( $TELAF_ROOT/apps/tafMngdServices/Storage/Components/tafMngdCfgStorageSvc )
}

start: auto

processes:
{
        run:
        {
                (tafMngdSecStorageSvc)
                (tafMngdCfgStorageSvc)
        }

        maxFileBytes: 8192K
        faultAction: stopApp
}

sandboxed: false

bindings:
{
    tafMngdSecStorageSvc.tafMngdSecStorageSvc.taf_ks -> tafKeyStoreSvc.taf_ks
    tafMngdSecStorageSvc.tafMngdSecStorageSvc.le_appInfo -> <root>.le_appInfo
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.taf_ks -> tafKeyStoreSvc.taf_ks
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.le_appInfo -> <root>.le_appInfo
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.le_cfg -> <root>.le_cfg
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.le_cfgAdmin -> <root>.le_cfgAdmin
}

bundles:
{
    file:
    {
        [rw]  $TELAF_ROOT/apps/tafMngdServices/Storage/Components/tafMngdCfgStorageSvc/config/tafMngdStorageConfig.json  /data/ManagedServices/
    }
}

// Directory in which configuration JSONs will be installed
requires:
{
    dir:
    {
        /data/ManagedServices /
    }

    configTree:
    {
        [w] .
    }

}

extern:
{
    tafMngdSecStorageSvc.tafMngdSecStorageSvc.taf_mngdStorSec
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.taf_mngdStorCfg
}
