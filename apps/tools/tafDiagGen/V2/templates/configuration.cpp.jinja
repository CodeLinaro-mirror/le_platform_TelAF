        if (nodeName == "{{ nodeName }}")
        {
        {{ generate_validation_loop_for_node(nodeName) }}
        }
        {% endif %}
        {% endfor %}

        return false;
    }
};

EXPORT_SYM bool validate_base_record(const uint8_t* dataRecord, size_t recordLength, const std::string nodeName) {
        return BaseValidator::validate(dataRecord, recordLength, nodeName);
}



EXPORT_SYM void init()
{
    LE_INFO("Diagnostic Configuration (v:%s, t:%s)",
            tafDiagGen_tool_version,
            tafDiagGen_tool_timestamp);

    try
    {
        checker_map = std::make_shared<std::unordered_map<uint16_t, std::shared_ptr<DidChecker>>>();

        {% for did_code, did_node in root.did_all.items() if did_node.supported_functions.write_did == true or did_node.supported_functions.io_control == true %}
        {
            /* -- DID: {{ did_code | f_to_hex_format(4) }} -- */

            std::shared_ptr<DidChecker> did_checker = std::make_shared<DidChecker>({{ did_code | f_to_hex_format(4) }}, {{ did_node.implementation.did_size }} /* did_size Bytes */);

        {% for byte_start_idx, data_ref_map in did_node.implementation.bytes.items() %}
            {% for bit_start_idx, data_ref in data_ref_map.items() %}
            {% set data_item = data_ref.data_ref_mnemonic | f_to_data_item(root) -%}
            {# ----------------------------------------------------------------------------------- #}
            {% if data_item.functional_definition.data_type == "Not numeric" %}
                {% if 'forbidden_characters' in data_item.functional_definition %}
            std::shared_ptr<std::vector<uint8_t>> forbidden_characters_{{byte_start_idx}}_{{bit_start_idx}} =
                std::make_shared<std::vector<uint8_t>>(std::initializer_list<uint8_t> {{ data_item.functional_definition.forbidden_characters | f_forbidden_characters_conversion(data_item) }});
                {% else %}
            std::shared_ptr<std::vector<uint8_t>> forbidden_characters_{{byte_start_idx}}_{{bit_start_idx}} = nullptr;
                {% endif %}

                {% if 'forbidden_values' in data_item.functional_definition %}
            std::shared_ptr<std::vector< std::shared_ptr<std::vector<uint8_t>> >> forbidden_values_{{byte_start_idx}}_{{bit_start_idx}} =
                std::make_shared<std::vector<std::shared_ptr<std::vector<uint8_t>>>>(
                    std::initializer_list<std::shared_ptr<std::vector<uint8_t>>>{{ data_item.functional_definition.forbidden_values | f_forbidden_values_conversion(data_item) }}
                );
                {% else %}
            std::shared_ptr<std::vector< std::shared_ptr<std::vector<uint8_t>> >> forbidden_values_{{byte_start_idx}}_{{bit_start_idx}} = nullptr;
                {% endif %}

            std::shared_ptr<NotNumeric> checker_{{byte_start_idx}}_{{bit_start_idx}} = std::make_shared<NotNumeric>
            (
                {{byte_start_idx}} * 8 + (7 - {{bit_start_idx}}),
                {{data_item.functional_definition.bit_size}},
                forbidden_characters_{{byte_start_idx}}_{{bit_start_idx}},
                forbidden_values_{{byte_start_idx}}_{{bit_start_idx}}
            );

            {# ----------------------------------------------------------------------------------- #}
            {% elif data_item.functional_definition.data_type == "Numeric" %}

                {% if 'min' in data_item.functional_definition and 'max' in data_item.functional_definition %}
                {{ data_item|f_check_min_max(data_item.functional_definition.min, data_item.functional_definition.max) }}
            std::shared_ptr<Numeric> checker_{{byte_start_idx}}_{{bit_start_idx}} = std::make_shared<Numeric>
            (
                {{byte_start_idx}} * 8 + (7 - {{bit_start_idx}}),
                {{data_item.functional_definition.bit_size}},
                {{data_item.functional_definition.min}},
                {{data_item.functional_definition.max}}
            );
                {% elif 'coding' in data_item.functional_definition %}
            std::shared_ptr<std::vector<uint32_t>> coding_{{byte_start_idx}}_{{bit_start_idx}} =
                std::make_shared<std::vector<uint32_t>>(std::initializer_list<uint32_t> {{ data_item.functional_definition.coding | f_coding_list_conversion() }});

            std::shared_ptr<Numeric> checker_{{byte_start_idx}}_{{bit_start_idx}} = std::make_shared<Numeric>
            (
                {{byte_start_idx}} * 8 + (7 - {{bit_start_idx}}),
                {{data_item.functional_definition.bit_size}},
                coding_{{byte_start_idx}}_{{bit_start_idx}}
            );
                {% else %}
                {{ raise_exception("Bad Not numeric data item") }}
                {% endif %}

            {# ----------------------------------------------------------------------------------- #}
            {% elif data_item.functional_definition.data_type == "Numeric list" %}

            std::shared_ptr<std::vector<uint32_t>> coding_{{byte_start_idx}}_{{bit_start_idx}} =
                std::make_shared<std::vector<uint32_t>>(std::initializer_list<uint32_t> {{ data_item.functional_definition.coding | f_coding_list_conversion() }});

            std::shared_ptr<NumericList> checker_{{byte_start_idx}}_{{bit_start_idx}} = std::make_shared<NumericList>
            (
                {{byte_start_idx}} * 8 + (7 - {{ bit_start_idx }}),
                {{data_item.functional_definition.bit_size}},
                coding_{{byte_start_idx}}_{{bit_start_idx}}
            );

            {% else %}
                {{ raise_exception("Unknow type({}) for data item".format(data_item.functional_definition.data_type)) }}
            {% endif %}
            did_checker->append(checker_{{byte_start_idx}}_{{bit_start_idx}});
            {% endfor %}
        {% endfor %}

            checker_map->emplace({{ did_code | f_to_hex_format(4) }}, did_checker);
        }
        {% endfor %}
    }
    catch (const std::exception& e)
    {
        LE_FATAL("Initialization failed: (%s) <-", e.what());
    }
}

}
