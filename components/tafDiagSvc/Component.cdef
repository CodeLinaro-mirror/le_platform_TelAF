provides:
{
    api:
    {
        taf_diagDataID.api
        taf_diagSecurity.api
#if ${LE_CONFIG_DIAG_VSTACK} = ""
        taf_diagRoutineCtrl.api
        taf_diagUpdate.api
        taf_diagReset.api
        taf_diagEvent.api
        taf_diagDTC.api
        taf_diagIOCtrl.api
        taf_diagDoIP.api
#endif
    }
}

requires:
{
#if ${LE_CONFIG_DIAG_VSTACK} = ""
    component:
    {
        $TELAF_ROOT/components/tafDiagSvc/tafDiagCfg
        $TELAF_ROOT/components/tafUDSStack
        $TELAF_ROOT/components/tafDataAccessComp
    }
#endif
#if ${LE_CONFIG_DIAG_VSTACK} = y
    api:
    {
        taf_diagBackend.api
    }
#endif
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
#if ${LE_CONFIG_DIAG_VSTACK} = ""
    -I$TELAF_ROOT/components/tafUDSStack
    -I$TELAF_ROOT/components/tafDataAccessComp
    -I$TELAF_ROOT/components/tafDiagSvc/tafDiagCfg
    -I$TELAF_ROOT/components/tafDoIPStack
#endif
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
#if ${LE_CONFIG_DIAG_VSTACK} = ""
    -I$TELAF_ROOT/components/tafUDSStack
    -I$TELAF_ROOT/components/tafDataAccessComp
    -I$TELAF_ROOT/components/tafDoIPStack
#endif
}

sources:
{
        tafDataIDSvc.cpp
        tafDataIDSvrImpl.cpp
        tafSecuritySvc.cpp
        tafSecuritySvrImpl.cpp
        tafDiagFrontend.cpp
        tafDiagBackend.cpp
