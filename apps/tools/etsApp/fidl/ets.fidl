	<**
		@description : Get last value of TestEventUINT8Reliable.
	**>
	method clientServiceGetLastValueOfEventTCP {
		out {
			<**
				@description : The unicast event value.
			**>
			UInt8 clientServiceGetLastValueOfEventTCP_ResArg1
		}
	}

	<**
		@description : Requests to trigger an broadcast event of type uint8 over reliable endpoint.
	**>
