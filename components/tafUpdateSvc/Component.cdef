provides:
{
    api:
    {
        taf_update.api
        taf_appMgmt.api
        taf_fwupdate.api
    }
}

requires:
{
    api:
    {
        le_update.api
        le_updateCtrl.api

        le_appRemove.api
        le_appCtrl.api
        le_appInfo.api
        le_cfg.api

        taf_update_pa.api    [types-only]
        taf_dcs.api
#if ${TARGET} = sa515m
        taf_mrc.api
#endif
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        taf_update_pa
    }

    lib:
    {
        lib/libtelux_tel.so
        lib/libtelux_data.so
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/components/tafUpdateSvc/taf_update_pa
    -I$TELAF_ROOT/include
    -ltelux_tel
    -ltelux_data
    -lComponent_taf_update_pa
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
}

sources:
{
    tafUpdateSvc.cpp
    tafUpdateImpl.cpp
    tafAppMgmtSvc.cpp
    tafAppMgmtImpl.cpp
    tafFwUpdateSvc.cpp
    tafFwUpdateImpl.cpp
}

