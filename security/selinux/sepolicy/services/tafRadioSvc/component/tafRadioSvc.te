policy_module(tafRadioSvc, 1.0)

# Framework definition for telaf
type telaf_tafRadioSvc_exec_t;
files_type(telaf_tafRadioSvc_exec_t);

type telaf_tafRadioSvc_t;

type telaf_tafRadioSvc_data_t;
files_type(telaf_tafRadioSvc_data_t);

ifdef(`sa525m',`
    telux_allow_tel_network_selection_read(telaf_tafRadioSvc_t)
    telux_allow_tel_srv_system_read(telaf_tafRadioSvc_t)
    telux_allow_tel_srv_system_config(telaf_tafRadioSvc_t)
    telux_allow_tel_phone_mgmt(telaf_tafRadioSvc_t)
    telux_allow_tel_network_selection_ops(telaf_tafRadioSvc_t)
    telux_allow_tel_private_info_read(telaf_tafRadioSvc_t)
    telux_allow_tel_ims_settings(telaf_tafRadioSvc_t)

    telux_allow_data(telaf_tafRadioSvc_t)
    telux_allow_data_setting(telaf_tafRadioSvc_t)
')

init_telaf_app_domain(telaf_tafRadioSvc_t,telaf_tafRadioSvc_exec_t)

# Allow update daemon to install/uninstall this service
telaf_admin_manage_all_files_perms(telaf_tafRadioSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafRadioSvc_exec_t)
