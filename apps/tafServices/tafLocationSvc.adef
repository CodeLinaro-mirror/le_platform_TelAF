executables:
{
        tafLocationSvc = ( $TELAF_ROOT/components/tafLocationSvc )
}

start: auto

processes:
{
        run:
        {
            (tafLocationSvc)
        }

        faultAction: restart

        #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
                maxWatchdogTimeout: 100000
        #else
                watchdogTimeout: never
        #endif
}

sandboxed: false

bindings:
{
}

extern:
{
        tafLocationSvc.tafLocationSvc.taf_gnss
        tafLocationSvc.tafLocationSvc.taf_pos
        tafLocationSvc.tafLocationSvc.taf_posCtrl
}
