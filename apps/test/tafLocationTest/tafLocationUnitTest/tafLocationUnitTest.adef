username: telaf
maxThreads: 600
sandboxed: false
executables:
{
    tafLocationUnitTest = ( tafLocationUnitTestComp )
}


processes:
{
    run:
    {
        (tafLocationUnitTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafLocationUnitTest.tafLocationUnitTestComp.taf_locGnss -> tafLocationSvc.taf_locGnss
    tafLocationUnitTest.tafLocationUnitTestComp.taf_locPos -> tafLocationSvc.taf_locPos
    tafLocationUnitTest.tafLocationUnitTestComp.taf_locPosCtrl -> tafLocationSvc.taf_locPosCtrl
}
