maxThreads: 600

username: telaf

startGroup: 12

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafNtnSvc = ( $TELAF_ROOT/components/tafNtnSvc )
}

start: auto

processes:
{
    run:
    {
        (tafNtnSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

extern:
{
    tafNtnSvc.tafNtnSvc.taf_ntn
}
