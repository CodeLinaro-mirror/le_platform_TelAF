package someip.testability

interface ETS {
	version {
		major 1
		minor 0
	}

	enumeration Enum {
		UNKNOWN = 1
		ONE = 2
		TWO = 3
		THREE = 4
		FOUR = 5
	}

	struct VersionType {
		UInt8 majorVersion
		UInt32 minorVersion
	}

	array uint8ArrayArray of UInt8

	array uint8ArrayReturnArray of UInt8

	<**
		@description : Check byte order handling of parameters.
	**>
	method checkByteOrder {
		in {
			<**
				@description : The first summand parameter.
			**>
			UInt8 checkByteOrder_ReqArg1
			<**
				@description : The second summand parameter.
			**>
			UInt16 checkByteOrder_ReqArg2
		}
		out {
			<**
				@description : The summation of input parameters.
			**>
			UInt32 checkByteOrder_ResArg1
		}
	}

	<**
		@description : Activates the remote client prxoy in the server side.
	**>
	method clientServiceActivate fireAndForget {
		in {
			<**
				@description : Wait time before triggering client proxy start.
			**>
			UInt8 clientServiceActivate_ReqArg1
		}
	}

	<**
		@description : Deactivates the remote client prxoy in the server side.
	**>
	method clientServiceDeactivate fireAndForget {
		in {
			<**
				@description : Wait time before triggering client proxy stop.
			**>
			UInt8 clientServiceDeactivate_ReqArg1
		}
	}

	<**
		@description : Get last value of multicast event triggered by service running in client side.
	**>
	method clientServiceGetLastValueOfEventUDPMulticast {
		out {
			<**
				@description : The multicast event value.
			**>
			UInt8 clientServiceGetLastValueOfEventUDPMulticast_ResArg1
		}
	}

	<**
		@description : Get last value of unicast event triggered by service launched in client side.
	**>
	method clientServiceGetLastValueOfEventUDPUnicast {
		out {
			<**
				@description : The unicast event value.
			**>
			UInt8 clientServiceGetLastValueOfEventUDPUnicast_ResArg1
		}
	}

	<**
		@description : Subscribe to the event offered by service launched in client side.
	**>
	method clientServiceSubscribeEventgroup fireAndForget {
		in {
			<**
				@description : Wait time before sending the subscription request.
			**>
			UInt32 clientServiceSubscribeEventgroup_ReqArg1
			<**
				@description : After this duration subscription should be canceled.
			**>
			UInt32 clientServiceSubscribeEventgroup_ReqArg2
		}
	}

	<**
		@description : Reverse the bits of all the input parameters and return it back.
	**>
	method echoBitfields {
		in {
			<**
				@description : 8 bit parameter.
			**>
			UInt8 echoBitfields_ReqArg1
			<**
				@description : 16 bit parameter.
			**>
			UInt16 echoBitfields_ReqArg2
			<**
				@description : 32 bit parameter.
			**>
			UInt32 echoBitfields_ReqArg3
		}
		out {
			<**
				@description : parameter with reverse bit pattern of 8 bit input parameter.
			**>
			UInt8 echoBitfields_ResArg1
			<**
				@description : parameter with reverse bit pattern of 16 bit input parameter.
			**>
			UInt16 echoBitfields_ResArg2
			<**
				@description : parameter with reverse bit pattern of 32 bit input parameter.
			**>
			UInt32 echoBitfields_ResArg3
		}
	}

	<**
		@description : Returns the input parameters in reverse order.
	**>
	method echoCommonDatatypes {
		in {
			<**
				@description : A boolean parameter.
			**>
			Boolean EchoCommonDatatypes_ReqArg1
			<**
				@description : An uint8 parameter.
			**>
			UInt8 EchoCommonDatatypes_ReqArg2
			<**
				@description : An uint16 parameter.
			**>
			UInt16 EchoCommonDatatypes_ReqArg3
			<**
				@description : An uint32 parameter.
			**>
			UInt32 EchoCommonDatatypes_ReqArg4
			<**
				@description : A int8 parameter.
			**>
			Int8 EchoCommonDatatypes_ReqArg5
			<**
				@description : A int16 parameter.
			**>
			Int16 EchoCommonDatatypes_ReqArg6
			<**
				@description : A int32 parameter.
			**>
			Int32 EchoCommonDatatypes_ReqArg7
			<**
				@description : A float parameter.
			**>
			Float EchoCommonDatatypes_ReqArg8
			<**
				@description : A double parameter.
			**>
			Double EchoCommonDatatypes_ReqArg9
		}
		out {
			<**
				@description : A double parameter.
			**>
			Double EchoCommonDatatypes_ResArg1
			<**
				@description : A float parameter.
			**>
			Float EchoCommonDatatypes_ResArg2
			<**
				@description : A int32 parameter.
			**>
			Int32 EchoCommonDatatypes_ResArg3
			<**
				@description : A int16 parameter.
			**>
			Int16 EchoCommonDatatypes_ResArg4
			<**
				@description : A int8 parameter.
			**>
			Int8 EchoCommonDatatypes_ResArg5
			<**
				@description : An uint32 parameter.
			**>
			UInt32 EchoCommonDatatypes_ResArg6
			<**
				@description : An uint16 parameter.
			**>
			UInt16 EchoCommonDatatypes_ResArg7
			<**
				@description : An uint8 parameter.
			**>
			UInt8 EchoCommonDatatypes_ResArg8
			<**
				@description : A boolean parameter.
			**>
			Boolean EchoCommonDatatypes_ResArg9
		}
	}

	<**
		@description : Returns back the ENUM passed as input parameter.
