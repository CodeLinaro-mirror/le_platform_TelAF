	attribute UInt8 [ ] TestFieldUINT8Array

	<**
		@description : A field of UINT8 type over reliable endpoint.
	**>
	attribute UInt8 TestFieldUINT8Reliable

	<**
		@description : The method returns the transfered UINT8 value back to the invoker over reliable endpoint.
