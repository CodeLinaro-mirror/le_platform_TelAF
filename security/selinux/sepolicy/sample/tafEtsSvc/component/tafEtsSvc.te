policy_module(tafEtsSvc, 1.0)

gen_require(`
  type sysfs_t;
  type systemd_tmpfiles_t;
  type tmp_t;
  type proc_net_t;
  type unreserved_port_t;
  type node_t;
')

# Framework definition for telaf
type telaf_tafEtsSvc_exec_t;
files_type(telaf_tafEtsSvc_exec_t);

type telaf_tafEtsSvc_t;

type telaf_tafEtsSvc_data_t;
files_type(telaf_tafEtsSvc_data_t);

# Run the service in its own confined domain
init_telaf_app_domain(telaf_tafEtsSvc_t,telaf_tafEtsSvc_exec_t)

# Allow update daemon to install/uninstall this service
telaf_admin_manage_all_files_perms(telaf_tafEtsSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafEtsSvc_exec_t)

# Allow systemd to get attribute of /tmp/vsomeip-0
allow systemd_tmpfiles_t tmp_t:sock_file { getattr };

# Allow tafEtsSvc to manipulate dir in tmpfs
allow telaf_tafEtsSvc_t tmp_t:dir manage_dir_perms;

# Allow tafEtsSvc to manipulate file in tmpfs
allow telaf_tafEtsSvc_t tmp_t:file manage_file_perms;

# Allow tafEtsSvc to manipulate sock file in tmpfs
allow telaf_tafEtsSvc_t tmp_t:sock_file manage_sock_file_perms;

# Allow tafEtsSvc to manipulate udp/tcp socket
allow telaf_tafEtsSvc_t self:udp_socket create_socket_perms;
allow telaf_tafEtsSvc_t self:tcp_socket create_stream_socket_perms;

# Allow tafEtsSvc to manipulate netlink_route_socket
allow telaf_tafEtsSvc_t self:netlink_route_socket rw_netlink_socket_perms;

# Allow telaf_tafEtsSvc_t to manipulate capabilites
allow telaf_tafEtsSvc_t self:capability { net_admin };
allow telaf_tafEtsSvc_t self:capability { sys_resource };

# Misc rules for network socket
allow telaf_tafEtsSvc_t proc_net_t:file read_file_perms;
allow telaf_tafEtsSvc_t { unreserved_port_t node_t }:udp_socket { name_bind node_bind };
allow telaf_tafEtsSvc_t { unreserved_port_t node_t }:tcp_socket { name_bind node_bind name_connect };

# Allow telaf_tafEtsSvc_t and telaf_tafSomeipGWSvc_t connect to each other
telaf_tafSomeipGWSvc_connect(telaf_tafEtsSvc_t)

# Allow telaf_tafEtsSvc_t and telaf_tafSomeipGWSvc_t write to each other
telaf_tafSomeipGWSvc_write(telaf_tafEtsSvc_t)