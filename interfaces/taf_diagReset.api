USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * Reset type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Type
{
    HARD_RESET = 0x01,                  ///< Power-on/start-up sequence.
    KEY_OFF_ON_RESET,                   ///< Key-off-on sequence.
    SOFT_RESET,                         ///< Resart application program.
    ENABLE_RAPID_POWER_SHUTDOWN_RESET,  ///< Enable the 'rapid power shut down' function.
    DISABLE_RAPID_POWER_SHUTDOWN_RESET, ///< Disable the 'rapid power shut down' function.
    ALL_RESET = 0xFF                    ///< Include all of the reset types.
};

//--------------------------------------------------------------------------------------------------
/**
 * Error code for Reset.
 */
//--------------------------------------------------------------------------------------------------
ENUM ErrorCode
{
    NO_ERROR = 0,
    CONDITIONS_NOT_CORRECT = 0x22
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the Reset service.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Service;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the Reset received request message.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE RxMsg;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference to a Reset service, if there's no Reset service, a new one will be created.
 *
 * @return
 *     - Reference to the service instance.
 *     - NULL if not allowed to create the service.
 *
 * @note The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Service GetService
(
    Type resetType
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for a Rx Reset message.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RxMsgHandler
(
    RxMsg rxMsgRef  IN,    ///< Received message reference.
    Type resetType  IN     ///< Reset type.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on Rx Reset message.
 */
//--------------------------------------------------------------------------------------------------
EVENT RxMsg
(
    Service svcRef IN,      ///< Service reference.
    RxMsgHandler handler    ///< Received message handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the Rx Reset message.
 *
 * @note This function must be called to send a response if receiving a message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_FAULT -- Failed.
 *
 * @note The process exits if an invalid reference is passed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendResp
(
    RxMsg rxMsgRef  IN,      ///< Received message reference.
    ErrorCode errCode  IN    ///< Error code type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes the Reset service.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid svcRef.
 *     - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveSvc
(
    Service svcRef  IN    ///< Service reference.
);