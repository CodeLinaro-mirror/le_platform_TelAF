username: telaf
maxThreads: 600
sandboxed: false

executables:
{
    tafAdefUnitTest = ( tafAdefUnitTestComp )
}

start: manual

processes:
{
    run:
    {
        (tafAdefUnitTest)
    }

    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }

    faultAction: stopApp
}

bindings:
{
    tafAdefUnitTest.tafAdefUnitTestComp.le_cfgAdmin -> <tafcore>.le_cfgAdmin
}
