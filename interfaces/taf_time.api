//--------------------------------------------------------------------------------------------------
/**
 *
 * @page c_tafTime Time Service
 *
 * @rst :ref:`API reference <File taf_time_interface.h>` @endrst
 *
 * @rst :ref:`HAL APIs <File tafHalTime.h>` @endrst
 *
 * <HR>
 *
 * The Time Service provides APIs that allow customer applications to set the system time
 * and get the system, network, and GNSS time.
 *
 * @section taf_time_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafTimeSvc service.
 *
 * The following example illustrates how to bind to the Time service.
 *
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_time -> tafTimeSvc.taf_time
   }
 * @endverbatim

 * @section c_taf_time_Get Get the time
 *
 * When trying to get the time information of a given time source, the application shall first
 * get the time reference by calling taf_time_GetTimeRef(), then call taf_time_GetTime()
 * to fetch the related time information. With the reference object, taf_time_GetRefSystemTime()
 * and taf_time_GetRefGptpTime() are two APIs to get the system time and GPTP time fetched
 * from taf_time_GetTime(). When the reference is not needed, call taf_time_ReleaseTimeRef()
 * to release the time reference.
 *
 * The following example illustrates how to get the time information.
 *
 * @code
 *
   le_result_t result;
   taf_time_TimeSpec_t timeVal;
   taf_time_TimeSourceRef_t timeSrcRef;

   // Get the reference for a time source.
   timeSrcRef = taf_time_GetTimeRef(TAF_TIME_SRC_NAME_NETWORK);
   if (timeSrcRef == NULL);
   {
      return LE_FAULT;
   }

   // Get the network time with reference.
   result = taf_time_GetTime(timeSrcRef, &timeVal);
   if (result != LE_OK)
   {
      return result;
   }
   LE_INFO("Reference network time is %"PRIu64".%"PRIu64, time.sec, timeVal.nanosec);

   // Get reference system time.
   result = taf_time_GetRefSystemTime(timeSrcRef, &timeVal);
   if (result == LE_OK)
   {
      LE_INFO("Reference system time is %"PRIu64".%"PRIu64, timeVal.sec, timeVal.nanosec);
   }

   // Get reference gptp time.
   result = taf_time_GetRefGptpTime(timeSrcRef, &timeVal);
   if (result == LE_OK)
   {
       LE_INFO("Reference gptp time is %"PRIu64".%"PRIu64, timeVal.sec, timeVal.nanosec);
   }

   // Release the memory for this reference.
   result = taf_time_ReleaseTimeRef(timeSrcRef);
   if (result == LE_OK)
   {
       LE_INFO("The reference was successfully removed\n");
   }
 *
 * @endcode
 *
 * @section c_taf_time_Set Set the system time
 *
 * - taf_time_SetSystemTime() -- Sets system time in the format of seconds and nanosconds.
 *
 * @code
 *
   static le_mem_PoolRef_t NewTimePool = NULL;
   taf_time_TimeSpec_t *newTime;
   NewTimePool = le_mem_CreatePool("NewTimePool", sizeof(taf_time_TimeSpec_t));
   newTime = (taf_time_TimeSpec_t*) le_mem_ForceAlloc(NewTimePool);

   newTime->sec = 1667788990;
   newTime->nanosec = 10000;

   if(taf_time_SetSystemTime((const taf_time_TimeSpec_t*)newTime, true)== LE_OK)
   {
        // Process received time.
   }
 *
 * @section taf_time_GetRtcTimeReqAsync Get the RTC time asynchronously
 *
 * With the callback function given in taf_time_GetRtcTimeReqAsync(), the application gets
 * the RTC time asynchronously. When the RTC time is available, the time service will notify
 * the client through the registered callback function.
 *.
 * The following example illustrates how to register a callback function and get the
 * time from RTC device asynchronously.
 *
 * @code

  static void getRTCTimeAsync(const taf_time_TimeSpec_t* timeVal,
    le_result_t responseState, void* contextPtr)
{
    LE_INFO("responseState: %d", responseState);
    LE_INFO("Received async vhal RTC time is %"PRIu64".%"PRIu64, timeVal->sec, timeVal->nanosec);
}

 //Register the async callback function
 void* TestGetRTCAsync(void* ctxPtr)
{
    le_result_t res = taf_time_GetRtcTimeReqAsync(getRTCTimeAsync, (void*)ctxPtr);

    if (res == LE_UNSUPPORTED)
    {
        LE_INFO("RTC Async get time API (work with VHAL) received: Unsupported");
    }
    return NULL;
}

 *
 * @endcode
 *
 * @section taf_time_GetSourceRef Get the source reference
 *
 * To get the reference of a source the following APIs can be used.
 *
 *  - taf_time_GetSourceRef() -- Gets the source reference.
 *
 * When trying to get the reference for a source, the application shall call
 * taf_time_GetSourceRef().
 *
 * The following example illustrates how to get the source reference.
 *
 * @code
 *
    uint8_t sourceId = TAF_TIME_SRC_NAME_SYSTEM;
     taf_time_SourceRef_t srcRef;

    srcRef = taf_time_GetSourceRef(sourceId);
    LE_ASSERT(srcRef != NULL);

 *
 * @endcode
 *
* @section taf_time_GetTimeZone Get the Offset from Universal time
 *
 * When trying to get the time zone information of a given time source, the application shall
 * first get the source reference by calling taf_time_GetSourceRef(), then call
 * taf_time_GetTimeZone() to fetch the Offset from Universal time i.e. the difference between
 * local time and Universal time, in increments of 15 minutes (signed value).
 *
 * The following example illustrates how to get the source information.
 *
 * @code
 *
    uint8_t sourceId = TAF_TIME_SRC_NAME_NETWORK;
    taf_time_SourceRef_t srcRef;

    srcRef = taf_time_GetSourceRef(sourceId);
    LE_ASSERT(srcRef != NULL);
    int8_t timeZone = 0;
    le_result_t res = taf_time_GetTimeZone(srcRef, &timeZone);
    LE_ASSERT(res == LE_OK);
    LE_INFO("Time zone is:  %d", timeZone);

 *
 * @endcode
 *
 * @section taf_time_GetTimeDayAdj Get the daylight saving adjustment
 *
 * When trying to get the daylight saving adjustment for a given time source, the application
 * shall first get the source reference by calling taf_time_GetSourceRef(), then call
 * taf_time_GetTimeDayAdj() to fetch the daylight saving adjustment in hours.
 *
 * The following example illustrates how to get the source information.
 *
 * @code
 *
    uint8_t sourceId = TAF_TIME_SRC_NAME_NETWORK;
    taf_time_SourceRef_t srcRef;

    srcRef = taf_time_GetSourceRef(sourceId);
    LE_ASSERT(srcRef != NULL);
    uint8_t dayltSavAdj;
    le_result_t res = taf_time_GetTimeDayAdj(srcRef, &dayltSavAdj);
    LE_ASSERT(res == LE_OK);
    LE_INFO("Day Light Saving is: %d", dayltSavAdj);

 *
 * @endcode
 *
 * @section taf_time_GetFailedLoops Get the number of failed loops and the polling interval time for a source
 *
 * When trying to get the number of failed loops and the polling interval time for a source,
 * the application shall first get the source reference by calling taf_time_GetSourceRef(),
 * then call taf_time_GetFailedLoops() to fetch the details.
 *
 * The following example illustrates how to get the source information.
 *
 * @code
 *
    uint8_t sourceId = TAF_TIME_SRC_NAME_RTC;
    taf_time_SourceRef_t srcRef;
    int32_t failedLoops =0;
    int64_t loopIntervalSec = 0;
    srcRef = taf_time_GetSourceRef(sourceId);
    LE_ASSERT(srcRef != NULL);
    le_result_t res = taf_time_GetFailedLoops(srcRef, &failedLoops, &loopIntervalSec);
    LE_ASSERT(res == LE_OK);
    LE_INFO("The number of failed loops are %d. Loop interval is %ld",
    failedLoops, loopIntervalSec);

 *
 * @endcode
 *
 * @section taf_time_IsAvailable Get the availability of a source
 *
 * When trying to get the availability of a source, the application shall first get
 * the source reference by calling taf_time_GetSourceRef(), then call taf_time_IsAvailable()
 * to fetch the availability.
 *
 * The following example illustrates how to get the source information.
 *
 * @code
 *
    uint8_t sourceId = TAF_TIME_SRC_NAME_RTC;
    taf_time_SourceRef_t srcRef;
    bool isAvailable;
    srcRef = taf_time_GetSourceRef(sourceId);
    LE_ASSERT(srcRef != NULL);
    isAvailable = taf_time_IsAvailable(srcRef);
    if (isAvailable)
    {
        LE_INFO("Time source is Available!");
    }
    else
    {
        LE_INFO("Time source is NOT Available!");
    }

 *
 * @endcode
 *
 * @section taf_time_GetSystemTimeSourceID Get the source ID of time source to which system time is synced
 *
 * When trying to get the latest time source to which system is synced, call
 * taf_time_GetSystemTimeSourceID() to fetch the source ID.
 *
 * The following example illustrates how to get the source information.
 *
 * @code
 *
    taf_time_TimeSources_t systemTimeSrc;
    le_result_t res = taf_time_GetSystemTimeSourceID(&systemTimeSrc);
    LE_ASSERT(res == LE_OK);
    LE_INFO("The lastest system time is set by %s", SourceNameIndexToStr(systemTimeSrc));
 *
 * @endcode
 *
 * @section taf_time_IsSourceValid Get the validity of a source
 *
 * When trying to get the validity of a source, the application shall first get
 * the source reference by calling taf_time_GetSourceRef(), then call taf_time_IsSourceValid()
 * to fetch the validity.
 *
 * The following example illustrates how to get the source information.
 *
 * @code
 *
    uint8_t sourceId = TAF_TIME_SRC_NAME_NETWORK;
    taf_time_SourceRef_t srcRef;
    bool status;
    srcRef = taf_time_GetSourceRef(sourceId);
    LE_ASSERT(srcRef != NULL);
    status = taf_time_IsSourceValid(srcRef);
    if (status)
    {
        LE_INFO("Time source is valid!");
    }
    else
    {
        LE_INFO("Time source is NOT valid!");
    }
 *
 * @endcode
 *
 * @section taf_time_SetValidity Set the validity of a source
 *
 * When trying to set the validity of a source, the application shall first get
 * the source reference by calling taf_time_GetSourceRef(), then call taf_time_SetValidity()
 * to set the validity.
 * @note Client can set validity for RTC and external application only.
 *
 * The following example illustrates how to set the validity of a time source.
 *
 * @code
 *
    uint8_t sourceId = TAF_TIME_SRC_NAME_RTC;
    taf_time_SourceRef_t srcRef;
    uint8_t validity = 0;
    srcRef = taf_time_GetSourceRef(sourceId);
    LE_ASSERT(srcRef != NULL);
    status = taf_time_SetValidity(srcRef, validity);
    LE_ASSERT(res == LE_OK);
 *
 * @endcode
 *
 * @section taf_time_SetRtcTimeReqAsync Set the RTC time asynchronously
 *
 * With the callback function SetRTCTimeAsync() the application can set the RTC time
 * asynchronously. The operation result will be notified to the client through the registered
 * callback function.
 *.
 * The following example illustrates how to register a callback function and set the
 * time from RTC device asynchronously.
 *
 * @code

void setRTCTimeAsync(le_result_t responseState, void* contextPtr)
{
    LE_TEST_ASSERT(responseState == LE_OK, "Test: setRTCTimeAsync response mode is LE_OK");
}

 //Register the async callback function
void* TestSetRTCAsync(void* cxtPtr)
{
   static le_mem_PoolRef_t NewTimePool = NULL;
   taf_time_TimeSpec_t* newTimePtr;
   NewTimePool = le_mem_CreatePool("TimePool", sizeof(taf_time_TimeSpec_t));
   newTimePtr = (taf_time_TimeSpec_t*)le_mem_ForceAlloc(NewTimePool);
   newTimePtr->sec = 1712345678;
   newTimePtr->nanosec = 12345678;
   le_result_t res = taf_time_SetRtcTimeReqAsync(newTimePtr, setRTCTimeAsync, (void*)cxtPtr);

   if (res == LE_UNSUPPORTED)
   {
       LE_INFO("RTC Async set time API (work with VHAL) received: Unsupported");
   }
   return NULL;
}

 *
 * @endcode
 *
 * @section c_taf_time_TimeValueChangeHandler_API Time notification
 *
 * With the reference object, taf_time_AddTimeValueChangeHandler() is for the application to
 * register an event handler for the time source. When the time source gets changed, the time
 * service will notify the client through that registered event handler.
 *
 * @note This functionality does not support RTC and external time sources.
 *
 *
 * When the notification is not needed, taf_time_RemoveTimeValueChangeHandler() is to de-register
 * the event handler to release.
 *
 * The following example illustrates how to register and get the time information,
 *
 * @code
   // Event handler for receiving notification from time service
   void TimeValueChangeHandler
   (
       taf_time_TimeSourceRef_t timeSrcRef,
       taf_time_TimeSpec_t* timeVal,
       void* contextPtr
   )
   {
       le_result_t result;
       taf_time_TimeSpec_t sysTime;
       taf_time_TimeSpec_t gptpTime;
       LE_INFO("Received network time from notification is %"PRIu64".%"PRIu64,
                                   timeSrcRef, timeVal->sec, timeVal->nanosec);

       // Get reference system time information.
       result = taf_time_GetRefSystemTime(timeSrcRef, &systemTime);
       if (result == LE_OK)
       {
           LE_INFO("Reference system time is %"PRIu64".%"PRIu64, sysTime.sec, sysTime.nanosec);
       }

       // Get reference gptp time information.
       result = taf_time_GetRefGptpTime(timeSrcRef, &gptpTime);
       if (result == LE_OK)
       {
           LE_INFO("Reference gptp time is %"PRIu64".%"PRIu64, time.sec, time.nanosec);
       }

       // Release the memory for this reference.
       result = taf_time_ReleaseTimeRef(timeSrcRef);
       if (result == LE_OK)
       {
              LE_INFO("The reference was successfully removed\n");
       }

       return;
   }

   static taf_time_TimeValueChangeHandlerRef_t TimeValueChangeHandlerRef = NULL;
   // Thread to register the handler
   void* TimeValueChangeHandlerTestThread
   (
       void* contextPtr ///< [IN] Thread context.
   )
   {
       // Connect to service.
       taf_time_ConnectService();

       // Register event handler
       TimeValueChangeHandlerRef = taf_time_AddTimeValueChangeHandler(TAF_TIME_SRC_NAME_NETWORK,
                 (taf_time_TimeValueChangeHandlerFunc_t)TimeValueChangeHandler, NULL);
       if(TimeValueChangeHandlerRef != NULL)
       {
            LE_INFO("The event handler was successfully registered\n");
       }

       le_event_RunLoop();
       return NULL;
   }

   //Creates a thread to register the handler and receive notification.
   le_thread_Ref_t threadRef = le_thread_Create("TimeSrcChangeTh",
                              TimeValueChangeHandlerTestThread, NULL);
   // De-register the hanlder when not need.
   taf_time_RemoveTimeValueChangeHandler(TimeValueChangeHandlerRef);
 *
 * @endcode
 *
 * To receive the time source change notification, the following APIs should be used.
 * - taf_time_AddTimeSourceChangeHandler() -- Adds the time source changed handler.
 * - taf_time_RemoveTimeSourceChangeHandler() -- Removes the registered time source changed handler.
 *
 * @code
 *
   // Time source change indication handler.
   void TimeSourceChangeHandler
   (
        taf_time_TimeSources_t PreTimeSource,
        taf_time_TimeSources_t NewTimeSource
   )
   {
        LE_INFO("Old time source: %d, New time source: %d\n",PreTimeSource, NewTimeSource);
   }

   // Add handler for time source change.
   taf_time_TimeSourceChangeHandlerRef_t TimeSourceChangeHandlerRef =
   taf_time_AddTimeSourceChangeHandler
   (
        (taf_time_TimeSourceChangeHandlerFunc_t)TimeSourceChangeHandler, NULL
   );

  // Time source change in some cases.

 *
 * @endcode
 *
 * @section c_taf_time_AddTimeSourceStatusHandler_API Time notification
 *
 * With the reference object, taf_time_AddTimeSourceStatusHandler() is for the application to
 * register an event handler for change in availability and/or validity of a time source.
 * When the time source status gets changed, the time service will notify the client through
 * that registered event handler.
 *
 * When the notification is not needed, taf_time_RemoveTimeSourceStatusHandler() is to de-register
 * the event handler to remove it.
 *
 * The following example illustrates how to register and get the time status information,
 *
 * @code
   // Source status change handler function
   void TimeSourceStatusHandler
   (
       bool isAvailable,
       void* contextPtr
   )
   {
       LE_INFO("Time source status is: %d", Available);
   }

  // Register the source status change handler

  static taf_time_TimeSourceStatusHandlerRef_t TimeSourceStatusHandlerRef = NULL;
  void* TimeSourceStatusHandlerTestThread
  (
    void* contextPtr ///< [IN] Thread context.
  )
  {
      uint8_t sourceid = 0;
      taf_time_SourceRef_t sourceRef = NULL;
      sourceRef = taf_time_GetSourceRef(sourceid);
      LE_ASSERT(sourceRef != NULL);
      TimeSourceStatusHandlerRef = taf_time_AddTimeSourceStatusHandler(sourceRef,
          (taf_time_TimeSourceStatusHandlerFunc_t)TimeSourceStatusHandler, NULL);
      LE_ASSERT(TimeSourceStatusHandlerRef != NULL);
  }

 *
 * @endcode
 * <HR>
 *
*/

//--------------------------------------------------------------------------------------------------
/**
 * Reference for a time source instance, time service uses it to maintain related information.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Time;
REFERENCE Source;

//--------------------------------------------------------------------------------------------------
/**
 * Time source list, which is maintaining by time service.
 *
 */
//--------------------------------------------------------------------------------------------------
ENUM TimeSources{
    SRC_NAME_RTC,           ///< RTC time source
    SRC_NAME_GNSS,          ///< GNSS time source
    SRC_NAME_EX_APP,        ///< External time source
    SRC_NAME_NETWORK,       ///< Network time source from phone1
    SRC_NAME_NETWORK2,      ///< Network time source from phone2
    SRC_NAME_UNKNOWN,       ///< No active time source
    SRC_NAME_SYSTEM = 0xFF  ///< System time ID
};

ENUM StatusEventType{
    STATUS_EVENT_AVAILABILITY = 1,
    STATUS_EVENT_VALIDITY = 2
};

//--------------------------------------------------------------------------------------------------
/**
 * Time structure to store seconds and nanoseconds since epoch.
 * - @b sec     -- Seconds since epoch
 * - @b nanosec -- Nanoseconds
 *
 */
//--------------------------------------------------------------------------------------------------
STRUCT TimeSpec
{
    uint64 sec;      ///< Seconds since epoch
    uint64 nanosec;  ///< Nanoseconds
};

//--------------------------------------------------------------------------------------------------
/**
 * Sets the system time.
 *
 * @instaging
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetSystemTime
(
    TimeSpec timeVal IN, ///< Time in seconds/nanoseconds
    bool ackTimeSvc  IN  ///< True acknowledge time service, otherwise not
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for source change event for the time source that system time is sycned to.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
HANDLER TimeSourceChangeHandler
(
    TimeSources preSource IN, ///< Previous time source
    TimeSources newSource IN  ///< Current time source
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report the new time source that system time is synced to.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
EVENT TimeSourceChange
(
    TimeSourceChangeHandler handler ///< Handler for time source change notification.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for time value change event.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
HANDLER TimeValueChangeHandler
(
    Time  timeRef  IN,    ///< Time reference.
    TimeSpec   timeVal      IN     ///< Time in seconds/nanoseconds
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information for registered time source.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
EVENT TimeValueChange
(
    TimeSources sourceId IN,           ///< Time source ID
    TimeValueChangeHandler    handler  ///< Handler for time source change notification.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference object for a time source.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Something went wrong.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Time GetTimeRef
(
    TimeSources sourceId IN  ///< Time source ID
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the time source and added related time information to its reference object.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Something went wrong.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTime
(
    Time timeRef    IN,  ///< Time reference
    TimeSpec timeVal         OUT  ///< Time in seconds/nanoseconds
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the system time which was created together with a specified time source.
 *
 * - It returns the system time in seconds/nanoseconds since epoch via output 'timeVal'.
 *
 * @b NOTE: This function must be called after the reference object was created, and related time
 * information has been saved to the structure for that reference object.
 *
 * @instaging
 * @return
 *  - LE_FAULT -- Something went wrong.
 *  - LE_UNAVAILABLE -- This reference time is currently not unavailable.
 *  - LE_UNSUPPORTED -- Not supported for current time source.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRefSystemTime
(
    Time  timeRef IN,   ///< Time reference
    TimeSpec  timeVal      OUT   ///< Time in seconds/nanoseconds
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets GPTP time that created when related time source was created.
 *
 * - It returns the GPTP time in seconds/nanoseconds since epoch via output 'timeVal'.
 *
 * @b NOTE: This function must be called after the reference object was created, and related time
 * information has been saved to the structure for that reference object.
 *
 * @instaging
 * @return
 *  - LE_FAULT -- Something went wrong.
 *  - LE_UNAVAILABLE -- This reference time is currently not unavailable.
 *  - LE_UNSUPPORTED -- Not supported for current time source.
 *  - LE_OK -- Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRefGptpTime
(
    Time  timeSrcRef IN,   ///< Time source reference.
    TimeSpec  timeVal      OUT   ///< Time in seconds/nanoseconds
);

//--------------------------------------------------------------------------------------------------
/**
 * Releases a 'Time' reference.
 *
 * @instaging
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_FAULT -- Something went wrong.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ReleaseTimeRef
(
    Time  timeSrcRef  IN  ///< Time source reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for asynchronous getting time request.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncGetTimeReqHandler
(
    TimeSpec    timeVal   IN,            ///< Time in seconds/nanoseconds.
    le_result_t responseState IN    ///< Status response.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the RTC time asynchronously.
 *
 * It returns the RTC time in seconds/nanoseconds since epoch via output timeVal.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_UNAVAILABLE -- The RTC time is not available.
 *  - LE_FAULT -- Internal error.
 *  - LE_NOT_IMPLEMENTED -- Not implemented.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRtcTimeReqAsync
(
    AsyncGetTimeReqHandler    handlerRef   IN    ///< Handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the time to RTC device.
 *
 * @instaging
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetTimeToRtc
(
    TimeSpec timeVal IN ///< Time in seconds/nanoseconds
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for asynchronous setting time request.
 *
 * @instaging
 */
HANDLER AsyncSetTimeReqHandler
(
    le_result_t responseState     IN    ///< Status response.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets RTC time asynchronously.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_UNAVAILABLE -- The rtc time is not available.
 *  - LE_FAULT -- Internal error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetRtcTimeReqAsync
(
    TimeSpec timeVal                      IN,        ///< Time in seconds/nanoseconds
    AsyncSetTimeReqHandler handlerRef     IN         ///< Handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference object for a source.
 *
 * @instaging
 * @return
 *  - Source -- Succeeded.
 *  - NULL -- Source is not available.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Source GetSourceRef
(
    TimeSources sourceId IN    ///< Source ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the number of failed loops for a source.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Something went wrong.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFailedLoops
(
    Source sourceRef       IN,    ///< Source reference.
    int32 faileLoops       OUT,   ///< Number of failed loops.
    int64 LoopIntervalSec  OUT    ///< Seconds per loop.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the availability of a source.
 *
 * @instaging
 * @return
 *  - true -- Available.
 *  - false -- Not available.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsAvailable
(
    Source sourceRef     IN    ///< Source reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the name of latest time source to which system time is synced.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Something went wrong.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSystemTimeSourceID
(
    TimeSources timeSource    OUT   ///< Time Source.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for time soure status change event.
 *
 * @note The handler is not supported for getting the availability change for system time source.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
HANDLER TimeSourceStatusHandler
(
    Source sourceRef            IN,  ///< Source reference.
    StatusEventType eventType   IN,  ///< Status event type.
    bool status                 IN   ///< Status of source as per event type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report the time source status change or there is no available time source.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
EVENT TimeSourceStatus
(
    Source sourceRef        IN,
    StatusEventType eventType   IN,
    TimeSourceStatusHandler handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the Offset from Universal time i.e. the difference between local time and Universal time,
 * in increments of 15 minutes (signed value). The time zone offset range is [-48, 48], so the
 * range of minutes is [-720, 720].
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Something went wrong.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTimeZone
(
   Source sourceRef  IN,   ///< Source reference.
   int8 timeZone     OUT   ///< Time zone.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the daylight saving adjustment in hours. Possible values for the output are 0, 1, and 2
 * indicating following:
 *
 * - 0: No adjustment for daylight saving.
 *
 * - 1: +1 adjustment for daylight saving.
 *
 * - 2: +2 adjustment for daylight saving.
 *
 * - 3: reserved.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Something went wrong.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTimeDayAdj
(
   Source sourceRef        IN,    ///< Source reference.
   uint8 dayltSavAdj       OUT    ///< Daylight saving adjustment.
);

//--------------------------------------------------------------------------------------------------
/**
 * Checks whether a time source is valid.
 *
 * @instaging
 * @return
 *  - true -- Valid.
 *  - false -- Not valid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsSourceValid
(
    Source sourceRef     IN    ///< Source reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the validity of a source.
 *
 * @instaging
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Something went wrong.
 *
 * @note - This function can be called to set validity for RTC and external application only.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetValidity
(
    Source sourceRef     IN,   ///< Source reference.
    bool   validity      IN    ///< Validity to set.
);
