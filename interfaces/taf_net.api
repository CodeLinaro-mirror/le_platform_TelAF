/**
 * Starts (asynchronously) a tunnel.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION StartTunnelAsync
(
    Tunnel tunnelRef                          IN, ///< Tunnel reference.
    AsyncTunnelHandler handler                IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
