{
    "app":
    {
        "probation":
        {
            "time": 10
        }
    },

    "firmware":
    {
        "unpack":
        {
            "directory": "/tmp"
        },

        "post-install":
        {
            "user-script": "/etc/firmware/post-install",
            "cancel":
            {
                "user-script": "/etc/firmware/post-install-cancel"
            }
        },

        "post-rollback":
        {
            "user-script": "/etc/firmware/post-rollback"
        }
    }
}