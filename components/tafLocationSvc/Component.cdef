provides:
{
    api:
    {
        taf_locGnss.api
        taf_locPos.api
        taf_locPosCtrl.api
    }
}

requires:
{
    api:
    {
    #if ${LE_CONFIG_ENABLE_CONFIG_TREE} = y
        le_cfg.api
    #endif
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
    }

    lib:
    {
        lib/libtelux_loc.so
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$LEGATO_ROOT/components/cfgEntries
    -I$TELAF_ROOT/include
    -ltelux_loc
    -ltelux_common
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
}

sources:
{
    tafGnssImpl.cpp
    tafPosImpl.cpp
    tafLocationSvc.cpp
}
