#include "$TELAF_ROOT/modules/sa525m.sdef"

apps:
{
    $TELAF_ROOT/apps/rpc/rpcTest/helloRpcServer/RpcPrintServer.adef
    $TELAF_ROOT/apps/rpc/rpcTest/helloRpcClient/RpcPrintClient.adef
}

// The RPC system ID of my system is 0x102, the peer system ID is 0x101
// So here we shall bind to peer system for RPC test.
bindings:
{
    RpcPrintClient.rpcClientPrinter -> <telaf>.rpcServer_101_telaf_tafRpcPrinter
}

interfaceSearch:
{
    $TELAF_ROOT/interfaces/someipGW
}
