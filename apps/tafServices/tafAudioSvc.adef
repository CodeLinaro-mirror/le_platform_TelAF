executables:
{
        tafAudioSvc = ( $TELAF_ROOT/components/tafAudioSvc )
}

start: auto

processes:
{
        run:
        {
                (tafAudioSvc)
        }

        faultAction: restart

        #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
                maxWatchdogTimeout: 100000
        #else
                watchdogTimeout: never
        #endif
}

sandboxed: false

bindings:
{
}

extern:
{
        tafAudioSvc.tafAudioSvc.taf_audio
}
