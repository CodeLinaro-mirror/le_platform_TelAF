/**
 * This function gets current network name.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCurrentNetworkName
(
    string nameStr[NETWORK_NAME_MAX_LEN] OUT, ///< Current network name.
    uint8 phoneId IN                          ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets current Mobile Country Code and Mobile Network Code.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCurrentNetworkMccMnc
(
    string mccStr[MCC_LEN] OUT,     ///< Mobile Country Code.
    string mncStr[MNC_MAX_LEN] OUT, ///< Mobile Network Code.
    uint8 phoneId IN                ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function performs celluar network scan, and get the reference of network scan information list.
 *
 * @return
 *  - Non-null pointer : The reference of network scan information list.
 *  - Null pointer : Internal error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ScanInformationList PerformCellularNetworkScan
(
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function performs celluar network scan asynchronously.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION PerformCellularNetworkScanAsync
(
    CellularNetworkScanHandler handler, ///< Handler for network scan.
    uint8 phoneId IN                    ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the reference of the first operator in network scan information list.
 *
 * @return
 *  - Non-null pointer : The reference of the first operator in network scan list.
 *  - Null pointer : Internal error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ScanInformation GetFirstCellularNetworkScan
(
    ScanInformationList scanInformationListRef IN ///< The reference of network scan information list.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the reference of next operator based on the current position of network scan
 * information list.
 *
 * @return
 *  - Non-null pointer : The reference of next operator in network scan list.
 *  - Null pointer : Internal error or the end of the list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ScanInformation GetNextCellularNetworkScan
(
    ScanInformationList scanInformationListRef IN ///< The reference of network scan information list.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function deletes the reference of network scan information list.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Reference not found.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteCellularNetworkScan
(
    ScanInformationList scanInformationListRef IN ///< The reference of network scan information list.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets MCC and MNC of a network scan operator.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Reference not found.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCellularNetworkMccMnc
(
    ScanInformation scanInformationRef IN, ///< The reference of scan information list.
    string mccPtr[MCC_LEN] OUT,            ///< Mobile Country Code.
    string mncPtr[MNC_MAX_LEN] OUT         ///< Mobile Network Code.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets network name of a network scan operator.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Reference not found.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCellularNetworkName
(
    ScanInformation scanInformationRef IN,   ///< The reference of scan information list.
    string namePtr[NETWORK_NAME_MAX_LEN] OUT ///< Network name.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function checks if a scan operator's network is in use.
 *
 * @return
 *  - True : If network is in use.
 *  - False : If invalid reference or network is not in use.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsCellularNetworkInUse
(
    ScanInformation scanInformationRef IN ///< The reference of network scan operator.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function checks if scan operator's network is available.
 *
 * @return
 *  - True : If network is available.
 *  - False : If invalid reference or network is available.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsCellularNetworkAvailable
(
    ScanInformation scanInformationRef IN ///< The reference of network scan operator.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function checks if scan operator is home network.
 *
 * @return
 *  - True : If it is home network.
 *  - False : If invalid reference or it is not home network.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsCellularNetworkHome
(
    ScanInformation scanInformationRef IN ///< The reference of network scan operator.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function checks if scan operator's network is forbidden.
 *
 * @return
 *  - True : If network is forbidden.
 *  - False : If invalid reference or network is forbidden.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsCellularNetworkForbidden
(
    ScanInformation scanInformationRef IN ///< The reference of network scan operator.
);
