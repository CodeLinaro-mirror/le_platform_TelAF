username: telaf
maxThreads: 600
sandboxed: false
start: manual
executables:
{
    exe_RpcPrintClient = (printClient)
}

processes:
{
    run:
    {
        RpcPrintClient = (exe_RpcPrintClient)
    }
}

extern:
{
    rpcClientPrinter = exe_RpcPrintClient.printClient.tafRpcPrinter
}

bindings:
{
    exe_RpcPrintClient.printClient.taf_someipClnt -> tafSomeipGWSvc.taf_someipClnt
}
