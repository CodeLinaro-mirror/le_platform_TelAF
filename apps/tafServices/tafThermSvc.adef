maxThreads: 600
sandboxed: false

username: telaf
startGroup: 22

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

executables:
{
    tafThermSvc = ( $TELAF_ROOT/components/tafThermSvc )
}

start: auto

processes:
{
    run:
    {
        (tafThermSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
}

extern:
{
    tafThermSvc.tafThermSvc.taf_therm
}
