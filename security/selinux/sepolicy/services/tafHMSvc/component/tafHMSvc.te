policy_module(tafHMSvc, 1.0)

# Framework definition for telaf
type telaf_tafHMSvc_exec_t;
files_type(telaf_tafHMSvc_exec_t);

type telaf_tafHMSvc_t;

type telaf_tafHMSvc_data_t;
files_type(telaf_tafHMSvc_data_t);

init_telaf_app_domain(telaf_tafHMSvc_t,telaf_tafHMSvc_exec_t)

kernel_read_system_state(telaf_tafHMSvc_t)

# Allow service to manage its own data directory; registers with admin domain.
telaf_manage_app_data_files(telaf_tafHMSvc_t, telaf_tafHMSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafHMSvc_exec_t)

# Allow tafHMSvc to access telux private info
telux_allow_tel_private_info_read(telaf_tafHMSvc_t)

gen_require(`
    type mm_socket_device_t;
    type modem_monitor_t;
')

# Allow tafHMSvc to write to ssr_notify
allow telaf_tafHMSvc_t mm_socket_device_t:sock_file write;

# Allow tafHMSvc to connect to modem_monitor
allow telaf_tafHMSvc_t modem_monitor_t:unix_stream_socket connectto;
