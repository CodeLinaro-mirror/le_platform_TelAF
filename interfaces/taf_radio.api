/**
 *  Adds a preferred operator.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_DUPLICATE -- Duplicate preferred operator.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddPreferredOperator
(
    string mcc[MCC_LEN] IN,     ///< MCC.
    string mnc[MNC_MAX_LEN] IN, ///< MNC.
    RatBitMask ratMask IN,      ///< RAT bitmask, applicable for GSM/UMTS/LTE/NR5G.
    uint8 phoneId IN            ///< Phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Removes a preferred operator.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_NOT_FOUND -- Preferred operator not found.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemovePreferredOperator
(
    string mcc[MCC_LEN] IN,     ///< MCC.
    string mnc[MNC_MAX_LEN] IN, ///< MNC.
    uint8 phoneId IN            ///< Phone ID.
);

//--------------------------------------------------------------------------------------------------
