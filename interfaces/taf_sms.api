FUNCTION le_result_t SetCallback
(
    Msg     msgRef,
    CallbackResult handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Set phone ID function for message, phone ID must be 1 or 2 (for DSDA use case)
 * @return the le_result of setting phone ID for message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION le_result_t SetPhoneId
(
    Msg     msgRef,
    uint8    phoneId
);

//--------------------------------------------------------------------------------------------------
/**
 * Delete message from message list, if no message list reference, delete the message from storage
 */
//--------------------------------------------------------------------------------------------------

FUNCTION Delete
(
    Msg msgRef
);

//--------------------------------------------------------------------------------------------------
/**
 * Get sender phone number of message
 * @return the le_result of getting sender phone number from message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION le_result_t GetSenderTel
(
    Msg     msgRef,
    string  tel[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] OUT
);

//--------------------------------------------------------------------------------------------------
/**
 * Get text of message
 * @return the le_result of getting text from message
 */
