//--------------------------------------------------------------------------------------------------
/**
 * @page c_taf_mngd_audioHw Managed Audio Hw Service
 *
 * @ref taf_mngd_audioHw_interface.h "API Reference"
 *
 * <HR>
 *
 * The Managed Audio service APIs help to do audio operations on the audio devices.
 *
 * @section taf_mngd_audioHw_binding IPC interfaces binding
 *
 * The following example illustrates how to bind to the Managed Audio service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_mngd_audioHw -> tafMngdAudioSvc.taf_mngd_audioHw
   }
   @endverbatim
 *
 * @section c_taf_mngd_audio_HWDevAPI HW device APIs
 *
 * TelAF Managed Audio Service helps the user to set/get audio device setting like audio device type
 * power state, mute state using HW device APIs. User can also set the configurations for audio
 * devices, can register for node state change events.
 *
 * @subsection c_send_configuration_tovhal Send audio configuration to Vendor
 *
 * @verbatim
    const char* configurePath = "/data/configure.xml";
    le_result_t res = taf_mngd_audioHw_SendVendorConfig(configPath);
    if(res == LE_OK)
        LE_INFO("Successfully sent the configuration to VHAL");

   @endverbatim
 *
 * @subsection c_get_audio_device_type Get the type of audio device connected to the node
 *
 * @verbatim
    taf_mngd_audio_NodeType_t nodeType = taf_mngd_audioHw_GetNodeType(0x1);
    if(nodeType != TAF_MNGD_AUDIO_INVALID)
        LE_INFO("Successfully got the audio device type");

   @endverbatim
 *
 * @subsection c_send_audio_device_configuration_tovhal Send audio device configuration to Vendor
 *
 * @verbatim
    const char* configurePath = "/data/audioConfigure.xml";
    le_result_t res = taf_mngd_audioHw_SendNodeVendorConfigure(configurePath);
    if(res == LE_OK)
        LE_INFO("Successfully sent the audio device configuration to Vendor");

   @endverbatim
 *
 * @subsection c_set_and_get_audio_device_power_state Set/get audio device power state
 *
 * @verbatim
    le_result_t res = taf_mngd_audioHw_SetNodePowerState(0x1, TAF_MNGD_AUDIO_SUSPEND);
    if(res == LE_OK)
        LE_INFO("Successfully set the audio device power state");

    taf_mngd_audio_NodePowerState_t state;
    res = taf_mngd_audioHW_GetNodePowerState(0x1, &state);
    if(res == LE_OK)
        LE_INFO("Successfully got the audio device power state %d", state);

   @endverbatim
 *
 * @subsection c_set_and_get_audio_device_mute_state Set/get audio device mute state
 *
 * @verbatim
    le_result_t res = taf_mngd_audioHw_SetNodeMuteState(0x1, true);
    if(res == LE_OK)
        LE_INFO("Successfully set the audio device mute state");

    bool state;
    res = taf_mngd_audioHw_GetNodeMuteState(0x1, &state);
    if(res == LE_OK)
        LE_INFO("Successfully got the audio device mute state %s", state ? "true" : "false");

   @endverbatim
 *
 * @subsection c_regsiter_audio_device_state_change Register/deregister audio device state change
 *
 * @verbatim
    static void NodeStateChangeCallback(uint8_t nodeId, taf_mngd_audioHw_Event_t event,
    void* contextPtr)
    {
        LE_INFO("Received node state change callback for audio device %d for event %d",
        nodeId, event);
    }

    taf_mngd_audio_NodeStateChangeHandlerRef_t handlerRef;
    handlerRef = taf_mngd_audioHw_AddNodeStateChangeHandler(0x1, NodeStateChangeCallback, NULL);
    if(handlerRef != NULL)
        LE_INFO("Successfully registered for node state change callback");

    // To deregister for node state change.
    taf_mngd_audioHw_RemoveNodeStateChangeHandler(handlerRef);

   @endverbatim
 */
//--------------------------------------------------------------------------------------------------

DEFINE MAX_CONFIG_LEN = 32;

/**
 * Audio Node types.
 */
ENUM NodeType
{
    INVALID = -1,
    AUDIO_CODEC,
    AUDIO_PA,
    AUDIO_A2B,
    AUDIO_MAX
};

/**
 * Audio Node power states
 */
ENUM NodePowerState
{
    POWER_OFF,
    SUSPEND,
    ACTIVE
};

//--------------------------------------------------------------------------------------------------
/**
 * Gets audio device node type.
 *
 * @return
 *     - LE_OK                 Success.
 *     - LE_BAD_PARAMETER      Node id is not valid.
 *     - LE_FAULT              Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNodeType
(
    uint8    nodeId   IN,   ///< The audio node ID.
    NodeType nodeType OUT   ///< The node type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends the information from application to vendor to perform customized operations on audio
 * devices.
 *
 * @return
 *     - LE_OK                 Success.
 *     - LE_BAD_PARAMETER      Node id is not valid.
 *     - LE_FAULT              Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendNodeVendorConfig
(
    uint8  nodeId                      IN,    ///< The audio node ID.
    string configPath[MAX_CONFIG_LEN]  IN     ///< The config path.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends the information from application to vendor to perform customized operations.
 *
 * @return
 *     - LE_OK                 Success.
 *     - LE_FAULT              Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendVendorConfig
(
    string configPath[MAX_CONFIG_LEN]  IN     ///< The configuration path.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets audio device power state.
 *
 * @return
 *     - LE_OK                 Success.
 *     - LE_BAD_PARAMETER      Node id is not valid.
 *     - LE_FAULT              Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNodePowerState
(
    uint8             nodeId  IN,    ///< The audio node ID.
    NodePowerState    state   IN     ///< The Power state to be set.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets audio device power state.
 *
 * @return
 *     - LE_OK                 Success.
 *     - LE_BAD_PARAMETER      Node id is not valid.
 *     - LE_FAULT              Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNodePowerState
(
    uint8           nodeId  IN,      ///< The audio node ID.
    NodePowerState  state   OUT      ///< The Power state of the audio device.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets audio device mute state.
 *
 * @return
 *     - LE_OK                 Success.
 *     - LE_BAD_PARAMETER      Node id is not valid.
 *     - LE_FAULT              Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNodeMuteState
(
    uint8   nodeId   IN,    ///< The audio node ID.
    bool    mute     IN     ///< True to mute, false to unmute.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets audio device mute state.
 *
 * @return
 *     - LE_OK                 Success.
 *     - LE_BAD_PARAMETER      Node id is not valid.
 *     - LE_FAULT              Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNodeMuteState
(
    uint8   nodeId   IN,      ///< The audio node ID.
    bool    isMuted  OUT      ///< The mute status of the audio device.
);

/**
 * Audio device events.
 */
ENUM Event
{
    MUTE,
    UNMUTE,
    MAX
};

/**
 * Handler for node state change.
 */
HANDLER NodeStateHandler
(
    uint8   nodeId  IN, ///< The audio node ID.
    Event   event       ///< State event.
);

/**
 * This event provides information on node status events.
 */
EVENT NodeStateChange
(
    uint8               nodeId  IN, ///< The audio node ID.
    NodeStateHandler    handler     ///< NodeStateHandler handler.
);