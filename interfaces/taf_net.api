 *   - LE_BAD_PARAMETER -- Bad parameter.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTunnelInterfaceName
(
    TunnelEntry tunnelEntryRef                IN, ///< Tunnel entry reference.
    string ifName[INTERFACE_NAME_MAX_LEN]     OUT ///< Interface name.
);

