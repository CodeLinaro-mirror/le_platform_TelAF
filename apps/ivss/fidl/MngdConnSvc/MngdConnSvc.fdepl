import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "platform:/plugin/org.genivi.commonapi.core/deployment/CommonAPI-4_deployment_spec.fdepl"
import "MngdConnSvc.fidl"

define org.genivi.commonapi.core.deployment for typeCollection com.qualcomm.qti.telephony.MngdConnSvcTypes
{
    enumeration TelephonyResultT
    {
        EnumBackingType = UInt8
    }

    enumeration MngdConnDataStateT
    {
        EnumBackingType = UInt8
    }

    enumeration ValueState
    {
        EnumBackingType = UInt8
    }
}

define org.genivi.commonapi.someip.deployment for interface com.qualcomm.qti.telephony.MngdConnSvc
{
    SomeIpServiceID = 0xED83

    broadcast DataState
    {
        SomeIpEventID = 33369
        SomeIpEventGroups = { 33369 }
    }

    method StartData
    {
        SomeIpMethodID = 601
    }

    method StopData
    {
        SomeIpMethodID = 602
    }

    method GetDataList
    {
        SomeIpMethodID = 603
    }

    method GetDataIpv4Info
    {
        SomeIpMethodID = 604
    }
}

define org.genivi.commonapi.someip.deployment for provider as Service
{
    instance com.qualcomm.qti.telephony.MngdConnSvc
    {
        InstanceId = "telephony.MngdConnSvc"

        SomeIpInstanceID = 1
    }
}
