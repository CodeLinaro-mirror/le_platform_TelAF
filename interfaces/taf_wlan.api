/**
 * @page c_tafwlan Wireless LAN Device Management Service
 *
 * @rst :ref:`API reference <File taf_wlan_interface.h>` @endrst
 *
 * <HR>
 *
 * The wireless LAN (WLAN) device management service provides APIs for
 * applications to manage and control WLAN chipsets. This service acts as the foundation
 * layer that must be configured before any WLAN access point (AP) or station (STA)
 * operations can be performed.
 *
 * The service supports multiple concurrent WLAN interfaces, advanced interference management
 * between 5G N79 and WLAN 5 GHz bands, and real-time device state monitoring.
 *
 * @section taf_wlan_binding IPC interfaces binding
 *
 * The functions of this service are provided by the @b tafWlanSvc application service.
 *
 * The following example illustrates how to bind to the WLAN service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_wlan -> tafWlanSvc.taf_wlan
   }
   @endverbatim
 *
 * @section c_taf_wlan_device_management Device Management Operations
 *
 * The WLAN device must be turned ON and configured with the appropriate mode before any AP
 * or STA operations can be performed. The service supports various device modes including
 * single AP, single STA, and concurrent AP+STA configurations.
 *
 * @subsection c_taf_wlan_basic_setup Setup the device
 *
 * The following example demonstrates the basic WLAN device setup workflow:
 *
 * @code
 *
   // Register for device state change events
   taf_wlan_DeviceStateHandlerRef_t stateHandlerRef =
       taf_wlan_AddDeviceStateHandler(NULL, DeviceStateHandler, NULL);
 *
   // Turn on the WLAN device
   le_result_t result = taf_wlan_TurnOn(NULL);
   if (result != LE_OK) {
       LE_ERROR("Failed to turn on WLAN device: %d", result);
       return result;
   }
 *
   // Set the device mode (e.g., AP + STA)
   result = taf_wlan_SetMode(NULL, TAF_WLAN_MODE_STA_AP);
   if (result != LE_OK) {
       LE_ERROR("Failed to set WLAN mode: %d", result);
       return result;
   }
 *
   // Verify the device state
   taf_wlan_DeviceState_t state;
   result = taf_wlan_GetState(NULL, &state);
   if (result == LE_OK && state == TAF_WLAN_ON) {
       LE_INFO("WLAN device is now ON and ready");
   }
 *
   @endcode
 *
 * @subsection c_taf_wlan_interface_discovery Discover available interfaces
 *
 * After setting the device mode, applications need to discover the available interfaces to
 * get references for AP and STA operations:
 *
 * @code
 *
   // Get interface information
   taf_wlan_APIntfInfo_t apIntf[TAF_WLAN_MAX_NUM_AP];
   taf_wlan_STAIntfInfo_t staIntf[TAF_WLAN_MAX_NUM_STA];
   size_t apIntfSize = TAF_WLAN_MAX_NUM_AP;
   size_t staIntfSize = TAF_WLAN_MAX_NUM_STA;
 *
   result = taf_wlan_GetIntfInfo(NULL, apIntf, &apIntfSize, staIntf, &staIntfSize);
   if (result != LE_OK) {
       LE_ERROR("Failed to get interface info: %d", result);
       return result;
   }
 *
   // Display available interfaces
   LE_INFO("Available AP interfaces: %zu", apIntfSize);
   for (size_t i = 0; i < apIntfSize; i++) {
       LE_INFO("  AP ID: %d, Interface: %s", apIntf[i].id, apIntf[i].IntfName);
   }
 *
   LE_INFO("Available STA interfaces: %zu", staIntfSize);
   for (size_t i = 0; i < staIntfSize; i++) {
       LE_INFO("  STA ID: %d, Interface: %s", staIntf[i].id, staIntf[i].IntfName);
   }
 *
   @endcode
 *
 * @subsection c_taf_wlan_state_monitoring Monitor device state
 *
 * Applications should register for device state change events to monitor WLAN device status:
 *
 * @code
 *
   // Device state change handler
   static void DeviceStateHandler(
       taf_wlan_WlanRef_t wlanRef,
       taf_wlan_DeviceState_t state,
       void* contextPtr
   )
   {
       switch (state) {
           case TAF_WLAN_OFF:
               LE_INFO("WLAN device is OFF");
               break;
           case TAF_WLAN_ON:
               LE_INFO("WLAN device is ON and ready");
               break;
           case TAF_WLAN_UNAVAILABLE:
               LE_ERROR("WLAN device is unavailable");
               break;
           default:
               LE_ERROR("Unknown WLAN device state: %d", state);
               break;
       }
   }
 *
   @endcode
 *
 * @section taf_wlan_set_interference Manage N79 5G and WLAN 5G interference
 *
 * The service provides advanced interference management between N79 5G and WLAN 5GHz bands
 * to optimize performance and avoid conflicts for devices that support 5G cellular and WLAN 5 GHz operations.
 *
 * @subsection c_taf_wlan_interference_setup Set up interference management
 *
 * The following example demonstrates how to configure band interference management:
 *
 * @code
 *
   // Set N79 5G band as higher priority
   le_result_t result = taf_wlan_SetBandIntPriority(NULL, TAF_WLAN_PRIO_BAND_N79);
   if (result != LE_OK) {
       LE_ERROR("Failed to set band priority: %d", result);
       return result;
   }
 *
   // Set wait times for both bands (in seconds)
   result = taf_wlan_SetBandIntWaitTime(NULL, TAF_WLAN_PRIO_BAND_N79, 30);
   if (result == LE_OK) {
       result = taf_wlan_SetBandIntWaitTime(NULL, TAF_WLAN_PRIO_BAND_WLAN_5_GHZ, 30);
   }
   if (result != LE_OK) {
       LE_ERROR("Failed to set wait times: %d", result);
       return result;
   }
 *
   // Enable interference management
   result = taf_wlan_SetBandIntState(NULL, TAF_WLAN_BAND_INT_ENABLED);
   if (result != LE_OK) {
       LE_ERROR("Failed to enable interference management: %d", result);
       return result;
   }
 *
   LE_INFO("Band interference management enabled successfully");
 *
   @endcode
 *
 * @subsection c_taf_wlan_interference_monitoring Monitor interference status
 *
 * The following snippet shows how applications can monitor the current interference management state:
 *
 * @code
 *
   // Get current interference state
   taf_wlan_BandIntState_t intState;
   le_result_t result = taf_wlan_GetBandIntState(NULL, &intState);
   if (result == LE_OK) {
       LE_INFO("Interference management is %s",
               (intState == TAF_WLAN_BAND_INT_ENABLED) ? "ENABLED" : "DISABLED");
   }
 *
   // Get current priority band
   taf_wlan_BandIntPriority_t priority;
   result = taf_wlan_GetBandIntPriority(NULL, &priority);
   if (result == LE_OK) {
       const char* priorityStr = (priority == TAF_WLAN_PRIO_BAND_N79) ?
                                "N79 5G" : "WLAN 5GHz";
       LE_INFO("Priority band: %s", priorityStr);
   }
 *
   // Get wait times for both bands
   uint32_t waitTime;
   result = taf_wlan_GetBandIntWaitTime(NULL, TAF_WLAN_PRIO_BAND_N79, &waitTime);
   if (result == LE_OK) {
       LE_INFO("N79 5G wait time: %u seconds", waitTime);
   }
 *
   result = taf_wlan_GetBandIntWaitTime(NULL, TAF_WLAN_PRIO_BAND_WLAN_5_GHZ, &waitTime);
   if (result == LE_OK) {
       LE_INFO("WLAN 5GHz wait time: %u seconds", waitTime);
   }
 *
   @endcode
 *
 * @section c_taf_wlan_complete_workflow Complete WLAN setup workflow
 *
 * The following example demonstrates a complete WLAN device setup workflow:
 *
 * @code
 *
   static taf_wlan_DeviceStateHandlerRef_t stateHandlerRef = NULL;
   static le_sem_Ref_t wlanSemRef = NULL;
 *
   static void DeviceStateHandler(
       taf_wlan_WlanRef_t wlanRef,
       taf_wlan_DeviceState_t state,
       void* contextPtr
   )
   {
       if (state == TAF_WLAN_ON) {
           LE_INFO("WLAN device is ready");
           le_sem_Post(wlanSemRef);
       }
   }
 *
   le_result_t SetupWlanDevice(void)
   {
       le_result_t result;
 *
       // Create semaphore for synchronization
       wlanSemRef = le_sem_Create("WlanSem", 0);
 *
       // Register for state change events
       stateHandlerRef = taf_wlan_AddDeviceStateHandler(NULL, DeviceStateHandler, NULL);
       if (stateHandlerRef == NULL) {
           LE_ERROR("Failed to register state handler");
           return LE_FAULT;
       }
 *
       // Turn on WLAN device
       result = taf_wlan_TurnOn(NULL);
       if (result != LE_OK) {
           LE_ERROR("Failed to turn on WLAN: %d", result);
           return result;
       }
 *
       // Wait for device to be ready
       le_sem_Wait(wlanSemRef);
 *
       // Set device mode for concurrent AP and STA
       result = taf_wlan_SetMode(NULL, TAF_WLAN_MODE_STA_AP);
       if (result != LE_OK) {
           LE_ERROR("Failed to set WLAN mode: %d", result);
           return result;
       }
 *
       // Configure interference management
       result = taf_wlan_SetBandIntPriority(NULL, TAF_WLAN_PRIO_BAND_N79);
       if (result == LE_OK) {
           result = taf_wlan_SetBandIntWaitTime(NULL, TAF_WLAN_PRIO_BAND_N79, 30);
       }
       if (result == LE_OK) {
           result = taf_wlan_SetBandIntWaitTime(NULL, TAF_WLAN_PRIO_BAND_WLAN_5_GHZ, 30);
       }
       if (result == LE_OK) {
           result = taf_wlan_SetBandIntState(NULL, TAF_WLAN_BAND_INT_ENABLED);
       }
 *
       if (result != LE_OK) {
           LE_WARN("Interference management setup failed: %d", result);
           // Continue anyway as this is optional
       }
 *
       LE_INFO("WLAN device setup completed successfully");
       return LE_OK;
   }
 *
   void CleanupWlanDevice(void)
   {
       if (stateHandlerRef) {
           taf_wlan_RemoveDeviceStateHandler(stateHandlerRef);
           stateHandlerRef = NULL;
       }
 *
       taf_wlan_TurnOff(NULL);
 *
       if (wlanSemRef) {
           le_sem_Delete(wlanSemRef);
           wlanSemRef = NULL;
       }
   }
 *
   @endcode
 *
 * @section c_taf_wlan_supported_modes Supported device modes
 *
 * The WLAN service supports the following device modes:
 *
 * | Mode | Description | Max APs | Max STAs |
 * |:-----|:------------|:--------|:---------|
 * | TAF_WLAN_MODE_AP | Single Access Point | 1 | 0 |
 * | TAF_WLAN_MODE_STA | Single Station | 0 | 1 |
 * | TAF_WLAN_MODE_STA_AP | Station + Access Point | 1 | 1 |
 * | TAF_WLAN_MODE_AP_AP | Dual Access Points | 2 | 0 |
 * | TAF_WLAN_MODE_AP_AP_STA | Dual APs + Station | 2 | 1 |
 *
 * @b NOTE: Mode changes require a device OFF/ON cycle to take effect.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;

USETYPES taf_net.api;

//--------------------------------------------------------------------------------------------------
/**
 * WLAN SSID max length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_SSID_LENGTH = 32;

//--------------------------------------------------------------------------------------------------
/**
 * WLAN Passphrase max length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_PASSPHRASE_LENGTH = 63;

//--------------------------------------------------------------------------------------------------
/**
 * WLAN connected client name max length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_DEVICE_NAME_LENGTH = 32;

//--------------------------------------------------------------------------------------------------
/**
 * WLAN BSSID(Basic Service Set Identifier) max length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_BSSID_LENGTH = 17;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum number of access points supported.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_NUM_AP = 2;

//--------------------------------------------------------------------------------------------------
/**
 * Maximum number of stations supported.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_NUM_STA = 1;

//--------------------------------------------------------------------------------------------------
/**
 * WLAN supported radio bands.
 */
//--------------------------------------------------------------------------------------------------
ENUM Band
{
    BAND_UNKNOWN,   ///< To skip setting band, pass UNKNOWN.
    BAND_5_GHZ,     ///< 5 GHz band.
    BAND_2P4_GHZ    ///< 2.4 GHz band.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN 5GHz and 5G N79 band interference configuration state.
 */
//--------------------------------------------------------------------------------------------------
ENUM BandIntState
{
    BAND_INT_DISABLED = 0, ///< Disable band interference.
    BAND_INT_ENABLED  = 1  ///< Enable band interference.
};

//--------------------------------------------------------------------------------------------------
/**
 * Bands used to set interference priority between WLAN 5GHz and 5G N79 bands.
 */
//--------------------------------------------------------------------------------------------------
ENUM BandIntPriority
{
    PRIO_BAND_UNKNOWN    = 0,  ///< Unknown band priority.
    PRIO_BAND_N79        = 1,  ///< The 5G N79 band.
    PRIO_BAND_WLAN_5_GHZ = 2   ///< The Wifi 5 GHz band.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN AP type.
 */
//--------------------------------------------------------------------------------------------------
ENUM APType
{
    UNKNOWN_AP,   ///< To skip setting AP type, pass UNKNOWN.
    PRIVATE_AP,   ///< Private AP.
    GUEST_AP      ///< Guest AP.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN security mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM SecurityMode
{
    SEC_MODE_UNKNOWN, ///< To skip setting security mode, pass UNKNOWN.
    SEC_MODE_OPEN,    ///< Open System Architecture.
    SEC_MODE_WEP,     ///< Wired Equivalent Privacy.
    SEC_MODE_WPA,     ///< Wi-Fi Protected Access.
    SEC_MODE_WPA2,    ///< Wi-Fi Protected Access II.
    SEC_MODE_WPA3     ///< Wi-Fi Protected Access III.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN security authentication methods.
 */
//--------------------------------------------------------------------------------------------------
ENUM SecurityAuthMethod
{
    SEC_AUTH_METHOD_UNKNOWN,    ///< To skip setting auth method, pass UNKNOWN.
    SEC_AUTH_METHOD_NONE,       ///< No Authentication - Open System.
    SEC_AUTH_METHOD_PSK,        ///< Pre-Shared Key.
    SEC_AUTH_METHOD_EAP_SIM,    ///< EAP - Subscriber Identity Module.
    SEC_AUTH_METHOD_EAP_AKA,    ///< EAP - Authentication and Key Agreement.
    SEC_AUTH_METHOD_EAP_LEAP,   ///< EAP - Lightweight Extensible Authentication Protocol.
    SEC_AUTH_METHOD_EAP_TLS,    ///< EAP - Transport Layer Security.
    SEC_AUTH_METHOD_EAP_TTLS,   ///< EAP - Tunneled Transport Layer Security.
    SEC_AUTH_METHOD_EAP_PEAP,   ///< EAP - Protected EAP.
    SEC_AUTH_METHOD_EAP_FAST,   ///< EAP - Flexible Authentication via Secure Tunneling.
    SEC_AUTH_METHOD_EAP_PSK,    ///< EAP - Pre-Shared Key.
    SEC_AUTH_METHOD_SAE         ///< Simultaneous Authentication of Equals.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN encryption methods.
 */
//--------------------------------------------------------------------------------------------------
ENUM SecurityEncryptionMethod
{
    SEC_ENCRYPT_METHOD_UNKNOWN,   ///< To skip setting encryption method, pass UNKNOWN.
    SEC_ENCRYPT_METHOD_RC4,       ///< Rivest Cipher 4.
    SEC_ENCRYPT_METHOD_TKIP,      ///< Temporal Key Integrity Protocol.
    SEC_ENCRYPT_METHOD_AES,       ///< Advanced Encryption Standard.
    SEC_ENCRYPT_METHOD_GCMP       ///< Galois/Counter Mode Protocol.
};

//--------------------------------------------------------------------------------------------------
/**
 * WLAN Service Set type.
 */
//--------------------------------------------------------------------------------------------------
ENUM ServiceSet
{
    SS_UNKNOWN,    ///< To skip setting encryption method, pass UNKNOWN.
    SS_BASIC,      ///< Basic Service Set(BSS).
    SS_EXTENDED    ///< Extended Service Set(ESS).
};

//-------------------------------------------------------------------------------------------------
/**
 * WLAN Device state.
 */
//-------------------------------------------------------------------------------------------------
ENUM DeviceState
{
    OFF,          ///< WLAN device is OFF.
    ON,           ///< WLAN device is ON.
    UNAVAILABLE   ///< WLAN device state is not available.
};

//-------------------------------------------------------------------------------------------------
/**
 * Supported WLAN Device modes.
 */
//-------------------------------------------------------------------------------------------------
ENUM DeviceMode
{
    MODE_UNKNOWN   = -1,    ///< Unsupported mode.
    MODE_AP        = 1,     ///< Single access point.
    MODE_STA       = 2,     ///< Single station.
    MODE_STA_AP    = 3,     ///< AP + STA.
    MODE_AP_AP     = 4,     ///< AP + AP.
    MODE_AP_AP_STA = 5      ///< AP + AP + STA.
};

//-------------------------------------------------------------------------------------------------
/**
 * AP identifier. Maximum number of identifiers will be MAX_NUM_AP.
 */
//-------------------------------------------------------------------------------------------------
ENUM APid
{
    AP_ID1 = 1,
    AP_ID2 = 2
};

//-------------------------------------------------------------------------------------------------
/**
 * STA identifier. Maximum number of identifiers will be MAX_NUM_STA.
 */
//-------------------------------------------------------------------------------------------------
ENUM STAid
{
    STA_ID1 = 1
};

//-------------------------------------------------------------------------------------------------
/**
 * AP interface information. This should be used to get AP reference.
 *
 */
//-------------------------------------------------------------------------------------------------
STRUCT APIntfInfo
{
    APid id;                                         ///< AP identifier
    string IntfName[taf_net.INTERFACE_NAME_MAX_LEN]; ///< Associated host interface name.
};

//-------------------------------------------------------------------------------------------------
/**
 * STA interface information. This should be used to get STA reference.
 *
 */
//-------------------------------------------------------------------------------------------------
STRUCT STAIntfInfo
{
    STAid id;                                         ///< STA identifier
    string IntfName[taf_net.INTERFACE_NAME_MAX_LEN];  ///< Associated host interface name.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the WLAN manager.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Wlan;

//-------------------------------------------------------------------------------------------------
/*
 * Events avaiable in WLAN Device Management service.
 */
//-------------------------------------------------------------------------------------------------

//-------------------------------------------------------------------------------------------------
/*
 * The WLAN device state event handler.
 *
 * @instaging
 *
 * @param[in] WlanRef    The WLAN reference. Set to NULL. Reserved for future use.
 * @param[in] state      The device state.
 * @param[in] contextPtr Context pointer.
 */
//-------------------------------------------------------------------------------------------------
HANDLER DeviceStateHandler
(
    Wlan WlanRef      IN, ///< The WLAN reference. Set to NULL. Reserved for future use.
    DeviceState state IN  ///< The device state.
);

//-------------------------------------------------------------------------------------------------
/*
 * Event to report the WLAN device state.
 *
 * @instaging
 *
 */
//-------------------------------------------------------------------------------------------------
EVENT DeviceState
(
    Wlan WlanRef               IN, ///< The WLAN reference. Reserved for future use.
    DeviceStateHandler handler IN
) = (0,1);

//-------------------------------------------------------------------------------------------------
/*
 * APIs avaiable in WLAN Device Management service.
 */
//-------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Turns WLAN device ON. This action brings up the respective WLAN host interface.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t TurnOn
(
    Wlan WlanRef      IN ///< The WLAN reference. Reserved for future use.
) = 2;

//--------------------------------------------------------------------------------------------------
/**
 * Turns WLAN device OFF. This action removes the respective WLAN host interface.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t TurnOff
(
    Wlan WlanRef      IN ///< The WLAN reference. Reserved for future use.
) = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the WLAN Device state.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetState
(
    Wlan WlanRef      IN,     ///< The WLAN reference. Reserved for future use.
    DeviceState state OUT     ///< WLAN device state.
) = 4;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the WLAN operating mode. Mode changes will take effect after a device off/on.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetMode
(
    Wlan WlanRef         IN, ///< The WLAN reference. Reserved for future use.
    DeviceMode wlanMode  IN  ///< The WLAN device mode.
) = 5;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the WLAN operating mode
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMode
(
    Wlan WlanRef         IN,  ///< The WLAN reference. Reserved for future use.
    DeviceMode wlanMode  OUT  ///< The WLAN device mode.
) = 6;

//--------------------------------------------------------------------------------------------------
/**
 * Gets active WLAN interface(s) information.
 * The information returned should be used to get the AP and STA reference(s) respectively.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIntfInfo
(
    Wlan WlanRef IN,                           ///< The WLAN reference. Reserved for future use.
    APIntfInfo  APIntfinfo[MAX_NUM_AP] OUT,    ///< The WLAN AP interfaces information.
    STAIntfInfo STAIntfinfo[MAX_NUM_STA] OUT   ///< The WLAN STA interfaces information.
) = 7;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the WLAN 5GHz and N79 5G band interference state.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - LE_NOT_POSSIBLE  The data subsystem has not been initialized.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetBandIntState
(
    Wlan                         WlanRef    IN,  ///< The WLAN reference. Reserved for future use.
    BandIntState                 state     OUT   ///< The band interference configuration state.
) = 8;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the WLAN 5GHz and N79 5G band interference state. This API should be called after the
 * priority band and the band wait times are set. If they are not set previously, the default
 * values will be used.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - LE_NOT_POSSIBLE  The data subsystem has not been initialized.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetBandIntState
(
    Wlan                         WlanRef    IN,  ///< The WLAN reference. Reserved for future use.
    BandIntState                 state      IN   ///< The band interference configuration state.
) = 9;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the WLAN 5GHz and N79 5G band interference priority. The value returned is the one that was
 * activated by called taf_wlan_SetBandIntState.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - LE_NOT_POSSIBLE  The data subsystem has not been initialized.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetBandIntPriority
(
    Wlan                         WlanRef      IN,  ///< The WLAN reference. Reserved for future use.
    BandIntPriority              bandPriority OUT  ///< The band interference priority.
) = 10;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the WLAN 5GHz and N79 5G band interference priority. By default N79 5G band will be set as
 * higher priority.
 *
 * The setting will take effect only after taf_wlan_SetBandIntState is called.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - LE_NOT_POSSIBLE  The data subsystem has not been initialized.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetBandIntPriority
(
    Wlan                         WlanRef      IN,  ///< The WLAN reference. Reserved for future use.
    BandIntPriority              bandPriority IN   ///< The band interference priority.
) = 11;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the wait time for WLAN 5GHz and 5G N79 bands. The value returned is the one that was
 * activated by called taf_wlan_SetBandIntState.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - LE_NOT_POSSIBLE  The data subsystem has not been initialized.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetBandIntWaitTime
(
    Wlan                         WlanRef   IN,   ///< The WLAN reference. Reserved for future use.
    BandIntPriority              band      IN,   ///< The band for which wait time is needed.
    uint32                       waitTime  OUT   ///< The wait time in seconds.
) = 12;

//--------------------------------------------------------------------------------------------------
/**
 * Sets the wait time for WLAN 5GHz and 5G N79 bands if enabled.
 *
 * Sets priority for modem to use either 5GHz WLAN or N79 5G band when they are both available to
 * avoid interference. The expected behavior based on the band priority is as follows:<br>
 *
 * N79 5G band is configured as higher priority: If N79 5G band becomes available while 5 GHz WLAN
 * is enabled, WLAN(AP/Sta) will be moved to 2.4 GHz. If N79 5G band becomes unavailable for the
 * configured N79 5G band wait time in seconds, WLAN will be moved to 5GHz.
 *
 * WLAN 5GHz is configured as higher priority: If WLAN 5GHz (AP/Sta) becomes available while 5G band
 * N79 is enabled, N79 5G band will be disabled. If WLAN 5GHz becomes unavailable for the
 * configured WLAN 5G wait time in seconds and N79 5G band is available, N79 5G band will be
 * enabled.
 *
 * By default, the wait time for both bands is set to 30s.
 *
 * The setting will take effect only after taf_wlan_SetBandIntState is called.
 *
 * @instaging
 *
 * @return
 * - LE_OK            Succeeded.
 * - LE_NOT_POSSIBLE  The data subsystem has not been initialized.
 * - Appropriate error is returned on failure.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetBandIntWaitTime
(
    Wlan                         WlanRef   IN,  ///< The WLAN reference. Reserved for future use.
    BandIntPriority              band      IN,  ///< The band for which to set the wait time.
    uint32                       waitTime  IN   ///< The wait time in seconds.
) = 13;
