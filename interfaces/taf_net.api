(
    VlanEntry vlanEntryRef                    IN, ///< VLAN entry reference.
    bool isAccelerated                        OUT  ///< Is accelerated or not.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the profile id bound with a VLAN by the VLAN entry reference.
 *
 * @return
 *   - Others -- Success.
 *   - -1 -- No binding.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION int32 GetVlanBoundProfileId
(
    VlanEntry vlanEntryRef                    IN ///< VLAN entry reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Binds a VLAN with a specified profile ID.
 * Note: if bind VLAN with default profile id, the system will auto reboot after 5 seconds
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- VLAN is not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t BindVlanWithProfile
(
    Vlan vlanRef                              IN, ///< VLAN Reference.
    uint32 profileId                          IN  ///< Profile id for VLAN association.
);

//--------------------------------------------------------------------------------------------------
/**
 * Unbinds a VLAN from previous profile ID.
 * Note: if unbind VLAN from default profile id, the system will auto reboot after 5 seconds
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- VLAN is not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UnbindVlanFromProfile
(
    Vlan vlanRef                              IN ///< VLAN Reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Synchronously enables L2TP for unmanaged Tunnel State.
 *
 * Note: If wants to use L2TP feature, need to set device mode with value 1 firstly.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t EnableL2tp
(
    bool enableMss                       IN,///< Enable TCP MSS to be clamped on L2TP interfaces.
    bool enableMtu                       IN,///< Enable MTU size to be set on underlying interfaces.
    uint32 mtuSize                       IN ///< Optional MTU size in bytes, default is 1422.
);

//--------------------------------------------------------------------------------------------------
/**
 * Asynchronously enables L2TP for unmanaged Tunnel State
 */
//--------------------------------------------------------------------------------------------------
FUNCTION EnableL2tpAsync
(
    bool enableMss                       IN,///< Enable TCP MSS to be clamped on L2TP interfaces.
    bool enableMtu                       IN,///< Enable MTU size to be set on underlying interfaces.
    uint32 mtuSize                       IN, ///< optional MTU size in bytes, default is 1422.
    AsyncL2tpHandler handler             IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Synchronously disables L2TP for unmanaged Tunnel State.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DisableL2tp
(
);

/**
 * Asynchronously disables L2TP for unmanaged Tunnel State.
 *
 * @return None.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION DisableL2tpAsync
(
    AsyncL2tpHandler handler                IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Is L2TP enabled.
 *
 * @return
 *   - false -- L2TP is disabled.
 *   - true -- L2TP is enabled.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsL2tpEnabled
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Is Mss(Maximum Segment Size) enabled.
 *
 * @return
 *   - false -- Mss is disabled for L2TP.
 *   - true -- Mss is enabled for L2TP.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsL2tpMssEnabled
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Is Mtu(Maximum Transmission Unit) enabled.
 *
 * @return
 *   - false -- Mtu is disabled for L2TP.
 *   - true -- Mtu is enabled for L2TP.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsL2tpMtuEnabled
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets L2TP MTU size.
 *
 * @return
 *   - 0 -- Failure.
 *   - Others -- Success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION uint32 GetL2tpMtuSize
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Creates a L2TP tunnel.
 *
 * @return
 *   - NULL -- Failure.
 *   - Others -- The reference of a tunnel.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Tunnel CreateTunnel
(
    L2tpEncapProtocol encaProto               IN, ///< Encapsulation protocol, UDP or IP.
    uint32 locId                              IN, ///< Local tunnel id.
    uint32 peerId                             IN, ///< Peer tunnel id.
    string peerIpAddr[IPV6_ADDR_MAX_LEN]      IN, ///< Peer IP addr.
    string ifName[INTERFACE_NAME_MAX_LEN]     IN  ///< Interface name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes an L2TP tunnel.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveTunnel
(
    Tunnel tunnelRef                          IN ///< Tunnel reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets UDP ports for a tunnel.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- Not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetTunnelUdpPort
(
    Tunnel tunnelRef                          IN, ///< Tunnel reference.
    uint32 localUdpPort                       IN, ///< Local UDP port - if UDP encapsulation is used.
    uint32 peerUdpPort                        IN  ///< Peer UDP port - if IP encapsulation is used.
);

