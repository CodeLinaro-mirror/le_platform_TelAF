policy_module(tafIvssRadioSvc, 1.0)

gen_require(`
  type sysfs_t;
  type systemd_tmpfiles_t;
  type tmp_t;
  type proc_net_t;
  type unreserved_port_t;
  type node_t;
')

# Framework definition for telaf
type telaf_tafIvssRadioSvc_exec_t;
files_type(telaf_tafIvssRadioSvc_exec_t);

type telaf_tafIvssRadioSvc_t;

type telaf_tafIvssRadioSvc_data_t;
files_type(telaf_tafIvssRadioSvc_data_t);

# Run the service in its own confined domain
init_telaf_app_domain(telaf_tafIvssRadioSvc_t,telaf_tafIvssRadioSvc_exec_t)

# Allow update daemon to install/uninstall this service
telaf_admin_manage_all_files_perms(telaf_tafIvssRadioSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafIvssRadioSvc_exec_t)

# Allow systemd to get attribute of /tmp/vsomeip-0
allow systemd_tmpfiles_t tmp_t:sock_file { getattr };

# Allow tafIvssRadioSvc to manipulate dir in tmpfs
allow telaf_tafIvssRadioSvc_t tmp_t:dir manage_dir_perms;

# Allow tafIvssRadioSvc to manipulate file in tmpfs
allow telaf_tafIvssRadioSvc_t tmp_t:file manage_file_perms;

# Allow tafIvssRadioSvc to manipulate sock file in tmpfs
allow telaf_tafIvssRadioSvc_t tmp_t:sock_file manage_sock_file_perms;

# Allow tafIvssRadioSvc to manipulate udp/tcp socket
allow telaf_tafIvssRadioSvc_t self:udp_socket create_socket_perms;
allow telaf_tafIvssRadioSvc_t self:tcp_socket create_stream_socket_perms;

# Allow tafIvssRadioSvc to manipulate netlink_route_socket
allow telaf_tafIvssRadioSvc_t self:netlink_route_socket rw_netlink_socket_perms;

# Allow telaf_tafIvssRadioSvc_t to manipulate capabilites
allow telaf_tafIvssRadioSvc_t self:capability { net_admin };
allow telaf_tafIvssRadioSvc_t self:capability { sys_resource };

# Misc rules for network socket
allow telaf_tafIvssRadioSvc_t proc_net_t:file read_file_perms;
allow telaf_tafIvssRadioSvc_t { unreserved_port_t node_t }:udp_socket { name_bind node_bind };
allow telaf_tafIvssRadioSvc_t { unreserved_port_t node_t }:tcp_socket { name_bind node_bind name_connect };

# Allow telaf_tafIvssRadioSvc_t and telaf_tafSomeipGWSvc_t to connectto unix_stream_socket
telaf_tafSomeipGWSvc_connect(telaf_tafIvssRadioSvc_t)
