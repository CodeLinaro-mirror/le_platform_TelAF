username: telaf
maxThreads: 600
sandboxed: false
executables:
{
    tafSAServerUnitTest = ( tafSAPUnitTestComp )
}


processes:
{
    run:
    {
        (tafSAServerUnitTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafSAServerUnitTest.tafSAPUnitTestComp.taf_simSap -> tafRemoteSimSvc.taf_simSap
}

