//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafDiagEvent Diag Event Management Service
 *
 * @rst :ref:`API reference <File taf_diagEvent_interface.h>` @endrst
 *
 * <HR>
 *
* Diag Event Management Service provides APIs for applications to process diagnostic events (errors)
* and associated data. Further, Diag Event Management Service provides interface function for the
* DTC service to get fault detection counter and clear DTC information.
 *
 * @section c_taf_diagEvent_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafDiagSvc platform service.
 *
 * The following example illustrates how to bind to the diag Event Management service.
 *
 * @verbatim
   bindings:
   {
        clientExe.clientComponent.taf_diagEvent -> tafDiagSvc.taf_diagEvent
   }
   @endverbatim
 *
 * @section c_taf_diagEvent_SetOperationCycleState_API Operation Cycle API
 *
 * taf_diagEvent_SetOperationCycleState() can be used to set operation cycle state for the specified
 * operation cycle id.
 *
 * The following example illustrates how to start the operation cycle.
 *
 * @code
 *
   le_result_t result = taf_diagEvent_SetOperationCycleState(DRIVING_CYCLE,
        TAF_DIAGEVENT_CYCLE_START);
   if (result != LE_OK)
   {
      LE_ERROR("Fail to start operation.");
      return result;
   }
   @endcode
 *
 * @section c_taf_diagEvent_server_API Server Service APIs
 *
 * A diag event service reference should be got using taf_diagEvent_GetService(). Use the
 * returned reference for subsequent operations.
 *
 * The following example illustrates how to set up a diag event server-service-instance.
 *
 * @code
   taf_diagEvent_ServiceRef_t svcRef;    // Service reference
 *
   // Get the service reference.
   svcRef = taf_diagEvent_GetService(eventId);
   LE_ASSERT(svcRef != NULL);
   @endcode
 *
 * @section c_taf_diag_event_set_status Set event status
 *
 * After getting the service reference, an application can call taf_diagEvent_SetStatus() or
 * taf_diagEvent_SetStatusWithSupplierFaultCode() to set the event status, and diag Event Management
 * service processes the event and generates DTC/event information, including event UDS status, DTC
 * status, fault detection counter, occurrence counter, etc.
 *
 * @code
   le_result_t result=taf_diagEvent_SetStatus(svcRef,TAF_DIAGEVENT_PREFAILED);
   if (result != LE_OK)
   {
      LE_ERROR("Fail to set event status with PREFAILED.");
      return result;
   }
   @endcode
 *
 * The following APIs are supported for event management:
 *
 * - taf_diagEvent_GetId() -- Gets the event ID for the given service reference.
 * - taf_diagEvent_SetStatus() -- Gets event status.
 * - taf_diagEvent_SetStatusWithSupplierFaultCode() -- Sets event status with supplier fault code.
 * - taf_diagEvent_GetUdsStatus() -- Gets event UDS status.
 * - taf_diagEvent_ResetDebounceStatus() -- Resets debounce status.
 * - taf_diagEvent_AddUdsStatusHandler() -- Adds a handler for event UDS status changes.
 * - taf_diagEvent_RemoveUdsStatusHandler() -- Removes a handler for event UDS status changes.
 * - taf_diagEvent_RemoveSvc() -- Removes the Event Management service.
 * - taf_diagEvent_AddEnableCondStateHandler() -- Adds a handler for Enable Condition state change.
 * - taf_diagEvent_RemoveEnableCondStateHandler() -- Removes a handler for Enable Condition state change.
 *
 * <HR>
 *
 */
//-------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Supplier fault code maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE SUPPLIER_FAULT_CODE_MAX_LEN = (10);

//--------------------------------------------------------------------------------------------------
/**
 * Diag Event status.
 */
//--------------------------------------------------------------------------------------------------
ENUM StatusType
{
    PASSED = 0x00,                  ///< Test result passed.
    FAILED,                         ///< Test result failed.
    PREPASSED,                      ///< Test result pre-passed.
    PREFAILED,                      ///< Test result pre-failed.
    CONFIRMED,                      ///< Test confirmed.
    TEST_NOT_COMPLETED,             ///< Test not completed.
    UNKNOWN = 0xff,                 ///< Unknown.
};

//--------------------------------------------------------------------------------------------------
/**
 * Operation cycle state.
 */
//--------------------------------------------------------------------------------------------------
ENUM OperationCycleState
{
    CYCLE_STOP = 0x00,                     ///< Operation cycle is stopped.
    CYCLE_START,                           ///< Operation cycle is started.
    CYCLE_RESTART,                         ///< Restart.
};

//--------------------------------------------------------------------------------------------------
/**
 * Debounce reset status.
 */
//--------------------------------------------------------------------------------------------------
ENUM DebounceResetStatus
{
    DEBOUNCE_FREEZE = 0x00,         ///< Freeze the counter.
    DEBOUNCE_RESET                  ///< Reset the counter.
};

//--------------------------------------------------------------------------------------------------
/**
 * Occurrence type.
 */
//--------------------------------------------------------------------------------------------------
ENUM OccurrenceType
{
    FIRST_OCCURRENCE = 0x00,                  ///< First occurrence.
    LAST_OCCURRENCE,                          ///< Last occurrence.
    LAST_DISAPPEARANCE,                       ///< Last disappearance.
    UNKNOWN_OCCURRENCE                        ///< Unknown.
};

//--------------------------------------------------------------------------------------------------
/**
 * UDS status byte type.
 */
//--------------------------------------------------------------------------------------------------
BITMASK UdsStatusByteType
{
    UDS_STATUS_TF,                          ///< Test failed.
    UDS_STATUS_TFTOC,                       ///< Test failed this operation cycle.
    UDS_STATUS_PDTC,                        ///< Pending DTC.
    UDS_STATUS_CDTC,                        ///< Confirmed DTC.
    UDS_STATUS_TNCSLC,                      ///< Test not completed since last clear.
    UDS_STATUS_TFSLC,                       ///< Test failed since last clear.
    UDS_STATUS_TNCTOC,                      ///< Test not completed this operation cycle.
    UDS_STATUS_WIR                          ///< Warning indicator requested.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the Event Management service.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Service;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference to a Event Management service, if there is no Event Management service, a new
 * one will be created.
 *
 * @return
 *     - Reference to the service instance.
 *     - NULL if not allowed to create the service.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Service GetService
(
    uint16 eventId IN
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the event ID for the given event reference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetId
(
    Service svcRef  IN,           ///< The event reference.
    uint16 eventId  OUT           ///< The event ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the event status.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid service reference.
 *     - LE_FAULT -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetStatus
(
    Service svcRef  IN,           ///< Service reference.
    StatusType eventStatus  IN    ///< Event status.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the event status with supplier fault code.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid service reference.
 *     - LE_FAULT -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetStatusWithSupplierFaultCode
(
    Service svcRef  IN,                                          ///< Service reference.
    StatusType eventStatus  IN,                                  ///< Event status.
    uint8 supplierFaultCode[SUPPLIER_FAULT_CODE_MAX_LEN]  IN     ///< Supplier Fault Code.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the event UDS status.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid service reference.
 *     - LE_FAULT -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetUdsStatus
(
    Service svcRef  IN,              ///< Service reference.
    uint8 eventUdsStatus  OUT        ///< Event UDS status.
);

//--------------------------------------------------------------------------------------------------
/**
 * Resets the debounce status.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid service reference.
 *     - LE_FAULT -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ResetDebounceStatus
(
    Service svcRef  IN,               ///< Service reference.
    DebounceResetStatus status  IN    ///< Event UDS status.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for a UDS status.
 */
//--------------------------------------------------------------------------------------------------
HANDLER UdsStatusHandler
(
    Service svcRef  IN,          ///< Service reference.
    uint8 eventUdsStatus  IN     ///< Event UDS status.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on UDS status.
 */
//--------------------------------------------------------------------------------------------------
EVENT UdsStatus
(
    Service  svcRef,             ///< Service reference.
    UdsStatusHandler  handler    ///< UDS status handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for a Enable Condition state.
 */
//--------------------------------------------------------------------------------------------------
HANDLER EnableCondStateHandler
(
    Service svcRef  IN,          ///< Service reference.
    bool state  IN               ///< Enable Condition state.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on Enable Condition state.
 */
//--------------------------------------------------------------------------------------------------
EVENT EnableCondState
(
    Service  svcRef,                        ///< Service reference.
    EnableCondStateHandler  handler         ///< Enable Condition state handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the state of an operation cycle.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_FAULT -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetOperationCycleState
(
    uint8 operationCycleId  IN,           ///< Operation cycle ID.
    OperationCycleState state  IN         ///< Operation cycle state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes the Event Management service.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveSvc
(
    Service svcRef  IN    ///< Service reference.
);
