USETYPES taf_types.api;

DEFINE  SMSC_ADDR_BYTES = (25);
DEFINE  TIMESTAMP_LEN   = (20);
DEFINE  TIMESTAMP_BYTES = (TIMESTAMP_LEN+1);
DEFINE  TEXT_LEN    = (160);
DEFINE  TEXT_BYTES  = (TEXT_LEN+1);
DEFINE  BINARY_BYTES  = (140);
DEFINE  UCS2_BYTES  = (140);
DEFINE  UCS2_CHARS  = (70);
DEFINE  PDU_PAYLOAD = (140);
DEFINE  PDU_BYTES   = (36+PDU_PAYLOAD);

ENUM Storage
{
    STORAGE_NV,
    STORAGE_SIM,
    STORAGE_HLOS,
    STORAGE_UNKNOWN
};

//--------------------------------------------------------------------------------------------------
/**
 * Full storage indication type.
 *
 * To notify client app with differet storage status, the following notifications will be
 * sent to client with storage full indications
 *
 * When preferred storage is set as HLOS:
 * - FULL_HLOS_ALERT:        means HLOS stoage reaches the alert threshold (currently 80%)
 *                           of usage
 * - FULL_HLOS:              means HLOS storage reaches 100% usage, there is no free slot
 * - FULL_HLOS_STORE_TO_SIM: means delivered message is stored to SIM
 * - FULL_BOTH_HLOS_AND_SIM: means both HLOS and SIM storage is run out
 *
 * When preferred storage is set as NV (not supported):
 * - FULL_NV: currently is not supported
 *
 * When preferred storage is set as SIM:
 * - FULL_SIM: means SIM storage is full
*/
//--------------------------------------------------------------------------------------------------
ENUM StorageFullType
{
    FULL_UNKNOWN,           ///< Unknown.
    FULL_HLOS_ALERT,        ///< HLOS storage is goint to be full.
    FULL_HLOS,              ///< HLOS storage is full.
    FULL_HLOS_STORE_TO_SIM, ///< HLOS storage is full and message is stored in SIM.
    FULL_BOTH_HLOS_AND_SIM, ///< Both HLOS storage and SIM storage are full.
    FULL_NV,                ///< NV storage is full.
    FULL_SIM                ///< SIM storage is full.
};

ENUM Type
{
    TYPE_TX,
    TYPE_RX,
    TYPE_UNKNOWN
};

ENUM ReadStatus
{
    RXSTS_READ,
    RXSTS_UNREAD,
    RXSTS_UNKNOWN
};

ENUM SendStatus
{
    TXSTS_UNSENT,
    TXSTS_SENDING,
    TXSTS_SENT,
    TXSTS_SENDING_FAILED,
    TXSTS_SENDING_TIMEOUT,
    TXSTS_UNKNOWN
};

ENUM LockStatus
{
    LKSTS_LOCKED,
    LKSTS_UNLOCKED,
    LKSTS_UNKNOWN
};

ENUM Format
{
    FORMAT_TEXT,
    FORMAT_BINARY,
    FORMAT_UCS2,
    FORMAT_PDU,
    FORMAT_UNKNOWN
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference type for SMS Message objects
 */
//--------------------------------------------------------------------------------------------------

REFERENCE Msg;

//--------------------------------------------------------------------------------------------------
/**
 * Reference type for SMS Message List
 */
//--------------------------------------------------------------------------------------------------

REFERENCE MsgList;

//--------------------------------------------------------------------------------------------------
/**
 * Create message list for accessing messages
 * @return the created message list
 */
//--------------------------------------------------------------------------------------------------

FUNCTION MsgList CreateRxMsgList
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Delete message list
 */
//--------------------------------------------------------------------------------------------------

FUNCTION DeleteList
(
    MsgList msgListRef
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for sending message
 */
//--------------------------------------------------------------------------------------------------

HANDLER CallbackResult
(
    Msg msgRef,
    SendStatus status IN
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for receiving message
 */
//--------------------------------------------------------------------------------------------------

HANDLER RxMsgHandler
(
    Msg  msgRef
);

//--------------------------------------------------------------------------------------------------
/**
 * Event for handler usage
 */
//--------------------------------------------------------------------------------------------------

EVENT RxMsg
(
    RxMsgHandler handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for full storage notification
 */
//--------------------------------------------------------------------------------------------------

HANDLER FullStorageHandler
(
    StorageFullType  fullType
);

//--------------------------------------------------------------------------------------------------
/**
 * Event for information on full storage notification
 */
//--------------------------------------------------------------------------------------------------

EVENT FullStorageEvent
(
    FullStorageHandler handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Get first message of list
 * @return the first message of message list
 */
//--------------------------------------------------------------------------------------------------

FUNCTION Msg GetFirst
(
    MsgList msgListRef
);

//--------------------------------------------------------------------------------------------------
/**
 * Get next message of list
 * @return the next message from tmp link of the message list
 */
//--------------------------------------------------------------------------------------------------

FUNCTION Msg GetNext
(
    MsgList msgListRef
);

//--------------------------------------------------------------------------------------------------
/**
 * Get send status of message
 * @return the send status of message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION SendStatus GetSendStatus
(
    Msg msgRef
);

//--------------------------------------------------------------------------------------------------
/**
 * Get read status of message
 * @return the read status of message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION ReadStatus GetReadStatus
(
    Msg msgRef
);

//--------------------------------------------------------------------------------------------------
/**
 * Get lock status of message
 * @return the lock status of message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION LockStatus GetLockStatus
(
    Msg msgRef
);

//--------------------------------------------------------------------------------------------------
/**
 * Create new message for sending
 * @return the created message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION Msg Create
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Set dentination phone number for message
 * @return the le_result of setting destination for message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION le_result_t SetDestination
(
    Msg     msgRef,
    string  dest[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN
);

//--------------------------------------------------------------------------------------------------
/**
 * Set text for message
 * @return the le_result of setting text for message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION le_result_t SetText
(
    Msg     msgRef,
    string  text[TEXT_LEN] IN
);

//--------------------------------------------------------------------------------------------------
/**
 * Set binary for message
 * @return the le_result of setting binary for message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION le_result_t SetBinary
(
    Msg     msgRef,                 ///< Reference to the message object.
    uint8   bin[BINARY_BYTES] IN  ///< Binary data.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set UCS2 for message
 * @return the le_result of setting UCS2 for message
 */
//--------------------------------------------------------------------------------------------------


FUNCTION le_result_t SetUCS2
(
    Msg     msgRef,                  ///< Reference to the message object.
    uint16  ucs2[UCS2_CHARS] IN  ///< UCS2 message.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set PDU format for message
 * @return the le_result of setting PDU format for message
 */
//--------------------------------------------------------------------------------------------------

FUNCTION le_result_t SetPDU
(
    Msg     msgRef,               ///< Reference to the message object.
    uint8   pdu[PDU_BYTES] IN ///< PDU message.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set callback function for message
 * @return the le_result of setting callback for message
 */
