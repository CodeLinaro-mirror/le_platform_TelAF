(
    int8    phoneId,                                        ///< Phone ID.
    string  addr[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] OUT  ///< Buffer to store SMS center address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set SMS center address
 * @return
 *     - LE_FAULT - Wait callback timeout or get error
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetSmsCenterAddress
(
    int8    phoneId,                                      ///< Phone ID.
    string  addr[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN ///< SMS center address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set preferred SMS storage place
 * @return
 *     - LE_FAULT - Function failed
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPreferredStorage
(
    Storage prefStorage IN ///< Preferred storage type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get preferred SMS storage place
 * @return
 *     - LE_FAULT - Function failed
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPreferredStorage
(
    Storage prefStorage OUT ///< Preferred storage type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Send PDU message
 * @return
 * - LE_FAULT - Function failed
 * - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendPduMsg
(
    uint8   dataPtr[PDU_BYTES] IN,  ///< Message in PDU format
    uint32  timeout                 ///< Timeout value for sending message
);
