provides:
{
    api:
    {
        taf_voicecall.api
    }
}

ldflags:
{
    -L$TELAF_DEFAULT_PA_LIB_DIR/lib
}

requires:
{
    api:
    {
        taf_ecall.api [optional]
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
    }

    lib:
    {
        libComponent_taf_pa_voicecall.so
        libComponent_taf_pa_voicecallDef.so
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -I$TELAF_PA_DEFAULT/include
    -std=c++17
}

sources:
{
    tafVoiceCallImpl.cpp
    tafVoiceCallSvr.cpp
}

