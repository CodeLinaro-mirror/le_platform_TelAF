			**>
            UInt32 echoUINT8E2E_ReqArg3
			<**
				@description : The crc value.
			**>
            UInt32 echoUINT8E2E_ReqArg4
			<**
				@description : The uint8 payload parameter.
			**>
            UInt8 echoUINT8E2E_ReqArg5
        }
        out {
			<**
				@description : The e2e header length.
			**>
            UInt16 echoUINT8E2E_ResArg1
			<**
				@description : The e2e counter value.
			**>
            UInt16 echoUINT8E2E_ResArg2
			<**
				@description : The e2e data Identifier.
			**>
            UInt32 echoUINT8E2E_ResArg3
			<**
				@description : The crc value.
			**>
            UInt32 echoUINT8E2E_ResArg4
			<**
				@description : The uint8 payload parameter.
			**>
            UInt8 echoUINT8E2E_ResArg5
        }
    }

