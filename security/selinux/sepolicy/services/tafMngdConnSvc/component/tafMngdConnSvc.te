policy_module(tafMngdConnSvc, 1.0)

# Framework definition for telaf
type telaf_tafMngdConnSvc_exec_t;
files_type(telaf_tafMngdConnSvc_exec_t);

type telaf_tafMngdConnSvc_t;

type telaf_tafMngdConnSvc_data_t;
files_type(telaf_tafMngdConnSvc_data_t);

init_telaf_app_domain(telaf_tafMngdConnSvc_t,telaf_tafMngdConnSvc_exec_t)
gen_require(`
    type telaf_tafDataCallSvc_t;
    type telaf_tafECallSvc_t;
    type telaf_tafMngdPMSvc_t;
    type telaf_tafNetSvc_t;
    type telaf_tafRadioSvc_t;
    type telaf_tafSimCardSvc_t;
')
telaf_ipc_bind(telaf_tafMngdConnSvc_t, telaf_tafSimCardSvc_t)
telaf_ipc_bind(telaf_tafMngdConnSvc_t, telaf_tafRadioSvc_t)
telaf_ipc_bind(telaf_tafMngdConnSvc_t, telaf_tafNetSvc_t)
telaf_ipc_bind(telaf_tafMngdConnSvc_t, telaf_tafMngdPMSvc_t)
telaf_ipc_bind(telaf_tafMngdConnSvc_t, telaf_tafECallSvc_t)
telaf_ipc_bind(telaf_tafMngdConnSvc_t, telaf_tafDataCallSvc_t)
telaf_use_device_manager(telaf_tafMngdConnSvc_t)


gen_require(`
    type etc_t;
    type home_root_t;
    type http_port_t;
    type net_conf_t;
    type proc_t;
    type shell_exec_t;
    type ping_exec_t;
    type systemd_resolved_var_run_t;
')

ifdef(`sa525m',`
    allow telaf_tafMngdConnSvc_exec_t telaf_admin_t:lnk_file {read};
    allow telaf_tafMngdConnSvc_t ping_exec_t:file { map };

')

#Allow for running curl and ping for ConnectivityTest in sa525
allow telaf_tafMngdConnSvc_t etc_t:file { getattr open read };
allow telaf_tafMngdConnSvc_t etc_t:lnk_file read;
allow telaf_tafMngdConnSvc_t home_root_t:dir search;
allow telaf_tafMngdConnSvc_t http_port_t:tcp_socket name_connect;
allow telaf_tafMngdConnSvc_t net_conf_t:file { getattr open read };
allow telaf_tafMngdConnSvc_t self:netlink_route_socket { bind create getattr nlmsg_read read write };
allow telaf_tafMngdConnSvc_t self:tcp_socket { read write connect create getattr getopt setopt };
allow telaf_tafMngdConnSvc_t self:udp_socket { connect create getattr read setopt write };
# execute_no_trans removed: shell must transition to a new domain, not run in
# telaf_tafMngdConnSvc_t.  Use corecmd_exec_shell() if a transition is defined.
allow telaf_tafMngdConnSvc_t shell_exec_t:file { execute open read };
allow telaf_tafMngdConnSvc_t proc_t:file { read open getattr};

#Allow for running curl and ping for ConnectivityTest in sa515
allow telaf_tafMngdConnSvc_t ping_exec_t:file { getattr open read execute execute_no_trans};
allow telaf_tafMngdConnSvc_t self:icmp_socket { create ioctl getopt read setopt write };
allow telaf_tafMngdConnSvc_t systemd_resolved_var_run_t:dir search;
allow telaf_tafMngdConnSvc_t systemd_resolved_var_run_t:file { getattr open read };
allow telaf_tafMngdConnSvc_t self:capability net_raw;
# sigkill and setcap removed: connection manager must not kill arbitrary
# processes or modify its own capability set.
allow telaf_tafMngdConnSvc_t self:process { getcap };
allow telaf_tafMngdConnSvc_t self:rawip_socket { create getopt read setopt write };
# Allow TLS certificate access for outbound connectivity checks (curl/ping).
telaf_use_cert_files(telaf_tafMngdConnSvc_t)


# Allow service to manage its own data directory; registers with admin domain.
telaf_manage_app_data_files(telaf_tafMngdConnSvc_t, telaf_tafMngdConnSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafMngdConnSvc_exec_t)

