sandboxed: false
executables:
{
    tafLocationUnitTest = ( tafLocationUnitTestComp )
}


processes:
{
    run:
    {
        (tafLocationUnitTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafLocationUnitTest.tafLocationUnitTestComp.taf_gnss -> tafLocationSvc.taf_gnss
    tafLocationUnitTest.tafLocationUnitTestComp.taf_pos -> tafLocationSvc.taf_pos
    tafLocationUnitTest.tafLocationUnitTestComp.taf_posCtrl -> tafLocationSvc.taf_posCtrl
}
