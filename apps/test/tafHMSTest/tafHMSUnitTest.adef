sandboxed: false

executables:
{
    tafHMSUnitTest = ( tafHMSUnitTest )
}

start: manual

processes:
{
    run:
    {
        (tafHMSUnitTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
    faultAction: stopApp
}

bindings:
{
    tafHMSUnitTest.tafHMSUnitTest.taf_hms -> tafHMSvc.taf_hms
}
