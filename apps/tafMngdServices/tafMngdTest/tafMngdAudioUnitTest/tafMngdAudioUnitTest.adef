maxThreads: 600
sandboxed: false

executables:
{
    tafMngdAudioUnitTest =
            ($TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdAudioUnitTest/tafMngdAudioUnitTestComp)
}

start: manual

processes:
{
    run:
    {
        (tafMngdAudioUnitTest)
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafMngdAudioUnitTest.tafMngdAudioUnitTestComp.taf_mngd_audio -> tafMngdAudioSvc.taf_mngd_audio
}
