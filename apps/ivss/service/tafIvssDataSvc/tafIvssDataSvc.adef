maxThreads: 600
sandboxed: false

start: manual

username: telaf

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_RAW
    CAP_IPC_LOCK
    CAP_SYS_NICE
    CAP_SYS_RESOURCE
    CAP_NET_ADMIN
    CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
    CAP_DAC_READ_SEARCH
    CAP_DAC_OVERRIDE
#endif
}

executables:
{
    tafIvssDataSvc = ( dataSvc )
}

processes:
{
    envVars:
    {
        VSOMEIP_CONFIGURATION = vsomeipRef.json
        COMMONAPI_CONFIG = commonapiRef.ini
    }

    run:
    {
        ( tafIvssDataSvc )
    }
    maxFileBytes: 8192K
}

bindings:
{
    tafIvssDataSvc.dataSvc.taf_mngdConn -> tafMngdConnSvc.taf_mngdConn
}
