DEFINE APP_NAME_BYTES = 48;
DEFINE APP_VERSION_BYTES = 101;
DEFINE APP_HASH_BYTES = 101;

/*
 * The reference of app list.
 */
REFERENCE AppList;

/*
 * The reference of app.
 */
REFERENCE App;

ENUM AppState
{
    STATE_STOPPED,
    STATE_STARTED
};

ENUM AppStartMode
{
    START_MANUAL,
    START_AUTO
};

/*
 * App information.
 */
STRUCT AppInfo
{
    string name[APP_NAME_BYTES];       // App name.
    string version[APP_VERSION_BYTES]; // App version.
    string hash[APP_HASH_BYTES];       // App hash.
    AppState state;                    // App state.
    AppStartMode startMode;            // App start mode.
    bool isSandboxed;                  // If it is a sandbox app.
};

FUNCTION AppState GetState
(
    string appName[APP_NAME_BYTES] IN // App name.
);

/*
 * Start an app.
 */
FUNCTION le_result_t Start
(
    string appName[APP_NAME_BYTES] IN // App name.
);

/*
 * Stop an app.
 */
FUNCTION le_result_t Stop
(
    string appName[APP_NAME_BYTES] IN // App name.
);

/*
 * Uninstall an app.
 */
FUNCTION le_result_t Uninstall
(
    string appName[APP_NAME_BYTES] IN // App name.
);

/*
 * Create app list.
 */
FUNCTION AppList CreateAppList
(
);

/*
 * Delete app list.
 */
FUNCTION le_result_t DeleteAppList
(
    AppList appListRef IN // App list reference.
);

/*
 * Get the reference of the first app.
 */
FUNCTION App GetFirstApp
(
    AppList appListRef IN // App list reference.
);

/*
 * Get the reference of the next app.
 */
FUNCTION App GetNextApp
(
    AppList appListRef IN // App list reference.
);

/*
 * Get app infomation.
 */
FUNCTION le_result_t GetAppDetails
(
    App appRef IN,      // App reference.
    AppInfo appInfo OUT // App info.
);
