maxThreads: 600
sandboxed: false

executables:
{
    tafKeyStoreSvc = ( $TELAF_ROOT/components/tafKeyStoreSvc )
    tafFSCryptSvc = ( $TELAF_ROOT/components/tafFSCryptSvc )
}

start: auto

username: telaf

startGroup: 11

capability:
{
        CAP_WAKE_ALARM
        CAP_FOWNER
        CAP_SYS_ADMIN
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
}

processes:
{
    run:
    {
        ( tafKeyStoreSvc )
        ( tafFSCryptSvc )
    }

    envVars:
    {
        LD_PRELOAD = /legato/systems/current/appsWriteable/tafKeyStoreSvc/lib/taf_pa_ioctl.so
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
    tafKeyStoreSvc.tafKeyStoreSvc.le_appInfo -> <tafcore>.le_appInfo
    tafKeyStoreSvc.taf_pa_keystore.le_appInfo -> <tafcore>.le_appInfo
    tafFSCryptSvc.taf_pa_fscrypt.le_appInfo -> <tafcore>.le_appInfo
    tafFSCryptSvc.tafFSCryptSvc.taf_ks -> tafKeyStoreSvc.taf_ks
    tafFSCryptSvc.tafFSCryptSvc.taf_pm -> tafPMSvc.taf_pm
}

extern:
{
    tafKeyStoreSvc.tafKeyStoreSvc.taf_ks
    tafFSCryptSvc.tafFSCryptSvc.taf_fsc
}
