executables:
{
        tafAudioSvc = ( $TELAF_ROOT/components/tafAudioSvc )
}

start: auto

processes:
{
        run:
        {
                (tafAudioSvc)
        }

        maxFileBytes: 8192K
        faultAction: restart
}

sandboxed: false

bindings:
{
}

extern:
{
        tafAudioSvc.tafAudioSvc.taf_audio
}
