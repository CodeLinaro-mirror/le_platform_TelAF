provides:
{
    api:
    {
        taf_therm.api
    }
}

requires:
{
    component:
    {
        $LEGATO_ROOT/components/watchdogChain

    }
    lib:
    {
        lib/libtelux_therm.so
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -ltelux_therm
    -ltelux_common
    -DLE_CONFIG_ENABLE_THERMAL_GET_TRIP_ID
    -DLE_CONFIG_ENABLE_THERMAL_GET_ZONE_ID
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
}

sources:
{
    tafThermSvc.cpp
    tafThermImpl.cpp
}