 *       function will not return.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ConfigureRobustLocation
(
    uint8 enable IN,     ///< Enable(1) or Disable(0)
    uint8 enabled911 IN  ///< Enable(1) or Diable for Enable911
);

