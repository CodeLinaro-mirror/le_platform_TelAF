sources:
{
    rpcPm/tafMngdRpcPm.cpp
    tafMngdPMImpl.cpp
    tafMngdPMSvc.cpp
}

provides:
{
    api:
    {
        $TELAF_ROOT/apps/tafMngdServices/interfaces/taf_mngdPm.api
    }
}

requires:
{
    api:
    {
        le_appInfo.api
        taf_pm = taf_pm.api                       // Local service interface
        taf_rpcPm = taf_pm.api  [manual-start]    // Remote service interface
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        $TELAF_ROOT/components/tafHalComp
    }
}

cxxflags:
{
    -I$TELAF_ROOT/include
    -I$TELAF_ROOT/apps/tafMngdServices/PM/Components/tafMngdPMSvc
    -I$TELAF_ROOT/apps/tafMngdServices/PM/Components/tafMngdPMSvc/rpcPm/tafMngdRpcPm
    -I$TELAF_ROOT/components/tafHalComp
    -I${LEGATO_ROOT}/framework/liblegato
    -I$TELAF_ROOT/include/vhal
    -I${LEGATO_ROOT}/components/watchdogChain
}

ldflags:
{
    -lboost_filesystem
}
