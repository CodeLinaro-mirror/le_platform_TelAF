{
    -L$TELAF_DEFAULT_PA_LIB_DIR/lib
}

requires:
{
    api:
    {
        le_cfg.api
        taf_ks.api
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
    }

    lib:
    {
        libtaf_pa_sms.so
        libtaf_pa_smsDef.so
    }
}

