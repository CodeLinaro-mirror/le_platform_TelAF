EXPORT_SYM std::vector<uint16_t> get_event_ids(uint32_t dtc_code)
{
    const DTCEntry& dtc = diagConf.dtc_all.at(dtc_code);
    const std::vector<int>& original_events = dtc.events;

    // Create a new vector with the correct type and copy the data, casting each element.
    std::vector<uint16_t> event_ids_as_u16;
    event_ids_as_u16.reserve(original_events.size());
    for (int event_id : original_events)
    {
        event_ids_as_u16.push_back(static_cast<uint16_t>(event_id));
    }
    return event_ids_as_u16; // Return the new vector by value.
}

