sandboxed: false

executables:
{
    tafSMSSvc = ( $TELAF_ROOT/components/tafSMSSvc )
}

start: auto

processes:
{
    run:
    {
        (tafSMSSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
    tafSMSSvc.taf_pa_sms.taf_ks -> tafKeyStoreSvc.taf_ks
}

extern:
{
    tafSMSSvc.tafSMSSvc.taf_sms
}
