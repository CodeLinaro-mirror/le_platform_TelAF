maxThreads: 300
groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
        tafSimCardSvc = ( $TELAF_ROOT/components/tafSimCardSvc )
}
start: auto

processes:
{
        run:
        {
                (tafSimCardSvc)
        }

        maxFileBytes: 8192K
        faultAction: restart
}

bindings:
{
}

extern:
{
        tafSimCardSvc.tafSimCardSvc.taf_sim
        tafSimCardSvc.tafSimCardSvc.taf_rsp
}

