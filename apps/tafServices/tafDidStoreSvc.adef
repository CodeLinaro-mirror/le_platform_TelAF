sandboxed: false

start: manual

maxThreads: 600
startGroup: 20

username: telaf

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_ADMIN
        CAP_SYS_ADMIN
        CAP_SYS_PTRACE
#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

executables:
{
    tafDidStoreSvc = ( $TELAF_ROOT/components/tafDidStoreSvc )
}

groups:
{
}

processes:
{
    run:
    {
        (tafDidStoreSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
    tafDidStoreSvc.tafDidStoreSvc.taf_diagDataID -> tafDiagSvc.taf_diagDataID
    tafDidStoreSvc.tafDidStoreSvc.le_appInfo -> <tafcore>.le_appInfo
}

extern:
{
    tafDidStoreSvc.tafDidStoreSvc.taf_diagDidStore
}
