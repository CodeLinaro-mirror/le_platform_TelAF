maxThreads: 600
username: telaf
startGroup: 11
sandboxed: false
start: auto

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_BIND_SERVICE
    CAP_BLOCK_SUSPEND
    CAP_SYS_BOOT

#if ${LE_CONFIG_TEST_COVERAGE} = y
    CAP_DAC_READ_SEARCH
    CAP_DAC_OVERRIDE
#endif
}

groups:
{
    system
    diag
    radio
    inet
    locclient
}

executables:
{
    tafPMSvc = ( $TELAF_ROOT/components/tafPMSvc )
}

processes:
{
    run:
    {
        (tafPMSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
    tafPMSvc.tafPMSvc.le_framework -> <tafcore>.le_framework
}

extern:
{
    tafPMSvc.tafPMSvc.taf_pm
}
