maxThreads: 700
start: manual
sandboxed: false

executables:
{
    tafMngdPmWsFilterTest = ( tafMngdPmWsFilterComp )
}

processes:
{
    run:
    {
        (tafMngdPmWsFilterTest)
    }

    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

bindings:
{
    tafMngdPmWsFilterTest.tafMngdPmWsFilterComp.taf_mngdPm -> tafMngdPMSvc.taf_mngdPm
}
