FUNCTION le_result_t GetSenderTel
(
    Msg     msgRef,                                       ///< Message reference.
    string  tel[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] OUT ///< Buffer to store sender number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get text of message
 * @return
 *     - LE_NOT_FOUND - Invalid message
 *     - LE_FAULT - Invalid input string
 *     - LE_OVERFLOW - String overflow
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetText
(
    Msg     msgRef,            ///< Message reference.
    string  text[TEXT_LEN] OUT ///< Buffer to store message text.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get binary data of message
 * @return
 *     - LE_NOT_FOUND - Invalid message
 *     - LE_FAULT - Invalid input string
 *     - LE_OVERFLOW - String overflow
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetBinary
(
    Msg     msgRef,               ///< Message reference.
    uint8   bin[BINARY_BYTES] OUT ///< Buffer to store binary data.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get UCS2 encoding of message
 * @return
 *     - LE_NOT_FOUND - Invalid message
 *     - LE_FAULT - Invalid input string
 *     - LE_OVERFLOW - String overflow
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetUCS2
(
    Msg     msgRef,               ///< Message reference.
    uint16  ucs2[UCS2_CHARS] OUT  ///< Buffer to store UCS2 characters.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get PDU format of message
 * @return
 *     - LE_NOT_FOUND - Invalid message
 *     - LE_FAULT - Invalid input string
 *     - LE_OVERFLOW - String overflow
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPDU
(
    Msg   msgRef,            ///< Message reference.
    uint8 pdu[PDU_BYTES] OUT ///< Buffer to store PDU format.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get PDU length of message
 * @return
 * - LE_NOT_FOUND - Invalid message
 * - LE_FAULT - Invalid input string
 * - LE_OVERFLOW - String overflow
 * - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION size GetPDULen
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get type of message
 * @return
 *     - The type of message
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Type GetType
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get format of message
 * @return
 *     - The format of message
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Format GetFormat
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get text length of message
 * @return
 *     - The text length of message
 */
//--------------------------------------------------------------------------------------------------
FUNCTION size GetUserdataLen
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Send message
 * @return
 *     - LE_NOT_FOUND - Invalid message
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Send
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Delete message from storage
 * @return
 *     - LE_NOT_FOUND - Invalid message
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteFromStorage
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Delete all messages from storage
 * In the case of HLOS storage, this API only delete those unlocked messages
 * @return
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteAllFromStorage
(
    Storage  storage
);

//--------------------------------------------------------------------------------------------------
/**
 * Mark message status as 'read'
 */
//--------------------------------------------------------------------------------------------------
FUNCTION MarkRead
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Mark message status as 'unread'
 */
//--------------------------------------------------------------------------------------------------
FUNCTION MarkUnread
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Mark message lock status as 'Locked', cannot be deleted from Storage
 * @return
 *     - LE_NOT_FOUND: Invalid message
 *     - LE_FAULT: Function failed
 *     - LE_OK: Function successful
 *     - LE_NOT_PERMITTED: Message have been locked or is not stored in HLOS
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t LockFromStorage
(
    Msg msgRef  ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Mark message lock status as 'unlocked', can be deleted from Storage
 * @return
 *     - LE_NOT_FOUND: Invalid message
 *     - LE_FAULT: Function failed
 *     - LE_OK: Function successful
 *     - LE_NOT_PERMITTED: Message is not locked or is not stored in HLOS
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UnlockFromStorage
(
    Msg msgRef  ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get SMS center address
 * @return
 *     - LE_OVERFLOW - Expected len is not enough
 *     - LE_OK - Function successful
 */
//--------------------------------------------------------------------------------------------------
