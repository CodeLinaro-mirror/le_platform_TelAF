//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafRadio Radio Service
 *
 * @ref taf_radio_interface.h "API Reference"
 *
 * <HR>
 *
 * The Radio Service APIs contain phone and network functions, and it is applied to configure and
 * obtain information of wireless cellular network. By default, radio service is powered on and
 * available by the system.
 *
 * @section taf_radio_binding IPC interfaces binding
 *
 * All the functions of this API are provided by the @b tafRadioSvc service.
 *
 * Here's a sample of how to bind to Radio Service:
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_radio -> tafRadioSvc.taf_radio
   }
 *
   @endverbatim
 *
 * @section c_taf_radio_power Power Management
 *
 * In this section, user can power on or power off the radio. By default, it is powered on.
 *
 * - taf_radio_SetRadioPower() / taf_radio_GetRadioPower() supports to set/get raido power status.
 *
 * Here is the example of powering on radio.
 *
 * @code
 *
   le_onoff_t power = LE_OFF;
   LE_ASSERT(taf_radio_SetRadioPower(LE_ON, slotId) == LE_OK);
   LE_ASSERT(taf_radio_GetRadioPower(&power, slotId) == LE_OK);
   LE_ASSERT(power == LE_ON);
 *
   @endcode
 *
 * @section c_taf_radio_registartion Network Registration
 *
 * In this section, user can register to network automatically or manually with specific MCC and MNC.
 *
 *  - taf_radio_SetAutomaticRegisterMode() supports to register to network automatically.
 *
 *  - taf_radio_SetManualRegisterMode() supports to register to network with MCC and MNC manually.
 *
 *  - taf_radio_GetRegisterMode() supports to get the network register mode.
 *
 *  - taf_radio_SetManualRegisterModeAsync() supports to register to network with handler asynchronously.
 *
 *  - taf_radio_AddNetRegRejectHandler() / taf_radio_RemoveNetRegRejectHandler() supports to add/remove
 * handler for network registration rejection.
 *
 *  - taf_radio_GetPlatformSpecificRegistrationErrorCode() supports to get the error code of network
 * registration.
 *
 * Here is the example of network registration.
 *
 * @code
 *
   LE_ASSERT(taf_radio_SetManualRegisterMode(mccStr1, mncStr1, slotId) == LE_OK);
   LE_ASSERT(taf_radio_GetPlatformSpecificRegistrationErrorCode() == 0);
   bool isManualMode = true;
   LE_ASSERT(taf_radio_GetRegisterMode(&isManualMode, mccStr2, TAF_RADIO_MCC_BYTES, mncStr2,
       TAF_RADIO_MNC_BYTES, slotId) == LE_OK);
   LE_ASSERT(isManualMode == true);
   LE_ASSERT(strcmp(mccStr1, mccStr2) == 0);
   LE_ASSERT(strcmp(mncStr1, mncStr2) == 0);
 *
   @endcode
 *
 * @section c_taf_radio_preferred_operator Preferred Operators
 *
 * In this section, user can configure the preferences of operators, and get the configuration details
 * with a list.
 *
 *  - taf_radio_GetPreferredOperatorsList() / taf_radio_DeletePreferredOperatorsList() supports to
   create/delete preferred operator list reference.
 *
 *  - taf_radio_AddPreferredOperator() / taf_radio_RemovePreferredOperator() supports to add/remove a
 * preferred operator.
 *
 *  - taf_radio_GetFirstPreferredOperator() / taf_radio_GetNextPreferredOperator() supports to get the
 * first/next preferred operator reference.
 *
 *  - taf_radio_GetPreferredOperatorDetails() supports to get the operator details.
 *
 * Here is the example of preferred operator list management.
 *
 * @code
 *
   // Add preference.
   for (int i = 0; i < PREFERRED_OPERATOR_NUM; i++) {
       taf_radio_AddPreferredOperator(prefMccStr[i], prefMncStr[i], prefRatMask, slotId);
   }

   // Create list.
   listRef = taf_radio_GetPreferredOperatorsList(slotId);

   // Traverse list
   opRef = taf_radio_GetFirstPreferredOperator(listRef);
   while (opRef != nullptr) {
       taf_radio_GetPreferredOperatorDetails(opRef, mccStr, TAF_RADIO_MCC_BYTES, mncStr,
           TAF_RADIO_MNC_BYTES, &ratMask);

       // Do something with the operator details.

       opRef = taf_radio_GetNextPreferredOperator(listRef);
   }

   // Delete list.
   taf_radio_DeletePreferredOperatorsList(listRef);

   // Remove preference.
   for (int i = 0; i < PREFERRED_OPERATOR_NUM; i++) {
       taf_radio_RemovePreferredOperator(prefMccStr[i], prefMncStr[i], slotId);
   }
 *
   @endcode
 *
 * @section c_taf_radio_rat Radio Access Technology
 *
 * In this section, user can get RAT in use, and configure RAT preferences.
 *
 *  - taf_radio_GetRadioAccessTechInUse() supports to get radio access technology in use.
 *
 *  - taf_radio_AddRatChangeHandler() / taf_radio_RemoveRatChangeHandler() supports to add/remove
 * handler for RAT change.
 *
 *  - taf_radio_SetRatPreferences() / taf_radio_GetRatPreferences() supports to set/get RAT peferences.
 *
 * Here is the example of RAT change indication.
 *
 * @code
 *
   // RAT change indication handler.
   static void RatChangeHandler(const taf_radio_RatChangeInd_t* indPtr, void* contextPtr)
   {
       LE_INFO("RAT: %d", indPtr->rat);
   }

   // Add handler for RAT change.
   handlerRef = taf_radio_AddRatChangeHandler((taf_radio_RatChangeHandlerFunc_t)RatChangeHandler, NULL);

   // RAT change in some cases.
 *
   @endcode
 *
 * @section c_taf_radio_cs_ps Circuit Switched and Packet Switched State
 *
 * In this section, user can get the circuit switched and packet switched state.
 *
 * - taf_radio_GetPacketSwitchedState() supports to get the circuit switched and packet switched state.
 *
 * - taf_radio_AddPacketSwitchedChangeHandler() / taf_radio_RemovePacketSwitchedChangeHandler() supports to
 * add/remove handler for CS/PS change.
 *
 * Here is the example of CS/PS change indication.
 *
 * @code
 *
   // CS/PS change indication handler.
   static void CsPsChangeHandler(const taf_radio_ServiceDomainState_t state, void* contextPtr)
   {
       LE_INFO("CS/PS state: %d", state);
   }

   // Add handler for CS/PS change.
   handlerRef = taf_radio_AddPacketSwitchedChangeHandler(
      (taf_radio_PacketSwitchedChangeHandlerFunc_t)CsPsChangeHandler, NULL);

   // CS/PS change in some cases.
 *
   @endcode
 *
 * @section c_taf_radio_signal_metrics Signal Metrics
 *
 * In this section, user can measure signal and get metrics of different RATs.
 *
 *  - taf_radio_GetSignalQual() supports to get the highest signal strength level.
 *
 *  - taf_radio_MeasureSignalMetrics() / taf_radio_DeleteSignalMetrics() supports to create/delete signal
 * metrics reference.
 *
 *  - taf_radio_GetRatOfSignalMetrics() supports to get cell RATs.
 *
 *  - taf_radio_GetGsmSignalMetrics() / taf_radio_GetUmtsSignalMetrics() / taf_radio_GetLteSignalMetrics() /
 * taf_radio_GetCdmaSignalMetrics() supports to get GSM/UMTS/LTE/CDMA signal metrics.
 *
 *  - taf_radio_AddSignalStrengthChangeHandler() / taf_radio_RemoveSignalStrengthChangeHandler() supports to
 * add/remove handler for signal strength change.
 *
 * Here is the example of getting LTE signal metrics.
 *
 * @code
 *
   metricRef = taf_radio_MeasureSignalMetrics(slotId);
   ratMask = taf_radio_GetRatOfSignalMetrics(metricRef);
   if (ratMask & TAF_RADIO_CELL_RAT_MASK_LTE) {
       LE_ASSERT(taf_radio_GetLteSignalMetrics(metricsRef, &ss, &rsrq, &rsrp, &snr) == LE_OK);
       LE_INFO("LTE signal strength in dBm: %d\n", ss);
       LE_INFO("LTE reference signal receive quality in dB : %d\n", rsrq);
       LE_INFO("LTE reference signal receive power in dBm : %d\n", rsrp);
       LE_INFO("LTE signal-to-noise ratio in dB : %d\n", snr);
   }
 *
   @endcode
 *
 * @section c_taf_radio_serving_cell Serving Cellular Network Information
 *
 * In this section, user can get information of serving cellular network.
 *
 *  - taf_radio_GetServingCellId() supports to get the Cell ID.
 * @warning Only applicatable for GSM/LTE/WCDMA/TDSCDMA.
 *
 *  - taf_radio_GetServingCellLocAreaCode() supports to get the Location Area Code.
 * @warning Only applicatable for  GSM/WCDMA/TDSCDMA.
 *
 *  - taf_radio_GetServingCellLteTracAreaCode() supports to get the Tracking Area Code.
 * @warning Only applicatable for LTE.
 *
 *  - taf_radio_GetServingCellEarfcn() supports to get the E-UTRA Absolute Radio Frequency Channel Number.
 * @warning Only applicatable for LTE.
 *
 *  - taf_radio_GetServingCellTimingAdvance() supports to get the Timing Advance.
 * @warning Only applicatable for GSM/LTE.
 *
 *  - taf_radio_GetPhysicalServingLteCellId() supports to get the Physical cell ID.
 * @warning Only applicatable for LTE.
 *
 *  - taf_radio_GetServingCellGsmBsic() supports to get the Base Statation ID.
 * @warning Only applicatable for GSM.
 *
 *  - taf_radio_GetServingCellScramblingCode() supports to get the Primary Scrambling Code.
 * @warning Only applicatable for WCDMA.
 *
 * @section c_taf_radio_network Network Information
 *
 * APIs described in this section, the user can use them to get the current network, and discover nearby networks
 * by scanning.
 *
 *  - taf_radio_GetCurrentNetworkName() supports to get current network name.
 *
 *  - taf_radio_GetCurrentNetworkMccMnc() supports to get current network MCC and MNC.
 *
 *  - taf_radio_PerformCellularNetworkScan() / taf_radio_DeleteCellularNetworkScan() supports to create/delete
 * a list reference for performing network scan.
 *
 *  - taf_radio_PerformCellularNetworkScanAsync() supports to perform network scan with handler
 * asynchronously.
 *
 *  - taf_radio_GetFirstCellularNetworkScan() / taf_radio_GetNextCellularNetworkScan() supports to get
 * first/next reference of operator in network scan list.
 *
 *  - taf_radio_GetCellularNetworkMccMnc() supports to get MCC and MNC of a network scan operator.
 *
 *  - taf_radio_GetCellularNetworkMccMnc() supports to get the name of a network scan operator.
 *
 *  - taf_radio_IsCellularNetworkInUse() supports to check if using the network scan operator's network.
 *
 *  - taf_radio_IsCellularNetworkAvailable() supports to check if network is available.
 *
 *  - taf_radio_IsCellularNetworkHome() supports to check if it is home network.
 *
 *  - taf_radio_IsCellularNetworkForbidden() supports to check if network is forbidden.
 *
 * When users fail to register to current network, they may scan and find the nearby networks, and register to
 * an available network with MCC and MNC manually. Here is the example of scanning network.
 *
 * @code
 *
   // Create list and perform network scan.
   listRef = taf_radio_PerformCellularNetworkScan(slotId);

   // Traverse list
   opRef = taf_radio_GetFirstCellularNetworkScan(listRef);
   while (opRef != nullptr) {
       LE_ASSERT(taf_radio_GetCellularNetworkName(opRef, name, TAF_RADIO_NETWORK_NAME_MAX_LEN) == LE_OK);
       LE_ASSERT(taf_radio_GetCellularNetworkMccMnc(opRef, mcc, TAF_RADIO_MCC_BYTES,
           mnc, TAF_RADIO_MNC_BYTES) == LE_OK);
       inUse = taf_radio_IsCellularNetworkInUse(opRef);
       available = taf_radio_IsCellularNetworkAvailable(opRef);
       fobbiden = taf_radio_IsCellularNetworkForbidden(opRef);
       home = taf_radio_IsCellularNetworkHome(opRef);

       // Do something with the network scan information.

       opRef = taf_radio_GetNextCellularNetworkScan(listRef);
   }

   // Delete list.
   taf_radio_DeleteCellularNetworkScan(listRef);
 *
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * Mobile Country Code length without null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MCC_LEN = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Mobile Network Code minimum length without null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MNC_MIN_LEN = 2;

//--------------------------------------------------------------------------------------------------
/**
 * Mobile Network Code maximum length without null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MNC_MAX_LEN = 3;

//--------------------------------------------------------------------------------------------------
/**
 * Mobile Country Code length with null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MCC_BYTES = (MCC_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * Mobile Network Code maximum length with null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MNC_BYTES = (MNC_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * Network maximum name length without null character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NETWORK_NAME_MAX_LEN = 100;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of preferred operator list.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE PreferredOperatorList;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of preferred operator.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE PreferredOperator;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of signal metrics.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Metrics;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of network scan information list.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE ScanInformationList;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of network scan information.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE ScanInformation;

//--------------------------------------------------------------------------------------------------
/**
 * Radio Access Technology (RAT) enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM Rat
{
    RAT_UNKNOWN,  ///< Unknown rat.
    RAT_GPRS,     ///< General Packet Radio Service.
    RAT_EDGE,     ///< Enhanced Data Rate for GSM Evolution.
    RAT_UMTS,     ///< Universal Mobile Telecommunications System.
    RAT_IS95A,    ///< A standard in CDMA.
    RAT_IS95B,    ///< A standard in CDMA.
    RAT_1xRTT,    ///< A 2.5G Technology in CDMA.
    RAT_EVDO_0,   ///< EVolution Data Only Rev.0 in CDMA.
    RAT_EVDO_A,   ///< EVolution Data Only Rev.A in CDMA.
    RAT_HSDPA,    ///< High Speed Downlink Packet Access in WCDMA.
    RAT_HSUPA,    ///< High Speed Uplink Packet Access in WCDMA.
    RAT_HSPA,     ///< High-Speed Packet Access in WCDMA.
    RAT_EVDO_B,   ///< EVolution Data Only Rev.B in CDMA.
    RAT_EHRPD,    ///< Evolved High Rate Package Data.
    RAT_LTE,      ///< Long Term Evolution.
    RAT_HSPAP,    ///< A 3.5G Technology in WCDMA.
    RAT_GSM,      ///< A 3.5G Technology in WCDMA.
    RAT_TD_SCDMA, ///< Time Division-Synchronous Code Division Multiple Access.
    RAT_IWLAN,    ///< Industrial Wireless Local Area Networks.
    RAT_LTE_CA,   ///< Long Term Evolution Carrier Aggregation.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network reject cause enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM NetRejCause
{
    NET_REJ_CAUSE_UNDEFINED = -1,                    ///< Undefined.
    NET_REJ_CAUSE_GENERAL,                           ///< General.
    NET_REJ_CAUSE_AUTH_FAILURE,                      ///< Authentication Failure.
    NET_REJ_CAUSE_IMSI_UNKNOWN,                      ///< IMSI unknown in HLR.
    NET_REJ_CAUSE_ILLEGAL_MS,                        ///< Illegal Mobile Station (MS), network refuses service to the MS either because an identity of the MS is not acceptable to the network or because the MS does not pass the authentication check.
    NET_REJ_CAUSE_IMSI_UNKNOWN_VLR,                  ///< IMSI unknown in Visitors Location Register (VLR).
    NET_REJ_CAUSE_IMEI_NOT_ACCEPTED,                 ///< Network does not accept emergency call establishment using an IMEI or not accept attach procedure for emergency services using an IMEI.
    NET_REJ_CAUSE_ILLEGAL_ME,                        ///< ME used is not acceptable to the network.
    NET_REJ_CAUSE_GPRS_SERVICES_NOT_ALLOWED,         ///< Not allowed to operate GPRS services.
    NET_REJ_CAUSE_GPRS_NON_GPRS_NOT_ALLOWED,         ///< Not allowed to operate either GPRS or non-GPRS services.
    NET_REJ_CAUSE_MS_IDENTITY_FAILED,                ///< The network cannot derive the MS's identity from the P-TMSI/GUTI.
    NET_REJ_CAUSE_IMPLICITLY_DETACHED,               ///< Network has implicitly detached the MS.
    NET_REJ_CAUSE_PLMN_NOT_ALLOWED,                  ///< If the network initiates a detach request or UE requests a services, in a PLMN where the MS, by subscription or due to operator determined barring is not allowed to operate.
    NET_REJ_CAUSE_LOCATION_AREA_NOT_ALLOWED,         ///< Network initiates a detach request, in a location area where the HPLMN determines that the MS, by subscription, is not allowed to operate or roaming subscriber the subscriber is denied service even if other PLMNs are available on which registration was possible.
    NET_REJ_CAUSE_ROAMING_NOT_ALLOWED,               ///< Roaming not allowed in this Location Area.
    NET_REJ_CAUSE_GPRS_NOT_ALLOWED_IN_PLMN,          ///< GPRS services not allowed in this PLMN.
    NET_REJ_CAUSE_NO_SUITABLE_CELLS,                 ///< No Suitable Cells in this Location Area.
    NET_REJ_CAUSE_MSC_TEMPORARILY_NOT_REACHABLE,     ///< MSC temporarily not reachable.
    NET_REJ_CAUSE_NETWORK_FAILURE,                   ///< Network Failure.
    NET_REJ_CAUSE_MAC_FAILURE = 20,                  ///< MAC failure.
    NET_REJ_CAUSE_SYNC_FAILURE,                      ///< USIM detects that the SQN in the AUTHENTICATION REQUEST or AUTHENTICATION_AND_CIPHERING REQUEST message is out of range.
    NET_REJ_CAUSE_CONGESTION,                        ///< Network cannot serve a request from the MS because of congestion.
    NET_REJ_CAUSE_GSM_AUTHENTICATION_UNACCEPTABLE,   ///< GSM Authentication unacceptable.
    NET_REJ_CAUSE_NOT_AUTHORIZED = 25,               ///< Not Authorized for this CSG.
    NET_REJ_CAUSE_SMS_PROVIDED_VIA_GPRS = 28,        ///< SMS provided via GPRS in this routing area.
    NET_REJ_CAUSE_SERVICE_OPTION_NOT_SUPPORTED = 32, ///< Service option not supported.
    NET_REJ_CAUSE_SERVICE_OPTION_NOT_SUBCRIBED,      ///< Requested service option not subscribed.
    NET_REJ_CAUSE_SERVICE_OPTION_OUT_OF_ORDER,       ///< Service option temporarily out of order.
    NET_REJ_CAUSE_CALL_NOT_IDENTIFIED = 38,          ///< Call cannot be identified.
    NET_REJ_CAUSE_NO_PDP_CONTEXT_ACTIVATED = 40,     ///< No PDP context activated.
    NET_REJ_CAUSE_RETRY_FOR_NEW_CELL = 48,           ///< Retry upon entry into a new cell.
    NET_REJ_CAUSE_INCORRECT_MESSAGE = 95,            ///< Semantically incorrect message.
    NET_REJ_CAUSE_INVALID_INFO,                      ///< Invalid mandatory information.
    NET_REJ_CAUSE_MSG_TYPE_NOT_IMPLEMENTED,          ///< Message type non-existent or not implemented.
    NET_REJ_CAUSE_MSG_NOT_COMPATIBLE,                ///< Message not compatible with protocol state.
    NET_REJ_CAUSE_INFO_NOT_IMPLEMENTED,              ///< Information element non-existent or not implemented.
    NET_REJ_CAUSE_CONDITIONAL_IE_ERROR,              ///< Conditional IE error.
    NET_REJ_CAUSE_PROTOCOL_ERROR_UNSPECIFIED = 111   ///< Protocol error, unspecified.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network registration state enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM NetRegState
{
    NET_REG_STATE_NOT_REG_AND_NOT_SEARCHING,                         ///< Not registered and not searching.
    NET_REG_STATE_REG_HOME,                                          ///< Home registered.
    NET_REG_STATE_NOT_REG_AND_SEARCHING,                             ///< Not registered and searching.
    NET_REG_STATE_REG_DENIED,                                        ///< Registered denied.
    NET_REG_STATE_UNKNOWN,                                           ///< Unknown state.
    NET_REG_STATE_REG_ROAMING,                                       ///< Roaming registered.
    NET_REG_STATE_RSV_6,                                             ///< Reserved 6 register state.
    NET_REG_STATE_RSV_7,                                             ///< Reserved 7 register state.
    NET_REG_STATE_RSV_8,                                             ///< Reserved 8 register state.
    NET_REG_STATE_RSV_9,                                             ///< Reserved 9 register state.
    NET_REG_STATE_NOT_REG_AND_EMERGENCY_AVAILABLE_AND_NOT_SEARCHING, ///< Not registered and not searching, but emergency available.
    NET_REG_STATE_RSV_11,                                            ///< Reserved 11 register state.
    NET_REG_STATE_NOT_REG_AND_EMERGENCY_AVAILABLE_AND_SEARCHING,     ///< Not registered and searching, emergency available.
    NET_REG_STATE_REG_DENIED_AND_EMERGENCY_AVAILABLE,                ///< Registered denied, but emergency available.
    NET_REG_STATE_UNKNOWN_AND_EMERGENCY_AVAILABLE                    ///< Unknown state, but emergency available.
};

//--------------------------------------------------------------------------------------------------
/**
 * Service domain state enum.
 */
//--------------------------------------------------------------------------------------------------
ENUM ServiceDomainState
{
    SERVICE_DOMAIN_STATE_UNKNOWN = -1, ///< Unknown state.
    SERVICE_DOMAIN_STATE_CS_ONLY,      ///< Circuit Switched only.
    SERVICE_DOMAIN_STATE_PS_ONLY,      ///< Packet Switched only.
    SERVICE_DOMAIN_STATE_CS_AND_PS     ///< Circuit Switched and Packet Switched.
};

//--------------------------------------------------------------------------------------------------
/**
 * RAT bit mask.
 */
//--------------------------------------------------------------------------------------------------
BITMASK RatBitMask
{
    RAT_BIT_MASK_RSV_0,  ///< Reserved 0 bit mask.
    RAT_BIT_MASK_RSV_1,  ///< Reserved 1 bit mask.
    RAT_BIT_MASK_RSV_2,  ///< Reserved 2 bit mask.
    RAT_BIT_MASK_RSV_3,  ///< Reserved 3 bit mask.
    RAT_BIT_MASK_RSV_4,  ///< Reserved 4 bit mask.
    RAT_BIT_MASK_RSV_5,  ///< Reserved 5 bit mask.
    RAT_BIT_MASK_RSV_6,  ///< Reserved 6 bit mask.
    RAT_BIT_MASK_GSM,    ///< GSM bit mask.
    RAT_BIT_MASK_RSV_8,  ///< Reserved 8 bit mask.
    RAT_BIT_MASK_RSV_9,  ///< Reserved 9 bit mask.
    RAT_BIT_MASK_RSV_10, ///< Reserved 10 bit mask.
    RAT_BIT_MASK_NR5G,   ///< NR5G bit mask.
    RAT_BIT_MASK_RSV_12, ///< Reserved 12 bit mask.
    RAT_BIT_MASK_RSV_13, ///< Reserved 13 bit mask.
    RAT_BIT_MASK_LTE,    ///< LTE bit mask.
    RAT_BIT_MASK_UMTS,   ///< UMTS bit mask.
    RAT_BIT_MASK_ALL     ///< All(GSM + NR5G + LTE + UMTS) bit mask.
};

//--------------------------------------------------------------------------------------------------
/**
 * RAT preference bit mask.
 */
//--------------------------------------------------------------------------------------------------
BITMASK RatPrefMask
{
    RAT_PREF_MASK_CDMA_1X,   ///< CDMA_1X bit mask.
    RAT_PREF_MASK_CDMA_EVDO, ///< CDMA_EVDO bit mask.
    RAT_PREF_MASK_GSM,       ///< GSM bit mask.
    RAT_PREF_MASK_WCDMA,     ///< WCDMA bit mask.
    RAT_PREF_MASK_LTE,       ///< LTE bit mask.
    RAT_PREF_MASK_TDSCDMA,   ///< TD-SCDMA bit mask.
    RAT_PREF_MASK_NR5G,      ///< NR5G bit mask.
    RAT_PREF_MASK_ALL        ///< All(CDMA + GSM + WCDMA + LTE + TD-SCDMA + NR5G) bit mask.
};

//--------------------------------------------------------------------------------------------------
/**
 * Cell RAT bit mask.
 */
//--------------------------------------------------------------------------------------------------
BITMASK CellRatMask
{
    CELL_RAT_MASK_GSM,     ///< GSM bit mask.
    CELL_RAT_MASK_CDMA,    ///< CDMA bit mask.
    CELL_RAT_MASK_LTE,     ///< LTE bit mask.
    CELL_RAT_MASK_WCDMA,   ///< WCDMA bit mask.
    CELL_RAT_MASK_TDSCDMA, ///< TDSCDMA bit mask.
    CELL_RAT_MASK_UNKNOWN  ///< UNKNOWN bit mask.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network rejection indication structure.
 */
//--------------------------------------------------------------------------------------------------
STRUCT NetRegRejInd
{
    NetRejCause cause; ///< Network rejection cause.
    uint8 phoneId;     ///< Slot ID.
};

//--------------------------------------------------------------------------------------------------
/**
 * RAT change indication structure.
 */
//--------------------------------------------------------------------------------------------------
STRUCT RatChangeInd
{
    Rat rat;       ///< RAT.
    uint8 phoneId; ///< Slot ID.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network registration state indication structure.
 */
//--------------------------------------------------------------------------------------------------
STRUCT NetRegStateInd
{
    NetRegState state; ///< Network registration state.
    uint8 phoneId;     ///< Slot ID.
};

//--------------------------------------------------------------------------------------------------
/**
 * Handler for manual selection.
 */
//--------------------------------------------------------------------------------------------------
HANDLER ManualSelectionHandler
(
    le_result_t result IN ///< Result of manual selection.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for network registration rejection.
 */
//--------------------------------------------------------------------------------------------------
HANDLER NetRegRejectHandler
(
    NetRegRejInd rejInd IN ///< Network rejection indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for RAT change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RatChangeHandler
(
    RatChangeInd ratChangeInd IN ///< RAT change indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for network registration state.
 */
//--------------------------------------------------------------------------------------------------
HANDLER NetRegStateHandler
(
    NetRegStateInd stateInd IN ///< Network registration state indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for circuit and packet switched change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER PacketSwitchedChangeHandler
(
    ServiceDomainState state IN ///< Service domain state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for signal strength change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER SignalStrengthChangeHandler
(
    int32 ss IN ///< The signal strength.
);

/*
 * Handler for network scan.
 */
HANDLER CellularNetworkScanHandler
(
    ScanInformationList listRef IN ///< The reference of network scan information list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report network registration rejection.
 */
//--------------------------------------------------------------------------------------------------
EVENT NetRegReject
(
    NetRegRejectHandler handler ///< Handler for network registration rejection.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report RAT change.
 */
//--------------------------------------------------------------------------------------------------
EVENT RatChange
(
    RatChangeHandler handler ///< Handler for RAT change.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report network registration state.
 */
//--------------------------------------------------------------------------------------------------
EVENT NetRegStateEvent
(
    NetRegStateHandler handler ///< Handler for network registration state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report circuit and packet switched change.
 */
//--------------------------------------------------------------------------------------------------
EVENT PacketSwitchedChange
(
    PacketSwitchedChangeHandler handler ///< Handler for circuit and packet switched change.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report signal strength change.
 */
//--------------------------------------------------------------------------------------------------
EVENT SignalStrengthChange
(
    CellRatMask ratMask IN,             ///< Cell RAT mask.
    SignalStrengthChangeHandler handler ///< Handler for signal strength change.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function sets the radio power state.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetRadioPower
(
    le_onoff_t power IN, ///< Power state.
    uint8 phoneId IN     ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the radio power state.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRadioPower
(
    le_onoff_t power OUT, ///< Power state.
    uint8 phoneId IN      ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function registers to network using automatic mode.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAutomaticRegisterMode
(
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function registers to network using manual mode.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetManualRegisterMode
(
    string mcc[MCC_LEN] IN,     ///< Mobile Country Code.
    string mnc[MNC_MAX_LEN] IN, ///< Mobile Network Code.
    uint8 phoneId IN            ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function registers to network asynchronously using manual mode.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION SetManualRegisterModeAsync
(
    string mcc[MCC_LEN] IN,         ///< Mobile Country Code.
    string mnc[MNC_MAX_LEN] IN,     ///< Mobile Network Code.
    ManualSelectionHandler handler, ///< Handler for manual selection.
    uint8 phoneId IN                ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets network registration mode.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRegisterMode
(
    bool isManualPtr OUT,           ///< True if manual mode, false if automatic mode.
    string mccPtr[MCC_LEN] OUT,     ///< Mobile Country Code.
    string mncPtr[MNC_MAX_LEN] OUT, ///< Mobile Network Code.
    uint8 phoneId IN                ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets platform specific error code of network registration.
 *
 * @return
 * - Platform specific error code of network registration.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION int32 GetPlatformSpecificRegistrationErrorCode
(
);

//--------------------------------------------------------------------------------------------------
/**
 * This function adds a preferred operator.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_DUPLICATE : Duplicate preferred operator.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddPreferredOperator
(
    string mcc[MCC_LEN] IN,     ///< Mobile Country Code.
    string mnc[MNC_MAX_LEN] IN, ///< Mobile Network Code.
    RatBitMask ratMask IN,      ///< RAT bit mask.
    uint8 phoneId IN            ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function removes a preferred operator.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_NOT_FOUND : Preferred operator not found.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemovePreferredOperator
(
    string mcc[MCC_LEN] IN,     ///< Mobile Country Code.
    string mnc[MNC_MAX_LEN] IN, ///< Mobile Network Code.
    uint8 phoneId IN            ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function deletes preferred operators list.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Preferred operator not found.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeletePreferredOperatorsList
(
    PreferredOperatorList preferredOperatorListRef IN ///< The reference of preferred operators list.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function creates preferred operators list.
 *
 * @return
 *  - Non-null pointer : The reference of preferred operators list.
 *  - Null pointer : Internal error or no preferred operators list.
 *
 * @note At most 1 preferred operator list per slot.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION PreferredOperatorList GetPreferredOperatorsList
(
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the first preferred operator.
 *
 * @return
 *  - Non-null pointer : The reference of the first preferred operator.
 *  - Null pointer : Internal error or empty list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION PreferredOperator GetFirstPreferredOperator
(
    PreferredOperatorList  preferredOperatorListRef IN ///< The reference of preferred operators list.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the next preferred operator based on the current position in the list.
 *
 * @return
 *  - Non-null pointer : The reference of next preferred operator.
 *  - Null pointer : Internal error or empty list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION PreferredOperator GetNextPreferredOperator
(
    PreferredOperatorList  preferredOperatorListRef IN ///< The reference of preferred operators list.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the details of preferred operator.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_NOT_FOUND : Preferred operator not found.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPreferredOperatorDetails
(
    PreferredOperator preferredOperatorRef IN, ///< The reference of preferred operator.
    string mccPtr[MCC_LEN] OUT,                ///< Mobile Country Code.
    string mncPtr[MNC_MAX_LEN] OUT,            ///< Mobile Network Code.
    RatBitMask ratMask OUT                     ///< RAT bit mask.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets the RAT in use.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_TIMEOUT : Response time out.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRadioAccessTechInUse
(
    Rat rat OUT,     ///< RAT in use.
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function sets RAT preferences.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
 *  - LE_FAULT : On failure.
 *  - LE_OK : On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetRatPreferences
(
    RatPrefMask ratMask IN, ///< Bit mask for RAT prefences.
    uint8 phoneId IN        ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * This function gets RAT preferences.
 *
 * @return
 *  - LE_BAD_PARAMETER : Bad parameters.
