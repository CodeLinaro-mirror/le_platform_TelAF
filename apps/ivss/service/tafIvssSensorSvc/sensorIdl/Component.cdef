externalBuild:
{
    "capicxx-core-gen -sk $TELAF_ROOT/apps/ivss/fidl/SensorSvc/SensorSvc.fidl"
    "capicxx-core-gen -sk $TELAF_ROOT/apps/ivss/fidl/SensorSvc/SensorSvc.fdepl"
    "capicxx-someip-gen $TELAF_ROOT/apps/ivss/fidl/SensorSvc/SensorSvc.fdepl"

    "bash $TELAF_ROOT/apps/ivss/common/make.sh SensorSvc"
}

bundles:
{
    file:
    {
        $BUILDDIR/build/libSensorSvc-someip.so   /lib/
    }
}

provides:
{
    headerDir:
    {
        $BUILDDIR/src-gen
    }
}
