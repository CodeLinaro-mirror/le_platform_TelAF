);

/**
 *  Gets the DCNR and ENDC mode status.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNrDualConnectivityStatus
(
    NREndcAvailability statusEndc OUT,         ///< ENDC availability status.
    NRDcnrRestriction statusDcnr OUT,          ///< DCNR restriction status.
    uint8 phoneId IN                           ///< Phone ID.
);

/**
 *  Gets the long name of the network.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_TIMEOUT -- Time out.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCurrentNetworkLongName
(
    string longNameStr[NETWORK_NAME_MAX_LEN] OUT,   ///< Long network name.
    uint8 phoneId IN                                ///< Phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the details of the total SIM count and maximum active SIM count.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *  - LE_TIMEOUT -- Time out.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetHardwareSimConfig
(
    uint8 totalSimCount OUT,   ///< The maximum number of SIMs supported simultaneously.
    uint8 maxActiveSims OUT    ///< The maximum number of SIMs that can be active simultaneously.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the RAT capabilities supported by hardware and SIM based on a given phone ID.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 *  - LE_TIMEOUT -- Time out.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetHardwareSimRatCapabilities
(
    RatBitMask deviceRatCapMask OUT,     ///< Device RAT capability bitmask.
    RatBitMask simRatCapMask OUT,        ///< SIM RAT capability bitmask.
    uint8 phoneId IN                     ///< Phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the hysteresis in units of 0.1 dBm. which is an optional parameter for signal strength
 * indication.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters
 *  - LE_FAULT -- Failed.
 */

//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetSignalStrengthIndHysteresis
(
    SigType sigType,                ///< Signal type.
    uint16 hysteresis IN,           ///< Hysteresis dBm in units of 0.1 dBm.
    uint8 phoneId IN                ///< Phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the hysteresis time in milliseconds which is an optional parameter for signal strength
 * indication.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters
 *  - LE_FAULT -- Failed.
 */

//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetSignalStrengthIndHysteresisTimer
(
    uint16 hysteresisTimer IN,     ///< Hysteresis time in milliseconds.
    uint8 phoneId IN               ///< Phone ID.
);
