# This file was auto-generated by generate_telaf_selinux.py as an initial
# skeleton based on the corresponding .adef file.  It covers the minimum
# rules derived from the adef (capabilities, IPC bindings, data files).
# Review and extend it with any additional rules required at runtime before
# committing.

policy_module(keyFileReliabilityTest, 1.0)

gen_require(`
    type telaf_tafKeyStoreSvc_t;
    type telaf_app_tool_t;
    type telaf_app_tool_exec_t;
    type syslogd_t;
')

# --- keyFileReliabilityTest ---
type telaf_keyFileReliabilityTest_exec_t;
files_type(telaf_keyFileReliabilityTest_exec_t);
type telaf_keyFileReliabilityTest_t;
type telaf_keyFileReliabilityTest_data_t;
files_type(telaf_keyFileReliabilityTest_data_t);

init_telaf_app_domain(telaf_keyFileReliabilityTest_t, telaf_keyFileReliabilityTest_exec_t)
telaf_ipc_bind(telaf_keyFileReliabilityTest_t, telaf_tafKeyStoreSvc_t)
telaf_manage_app_data_files(telaf_keyFileReliabilityTest_t, telaf_keyFileReliabilityTest_data_t)
telaf_admin_manage_all_files_perms(telaf_keyFileReliabilityTest_exec_t)

# TakeActionToKeyFile() in keyFileReliabilityTest.c forks and execs
# "sh <app-bin-dir>/keyFileReliabilityTest.sh <args>" in this domain, with no
# transition. Grant the same in-domain shell exec already used by tafMngdConnSvc
# and tafSelinuxAllowIntTest for this pattern.
telaf_exec_shell(telaf_keyFileReliabilityTest_t)

# The helper script deletes, zero-fills and compares the active key file under
# /persist/tafKeyStoreSvc/keyMaster_pa (persist_t), so it needs the same access
# to that storage as tafKeyStoreSvc itself. The backup copy under
# /data/persist/... is data_t, already covered by init_telaf_app_domain's
# manage_user_data_files().
telaf_use_persist_storage(telaf_keyFileReliabilityTest_t)

# The key files' DAC modes do not permit even root to traverse/read them
# outright, so the capability checks the kernel falls back on must be allowed --
# same pair tafKeyStoreSvc holds for these same files.
allow telaf_keyFileReliabilityTest_t self:capability { dac_override dac_read_search };

# "timeout", which bounds the restart in the helper script, polls its child once
# a second with kill(pid, 0) to see whether it has exited (timeout.c). That is a
# null signal, and signull is a separate permission that the baseline
# "self:process { signal setsched }" for the app domain does not cover. Without
# it the poll fails and timeout cannot tell a finished child from a running one.
allow telaf_keyFileReliabilityTest_t self:process { signull };

# The script reads the syslog with "logread" to detect the keyStore PA
# re-initializing after a restart. logread has no domain of its own, so it runs
# in this domain and needs syslogd's shared-memory ring buffer and the
# semaphores guarding it -- same permission set telaf_admin_t already holds.
allow telaf_keyFileReliabilityTest_t syslogd_t:shm { read unix_read associate };
allow telaf_keyFileReliabilityTest_t syslogd_t:sem { read write associate unix_write };

# The script restarts tafKeyStoreSvc with Legato's "app" tool. That tool has its
# own domain, so transition into it rather than granting execute_no_trans: the
# tool would otherwise run here and this domain would need every privilege it
# uses to drive the Supervisor.
domtrans_pattern(telaf_keyFileReliabilityTest_t, telaf_app_tool_exec_t, telaf_app_tool_t)

# The "app" tool is reached through the forked shell, and Legato's IPC session
# sockets are not close-on-exec, so the tool starts life holding sockets this
# domain created and keeps using them once it has transitioned away.
allow telaf_app_tool_t telaf_keyFileReliabilityTest_t:unix_stream_socket { read write };
