maxThreads: 300

username: telaf

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafPMSvc = ( $TELAF_ROOT/simulation/pa/taf_pa_simula_pm/tafPMSvc )
}

start: auto

processes:
{
    run:
    {
        (tafPMSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

extern:
{
    tafPMSvc.tafPMSvc.taf_pm
}
