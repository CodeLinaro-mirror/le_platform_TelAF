class BaseValidator {
public:
    static bool validate(const uint8_t* dataRecord, size_t recordLength, const std::string& nodeName) {

        LE_INFO("recordLength: %d",(int)recordLength);
        LE_INFO("nodeName: %s",nodeName.c_str());

        std::map<std::string, std::map<uint16_t, std::function<bool(uint32_t)>>> nodeValidators;

        {% for node_name, node_info in root.routine_parameters_all.items() %}
            {% if node_name in nodes_to_include %}
            nodeValidators["{{ node_name }}"] = {
                {% for bit_offset, element in node_info.bit_offset.items() %}
                    {% if 'functional_definition' in root.datas[element.dataElement] %}
                        { {{ bit_offset }},
                          std::bind(&Validator_{{ element.dataElement }}::validate,
                          Validator_{{ element.dataElement }}(
                              {% if root.datas[element.dataElement].functional_definition.data_type == 'Numeric' %}
                                  {% if root.datas[element.dataElement].functional_definition.max != root.datas[element.dataElement].functional_definition.min %}
                                      {{ root.datas[element.dataElement].functional_definition.min }},
                                      {{ root.datas[element.dataElement].functional_definition.max }},
                                      {}
                                  {% else %}
                                      0,0,
                                      { {% for k, v in root.datas[element.dataElement].functional_definition.coding.items() %} {{ k }} {% if not loop.last %}, {% endif %} {% endfor %} }
                                  {% endif %}
                              {% elif root.datas[element.dataElement].functional_definition.data_type == 'Not numeric' %}
                                  {% if root.datas[element.dataElement].functional_definition.forbidden_values and root.datas[element.dataElement].functional_definition.forbidden_values | length > 0 %}
                                      {% if root.datas[element.dataElement].functional_definition.forbidden_values %}
                                      { {% for v in root.datas[element.dataElement].functional_definition.forbidden_values %} {{ v }} {% if not loop.last %}, {% endif %} {% endfor %} },
                                      {% else %}
                                      {},
                                      {% endif %}
                                      {}
                                  {% else %}
                                      {},
                                      {% if root.datas[element.dataElement].functional_definition.forbidden_characters %}
                                      {{ root.datas[element.dataElement].functional_definition.forbidden_characters | f_forbidden_characters_conversion(root.datas[element.dataElement]) }}
                                      {% else %}
                                      {}
                                      {% endif %}
                                  {% endif %}
                            {% elif root.datas[element.dataElement].functional_definition.data_type == 'Numeric list' %}
                                { {% for k, v in root.datas[element.dataElement].functional_definition.coding.items() %} {{ k }} {% if not loop.last %}, {% endif %} {% endfor %} }
                            {% endif %}
                        ),
                        std::placeholders::_1)
                      },
                    {% endif %}
                {% endfor %}
            };
            {% endif %}
        {% endfor %}

        if (nodeValidators.find(nodeName) == nodeValidators.end()) return false; /* Skipping check */

        {% for nodeName in root.routine_parameters_all.keys() %}
        {% if nodeName in nodes_to_include %}
        if (nodeName == "{{ nodeName }}")
        {
        {{ generate_validation_loop_for_node(nodeName) }}
        }
        {% endif %}
        {% endfor %}

        return false;
    }
};

EXPORT_SYM bool validate_base_record(const uint8_t* dataRecord, size_t recordLength, const std::string nodeName) {
        return BaseValidator::validate(dataRecord, recordLength, nodeName);
}

