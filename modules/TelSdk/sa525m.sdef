commands:
{
    cm = tools:/scripts/cm
#if ${TELUX_LOCATION_SUPPORTED} = y
    gnss = tools:/bin/gnss
#endif
    fwupdate = tools:/bin/fwupdate
    pm = tafTools:/bin/pm
    tafmodule = tafTools:/bin/tafmodule
}

bindings:
{
    <telaf>.DeviceManager -> <root>.DeviceManager
    <root>.DeviceManagerTool -> <root>.DeviceManagerTool
    <telaf>.sdirTool -> <root>.sdirTool
    <system>.taf_flash -> <telaf>.taf_flash
}

interfaceSearch:
{
    $TELAF_ROOT/interfaces
    $TELAF_ROOT/interfaces/someipGW
    $TELAF_ROOT/interfaces/tafVNW
    $TELAF_ROOT/interfaces/staging
    $TELAF_ROOT/apps/tafMngdServices/interfaces
    $TELAF_ROOT/apps/tafMngdServices/interfaces/staging
    $TELAF_ROOT/interfaces/tafDiagBackend
    interfaces/positioning
    $LEGATO_ROOT/apps/sample/voiceCallApp
    // $TELAF_ROOT/apps/test/tafPMTest/tafPMIntgTest
}

cflags:
{
    -DTARGET_SA525M
}

cxxflags:
{
    -DTARGET_SA525M
}
