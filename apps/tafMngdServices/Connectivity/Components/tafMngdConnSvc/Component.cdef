sources:
{
    tafMngdConnSvc.cpp
    Admin/tafMngdConnAdmin.cpp
    Data/tafMngdConnData.cpp
    Radio/tafMngdConnRadio.cpp
    Sim/tafMngdConnSim.cpp
    ECall/tafMngdConnECall.cpp
    JSONParser/tafMngdConnSvcJSONParser.cpp
    JSONParser/tafMngdSvcJSONParser_Helper.cpp
    JSONParser/tafMngdConnSvcParser_PolicyParser.cpp
    JSONParser/tafMngdConnSvcParser_ConfigurationParser.cpp
    $TELAF_ROOT/components/tafDataCallSvc/tafDcsHelper.cpp
}

provides:
{
    api:
    {
        $TELAF_ROOT/apps/tafMngdServices/interfaces/taf_mngdConn.api
    }
}

requires:
{
    api:
    {
        taf_dcs.api
        taf_radio.api
        taf_sim.api
        le_appInfo.api
#if ${LE_CONFIG_TARGET_SIMULATION} = ""
        taf_net.api
        taf_ecall.api
        $TELAF_ROOT/apps/tafMngdServices/interfaces/taf_mngdPm.api
#endif
    }

#if ${LE_CONFIG_TAFMNGDCONNSVC_USE_CURL} = "y"
    lib:
    {
        curl
    }
#endif

}

cxxflags:
{
    -I$TELAF_ROOT/include
    -I$TELAF_ROOT/apps/tafMngdServices/Connectivity/Components/tafMngdConnSvc/ConfigTreeHelper
    -I$TELAF_ROOT/apps/tafMngdServices/Connectivity/Components/tafMngdConnSvc/Admin
    -I$TELAF_ROOT/apps/tafMngdServices/Connectivity/Components/tafMngdConnSvc/Data
    -I$TELAF_ROOT/apps/tafMngdServices/Connectivity/Components/tafMngdConnSvc/Radio
    -I$TELAF_ROOT/apps/tafMngdServices/Connectivity/Components/tafMngdConnSvc/Sim
    -I$TELAF_ROOT/apps/tafMngdServices/Connectivity/Components/tafMngdConnSvc/ECall
    -I$TELAF_ROOT/apps/tafMngdServices/Connectivity/Components/tafMngdConnSvc/JSONParser
    -I$TELAF_ROOT/apps/tafMngdServices/Connectivity/Components/tafMngdConnSvc
    -I$TELAF_ROOT/components/tafDataCallSvc
    -I$LEGATO_ROOT/framework/liblegato
}

ldflags:
{
    -lboost_filesystem
}