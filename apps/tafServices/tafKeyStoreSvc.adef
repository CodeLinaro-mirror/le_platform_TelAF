sandboxed: false

executables:
{
    tafKeyStoreSvc = ( $TELAF_ROOT/components/tafKeyStoreSvc )
    tafFSCryptSvc = ( $TELAF_ROOT/components/tafFSCryptSvc )
}

start: auto

processes:
{
    run:
    {
        ( tafKeyStoreSvc )
        ( tafFSCryptSvc )
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
    tafKeyStoreSvc.tafKeyStoreSvc.le_appInfo -> <root>.le_appInfo
    tafKeyStoreSvc.taf_pa_keystore.le_appInfo -> <root>.le_appInfo
    tafFSCryptSvc.taf_pa_fscrypt.le_appInfo -> <root>.le_appInfo
    tafFSCryptSvc.taf_pa_fscrypt.taf_ks -> tafKeyStoreSvc.taf_ks
    tafFSCryptSvc.tafFSCryptSvc.taf_pm -> tafPMSvc.taf_pm
}

extern:
{
    tafKeyStoreSvc.tafKeyStoreSvc.taf_ks
    tafFSCryptSvc.tafFSCryptSvc.taf_fsc
}
