policy_module(tafRemoteSimSvc, 1.0)

# Framework definition for telaf
type telaf_tafRemoteSimSvc_exec_t;
files_type(telaf_tafRemoteSimSvc_exec_t);

type telaf_tafRemoteSimSvc_t;

type telaf_tafRemoteSimSvc_data_t;
files_type(telaf_tafRemoteSimSvc_data_t);

init_telaf_app_domain(telaf_tafRemoteSimSvc_t,telaf_tafRemoteSimSvc_exec_t)

# Allow update daemon to install/uninstall this service
telaf_admin_manage_all_files_perms(telaf_tafRemoteSimSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafRemoteSimSvc_exec_t)



