sandboxed: false
executables:
{
    tafPMSvc = ( $TELAF_ROOT/components/tafPMSvc )
}
start: auto

processes:
{
    run:
    {
        (tafPMSvc)
    }


    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
}

extern:
{
    tafPMSvc.tafPMSvc.taf_pm
}
