EXPORT_SYM std::string get_routine_record(uint16_t rid, uint8_t subFunc)
{
    NEED_INITED();
    try
    {
        // Direct lookup using the helper function
        const RoutineEntry& routine = cfg::get_routine_entry(rid);

        if (subFunc == 0x01)
        {
            if (routine.request.start.empty())
            {
                LE_INFO("start field is empty for RID 0x%X", rid);
                return "null";
            }
            return routine.request.start;
        }
        else if (subFunc == 0x02)
        {
            if (routine.request.stop.empty())
            {
                LE_INFO("stop field is empty for RID 0x%X", rid);
                return "null";
            }
            return routine.request.stop;
        }
        else if (subFunc == 0x03)
        {
            if (routine.request.result.empty())
            {
                LE_INFO("result field is empty for RID 0x%X", rid);
                return "null";
            }
            return routine.request.result;
        }
    }
    catch (const std::exception& e)
    {
        LE_INFO("Routine 0x%X not found: %s", rid, e.what());
        return "null";
    }

    return "null";
}

