USETYPES taf_types.api;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the payload data in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_PAYLOAD_SIZE = 4095;

//-------------------------------------------------------------------------------------------------
/**
 * Diagnostic SessionControl type.
 */
//-------------------------------------------------------------------------------------------------
ENUM SessionType
{
    DEFAULT = 0x01,                       ///< Default session.
    PROGRAMMING,                          ///< Programming session.
    EXTENDED,                             ///< Extended diagnostic session.
    VEHICLE_MANUFACTURER_SPECIFIC = 0x40, ///< Vehicle manufacture specific session.
    FOTA = 0x42,                          ///< FOTA session.
    SYSTEM_SUPPLIER_SPECIFIC = 0x60       ///< System supplier specific session.
};

//-------------------------------------------------------------------------------------------------
/**
 * Error code for SessionControl.
 */
//-------------------------------------------------------------------------------------------------
ENUM SesControlErrorCode
{
    SES_CONTROL_NO_ERROR = 0,
    SES_CONTROL_CONDITIONS_NOT_CORRECT = 0x22
};

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the SessionControl request message.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE SesTypeCheck;

//--------------------------------------------------------------------------------------------------
/**
 * Handler for a session control type.
 */
//--------------------------------------------------------------------------------------------------
HANDLER SesTypeHandler
(
    SesTypeCheck sesTypeRef  IN,    ///< Session type reference.
    SessionType sesCtrlType  IN     ///< Session control type.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on Rx session control type.
 */
//--------------------------------------------------------------------------------------------------
EVENT SesTypeCheck
(
    SesTypeHandler handler    ///< Received message handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends a response message for the condition check of session control type.
 *
 * @note This function must be called to send a response if receiving a message.
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid rxMsgRef.
 *     - LE_NOT_FOUND -- Reference not found.
 *     - LE_FAULT -- Failed.
 *
 * @note The process exits if an invalid reference is passed.
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendSesTypeCheckResp
(
    SesTypeCheck sesTypeRef  IN,        ///< Session type reference.
    SesControlErrorCode errCode  IN     ///< Error code type.
);

//-------------------------------------------------------------------------------------------------
/**
 * Handler for a session control type change.
 */
//-------------------------------------------------------------------------------------------------
HANDLER SesChangeHandler
(
    SessionType previousType  IN,    ///< Previous session control type.
    SessionType currentType   IN     ///< Current session control type.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information on session control type change.
 */
//-------------------------------------------------------------------------------------------------
EVENT SesChange
(
    SesChangeHandler handler    ///< Received message handler.
);
