    uint32_t min, max;
    std::vector<uint32_t> allowedValues;
    {% elif data.functional_definition.data_type == 'Not numeric' %}
    std::vector<uint32_t> forbiddenValues;
    std::vector<uint32_t> forbiddenRanges;
    {% elif data.functional_definition.data_type == 'Numeric list' %}
    std::vector<uint32_t> allowedValues;
    {% endif %}
public:
    {% if data.functional_definition.data_type == 'Numeric' %}
    Validator_{{ element.dataElement }}(uint32_t min, uint32_t max, const std::vector<uint32_t>& values)
    : min(min), max(max), allowedValues(values) {}
    {% elif data.functional_definition.data_type == 'Not numeric' %}
    Validator_{{ element.dataElement }}(const std::vector<uint32_t>& values, const std::vector<uint32_t>& ranges)
    : forbiddenValues(values), forbiddenRanges(ranges) {}
    {% elif data.functional_definition.data_type == 'Numeric list' %}
    Validator_{{ element.dataElement }}(const std::vector<uint32_t>& values)
    : allowedValues(values) {}
    {% endif %}

    bool validate(uint32_t value) {
        {% if data.functional_definition.data_type == 'Numeric' %}
        LE_DEBUG("Numeric!!");
        if (min != max) {
            LE_DEBUG("Numeric---> Min/Max");
            LE_DEBUG("min: %" PRIu32 "",min);
            LE_DEBUG("max: %" PRIu32 "",max);
            if (value < min || value > max)
            {
                LE_DEBUG("Found Banned value: %" PRIu32 "",value);
                return true; /* Found Banned value */
            }
        } else if (!allowedValues.empty()) {
            LE_DEBUG("Numeric---> coding");

            auto it = std::find(allowedValues.begin(),
                                allowedValues.end(),
                                value);

            if (it == allowedValues.end())
            {
                LE_DEBUG("Found Banned value: %" PRIu32 "",value);
                return true; /* Not found -> Ban it */
            }
        }
        return false;
        {% elif data.functional_definition.data_type == 'Not numeric' %}
        LE_DEBUG("Not numeric!!");
        if(forbiddenValues.size() > 0){
            LE_DEBUG("Not numeric---> forbidden_values");
            for (auto forbidden : forbiddenValues) {
                if (value == forbidden)
                {
                    LE_DEBUG("Found Banned value: %" PRIu32 "",value);
                    return true;    /* Found Banned value */
                }
            }
        } else {
            LE_DEBUG("Not numeric---> forbidden_characters");
            for (auto range : forbiddenRanges) {
                if (value == range)
                {
                    LE_DEBUG("Found Banned value: %" PRIu32 "",value);
                    return true;   /* Found Banned value */
                }
            }
        }
        return false;
        {% elif data.functional_definition.data_type == 'Numeric list' %}
        LE_DEBUG("Numeric list!!");
        auto it = std::find(allowedValues.begin(),
                            allowedValues.end(),
                            value);

        if (it == allowedValues.end())
        {
            LE_DEBUG("Found Banned value: %" PRIu32 "",value);
            return true; /* Not found -> Ban it */
        }
        return false;
        {% endif %}
     }
};
