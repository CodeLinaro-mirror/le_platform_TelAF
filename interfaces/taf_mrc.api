//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafMRC MRC Service
 *
 * @rst :ref:`API reference <File taf_mrc_interface.h>` @endrst
 *
 * <HR>
 *
 * The memory robustness criteria (MRC) service APIs are designed for operations on an MRC daemon
 * (MRCD).
 * The MRC service is mainly applied in over-the-air firmware updates and mirrored systems. The MRCD
 * runs in the the background to support EFS2 backup and restore, system mirroring, flash scrubbing,
 * suspending for eCall, and FOTA flash access arbitration. MRCD processes them by priority, and the
 * MRC service APIs notify MRCD of FOTA events.
 *
 * @section taf_mrc_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafMRCSvc service.
 *
 * The following example illustrates how to bind to the MRC service.
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_mrc -> tafMRCSvc.taf_mrc
   }
 *
   @endverbatim
 *
 * @section c_taf_mrc_ota FOTA Supplementary Operations
 *
 * - taf_mrc_SendOtaStartMsg() - Sends an OTA start notification to MRCD before FOTA starts.
 *
 * - taf_mrc_SendOtaResumeMsg() - Sends an OTA resume notification to MRCD when FOTA resumes.
 *
 * - taf_mrc_SendOtaEndMsg() Sends an OTA end notification to MRCD when FOTA completes.
 *
 * - taf_mrc_SendOtaAbsyncMsg() - Synchronizes active and inactive slots.
 *
 * The following example illustrates FOTA operations with MRCD.
 *
 * @code
 *
   // When FOTA starts.
   LE_ASSERT(taf_mrc_SendOtaStartMsg() == LE_OK);

   // Perform FOTA with recovery client or flash acesss.

   // When FOTA completes.
   LE_ASSERT(taf_mrc_SendOtaEndMsg(TAF_MRC_OTA_OP_STATUS_SUCCESS) == LE_OK);

   // Swicth to active slot.

   // Slot synchronization.
   LE_ASSERT(taf_mrc_SendOtaStartMsg() == LE_OK);
 *
   @endcode
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 * OTA operation status enum.
 *
 * @b NOTE: OTA status notified to MRCD.
 */
//--------------------------------------------------------------------------------------------------
ENUM OtaOperationStatus
{
    OTA_OP_STATUS_SUCCESS = 1, ///< OTA operation status is success.
    OTA_OP_STATUS_FAILURE      ///< OTA operation status is failure.
};

//--------------------------------------------------------------------------------------------------
/**
 * Sync status enum.
 *
 * @b NOTE: Sync status notified to MRCD.
 */
//--------------------------------------------------------------------------------------------------
ENUM SyncStatus
{
    SYNC_STATUS_INIT = 0,    ///< Sync is initialized by client.
    SYNC_STATUS_SUCCESS,     ///< Sync status is success.
    SYNC_STATUS_FAILURE      ///< Sync status is failure.
};


//--------------------------------------------------------------------------------------------------
/**
 * Sends an OTA start message to MRCD.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendOtaStartMsg
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends an OTA resume message to MRCD.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendOtaResumeMsg
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends an OTA end message to MRCD.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendOtaEndMsg
(
    OtaOperationStatus otaStatus IN ///< OTA operation status.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends a message to MRCD to synchronize active and inactive slots.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendOtaAbsyncMsg
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends sync staus to MRCD.
 *
 * @return
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendSyncStatusMsg
(
    SyncStatus status IN ///< Sync status.
);