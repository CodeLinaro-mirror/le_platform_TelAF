//--------------------------------------------------------------------------------------------------
/**
 * @page c_taf_mngdSecStore Managed Storage Service
 *
 * @ref taf_mngdStorage_secure_interface.h "API Reference"
 *
 * <HR>
 *
 * The Managed Storage service APIs provides applications to use encrypted and reliable
 * storages.
 *
 * @section taf_mngdStorageSvc_binding IPC interfaces binding
 *
 * The following example illustrates how to bind to the Managed Storage Service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_mngdSecStore -> tafMngdStorageSvc.taf_mngdSecStore
   }
   @endverbatim
 *
 * @section taf_mngdSecStore Manage secure storage
 *
 * TelAF Managed Storage Service's client calls taf_mngdSecStore_Create() to create the secure storage
 * which is allocated to the client, so that the client can create, read and write data under the storage.
 * This function returns the result to indicate the status of creating secure storage.
 *
 * @code

    taf_mngdSecStore_Create();

 * @endcode
 *
 * Optionally, client calls the following interfaces to finish storage management.
 *
 * The following storage APIs are supported.
 * - taf_mngdSecStore_GetUsedSize() -- Gets used size of the storage.
 * - taf_mngdSecStore_GetFreeSize() -- Gets free size of the storage.
 *
 * @section taf_mngdSecStore_data Manage the data item
 *
 * TelAF Managed Storage Service's client calls taf_mngdSecStore_GetDataRef() and input data label
 * to get the data item which is allocated to the client to store data.
 * Data label can be defined in an arbitrary unique ID that follows the POSIX file name convention.
 *
 * @code

    taf_mngdSecStore_DataRef_t dataRef
        = taf_mngdSecStore_GetDataRef("DataName");

    if(dataRef)
    {
        // Process of the data access
    }
    else
    {
        taf_mngdSecStore_DataRef_t dataRef
            = taf_mngdSecStore_CreateDataRef("DataName");

        if(dataRef)
        {
            // Process of the data access
        }
        else
        {
            // Check input data label
        }
    }

 * @code
 *
 * Optionally, client calls the following interfaces to finish the data item manipulations.
 *
 * The following storage APIs are supported.
 * - taf_mngdSecStore_GetDataSize() -- Gets the data size from the given data item.
 * - taf_mngdSecStore_DeleteData() -- Deletes the data item.
 *
 * @section taf_mngdSecStore_data_write Write data to the data item
 *
 * To store data in secure data item, the client firstly calls taf_mngdSecStore_WriteDataStart()
 * to start a writing operation, then calls taf_mngdSecStore_WriteDataChunk() to input data buffer
 * and specify data length. This API can be called back-to-back to do multiple writing operation.
 * At the end, the client calls taf_mngdSecStore_WriteDataEnd() to finish the current writing
 * operation.
 *
 * @code

    uint8_t dataBuff_1[DATA_LEN_1] = {};
    uint8_t dataBuff_2[DATA_LEN_2] = {};

    le_result_t res = taf_mngdSecStore_WriteDataStart(dataRef);

    if(LE_OK == res)
    {
        res = taf_mngdSecStore_WriteDataChunk(dataRef, dataBuff_1, DATA_LEN_1);

        res = taf_mngdSecStore_WriteDataChunk(dataRef, dataBuff_2, DATA_LEN_2);
    }

    taf_mngdSecStore_WriteDataEnd(dataRef);

 * @code
 *
 * @section taf_mngdSecStore_data_read Read data from the data item
 *
 * To read data from the data item, the client calls taf_mngdSecStore_ReadData() with buffer pointer
 * to store the output data. The third output parameter is to specify the data length of the read data.
 * The client shall keep calling taf_mngdSecStore_ReadData() to read the entire data until the returned
 * read data length is 0.
 *
 * @code

    uint8_t dataBuff[DATA_LEN] = {};
    size readLen = 0;

    le_result_t res = taf_mngdSecStore_ReadDataFirstChunk(dataRef, dataBuff, &readLen);

    // use the read data from the data buffer

    while(reaLen > 0 && res == LE_OK)
    {
        res = taf_mngdSecStore_ReadDataNextChunk(dataRef, dataBuff, &readLen);

        // use the read data from the data buffer
    }

 * @code
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

/**
 * Maximum number of characters and bytes for a secure storage data label.
 */
DEFINE MAX_DATA_LABLE_SIZE = 255;
DEFINE MAX_DATA_LABLE_BYTES = (MAX_DATA_LABLE_SIZE + 1);

/**
 * Maximum number of bytes for each data chunk in secure storage.
 */
DEFINE MAX_DATA_CHUNK_SIZE = 8192;


/**
 * Secure storage data reference.
 */
REFERENCE Data;

//--------------------------------------------------------------------------------------------------
/**
 * Gets the used size of the storage in bytes.
 *
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid size buffer or storage reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetUsedSize
(
    uint32  size       OUT   ///< Used size.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the free size of the storage in bytes.
 *
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid size buffer or storage reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFreeSize
(
    uint32  size       OUT   ///< Free size.
);

//--------------------------------------------------------------------------------------------------
/**
 * Creates a data label with empty data and returns the reference to the data label.
 *
 * @return
 *     - Date       New data reference.
 *     - NULL       Invalid data label, or the data label already exists.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Data CreateData
(
    string dataLabel[MAX_DATA_LABLE_BYTES]  IN   ///< Data label.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data reference for the data label.
 *
 * @return
 *     - Date       Data reference.
 *     - NULL       Invalid data label, or the data label does not exist.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Data GetDataRef
(
    string dataLabel[MAX_DATA_LABLE_BYTES]  IN   ///< Data label.
);

//--------------------------------------------------------------------------------------------------
/**
 * Starts writing data operation for the data.
 *
 * @return
 *     - LE_OK             Successfully initializes the operation.
 *     - LE_BAD_PARAMETER  The given data label is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t WriteDataStart
(
    Data dataRef IN   ///< Data reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Processes writing data operation for the data chunk. This API can be called for multiple times if
 * the size of written data is greater than MAX_DATA_CHUNK_SIZE.
 *
 * @return
 *     - LE_OK             Successfully processes the operation.
 *     - LE_BAD_PARAMETER  The given data label is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t WriteDataChunk
(
    Data dataRef                      IN,   ///< Data reference.
    uint8 buffer[MAX_DATA_CHUNK_SIZE] IN    ///< Data buffer.
);

//--------------------------------------------------------------------------------------------------
/**
 * Ends writing data operation for the data.
 *
 * @return
 *     - LE_OK             Successfully ends the operation.
 *     - LE_BAD_PARAMETER  The given data label is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t WriteDataEnd
(
    Data dataRef IN   ///< Data reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Reads the first chunk from the given data item.
 *
 * @return
 *     - LE_OK             Successfully reads the data.
 *     - LE_BAD_PARAMETER  The given data label is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ReadDataFirstChunk()
(
    Data dataRef                      IN,   ///< Data reference.
    uint8 buffer[MAX_DATA_CHUNK_SIZE] OUT   ///< Data buffer.
);

//--------------------------------------------------------------------------------------------------
/**
 * Reads the next data chunk from the given data item. To get the entire data, the client should
 * keep calling this API after calling ReadDataFirstChunk(), until the return output length is 0.
 *
 * @return
 *     - LE_OK             Successfully reads the data.
 *     - LE_BAD_PARAMETER  The given data label is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ReadDataNextChunk()
(
    Data dataRef                      IN,   ///< Data reference.
    uint8 buffer[MAX_DATA_CHUNK_SIZE] OUT   ///< Data buffer.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data size for the given data item in bytes. If the data item is empty, the returned data
 * size will be 0.
 *
 * @return
 *     - LE_OK             Successfully deletes the data.
 *     - LE_BAD_PARAMETER  The given data label is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDataSize
(
    Data dataRef    IN,   ///< Data reference.
    uint32 dataSize OUT   ///< Data Size.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the data from the given data item.
 *
 * @return
 *     - LE_OK             Successfully deletes the data.
 *     - LE_BAD_PARAMETER  The given data label is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteData
(
    Data dataRef IN   ///< Data reference.
);
