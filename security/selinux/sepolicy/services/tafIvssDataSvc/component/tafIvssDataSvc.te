policy_module(tafIvssDataSvc, 1.0)

gen_require(`
  type sysfs_t;
  type systemd_tmpfiles_t;
  type tmp_t;
  type proc_net_t;
  type unreserved_port_t;
  type node_t;
')

# Framework definition for telaf
type telaf_tafIvssDataSvc_exec_t;
files_type(telaf_tafIvssDataSvc_exec_t);

type telaf_tafIvssDataSvc_t;

type telaf_tafIvssDataSvc_data_t;
files_type(telaf_tafIvssDataSvc_data_t);

# Run the service in its own confined domain
init_telaf_app_domain(telaf_tafIvssDataSvc_t,telaf_tafIvssDataSvc_exec_t)

# Allow service to manage its own data directory; registers with admin domain.
telaf_manage_app_data_files(telaf_tafIvssDataSvc_t, telaf_tafIvssDataSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafIvssDataSvc_exec_t)

# Allow systemd to get attribute of /tmp/vsomeip-0
allow systemd_tmpfiles_t tmp_t:sock_file { getattr };

# Allow tafIvssDataSvc to manipulate udp/tcp socket
allow telaf_tafIvssDataSvc_t self:udp_socket create_socket_perms;
allow telaf_tafIvssDataSvc_t self:tcp_socket create_stream_socket_perms;

# Allow tafIvssDataSvc to manipulate netlink_route_socket
allow telaf_tafIvssDataSvc_t self:netlink_route_socket rw_netlink_socket_perms;

# sys_resource: removed -- no evidence vsomeip needs to exceed rlimits.
# net_admin is granted via telaf_use_vsomeip_network() below.
allow telaf_tafIvssDataSvc_t self:capability { net_admin };

# Misc rules for network socket
allow telaf_tafIvssDataSvc_t proc_net_t:file read_file_perms;
allow telaf_tafIvssDataSvc_t { unreserved_port_t node_t }:udp_socket { name_bind node_bind };
allow telaf_tafIvssDataSvc_t { unreserved_port_t node_t }:tcp_socket { name_bind node_bind name_connect };

# Allow telaf_tafIvssDataSvc_t and telaf_tafSomeipGWSvc_t connect to each other
telaf_tafSomeipGWSvc_connect(telaf_tafIvssDataSvc_t)

# Allow telaf_tafIvssDataSvc_t and telaf_tafSomeipGWSvc_t write to each other
telaf_tafSomeipGWSvc_write(telaf_tafIvssDataSvc_t)