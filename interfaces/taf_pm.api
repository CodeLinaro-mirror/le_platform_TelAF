/**
 * Maximum string length for a wake-up source tag (not including the null-terminator)
 */
DEFINE TAG_LEN = 31;

/**
 * Maximum string length for a wake-up source tag (including the null-terminator)
 */
DEFINE TAG_LEN_BYTES = TAG_LEN + 1;


/**
 * Option TAF_PM_REF_COUNT to manage a reference counted wakeup source
 */
DEFINE REF_COUNT = 1;

/**
 * Defines power states of the system
 */
ENUM State
{
    STATE_UNKNOWN,       ///< System state is unknown
    STATE_RESUME,        ///< System state is resume
    STATE_SUSPEND,       ///< System state is suspend
    STATE_SHUTDOWN       ///< System state is shutdown
};

/**
 * Defines all the status codes of API processing
 */
ENUM Status
{
    SUCCESS,         ///< API processing is successful
    FAILED,          ///< API processing failure
    EXPIRED          ///< Expired
};

/**
 * Handler for state change
 */
HANDLER StateChangeHandler
(
    State state IN
);

/**
 * TCU state change event of the local process
 */
EVENT StateChange
(
    StateChangeHandler handler
);

/**
 * Reference to wakeup source used by StayAwake and Relax function
 */
REFERENCE WakeupSource;

/**
 * Create a new wakeup source
 *
 * @return
 *      - Reference to wakeup source (to be used later for acquiring/releasing)
 *      - Null on failure
 *
 * @note The process exits if an invalid or existing tag is passed,
 *       or on syscall failures
 */
FUNCTION WakeupSource NewWakeupSource
(
    uint32 createOpts IN,       ///< Wakeup source options
    string wsTag[TAG_LEN] IN    ///< Context-specific wakeup source tag
);

/**
 * Acquire a passed wakeup source ref
 *
 * @return
 *     - LE_OK          if the wakeup source is acquired
 *     - LE_FAULT       for other errors
 *
 * @note The process exits with invalid reference
 */
FUNCTION le_result_t StayAwake
(
    WakeupSource wsRef IN      ///< Reference of wakeup source to be acquired
);

/**
 * Release a previously acquired wakeup source
 *
 * @return
 *     - LE_OK          if the wakeup source is acquired
 *     - LE_NOT_FOUND   if the wakeup source was not currently acquired
 *     - LE_FAULT       for other errors
 *
 * @note If an invalid reference is passed, process exits
 */
FUNCTION le_result_t Relax
(
    WakeupSource wsRef IN     ///< Reference of wakeup source to be released
);

/**
 * Get current system state of the local process
 *
 * @return State of the system
 */
FUNCTION State GetPowerState
(
);

