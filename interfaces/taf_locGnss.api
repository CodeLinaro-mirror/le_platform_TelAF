    HAS_VERTICAL_ACCURACY_BIT,    ///< Valid vertical accuracy via @ref taf_locGnss_GetAltitude
    HAS_SPEED_ACCURACY_BIT,       ///< Valid speed accuracy via @ref taf_locGnss_GetHorizontalSpeed
    HAS_HEADING_ACCURACY_BIT,     ///< Valid heading accuracy via @ref taf_locGnss_GetDirection
    HAS_TIMESTAMP_BIT,            ///< Valid timestamp  via @ref taf_locGnss_GetEpochTime
    HAS_ELAPSED_REAL_TIME_BIT,    ///< Valid elapsed real time via @ref taf_locGnss_GetRealTimeInformation
    HAS_ELAPSED_REAL_TIME_UNC_BIT,///< Valid elapsed real time uncertainty via
