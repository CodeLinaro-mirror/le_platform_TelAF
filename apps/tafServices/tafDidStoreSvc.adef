sandboxed: false

start: manual

maxThreads: 600
startGroup: 20

username: telaf

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
        CAP_SYS_ADMIN
        CAP_SYS_PTRACE
}

executables:
{
    tafDidStoreSvc = ( $TELAF_ROOT/components/tafDidStoreSvc )
}

groups:
{
}

processes:
{
    run:
    {
        (tafDidStoreSvc)
    }

    faultAction: restart
}

bindings:
{
    tafDidStoreSvc.tafDidStoreSvc.taf_diagDataID -> tafDiagSvc.taf_diagDataID
    tafDidStoreSvc.tafDidStoreSvc.le_appInfo -> <root>.le_appInfo
}

extern:
{
    tafDidStoreSvc.tafDidStoreSvc.taf_diagDidStore
}
