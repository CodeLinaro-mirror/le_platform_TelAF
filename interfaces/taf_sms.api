//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafsms SMS Service
 *
 * @ref taf_sms_interface.h "API Reference"
 *
 * <HR>
 *
 * The SMS service can be used to send/receive SMS messages and access messages from storage.
 * SMS is an easy and fast way to communicate or transmit data between devices in a cellular network.
 *
 * @section taf_sms_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafSMSSvc application service.
 *
 * The following example illustrates how to bind to the SMS service.
 * @verbatim
 *
   bindings:
   {
       clientExe.clientComponent.taf_sms -> tafSMSSvc.taf_sms
   }
   @endverbatim
 *
 * @section c_taf_sms_Create Creating a message object
 *
 * Before setting up and sending messages via these APIs, you need to create a message object by
 * calling taf_sms_Create()
 *
 * - taf_sms_Create() -- Creates a message object.
 *
 * @section c_taf_sms_Delete Deleting a message object
 *
 * When a message object is no longer used, call taf_sms_Delete to free the resources and delete the object.
 *
 * - taf_sms_Delete() -- Deletes the object.
 *
 * @section c_taf_sms_Set_1 Message object parameters configuration
 *
 * - taf_sms_SetDestination() -- Sets the destination phone number.
 *
 * - taf_sms_SetCallback() -- Sets the callback function to get the message send result.
 *
 * - taf_sms_SetPhoneId() -- With dual SIMs in device, sets the source phone ID.
 *
 * @section c_taf_sms_Set_2 Message content and format configuration
 *
 * There are 3 types of message formats can be assigned, either text messages (7-bit), binary messages (8-bit),
 * or UCS2 messages (16-bit). You can directly encode messages in PDU format as well. Message data length is
 * set with these APIs accordingly. For text messages, the maximum supported character length is 160 characters.
 * For binary messages, the maximum supported length is 140 bytes.
 * For UCS2 messages, the maximum supported characters is 70 characters.
 *
 * - taf_sms_SetText() -- Sets the message content as alphabet text.
 *
 * - taf_sms_SetBinary() -- Sets the message content as binary data.
 *
 * - taf_sms_SetUCS2() -- Sets the message as UCS2 text.
 *
 * - taf_sms_SetPDU() -- Sets the message with PDU format.
 *
 * The following example illustrates creating, setting up, and deleting a message object.
 *
 * @code

    taf_sms_MsgRef_t    tmpMsg;
    char                text[TAF_SMS_TEXT_BYTES] = {0};

    tmpMsg = taf_sms_Create();

    if(tmpMsg)
    {
        if(taf_sms_SetText(tmpMsg, "test set next") != LE_OK)
        {
            LE_ERROR("set text failed");
        }

        if(taf_sms_SetDestination(tmpMsg, "123456789") != LE_OK)
        {
            LE_ERROR("set destination failed");
        }

        if(taf_sms_SetPhoneId(tmpMsg, 1) != LE_OK);
        {
            LE_ERROR("set phone ID failed");
        }

        taf_sms_Delete(tmpMsg);
    }
    else
    {
        LE_ERROR("tmpMsg is NULL");
    }

 * @endcode
 *
 * @section c_taf_sms_Send Sending a message
 *
 * When a message is ready, taf_sms_Send() can be called to send it. taf_sms_Send() is returned with modem
 * feedback and with a maximum 10 second timeout.
 *
 * A message object can only be used once for sending, no matter what the sending result is.
 * Message objects need to be deleted by the caller.
 *
 * @section c_taf_sms_Receive Receiving messages
 *
 * To receive incoming messages, register a handler function with taf_sms_AddRxMsgHandler() and follow the
 * handler type definition: void (*taf_sms_RxMsgHandlerFunc_t)(taf_sms_MsgRef_t msg)
 *
 * A message object is created automatically when an incoming message is received, the registered handler
 * is triggered and further processes on the received message.
 *
 * To remove the handler function, call taf_sms_RemoveRxMsgHandler(). Callers have to delete the message object
 * when the message is no longer needed.
 *
 * @section c_taf_sms_Get Getting content and information of the message object
 *
 * - taf_sms_GetUserdataLen() Gets the data length of the content.
 * - taf_sms_GetText() -- Gets the text content of the message.
 * - taf_sms_GetUCS2() -- Gets the UCS2 text of the message.
 * - taf_sms_GetPDU() -- Gets the PDU format of the message.
 * - taf_sms_GetSendStatus() -- Gets the sending status from the Tx message.
 * - taf_sms_GetReadStatus() -- Gets the read status from the Rx message.
 *
 * @section c_taf_sms_Storage Storage configuration
 *
 * SMS service provides two types of storage to store messages, SIM card and HLOS.
 * It is receommended to use HLOS to maintain storage since it offers a full-function storage mechanism, including different types of
 * storage indication, message encryption, and storage recycling mechanism.
 *
 * - taf_sms_SetPreferredStorage() -- Sets preferred storage.
 * - taf_sms_GetPreferredStorage() -- Gets preferred storage.
 *
 * @section c_taf_sms_Storage_Indication Receiving full storage indication
 *
 * To receive storage indications, register a handler function with taf_sms_AddFullStorageEventHandler() and follow the
 * handler type definition of @ref taf_sms_FullStorageHandlerFunc_t
 *
 * To remove the handler function, call taf_sms_RemoveFullStorageEventHandler().
 *
 * @section c_taf_sms_RX Manipulating message in storage
 *
 * - taf_sms_DeleteFromStorage() -- Deletes a message from its storage location.
 * - taf_sms_MarkRead() -- Marks a message status as read.
 * - taf_sms_MarkUnread() -- Marks a message status as unread.
 *
 * HLOS storage provides more functions to maintain messsage configurations.
 *
 * - taf_sms_LockFromStorage() -- Marks a message as locked and the marked message cannot be deleted.
 * - taf_sms_UnlockFromStorage() -- Marks a message as unlocked and the marked message can be deleted.
 *
 * @section c_taf_sms_SmsCenter SMS center configuration
 *
 * - taf_sms_GetSmsCenterAddress() -- Gets SMS center address.
 * - taf_sms_SetSmsCenterAddress() -- Sets SMS center address.
 *
 * @section c_taf_sms_CellBroadcast Cell broadcast configuration
 *
 * - taf_sms_ActivateCellBroadcast() -- Activates cell broadcast.
 * - taf_sms_DeactivateCellBroadcast() -- Deactivates cell broadcast.
 * - taf_sms_AddCellBroadcastIds() -- Add cell broadcast message range of identifier.
 * - taf_sms_GetSmsCenterAddress() -- Remove cell broadcast range of message identifiers.
 *
 * @section taf_sms_usage_flow Typical application call flow
 *
 * @image html SMS_usage_flow.jpg
 *
 * The referenced application A and B can be two applications that are located in different NAD devices.
 * They communicate via the tafSMSSvc service on the corresponding NAD device.
 *
 * #0 -- Set the message receiving handler to be able to receive any messages sent to the application.
 *
 * #1 -- Create the message reference from the sender (application A).
 *
 * #2 -- Set the message content.
 *
 * #3 -- Set the receiver's phone number.
 *
 * #4 -- Set the message callback to get the sending result.
 *
 * #5 -- Send the message.
 *
 * #6 -- Get the new message notification with the message reference.
 *
 * #7 -- Get the sender's phone number.
 *
 * #8 -- Get the message content.
 *
 * #9 -- Mark the message as Read status.
 *
 * #10 -- (Optional) Delete the message from storage.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * SMS center length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  SMSC_ADDR_BYTES = (25);

//--------------------------------------------------------------------------------------------------
/**
 * Timestamp string length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  TIMESTAMP_LEN   = (20);

//--------------------------------------------------------------------------------------------------
/**
 * Timestamp string length including the null-terminator.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  TIMESTAMP_BYTES = (TIMESTAMP_LEN+1);

//--------------------------------------------------------------------------------------------------
/**
 * The text message length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  TEXT_LEN    = (160);

//--------------------------------------------------------------------------------------------------
/**
 * The text message length including the null-terminator.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  TEXT_BYTES  = (TEXT_LEN+1);

//--------------------------------------------------------------------------------------------------
/**
 * The binary message length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  BINARY_BYTES  = (140);

//--------------------------------------------------------------------------------------------------
/**
 * The UCS2 message length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  UCS2_BYTES  = (140);

//--------------------------------------------------------------------------------------------------
/**
 * The UCS2 message characters length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  UCS2_CHARS  = (70);

//--------------------------------------------------------------------------------------------------
/**
 * The PDU payload bytes length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  PDU_PAYLOAD = (140);

//--------------------------------------------------------------------------------------------------
/**
 * The PDU message length.
 * 36 bytes header.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  PDU_BYTES   = (36+PDU_PAYLOAD);

//--------------------------------------------------------------------------------------------------
/**
 * Message storage type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Storage
{
    STORAGE_NONE,    ///< NONE storage (notify only).
    STORAGE_NV,      ///< NV storage (not supported).
    STORAGE_SIM,     ///< SIM storage.
    STORAGE_HLOS,    ///< HLOS storage.
    STORAGE_UNKNOWN, ///< Unknown storage.
};

//--------------------------------------------------------------------------------------------------
/**
 * Full storage indication type.
 *
 * To notify a client app with differet storage status, the following notifications will be
 * sent to client with storage full indications.
 *
 * When preferred storage is set as HLOS:
 * - FULL_STORAGE_HLOS_ALERT -- HLOS storage reached the alert threshold (currently 80%) of usage.
 * - FULL_STORAGE_HLOS -- HLOS storage reached 100% usage, there is no free slot.
 *
 * When preferred storage is set as NV (not supported):
 * - FULL_STORAGE_NV -- Currently not supported.
 *
 * When preferred storage is set as SIM:
 * - FULL_STORAGE_SIM -- SIM storage is full.
 */
//--------------------------------------------------------------------------------------------------
ENUM StorageFullType
{
    FULL_UNKNOWN,           ///< Unknown.
    FULL_HLOS_ALERT,        ///< HLOS storage is going to be full.
    FULL_HLOS,              ///< HLOS storage is full.
    FULL_HLOS_STORE_TO_SIM, ///< HLOS storage is full and message is stored in SIM.
    FULL_BOTH_HLOS_AND_SIM, ///< Both HLOS storage and SIM storage are full.
    FULL_NV,                ///< NV storage is full.
    FULL_SIM                ///< SIM storage is full.
};

//--------------------------------------------------------------------------------------------------
/**
 * Message type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Type
{
    TYPE_TX,     ///< Tx message.
    TYPE_RX,     ///< Rx message.
    TYPE_UNKNOWN ///< Unknown type.
};

//--------------------------------------------------------------------------------------------------
/**
 * Read status type (for Rx message).
 */
//--------------------------------------------------------------------------------------------------
ENUM ReadStatus
{
    RXSTS_READ,   ///< Message is read.
    RXSTS_UNREAD, ///< Message is unread.
    RXSTS_UNKNOWN ///< Unknown status.
};

//--------------------------------------------------------------------------------------------------
/**
 * Send status type (for Tx message).
 */
//--------------------------------------------------------------------------------------------------
ENUM SendStatus
{
    TXSTS_UNSENT,          ///< Message is unsent.
    TXSTS_SENDING,         ///< Message is being sent.
    TXSTS_SENT,            ///< Message is sent.
    TXSTS_SENDING_FAILED,  ///< Message failed to be sent.
    TXSTS_SENDING_TIMEOUT, ///< Message timed out while sending.
    TXSTS_UNKNOWN          ///< Unknown status.
};

//--------------------------------------------------------------------------------------------------
/**
 * Lock status type (for Rx message stored in HLOS).
 */
//--------------------------------------------------------------------------------------------------
ENUM LockStatus
{
    LKSTS_LOCKED,   ///< Locked status.
    LKSTS_UNLOCKED, ///< Unlocked status.
    LKSTS_UNKNOWN   ///< Unknown status.
};

//--------------------------------------------------------------------------------------------------
/**
 * Message format type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Format
{
    FORMAT_TEXT,   ///< Text format.
    FORMAT_BINARY, ///< Binary format.
    FORMAT_UCS2,   ///< UCS2 format.
    FORMAT_PDU,    ///< PDU format.
    FORMAT_UNKNOWN ///< Unknown.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference type for SMS message objects.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Msg;

//--------------------------------------------------------------------------------------------------
/**
 * Reference type for SMS message List.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE MsgList;

//--------------------------------------------------------------------------------------------------
/**
 * Creates a message list for accessing messages.
 *
 * @return
 * Created message list reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION MsgList CreateRxMsgList
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes a message list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION DeleteList
(
    MsgList msgListRef ///< Message list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for sending messages.
 */
//--------------------------------------------------------------------------------------------------
HANDLER CallbackResult
(
    Msg msgRef,          ///< Message list reference.
    SendStatus status IN ///< Sending status.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for receiving messages.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RxMsgHandler
(
    Msg  msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event for handler usage.
 */
//--------------------------------------------------------------------------------------------------
EVENT RxMsg
(
    RxMsgHandler handler ///< Handler for receiving messages.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for full storage notifications.
 */
//--------------------------------------------------------------------------------------------------
HANDLER FullStorageHandler
(
    StorageFullType  fullType ///< Full storage indication type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event for information on full storage notifications.
 */
//--------------------------------------------------------------------------------------------------
EVENT FullStorageEvent
(
    FullStorageHandler handler ///< Handler for full storage indications.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the first message in the given list.
 *
 * @return
 * The first message reference in the message list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Msg GetFirst
(
    MsgList msgListRef ///< Message list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the next message in the list.
 *
 * @return
 * The next message reference from the message list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Msg GetNext
(
    MsgList msgListRef ///< Message list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's send status.
 *
 * @return
 * The message send status.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION SendStatus GetSendStatus
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's read status.
 *
 * @return
 * The message's read status.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ReadStatus GetReadStatus
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's lock status.
 *
 * @return
 * The message's lock status.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION LockStatus GetLockStatus
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Creates a new message to send.
 *
 * @return
 * The created message reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Msg Create
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the message's destination phone number.
 *
 * @return
 * - LE_BAD_PARAMETER -- Invalid input.
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDestination
(
    Msg     msgRef,                                       ///< Message reference.
    string  dest[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN ///< Destination number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the message's text.
 *
 * @return
 * - LE_BAD_PARAMETER -- Invalid input.
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetText
(
    Msg     msgRef,           ///< Message reference.
    string  text[TEXT_LEN] IN ///< Text message.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the message's binary content.
 *
 * @return
 * - LE_BAD_PARAMETER --  Invalid input.
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetBinary
(
    Msg     msgRef,               ///< Message reference.
    uint8   bin[BINARY_BYTES] IN  ///< Binary data.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the message's UCS2 content.
 *
 * @return
 * - LE_BAD_PARAMETER -- Invalid input.
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetUCS2
(
    Msg     msgRef,              ///< Message reference.
    uint16  ucs2[UCS2_CHARS] IN  ///< UCS2 message.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the message's PDU format.
 * @return
 * - LE_BAD_PARAMETER -- Invalid input.
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPDU
(
    Msg     msgRef,           ///< Message reference.
    uint8   pdu[PDU_BYTES] IN ///< Message in PDU format.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the message's callback function.
 *
 * @return
 * - LE_BAD_PARAMETER -- Invalid input.
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetCallback
(
    Msg     msgRef,        ///< Message reference.
    CallbackResult handler ///< Handler for sending message.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the phone ID function for the message; phone ID must be 1 or 2 (for DSDA use case).
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPhoneId
(
    Msg     msgRef,  ///< Message reference.
    uint8   phoneId  ///< Phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes a message from the message list, if there is no message list reference, it deletes
 * the message from storage.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Delete
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message sender's phone number.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_NOT_PERMITTED -- Invalid message type.
 * - LE_FAULT -- Invalid input string.
 * - LE_OVERFLOW -- String overflow.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSenderTel
(
    Msg     msgRef,                                       ///< Message reference.
    string  tel[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] OUT ///< Buffer to store sender's number.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's text.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Invalid input string.
 * - LE_OVERFLOW -- String overflow.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetText
(
    Msg     msgRef,            ///< Message reference.
    string  text[TEXT_LEN] OUT ///< Buffer to store message text.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's binary data.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Invalid input string.
 * - LE_OVERFLOW -- String overflow.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetBinary
(
    Msg     msgRef,               ///< Message reference.
    uint8   bin[BINARY_BYTES] OUT ///< Buffer to store binary data.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's UCS2 encoding.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Invalid input string.
 * - LE_OVERFLOW -- String overflow.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetUCS2
(
    Msg     msgRef,               ///< Message reference.
    uint16  ucs2[UCS2_CHARS] OUT  ///< Buffer to store UCS2 characters.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's PDU format.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Invalid input string.
 * - LE_OVERFLOW -- String overflow.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPDU
(
    Msg   msgRef,            ///< Message reference.
    uint8 pdu[PDU_BYTES] OUT ///< Buffer to store PDU format.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's PDU length.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Invalid input string.
 * - LE_OVERFLOW -- String overflow.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION size GetPDULen
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's type.
 *
 * @return
 * The message type.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Type GetType
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's format.
 *
 * @return
 * The message format.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Format GetFormat
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the message's text length.
 *
 * @return
 * The message's text length.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION size GetUserdataLen
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Send the message.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Send
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes a message from storage.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteFromStorage
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes all messages from storage.
 *
 * @note In the case of HLOS storage, this API only deletes unlocked messages.
 *
 * @return
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteAllFromStorage
(
    Storage  storage
);

//--------------------------------------------------------------------------------------------------
/**
 * Marks a message's status as read.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION MarkRead
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Marks a message's status as unread.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION MarkUnread
(
    Msg msgRef ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Marks a message's lock status as locked; the message cannot be deleted from storage.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 * - LE_NOT_PERMITTED -- Message is locked or is not stored in HLOS.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t LockFromStorage
(
    Msg msgRef  ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Marks a message's lock status as unlocked; the message can be deleted from storage.
 *
 * @return
 * - LE_NOT_FOUND -- Invalid message.
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 * - LE_NOT_PERMITTED -- Message is not locked or is not stored in HLOS.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UnlockFromStorage
(
    Msg msgRef  ///< Message reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the SMS center address for specified phone ID.
 *
 * @return
 * - LE_OVERFLOW -- Input buffer len is not enough.
 * - LE_FAULT -- Internal error.
 * - LE_TIMEOUT -- Timeout occurred.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSmsCenterAddress
(
    uint8   phoneId,                                        ///< Phone ID.
    string  addr[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] OUT  ///< Buffer to store SMS center address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the SMS center address for specified phone ID.
 *
 * @return
 * - LE_OVERFLOW -- Input buffer len is not enough.
 * - LE_FAULT -- Internal error.
 * - LE_TIMEOUT -- Timeout occurred.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetSmsCenterAddress
(
    uint8   phoneId,                                      ///< Phone ID.
    string  addr[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN ///< SMS center address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the preferred SMS storage place.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_TIMEOUT -- Timeout occurred.
 * - LE_UNSUPPORTED -- Input storage is not suppported.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPreferredStorage
(
    Storage prefStorage IN ///< Preferred storage type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the preferred SMS storage place.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_TIMEOUT -- Timeout occurred.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPreferredStorage
(
    Storage prefStorage OUT ///< Preferred storage type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends a PDU message.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendPduMsg
(
    uint8   dataPtr[PDU_BYTES] IN,  ///< Message in PDU format.
    uint32  timeout                 ///< Timeout value message send.
);

//--------------------------------------------------------------------------------------------------
/**
 * Activates cell broadcast for specified phone ID.
 *
 * @return
 * - LE_TIMEOUT -- Timeout occurred.
 * - LE_FAULT -- Failed.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ActivateCellBroadcast
(
    uint8   phoneId     ///< Phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deactivates cell broadcast for specified phone ID.
 *
 * @return
 * - LE_FAULT -- Failed.
 * - LE_TIMEOUT -- Timeout occurred.
 * - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeactivateCellBroadcast
(
    uint8   phoneId     ///< Phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Add cell broadcast message range of identifier for specified phone ID.
 *
 * @return
 * - LE_BAD_PARAMETER -- Invalid input.
 * - LE_TIMEOUT -- Timeout occurred.
 * - LE_FAULT -- Internal error.
 * - LE_OK -- Succceeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddCellBroadcastIds
(
    uint8  phoneId IN,  ///< Phone ID.
    uint16 fromId IN,   ///< Starting point of the filter.
    uint16 toId IN      ///< Ending point of the filter.
);

//--------------------------------------------------------------------------------------------------
/**
 * Remove cell broadcast range of message identifiers for specified phone ID.
 *
 * @return
 * - LE_BAD_PARAMETER -- Invalid input.
 * - LE_TIMEOUT -- Timeout occurred.
 * - LE_FAULT -- Internal error.
 * - LE_OK -- Succceeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveCellBroadcastIds
(
    uint8  phoneId IN,  ///< Phone ID.
    uint16 fromId IN,   ///< Starting point of the range.
    uint16 toId IN      ///< Ending point of the range.
);
