 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSessionConfig
(
    TunnelEntry tunnelEntryRef                IN, ///< Tunnel entry reference.
    L2tpSessionConfig sessionConfig[L2TP_MAX_SESSION_NUMBER_PER_TUNNEL]  OUT ///< Session config.
);
