maxThreads: 300
groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafECallSvc = ( $TELAF_ROOT/components/tafECallSvc )
}

start: auto

processes:
{
    run:
    {
        (tafECallSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

requires:
{
    configTree:
    {
        [w] .
    }
}

bindings:
{
    tafECallSvc.tafECallSvc.taf_sim -> tafSimCardSvc.taf_sim
    tafECallSvc.taf_pa_ecall.taf_sim -> tafSimCardSvc.taf_sim
}

extern:
{
    tafECallSvc.tafECallSvc.taf_ecall
}
