    OP_MODE_RESETTING,           ///< Device is in process of power cycling.
    OP_MODE_SHUTTING_DOWN,       ///< Device is in process of shutting down.
    OP_MODE_PERSISTENT_LOW_POWER ///< Persistent low power mode.
};

