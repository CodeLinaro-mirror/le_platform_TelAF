sandboxed: false

maxThreads: 600

username: telaf

startGroup: 11

capability:
{
    CAP_WAKE_ALARM
    CAP_BLOCK_SUSPEND
    CAP_DAC_OVERRIDE
    CAP_SYS_ADMIN
    CAP_DAC_READ_SEARCH
}

executables:
{
    tafRpcProxy = (component)
}

processes:
{
    run:
    {
        (tafRpcProxy)
    }

    faultAction: restart
}

bindings:
{
    tafRpcProxy.component.taf_someipClnt -> tafSomeipGWSvc.taf_someipClnt
    tafRpcProxy.component.taf_someipSvr -> tafSomeipGWSvc.taf_someipSvr
    tafRpcProxy.component.le_instStat -> <root>.le_instStat
}
