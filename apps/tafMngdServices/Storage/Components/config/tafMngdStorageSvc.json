{
    "Product": "TelAF",
    "Name": "MSS",
    "Version": "0.0.0",
    "Extension": "/data/persist/telaf/",
    "MSS Config Storage": {
        "Configuration": {
            "UpdatePath":[
                {
                    "QcmFormat": true,
                    "Path": "/data/ManagedServices/MSS/update/"
                }
            ],
            "StoragePath":[
                {
                    "BasePath": "/persist/configStorage/",
                    "BackupPath": "/persist/rfs/configStorage/"
                }
            ]
        }
    },
    "MSS Secure File Storage":
    {
        "Configuration":
        {
            "StoragePath":[
                {
                    "BasePath": "/persist/fileStorage/",
                    "BackupPath": "/persist/rfs/secFileStorage/"
                }
            ],
            "Storages": [
                {
                    "StorageName": "testSvcStorage",
                    "AccessibleApps": {
                        "Read": ["tafMngdStorageUnitTest", "tafMngdSecSharedApp"],
                        "Write": ["tafMngdStorageUnitTest","tafMngdSec2ndSharedApp"]
                    }
                },
                {
                    "StorageName": "SvcStorageInstance",
                    "AccessibleApps": {
                        "Read": ["AppA"],
                        "Write": ["AppB"]
                    }
                }
            ]
        }
    },
    "MSS Secure Data Storage":
    {
        "Configuration":
        {
            "StoragePath":[
                {
                    "BasePath": "/data/secStorage/",
                    "BackupPath": "/data/rfs/secStorage/"
                }
            ]
        }
    }
}