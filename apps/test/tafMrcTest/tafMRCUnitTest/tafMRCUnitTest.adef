sandboxed: false

maxMemoryBytes: 60000K

executables:
{
    tafMRCUnitTest = ( tafMRCComponent )
}

start: manual

processes:
{
    run:
    {
        (tafMRCUnitTest)
    }
    maxFileBytes: 1048576K
    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafMRCUnitTest.tafMRCComponent.taf_mrc -> tafMRCSvc.taf_mrc
}
