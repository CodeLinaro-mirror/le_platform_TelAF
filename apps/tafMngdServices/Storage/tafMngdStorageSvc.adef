maxThreads: 600

username: telaf
startGroup: 11

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
        CAP_FOWNER
        CAP_SYS_ADMIN
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

executables:
{
        tafMngdSecDataStorageSvc = ( $TELAF_ROOT/apps/tafMngdServices/Storage/Components/tafMngdSecDataStorageSvc )
        tafMngdSecFileStorageSvc = ( $TELAF_ROOT/apps/tafMngdServices/Storage/Components/tafMngdSecFileStorageSvc )
        tafMngdCfgStorageSvc = ( $TELAF_ROOT/apps/tafMngdServices/Storage/Components/tafMngdCfgStorageSvc )
}

start: auto

processes:
{
        run:
        {
                (tafMngdSecDataStorageSvc)
                (tafMngdSecFileStorageSvc)
                (tafMngdCfgStorageSvc)
        }

        maxFileBytes: 8192K
        faultAction: stopApp
}

sandboxed: false

bindings:
{
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.taf_fsc -> tafKeyStoreSvc.taf_fsc
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.le_cfg -> <root>.le_cfg
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.le_cfgAdmin -> <root>.le_cfgAdmin
    tafMngdSecDataStorageSvc.tafMngdSecDataStorageSvc.taf_ks -> tafKeyStoreSvc.taf_ks
    tafMngdSecDataStorageSvc.tafMngdSecDataStorageSvc.le_appInfo -> <root>.le_appInfo
    tafMngdSecFileStorageSvc.tafMngdSecFileStorageSvc.taf_fsc -> tafKeyStoreSvc.taf_fsc
    tafMngdSecFileStorageSvc.tafMngdSecFileStorageSvc.le_appInfo -> <root>.le_appInfo
}

bundles:
{
    file:
    {
        [r]  $TELAF_ROOT/apps/tafMngdServices/Storage/Components/config/tafMngdStorageSvc.json  /
    }
}

// Directory in which configuration JSONs will be installed
requires:
{
    dir:
    {
        /data/ManagedServices /
    }

    configTree:
    {
        [rw] tafMngdCfgStorageSvc
    }

}

extern:
{
    tafMngdSecDataStorageSvc.tafMngdSecDataStorageSvc.taf_mngdStorSecData
    tafMngdSecFileStorageSvc.tafMngdSecFileStorageSvc.taf_mngdStorSecFile
    tafMngdCfgStorageSvc.tafMngdCfgStorageSvc.taf_mngdStorCfg
}
