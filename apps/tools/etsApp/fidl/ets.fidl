	<**
		@description : A broadcast e2e event triggered on triggerEventUINT8E2E method request.
	**>
	broadcast TestEventUINT8E2E {
		out {
			<**
				@description : The e2e header length.
			**>
			UInt16 length
			<**
				@description : The e2e counter value.
			**>
			UInt16 counter
			<**
				@description : The e2e data Identifier.
			**>
			UInt32 dataID
			<**
				@description : The crc value.
			**>
			UInt32 CRC
			<**
				@description : The uint8 payload parameter.
			**>
			UInt8 uINT8Value
		}
	}

	<**
		@description : Returns back the e2e data passed as input parameter.
	**>
	method echoUINT8E2E{
        in {
			<**
				@description : The e2e header length.
			**>
