/**
 *  Gets the current network name.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCurrentNetworkName
(
    string nameStr[NETWORK_NAME_MAX_LEN] OUT, ///< Current network name.
    uint8 phoneId IN                          ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the current MCC and MNC.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_FAULT -- Failed.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCurrentNetworkMccMnc
(
    string mccStr[MCC_LEN] OUT,     ///< MCC.
    string mncStr[MNC_MAX_LEN] OUT, ///< MNC.
    uint8 phoneId IN                ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Performs celluar network scan and gets the network scan information list reference.
 *
 * @return
 *  - Non-null pointer -- The network scan information list reference.
 *  - Null pointer -- Internal error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ScanInformationList PerformCellularNetworkScan
(
    uint8 phoneId IN ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Asynchronously performs a celluar network scan.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION PerformCellularNetworkScanAsync
(
    CellularNetworkScanHandler handler, ///< Handler for network scan.
    uint8 phoneId IN                    ///< Slot ID.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the reference of the first operator in the network scan information list.
 *
 * @return
 *  - Non-null pointer -- The reference of the first operator in the network scan list.
 *  - Null pointer -- Internal error.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ScanInformation GetFirstCellularNetworkScan
(
    ScanInformationList scanInformationListRef IN ///< The network scan information list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the reference of the next operator based on the current position in the network scan
 * information list.
 *
 * @return
 *  - Non-null pointer -- The reference to the next operator in the network scan list.
 *  - Null pointer -- Internal error or the end of the list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ScanInformation GetNextCellularNetworkScan
(
    ScanInformationList scanInformationListRef IN ///< The network scan information list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Deletes the network scan information list reference.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteCellularNetworkScan
(
    ScanInformationList scanInformationListRef IN ///< The network scan information list reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets MCC and MNC of a network scan operator.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCellularNetworkMccMnc
(
    ScanInformation scanInformationRef IN, ///< The scan information list reference.
    string mccPtr[MCC_LEN] OUT,            ///< MCC.
    string mncPtr[MNC_MAX_LEN] OUT         ///< MNC.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the network name of a network scan operator.
 *
 * @return
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_NOT_FOUND -- Reference not found.
 *  - LE_OK -- Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetCellularNetworkName
(
    ScanInformation scanInformationRef IN,   ///< The scan information list reference.
    string namePtr[NETWORK_NAME_MAX_LEN] OUT ///< Network name.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Checks if a scan operator's network is in use.
 *
 * @return
 *  - True -- Network is in use.
 *  - False -- Invalid reference or network is not in use.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsCellularNetworkInUse
(
    ScanInformation scanInformationRef IN ///< The network scan operator reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Checks if the scan operator's network is available.
 *
 * @return
 *  - True -- Network is available.
 *  - False -- Invalid reference or network is available.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsCellularNetworkAvailable
(
    ScanInformation scanInformationRef IN ///< The network scan operator reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Checks if scan operator is home network.
 *
 * @return
 *  - True -- It is home network.
 *  - False -- Invalid reference or it is not home network.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsCellularNetworkHome
(
    ScanInformation scanInformationRef IN ///< The network scan operator reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Checks if scan operator's network is forbidden.
 *
 * @return
 *  - True -- Network is forbidden.
 *  - False -- Invalid reference or network is forbidden.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsCellularNetworkForbidden
(
    ScanInformation scanInformationRef IN ///< The network scan operator reference.
);
