sources:
{
    tafMngdSecStore.cpp
    tafMngdSecData.cpp
    tafMngdStorageImpl.cpp
    tafMngdStorageSvc.cpp
    tafMngdConfigStorage.cpp
}

provides:
{
    api:
    {
        $TELAF_ROOT/apps/tafMngdServices/interfaces/staging/taf_mngdStorSec.api
        $TELAF_ROOT/apps/tafMngdServices/interfaces/staging/taf_mngdStorCfg.api
    }
}

requires:
{
    api:
    {
        taf_ks.api
        le_appInfo.api
        le_cfg.api
        le_cfgAdmin.api
    }

    component:
    {
        $TELAF_ROOT/components/tafRFSLib
    }
}

cxxflags:
{
    -I$TELAF_ROOT/include
    -I${LEGATO_ROOT}/framework/liblegato
    -I$TELAF_ROOT/include/staging
    -DMSS_SEC_STORE_SIZE=8192
}

ldflags:
{
   -lssl
   -lcrypto
   -lboost_filesystem
}