maxThreads: 600
sandboxed: false

executables:
{
    tafMngdSecDataStorageUnitTest =
            ($TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdStorageUnitTest/tafMngdSecDataStorageUnitTestComp)

    tafMngdCfgStorageUnitTest =
            ($TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdStorageUnitTest/tafMngdCfgStorageUnitTestComp)

    tafMngdSecFileStorageUnitTest =
            ($TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdStorageUnitTest/tafMngdSecFileStorageUnitTestComp)

}

start: manual

processes:
{

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafMngdCfgStorageUnitTest.tafMngdCfgStorageUnitTestComp.taf_mngdStorCfg -> tafMngdStorageSvc.taf_mngdStorCfg
    tafMngdSecDataStorageUnitTest.tafMngdSecDataStorageUnitTestComp.taf_mngdStorSecData -> tafMngdStorageSvc.taf_mngdStorSecData
    tafMngdSecFileStorageUnitTest.tafMngdSecFileStorageUnitTestComp.taf_mngdStorSecFile -> tafMngdStorageSvc.taf_mngdStorSecFile
}

