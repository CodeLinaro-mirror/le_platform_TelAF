policy_module(tafTimeUnitTest, 1.0)

gen_require(`
  type telaf_admin_t;
  type data_t;
')

type telaf_tafTimeUnitTest_data_t;
files_type(telaf_tafTimeUnitTest_data_t);

type telaf_tafTimeUnitTest_exec_t;
files_type(telaf_tafTimeUnitTest_exec_t);

type telaf_tafTimeUnitTest_t;

init_telaf_app_domain(telaf_tafTimeUnitTest_t,telaf_tafTimeUnitTest_exec_t)

# For accessing gptp device
telaf_use_gptp(telaf_tafTimeUnitTest_t)

allow telaf_admin_t telaf_tafTimeUnitTest_exec_t:lnk_file { read };

# Allow time service to create netlink socket
allow telaf_tafTimeUnitTest_t telaf_tafTimeUnitTest_t:netlink_route_socket *;
