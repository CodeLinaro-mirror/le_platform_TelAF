sandboxed: false

maxThreads: 300

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_RAW
    CAP_IPC_LOCK
    CAP_SYS_NICE
    CAP_SYS_RESOURCE
    CAP_NET_ADMIN
    CAP_BLOCK_SUSPEND
}

executables:
{
    tafSomeipGWSvc = ( $TELAF_ROOT/components/tafSomeipGWSvc )
}

processes:
{
    envVars:
    {
        VSOMEIP_CONFIGURATION = tafSomeipGWSvc.json
    }

    run:
    {
        ( tafSomeipGWSvc )
    }

    faultAction: restart
}

bindings:
{
}

extern:
{
    tafSomeipGWSvc.tafSomeipGWSvc.taf_someipSvr
    tafSomeipGWSvc.tafSomeipGWSvc.taf_someipClnt
}

