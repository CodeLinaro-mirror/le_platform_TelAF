maxThreads: 600

username: telaf

startGroup: 12

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafSMSSvc = ( $TELAF_ROOT/components/tafSMSSvc )
}

start: auto

processes:
{
    run:
    {
        (tafSMSSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
    tafSMSSvc.tafSMSSvc.taf_ks -> tafKeyStoreSvc.taf_ks
}

extern:
{
    tafSMSSvc.tafSMSSvc.taf_sms
}
