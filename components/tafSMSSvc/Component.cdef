provides:
{
    api:
    {
        taf_sms.api
    }
}

ldflags:
{
    -L$TELAF_DEFAULT_PA_LIB_DIR/lib
}

requires:
{
    api:
    {
        le_cfg.api
        taf_ks.api [optional]
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
    }

    lib:
    {
        libComponent_taf_pa_sms.so
        libComponent_taf_pa_smsDef.so
    }
}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$LEGATO_ROOT/components/cfgEntries
    -I$TELAF_ROOT/include
    -I$TELAF_PA_DEFAULT/include
    -std=c++17
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
}

sources:
{
    tafSmsImpl.cpp
    tafSmsSvc.cpp
    tafSmsPdu.cpp
    tafSmsHlos.cpp
}
