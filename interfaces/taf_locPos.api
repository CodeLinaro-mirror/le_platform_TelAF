//--------------------------------------------------------------------------------------------------
/**
 * @page c_taflocPos Positioning
 *
 * @rst :ref:`API reference <File taf_locPos_interface.h>` @endrst
 *
 * <HR>
 *
 * This API provides access to the device's physical position and movement information.
 *
 * @b NOTE: Enabling and disabling the positioning system can be performed
 *          only through the @ref c_taflocPosCtrl.
 *
 * @section taf_locPos_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafLocationSvc application service.
 *
 * The following example illustrates how to bind to the positioning service.
 * @verbatim
   bindings:
   {
      clientExe.clientComponent.taf_locPos -> tafLocationSvc.taf_locPos
   }
   @endverbatim
 *
 * The @c taf_locPos_Get2DLocation() function gets the last updated latitude, longitude,
 * and the horizontal accuracy values:
 *
 * - Latitude is in degrees, positive North.
 * - Longitude is in degrees, positive East.
 * - Horizontal accuracy is in meters by default.
 *
 * @verbatim
   int32_t latitude;
   int32_t longitude;
   int32_t hAccuracy;
   if (taf_locPos_Get2DLocation(&latitude, &longitude, &hAccuracy) == LE_OK)
   {
     // Process after succesfully getting the 2 dimension location information.
   }
   @endverbatim
 *
 * For example, the latitude and longitude are given in degrees with 6 decimal places like
 * - Latitude +48858300 = 48.858300 degrees North
 * - Longitude +2294400 = 2.294400 degrees East
 *
 * The @c taf_locPos_Get3DLocation() function gets the last updated latitude, longitude,
 * altitude, and their associated accuracy values.
 *
 * - Altitude is in meters by default, above mean sea level, with 3 decimal places,
 *   i.e., 3047 = 3.047 meters.
 * - Horizontal and vertical accuracies are in meters by default.
 *
 * @verbatim
   int32_t latitude;
   int32_t longitude;
   int32_t hAccuracy;
   int32_t altitude;
   int32_t vAccuracy;
   if (taf_locPos_Get3DLocation(&latitude, &longitude, &hAccuracy,&altitude, &vAccuracy) == LE_OK)
   {
     // Process after succesfully getting the 3 dimensional location information.
   }
   @endverbatim
 *
 * The @c taf_locPos_GetTime() function gets the time of last updated position.
 *
 * - Hours into the day; range is 0 to 23.
 * - Minutes into the hour; range is 0 to 59.
 * - Seconds into the minute; range is 0 to 59.
 * - Milliseconds into the second; range is 0 to 999.
 *
 * @verbatim
   uint16_t hrsPtr;
   uint16_t minPtr;
   uint16_t secPtr;
   uint16_t msecondsPtr;
   if (taf_locPos_GetTime(&hrsPtr, &minPtr, &secPtr,&msecondsPtr) == LE_OK)
   {
     // Process after succesfully getting the time information.
   }
   @endverbatim
 *
 * The @c taf_locPos_GetDate() function gets the date of last updated position.
 *
 * - Year A.D.; e.g. 2014.
 * - Month into the year; range is 1 to 12.
 * - Days into the month; range is 1 to 31.
 *
 * @verbatim
   uint16_t yearPtr;
   uint16_t monthPtr;
   uint16_t dayPtr;
   if (taf_locPos_GetDate(&yearPtr, &monthPtr, &dayPtr) == LE_OK)
   {
     // Process after succesfully getting the date information.
   }
   @endverbatim
 *
 * The @c taf_locPos_GetDirection() function gets the last updated direction value in degrees and
 * its associated accuracy value.
 *
 * - Direction in degrees; range is 0 to 359 with 0 being true North.
 * Direction of movement is the direction that the vehicle or person is actually moving.
 *
 * @verbatim
   uint32_t direction;
   uint32_t directionAccuracy;
   if (taf_locPos_GetDirection(&direction, &directionAccuracy) == LE_OK)
   {
     // Process after succesfully getting the direction information.
   }
   @endverbatim
 *
 * The @c taf_locPos_GetMotion() function gets motion's data (horizontal speed and accuracy;
 * verticial speed and accuracy).
 * @verbatim
   uint32_t hSpeed, hAccuracy;
   int32_t vSpeed, vAccuracy;
   if (taf_locPos_GetMotion(&hSpeed, &hAccuracy, &vSpeed, &vAccuracy)) == LE_OK)
   {
     // Process after succesfully getting the Motion data.
   }
   @endverbatim
 *
 * The @c taf_locPos_GetFixState() function gets the position fix state. The fix state allows the user
 * to determine if it is a 2-dimensional or a 3-dimensional position fix.
 *
 * @verbatim
   taf_locPos_FixState_t fixState;
   if(taf_locPos_GetFixState(&fixState)== LE_OK)
   {
     // Process after succesfully getting the fix state.
   }
   @endverbatim
 *
 * The @c taf_locPos_SetDistanceResolution() function sets the resolution for the positioning distance
 * values.
 *
 * @verbatim
   if(taf_locPos_SetDistanceResolution(RES_DECIMETER) == LE_OK))
   {
     // Process after succesfully setting the distance resolution.
   }
   @endverbatim
 *
 * To be notified when the device is in motion, you must register a handler function
 * to get the new position data. The @c taf_locPos_AddMovementHandler() API registers
 * that handler. The horizontal and vertical change is measured in meters so only movement over
 * the threshhold triggers notification (0 means not to notify about changes).
 *
 * @verbatim
   static void NavigationHandler
   (
      taf_locPos_SampleRef_t positionSampleRef,
      void* contextPtr
   )
   {
     int32_t latitude, longitude, horizontalAccuracy;
     LE_ASSERT_OK(taf_locPos_sample_Get2DLocation(positionSampleRef, &latitude,
                                            &longitude, &horizontalAccuracy));
     taf_locPos_sample_Release(positionSampleRef);
   }
   static taf_locPos_MovementHandlerRef_t  navigationHandlerRef;
   navigationHandlerRef = taf_locPos_AddMovementHandler(0, 0, NavigationHandler, NULL);
   LE_ASSERT(NULL != navigationHandlerRef);
   taf_locPos_RemoveMovementHandler(navigationHandlerRef);
   @endverbatim
 *
 * The handler gives a reference to the position sample object that triggered the
 * notification. You can then access parameters using accessor functions and release
 * the object when done with it.
 *
 * The accessor functions are:
 * - taf_locPos_sample_Get2DLocation -- Triggered inside NavigationHandler() function to get
 *   positionSampleRef.
 *
 * @verbatim
   int32_t  longi, lat, haccuracy;
   if(taf_locPos_sample_Get2DLocation(positionSampleRef, &longi, &lat, &haccuracy) == LE_OK)
   {
     // Process after succesfully getting the 2 dimensional location information.
   }
   @endverbatim
 *
 * - taf_locPos_sample_GetTime() -- Triggered inside NavigationHandler() function to get
 *   positionSampleRef.
 *
 * @verbatim
   int32_t  hours, min, sec;
   if(taf_locPos_sample_GetTime(positionSampleRef, &hours, &min, &sec) == LE_OK)
   {
     // Process after succesfully getting the time information.
   }
   @endverbatim
 *
 * - taf_locPos_sample_GetDate() -- Triggered inside NavigationHandler() function to get
 *   positionSampleRef.
 *
 * @verbatim
   int32_t  year, month, day;
   if(taf_locPos_sample_GetDate(positionSampleRef, &year, &month, &day) == LE_OK)
   {
     // Process after succesfully getting the time information.
   }
   @endverbatim
 *
 * - taf_locPos_sample_GetAltitude() -- Triggered inside NavigationHandler() function to get
 *   positionSampleRef.
 *
 * @verbatim
   int32_t  altitude,altitudeAccuracy,
   if(taf_locPos_sample_GetAltitude(positionSampleRef, &altitude, &altitudeAccuracy) == LE_OK)
   {
     // Process after succesfully getting the altitude information.
   }
   @endverbatim
 *
 * - taf_locPos_sample_GetHorizontalSpeed() -- Triggered inside NavigationHandler() function to get
 *   positionSampleRef.
 *
 * @verbatim
   int32_t  hSpeed,hSpeedAccuracy,
   if(taf_locPos_sample_GetHorizontalSpeed(positionSampleRef, &hSpeed, &hSpeedAccuracy) == LE_OK)
   {
     // Process after succesfully getting the horizontal speed information.
   }
   @endverbatim
 *
 * - taf_locPos_sample_GetVerticalSpeed() -- Triggered inside NavigationHandler() function to get
 *   positionSampleRef.
 *
 * @verbatim
   int32_t  vSpeed,vSpeedAccuracy,
   if(taf_locPos_sample_GetVerticalSpeed(positionSampleRef, &vSpeed, &vSpeedAccuracy) == LE_OK)
   {
     // Process after succesfully getting the vertifical speed information.
   }
   @endverbatim
 *
 * - taf_locPos_sample_GetDirection() -- Triggered inside NavigationHandler() function to get
 *   positionSampleRef.
 *
 * @verbatim
   int32_t  direction,directionAccuracy,
   if(taf_locPos_sample_GetDirection(positionSampleRef, &direction, &directionAccuracy) == LE_OK)
   {
     // Process after succesfully getting the direction information.
   }
   @endverbatim
 *
 * - taf_locPos_sample_GetFixState()
 *
 * @verbatim
   taf_locPos_FixState_t fixState;
   if(taf_locPos_sample_GetFixState(&fixState)== LE_OK)
   {
     // Process after succesfully getting the fix state.
   }
   @endverbatim
 *
 * @c taf_locPos_sample_Release() releases the object.
 *
 * You can remove the handler function by calling the taf_locPos_RemoveMovementHandler() API.
 * @b NOTE: The taf_locPos_RemoveMovementHandler() API does not delete the position object. The caller has
 *          to delete it by calling the taf_locPos_sample_Release() function.
 *
 * @section taf_locPos_acquisitionRate Positioning acquisition rate
 *
 * The acquisition rate value can be set or with taf_locPos_SetAcquisitionRate() and retrieved with
 * taf_locPos_GetAcquisitionRate().
 * It is also set when calling taf_locPos_AddMovementHandler(). The acquisition rate is calculated
 * from the horizontal and vertical magnitude parameters set in this function.
 * This calculated acquisition rate can be retrieved by calling taf_locPos_GetAcquisitionRate().
 * @verbatim
   if(taf_locPos_SetAcquisitionRate(3000) == LE_OK)
   {
     // Process after succesfully setting the acquisition rate.
   }
   @endverbatim
 * @verbatim
   uint32_t acquisitionRate=0;
   if(taf_locPos_GetAcquisitionRate(&fixState)== LE_OK)
   {
     // Process after succesfully getting the acquisition rate.
   }
   @endverbatim
 * @b NOTE: The acquisition rate set will take effect once a request of activation of the positioning service
 *          by taf_locPosCtrl_Request() is done.
 *
 * @b NOTE: If the acquisition rate was not previously configured, it will be set to a default value
 *          of one second once taf_locPosCtrl_Request() is called.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 *  Position sample reference type.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Sample;

//--------------------------------------------------------------------------------------------------
USETYPES taf_locGnss.api;

DEFINE TAF_LOCPOS_MAX_OBJ = 1;

//--------------------------------------------------------------------------------------------------

/**
 * Handler for movement changes that returns the reference of a reported position sample.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER MovementHandler
(
 Sample positionSampleRef ///< [OUT] Reference of the reported position sample.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on movement changes.
 *
 */
//--------------------------------------------------------------------------------------------------
EVENT Movement
(
 uint32 horizontalMagnitude IN, ///< Horizontal magnitude in meters.
 uint32 verticalMagnitude IN,   ///< Vertical magnitude in meters.
 MovementHandler handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the 2D location data (latitude, longitude, horizontal accuracy).
 *
 * @return
 * - LE_FAULT         Failed to get the 2D location data.
 * - LE_OUT_OF_RANGE  One, or more, retrieved parameters is invalid.
 * - LE_OK            Succeeded.
 *
 * @b NOTE: latitudePtr, longitudePtr, hAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Get2DLocation
(
 int32 latitude OUT,     ///< WGS84 latitude in degrees.
 int32 longitude OUT,    ///< WGS84 longitude in degrees.
 int32 hAccuracy OUT     ///< Horizontal accuracy in meters by default.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the date of the last updated location.
 *
 * @return
 * - LE_FAULT         Failed to get the date.
 * - LE_OUT_OF_RANGE  The retrieved date is invalid.
 * - LE_OK            Succeeded.
 *
 * @b NOTE: Currently the API implementation is in progress.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDate
(
 uint16 year OUT,             ///< UTC Year A.D., e.g. 2014.
 uint16 month OUT,            ///< UTC Month into the year; range is 1 to 12.
 uint16 day OUT               ///< UTC Days into the month; range is 1 to 31.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position fix state.
 *
 * @return
 * - LE_FAULT         Failed to get the position fix state.
 * - LE_OK            Succeeded.
 *
 * @b NOTE: In case the function fails to get the position fix state, a fatal error occurs,
 *       the function will not return.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFixState
(
 taf_locGnss.FixState state OUT              ///< Position fix state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the motion data (horizontal speed, horizontal speed
 * accuracy, vertical speed, and vertical speed accuracy).
 *
 * @return
 * - LE_FAULT         Failed to get the motion data.
 * - LE_OUT_OF_RANGE  One, or more, of the retrieved parameters is invalid (set to INT32_MAX,
 *                    UINT32_MAX).
 * - LE_OK            Succeeded.
 *
 * @b NOTE: hSpeedPtr, hSpeedAccuracyPtr, vSpeedPtr, and vSpeedAccuracyPtr can be set to NULL if not
 *       needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMotion
(
 uint32 hSpeed OUT,           ///< Horizontal speed in m/sec.
 uint32 hSpeedAccuracy OUT,   ///< Horizontal speed accuracy in m/sec.
 int32 vSpeed OUT,            ///< Vertical speed in m/sec.
 int32 vSpeedAccuracy OUT     ///< Vertical speed accuracy in m/sec.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's direction. Direction of movement is the direction that the vehicle or
 * person is actually moving.
 *
 * @return
 * - LE_FAULT         Failed to get the direction indication.
 * - LE_OUT_OF_RANGE  One, or more, of the retrieved parameters is invalid.
 * - LE_OK            Succeeded.
 *
 * @b NOTE: Direction is given in degrees.
 *       Direction ranges from 0 to 359 degrees, where 0 is true North degree.
 *
 * @b NOTE: directionPtr and directionAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDirection
(
 uint32 direction OUT,           ///< Direction indication in degrees; range is 0 to 359.
 uint32 directionAccuracy OUT    ///< Direction's accuracy estimation in degrees.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's time.
 *
 * @return
 * - LE_FAULT         Failed to get the time.
 * - LE_OUT_OF_RANGE  The retrieved time is invalid.
 * - LE_OK            Succeeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTime
(
 uint16 hours OUT,            ///< UTC Hours of the day; range is 0 to 23.
 uint16 minutes OUT,          ///< UTC Minutes of the hour; range is 0 to 59.
 uint16 seconds OUT,          ///< UTC Seconds of the minute; range is 0 to 59.
 uint16 milliseconds OUT      ///< UTC Milliseconds of the second; range is 0 to 999.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the acquisition rate.
 *
 * @return
 * - LE_OUT_OF_RANGE    Acquisition rate is invalid.
 * - LE_OK              Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAcquisitionRate
(
 uint32  acquisitionRate IN  ///< Acquisition Rate in milliseconds.
);

//--------------------------------------------------------------------------------------------------
/**
 * Retrieves the acquisition rate in milliseconds.
 *
 * @return
 * Acquisition rate in milliseconds.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION uint32 GetAcquisitionRate
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Releases the position sample.
 *
 * @b NOTE: If the caller is passing an invalid position reference to this function,
 *       it is a fatal error and the function will not return.
 */
//--------------------------------------------------------------------------------------------------

FUNCTION sample_Release
(
 Sample positionSampleRef            ///< Position sample reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Resolution values.
*/
ENUM Resolution
{
    RES_METER,                     ///< Meter resolution.
    RES_DECIMETER,                 ///< Decimeter resolution.
    RES_CENTIMETER,                ///< Centimeter resolution.
    RES_MILLIMETER,                ///< Millimeter resolution
    RES_UNKNOWN                    ///< Unknown resolution.
};

//--------------------------------------------------------------------------------------------------
/**
 * Gets the 3D location data (latitude, longitude, altitude,
 * horizontal accuracy, vertical accuracy)
 *
 * @return
 * - LE_FAULT         Failed to get the 3D location data.
 * - LE_OUT_OF_RANGE  One, or more, of the retrieved parameters is invalid.
 * - LE_OK            Succeeded.
 *
 * @b NOTE: latitudePtr, longitudePtr,hAccuracyPtr, altitudePtr, and vAccuracyPtr can be set to NULL
 *       if not needed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Get3DLocation
(
    int32 latitude OUT,     ///< WGS84 Latitude in degrees.
    int32 longitude OUT,    ///< WGS84 Longitude in degrees.
    int32 hAccuracy OUT,    ///< Horizontal accuracy in meters by default.
    int32 altitude OUT,     ///< Altitude above mean sea level in meters by default.
    int32 vAccuracy OUT     ///< Vertical accuracy in meters by default.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's 2D location (latitude, longitude,
 * horizontal accuracy)
 *
 * @return
 * - LE_FAULT         Failed to find the positionSample.
 * - LE_OUT_OF_RANGE  One, or more, of the retrieved parameters is invalid.
 * - LE_OK            Suceeded.
 *
 * @b NOTE: If the caller passes an invalid position reference to this function,
 *       it is a fatal error and the function will not return.
 *
 * @b NOTE: latitudePtr, longitudePtr, and horizontalAccuracyPtr can be set to NULL if not needed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_Get2DLocation
(
    Sample positionSampleRef,     ///< Position sample reference.
    int32 latitude OUT,           ///< WGS84 latitude in degrees.
    int32 longitude OUT,          ///< WGS84 longitude in degrees.
    int32 horizontalAccuracy OUT  ///< Horizontal accuracy in meters by default.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's altitude.
 *
 * @return
 * - LE_FAULT         Failed to find the positionSample.
 * - LE_OUT_OF_RANGE  One, or more, of the retrieved parameters is invalid.
 * - LE_OK            Suceeded.
 *
 * @b NOTE: If the caller passes an invalid position reference to this function,
 *       it is a fatal error and the function will not return.
 *
 * @b NOTE: altitudePtr and altitudeAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetAltitude
(
    Sample positionSampleRef,           ///< Position sample reference.
    int32 altitude OUT,                 ///< Altitude above mean sea level in meters by default.
    int32 altitudeAccuracy OUT          ///< Vertical accuracy in meters by default.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's time.
 *
 * @return
 * - LE_FAULT         Failed to get the time.
 * - LE_OUT_OF_RANGE  The retrieved time is invalid.
 * - LE_OK            Succeeded.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetTime
(
    Sample positionSampleRef,    ///< Position sample reference.
    uint16 hours OUT,            ///< UTC hours of the day; range is 0 to 23.
    uint16 minutes OUT,          ///< UTC minutes of the hour; range is 0 to 59.
    uint16 seconds OUT,          ///< UTC seconds of the minute; range is 0 to 59.
    uint16 milliseconds OUT      ///< UTC milliseconds of the second; range is 0 to 999.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's horizontal speed.
 *
 * @return
 * - LE_FAULT         Failed to find the positionSample.
 * - LE_OUT_OF_RANGE  One, or more, of the retrieved parameters is invalid.
 * - LE_OK            Suceeded.
 *
 * @b NOTE: If the caller passes an invalid position reference to this function,
 *       it is a fatal error and the function will not return.
 *
 * @b NOTE: hSpeedPtr and hSpeedAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetHorizontalSpeed
(
    Sample positionSampleRef,           ///< Position sample reference.
    uint32 hSpeed OUT,                  ///< The horizontal speed in m/sec.
    uint32 hSpeedAccuracy OUT           ///< The horizontal accuracy in m/sec.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's direction
 *
 * @return
 * - LE_FAULT         Failed to find the positionSample.
 * - LE_OUT_OF_RANGE  One of the retrieved parameter is invalid.
 * - LE_OK            Suceeded.
 *
 * @b NOTE: Direction is given in degrees.
 *       Direction ranges from 0 to 359 degrees, where 0 is true North.
 *
 * @b NOTE: If the caller passed an invalid position reference to this function,
 *       it is a fatal error and the function will not return.
 *
 * @b NOTE: directionPtr and directionAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetDirection
(
    Sample positionSampleRef,           ///< Position sample reference.
    uint32 direction OUT,               ///< Direction indication in degrees.
    uint32 directionAccuracy OUT        ///< Direction's accuracy estimation in degrees.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's vertical speed.
 *
 * @return
 * - LE_FAULT         Failed to find the positionSample.
 * - LE_OUT_OF_RANGE  One, or more, of the retrieved parameters is not valid.
 * - LE_OK            Suceeded.
 *
 * @b NOTE: If the caller passes an invalid position reference to this function,
 *       it is a fatal error and the function will not return.
 *
 * @b NOTE: vSpeedPtr and vSpeedAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetVerticalSpeed
(
    Sample positionSampleRef,           ///< Position sample reference
    int32 vspeed OUT,                   ///< The vertical speed in m/sec.
    int32 vspeedAccuracy OUT            ///< The vertical speed's accuracy in m/sec.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the resolution for the positioning distance values.
 *
 * @return
 * - LE_OK               Suceeded.
 * - LE_BAD_PARAMETER    Invalid parameter provided.
 *
 * @b NOTE: The positioning distance values are: the altitude above sea level, the horizontal
 *       position accuracy and the vertical position accuracy. The API sets the same resolution to
 *       all distance values. The resolution change request takes effect immediately.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDistanceResolution
(
    Resolution resolution IN        ///< Resolution.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample's fix state.
 *
 * @return
 * - LE_FAULT         Failed to get the position sample's fix state.
 * - LE_OK            Suceeded.
 *
 * @b NOTE: If the caller passes an invalid position reference to this function,
 *       it is a fatal error and the function will not return.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetFixState
(
    Sample positionSampleRef,           ///< Position sample reference.
    taf_locGnss.FixState state OUT         ///< Position fix state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the position sample date.
 *
 * @return
 * - LE_FAULT         Failed to get the date.
 * - LE_OUT_OF_RANGE  The retrieved date is invalid.
 * - LE_OK            Suceeded.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetDate
(
    Sample positionSampleRef,    ///< Position sample reference.
    uint16 year OUT,             ///< UTC year
    uint16 month OUT,            ///< UTC month of the year; range is 1 to 12.
    uint16 day OUT               ///< UTC day of the month; range is 1 to 31.
);
