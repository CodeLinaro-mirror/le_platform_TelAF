maxThreads: 600

username: telaf

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_ADMIN
    CAP_BLOCK_SUSPEND
    CAP_DAC_OVERRIDE
#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
#endif
}

executables:
{
    tafMngdAudioSvc = ( $TELAF_ROOT/apps/tafMngdServices/Audio/Components/tafMngdAudioSvc )
}

start: manual

processes:
{
    run:
    {
        (tafMngdAudioSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart

}

requires:
{
    configTree:
    {
        [r] .
    }
}

sandboxed: false

extern:
{
    tafMngdAudioSvc.tafMngdAudioSvc.taf_mngd_audio
    tafMngdAudioSvc.tafMngdAudioSvc.taf_mngd_audioHw
}

bindings:
{
    tafMngdAudioSvc.tafMngdAudioSvc.taf_mngdPm -> tafMngdPMSvc.taf_mngdPm
}
