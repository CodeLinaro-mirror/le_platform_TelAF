maxThreads: 600

username: telaf

startGroup: 21

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
        tafNetSvc = ( $TELAF_ROOT/components/tafNetSvc/tafNetwork)
}
start: auto

processes:
{
        run:
        {
                (tafNetSvc)
        }

        maxFileBytes: 8192K
        faultAction: restart

}

bindings:
{
    tafNetSvc.tafNetwork.taf_dcs -> tafDataCallSvc.taf_dcs
    tafNetSvc.tafNetwork.taf_pm -> tafPMSvc.taf_pm

}
extern:
{
       tafNetSvc.tafNetwork.taf_net
}
