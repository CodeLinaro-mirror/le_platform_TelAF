provides:
{
    api:
    {
        $TELAF_ROOT/interfaces/taf_dcs.api
        $TELAF_ROOT/interfaces/taf_mdc.api
    }
}

requires:
{
    component:
    {
        $TELAF_PA_DEFAULT/component/taf_pa_dataDef
        // stub component only for build purpose
        $LEGATO_BUILD/stub/component/taf_pa_data
    }

    api:
    {
        taf_pm.api
    }
}

cxxflags:
{
    -I$TELAF_ROOT/include
    -I$TELAF_PA_DEFAULT/include
    -I$TELAF_PA_DEFAULT/include/data
    -std=c++17
}

sources:
{
    main.cpp
    tafDcsSvc.cpp
    tafDcsSvcImpl.cpp
    tafDcsProfileImpl.cpp
    tafDcsProfileManagerImpl.cpp
    tafDcsUtils.cpp
}
