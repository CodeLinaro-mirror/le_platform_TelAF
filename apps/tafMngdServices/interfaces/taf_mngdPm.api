/**
 * @page c_taf_mngdPm Managed Power Management Service
 *
 * @rst :ref:`API reference <File taf_mngdPm_interface.h>` @endrst
 *
 * @rst :ref:`HAL APIs <File tafHalPM.h>` @endrst
 *
 * <HR>
 *
 * The Managed Power Management service APIs help to manage power on the NAD/TCU.
 *
 * @section taf_mngdPm_binding IPC interfaces binding
 *
 *
 * The following example illustrates how to bind to the Managed Power Management service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_mngdPm -> tafMngdPMSvc.taf_mngdPm
   }
   @endverbatim
 *
 * @section taf_mngdPm Configuration
 *
 * Before starting the service, the user should place a JSON file named
 * tafMngdPMSvc.json into /data/ManagedServices directory. This JSON file contains the
 * configurations for bootup system awake time, whether PM HAL is enabled, timeout length
 * for hal responses.
 *
 * The default configuration file is available at
 * /legato/systems/current/appsWriteable/tafMngdPMSvc/tafMngdPMSvc.json
 *
 * @section taf_mngdPm_shutdown Shutdown the system forcefully
 *
 * TelAF Power Management Service's client calls taf_mngdPm_ShutdownReqAsync() to shut down the
 * system forcefully.
 * This function returns le_result_t and updates the results through callback function reference
 * provided in the function call. This API will collaborate with the PM VHAL.
 * @verbatim

    void ForcedSystemShutdownCallBack(taf_mngdPm_ShutdownMode_t mode,
        taf_mngdPm_ResponseMode_t ResponseMode, le_result_t result, void* contextPtr)
    {
        LE_INFO("ForcedSystemShutdownCallBack ");
    }

    void ForcedSystemShutdown()
    {
        le_result_t result = taf_mngdPm_ShutdownReqAsync(TAF_MNGDPM_SYSTEM_FORCEFUL_SHUTDOWN,
                ForcedSystemShutdownCallBack, NULL);

        if(result == LE_OK) {
            LE_INFO("Forcefull shutdown request sent successfully");
        }
    }

   @endverbatim
 *
 * @section taf_mngdPm_restart Restart the system forcefully
 *
 * TelAF Power Management Service's client calls taf_mngdPm_RestartReqAsync() to restart the
 * system forcefully.
 * This function returns le_result_t and updates the results through callback function reference
 * provided in the function call. This function also provides the ability to shut down the NAD on
 * receiving this restart request in case customer wants to wake up the NAD after power off. This
 * API will collaborate with the PM VHAL.
 * @verbatim

    void RestartCallback(taf_mngdPm_RestartMode_t mode, taf_mngdPm_ResponseMode_t rspmode,
            le_result_t result, void* contextPtr)
    {
        LE_INFO(" RestartCallback ");
    }

    void RestartSystem()
    {
        le_result_t res = taf_mngdPm_RestartReqAsync(TAF_MNGDPM_RESTART_SYSTEM_OFF_ON,
                RestartCallback, NULL);
        if(result == LE_OK) {
            LE_INFO("Forcefull restart request sent successfully");
        }
    }
   @endverbatim
 * @section taf_mngdPm_setTargetedMode Set the targeted power mode to the node
 *
 * TelAF Power Management Service's client calls taf_mngdPm_SetNodeTargetedPowerMode() to set the
 * power mode of the node.
 * This function returns le_result_t and sets the targeted power mode of the node requested once
 * all the wake sources are released. This API will collaborate with the PM VHAL.
 * @verbatim

    // To set the targeted power mode of NAD to SHUT DOWN.
    void SetTargetedPowerMode()
    {
        result = taf_mngdPm_SetNodeTargetedPowerMode(0,TAF_MNGDPM_SHUTDOWN);
        if(result == LE_OK)
            LE_INFO("taf_mngdPm_GracefulSysShutdownWakeLock triggered successfully");
    }
   @endverbatim
 *
 * @section taf_mngdPm_ModemWakesource Modem wake source configuration
 *
 * TelAF Managed Power Management Service's client calls taf_mngdPm_SetNodeModemWakeupSel() to
 * set the whitelisted modem wake sources within modem services of SMS, SIM and voice call.
 * By default, there's no whitelist control for modem wake sources from TelAF Managed Power
 * Management Service if there's no client calling the API.
 *
 * Supported modem wake sources control are defined with NodeModemWsBitMask:
 * -- SMS: Modem wake up due to incoming SMS.
 * -- VOICE_CALL: Modem wake up due to incoming voice call.
 * -- REMOTE_SIM_PROFILE_SWAP: Modem wake up due to remote SIM profile swap.
 *
 * taf_mngdPm_SetNodeModemWakeupSel() is used to query the configured whitelisted modem wake
 * sources by taf_mngdPm_SetNodeModemWakeupSel().
 *
 * When there is a NAD wakeup triggered due to the supported modem wake sources, the API of
 * taf_mngdPm_GetNodeModemAwakeReason() is used to query it. If there are clients registering
 * for the wake up event by taf_mngdPm_AddNodeModemAwakeHandler(),
 * the wake up event will be sent to the clients with node ID and wake up reason.
 *
 * @section taf_mngdPm_SetModemWakeupSource Configure the allowed Modem wakeup source type
 *
 * @b NOTE: This section is obsolete and will be removed soon.
 *
 * The API of taf_mngdPm_SetModemWakeupSource() is used to configure the allowed Modem wakeup
 * source type.
 * The input parameter is taken as the bitmap to set to the service.
 * The service takes the union of multiple API calls to set the allowed wakeup sources.
 * Bit 0 is for SMS, bit 1 is for incoming call, bit 2 is for MCU_VHAL.
 * @verbatim

    void SetModemWakeupSource()
    {
        le_result_t result = taf_mngdPm_SetModemWakeupSource(uint32_t wakeupSource);
        if(result == LE_OK)
            LE_INFO("taf_mngdPm_SetModemWakeupSource set successfully");
    }
   @endverbatim
 *
 * @section taf_mngdPm_CreateWakeupSource Acquire a wake source
 *
 * TelAF Managed Power Management Service's client calls taf_mngdPm_CreateWakeupSource() and
 * taf_mngdPm_StayAwake() to acquire a wake source to keep the system awake.
 * The reason parameter in taf_mngdPm_CreateWakeupSource() is authenticated based on the mask
 * given by
 * taf_mngdPm_AuthorizeStayAwakeReason() and passed to VHAL.
 * The authorized wake source keeps the system awake when taf_mngdPm_StayAwake() is called.
 * By default, all the stake awake reasons are authorized.
 * @verbatim

    void CreateWakeupSource()
    {
        const char* wsTag = "OEM_Normal";
        taf_mngdPm_wsRef_t ref = taf_mngdPm_CreateWakeupSource(
                       TAF_MNGDPM_STAY_AWAKE_REASON_NORMAL,
                       TAF_MNGDPM_WS_OPT_DEFAULT, wsTag
                       );
        if(ref != NULL)
            LE_INFO("taf_mngdPm_CreateWakeupSource created a wake source successfully");
    }
    void StayAwake()
    {
        le_result_t result = = taf_mngdPm_StayAwake(ref);
        if(result == LE_OK)
            LE_INFO("taf_mngdPm_StayAwake successfully acquire a wake source to keep the system awake");
    }
   @endverbatim
 *
 * @section taf_mngdPm_Relax Release an acquired wake source
 *
 * TelAF Managed Power Management Service's client calls taf_mngdPm_Relax() to request
 * MPMS to release the acquired wake lock.
 * This function returns le_result_t.
 * @verbatim
    void Relax()
    {
        le_result_t result = = taf_mngdPm_Relax(ref);
        if(result == LE_OK)
            LE_INFO("taf_mngdPm_Relax successfully released a acquired wake lock");
    }
   @endverbatim
 *
 * @section taf_mngdPm_WakeupVehicleReqAsync Wake up the vehicle
 *
 * TelAF Managed Power Management Service's client calls taf_mngdPm_WakeupVehicleReqAsync() to request
 * MPMS to wake up the vehicle.
 * This function returns le_result_t.
 * @verbatim
 void wakeupVehicleCB(taf_mngdPm_RestartMode_t mode, taf_mngdPm_ResponseMode_t rspmode,
            le_result_t result, void* contextPtr)
    {
        LE_INFO(" wakeupVehicleCB ");
    }

    void WakeupVehicleReqAsync()
    {
        le_result_t result = = taf_mngdPm_WakeupVehicleReqAsync(VEHICLE_WAKEUP_REASON_DEFAULT,
                 wakeupVehicleCB,NULL);
        if(result == LE_OK) {
            LE_INFO("WakeupVehicleReqAsync request sent successfully");
        }
    }
   @endverbatim
 *
 *<HR>
 *
 */
//--------------------------------------------------------------------------------------------------

/**
 * Maximum string length for the Virtual Machine name.
 */
DEFINE MACHINE_NAME_LEN = 32;

/*
 * ENUM for NADs.
 */
ENUM Nad{
    NAD1
};

/**
 * System power states.
 */
ENUM State
{
    STATE_UNKNOWN,                  ///< Power state is unknown.
    STATE_RESUME,                   ///< Power state is resume.
    STATE_SUSPEND,                  ///< Power state is suspend.
    STATE_SHUTDOWN,                 ///< Power state is shutdown.
    STATE_RESTART,                  ///< Power state is restart.
    STATE_RESTARTING,                ///< Power state is restarting.
    STATE_RELEASING_WAKE_SOURCE,    ///< Power state is releasing wake source.
    STATE_SUSPENDING,               ///< Power state is suspending.
    STATE_SHUTTING_DOWN,            ///< Power state is shutting down.
    STATE_WAKING_UP                 ///< Power state is waking up.
};

/**
 * Targeted power modes.
 */
ENUM TargetedPowerMode
{
    RESUME,            ///< Power mode is resume.
    SUSPEND,           ///< Power mode is suspend.
    SHUTDOWN           ///< Power mode is shutdown.
};

/**
 * Response mode for async requests.
 */
ENUM ResponseMode
{
    READY,           ///< The request is accepted.
    NOT_READY,       ///< The request is rejected.
    TIMEOUT,         ///< The request to get the response is timed out.
    INVALID_REQUEST  ///< The request sent is invalid.
};

/**
 * Forceful shutdown request mode.
 */
ENUM ShutdownMode
{
    SHUTDOWN_MODE_NORMAL     ///< System forceful shutdown.
};

/**
 * Wakeup type for system wakeup.
 */
ENUM WakeupType
{
    APP_STAYAWAKE,  ///< The wakeup type is to keep the system awake.
    SMS,            ///< The wakeup type is SMS for system wakeup.
    VOICE_CALL,     ///< The wakeup type is VOICE_CALL for system wakeup.
    MCU_VHAL        ///< The wakeup type is  MCU / VHAL for system wakeup.
};

/**
 * StayAwakeReason type for system wakeup.
 * Value range from 5 to 15 is for the platform future extension.
 * Value range from 16 to 31 is for Tier 1 product specific extension.
 */
ENUM StayAwakeReason
{
    STAY_AWAKE_REASON_NORMAL,             ///< StayAwake Reason normal.
    STAY_AWAKE_REASON_ECALL_ACTIVE,       ///< StayAwake Reason for ecall active.
    STAY_AWAKE_REASON_ECALL_CALLBACK,     ///< StayAwake Reason for ecall callback.
    STAY_AWAKE_REASON_SW_UPDATE,          ///< StayAwake Reason for software update.
    STAY_AWAKE_REASON_VEH_NETWORK,        ///< StayAwake Reason for vehicle network.

    STAY_AWAKE_REASON_VENDOR_1 = 16,      ///< Tier-1 product specific StayAwake Reason.
                                          ///< For handling bub state.
    STAY_AWAKE_REASON_VENDOR_2,           ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_3,           ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_4,           ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_5,           ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_6,           ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_7,           ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_8,           ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_9,           ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_10,          ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_11,          ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_12,          ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_13,          ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_14,          ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_15,          ///< Tier-1 product specific StayAwake Reason.
    STAY_AWAKE_REASON_VENDOR_16           ///< Tier-1 product specific StayAwake Reason.
};

/**
 * StayAwakeReason BitMask for system wakeup.
 * Value range from 5 to 15 is for the platform future extension.
 * Value range from 16 to 31 is for Tier 1 product specific extension.
 */
BITMASK StayAwakeReasonBitMask
{
    STAY_AWAKE_REASON_BIT_MASK_NORMAL,           ///< StayAwake Reason bit mask normal.
    STAY_AWAKE_REASON_BIT_MASK_ECALL_ACTIVE,     ///< StayAwake Reason bit mask for ecall active.
    STAY_AWAKE_REASON_BIT_MASK_ECALL_CALLBACK,   ///< StayAwake Reason bit mask for ecall callback.
    STAY_AWAKE_REASON_BIT_MASK_SW_UPDATE,        ///< StayAwake Reason bit mask for software update.
    STAY_AWAKE_REASON_BIT_MASK_VEH_NETWORK,      ///< StayAwake Reason bit mask for vehicle net.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_1 = 0x10000, ///< StayAwake Reason bit mask for vendor specific.
                                                 ///< For handling bub state.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_2,         ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_3,         ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_4,         ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_5,         ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_6,         ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_7,         ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_8,         ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_9,         ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_10,        ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_11,        ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_12,        ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_13,        ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_14,        ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_15,        ///< StayAwake Reason bit mask for vendor specific.
    STAY_AWAKE_REASON_BIT_MASK_VENDOR_16         ///< StayAwake Reason bit mask for vendor specific.
};

