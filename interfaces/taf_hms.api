//--------------------------------------------------------------------------------------------------
/**
 * Handler for change in modem event.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
HANDLER ModemEvtHandler
(
    ModemEvtType eventType   IN,             ///< Modem event
    ModemEvtSeverity eventSeverity IN,       ///< Modem event level
    ModemEvent eventRef                  ///< Modem status change event reference
);


//--------------------------------------------------------------------------------------------------
/**
 * Event to report the modem status change and relevant information.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
EVENT ModemEvt
(
    ModemEvtHandler handler    ///< Modem status handler.
);


///------------------------------------------------------------------------------------------------
/**
* Release modem event reference.
*
* @instaging
*
* @return
* - LE_FAULT         Failed.
* - LE_OK            Succeeded.
*/
//------------------------------------------------------------------------------------------------
FUNCTION le_result_t ReleaseModemEvt
(
    ModemEvent eventRef                  ///< Modem status change event reference
);

//--------------------------------------------------------------------------------------------------
/**
 * Maximum length of a reset specific information string, excluding any termination character.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_RESET_LEN   = 50;


//--------------------------------------------------------------------------------------------------
/**
 * Reset type enum
 */
//--------------------------------------------------------------------------------------------------
ENUM Reset
{
    RESET_UNKNOWN = 0,     ///< Unknown
    RESET_USER    = 1,     ///< User request
    RESET_HARD    = 2,     ///< Hardware switch
    RESET_UPDATE  = 3,     ///< Software update
    RESET_CRASH   = 4,     ///< Software crash
    RESET_WDOG    = 5,     ///< Watchdog bark
    RESET_POWER_DOWN  = 6,     ///< Power Down
    RESET_VOLT_CRIT   = 7,     ///< Power Down due to a critical voltage level
    RESET_TEMP_CRIT   = 8,     ///< Power Down due to a critical temperature level
    RESET_CORRUPTED   = 9,     ///< Image or binary was corrupted
    RESET_AUTH_FAILED = 10,    ///< Image or binary was authentication failed
    RESET_ADMIN_TRIGGER = 11   ///< Reserved for sub-reason
};

//--------------------------------------------------------------------------------------------------
/**
 * Get the last reset information reason
 *
 * @instaging
 *
 * @return
 *      - LE_OK          on success
 *      - LE_UNSUPPORTED if it is not supported by the platform
 *        LE_OVERFLOW    specific reset information length exceeds the maximum length.
 *      - LE_FAULT       for any other errors
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetResetInformation
(
    Reset reset OUT,                                ///< Reset information
    string resetSpecificInfoStr[MAX_RESET_LEN] OUT  ///< Reset specific information
);
