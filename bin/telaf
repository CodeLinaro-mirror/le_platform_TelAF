#!/usr/bin/env sh

# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
# SPDX-License-Identifier: BSD-3-Clause-Clear

# system/bin and /sbin should be in the path.
# Search for the installed TelAF system bin first.
export PATH=/legato/systems/current/bin:/mnt/legato/system/bin:/sbin:$PATH

TELAF_INSTALLED_VERSION=/legato/systems/current/version

TelafPrintUsage()
{
    echo "NAME"
    echo "  TelAF -> TelAF tool to be used to control the TelAF Application Framework."
    echo "OVERVIEW"
    echo "  telaf [start|stop|restart|status|version|storage|security|help]"
    echo "HELP MENU"
    echo "  telaf start"
    echo "    :Starts the TelAF Application Framework."
    echo "  telaf stop"
    echo "    :Stops the TelAF Application Framework."
    echo "  telaf restart"
    echo "    :Restarts the TelAF Application Framework."
    echo "  telaf status"
    echo "    :Displays the current running state."
    echo "  telaf version"
    echo "    :Displays the currently installed TelAF version."
    echo "  telaf help"
    echo "    :Displays TelAF usage help."
    echo "  telaf storage"
    echo "    :Shows type and the disk/flash usage of telaf."
    echo "  telaf memory"
    echo "    :Shows the memory usage of the telaf."
    echo "  telaf security"
    echo "    :Shows the list of telaf selinux modules."
}

IsSystemInstalled()
{
    if [ -e "${TELAF_INSTALLED_VERSION}" ]
    then
        return 0
    else
        return 1
    fi
}

# Get the last component after the final "/" in the cgroup v2 (hierarchy 0) path.
# PVM supervisor: 0::/system.slice/telaf.service -> "telaf.service"
GetCgroupV2Suffix()
{
    grep "^0::" /proc/$1/cgroup 2>/dev/null | sed 's|.*/||'
}

IsFrameworkRunning()
{
    local version=$(cat ${TELAF_INSTALLED_VERSION} | sed 's/_modified$//')
    local comm
    local pid

    # Only the supervisor needs looking at, so pick the candidates out by
    # reading /proc/<pid>/comm with the shell, which costs no child process,
    # and confirm the installed version on the few that remain.
    for commfile in /proc/[0-9]*/comm
    do
        read -r comm < "$commfile" 2>/dev/null || continue
        [ "$comm" = "supervisor" ] || continue

        pid=${commfile#/proc/}
        pid=${pid%/comm}

        # Match the version against the raw cmdline instead of 'ps' output: the
        # PID column differs between busybox and procps, and busybox truncates
        # long command lines to the terminal width, which cuts the version
        # string short.
        grep -q "$version" /proc/$pid/cmdline 2>/dev/null || continue

        if [ -n "${TELAF_IN_CONTAINER}" ]
        then
            # Inside the LXC container and inside the simulation container /proc
            # only lists our own PID namespace, so any match belongs to us. No
            # cgroup filtering is needed, and there is no single suffix to pin:
            # LXC reports 0::/ when the framework was started by the container
            # init and 0::/.lxc when it was started from an lxc-attach session,
            # whose cgroup the supervisor inherits, and the simulation container
            # reports 0::/__cgroot__.
            return 0
        fi

        # On PVM /proc also lists the LXC payload processes, which are not the
        # framework running here. Requiring the telaf.service cgroup keeps them
        # out.
        if [ "$(GetCgroupV2Suffix $pid)" = "telaf.service" ]
        then
            return 0
        fi
    done

    return 1
}

TelafStatus()
{
    if ! IsSystemInstalled
    then
        echo "TelAF systems are not installed"
        exit 1
    fi

    echo "TelAF Systems were installed"
    echo -n "TelAF framework is "
    if IsFrameworkRunning
    then
        echo "running"
        exit 0
    else
        echo "not running"
        exit 1
    fi
}
StartTelafService()
{
    if ! IsSystemInstalled
    then
        echo "TelAF systems are not installed"
        return 1
    fi

    # If TelAF is already running.
    if IsFrameworkRunning
    then
        echo "The TelAF Supervisor is already running"
        return 0
    fi

    echo "Starting TelAF service..."

    if [ -n "${TELAF_IN_CONTAINER}" ]; then
        # In LXC & Docker containers, don't use systemd
        /mnt/legato/start
    else
        systemctl start telaf
    fi
    if [ $? -ne 0 ] ; then
        echo "Start TelAF service failed"
        return 1
    fi

    echo "TelAF service is started"
    return 0
}

StartTelafAppGroup()
{
    if [ -n "${TELAF_IN_CONTAINER}" ]; then
        # In LXC & Docker containers, don't use systemd
        /legato/systems/current/bin/app startGroup
    else
        systemctl stop  telaf.app
        systemctl start telaf.app
    fi
    if [ $? -ne 0 ] ; then
        echo "Start TelAF App group failed"
        return 1
    fi

    echo "Start TelAF APP group successfully"
    return 0
}

StopTelafAppGroup()
{
    if [ -n "${TELAF_IN_CONTAINER}" ]; then
        # In LXC & Docker containers, don't use systemd
        /legato/systems/current/bin/app stopGroup
    else
        systemctl stop telaf.app
    fi
    if [ $? -ne 0 ] ; then
        echo "Stop TelAF App group failed"
        return 1
    fi

    echo "Stop TelAF APP group successfully"
    return 0
}

StartTelaf()
{
    StartTelafService
    if [ $? -ne 0 ] ; then
        exit 1
    fi

    StartTelafAppGroup
    if [ $? -ne 0 ] ; then
        exit 1
    fi

    echo "TelAF is started"
}

StopTelaf()
{
    if ! IsSystemInstalled
    then
        echo "TelAF systems are not installed"
        exit 1
    fi

    if IsFrameworkRunning
    then
        # StopTelafTimeout will be scaled according to the number of running TelAF services.
        # Estimation of 5 seconds for the TelAF framework itself, and 3 seconds per TelAF service to
        # shutdown.
        StopTelafTimeout=$(( 5 + $(app status | grep running | wc -l) * 3 ))

        echo -n "Stopping TelAF "

        # Direct the Supervisor to shutdown TelAF.
        app "stopLegato" 2> /dev/null &

        # wait for TelAF supervisor to shutdown
        telafcountDown=$StopTelafTimeout
        while [ $telafcountDown -ne 0 ]
        do
            if IsFrameworkRunning
            then
                echo -n "."
                sleep 1
            else
                break
            fi
            telafcountDown=`expr $telafcountDown - 1`
        done
        echo

        # If TelAF is still running
        if IsFrameworkRunning
        then
            echo "TelAF may still be alive after an attempt of hard-kill, rebooting the system"
            reboot
        fi
    else
        echo "TelAF wasn't running"
        return
    fi

    echo "TelAF is stopped"
}

RestartTelaf()
{
    if ! IsSystemInstalled
    then
        echo "TelAF systems are not installed"
        exit 1
    fi

    if IsFrameworkRunning
    then
        echo "Restarting TelAF ..."

        # Direct the Supervisor to restart TelAF.
        app "restartLegato" 2> /dev/null

    else
        StopTelaf
        StartTelaf
    fi
}

TelafStorage()
{
    UBI_DVE_NUMBER=`ubinfo -a | grep telaf_a -wB 5 \
                              | grep "Volume ID" | awk -F '[()]' '{print $2}' | grep -o '[0-9]'`
    if [ ! "x$UBI_DVE_NUMBER" = x ]; then
        echo ""
        ubinfo -d $UBI_DVE_NUMBER -N telaf_a | grep -E "Volume|Size|Name"
    fi

    UBI_DVE_NUMBER=`ubinfo -a | grep telaf_b -wB 5 \
                              | grep "Volume ID" | awk -F '[()]' '{print $2}' | grep -o '[0-9]'`
    if [ ! "x$UBI_DVE_NUMBER" = x ]; then
        echo ""
        ubinfo -d $UBI_DVE_NUMBER -N telaf_b | grep -E "Volume|Size|Name"
    fi

    UBI_DVE_NUMBER=`ubinfo -a | grep telaf_app -wB 5 \
                              | grep "Volume ID" | awk -F '[()]' '{print $2}' | grep -o '[0-9]'`
    if [ ! "x$UBI_DVE_NUMBER" = x ]; then
        echo ""
        ubinfo -d $UBI_DVE_NUMBER -N telaf_app | grep -E "Volume|Size|Name"
    fi

    echo ""
    df -h | head -n 1
    df -h | grep -w "/mnt/legato"
}

TelafMemory()
{
    echo "TelAF memory -> to be implemented"
}

TelafSecurity()
{
    echo "TelAF SELinux modules list :"
    semodule -l | grep taf | grep -v staff
}

TelafVersion()
{
    if [ -f $TELAF_INSTALLED_VERSION ]
    then
        cat $TELAF_INSTALLED_VERSION
    else
        echo "Unknown VERSION"
        exit 1
    fi
}

TELAF_ACTION=$1

case "$TELAF_ACTION" in
    start)
        StartTelaf
        ;;

    stop)
        StopTelaf
        ;;

    restart)
        RestartTelaf
        ;;

    status)
        TelafStatus
        ;;

    storage)
        TelafStorage
        ;;

    memory)
        TelafMemory
        ;;

    security)
        TelafSecurity
        ;;

    help|--help|-h)
        TelafPrintUsage
        ;;

    version|--version|-v)
        TelafVersion
        ;;

    *)
        TelafPrintUsage
        exit 1
        ;;
esac

exit 0
