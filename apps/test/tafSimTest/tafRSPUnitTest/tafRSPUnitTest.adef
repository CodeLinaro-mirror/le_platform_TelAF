maxThreads: 600
sandboxed: false
executables:
{
    tafRSPUnitTest = ( tafRSPTestComp )
}


processes:
{
    run:
    {
        (tafRSPUnitTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafRSPUnitTest.tafRSPTestComp.taf_simRsp -> tafSimCardSvc.taf_simRsp
}

