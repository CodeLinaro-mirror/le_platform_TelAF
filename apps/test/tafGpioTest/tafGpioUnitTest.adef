maxThreads: 600
sandboxed: false

executables:
{
    tafGpioUnitTest = ( tafGpioUnitTest )
}

start: manual

processes:
{
    run:
    {
        (tafGpioUnitTest)
    }

    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }

    faultAction: stopApp
}

bindings:
{
    tafGpioUnitTest.tafGpioUnitTest.taf_gpio -> tafGpioSvc.taf_gpio
}
