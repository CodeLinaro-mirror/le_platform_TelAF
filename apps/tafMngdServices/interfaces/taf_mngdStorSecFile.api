//--------------------------------------------------------------------------------------------------
/**
 * @page c_taf_mngdStorSecFile Managed Secured File Storage Service
 *
 * @rst :ref:`API reference <File taf_mngdStorSecFile_interface.h>` @endrst
 *
 * <HR>
 *
 * The Managed Storage service provides applications the APIs to use encrypted and reliable
 * storages.
 *
 * @section taf_mngdStorageSvc_binding IPC interfaces binding
 *
 * The following example illustrates how to bind to the secure file storage interface.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_mngdStorSecFile -> tafMngdStorageSvc.taf_mngdStorSecFile
   }
   @endverbatim
 *
 * @section taf_mngdStorSecFile Configuration
 *
 * The service configuration file will be bundled when building the service. The path of default
 * file in the project is apps/tafMngdServices/Storage/Components/config/tafMngdStorageConfig.json.
 * The client can also provide its own service configuration file at the extension path mentioned
 * in default service json. Then service will be initialized with that service json.
 *
 * @b NOTE: It is advised to provide absolute paths in service configuration json.
 *
 * @section taf_mngdStorSecFile Create secure file storage
 *
 * The client is allocated the secure storage when it connects to the service. When it calls
 * taf_mngdStorSecFile_CreateStorage() to create a storage item, the client uses the storage to create,
 * read, and write its own data. This function returns the storage reference when the client creates
 * a secure storage item with a storage name.
 *
 * @code

    le_result_t result = taf_mngdStorSecFile_CreateStorage("StorageName");

    if (result == LE_OK)
    {
        taf_mngdStorSecFile_StorageRef_t storageRef = taf_mngdStorSecFile_GetStorageRef("StorageName");

        // Use storage reference to manipulate the secure folder or file operations
    }

 * @endcode
 *
 * @section taf_mngdStorSecFile Manage secure file storage
 *
 * The client can unlock the storage by calling taf_mngdStorSecFile_UnlockStorage(). This function
 * sends a request to unlock the specified storage. After unlocking, the client can access files in
 * the storage.
 *
 * The client can lock the storage by calling taf_mngdStorSecFile_LockStorage(). This function sends
 * a request to lock the specified storage. After locking, the files under the storage will be encrypted
 * and cannot be accessed.
 *
 * @code

    le_result_t result = taf_mngdStorSecFile_UnlockStorage(storageRef);
    if (result == LE_OK)
    {
        // Storage unlocked successfully

        // File operations

        // Lock the storage if no need to access the file
        result = taf_mngdStorSecFile_LockStorage(storageRef);
    }
    else
    {
        // Handle error
    }

 * @endcode
 *
 * Optionally, the client calls the following interfaces to manage the storage. With these interfaces,
 * storage locking and unlocking will be taken care by Managed Storage Service automatically.
 *
 * The following storage APIs are supported for file operations with reliability:
 * - taf_mngdStorSecFile_ImportFile() -- Imports a file to the storage.
 * - taf_mngdStorSecFile_ReadFile() -- Reads a file from the storage.
 * - taf_mngdStorSecFile_DeleteFile() -- Deletes a file and its backup from the storage.
 *
 * The following storage API is used to get the base path of the storage:
 * - taf_mngdStorSecFile_GetBasePath() -- Gets the base path of the storage.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------


USETYPES taf_fsc.api;
USETYPES le_limit.api;

/**
 * Maximum number of characters and bytes for a secure file storage name.
 */
DEFINE MAX_STORAGE_NAME_SIZE = taf_fsc.MAX_STORAGE_NAME_SIZE;

/**
 * Maximum number of bytes for each data chunk in secure file storage reading.
 */
DEFINE MAX_DATA_CHUNK_SIZE = 8192;

/**
 * Secure file storage reference.
 */
REFERENCE Storage;

/**
 * Secure file storage managed capability mask.
 */
BITMASK ManagedCapMask
{
    CAP_RELIABILITY,    ///< file reliability.
};

//--------------------------------------------------------------------------------------------------
/**
 * Creates a file storage name with empty FSCrypt folder and returns the reference to the storage name
 * and the managed capability. The storage name shall follow POSIX portable folder name convention.
 *
 * The created data will be owned by the calling app.
 *
 * @instaging
 * @return
 *     - LE_OK             Sent request successfully.
 *     - LE_BAD_PARAMETER  The storage name is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CreateStorage
(
    string storageName[MAX_STORAGE_NAME_SIZE]  IN,   ///< Storage name.
    ManagedCapMask ManagedCapMask              IN    ///< Managed capability.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the storage reference for the storage name. The storage name shall follow POSIX folder file name
 * convention.
 *
 * @instaging
 * @return
 *     - Storage    New storage reference.
 *     - NULL       Invalid storage name, or the storage name does not exist.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Storage GetStorageRef
(
    string storageName[MAX_STORAGE_NAME_SIZE]  IN   ///< Storage name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends the request to unlock the storage.
 *
 * @instaging
 * @return
 *     - LE_OK             Sent request successfully.
 *     - LE_BAD_PARAMETER  The storage reference is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t UnlockStorage
(
    Storage storageRef IN   ///< Storage reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sends the request to lock the storage.
 *
 * @instaging
 * @return
 *     - LE_OK             Sent request successfully.
 *     - LE_BAD_PARAMETER  The storage reference is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t LockStorage
(
    Storage storageRef IN   ///< Storage reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Imports the source file to the storage.
 *
 * @instaging
 * @return
 *     - LE_OK             Imported successfully.
 *     - LE_BAD_PARAMETER  The source file path or the target file patch is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ImportFile
(
    Storage storageRef                           IN,   ///< Storage reference.
    string sourceFilePath[le_limit.MAX_PATH_LEN] IN,   ///< Source file to be copied to the file
                                                       ///< storage.
    string targetFilePath[le_limit.MAX_PATH_LEN] IN    ///< Target file path is the relative path
                                                       ///< to the file storage reference
);

//--------------------------------------------------------------------------------------------------
/**
 * Reads the file from the storage. The read data size is limited by the MAX_DATA_CHUNK_SIZE.
 *
 * @instaging
 * @return
 *     - LE_OK             Sent request successfully.
 *     - LE_BAD_PARAMETER  The file path is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ReadFile
(
    Storage storageRef                     IN,   ///< Storage reference.
    string filePath[le_limit.MAX_PATH_LEN] IN,   ///< File path is the relative path to the file
                                                 ///< storage reference
    uint8 bufPtr[MAX_DATA_CHUNK_SIZE]      OUT   ///< Output buffer.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the file from the storage.
 *
 * @instaging
 * @return
 *     - LE_OK             Sent request successfully.
 *     - LE_BAD_PARAMETER  The file path is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteFile
(
    Storage storageRef                     IN,   ///< Storage reference.
    string filePath[le_limit.MAX_PATH_LEN] IN    ///< File path is the relative path to the file
                                                 ///< storage reference
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the file storage base path.
 *
 * @instaging
 * @return
 *     - LE_OK             Sent request successfully.
 *     - LE_BAD_PARAMETER  The given storage reference is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetBasePath
(
    Storage storageRef                     IN,   ///< Storage reference.
    string basePath[le_limit.MAX_PATH_LEN] OUT   ///< Storage base path to the file storage reference
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the file storage. The storage needs to be cleaned up before deletion.
 *
 * @instaging
 * @return
 *     - LE_OK             Sent request successfully.
 *     - LE_BAD_PARAMETER  The given storage reference is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteStorage
(
    Storage storageRef                     IN  ///< Storage reference.
);
