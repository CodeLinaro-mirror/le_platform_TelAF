//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafpos Positioning
 *
 * @ref taf_pos_interface.h "API Reference" <br>
 *
 * <HR>
 *
 * This API provides access to the device's physical position and movement information.
 *
 * @note    Enabling and disabling the positioning system can be performed
 *          only through the @ref c_tafposCtrl.
 *
 * @section taf_pos_binding IPC interfaces binding
 *
 * All the functions of this API are provided by the @b tafLocationSvc application service.
 *
 * Here's a code sample binding to Positioning services:
 * @verbatim
   bindings:
   {
      clientExe.clientComponent.taf_pos -> positioningService.taf_pos
   }
   @endverbatim
 *
 * The @c taf_pos_Get2DLocation() function gets the last updated latitude, longitude
 * and the horizontal accuracy values:
 *
 * - latitude is in degrees, positive North.
 * - longitude is in degrees, positive East.
 * - horizontal accuracy is in meters by default
 * @verbatim
   int32_t latitude;
   int32_t longitude;
   int32_t hAccuracy;
   if (taf_pos_Get2DLocation(&latitude, &longitude, &hAccuracy) == LE_OK)
   {
     // Process after succesfully getting the 2 dimension location information.
   }
   @endverbatim
 *
 * e.g:The latitude and longitude are given in degrees with 6 decimal places like
 * - Latitude +48858300  = 48.858300 degrees North
 * - Longitude +2294400  =  2.294400 degrees East
 *
 * The @c taf_pos_Get3DLocation() function gets the last updated latitude, longitude,
 * altitude and their associated accuracy values.
 * - altitude is in meters by default, above Mean Sea Level, with 3 decimal places
 * (3047 = 3.047 meters).
 * - horizontal and vertical accuracies are in meters by default.
 * @verbatim
   int32_t latitude;
   int32_t longitude;
   int32_t hAccuracy;
   int32_t altitude;
   int32_t vAccuracy;
   if (taf_pos_Get3DLocation(&latitude, &longitude, &hAccuracy,&altitude, &vAccuracy) == LE_OK)
   {
     // Process after succesfully getting the 3 dimensional location information.
   }
   @endverbatim
 *
 * The @c taf_pos_GetTime() function gets the time of last updated position:
 * - Hours into the day [range 0..23].
 * - Minutes into the hour [range 0..59].
 * - Seconds into the minute [range 0..59].
 * - Milliseconds into the second [range 0..999].
 * @verbatim
   uint16_t hrsPtr;
   uint16_t minPtr;
   uint16_t secPtr;
   uint16_t msecondsPtr;
   if (taf_pos_GetTime(&hrsPtr, &minPtr, &secPtr,&msecondsPtr) == LE_OK)
   {
     // Process after succesfully getting the time information.
   }
   @endverbatim
 *
 * The @c taf_pos_GetDate() function gets the date of last updated position:
 * - Year A.D. [e.g. 2014].
 * - Month into the year [range 1...12].
 * - Days into the month [range 1...31].
 * @verbatim
   uint16_t yearPtr;
   uint16_t monthPtr;
   uint16_t dayPtr;
   if (taf_pos_GetDate(&yearPtr, &monthPtr, &dayPtr) == LE_OK)
   {
     // Process after succesfully getting the date information.
   }
   @endverbatim
 *
 * The @c taf_pos_GetHeading() function gets the last updated heading value in degrees and
 * its associated accuracy value:
 *  - Heading in degrees, ranges from 0 to 359, 0 being True North.
 * Heading is the direction that the vehicle or person is facing.
 * @verbatim
   uint32_t heading;
   uint32_t headingAccuracy;
   if (taf_pos_GetHeading(&heading, &headingAccuracy) == LE_OK)
   {
     // Process after succesfully getting the heading information.
   }
   @endverbatim
 *
 * The @c taf_pos_GetDirection() function gets the last updated direction value in degrees and
 * its associated accuracy value:
 *  - Direction in degrees, ranges from 0 to 359, 0 being True North.
 * Direction of movement is the direction that the vehicle or person is actually moving.
 * @verbatim
   uint32_t direction;
   uint32_t directionAccuracy;
   if (taf_pos_GetDirection(&direction, &directionAccuracy) == LE_OK)
   {
     // Process after succesfully getting the direction information.
   }
   @endverbatim
 *
 * The @c taf_pos_GetFixState() function gets the position fix state. The fix state allows the user
 * to determine if it is a 2-Dimensional or a 3-Dimensional position fix.
 * @verbatim
   taf_pos_FixState_t fixState;
   if(taf_pos_GetFixState(&fixState)== LE_OK)
   {
     // Process after succesfully getting the fix state.
   }
   @endverbatim
 *
 * The @c taf_pos_SetDistanceResolution() function sets the resolution for the positioning distance
 * values.
 * @verbatim
   if(taf_pos_SetDistanceResolution(RES_DECIMETER) == LE_OK))
   {
     // Process after succesfully setting the distance resolution.
   }
   @endverbatim
 *
 * To be notified when the device is in motion, you must register an handler function
 * to get the new position's data. The @c taf_pos_AddMovementHandler() API registers
 * that handler. The horizontal and vertical change is measured in meters so only movement over
 * the threshhold will trigger notification (0 means we don't care about changes).
 * @verbatim
    static void NavigationHandler
    (
       taf_pos_SampleRef_t positionSampleRef,
       void* contextPtr
    )
    {
      int32_t latitude, longitude, horizontalAccuracy;
      LE_ASSERT_OK(taf_pos_sample_Get2DLocation(positionSampleRef, &latitude,
                                             &longitude, &horizontalAccuracy));
      taf_pos_sample_Release(positionSampleRef);
    }
    static taf_pos_MovementHandlerRef_t  navigationHandlerRef;
    navigationHandlerRef = taf_pos_AddMovementHandler(0, 0, NavigationHandler, NULL);
    LE_ASSERT(NULL != navigationHandlerRef);
    taf_pos_RemoveMovementHandler(navigationHandlerRef);
   @endverbatim
 *
 * The handler will give a reference to the position sample object that has triggered the
 * notification. You can then access parameters using accessor functions, and release
 * the object when done with it.
 *
 * The accessor functions are:
 * - taf_pos_sample_Get2DLocation()
 * The API is triggered inside NavigationHandler() function to get positionSampleRef.
 * @verbatim
   int32_t  longi, lat, haccuracy;
   if(taf_pos_sample_Get2DLocation(positionSampleRef, &longi, &lat, &haccuracy) == LE_OK)
   {
     // Process after succesfully getting the 2 dimensional location information.
   }
   @endverbatim
 * - taf_pos_sample_GetTime()
 * The API is triggered inside NavigationHandler() function to get positionSampleRef.
 * @verbatim
   int32_t  hours, min, sec;
   if(taf_pos_sample_GetTime(positionSampleRef, &hours, &min, &sec) == LE_OK)
   {
     // Process after succesfully getting the time information.
   }
   @endverbatim
 * - taf_pos_sample_GetDate()
 * The API is triggered inside NavigationHandler() function to get positionSampleRef.
 * @verbatim
   int32_t  year, month, day;
   if(taf_pos_sample_GetDate(positionSampleRef, &year, &month, &day) == LE_OK)
   {
     // Process after succesfully getting the time information.
   }
   @endverbatim
 * - taf_pos_sample_GetAltitude()
 * The API is triggered inside NavigationHandler() function to get positionSampleRef.
 * @verbatim
   int32_t  altitude,altitudeAccuracy,
   if(taf_pos_sample_GetAltitude(positionSampleRef, &altitude, &altitudeAccuracy) == LE_OK)
   {
     // Process after succesfully getting the altitude information.
   }
   @endverbatim
 * - taf_pos_sample_GetHorizontalSpeed()
 * The API is triggered inside NavigationHandler() function to get positionSampleRef.
 * @verbatim
   int32_t  hSpeed,hSpeedAccuracy,
   if(taf_pos_sample_GetHorizontalSpeed(positionSampleRef, &hSpeed, &hSpeedAccuracy) == LE_OK)
   {
     // Process after succesfully getting the horizontal speed information.
   }
   @endverbatim
 * - taf_pos_sample_GetVerticalSpeed()
 * The API is triggered inside NavigationHandler() function to get positionSampleRef.
 * @verbatim
   int32_t  vSpeed,vSpeedAccuracy,
   if(taf_pos_sample_GetVerticalSpeed(positionSampleRef, &vSpeed, &vSpeedAccuracy) == LE_OK)
   {
     // Process after succesfully getting the vertifical speed information.
   }
   @endverbatim
 * - taf_pos_sample_GetDirection()
 * The API is triggered inside NavigationHandler() function to get positionSampleRef.
 * @verbatim
   int32_t  direction,directionAccuracy,
   if(taf_pos_sample_GetDirection(positionSampleRef, &direction, &directionAccuracy) == LE_OK)
   {
     // Process after succesfully getting the direction information.
   }
   @endverbatim
 * - taf_pos_sample_GetFixState()
 * @verbatim
   taf_pos_FixState_t fixState;
   if(taf_pos_sample_GetFixState(&fixState)== LE_OK)
   {
     // Process after succesfully getting the fix state.
   }
   @endverbatim
 *
 * @c taf_pos_sample_Release() releases the object.
 *
 * You can remove the handler function by calling the taf_pos_RemoveMovementHandler() API.
 * @note The taf_pos_RemoveMovementHandler() API does not delete the Position Object. The caller has
 *       to delete it by calling the taf_pos_sample_Release() function.
 *
 *@section taf_pos_acquisitionRate Positioning acquisition rate
 *
 * The acquisition rate value can be set or get with taf_pos_SetAcquisitionRate() and
 * taf_pos_GetAcquisitionRate().
 * It is also set when calling taf_pos_AddMovementHandler(). The acquisition rate is calculated
 * from the horizontal and vertical magnitude parameters set in this function.
 * This calculated acquisition rate can be retrieved by calling taf_pos_GetAcquisitionRate().
 * @verbatim
   if(taf_pos_SetAcquisitionRate(3000) == LE_OK)
   {
     // Process after succesfully setting the acquisition rate.
   }
   @endverbatim
 * @verbatim
   uint32_t acquisitionRate=0;
   if(taf_pos_GetAcquisitionRate(&fixState)== LE_OK)
   {
     // Process after succesfully getting the acquisition rate.
   }
   @endverbatim
 * @note
 * The acquisition rate set will take effect once a request of activation of the positioning service
 * by taf_posCtrl_Request() is done.
 * @note
 * If the acquisition rate was not previously configured, it will be set to a default value
 * of one second once taf_posCtrl_Request() is called.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
 *  Reference type for dealing with Position samples.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Sample;

//--------------------------------------------------------------------------------------------------
USETYPES taf_gnss.api;

DEFINE TAF_POS_MAX_OBJ = 1;

//--------------------------------------------------------------------------------------------------

/**
 * Handler for movement changes that returns the reference of a reported position sample.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER MovementHandler
(
 Sample positionSampleRef ///< [OUT] Reference of the reported position sample.
);

//--------------------------------------------------------------------------------------------------
/**
 * This event provides information on movement changes.
 *
 */
//--------------------------------------------------------------------------------------------------
EVENT Movement
(
 uint32 horizontalMagnitude IN, ///< Horizontal magnitude in meters.
 uint32 verticalMagnitude IN,   ///< Vertical magnitude in meters.
 MovementHandler handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the 2D location's data (Latitude, Longitude, Horizontal
 * accuracy).
 *
 * @return LE_FAULT         On failure in getting the 2D location's data
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid.
 * @return LE_OK            On Success.
 *
 * @note latitudePtr, longitudePtr, hAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Get2DLocation
(
 int32 latitude OUT,     ///< WGS84 Latitude in degrees.
 int32 longitude OUT,    ///< WGS84 Longitude in degrees.
 int32 hAccuracy OUT     ///< Horizontal accuracy in meters by default.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the date of the last updated location
 *
 * @return LE_FAULT         On failure in getting the date.
 * @return LE_OUT_OF_RANGE  The retrieved date is invalid.
 * @return LE_OK            On Success.
 *
 * @note Currently the API implementation is in progress.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDate
(
 uint16 year OUT,             ///< UTC Year A.D. [e.g. 2014].
 uint16 month OUT,            ///< UTC Month into the year [range 1 to 12].
 uint16 day OUT               ///< UTC Days into the month [range 1 to 31].
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position fix state
 *
 * @return LE_FAULT         On failure in getting the position fix state.
 * @return LE_OK            On Success.
 *
 * @note In case the function fails to get the position fix state, a fatal error occurs,
 *       the function will not return.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetFixState
(
 taf_gnss.FixState state OUT              ///< Position fix state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's heading. Heading is the direction that the vehicle or person is facing.
 *
 * @return LE_FAULT         On failure in getting the heading indication.
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid (set to UINT32_MAX).
 * @return LE_OK            On Success.
 *
 * @note Heading is given in degrees.
 *       Heading ranges from 0 to 359 degrees, where 0 is True North.
 *
 * @note headingPtr, headingAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetHeading
(
 uint32 heading OUT,          ///< Heading in degrees.
 uint32 headingAccuracy OUT   ///< Heading's accuracy in degrees.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the motion's data (Horizontal Speed, Horizontal Speed's
 * accuracy, Vertical Speed, Vertical Speed's accuracy).
 *
 * @return LE_FAULT         On failure in getting the motion's data.
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid (set to INT32_MAX,
 *                          UINT32_MAX).
 * @return LE_OK            On Success.
 *
 * @note hSpeedPtr, hSpeedAccuracyPtr, vSpeedPtr, vSpeedAccuracyPtr can be set to NULL if not
 *       needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMotion
(
 uint32 hSpeed OUT,           ///< Horizontal Speed in m/sec.
 uint32 hSpeedAccuracy OUT,   ///< Horizontal Speed's accuracy in m/sec.
 int32 vSpeed OUT,            ///< Vertical Speed in m/sec.
 int32 vSpeedAccuracy OUT     ///< Vertical Speed's accuracy in m/sec.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's direction. Direction of movement is the direction that the vehicle or
 * person is actually moving.
 *
 * @return LE_FAULT         On Failure in getting the direction indication.
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid
 * @return LE_OK            On Success
 *
 * @note Direction is given in degrees.
 *       Direction ranges from 0 to 359 degrees, where 0 is True North degree.
 *
 * @note directionPtr, directionAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDirection
(
 uint32 direction OUT,           ///< Direction indication in degrees[0 to 359].
 uint32 directionAccuracy OUT    ///< Direction's accuracy estimation in degrees.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's time.
 *
 * @return LE_FAULT         On Failure in getting the time.
 * @return LE_OUT_OF_RANGE  The retrieved time is invalid.
 * @return LE_OK            On Success.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTime
(
 uint16 hours OUT,            ///< UTC Hours of the day [range 0 to 23].
 uint16 minutes OUT,          ///< UTC Minutes of the hour [range 0 to 59]
 uint16 seconds OUT,          ///< UTC Seconds of the minute [range 0 to 59]
 uint16 milliseconds OUT      ///< UTC Milliseconds of the second [range 0 to 999].
);

//--------------------------------------------------------------------------------------------------
/**
 * Set the acquisition rate.
 *
 * @return
 *    LE_OUT_OF_RANGE    acquisition rate is invalid.
 *    LE_OK              On success.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAcquisitionRate
(
 uint32  acquisitionRate IN  ///< Acquisition Rate in milliseconds.
);

//--------------------------------------------------------------------------------------------------
/**
 * Retrieve the acquisition rate in milliseconds.
 *
 * @return
 *    Acquisition Rate in milliseconds.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION uint32 GetAcquisitionRate
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Release the position sample.
 *
 * @note If the caller is passing an invalid Position reference into this function,
 *       it is a fatal error, the function will not return.
 */
//--------------------------------------------------------------------------------------------------

FUNCTION sample_Release
(
 Sample positionSampleRef            ///< Position sample reference.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Resolution values.
*/
ENUM Resolution
{
    RES_METER,                     ///< Meter Resolution.
    RES_DECIMETER,                 ///< Decimeter Resolution.
    RES_CENTIMETER,                ///< Centimeter Resolution.
    RES_MILLIMETER,                ///< Millimeter Resolution
    RES_UNKNOWN                    ///< Unknown Resolution.
};

//--------------------------------------------------------------------------------------------------
/**
 * Get the 3D location's data (Latitude, Longitude, Altitude,
 * Horizontal accuracy, Vertical accuracy)
 *
 * @return LE_FAULT         On failure in getting the 3D location's data
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid
 * @return LE_OK            On Success.
 *
 * @note latitudePtr, longitudePtr,hAccuracyPtr, altitudePtr, vAccuracyPtr can be set to NULL
 *       if not needed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Get3DLocation
(
    int32 latitude OUT,     ///< WGS84 Latitude in degrees.
    int32 longitude OUT,    ///< WGS84 Longitude in degrees.
    int32 hAccuracy OUT,    ///< Horizontal accuracy in meters by default.
    int32 altitude OUT,     ///< Altitude above Mean Sea Level in meters by default.
    int32 vAccuracy OUT     ///< Vertical accuracy in meters by default.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's 2D location (latitude, longitude,
 * horizontal accuracy)
 *
 * @return LE_FAULT         On Failure in finding the positionSample.
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid.
 * @return LE_OK            On Success.
 *
 * @note If the caller is passing an invalid Position reference into this function,
 *       it is a fatal error, the function will not return.
 *
 * @note latitudePtr, longitudePtr, horizontalAccuracyPtr can be set to NULL if not needed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_Get2DLocation
(
    Sample positionSampleRef,     ///< Position sample reference.
    int32 latitude OUT,           ///< WGS84 Latitude in degrees.
    int32 longitude OUT,          ///< WGS84 Longitude in degrees.
    int32 horizontalAccuracy OUT  ///< Horizontal accuracy in meters by default.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's altitude.
 *
 * @return LE_FAULT         On Failure in finding the positionSample.
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid.
 * @return LE_OK            On Success.
 *
 * @note If the caller is passing an invalid Position reference into this function,
 *       it is a fatal error, the function will not return.
 *
 * @note altitudePtr, altitudeAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetAltitude
(
    Sample positionSampleRef,           ///< Position sample reference.
    int32 altitude OUT,                 ///< Altitude above Mean Sea Level in meters by default.
    int32 altitudeAccuracy OUT          ///< Vertical accuracy in meters by default.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's time.
 *
 * @return LE_FAULT         On failure in getting the time.
 * @return LE_OUT_OF_RANGE  The retrieved time is invalid.
 * @return LE_OK            On Success
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetTime
(
    Sample positionSampleRef,    ///< Position sample reference.
    uint16 hours OUT,            ///< UTC Hours of the day [range 0 to 23].
    uint16 minutes OUT,          ///< UTC Minutes of the hour [range 0 to 59].
    uint16 seconds OUT,          ///< UTC Seconds of the minute [range 0 to 59].
    uint16 milliseconds OUT      ///< UTC Milliseconds of the second [range 0 to 999].
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's horizontal speed.
 *
 * @return LE_FAULT         On failure is finding the positionSample.
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid
 * @return LE_OK            On Success.
 *
 * @note If the caller is passing an invalid Position reference into this function,
 *       it is a fatal error, the function will not return.
 *
 * @note hSpeedPtr, hSpeedAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetHorizontalSpeed
(
    Sample positionSampleRef,           ///< Position sample reference.
    uint32 hSpeed OUT,                  ///< The Horizontal Speed in m/sec.
    uint32 hSpeedAccuracy OUT           ///< The Horizontal accuracy in m/sec.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's direction
 *
 * @return LE_FAULT         On failure in finding the positionSample.
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is invalid.
 * @return LE_OK            On Success.
 *
 * @note Direction is given in degrees.
 *       Direction ranges from 0 to 359 degrees, where 0 is True North.
 *
 * @note If the caller is passing an invalid Position reference into this function,
 *       it is a fatal error, the function will not return.
 *
 * @note directionPtr, directionAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetDirection
(
    Sample positionSampleRef,           ///< Position sample reference.
    uint32 direction OUT,               ///< Direction indication in degrees.
    uint32 directionAccuracy OUT        ///< Direction's accuracy estimatation in degrees.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's vertical speed.
 *
 * @return LE_FAULT         On failure in finding the positionSample.
 * @return LE_OUT_OF_RANGE  One of the retrieved parameter is not valid.
 * @return LE_OK            On Success.
 *
 * @note If the caller is passing an invalid Position reference into this function,
 *       it is a fatal error, the function will not return.
 *
 * @note vSpeedPtr, vSpeedAccuracyPtr can be set to NULL if not needed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetVerticalSpeed
(
    Sample positionSampleRef,           ///< Position sample reference
    int32 vspeed OUT,                   ///< The Vertical Speed in m/sec.
    int32 vspeedAccuracy OUT            ///< The Vertical Speed's accuracy in m/sec.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set the resolution for the positioning distance values.
 *
 * @return LE_OK               On Success.
 * @return LE_BAD_PARAMETER    Invalid parameter provided.
 *
 * @note The positioning distance values are: the altitude above sea level, the horizontal
 *       position accuracy and the vertical position accuracy. The API sets the same resolution to
 *       all distance values. The resolution change request takes effect immediately.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDistanceResolution
(
    Resolution resolution IN        ///< Resolution.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample's fix state.
 *
 * @return LE_FAULT         On failure in getting the position sample's fix state.
 * @return LE_OK            On Success.
 *
 * @note If the caller is passing an invalid Position reference into this function,
 *       it is a fatal error, the function will not return.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetFixState
(
    Sample positionSampleRef,           ///< Position sample reference.
    taf_gnss.FixState state OUT         ///< Position fix state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the position sample date.
 *
 * @return LE_FAULT         On failure in getting the date.
 * @return LE_OUT_OF_RANGE  The retrieved date is invalid.
 * @return LE_OK            On Success.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t sample_GetDate
(
    Sample positionSampleRef,    ///< Position sample reference.
    uint16 year OUT,             ///< UTC Year
    uint16 month OUT,            ///< UTC Month of the year [range 1 to 12].
    uint16 day OUT               ///< UTC Days of the month [range 1 to 31].
);
