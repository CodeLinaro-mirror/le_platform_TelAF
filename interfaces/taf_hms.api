//--------------------------------------------------------------------------------------------------
/**
 * Handler for change in modem event.
 */
//--------------------------------------------------------------------------------------------------
HANDLER ModemEvtHandler
(
    ModemEvtType eventType   IN,             ///< Modem event
    ModemEvtSeverity eventSeverity IN,       ///< Modem event level
    ModemEvent eventRef                  ///< Modem status change event reference
);


//--------------------------------------------------------------------------------------------------
/**
 * Event to report the modem status change and relevant information.
 *
 * @b STAGING: This is a staging API and is subject to change.
 */
//--------------------------------------------------------------------------------------------------
EVENT ModemEvt
(
    ModemEvtHandler handler    ///< Modem status handler.
);


///------------------------------------------------------------------------------------------------
/**
* Release modem event reference.
*
* @b STAGING: This is a staging API and is subject to change.
* @return
* - LE_FAULT         Failed.
* - LE_OK            Succeeded.
*/
//------------------------------------------------------------------------------------------------
FUNCTION le_result_t ReleaseModemEvt
(
    ModemEvent eventRef                  ///< Modem status change event reference
);