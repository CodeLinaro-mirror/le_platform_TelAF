maxThreads: 300

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_BLOCK_SUSPEND
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafPMSvc = ( $TELAF_ROOT/components/tafPMSvc )
}
start: auto

processes:
{
    run:
    {
        (tafPMSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
}

extern:
{
    tafPMSvc.tafPMSvc.taf_pm
}
