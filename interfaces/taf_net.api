//--------------------------------------------------------------------------------------------------
/**
 * Creates a VLAN
 *
 * Note: If wants to use VLAN bridge and VLAN binding feature, need to set device mode with value 0
 * firstly.
 *
 * @return
 *   - NULL -- Failure.
 *   - Others -- The reference of VLAN.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Vlan CreateVlan
(
    uint16 vlanId                             IN, ///< VLAN identifier (i.e 1-4094).
    bool isAccelerated                        IN  ///< Is acceleration allowed.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes a VLAN. It's not allowed to remove a VLAN if the VLAN interface list is not empty.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- VLAN is not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveVlan
(
    Vlan vlanRef                              IN ///< VLAN reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets VLAN by VLAN id
 *
 * @return
 *   - NULL -- Not found.
 *   - Others -- The VLAN reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Vlan GetVlanById
(
    uint16 vlanId                             IN ///< VLAN id.
);

//--------------------------------------------------------------------------------------------------
/**
 * Adds a VLAN interface into the VLAN interface list.
 *
 * Note: Adds the first interface into the VLAN interface list with the same interface type will
 * trigger a system reboot if the VLAN acceleration has been allowed
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- VLAN is not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_DUPLICATE -- ifType already added into the VLAN.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddVlanInterface
(
    Vlan vlanRef                              IN, ///< VLAN Reference.
    VlanIfType ifType                         IN  ///< Interface type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Removes a VLAN interface from the VLAN interface list.
 * Note: Remove the last interface from the VLAN interface list with the same interface type will
 * trigger a system reboot if the VLAN acceleration has been allowed.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- VLAN is not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveVlanInterface
(
    Vlan vlanRef                              IN, ///< VLAN Reference.
    VlanIfType ifType                         IN  ///< Interface type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the VLAN interface list.
 *
 * @return
 *   - NULL -- If the VLAN is not found or the VLAN interface list is empty.
 *   - Others -- The reference of VLAN interface list.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanIfList GetVlanInterfaceList
(
    Vlan vlanRef                              IN ///< VLAN Reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the first VLAN interface reference with a list.
 *
 * @return
 *   - NULL -- If the interface list doesn't exist.
 *   - Others -- The reference of the first VLAN interface.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanIf GetFirstVlanInterface
(
    VlanIfList  vlanIfListRef                 IN ///< Reference of a VLAN interface list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the next VLAN interface reference with a list.
 *
 * @return
 *   - NULL -- If the VLAN interface list or the next interface doesn't exist.
 *   - Others -- The reference of the next VLAN interface.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION VlanIf GetNextVlanInterface
(
    VlanIfList  vlanIfListRef                 IN ///< Reference of a VLAN interface list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the VLAN interface list.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- VLAN interface list is not found.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteVlanInterfaceList
(
    VlanIfList  vlanIfListRef                 IN ///< Reference of a VLAN interface list.
);

//--------------------------------------------------------------------------------------------------
/**
