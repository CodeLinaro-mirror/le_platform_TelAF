 */

//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetMagneticDeviation
(
    Sample positionSampleRef    IN, ///< Position sample reference.
    int32 magneticDeviationPtr  OUT ///< MagneticDeviation in degrees. It is the difference between
                                    ///  the bearing to true north and the bearing shown on magnetic
                                    ///  compass. The deviation is positive when the magnetic north
                                    ///  is east of true north.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the semi-major and semi-minor horizontal elliptical uncertainty
 * per client session.
 *
 * @return
 *  - LE_OK             Succeeded.
 *  - LE_FAULT          Failed.
 *  - LE_NOT_PERMITTED  The Location service is not in the Active state.
 *
 * @b NOTE: If the caller passes a null pointer to this function, it is a fatal error
 *       and the client will be killed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEllipticalUncertainty
(
    Sample positionSampleRef          IN, ///< Position sample reference.
    uint32 horUncEllipseSemiMajorPtr OUT, ///< Horizontal semi-major elliptical uncertainty. It is
                                          ///  semi-major axis of horizontal elliptical uncertainty.
                                          ///  Units: Meters Uncertainty is defined with 39% confidence level.
    uint32 horUncEllipseSemiMinorPtr OUT, ///< Horizontal semi-minor elliptical uncertainty. It is
                                          ///  semi-minor axis of horizontal elliptical uncertainty.
                                          ///  Units: Meters Uncertainty is defined with 39% confidence level.
    uint8  horConfidencePtr          OUT  ///< Horizontal confidence level. It is defined with 39% confidence level.
);

