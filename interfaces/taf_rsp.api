USETYPES taf_sim.api;

DEFINE  EID_LEN    = (32);
DEFINE  EID_BYTES  = (EID_LEN+1);
DEFINE  MAX_PROFILE = (32);
DEFINE  NAME_LEN    = (64);
DEFINE  NAME_BYTES  = (NAME_LEN+1);
DEFINE  SPN_LEN    = (32);
DEFINE  SMDP_LEN   = (1024);
DEFINE  NICKNAME_LEN    = (64);
DEFINE  NICKNAME_BYTES  = (NICKNAME_LEN+1);
DEFINE  ACTIVATION_CODE_LEN    = (256);
DEFINE  ACTIVATION_CODE_BYTES  = (ACTIVATION_CODE_LEN+1);
DEFINE  CODE_LEN    = (256);
DEFINE  CODE_BYTES  = (CODE_LEN+1);


/**
 * Indicates profile type of card
 */
ENUM ProfileType
{
    UNKNOWN = -1,
    REGULAR = 0,    ///< Regular profile
    EMERGENCY,      ///< Emergency profile
};

/**
 * Indicates profile icon type.
 */
ENUM IconType
{
    NONE = 0,       ///< No icon information
    JPEG,           ///< JPEG icon
    PNG,            ///< PNG icon
};

/**
 * Indicates profile class.
 */
ENUM ProfileClass
{
    TEST = 0,        ///< Test profile
    PROVISIONING,    ///< Provisioning profile
    OPERATIONAL      ///< Operational  profile
};

/**
 * Defines profile policy rules(PPR). Each value represents
 * corresponding bit for PprMask bitset.
 */
ENUM PolicyRuleType
{
    PROFILE_DISABLE_NOT_ALLOWED,     ///< Disabling of the profile is not allowed
    PROFILE_DELETE_NOT_ALLOWED,      ///< Deletion of the profile is not allowed
    PROFILE_DELETE_ON_DISABLE,       ///< Deletion of the profile is required on successful disabling
};

/**
 * Indicates profile download status.
 */
ENUM DownloadStatus
{
    DOWNLOAD_ERROR = 0,                  ///< Profile download error
    DOWNLOAD_INSTALLATION_COMPLETE,      ///< Profile download and installation is complete
};

/**
 * Indicates profile download error cause.
 */
ENUM DownloadErrorCause
{
    GENERIC = 1,                      ///< Generic error
    SIM,                              ///< Error from the SIM card
    NETWORK,                          ///< Error from the network
    MEMORY,                           ///< Error due to no memory
    UNSUPPORTED_PROFILE_CLASS,        ///< Unsupported profile class
    PPR_NOT_ALLOWED,                  ///< Profile policy rules not allowed
    END_USER_REJECTION,               ///< End user rejection
    END_USER_POSTPONED,               ///< End user postponed
};

ENUM UserConsentReasonType
{
    USER_REJECTION = 0,          ///< End user rejection
    USER_POSTPONED               ///< End user postponed
};

STRUCT SimProfileInfo
{
    uint32         profileId;
    ProfileType    profileType;
    string         iccid[taf_sim.ICCID_LEN];
    bool           isActive;
    string         nickName[NICKNAME_LEN];
    string         name[NAME_LEN];
    string         spn[SPN_LEN];
    IconType       iconType;
    ProfileClass   profileClass;
    uint8          mask;
};

HANDLER  ProfileDownloadHandler
(
    taf_sim.Id         slotId  IN,
    DownloadStatus     downloadStatus IN,
    DownloadErrorCause errorCause IN
);

EVENT  ProfileDownload
(
    ProfileDownloadHandler handler
);

HANDLER  ProfileUserConsentHandler
(
    taf_sim.Id         slotId  IN,
    bool               userConsentRequired IN,
    uint8              mask
);

EVENT  ProfileUserConsent
(
    ProfileUserConsentHandler handler
);

HANDLER  ProfileConfirmationCodeHandler
(
    taf_sim.Id         slotId  IN,
    string             profileName[NAME_LEN]
);

EVENT  ProfileConfirmationCode
(
    ProfileConfirmationCodeHandler handler
);

/**
 * Request eUICC identifier(EID) for the slot.
 */
FUNCTION le_result_t GetEID
(
    taf_sim.Id       slotId IN,
    string           eid[EID_LEN] OUT
);

/**
 * Add new profile to eUICC card and download and install the profile on eUICC.
 *
 */
FUNCTION le_result_t AddProfile
(
    taf_sim.Id       slotId IN,
    string           activationCode[ACTIVATION_CODE_LEN] IN,
    string           confirmationCode[CODE_LEN] IN,
    bool             userConsentSupported IN
);

/**
 *  Delete profile from eUICC card.
 */
FUNCTION le_result_t DeleteProfile
(
    taf_sim.Id       slotId IN,
    uint32           profileId IN
);

/**
 *   Enable or disable profile which allows to switch to other profile on eUICC card.
 */
FUNCTION le_result_t SetProfile
(
    taf_sim.Id       slotId IN,
    uint32           profileId IN,
    bool             enable    IN
);

/**
 *  Update nick name of the profile
 */
FUNCTION le_result_t UpdateNickName
(
    taf_sim.Id       slotId IN,
    uint32           profileId IN,
    string           nickName[NICKNAME_LEN] IN
);

/**
 *  Request list of profiles supported by the eUICC card.
 */
FUNCTION le_result_t GetProfileList
(
    taf_sim.Id        slotId IN,
    SimProfileInfo    profileList[MAX_PROFILE] OUT
);

/**
 * Set Subscription Manager Data Preparation (SM-DP+) address on the eUICC. If SMDP+
 * address length is zero then the existing SM-DP+ address on the eUICC is removed
 *
 */
FUNCTION le_result_t SetServerAddress
(
    taf_sim.Id       slotId IN,
    string           smdpAdress[SMDP_LEN] IN
);

/**
 * Get Subscription Manager Data Preparation (SM-DP+) address and the Subscription Manager
 * Discovery Server (SMDS) address configured on the eUICC.
 */
FUNCTION le_result_t GetServerAddress
(
    taf_sim.Id           slotId IN,
    string               smdpAdress[SMDP_LEN]  OUT,
    string               smdsdress[SMDP_LEN] OUT
);

/**
 * Provide user consent required for downloading and installing profile.
 * This API should be called in response to ProfileUserConsent event
 */
FUNCTION le_result_t ProvideUserConsent
(
    taf_sim.Id              slotId IN,
    bool                    userConsent IN,
    UserConsentReasonType   reason
);

/**
 * Provide confirmation code required for downloading and installing profile.
 * This API should be called in response to ProfileConfirmationCode event
 */
FUNCTION le_result_t ProvideConfirmationCode
(
    taf_sim.Id              slotId IN,
    string                  code[CODE_LEN] IN
);
