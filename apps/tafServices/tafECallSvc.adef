maxThreads: 600

username: telaf

startGroup: 14

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_RAW
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafECallSvc = ( $TELAF_ROOT/components/tafECallSvc )
}

start: auto

processes:
{
    run:
    {
        (tafECallSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

requires:
{
    configTree:
    {
        [w] .
    }
}

bindings:
{
    tafECallSvc.tafECallSvc.taf_sim -> tafSimCardSvc.taf_sim
}

extern:
{
    tafECallSvc.tafECallSvc.taf_ecall
}
