//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafDiagDataIDStor Diag Data ID Storage Service
 *
 * @rst :ref:`API reference <File taf_diagDidStore_interface.h>` @endrst
 *
 * @rst :ref:`Plugin APIs <File tafPiDiagDID.h>` @endrst
 *
 * <HR>
 *
 * The diag DataIDStore service provides APIs for read, write and DID change notification.
 * The plugin reads and writes data associated with the DID from vehicle systems storage.
 * Did notification allows the application to receive notifications when the data associated with a
 * specific DID changes.
 *
 * @section taf_diagDidStore_binding IPC interfaces binding
 *
 * The functions of this API are provided by the @b tafDidStoreSvc platform service.
 *
 * The following example illustrates how to bind to the diag DataIDStore service.
 *
 * @verbatim
   bindings:
   {
        clientExe.clientComponent.taf_diagDidStore -> tafDidStoreSvc.taf_diagDidStore
   }
   @endverbatim
 *
 * @section c_taf_diagDidStore_server_API Server-service APIs
 *
 * A diag DataID storage service reference should be got using taf_diagDidStore_GetService(). Use
 * the returned reference for subsequent operations.
 *
 * The following example illustrates how to set up a diag DataID storage server-service-instance.
 *
 * @code
   taf_diagDidStore_ServiceRef_t svcRef;    // Service reference

   // Get the service reference.
   svcRef = taf_diagDidStore_GetService();
   LE_ASSERT(svcRef != NULL);
   @endcode
 *
 * - taf_diagDidStore_Read() -- Reads the data record of the DID.
 * - taf_diagDidStore_Write() -- Writes the data record to given DID.
 *
 * An application must call taf_diagDidStore_AddDataIdChangeHandler() first to register a handler
 * for a DataID to get the change notification. To receive notifications for additional DataID, an
 * application should call taf_diagDidStore_GetDIDHandlerRef() to retrieve the handler reference.
 * It can then use taf_diagDidStore_AddDIDToHandler() or taf_diagDidStore_RemoveDIDFromHandler()
 * by passing the handler reference along with the desired DataID. If a change occurs in any of
 * registered DataID, the service triggers the same handler and provides the updated value for the
 * corresponding DataID.
 *
 * @code
   // Rx DataID change handler function.
   void DataIdChangeHandler
   (
        uint16_t dataId,
        const uint8_t* dataRecordPtr,
        size_t dataRecordSize,
        void* contextPtr
   )
   {
        // Process after DataID record change
   }

   // Register the DataID change handler.
   uint16_t dataId = 0xA5A6;
   taf_diagDidStore_DataIdChangeHandlerRef_t handlerRef =
       taf_diagDidStore_AddDataIdChangeHandler(svcRef, dataId,
            (taf_diagDidStore_DataIdChangeHandlerFunc_t)DataIdChangeHandler, NULL);
   LE_ERROR_IF((handlerRef == NULL), "taf_diagDidStore_AddDataIdChangeHandler returns NULL!");

   // Get the handler reference.
   taf_diagDidStore_DIDChangeHandlerRef_t didHandlerRef;
   didHandlerRef = taf_diagDidStore_GetDIDHandlerRef(svcRef);
   LE_ASSERT(didHandlerRef != NULL);

   // Add the DataID to get the change notification.
   uint16_t dataId = 0xF011;
   le_result_t result = taf_diagDidStore_AddDIDToHandler(didHandlerRef, dataId);
   if (result != LE_OK || result != LE_DUPLICATE){
    LE_ERROR("Fail to add DataID");
    return result;
   }

   // Remove the DataID.
   uint16_t dataId = 0xF011;
   le_result_t result = taf_diagDidStore_RemoveDIDFromHandler(didHandlerRef, dataId);
   if (result != LE_OK || result != LE_NOT_FOUND){
    LE_ERROR("Fail to remove DataID");
    return result;
   }

   // To remove the handler function, when it is not needed.
   taf_diagDidStore_RemoveDataIdChangeHandler(handlerRef);
   @endcode
 *
 * <HR>
 *
 */
//-------------------------------------------------------------------------------------------------

API_VERSION = 1;
SERVING_VERSION = 1;

//-------------------------------------------------------------------------------------------------
/**
 * The maximum size of the WriteDID request data record in bytes.
 */
//-------------------------------------------------------------------------------------------------
DEFINE MAX_DID_DATA_RECORD_SIZE = 4092;

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the DID Storage service.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE Service;

//-------------------------------------------------------------------------------------------------
/**
 * Reference to the DID change handler.
 */
//-------------------------------------------------------------------------------------------------
REFERENCE DIDChangeHandler;

//-------------------------------------------------------------------------------------------------
/**
 * Gets the reference of a DataIDStorg service.
 *
 * @instaging
 *
 * @return
 *     - Reference to the service instance.
 *     - NULL if errors.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION Service GetService
(
) = 0;

//-------------------------------------------------------------------------------------------------
/**
 * Reads the data record of the DID.
 *
 * @note The process exits if an invalid reference is passed.
 *
 * @instaging
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid svcRef.
 *     - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t Read
(
    Service svcRef IN,                                 ///< Service reference.
    uint16 dataId  IN,                                 ///< Data identifier.
    uint8 dataRecord[MAX_DID_DATA_RECORD_SIZE]  OUT    ///< Data record.
) = 1;

//-------------------------------------------------------------------------------------------------
/**
 * Writes the data record to given DID.
 *
 * @note The process exits if an invalid reference is passed.
 *
 * @instaging
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid svcRef.
 *     - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t Write
(
    Service svcRef IN,                          ///< Service reference.
    uint16 dataId  IN,                          ///< Data identifier.
    uint8 data[MAX_DID_DATA_RECORD_SIZE]  IN    ///< Data payload.
) = 2;

//-------------------------------------------------------------------------------------------------
/**
 * Handler for a DID change notification.
 *
 * @instaging
 *
 * @param[in] dataId     Data identifier.
 * @param[in] dataRecord Data record.
 * @param[in] contextPtr Context pointer.
 */
//-------------------------------------------------------------------------------------------------
HANDLER DataIdChangeHandler
(
    uint16 dataId IN,                                 ///< Data identifier.
    uint8 dataRecord[MAX_DID_DATA_RECORD_SIZE] IN     ///< Data record.
);

//-------------------------------------------------------------------------------------------------
/**
 * This event provides information about the DID change notification.
 *
 * @instaging
 */
//-------------------------------------------------------------------------------------------------
EVENT DataIdChange
(
    Service svcRef IN,              ///< Service reference.
    uint16 dataId IN,               ///< Data identifier.
    DataIdChangeHandler handler     ///< Received message handler.
) = (3,4);

//-------------------------------------------------------------------------------------------------
/**
 * Gets the reference of a DID change handler.
 *
 * @instaging
 *
 * @return
 *     - Reference to the DID change handler.
 *     - NULL if errors.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION DIDChangeHandler GetDIDHandlerRef
(
    Service svcRef IN   ///< Service reference.
) = 5;

//-------------------------------------------------------------------------------------------------
/**
 * Adds the DID to handler for change notification.
 *
 * @instaging
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid handlerRef.
 *     - LE_DUPLICATE -- Data identifier already added.
 *     - LE_FAULT -- Failed.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t AddDIDToHandler
(
    DIDChangeHandler handlerRef IN, ///< Handler reference.
    uint16 dataId  IN               ///< Data identifier.
) = 6;

//-------------------------------------------------------------------------------------------------
/**
 * Removes the DID from handler.
 *
 * @instaging
 *
 * @return
 *     - LE_OK -- Succeeded.
 *     - LE_BAD_PARAMETER -- Invalid handlerRef.
 *     - LE_NOT_FOUND -- Data identifier not found.
 *
 */
//-------------------------------------------------------------------------------------------------
FUNCTION le_result_t RemoveDIDFromHandler
(
    DIDChangeHandler handlerRef IN, ///< Handler reference.
    uint16 dataId  IN               ///< Data identifier.
) = 7;
