requires:
{
    api:
    {
        le_cfg.api
        le_cfgAdmin.api
    }
}

bundles:
{
    file:
    {
        [rw] configTest-primitive.json /data/
        [rw] configTest-1000.json /data/
        [rw] configTest-5000.json /data/
        [rw] configTest-errorValue.json /data/
        [rw] configTest-errorFormat.json /data/
        [rw] configTest-readWrite.json   /data/
        [r] configTest-readOnly.json     /data/
    }
}


sources:
{
    config.c
}