maxThreads: 600
sandboxed: false

executables:
{
    tafSmsIntTest = ( tafSmsIntTest )
}

start: manual

processes:
{
    run:
    {
        (tafSmsIntTest)
    }

    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }

    faultAction: stopApp

    #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
        maxWatchdogTimeout: 100000
    #else
        watchdogTimeout: never
    #endif
}

bindings:
{
    tafSmsIntTest.tafSmsIntTest.taf_sms -> tafSMSSvc.taf_sms
}
