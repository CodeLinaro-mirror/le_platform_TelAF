/**
 * @page c_tafDataCallSvc Data Call Service
 *
 * @rst :ref:`API reference <File taf_dcs_interface.h>` @endrst
 *
 * <HR>
 *
 * The Data Call service API is used for applications to manage data calls and data profiles.
 * It provides APIs over a mobile network.
 *
 * @section c_taf_dcs_binding IPC interfaces binding
 *
 * All functions of this API are provided by the @b tafDataCallSvc application service.
 *
 * The following example illustrates how to bind to the data call service.
 *
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_dcs -> tafDataCallSvc.taf_dcs
   }
   @endverbatim
 *
 * @section c_taf_dcs_start_data_call Starting a data call
 *
 * A synchronous data call can be started using taf_dcs_StartSession() with the profile
 * reference passed as parameters.
 *
 * @verbatim
   result = taf_dcs_StartSession(profileReference);
   if (result != LE_OK)
   {
      LE_ERROR("Fail to start data call.");
      return result;
   }
   @endverbatim
 *
 * An asynchronous data call can be started using taf_dcs_StartSessionAsync() with the profile
 * reference passed as parameters. The result of the taf_dcs_StartSessionAsync() operation will be
 * provided via the completion handler, #taf_dcs_AsyncSessionHandlerFunc_t.
 *
 * @verbatim
   void AsyncSessionHandler (taf_dcs_ProfileRef_t profileRef,le_result_t result,void* contextPtr)
   {
     if (LE_OK == result)
     {
        //Start session successful
     }
     else
     {
        // Handle errors
     }
   }
   myFunc()
   {
     taf_dcs_StartSessionAsync(profileReference, AsyncSessionHandler, contextPtr);
   }
   @endverbatim
 *
 * Before starting a data call, an application registers a state handler using
 * taf_dcs_AddSessionStateHandler(). Once the data call state changes the handler will be called
 * indicating the new state.
 *
 * @verbatim
   sessionStateRef = taf_dcs_AddSessionStateHandler(profileReference,
                    (taf_dcs_SessionStateHandlerFunc_t)data_event_handler, NULL);
   @endverbatim
 *
 * An application can stop a synchronous data call by using taf_dcs_StopSession() and stop an
 * asynchronous data call by using taf_dcs_StopSessionAsync().
 *
 * @b NOTE: When an application starts a data call using taf_dcs_StartSession() or
 * taf_dcs_StartSessionAsync() and the application loses the connection with the data call service,
 * the data call will be automatically stopped by the data call service.
 *
 * @section c_taf_dcs_roaming_status Roaming status
 *
 * Data call service provides the APIs to get the roaming status and register the handler to track
 * the roaming status change. Once the roaming status changes, the application registered handler
 * is called with the new roaming status.
 *
 * @verbatim
   roamingStatusHandlerRef = taf_dcs_AddRoamingStatusHandler(
                           (taf_dcs_RoamingStatusHandlerFunc_t)RoamingStatusHandlerFunc, NULL);
   @endverbatim
 *
 * To remove the handler, an application can use
 * taf_dcs_RemoveRoamingStatusHandler(roamingStatusHandlerRef);.
 *
 * The following APIs are added for roaming status and APN types:
 *
 * - taf_dcs_AddRoamingStatusHandler() -- Adds a handler for roaming status.
 * - taf_dcs_RemoveRoamingStatusHandler() -- Removes a handler for roaming status.
 * - taf_dcs_GetRoamingStatus() -- Gets current roaming status.
 * - taf_dcs_GetApnTypes() -- Gets APN types.
 *
 * @section c_taf_dcs_support_phone_id Phone ID support
 *
 * Data call service provides API to support phone ID for DSSA/DSDA mode. The application can use
 * phone ID for these APIs.
 *
 * @verbatim
   profileReference = GetProfileEx(phoneId, profileId);
   @endverbatim
 *
 * The following APIs are added for supporting phone ID.
 *
 * - taf_dcs_GetProfileListEx() -- Gets the data profile list with the specified phone ID.
 * - taf_dcs_GetDefaultPhoneIdAndProfileId() -- Gets the default phone ID and profile index.
 * - taf_dcs_SetDefaultProfileIndexEx() -- Sets the default profile corresponding to the specified phone ID and profile index.
 * - taf_dcs_GetProfileEx() -- Gets the profile reference for the given phone ID and profile index.
 * - taf_dcs_GetPhoneId() -- Gets the phone ID for the given profile reference.
 * - taf_dcs_GetPhoneIdByInterfaceName() -- Gets the phone ID by the interface name.
 *
 * @section c_taf_dcs_manage_profiles Managing Profiles
 *
 * Data call service provides APIs to manage profiles. TelAF applications can create profiles,
 * update profile parameters and delete profiles with the profile management APIs.<br>
 * To create a profile, applications should first get a profile reference using the
 * taf_dcs_GetProfileEx() API with #TAF_DCS_UNDEFINED_PROFILE_ID for profileId. After setting all
 * relevant parameters, applications can use taf_dcs_CreateProfile() to create the profile.<br>
 * Applications can get the ID of the created profile using taf_dcs_GetProfileId() API.<br>
 * Profiles can be deleted using taf_dcs_DeleteProfile().
 *
 * @verbatim
 * profileReference = taf_dcs_GetProfileEx(phoneId, #TAF_DCS_UNDEFINED_PROFILE_ID);
 * taf_dcs_SetAPN (profileReference, "TestAPN");
 * taf_dcs_CreateProfile(profileReference);
 * taf_dcs_GetProfileId (profileReference, &profileID);
 * taf_dcs_DeleteProfile(profileReference);
 * @endverbatim
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * The common name (string) maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NAME_MAX_LEN = 64;

//--------------------------------------------------------------------------------------------------
/**
 * The common name (string) maximum Bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE NAME_MAX_BYTES = (NAME_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of call contexts.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_CALL_OBJ = 32;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of session references.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_SESSION_REF = 32;

//--------------------------------------------------------------------------------------------------
/**
 * The APN name (string) maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE APN_NAME_MAX_LEN = NAME_MAX_LEN;

//--------------------------------------------------------------------------------------------------
/**
 * The APN name (string) maximum Bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE APN_NAME_MAX_BYTES = (APN_NAME_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * The authorized username (string) maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  USER_NAME_MAX_LEN = NAME_MAX_LEN;

//--------------------------------------------------------------------------------------------------
/**
 * The authorized user's password (string) maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  PASSWORD_NAME_MAX_LEN = NAME_MAX_LEN;

//--------------------------------------------------------------------------------------------------
/**
 * The authorized user's username (string) maximum Bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  USER_NAME_MAX_BYTES  = (USER_NAME_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * The authorized user's password (string) maximum Bytes.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  PASSWORD_NAME_MAX_BYTES  = (PASSWORD_NAME_MAX_LEN + 1);

//--------------------------------------------------------------------------------------------------
/**
 * The IPv4 address maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IPV4_ADDR_MAX_LEN = 16;

//--------------------------------------------------------------------------------------------------
/**
 * The IPv6 address ("ffff:ffff:ffff:ffff:ffff:ffff:255:255:255:255") maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IPV6_ADDR_MAX_LEN = 46;

//--------------------------------------------------------------------------------------------------
/**
 * The default cellular profile index.
 */
//--------------------------------------------------------------------------------------------------
DEFINE DEFAULT_PROFILE = 1;

//--------------------------------------------------------------------------------------------------
/**
 * The undefined profile ID (0xFFFF).
 */
//--------------------------------------------------------------------------------------------------
DEFINE UNDEFINED_PROFILE_ID = 0xFFFF;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the cellular profile context.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Profile;

//--------------------------------------------------------------------------------------------------
/**
 * Reference to the data call session context.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Call;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of entries for cellular profiles.
 */
//--------------------------------------------------------------------------------------------------
DEFINE PROFILE_LIST_MAX_ENTRY = 32;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of mappings for a handler session.
 */
//--------------------------------------------------------------------------------------------------
DEFINE MAX_ASYNC_HANDLER_MAPPING = 20;

//--------------------------------------------------------------------------------------------------
/**
 * The squash gateway addresses used by net APIs
 */
//--------------------------------------------------------------------------------------------------
STRUCT DefaultGatewayAddresses
{
    string  ipv4Addr[IPV4_ADDR_MAX_LEN];    ///< The IPv4 address.
    string  ipv6Addr[IPV6_ADDR_MAX_LEN];    ///< The IPv6 address.
};

//--------------------------------------------------------------------------------------------------
/**
 * The squash DNS addresses used by net APIs.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DnsServerAddresses
{
    string  ipv4Addr1[IPV4_ADDR_MAX_LEN];   ///< The primary IPv4 DNS address.
    string  ipv4Addr2[IPV4_ADDR_MAX_LEN];   ///< The secondary IPv4 DNS address.
    string  ipv6Addr1[IPV6_ADDR_MAX_LEN];   ///< The primary IPv6 DNS address.
    string  ipv6Addr2[IPV6_ADDR_MAX_LEN];   ///< The secondary IPv6 DNS address.
};

//--------------------------------------------------------------------------------------------------
/**
 * The supported data bearer technology.
 */
//--------------------------------------------------------------------------------------------------
ENUM DataBearerTechnology
{
    // CDMA related
    DATA_BEARER_TECHNOLOGY_UNKNOWN,               ///< Unknown.
    DATA_BEARER_TECHNOLOGY_CDMA2000_1X,           ///< CDMA 1XF.
    DATA_BEARER_TECHNOLOGY_CDMA2000_EVDO,         ///< CDMA Rev 0.
    DATA_BEARER_TECHNOLOGY_CDMA2000_EVDO_REVA,    ///< CDMA Rev A.
    DATA_BEARER_TECHNOLOGY_CDMA2000_EVDO_REVB,    ///< CDMA Rev B.
    DATA_BEARER_TECHNOLOGY_CDMA2000_EHRPD,        ///< CDMA EHPRD.
    DATA_BEARER_TECHNOLOGY_CDMA2000_HRPD,         ///< CDMA HPRD.
    DATA_BEARER_TECHNOLOGY_CDMA_EVDO_FMC,         ///< CDMA FMC.
    DATA_BEARER_TECHNOLOGY_3GPP2_WLAN,            ///< IWLAN.
    //UMTS related
    DATA_BEARER_TECHNOLOGY_WCDMA,                 ///< WCDMA (UMTS).
    DATA_BEARER_TECHNOLOGY_GPRS,                  ///< GPRS.
    DATA_BEARER_TECHNOLOGY_HSDPA,                 ///< HSDPA.
    DATA_BEARER_TECHNOLOGY_HSUPA,                 ///< HSUPA.
    DATA_BEARER_TECHNOLOGY_EDGE,                  ///< EDGE.
    DATA_BEARER_TECHNOLOGY_LTE,                   ///< LTE.
    DATA_BEARER_TECHNOLOGY_HSDPA_PLUS,            ///< HSDPA_PLUS.
    DATA_BEARER_TECHNOLOGY_DC_HSDPA_PLUS,         ///< DC_HSDPA_PLUS.
    DATA_BEARER_TECHNOLOGY_HSPA,                  ///< HSPA.
    DATA_BEARER_TECHNOLOGY_64_QAM,                ///< 64 QAM.
    DATA_BEARER_TECHNOLOGY_TD_SCDMA,              ///< TDS-CDMA.
    DATA_BEARER_TECHNOLOGY_GSM,                   ///< GSM.
    DATA_BEARER_TECHNOLOGY_3GPP_WLAN,             ///< IWLAN.
    DATA_BEARER_TECHNOLOGY_5G,                    ///< NR5G.
};

//--------------------------------------------------------------------------------------------------
/**
 * The supported data cellular call connection event.
 */
//--------------------------------------------------------------------------------------------------
ENUM ConState
{
    DISCONNECTED,                           ///< Disconnected state.
    CONNECTING,                             ///< Connecting state.
    CONNECTED,                              ///< Connected state.
    DISCONNECTING,                          ///< Disconnecting state.
};

//--------------------------------------------------------------------------------------------------
/**
 * The data profile PDP type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Pdp
{
    PDP_UNKNOWN,                            ///< Unknown.
    PDP_IPV4,                               ///< IPv4.
    PDP_IPV6,                               ///< IPv6.
    PDP_IPV4V6                              ///< IPv4 and IPv6.
};

//--------------------------------------------------------------------------------------------------
/**
 * The roaming type.
 */
//--------------------------------------------------------------------------------------------------
ENUM RoamingType
{
    ROAMING_UNKNOWN,                        ///< Unknown.
    ROAMING_DOMESTIC,                       ///< Device is in a domestic roaming network.
    ROAMING_INTERNATIONAL                   ///< Device is in an international roaming network.
};

//--------------------------------------------------------------------------------------------------
/**
 * The data profile authentication type.
 */
//--------------------------------------------------------------------------------------------------
BITMASK Auth
{
    AUTH_NONE,                              ///< None.
    AUTH_PAP,                               ///< PAP.
    AUTH_CHAP                               ///< CHAP.
};

//--------------------------------------------------------------------------------------------------
/**
 * The APN type mask.
 */
//--------------------------------------------------------------------------------------------------
BITMASK ApnType
{
    APN_TYPE_DEFAULT,                       ///< APN type for default/internet traffic.
    APN_TYPE_IMS,                           ///< APN type for the IP multimedia subsystem.
    APN_TYPE_MMS,                           ///< APN type for the multimedia messaging service.
    APN_TYPE_DUN,                           ///< APN type for the dial up network.
    APN_TYPE_SUPL,                          ///< APN type for secure user plane location.
    APN_TYPE_HIPRI,                         ///< APN type for high priority mobile data.
    APN_TYPE_FOTA,                          ///< APN type for over the air administration.
    APN_TYPE_CBS,                           ///< APN type for carrier branded services.
    APN_TYPE_IA,                            ///< APN type for initial attach.
    APN_TYPE_EMERGENCY,                     ///< APN type for emergency.
    APN_TYPE_UT,                            ///< APN type for UT.
    APN_TYPE_MCX                            ///< APN type for mission critical service.
};

//--------------------------------------------------------------------------------------------------
/**
 * The data profile technology type.
 */
//--------------------------------------------------------------------------------------------------
ENUM Tech
{
    TECH_UNKNOWN,                           ///< Unknown.
    TECH_3GPP,                              ///< 3GPP.
    TECH_3GPP2,                             ///< 3GPP2.
    TECH_ANY                                ///< Any.
};

//--------------------------------------------------------------------------------------------------
/**
 * Additional state information.
 * IP: The IP Type of this event, e.g.,
 *     which interface (IPv4/IPv6) is supported on a CONNECTED event.
 */
//--------------------------------------------------------------------------------------------------
STRUCT StateInfo
{
    Pdp      ipType;
};

//--------------------------------------------------------------------------------------------------
/**
 * The roaming status indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT RoamingStatusInd
{
    uint8 phoneId;                         ///< The phone ID.
    bool isRoaming;                        ///< True means that roaming is on; False means that
                                           ///  roaming is off.
    RoamingType type;                      ///< The roaming type. Valid only if roaming is on.
};

//--------------------------------------------------------------------------------------------------
/**
 * Starts a synchronous data cellular session for the given profile reference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Parameter is invalid or couldn't create the data call.
 *  - LE_OUT_OF_RANGE -- PDP type is unknown.
 *  - LE_DUPLICATE -- If the data session is already connected for the given profile.
 *  - LE_IN_PROGRESS -- The profile is in use and a data call is in progress.
 *  - LE_TIMEOUT -- Timed out when attempting to make the data call.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StartSession
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * The handler for asynchronous session start or stop result response.
 *
 * @param[in] profileRef The profile reference.
 * @param[in] result     The result of starting or stopping the data session.<br>
 *                       LE_OK           -- Succeeded.<br>
 *                       LE_NOT_POSSIBLE -- The data profile is not yet created.<br>
 *                       Others          -- Failed.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncSessionHandler
(
    Profile      profileRef                 IN, ///< The profile reference.
    le_result_t  result                     IN  ///< The result of starting or stopping session.
);

//--------------------------------------------------------------------------------------------------
/**
 * Starts (asynchronously) a cellular data session for the given profile reference.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION StartSessionAsync
(
    Profile profileRef                      IN, ///< The profile reference.
    AsyncSessionHandler handler             IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Stops (synchronously) a cellular data session for the given profile reference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Can't find a data call.
 *  - LE_OUT_OF_RANGE -- PdpType type is unknown.
 *  - LE_BAD_PARAMETER -- Call context is NULL.
 *  - LE_TIMEOUT -- Timeout to stop a data call.
 *  - LE_IN_PROGRESS -- The profile is in use and a data call is in progress.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StopSession
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Stops (asynchronously) a cellular data session for the given profile reference.
 *
 */
//--------------------------------------------------------------------------------------------------
FUNCTION StopSessionAsync
(
    Profile profileRef                      IN, ///< The profile reference.
    AsyncSessionHandler handler             IN  ///< The handler.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets a connected data call interface name.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_NOT_POSSIBLE -- Invalid status.
 *  - LE_NOT_FOUND -- Cannot find the interface name.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceName
(
    Profile profileRef                      IN, ///< The profile reference.
    string  ifName[NAME_MAX_LEN]            OUT ///< The interface name.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data call session handler.
 */
//--------------------------------------------------------------------------------------------------
HANDLER SessionStateHandler
(
    Profile      profileRef                 IN, ///< The profile reference.
    ConState     state                      IN, ///< The connection state.
    StateInfo    info                       IN  ///< The connection information.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data call session event.
 */
//--------------------------------------------------------------------------------------------------
EVENT SessionState
(
    Profile             profileRef, ///< The profile reference.
    SessionStateHandler handler     ///< The event handler reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for roaming status.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RoamingStatusHandler
(
    RoamingStatusInd roamingStatusInd IN    ///< Roaming status indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report roaming status.
 */
//--------------------------------------------------------------------------------------------------
EVENT RoamingStatus
(
    RoamingStatusHandler handler            ///< Handler for roaming status.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Gets the roaming status.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameters.
 *  - LE_TIMEOUT -- Response timed out.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetRoamingStatus
(
    uint8  phoneId              IN,  ///< The phone ID.
    bool isRoaming              OUT, ///< True means that roaming is on; False means that
                                     ///  roaming is off.
    RoamingType type            OUT  ///< The roaming type. Valid only if roaming is on.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv4 address.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv4Address
(
    Profile profileRef,                     ///< The profile reference.
    string  ipAddr[IPV4_ADDR_MAX_LEN] OUT   ///< The IPv4 address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv4 gateway address.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv4GatewayAddress
(
    Profile profileRef                      IN,  ///< The profile reference.
    string  gatewayAddr[IPV4_ADDR_MAX_LEN]  OUT  ///< The IPv4 gateway address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session primary and secondary DNS IPv4 addresses.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv4DNSAddresses
(
    Profile profileRef                     IN,  ///< The profile reference.
    string  dns1AddrStr[IPV4_ADDR_MAX_LEN] OUT, ///< The IPv4 primary DNS address.
    string  dns2AddrStr[IPV4_ADDR_MAX_LEN] OUT  ///< The IPv4 secondary DNS address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv6 address.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv6Address
(
    Profile profileRef                      IN, ///< The profile reference.
    string  ipAddr[IPV6_ADDR_MAX_LEN]       OUT ///< The IPv6 address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv6 gateway address.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv6GatewayAddress
(
    Profile profileRef                      IN, ///< The profile reference.
    string  gatewayAddr[IPV6_ADDR_MAX_LEN] OUT  ///< The IPv6 gateway address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session primary and secondary DNS IPv6 addresses.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv6DNSAddresses
(
    Profile profileRef                      IN, ///< The profile reference.
    string  dns1AddrStr[IPV6_ADDR_MAX_LEN] OUT, ///< The IPv6 primary DNS address.
    string  dns2AddrStr[IPV6_ADDR_MAX_LEN] OUT  ///< The IPv6 secondary DNS address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data session's current state.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetSessionState
(
    Profile       profileRef                IN, ///< The profile reference.
    ConState      connectionState           OUT ///< The connection state.
);

//--------------------------------------------------------------------------------------------------
/**
 * Checks if the data session is IPv4.
 *
 * @return
 *  - True -- IPv4.
 *  - False -- Not IPv4 or the profile reference is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsIPv4
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Checks if the data session is IPv6.
 *
 * @return
 *  - True -- IPv6.
 *  - False -- Not IPv6 or the profile reference is invalid.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION bool IsIPv6
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session data bearer technology.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDataBearerTechnology
(
    Profile profileRef                       IN,  ///< The profile reference.
    DataBearerTechnology dlDataBearerTechPtr OUT, ///< The downlink data bearer technology.
    DataBearerTechnology ulDataBearerTechPtr OUT  ///< The uplink data bearer technology.
);

//--------------------------------------------------------------------------------------------------
/**
 * The data profile structure.
 *
 */
//--------------------------------------------------------------------------------------------------
STRUCT ProfileInfo
{
    uint32 index;                           ///< The profile index.
    Tech   tech;                            ///< The technology.
    string name[NAME_MAX_LEN];              ///< The profile name.
};

//--------------------------------------------------------------------------------------------------
/**
 * The handler of the requesting data profile list.
 */
//--------------------------------------------------------------------------------------------------
HANDLER ProfileListHandler
(
    le_result_t  result                                 IN, ///< The result.
    ProfileInfo  profileList[PROFILE_LIST_MAX_ENTRY]    IN  ///< The profile list information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile list.
 *
 * @b NOTE: For Dual Sim-Single Active (DSSA) mode and Dual Sim-Dual Active (DSDA) mode, this API gets
 * the data profile list with phone ID 1.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_FAULT -- Failed.
 */
FUNCTION le_result_t GetProfileList
(
    ProfileInfo profileList[PROFILE_LIST_MAX_ENTRY]  OUT    ///< The profile list information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile list with the specified phone ID.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_FAULT -- Failed.
 */
FUNCTION le_result_t GetProfileListEx
(
    uint8 phoneId                                    IN,    ///< The phone ID.
    ProfileInfo profileList[PROFILE_LIST_MAX_ENTRY]  OUT    ///< The profile list information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the default profile index.
 *
 * @return
 *  - uint32 -- The profile index.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION uint32 GetDefaultProfileIndex
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the default phone ID and profile index.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetDefaultPhoneIdAndProfileId
(
    uint8  phoneId                          OUT, ///< The phone ID.
    uint32 profileId                        OUT  ///< The profile index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the default profile index corresponding to the specified profile index.
 *
 * @b NOTE: For Dual Sim-Single Active (DSSA) mode and Dual Sim-Dual Active (DSDA) mode, this API sets
 * the data profile with default phone ID 1.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDefaultProfileIndex
(
    uint32 profileId                        IN ///< The profile index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the default profile corresponding to the specified phone ID and profile index.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDefaultProfileIndexEx
(
    uint8 phoneId                           IN,///< The phone ID.
    uint32 profileId                        IN ///< The profile index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the profile reference for the given profile index.
 *
 * @b NOTE: For Dual Sim-Single Active (DSSA) mode and Dual Sim-Dual Active (DSDA) mode, this API gets
 * the profile reference with phone ID 1.
 *
 * @b NOTE: For creating profiles, use taf_dcs_GetProfileEx() followed by taf_dcs_CreateProfile().
 *
 * @return
 *  - NULL -- Error.
 *  - Others -- The profile reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Profile GetProfile
(
    uint32 profileId                        IN ///< The profile index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the profile reference for the given phone ID and profile ID.
 *
 * @return
 *  - NULL -- Error.
 *  - Others -- The profile reference.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Profile GetProfileEx
(
    uint8 phoneId IN,   ///< The phone ID.
    uint32 profileId IN ///< The profile ID. <br>
                        ///< Pass #TAF_DCS_UNDEFINED_PROFILE_ID to indicate the profile will be
                        ///< created by calling taf_dcs_CreateProfile().
                        ///< The API sets #TAF_DCS_TECH_3GPP and #TAF_DCS_PDP_IPV4 for technology
                        ///< and PDP respectively.<br>
                        ///< After creating the profile, clients can call taf_dcs_GetProfileId()
                        ///< to get the created profile's ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Creates a new profile on the device.<br>
 * On successful creation of profile, the profile reference will be updated with the created profile
 * ID. Clients can use taf_dcs_GetProfileId() to get the created profile ID.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_DUPLICATE -- Profile already created.
 *  - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t CreateProfile
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the profile with the given reference. Once a profile is deleted, the profile reference is
 * no longer valid.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_NOT_FOUND -- Profile reference was not found.
 *  - LE_BUSY -- Profile connection state is not DISCONNECTED. App should stop data and then delete
 *               the profile.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteProfile
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the profile index for the given profile reference.
 *
 * @b NOTE: This API will be depreacted. Please use taf_dcs_GetProfileId().
 *
 * @return
 *  - uint32 -- The profile index.
      0 -- Failed
 */
//--------------------------------------------------------------------------------------------------
FUNCTION uint32 GetProfileIndex
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the profile ID for the given profile reference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Profile reference was not found.
 *  - Others -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetProfileId
(
    Profile profileRef IN,  ///< The profile reference.
    uint32 profileId   OUT  ///< The profile ID. <br>
                            ///< #TAF_DCS_UNDEFINED_PROFILE_ID indicates the profile is not yet
                            ///< created.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the phone ID for the given profile reference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_NOT_FOUND -- Profile reference was not found.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPhoneId
(
    Profile profileRef                      IN,  ///< The profile reference.
    uint8 phoneId                           OUT  ///< The phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the data profile APN name.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Profile reference was not found.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAPN
(
    Profile profileRef                      IN, ///< The profile reference.
    string  apnName[APN_NAME_MAX_LEN]       IN  ///< The APN name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile APN name.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_OVERFLOW -- Apn size is smaller than APN_NAME_MAX_BYTES.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAPN
(
    Profile profileRef                      IN, ///< The profile reference.
    string  apnName[APN_NAME_MAX_LEN]       OUT ///< The APN name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the data profile name.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Profile reference was not found.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetProfileName
(
    Profile profileRef                      IN, ///< The profile reference.
    string  name[NAME_MAX_LEN]              IN  ///< The profile name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile name.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_OVERFLOW -- Apn size is smaller than APN_NAME_MAX_BYTES.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetProfileName
(
    Profile profileRef                      IN, ///< The profile reference.
    string  name[NAME_MAX_LEN]              OUT ///< The profile name.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the data profile technology preference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Profile reference was not found.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetTechPreference
(
    Profile profileRef                      IN, ///< The profile reference.
    Tech    techPref                        IN  ///< The technology preference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile technology preference.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Profile reference was not found.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetTechPreference
(
    Profile profileRef                      IN, ///< The profile reference.
    Tech    techPref                       OUT  ///< The technology preference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the data profile APN type.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetApnTypes
(
    Profile profileRef                      IN, ///< The profile reference.
    ApnType  apnType                        IN ///< The APN type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile APN types.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetApnTypes
(
    Profile profileRef                      IN, ///< The profile reference.
    ApnType  apnType                        OUT ///< The APN type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the data profile PDP type.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Profile reference was not found.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetPDP
(
    Profile profileRef                      IN, ///< The profile reference.
    Pdp     pdp                             IN  ///< The PDP type.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile PDP type.
 *
 * @return
 *  - TAF_DCS_PDP_UNKNOWN -- Unknown.
 *  - TAF_DCS_PDP_IPV4 -- IPV4.
 *  - TAF_DCS_PDP_IPV6 -- IPV6.
 *  - TAF_DCS_PDP_IPV4V6 -- IPV4 and IPV6.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION Pdp GetPDP
(
    Profile profileRef                      IN ///< The profile reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Set the data profile authentication type and username/password.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Could not retrieve the profile information.
 *  - LE_FAULT -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetAuthentication
(
    Profile profileRef                      IN, ///< The profile reference.
    Auth    auth                            IN, ///< The authentication type.
    string  userName[USER_NAME_MAX_LEN]     IN, ///< The username.
    string  password[PASSWORD_NAME_MAX_LEN] IN  ///< The password.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile authentication type and username/password.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_OUT_OF_RANGE -- The size of username or password is invalid.
 *  - LE_NOT_FOUND -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetAuthentication
(
    Profile profileRef                      IN,  ///< The profile reference.
    Auth    auth                            OUT, ///< The authentication type.
    string  userName[USER_NAME_MAX_LEN]     OUT, ///< The username.
    string  password[PASSWORD_NAME_MAX_LEN] OUT  ///< The password.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the data profile index by the interface name.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_NOT_FOUND -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetProfileIdByInterfaceName
(
    string        ifName[NAME_MAX_LEN]      IN, ///< The interface name.
    uint32        profileId                 OUT ///< The profile index.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the phone ID by the interface name.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_BAD_PARAMETER -- Bad parameter.
 *  - LE_NOT_FOUND -- Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPhoneIdByInterfaceName
(
    string        ifName[NAME_MAX_LEN]      IN,  ///< The interface name.
    uint8         phoneId                   OUT  ///< The phone ID.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv6 mask.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv6SubnetMask
(
    Profile profileRef                      IN, ///< The profile reference.
    uint32  mask                            OUT ///< The IPv6 mask.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the connected data session IPv4 mask.
 *
 * @return
 *  - LE_OK -- Succeeded.
 *  - LE_NOT_FOUND -- Failed.
 *  - LE_NOT_POSSIBLE -- Data profile is not yet created.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetIPv4SubnetMask
(
    Profile profileRef                      IN, ///< The profile reference.
    uint32  mask                            OUT ///< The IPv4 mask.
);
