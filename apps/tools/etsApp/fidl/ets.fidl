	<**
		@description : Reset interface to default values.
	**>
	method resetInterface fireAndForget { }

	<**
		@description : Suspend inteface by stopping offer and resume afterwards. 
	**>
	method suspendInterface fireAndForget {
		in {
			<**
				@description : Wait time before triggering the suspend request.
			**>
			UInt32 suspendInterface_ReqArg1
			<**
				@description : After this time resume the offer service.
			**>
			UInt32 suspendInterface_ReqArg2
		}
	}

	<**
		@description : Requests to trigger an broadcast event of type uint8.
	**>
	method triggerEventUINT8 fireAndForget {
		in {
			<**
				@description : Wait time before triggering the event.
			**>
			UInt32 triggerEventUINT8_ReqArg1
			<**
				@description : Trigger event shall be active for this period.
			**>
			UInt32 triggerEventUINT8_ReqArg2
			<**
				@description : Event shall be triggered with ths periodicity.
			**>
			UInt32 triggerEventUINT8_ReqArg3
		}
	}

