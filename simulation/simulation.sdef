//--------------------------------------------------------------------------------------------------
// TelAF Simulation system definition that includes essential services.
//--------------------------------------------------------------------------------------------------

#include "$LEGATO_ROOT/legatoTargetConfig.sinc"

apps:
{
    $SIMULATION_ROOT/stub/taf_simula_pm/tafPMSvc
    $SIMULATION_ROOT/bypass/telaf/tafmodule

    // from --> $TELAF_ROOT/apps/tafServices/tafKeyStoreSvc
    $SIMULATION_ROOT/stub/keyStore/tafKeyStoreSvc

#if ${TELAF_SIMULATION_ENABLE_SOMEIP_GW} = y
    $TELAF_ROOT/apps/tafServices/tafSomeipGWSvc
#endif

#if ${TELAF_SIMULATION_ENABLE_SMS} = y
    $TELAF_ROOT/apps/tafServices/tafSMSSvc
#endif

#if ${TELAF_SIMULATION_ENABLE_DCS} = y
    $TELAF_ROOT/apps/tafServices/tafDataCallSvc
#endif

#if ${TELAF_SIMULATION_ENABLE_SIM} = y
    // from --> $TELAF_ROOT/apps/tafServices/tafSimCardSvc
    $SIMULATION_ROOT/bypass/telsdk/tafSimCardSvc
#endif

#if ${TELAF_SIMULATION_ENABLE_LOC} = y
    $TELAF_ROOT/apps/tafServices/tafLocationSvc
    $SIMULATION_ROOT/bypass/telsdk/gnssTool
#endif

#if ${TELAF_SIMULATION_ENABLE_RADIO} = y
    // from --> $TELAF_ROOT/apps/tafServices/tafRadioSvc
    $SIMULATION_ROOT/stub/taf_simula_radio/tafRadioSvc
#endif

#if ${TELAF_SIMULATION_ENABLE_MNGD_CONN} = y
    $TELAF_ROOT/apps/tafMngdServices/Connectivity/tafMngdConnSvc
#endif

#if ${TELAF_SIMULATION_ENABLE_RPC} = y
    $TELAF_ROOT/apps/rpc/rpcProxy/tafRpcProxy
#endif

#if ${TELAF_SIMULATION_ENABLE_MNGD_STRG} = y
    $TELAF_ROOT/apps/tafMngdServices/Storage/tafMngdStorageSvc
#endif

#if ${TELAF_SIMULATION_ENABLE_DIAG} = y
    $TELAF_ROOT/apps/tafServices/tafDiagSvc
    // from --> $TELAF_ROOT/apps/tafServices/tafUpdateSvc
    $SIMULATION_ROOT/stub/taf_simula_update/tafUpdateSvc
#endif

#if ${TELAF_SIMULATION_ENABLE_ECALL} = y
    $TELAF_ROOT/apps/tafServices/tafECallSvc
    $SIMULATION_ROOT/stub/taf_simula_audio/tafAudioSvc.adef
    $SIMULATION_ROOT/stub/taf_simula_gpio/tafGpioSvc.adef
#endif

    $LEGATO_ROOT/apps/sample/helloIpc/printClient
    $LEGATO_ROOT/apps/sample/helloIpc/printServer


    // --- Test Apps ---
    // $TELAF_ROOT/apps/test/tafSomeipGWTest/tafSomeipClntUnitTest/tafSomeipClntUnitTest
    // $TELAF_ROOT/apps/test/tafSomeipGWTest/tafSomeipSvrUnitTest/tafSomeipSvrUnitTest
    // $TELAF_ROOT/apps/test/tafSmsTest/tafSMSUnitTest
    // $TELAF_ROOT/apps/test/tafDataCallTest/tafDataCallUnitTest/tafDataCallUnitTest
    // $TELAF_ROOT/apps/test/tafSimTest/tafSimUnitTest/tafSimUnitTest
    // $TELAF_ROOT/apps/test/tafLocationTest/tafLocationUnitTest/tafLocationUnitTest
    // $TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdConnUnitTest/tafMngdConnUnitTest
    // $TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdConnIntTest/tafMngdConnIntTest
    // $TELAF_ROOT/apps/rpc/rpcTest/helloRpcServer/RpcPrintServer
    // $TELAF_ROOT/apps/rpc/rpcTest/helloRpcClient/RpcPrintClient
    // $TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdStorageUnitTest/tafMngdStorageUnitTest
    // $TELAF_ROOT/apps/tafMngdServices/tafMngdTest/tafMngdStorageUnitTest/tafMngdSecSharedApp
    // $TELAF_ROOT/apps/sample/diagApp/tafDiagApp
    // $TELAF_ROOT/apps/sample/diagEventApp/tafDiagEventApp
    // $TELAF_ROOT/apps/sample/diagCfg/tafDiagCfgSample
    // $TELAF_ROOT/apps/sample/diagCancelFileXfer/tafDiagCancelFileXfer
    // $TELAF_ROOT/apps/test/tafSomeipGWTest/multiRoutingManagersTest/multiRoutMgrsTestAppB
    // $TELAF_ROOT/apps/test/tafSomeipGWTest/multiRoutingManagersTest/multiRoutMgrsTestAppA
    // $TELAF_ROOT/apps/sample/eCallDemo/tafECallApp
    // $TELAF_ROOT/apps/test/tafECallTest/tafECallUnitTest/tafECallUnitTest
}

commands:
{
#if ${TELAF_SIMULATION_ENABLE_LOC} = y
    gnss = gnssTool:/bin/gnss
#endif

    tafmodule = tafmodule:/bin/tafmodule
}

bindings:
{
    <telaf>.DeviceManager -> <tafcore>.DeviceManager
    <telaf>.DeviceManagerTool -> <tafcore>.DeviceManagerTool
    <telaf>.sdirTool -> <tafcore>.sdirTool
}

interfaceSearch:
{
    $TELAF_ROOT/interfaces
    $TELAF_ROOT/interfaces/staging
    $TELAF_ROOT/interfaces/tafVNW
    $TELAF_ROOT/interfaces/someipGW
    $TELAF_ROOT/apps/tafMngdServices/interfaces
    $LEGATO_ROOT/apps/sample/helloIpc

#if ${TELAF_SIMULATION_ENABLE_RPC} = y
    $TELAF_ROOT/apps/rpc/rpcTest
#endif
}

cflags:
{
    -DTARGET_SA525M
}

cxxflags:
{
    -DTARGET_SA525M
}
