sandboxed: false

start: auto

maxThreads: 600

username: telaf

startGroup: 0

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_ADMIN
#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
#endif
        CAP_DAC_OVERRIDE
}

executables:
{
    tafDiagSvc = ( $TELAF_ROOT/components/tafDiagSvc )
}

groups:
{
}

processes:
{
    run:
    {
        (tafDiagSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
#if ${LE_CONFIG_DIAG_VSTACK} = y
    tafDiagSvc.tafDiagSvc.taf_diagBackend -> tafDiagBackendSvc.taf_diagBackend
#endif
}

extern:
{
    tafDiagSvc.tafDiagSvc.taf_diagDataID
    tafDiagSvc.tafDiagSvc.taf_diagSecurity
    tafDiagSvc.tafDiagSvc.taf_diagUpdate
    tafDiagSvc.tafDiagSvc.taf_diagReset
    tafDiagSvc.tafDiagSvc.taf_diagRoutineCtrl
    tafDiagSvc.tafDiagSvc.taf_diagIOCtrl
    tafDiagSvc.tafDiagSvc.taf_diag
    tafDiagSvc.tafDiagSvc.taf_diagIDPS
#if ${LE_CONFIG_DIAG_VSTACK} = ""
    tafDiagSvc.tafDiagSvc.taf_diagEvent
    tafDiagSvc.tafDiagSvc.taf_diagDTC
    tafDiagSvc.tafDiagSvc.taf_diagDoIP
    tafDiagSvc.tafDiagSvc.taf_diagAuth
#endif
}
