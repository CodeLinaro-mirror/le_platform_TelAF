externalBuild:
{
    "capicxx-core-gen -sk $TELAF_ROOT/apps/ivss/fidl/MngdConnSvc/MngdConnSvc.fidl"
    "capicxx-core-gen -sk $TELAF_ROOT/apps/ivss/fidl/MngdConnSvc/MngdConnSvc.fdepl"
    "capicxx-someip-gen $TELAF_ROOT/apps/ivss/fidl/MngdConnSvc/MngdConnSvc.fdepl"
    "bash $TELAF_ROOT/apps/ivss/common/make.sh DataSvc"
}

bundles:
{
    file:
    {
        $BUILDDIR/build/libDataSvc-someip.so   /lib/
    }
}

provides:
{
    headerDir:
    {
        $BUILDDIR/src-gen
    }
}
