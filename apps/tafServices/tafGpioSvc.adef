maxThreads: 600

username: telaf

startGroup: 25

capability:
{
        CAP_WAKE_ALARM
        CAP_SYS_MODULE
        CAP_BLOCK_SUSPEND
#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafGpioSvc = ( $TELAF_ROOT/components/tafGpioSvc )
}
start: auto

processes:
{
    run:
    {
        (tafGpioSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bundles:
{
    file:
    {
        [rw]     $TELAF_ROOT/components/tafGpioSvc/gpioWakeupPin.conf     /
    }
}

bindings:
{
}

extern:
{
    tafGpioSvc.tafGpioSvc.taf_gpio
}
