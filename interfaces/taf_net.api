/**
 * @page c_tafNetwork Network Service
 *
 * @ref taf_net_interface.h "API Reference"
 *
 * <HR>
 *
 * Network service is a data network configuration service. It provides unified TelAF networking
 * APIs for configuration.
 *
 * Network service provides APIs for applications to manage route, gateway, DNS, NAT, GSB, VLAN,
 * Socksv5, L2tp, filter and firewall.
 *
 * @section c_taf_net_binding IPC interfaces binding
 *
 * All the functions of this API are provided by the @b tafNetSvc application service.
 *
 * Here's a sample of how to bind to Network service:
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_net -> tafNetSvc.taf_net
   }
   @endverbatim
 *
 * @section c_taf_net_route_management Route management
 *
 * Route can be changed by using taf_net_ChangeRoute with interface name, destination address,
 * prefix length, metric, isAdd passed as parameters.
 *
 * Here's a sample of how to change a route. In this example, it will add a route with interface
 * "eth0", destination address "192.168.10.0", subnet mask "255.255.255.0", metric 0.
 * @verbatim
   result=taf_net_ChangeRoute("eth0","192.168.10.0",24,0,TAF_NET_ADD);
   @endverbatim
 *
 * Before changing the route, an application can register a state handler using
 * taf_net_AddRouteChangeHandler(). Once the route is changed, the handler will be called.
 * @verbatim
   routeChangeHandlerRef = taf_net_AddRouteChangeHandler(
                           (taf_net_RouteChangeHandlerFunc_t)NetRouteChangeHandlerFunc, NULL);
   @endverbatim
 *
 * To remove the handler, an application can use
 * taf_net_RemoveRouteChangeHandler(routeChangeHandlerRef);
 *
 * @section c_taf_net_gateway_management Gateway management
 *
 * Gateway management provides APIs to set, backup, restore system default gateway, and query
 * interface gateway, including IPV4 address and IPV6 address.
 *
 * Default gateway can be set by using taf_net_SetDefaultGW with interface name passed as parameter.
 * The gateway addresses of the interface will be retrieved and set into the system.
 *
 * Here's a sample of how to set default gateway. In this example, it will set system default gateways
 * with gateway addresses from interface "rmnet_data1", including IPV4 and IPV6 gateways:
 * @verbatim
   result=taf_net_SetDefaultGW("rmnet_data1");
   @endverbatim
 *
 * Before setting the default gateway, an application can register a state handler using
 * taf_net_AddGatewayChangeHandler(). Once the default gateway is set, the handler will be called.
 * @verbatim
   gatewayChangeHandlerRef = taf_net_AddGatewayChangeHandler(
                           (taf_net_GatewayChangeHandlerFunc_t)NetGatewayChangeHandlerFunc, NULL);
   @endverbatim
 *
 * To remove the handler, an application can use
 * taf_net_RemoveGatewayChangeHandler(gatewayChangeHandlerRef);
 *
 * The following APIs are supported for gateway management
 *
 * - taf_net_SetDefaultGW()    -- Sets system default gateway.
 * - taf_net_GetInterfaceGW()    -- Gets interface gateway.
 * - taf_net_BackupDefaultGW()   -- Backups system gateway.
 * - taf_net_RestoreDefaultGW()  -- Restores system gateway.
 * - taf_net_AddGatewayChangeHandler()  -- Adds a handler for gateway change.
 * - taf_net_RemoveGatewayChangeHandler()  -- Removes a handler for gateway change.
 *
 * @section c_taf_net_DNS_management DNS management
 *
 * DNS can be set by using taf_net_SetDNS with interface name, passed as parameter.
 * The DNS addresses of the interface will be retrieved and set into the system including
 * primary IPV4 and IPV6 addresses and secondary IPV4 and IPV6 addresses.
 *
 * Here's a sample of how to set DNS. In this example, it will set system DNS addresses with DNS
 * addresses from interface "rmnet_data1", including IPV4 and IPV6 DNS addresses:
 * @verbatim
   result=taf_net_SetDNS("rmnet_data1");
   @endverbatim
 *
 * Before setting the DNS, an application can register a state handler using
 * taf_net_AddDNSChangeHandler(). Once the DNS is set, the handler will be called.
 * @verbatim
   DNSChangeHandlerRef = taf_net_AddDNSChangeHandler(
                           (taf_net_DNSChangeHandlerFunc_t)NetDNSChangeHandlerFunc, NULL);
   @endverbatim
 *
 * To remove the handler, an application can use
 * taf_net_RemoveDNSChangeHandler(DNSChangeHandlerRef).
 *
 * taf_net_GetInterfaceDNS() can be used to query the interface DNS addresses, including primary
 * IPV4 and IPV6 addresses and secondary IPV4 and IPV6 addresses.
 *
 * @section c_taf_net_DestNat_management Static destination NAT management.
 *
 * Static destination NAT can be added, removed, retrieved for default PDN and on-demand PDN.
 *
 * Static destination NAT can be added by using taf_net_AddDestNatEntryOnDefaultPdn with
 * private IP address, private port, global port, IP protocol type, passed as parameter.
 * The destination NAT will be added into iptables if the default PDN is brought up.
 *
 * Here's a sample of how to add a static destination NAT entry on default PDN. In this example,
 * it will add a static destination NAT entry on default PDN with private ip address
 * "192.168.225.30", private port 5000, global port 5000 and TCP protocol type:
 * @verbatim
   result=taf_net_AddDestNatEntryOnDefaultPdn("192.168.225.30", 5000, 5000, TAF_NET_TCP);
   @endverbatim
 *
 * The following APIs are supported for NAT management
 *
 * - taf_net_AddDestNatEntryOnDefaultPdn()      -- Adds destination NAT for default PDN.
 * - taf_net_RemoveDestNatEntryOnDefaultPdn()   -- Removes destination NAT for default PDN.
 * - taf_net_AddDestNatEntryOnDemandPdn()       -- Adds destination NAT for on-demand PDN.
 * - taf_net_RemoveDestNatEntryOnDemandPdn()    -- Removes destination NAT for on-demand PDN.
 * - taf_net_GetDestNatEntryListOnDefaultPdn()  -- Gets the reference of destination NAT entry list.
 * - taf_net_GetDestNatEntryListOnDemandPdn()   -- Gets the reference of destination NAT entry list.
 * - taf_net_GetFirstDestNatEntry()  -- Gets the reference of the first destination NAT entry.
 * - taf_net_GetNextDestNatEntry()   -- Gets the reference of the next destination NAT entry.
 * - taf_net_GetDestNatEntryDetails()  -- Gets the details of destination NAT entry.
 * - taf_net_DeleteDestNatEntryList()  -- Deletes the reference of destination NAT entry list.
 * - taf_net_AddDestNatChangeHandler()  -- Adds a handler for NAT change.
 * - taf_net_RemoveDestNatChangeHandler()  -- Removes a handler for NAT change.

 * @note When adding a static destination NAT entry, and then changing the default profile ID, the
 * static destination NAT entry will be changed accordingly.
 *
 * @note After binding VLAN with the profile id, the corresponding destination NAT for
 * on-demand PDN can be added into iptables.
 *
 * @section c_taf_net_Vlan_management VLAN management
 *
 * VLAN management provides APIs for VLAN creation, VLAN binding and VLAN information query.
 *
 * VLAN can be created using taf_net_CreateVlan with VLAN Id and isAccelerated passed as parameters.
 * After VLAN is created, the application can use taf_net_AddVlanInterface to add VLAN
 * interface, and then use taf_net_BindVlanWithProfile to bind VLAN with profile.
 *
 * Here's a sample of how to create a VLAN. In this example, it will create a VLAN with VLAN ID 5,
 * and the VLAN will not be accelerated. The return value is VLAN reference:
 * @verbatim
   vlanReference = taf_net_CreateVlan(5, false);
   if (!vlanReference)
   {
      LE_INFO("isAccelerated conflicts with old value");
      return LE_FAULT;
   }
   @endverbatim
 *
 * The following APIs are supported for VLAN
 *
 * - taf_net_CreateVlan()       -- Creates a VLAN.
 * - taf_net_RemoveVlan()       -- Removes a VLAN.
 * - taf_net_GetVlanById()      -- Gets a VLAN reference.

 * VLAN interface can be added using taf_net_AddVlanInterface with VLAN reference and interface
 * type, passed as parameter.
 *
 * Here's a sample of how to add a VLAN interface, In this example, it will add a VLAN interface
 * into VLAN with interface type TAF_NET_ETH:
 * @verbatim
   result = taf_net_AddVlanInterface(vlanReference, TAF_NET_ETH);
   @endverbatim
 *
 * The following APIs are supported for VLAN interface
 *
 * - taf_net_AddVlanInterface()       -- Adds a VLAN interface.
 * - taf_net_RemoveVlanInterface()    -- Removes a VLAN interface.
 * - taf_net_GetVlanInterfaceList()   -- Gets the reference of the VLAN interface list.
 * - taf_net_GetFirstVlanInterface()  -- Gets the reference of the first VLAN interface.
 * - taf_net_GetNextVlanInterface()   -- Gets the reference of the next VLAN interface.
 * - taf_net_DeleteVlanInterfaceList()   -- Deletes the reference of the VLAN interface list.
 * - taf_net_GetVlanInterfaceType()   -- Gets the VLAN interface type.
 *
 * @note When adding a VLAN interface for a VLAN with isAccelerated as true, if the interface is
 * the first added for the interface type in the system, the system will be rebooted automatically
 * after 5 seconds.
 *
 * @note When deleting a VLAN interface for a VLAN with isAccelerated as true, if the interface is
 * the last deleted for the interface type in the system, the system will be rebooted automatically
 * after 5 seconds.
 *
 * The following APIs are supported for VLAN information retrieving.
 *
 * - taf_net_GetVlanEntryList()       -- Gets the reference of the VLAN entry list.
 * - taf_net_GetFirstVlanEntry()      -- Gets the reference of the first VLAN entry.
 * - taf_net_GetNextVlanEntry()       -- Gets the reference of the next VLAN entry.
 * - taf_net_DeleteVlanEntryList()    -- Deletes the reference of the VLAN entry list.
 * - taf_net_GetVlanId()              -- Gets the VLAN id.
 * - taf_net_IsVlanAccelerated()      -- Checks if the VLAN is accelerated.
 * - taf_net_GetVlanBoundProfileId()  -- Gets the profile id bound with this VLAN.
 *
 * VLAN can be bound with profile by using taf_net_BindVlanWithProfile with VLAN reference and
 * profile id passed as parameter.
 *
 * Here's a sample of how to bind VLAN with profile. In this example, it will bind VLAN with
 * profile id 5:
 * @verbatim
   result = taf_net_BindVlanWithProfile(vlanReference, 5);
   @endverbatim
 *
 * The API taf_net_UnbindVlanFromProfile can be used to unbind VLAN from profile.
 *
 * @note If binding VLAN with default profile id, the system will auto reboot after 5 seconds.
 *
 * @note If unbinding VLAN from default profile id, the system will auto reboot after 5 seconds.
 *
 * @section c_taf_net_L2TP_management L2TP management
 *
 * L2TP management provides APIs for enabling and disabling L2TP, creating and removing tunnel,
 * adding and removing session, setting UDP port, starting and stopping tunnel, querying L2TP
 * information etc.
 *
 * Tunnel can be created by using taf_net_CreateTunnel. After creating tunnel, the application can
 * use taf_net_SetTunnelUdpPort to set UDP port for UDP encapsulation protocol, taf_net_AddSession
 * to add session into tunnel, and then use taf_net_StartTunnel to start this tunnel.
 *
 * Here's a sample of how to create a tunnel. In this example, it will create a tunnel with IP
 * encapsulation protocol, local tunnel id 1, peer tunnel id 1, peer IP address fd53:7cb8:383:5::2
 * and interface name eth0.5. The return value is the tunnel reference:
 * @verbatim
   tunnelReference = taf_net_CreateTunnel(TAF_NET_L2TP_IP, 1, 1, "fd53:7cb8:383:5::2", "eth0.5");
   if (!tunnelReference)
   {
      LE_INFO("Failed to create a tunnel");
      return LE_FAULT;
   }
   @endverbatim
 *
 * An application can synchrounously start a tunnel using taf_net_StartTunnel with tunnel
 * reference passed as parameter.
 *
 * @verbatim
   result = taf_net_StartTunnel(tunnelReference);
   if (result !LE_OK)
   {
      LE_INFO("Failed to start a tunnel");
      return LE_FAULT;
   }
   @endverbatim
 *
 * An application can asynchrounously start a tunnel using taf_net_StartTunnelAsync with tunnel
 * reference and handler function passed as parameters.
 *
 * @verbatim
   taf_net_StartTunnelAsync(tunnelRef,StartTunnelAsyncHandlerFunc,NULL);
   @endverbatim
 *
 * Before asynchrounously starting a tunnel, an application defines a handler function. Once the
 * tunnel is started, the handler function will be called.
 *
 * @verbatim
   void StartTunnelAsyncHandlerFunc(taf_net_TunnelRef_t tunnelRef,
                                    le_result_t result,
                                    void* contextPtr)
   {
       LE_INFO("**** Handler for Start Tunnel Asynchronously (Begin)****");
       LE_INFO("tunnelRef= %p, result: %d", tunnelRef, result);
       LE_INFO("**** Handler for Start Tunnel Asynchronously (End)****");
   }
   @endverbatim
 *
 * The following APIs are supported for tunnel configuration.
 *
 * - taf_net_CreateTunnel()       -- Creates a tunnel.
 * - taf_net_RemoveTunnel()       -- Removes a tunnel.
 * - taf_net_SetTunnelUdpPort()   -- Sets UDP port for a tunnel.
 * - taf_net_AddSession()         -- Adds session into a tunnel.
 * - taf_net_RemoveSession()      -- Removes session from a tunnel.
 * - taf_net_StartTunnel()        -- Synchronously starts a tunnel.
 * - taf_net_StartTunnelAsync()   -- Asynchronously starts a tunnel.
 * - taf_net_StopTunnel()         -- Synchronously stops a tunnel.
 * - taf_net_StopTunnelAsync()    -- Asynchronously stops a tunnel.
 * - taf_net_GetTunnelRefById()   -- Gets a tunnel reference.
 *
 * The following APIs are supported for tunnel information retrieving.
 *
 * - taf_net_GetTunnelEntryList()       -- Gets the reference of the tunnel entry list.
 * - taf_net_GetFirstTunnelEntry()      -- Gets the reference of the first tunnel entry.
 * - taf_net_GetNextTunnelEntry()       -- Gets the reference of the next tunnel entry.
 * - taf_net_DeleteTunnelEntryList()    -- Deletes the reference of the tunnel entry list.
 * - taf_net_GetTunnelEncapProto()      -- Gets encapsulation protocol of a tunnel.
 * - taf_net_GetTunnelLocalId()         -- Gets local id of a tunnel.
 * - taf_net_GetTunnelPeerId()          -- Gets peer id of a tunnel.
 * - taf_net_GetTunnelLocalUdpPort()    -- Gets local UDP port of a tunnel.
 * - taf_net_GetTunnelPeerUdpPort()     -- Gets peer UDP port of a tunnel.
 * - taf_net_GetTunnelPeerIpv6Addr()    -- Gets peer IP v6 address of a tunnel.
 * - taf_net_GetTunnelPeerIpv4Addr()    -- Gets peer IP v4 address of a tunnel.
 * - taf_net_GetTunnelInterfaceName()   -- Gets interface name of a tunnel.
 * - taf_net_GetTunnelIpType()          -- Gets IP type of a tunnel.
 * - taf_net_GetSessionConfig()         -- Gets session config of a tunnel.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

USETYPES taf_types.api;

//--------------------------------------------------------------------------------------------------
/**
 * The interface name maximum number.
 */
//--------------------------------------------------------------------------------------------------
DEFINE INTERFACE_NAME_MAX_NUM = 36;

//--------------------------------------------------------------------------------------------------
/**
 * The interface name maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE INTERFACE_NAME_MAX_LEN = 30;

//--------------------------------------------------------------------------------------------------
/**
 * The IPv4 address maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IPV4_ADDR_MAX_LEN = 16;

//--------------------------------------------------------------------------------------------------
/**
 * The IPv6 address maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IPV6_ADDR_MAX_LEN = 46;

//--------------------------------------------------------------------------------------------------
/**
 * The IP address maximum length.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  IP_ADDR_MAX_LEN = IPV6_ADDR_MAX_LEN;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum number of entries in the NAT memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_NAT_ENTRY = (50);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum entry for VLAN memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_VLAN_ENTRY = (100);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum entry list for VLAN memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_VLAN_ENTRY_LIST = (2);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum interface for VLAN memory pool.
 */
//--------------------------------------------------------------------------------------------------
DEFINE  MAX_VLAN_INTERFACE = (5);

//--------------------------------------------------------------------------------------------------
/**
 * The maximum tunnel number.
 */
//--------------------------------------------------------------------------------------------------
DEFINE L2TP_MAX_TUNNEL_NUMBER = 2;

//--------------------------------------------------------------------------------------------------
/**
 * The maximum session per tunnel.
 */
//--------------------------------------------------------------------------------------------------
DEFINE L2TP_MAX_SESSION_NUMBER_PER_TUNNEL = 3;


//--------------------------------------------------------------------------------------------------
/**
 * IP protocol.
 */
//--------------------------------------------------------------------------------------------------
ENUM IpProto
{
    TCP = 6,                    ///< TCP.
    UDP = 17                    ///< UDP.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network action.
 */
//--------------------------------------------------------------------------------------------------
ENUM NetAction
{
    DELETE,                     ///< Deletion operation.
    ADD                         ///< Addition operation.
};

//--------------------------------------------------------------------------------------------------
/**
 * Network IP type.
 */
//--------------------------------------------------------------------------------------------------
ENUM NetIpType
{
    IPV4,                       ///< IPV4.
    IPV6                        ///< IPV6.
};

//--------------------------------------------------------------------------------------------------
/**
 * The technology.
 */
//--------------------------------------------------------------------------------------------------
ENUM TechType
{
    TECH_CELLULAR,              ///< CELLULAR.
    TECH_WIFI,                  ///< WIFI.
    TECH_ETHERNET               ///< ETHERNET.
};

//--------------------------------------------------------------------------------------------------
/**
 * The state.
 */
//--------------------------------------------------------------------------------------------------
ENUM State
{
    STATE_DOWN,                 ///< DOWN.
    STATE_UP                    ///< UP.
};

//--------------------------------------------------------------------------------------------------
/**
 * L2TP encapsulation protocols.
 */
//--------------------------------------------------------------------------------------------------
ENUM L2tpEncapProtocol
{
    L2TP_NONE,
    L2TP_IP,                      // IP Protocol used for encapsulation.
    L2TP_UDP                      // UDP Protocol used for encapsulation.
};

//--------------------------------------------------------------------------------------------------
/**
 * Preferred IP family for the connection.
 */
//--------------------------------------------------------------------------------------------------
ENUM IpFamilyType
{
    L2TP_UNKNOWN = -1,
    L2TP_IPV4 = 0x04,             // IPv4 data connection.
    L2TP_IPV6 = 0x06,             // IPv6 data connection.
    L2TP_IPV4V6 = 0x0A,           // IPv4 and IPv6 data connection.
};

//--------------------------------------------------------------------------------------------------
/**
 * The VLAN interface type
 */
//--------------------------------------------------------------------------------------------------
ENUM VlanIfType
{
    IFACE_UNKNOWN,              ///< UNKNOWN interface.
    WLAN,                       ///< Wireless Local Area Network (WLAN).
    ETH,                        ///< Ethernet (ETH).
    ECM,                        ///< Ethernet Control Model (ECM).
    RNDIS,                      ///< Remote Network Driver Interface Specification (RNDIS).
    MHI                         ///< Modem Host Interface (MHI).
};

//--------------------------------------------------------------------------------------------------
/**
 * Binding action.
 */
//--------------------------------------------------------------------------------------------------
ENUM BindingAction
{
    BIND,                       ///< Bind.
    UNBIND                      ///< Unbind.
};

//--------------------------------------------------------------------------------------------------
/**
 * The device mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM DeviceMode
{
    DEVICE_UNKNOWN = -1,        ///< UNKNOWN.
    DEVICE_NONE,                ///< NONE.
    DEVICE_L2L,                 ///< Device Lan to Lan mode.
    DEVICE_E2E                  ///< Device End to End mode.
};

//--------------------------------------------------------------------------------------------------
/**
 * The destination NAT change indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DestNatChangeInd
{
    uint32  profileId;                        ///< Profile ID.
    NetAction action;                         ///< Add or delete.
};

//--------------------------------------------------------------------------------------------------
/**
 * The interface information.
 */
//--------------------------------------------------------------------------------------------------
STRUCT InterfaceInfo
{
    string       interfaceName[INTERFACE_NAME_MAX_LEN];   ///< The interface name.
    TechType     tech;                                    ///< The technology.
    State        state;                                   ///< The state.
};

//--------------------------------------------------------------------------------------------------
/**
 * The DNS server addresses.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DnsServerAddresses
{
    string   ipv4Addr1[IPV4_ADDR_MAX_LEN];    ///< The first IPv4 DNS address.
    string   ipv4Addr2[IPV4_ADDR_MAX_LEN];    ///< The second IPv4 DNS address.
    string   ipv6Addr1[IPV6_ADDR_MAX_LEN];    ///< The first IPv6 DNS address.
    string   ipv6Addr2[IPV6_ADDR_MAX_LEN];    ///< The second IPv6 DNS address.
};

//--------------------------------------------------------------------------------------------------
/**
 * The route change indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT RouteChangeInd
{
    string interfaceName[INTERFACE_NAME_MAX_LEN];      ///< The interface name.
    string destAddr[IP_ADDR_MAX_LEN];                  ///< Destination IP address.
    string prefixLength[IP_ADDR_MAX_LEN];              ///< Destination's subnet mask or length.
    uint16 metric;                                     ///< Metric.
    NetAction action;                                  ///< Add or delete.
};

//--------------------------------------------------------------------------------------------------
/**
 * The gateway change indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT GatewayChangeInd
{
    string interfaceName[INTERFACE_NAME_MAX_LEN];      ///< The interface name.
    string gatewayAddr[IP_ADDR_MAX_LEN];               ///< Destination IP address.
    NetIpType ipType;                                  ///< IP type.
};

//--------------------------------------------------------------------------------------------------
/**
 * The DNS change indication.
 */
//--------------------------------------------------------------------------------------------------
STRUCT DNSChangeInd
{
    string ipAddr1[IP_ADDR_MAX_LEN];          ///< The first DNS address.
    string ipAddr2[IP_ADDR_MAX_LEN];          ///< The second DNS address.
    NetIpType ipType;                         ///< IP type.
};

//--------------------------------------------------------------------------------------------------
/**
 * L2TP tunnel session configuration.
 */
//--------------------------------------------------------------------------------------------------
STRUCT L2tpSessionConfig
{
    uint32 locId;                       ///< Local session id.
    uint32 peerId;                      ///< Peer session id.
};

//--------------------------------------------------------------------------------------------------
/**
 * Reference to a destination NAT entry list.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE DestNatEntryList;

//--------------------------------------------------------------------------------------------------
/*
 * Reference to a destination NAT entry.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE DestNatEntry;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a VLAN.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Vlan;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a VLAN entry list.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VlanEntryList;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a VLAN entry.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VlanEntry;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a VLAN interface list.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VlanIfList;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a VLAN interface.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE VlanIf;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a Tunnel entry list.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE TunnelEntryList;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a Tunnel entry.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE TunnelEntry;

//--------------------------------------------------------------------------------------------------
/**
 * The reference of a Tunnel.
 */
//--------------------------------------------------------------------------------------------------
REFERENCE Tunnel;

//--------------------------------------------------------------------------------------------------
/**
 * Handler for route change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER RouteChangeHandler
(
    RouteChangeInd routeInd IN                ///< Route indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report route change.
 */
//--------------------------------------------------------------------------------------------------
EVENT RouteChange
(
    RouteChangeHandler handler                ///< Handler for route change.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for gateway change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER GatewayChangeHandler
(
    GatewayChangeInd gatewayInd IN            ///< Gateway indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report gateway change.
 */
//--------------------------------------------------------------------------------------------------
EVENT GatewayChange
(
    GatewayChangeHandler handler              ///< Handler for gateway change.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for DNS change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER DNSChangeHandler
(
    DNSChangeInd DNSInd IN                    ///< DNS indication.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report DNS change.
 */
//--------------------------------------------------------------------------------------------------
EVENT DNSChange
(
    DNSChangeHandler handler                  ///< Handler for DNS change.
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for destination NAT change.
 */
//--------------------------------------------------------------------------------------------------
HANDLER DestNatChangeHandler
(
    DestNatChangeInd destNatInd IN            ///< Destination NAT indication.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Handler for asynchronous starting or stopping tunnel result response.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncTunnelHandler
(
    Tunnel       tunnelRef                    IN,  ///< Tunnel reference.
    le_result_t  result                       IN   ///< The result of starting or stopping tunnel.
);

//--------------------------------------------------------------------------------------------------
/**
 *  Handler for asynchronous enabling or disabling L2TP result response.
 *
 */
//--------------------------------------------------------------------------------------------------
HANDLER AsyncL2tpHandler
(
    le_result_t  result                       IN   ///< The result of enabling or disabling L2TP.
);

//--------------------------------------------------------------------------------------------------
/**
 * Event to report destination NAT change.
 */
//--------------------------------------------------------------------------------------------------
EVENT DestNatChange
(
    DestNatChangeHandler handler              ///< Handler for destination NAT change.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the interface infomation list.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceList
(
    InterfaceInfo ifInfoList[INTERFACE_NAME_MAX_NUM]  OUT ///< Interface information list.
);

//--------------------------------------------------------------------------------------------------
/**
 * Adds or removes a route.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ChangeRoute
(
    string interfaceName[INTERFACE_NAME_MAX_LEN]      IN, ///< The interface name.
    string destAddr[IP_ADDR_MAX_LEN]                  IN, ///< Destination IP address.
    string subnetMask[IP_ADDR_MAX_LEN]                IN, ///< Destination's subnet mask or length string.
    uint16 metric                                     IN, ///< Metric.
    NetAction isAdd                                   IN  ///< Add or delete.
);

//--------------------------------------------------------------------------------------------------
/**
 * Backs up the current default gateway of the system into DB, including both IPv4 and IPv6.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- No default gateway.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t BackupDefaultGW
(
);

//--------------------------------------------------------------------------------------------------

/**
 * Restores the default gateway of the system from the last backed up one, including IPv4 and/or IPv6.
 * Only gateways backed up and set by the same client session can be restored.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- No backup.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RestoreDefaultGW
(
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the default gateway address received from the interface into the system.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- No gateway address from the interface.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDefaultGW
(
    string  ifName[INTERFACE_NAME_MAX_LEN]    IN ///< The interface to retrieve the default gateway addresses from.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the gateway addresses from the specified interface.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- No gateway address from the interface.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceGW
(
    string  ifName[INTERFACE_NAME_MAX_LEN]           IN,  ///< Interaface name to get the gateway.
    string  ipv4Addr[IPV4_ADDR_MAX_LEN]              OUT, ///< IPv4 address.
    string  ipv6Addr[IPV6_ADDR_MAX_LEN]              OUT  ///< IPv6 address.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the DNS addresses received from the interface into the system.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- No DNS addresses from the interface.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetDNS
(
    string  ifName[INTERFACE_NAME_MAX_LEN]    IN ///< The interface from which to get the DNS addresses.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the DNS addresses from the interface, including IPv4 and IPv6 addresses.
 *
 * @return
 *   - LE_OK -- Success.
 *   - LE_NOT_FOUND -- Not found DNS addresses from the interface.
 *   - LE_BAD_PARAMETER -- Bad parameter.
 *   - LE_FAULT -- Failure.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInterfaceDNS
(
    string  ifName[INTERFACE_NAME_MAX_LEN]    IN, ///< The interaface name to get the DNS addresses.
    DnsServerAddresses  dnsServerAddresses    OUT ///< DNS addresses structure.
);

