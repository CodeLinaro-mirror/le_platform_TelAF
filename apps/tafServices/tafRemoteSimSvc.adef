maxThreads: 300

username: telaf

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
        tafRemoteSim = ( $TELAF_ROOT/components/tafRemoteSimSvc/RemoteSimDaemon)
        tafSAPCard = ( $TELAF_ROOT/components/tafRemoteSimSvc/SAPProvider)
}
start: manual

processes:
{
        run:
        {
                (tafRemoteSim)
                (tafSAPCard)
        }

        maxFileBytes: 8192K
        faultAction: restart
}

bindings:
{
        tafSAPCard.SAPProvider.taf_sim -> tafSimCardSvc.taf_sim
}
extern:
{
        tafRemoteSim.RemoteSimDaemon.taf_rsim
        tafSAPCard.SAPProvider.taf_sap
}
