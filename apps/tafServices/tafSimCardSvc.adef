maxThreads: 600

username: telaf

startGroup: 12

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
        tafSimCardSvc = ( $TELAF_ROOT/components/tafSimCardSvc )
}
start: auto

processes:
{
        run:
        {
                (tafSimCardSvc)
        }

        maxCoreDumpFileBytes: 100000K
        maxFileBytes: 100000K
        faultAction: restart
}

bindings:
{
    tafSimCardSvc.tafSimCardSvc.taf_pm -> tafPMSvc.taf_pm
}

extern:
{
        tafSimCardSvc.tafSimCardSvc.taf_sim
        tafSimCardSvc.tafSimCardSvc.taf_simRsp
}

