provides:
{
    api:
    {
        taf_net.api
        taf_netIpPass.api
    }
}

requires:
{
    api:
    {
        taf_dcs.api
    }

    lib:
    {
        lib/libtelux_tel.so
        lib/libtelux_data.so
    }

    component:
    {
        $LEGATO_ROOT/components/watchdogChain
        $TELAF_ROOT/components/stub/taf_pa_net
    }

}

cxxflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
    -I$TELAF_ROOT/include
    -I$TELAF_ROOT/components/stub/taf_pa_net
}

cflags:
{
    -I$LEGATO_ROOT/components/watchdogChain
}

sources:
{
    tafNetworkImpl.cpp
    tafNetworkSvc.cpp
    tafRoutingDns.cpp
    tafNatImpl.cpp
    tafVlanImpl.cpp
    tafL2tpImpl.cpp
    tafSocksImpl.cpp
    tafGsbImpl.cpp
}

