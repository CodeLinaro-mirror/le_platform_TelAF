DEFINE MAX_VERS_LEN = 256;

ENUM ImageType
{
    BOOT_IMG,
    SYSTEM_SQUASHFS,
    FIRMWARE,
    TELAF_SQUASHFS,
    TELAF_APP
};

ENUM State
{
    IDLE,
    DOWNLOAD_FAIL,
    DOWNLOADING,
    DOWNLAOD_PAUSED,
    DOWNLOAD_COMPLETE,
    INSTALLING,
    INSTALL_SUCCESS,
    PROBATION,
    RECOVERY,
    REPORTING
};

STRUCT StateInfo
{
    State state;
    int32 percent;
};

FUNCTION le_result_t Download
(
    ImageType type IN
);

FUNCTION le_result_t Install
(
);

FUNCTION le_result_t RebootToActive
(
);

FUNCTION le_result_t GetFirmwareVersion
(
    string version[MAX_VERS_LEN] OUT
);

FUNCTION le_result_t Sync
(
);

HANDLER StateHandler
(
    StateInfo stateInfo IN
);

EVENT State
(
    StateHandler handler
);