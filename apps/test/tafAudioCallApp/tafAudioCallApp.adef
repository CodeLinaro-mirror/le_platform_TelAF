requires:
{
    configTree:
    {
        [w] tafAudioCallApp
    }
}

executables:
{
    tafAudioCallApp = ( tafAudiocallComponent)
    audiocall = ( tafAudioctrlComponent )
}

processes:
{
    run:
    {
        ( tafAudioCallApp )
    }
}

start: auto
sandboxed: false

bindings:
{
    tafAudioCallApp.tafAudiocallComponent.taf_voicecall -> tafVoiceCallSvc.taf_voicecall
    tafAudioCallApp.tafAudiocallComponent.taf_audio -> tafAudioService.taf_audio
    audiocall.tafAudioctrlComponent.tafAudioCtrl -> tafAudioCallApp.tafAudiocallComponent.tafAudioCtrl
}
