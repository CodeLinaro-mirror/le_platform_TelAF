/**
 * WakeupNodeSourceRef for system wakeup.
 */
REFERENCE ws;

/**
 * WakeupNodeSourceRef for system wakeup.
 */
REFERENCE nodePowerState;

/**
 * NodeModemAwakeEventRef for node modem wakeup.
 */
REFERENCE NodeModemAwakeEvent;

/**
 * Handler for async shutdown request.
 *
 * @instaging
 *
 * @param[in] requestedMode Requested mode.
 * @param[in] responseMode  Request response.
 * @param[in] result        Request response result.
 * @param[in] contextPtr    Context pointer.
 */
HANDLER AsyncShutdownReqHandler
(
    ShutdownMode requestedMode IN,   ///< Requested mode.
    ResponseMode responseMode  IN,   ///< Request response.
    le_result_t result         IN    ///< Request response result.
);

/**
 * Restart request mode.
 */
ENUM RestartMode
{
    RESTART_SYSTEM_OFF_ON,   ///< Restart System.
    RESTART_MODE_NAD_REBOOT  ///< NAD Reboot
};

/**
 * Handler for async restart request.
 *
 * @instaging
 *
 * @param[in] restartMode  Restart mode.
 * @param[in] responseMode Request response.
 * @param[in] result       Request response result.
 * @param[in] contextPtr   Context pointer.
 */
HANDLER AsyncRestartReqHandler
(
    RestartMode restartMode   IN,    ///< Restart mode.
    ResponseMode responseMode IN,    ///< Request response.
    le_result_t result        IN     ///< Request response result.
);

/**
 * Handler for async Wake up Vehicle request.
 *
 * @instaging
 *
 * @param[in] reason     WakeupVehicleReason reason.
 * @param[in] status     Response status.
 * @param[in] result     Request response result.
 * @param[in] contextPtr Context pointer.
 */
HANDLER AsyncWakeupVehicleReqHandler
(
    int32 reason IN,    ///< WakeupVehicleReason reason.
    int32 status IN,     ///< Response status.
    le_result_t result IN     ///< Request response result.
);

/**
 * State indication structure.
 */
STRUCT StateInd
{
    State state;    ///< Power state.
};

/**
 * Handler for state change.
 *
 * @instaging
 *
 * @param[in] stateInd   The system state indication.
 * @param[in] contextPtr Context pointer.
 */
HANDLER StateChangeHandler
(
    StateInd stateInd IN  ///< The system state indication.
);

/**
 * State change event.
 *
 * @instaging
 */
EVENT StateChange
(
    StateChangeHandler handler  ///< The state change handler.
);

/**
 * Handler for information report.
 *
 * @instaging
 *
 * @param[in] report     The status report.
 * @param[in] contextPtr Context pointer.
 */
HANDLER InfoReportHandler
(
    int32 report     IN  ///< The status report.
);

/**
 * Information data report event.
 *
 * @instaging
 */
EVENT InfoReport
(
    InfoReportBitMask infoReportMask,  ///< Bit mask for the data report.
    InfoReportHandler handler    ///< The data report handler.
);

/**
 * Handler for node power state change.
 *
 * @instaging
 *
 * @param[in] pmNodeId   Node ID.
 * @param[in] ref        Node power state reference.
 * @param[in] state      Node power state.
 * @param[in] contextPtr Context pointer.
 */
HANDLER NodePowerStateChangeHandler
(
    uint8 pmNodeId IN,          ///< Node ID.
    nodePowerState ref IN,      ///< Node power state reference.
    NodePowerState state IN     ///< Node power state.
);

/**
 * State change event.
 *
 * @instaging
 */
EVENT NodePowerStateChange
(
    NodePowerStateChangeHandler handler,  ///< The state change handler.
    uint8 pmNodeId,
    NodePowerStateChangeBitMask bitmask
);

//--------------------------------------------------------------------------------------------------
/**
 * Handler for node modem awake.
 *
 * @instaging
 *
 * @param[in] ref        Node modem awake event reference.
 * @param[in] pmNodeId   Node ID.
 * @param[in] wsBitmask  Modem wakeup reason bitmask.
 * @param[in] contextPtr Context pointer.
 */
//--------------------------------------------------------------------------------------------------
HANDLER NodeModemAwakeHandler
(
    NodeModemAwakeEvent ref IN,        ///< Node modem awake event reference.
    uint8 pmNodeId IN,                 ///< Node ID.
    NodeModemWsBitMask wsBitmask IN    ///< Modem wakeup reason bitmask.
);

//--------------------------------------------------------------------------------------------------
/**
 * Node modem awake event.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
EVENT NodeModemAwake
(
    NodeModemAwakeHandler handler,  ///< The modem awake event handler.
    uint8 pmNodeId,
    NodeModemWsBitMask wsBitmask
);


//--------------------------------------------------------------------------------------------------
/**
 * Sets the targeted power mode for the node.
 * Node will initiate the requested power state once all wake sources are released.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sets the targeted power mode.
 *     - LE_BAD_PARAMETER  The given pmNodeId is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNodeTargetedPowerMode
(
    uint8 pmNodeId IN,               ///< The Node ID given.
    TargetedPowerMode powerMode IN   ///< The power mode to be set.
);

//--------------------------------------------------------------------------------------------------
/**
 * Forcefully shuts down the system.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ShutdownReqAsync
(
    ShutdownMode              requstedMode  IN,   ///< Requested mode.
    AsyncShutdownReqHandler   handlerRef    IN,   ///< Handler Reference.
    ShutdownReason            reason        IN    ///< Shutdown reason.
);

//--------------------------------------------------------------------------------------------------
/**
 * Forcefully restarts the system.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RestartReqAsync
(
    RestartMode             restartMode  IN,   ///< Restart mode.
    AsyncRestartReqHandler  handlerRef   IN,   ///< Handler reference.
    RestartReason            reason      IN    ///< Restart reason.
);

//--------------------------------------------------------------------------------------------------
/**
 * Request for the vehicle wakeup with wake up reason.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t WakeupVehicleReqAsync
(
    int32           reason  IN,   ///< WakeupVehicle Reason.
    AsyncWakeupVehicleReqHandler  handlerRef   IN    ///< AsyncWakeupVehicleReq Handler reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Creates a new wake lock reference.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION ws NewNodeWakeupSource (
    uint8 pmNodeId IN,               ///< The Node ID given.
    WakeupType  wakeupType IN,       ///< The wakeup type given.
    string vhalTag[WSREF_MAXLEN] IN  ///< The HAL tag information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the allowed Modem wakeup source type.
 * Currently the SMS, incoming call, and MCU_VHAL sources are supported to be set.
 *
 * @b NOTE: This API will be replaced by SetNodeModemWakeupSel soon.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid wakeupSource type.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetModemWakeupSource (
    uint32 wakeupSource IN       ///< The allowed wakeup sources bit map.
                                 ///< Bit 0 is for SMS, bit 1 is for incoming call, bit 2 is for MCU_VHAL.
);

//--------------------------------------------------------------------------------------------------
/**
 * Releases the acquired wake source.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RelaxNode (
    ws wsRef IN    ///< The wakesource reference ID given.
);

//--------------------------------------------------------------------------------------------------
/**
 * Acquires the wake source to keep the node awake.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StayAwakeNode(
    ws wsRef IN     ///< The wakesource reference ID given.
);

//--------------------------------------------------------------------------------------------------
/**
 * Initiates the forceful shutdown for the given node.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully shuts down for the given node.
 *     - LE_BAD_PARAMETER  The given pmNodeId is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ShutdownNode
(
    uint8 pmNodeId IN   ///< The Node ID given.
);

//--------------------------------------------------------------------------------------------------
/**
 * Initiates the forceful restart for the given node.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully restarts for the given node.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RestartNode
(
    uint8 pmNodeId IN   ///< The Node ID given.
);
//--------------------------------------------------------------------------------------------------
/**
 * Gets the status information report based on the given report ID.
 *
 * @instaging
 * @return
 *     - LE_OK             Succeed.
 *     - LE_BAD_PARAMETER  Invalid report ID.
 *     - LE_FAULT          No VHAL module detected.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetInfoReport
(
    InfoDataId reportId IN,  ///< The status report ID.
    int32 report  OUT      ///< The status report.
);
//--------------------------------------------------------------------------------------------------
/**
 * Sends the acknowledgement for the node power state change notification.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully restarts for the given node.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SendNodePowerStateChangeAck
(
    uint8 pmNodeId IN,   ///< The Node ID given.
    nodePowerState Ref,
    NodeClientAck ack
);

//--------------------------------------------------------------------------------------------------
/**
 * Authorize the StayAwake reasons with bit mask.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully authorize the StayAwake reason bitmask.
 *     - LE_BAD_PARAMETER  Invalid requested StayAwake reason bitmask.
 *     - LE_FAULT          Failed to Authorize StayAwake reason bitmask.
 */

//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t AuthorizeStayAwakeReason
(
     StayAwakeReasonBitMask stayAwakeReasonMask
);

//--------------------------------------------------------------------------------------------------
/**
 * Creates a new wake lock reference with given StayAwakeReason.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */

//--------------------------------------------------------------------------------------------------
FUNCTION ws CreateWakeupSource (
    StayAwakeReason reason IN,       ///< The wakeup type given.
    WsOpt option,
    string wsTag[WSREF_MAXLEN] IN  ///< The HAL tag information.
);

//--------------------------------------------------------------------------------------------------
/**
 * Releases the acquired wake source.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Relax (
    ws wsRef IN    ///< The wakesource reference ID given.
);

//--------------------------------------------------------------------------------------------------
/**
 * Acquires the wake source to keep the node awake.
 *
 * @instaging
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t StayAwake(
    ws wsRef IN     ///< The wakesource reference ID given.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the whitelisted modem wakeup selection.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNodeModemWakeupSel
(
    uint8 pmNodeId IN,               ///< The Node ID given.
    NodeModemWsBitMask wsBitmask     ///< Modem wakeup selection to be whitelisted.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the whitelisted modem wakeup selection.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNodeModemWakeupSel
(
    uint8 pmNodeId IN,                   ///< The Node ID given.
    NodeModemWsBitMask wsBitmask OUT     ///< Modem wakeup selection to be whitelisted.
);

//--------------------------------------------------------------------------------------------------
/**
 * Gets the last modem wakeup reason.
 *
 * @b NOTE: This is supported only on SA525M.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetNodeModemAwakeReason
(
    uint8 pmNodeId IN,                   ///< The Node ID given.
    NodeModemWsBitMask wsBitmask OUT     ///< Modem wakeup reason.
);

//--------------------------------------------------------------------------------------------------
/**
 * Deletes the given wake source.
 *
 * @instaging
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t DeleteWakeupSource
(
    ws wsRef IN     ///< The wakesource reference ID given.
);