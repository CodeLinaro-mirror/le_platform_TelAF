//--------------------------------------------------------------------------------------------------
/**
 * @page c_taf_mngd_pm Managed Power Management Service
 *
 * @ref taf_mngd_pm_interface.h "API Reference"
 *
 * <HR>
 *
 * The Managed Power Management service APIs help to manage power on the NAD/TCU.
 *
 * @section taf_mngd_pm_binding IPC interfaces binding
 *
 *
 * The following example illustrates how to bind to the Managed Power Management service.
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_mngd_pm -> tafMngdPMSvc.taf_mngd_pm
   }
   @endverbatim
 *
 * @section taf_mngd_pm Configuration
 *
 * Before starting the service, the user should place a JSON file named
 * tafMngdPMConfig.json into /data/ManagedServices directory. This JSON file contains the
 * configurations for trigger sources, e.g., CAN, SMS, and GPIO.
 *
 * The default configuration file is available at
 * /legato/systems/current/appsWriteable/tafMngdPMSvc/tafMngdPMConfig.json
 *
 * @section taf_mngd_pm_SetNadPowerState Set the power state of NAD
 *
 * TelAF Power Management Service provides APIs to set the power state of a given NAD device.
 * TelAF Power Management Service's client calls taf_mngd_pm_SetNadPowerState() to set the power
 * state of the machine.
 * @verbatim

    le_result_t res = taf_mngd_pm_SetNadPowerState(TAF_MNGD_PM_NAD1, TAF_MNGD_PM_SUSPEND);
    if (res == LE_OK) {
        LE_INFO("Successfully triggered suspend");
    }

   @endverbatim
 *
 * @section taf_mngd_pm_SetVMPowerState Set the power state for a particular Virtual Machine
 * in NAD
 *
 * TelAF Power Management Service provides APIs to set the power state of a particular Virtual
 * Machine.
 * TelAF Power Management Service's client calls taf_mngd_pm_SetVMPowerState() to set the power
 * state of the particular Virtual Machine. To get the available Virtual Machines, client calls
 * taf_pm_GetMachineList().
 *
 * @verbatim

    le_result_t res = taf_mngd_pm_SetVMPowerState(TAF_MNGD_PM_NAD1, "VMName",
            TAF_MNGD_PM_SUSPEND);

   @endverbatim
 *
 * @section taf_mngd_pm_GetVMPowerState Get the power state for a particular Virtual Machine
 * in NAD
 *
 * TelAF Power Management Service provides APIs to get the power state of a particular Virtual
 * Machine.
 * TelAF Power Management Service's client calls taf_mngd_pm_GetVMPowerState() to get the power
 * state of a particular Virtual Machine.
 * This function returns le_result_t and updates the state of the Virtual Machine.
 * @verbatim

    static char* StateToString(taf_mngd_pm_State_t *state)
    {
        switch (*state)
        {
            case TAF_MNGD_PM_STATE_RESUME:
                return "RESUME";
            case TAF_MNGD_PM_STATE_SUSPEND:
                return "SUSPEND";
            case TAF_MNGD_PM_STATE_SHUTDOWN:
                return "SHUTDOWN";
            default:
                LE_ERROR("unknown state");
                return "UNKNOWN";
        }
    }

    void Test_GetVMPowerState() {
        taf_mngd_pm_State_t state;
        le_result_t res = taf_mngd_pm_GetVMPowerState(TAF_MNGD_PM_NAD1, arg, &state);
        LE_INFO("state is %s", StateToString(state));
    }

   @endverbatim
 *
 * @section taf_mngd_pm_shutdown Shutdown the system forcefully
 *
 * TelAF Power Management Service's client calls taf_mngd_pm_ShutdownReqAsync() to shut down the
 * system forcefully.
 * This function returns le_result_t and updates the results through callback function reference
 * provided in the function call. This API will collaborate with the PM VHAL.
 * @verbatim

    void ForcedSystemShutdownCallBack(taf_mngd_pm_ShutdownMode_t mode,
        taf_mngd_pm_ResponseMode_t ResponseMode, void* contextPtr)
    {
        LE_INFO("ForcedSystemShutdownCallBack ");
    }

    void ForcedSystemShutdown()
    {
        le_result_t result = taf_mngd_pm_ShutdownReqAsync(TAF_MNGD_PM_SYSTEM_FORCEFUL_SHUTDOWN,
                ForcedSystemShutdownCallBack, NULL);

        if(result == LE_OK) {
            LE_INFO("Forcefull shutdown request sent successfully");
        }
    }

   @endverbatim
 *
 * @section taf_mngd_pm_restart Restart the system forcefully
 *
 * TelAF Power Management Service's client calls taf_mngd_pm_RestartReqAsync() to restart the
 * system forcefully.
 * This function returns le_result_t and updates the results through callback function reference
 * provided in the function call. This function also provides the ability to shut down the NAD on
 * receiving this restart request in case customer wants to wake up the NAD after power off. This
 * API will collaborate with the PM VHAL.
 * @verbatim

    void RestartCallback(taf_mngd_pm_RestartMode_t mode, taf_mngd_pm_ResponseMode_t rspmode,
            void* contextPtr)
    {
        LE_INFO(" RestartCallback ");
    }

    void RestartSystem()
    {
        le_result_t res = taf_mngd_pm_RestartReqAsync(TAF_MNGD_PM_RESTART_SYSTEM_OFF_ON,
                RestartCallback, NULL);
        if(result == LE_OK) {
            LE_INFO("Forcefull restart request sent successfully");
        }
    }
   @endverbatim
 * @section taf_mngd_pm_setTargetedMode Set the targeted power mode to the node
 *
 * TelAF Power Management Service's client calls taf_mngd_pm_SetNodeTargetedPowerMode() to set the
 * power mode of the node.
 * This function returns le_result_t and sets the targeted power mode of the node requested once
 * all the wake sources are released. This API will collaborate with the PM VHAL.
 * @verbatim

    // To set the targeted power mode of NAD to SHUT DOWN.
    void SetTargetedPowerMode()
    {
        result = taf_mngd_pm_SetNodeTargetedPowerMode(0,TAF_MNGD_PM_SHUTDOWN);
        if(result == LE_OK)
            LE_INFO("taf_mngd_pm_GracefulSysShutdownWakeLock triggered successfully");
    }
   @endverbatim
 *
 *<HR>
 *
 */
//--------------------------------------------------------------------------------------------------

/**
 * Maximum string length for the Virtual Machine name.
 */
DEFINE MACHINE_NAME_LEN = 32;

/*
 * ENUM for NADs.
 */
ENUM Nad{
    NAD1
};

/**
 * System power states.
 */
ENUM State
{
    STATE_UNKNOWN,       ///< Power state is unknown.
    STATE_RESUME,        ///< Power state is resume.
    STATE_SUSPEND,       ///< Power state is suspend.
    STATE_SHUTDOWN       ///< Power state is shutdown.
};

/**
 * Targeted power modes.
 */
ENUM TargetedPowerMode
{
    RESUME,            ///< Power mode is resume.
    SUSPEND,           ///< Power mode is suspend.
    SHUTDOWN           ///< Power mode is shutdown.
};

/**
 * Response mode for async requests.
 */
ENUM ResponseMode
{
    READY,           ///< Response is ready.
    NOT_READY,       ///< Response is not ready.
    TIMEOUT          ///< Response is timeout.
};

/**
 * Forceful shutdown request mode.
 */
ENUM ShutdownMode
{
    SYSTEM_FORCEFUL_SHUTDOWN     ///< System forceful shutdown.
};

/**
 * Handler for async shutdown request.
 */
HANDLER AsyncShutdownReqHandler
(
    ShutdownMode requestedMode IN,   ///< Requested mode.
    ResponseMode responseMode  IN    ///< Request response.
);

/**
 * Restart request mode.
 */
ENUM RestartMode
{
    RESTART_SYSTEM_OFF_ON    ///< Restart System.
};

/**
 * Handler for async restart request.
 */
HANDLER AsyncRestartReqHandler
(
    RestartMode restartMode   IN,    ///< Restart mode.
    ResponseMode responseMode IN     ///< Request response.
);

//--------------------------------------------------------------------------------------------------
/**
* Sets the power state of the given NAD.
*
* @return
*     - LE_OK             Successfully changed the state of device.
*     - LE_BAD_PARAMETER  Invalid state.
*     - LE_BUSY           The state transition request is in progress.
*     - LE_FAULT          Failed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNadPowerState
(
    Nad nad IN,                 ///< NAD power state to be changed.
    State state IN              ///< State to be set.
);

//--------------------------------------------------------------------------------------------------
/**
* Sets the power state to the respective Virtual Machine in the given NAD.
*
* @return
*     - LE_OK             Successfully changed the state of the Virtual Machine.
*     - LE_BAD_PARAMETER  The given Virtual Machine is not available in the mentioned NAD
*                         or the given state is invalid.
*     - LE_BUSY           The state transition request is in progress.
*     - LE_FAULT          Failed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetVMPowerState
(
    Nad nad IN,                                ///< NAD where the mentioned Virtual Machine is
                                               ///  available.
    string  vmName[MACHINE_NAME_LEN] IN,       ///< Virtual Machine name.
    State   state IN                           ///< State to be set.
);

//--------------------------------------------------------------------------------------------------
/**
* Gets the power state of the respective Virtual Machine in the given NAD.
*
* @return
*     - LE_OK            Success.
*     - LE_BAD_PARAMETER Invalid parameters.
*     - LE_FAULT         Failed.
*/
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetVMPowerState(
    Nad nad IN,                                 ///< NAD where the mentioned Virtual Machine is
                                                ///  available.
    string  vmName[MACHINE_NAME_LEN] IN,        ///< Virtual Machine name.
    State state OUT                             ///< State of the Virtual Machine.
);

//--------------------------------------------------------------------------------------------------
/**
 * Sets the targeted power mode for the node.
 * Node will initiate the requested power state once all wake sources are released.
 * @return
 *     - LE_OK             Successfully sets the targeted power mode.
 *     - LE_BAD_PARAMETER  The given pmNodeId is invalid.
 *     - LE_FAULT          Failed.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t SetNodeTargetedPowerMode
(
    uint8 pmNodeId IN,               ///< The Node ID given.
    TargetedPowerMode powerMode IN   ///< The power mode to be set.
);

//--------------------------------------------------------------------------------------------------
/**
 * Forcefully shuts down the system.
 *
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t ShutdownReqAsync
(
    ShutdownMode              requstedMode  IN,   ///< Requested mode.
    AsyncShutdownReqHandler   handlerRef    IN    ///< Handler Reference.
);

//--------------------------------------------------------------------------------------------------
/**
 * Forcefully restarts the system.
 *
 * @return
 *     - LE_OK             Successfully sent the request.
 *     - LE_BAD_PARAMETER  Invalid requested mode or handler reference.
 *     - LE_FAULT          Failed to send the request.
 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t RestartReqAsync
(
    RestartMode             restartMode  IN,   ///< Restart mode.
    AsyncRestartReqHandler  handlerRef   IN    ///< Handler reference.
);