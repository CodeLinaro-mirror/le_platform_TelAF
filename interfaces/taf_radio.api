    PDP_ERROR_UNKNOWN_PDP,                 ///< PDP was unknown.
    PDP_ERROR_REASON_NOT_SPECIFIED,        ///< Reason not specified.
    PDP_ERROR_CONNECTION_BRINGUP_FAILURE,  ///< Connection bring-up failure.
