sandboxed: false

capability:
{
        CAP_WAKE_ALARM
        CAP_BLOCK_SUSPEND
}

executables:
{
    tafCanSvc = ( $TELAF_ROOT/components/tafVNW/tafCanSvc )
}

start: auto

processes:
{
    run:
    {
        (tafCanSvc)
    }

    faultAction: restart
}

bindings:
{
}

extern:
{
    tafCanSvc.tafCanSvc.taf_can
}
