maxThreads: 600

username: telaf

startGroup: 22

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_BIND_SERVICE
    CAP_NET_ADMIN
    CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
    CAP_DAC_READ_SEARCH
    CAP_DAC_OVERRIDE
#endif
}

groups:
{
    system
    diag
    radio
    inet
    locclient
}

sandboxed: false

executables:
{
    tafDevInfoSvc = ( $TELAF_ROOT/components/tafDevInfoSvc )
}

start: auto

processes:
{
    run:
    {
        (tafDevInfoSvc)
    }

    maxCoreDumpFileBytes: 100000K
    maxFileBytes: 100000K
    faultAction: restart
}

bindings:
{
}

extern:
{
    tafDevInfoSvc.tafDevInfoSvc.taf_devInfo
}
