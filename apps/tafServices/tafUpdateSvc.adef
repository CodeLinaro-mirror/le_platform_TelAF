sandboxed: false

maxMemoryBytes: 60000K

executables:
{
    tafUpdateSvc = ( $TELAF_ROOT/components/tafUpdateSvc )
}

start: auto

requires :
{
    configTree:
    {
        [r] system
    }
}

processes:
{
    run:
    {
        (tafUpdateSvc)
    }

    maxFileBytes: 1048576K
    faultAction: restart
}

bindings:
{
    tafUpdateSvc.tafUpdateSvc.taf_dcs -> tafDataCallSvc.taf_dcs
#if ${TARGET} = sa515m
    tafUpdateSvc.tafUpdateSvc.taf_mrc -> tafMRCSvc.taf_mrc
#endif
    tafUpdateSvc.tafUpdateSvc.le_update -> <root>.le_update
    tafUpdateSvc.tafUpdateSvc.le_updateCtrl -> <root>.le_updateCtrl
    tafUpdateSvc.tafUpdateSvc.le_cfg -> <root>.le_cfg
    tafUpdateSvc.tafUpdateSvc.le_appCtrl -> <root>.le_appCtrl
    tafUpdateSvc.tafUpdateSvc.le_appInfo -> <root>.le_appInfo
    tafUpdateSvc.tafUpdateSvc.le_appRemove -> <root>.le_appRemove
}

extern:
{
    tafUpdateSvc.tafUpdateSvc.taf_update
    tafUpdateSvc.tafUpdateSvc.taf_appMgmt
    tafUpdateSvc.tafUpdateSvc.taf_fwupdate
}
