/**
 * @page c_tafaudio Audio Service
 *
 * @rst :ref:`API reference <File taf_audio_interface.h>` @endrst
 *
 * <HR>
 * The Audio service APIs provide an interface to playback and record audio.
 * TelAf audio is connector based and audio connectors have one input and output interface, which
 * is responsible for routing audio data.
 *
 * The audio stream reference represents the audio interfaces for the given connectors.
 *
 * For any stream types the maximum number of supported devices is one. A single stream for multiple
 * devices is not supported.
 *
 * For example, for a voice call audio path, MIC and SPEAKER connectors are required, but in lower
 * layers the audio stream is closely coupled, so once the stream type is set to to VOICE both the
 * MIC and SPEAKER are configured.
 *
 * @section taf_audio_binding IPC interfaces binding
 *
 * All functions of this API are provided by the @b tafAudioSvc application service.
 *
 * The following example shows how to bind to the audio service.
 *
 * In application.adef add the taf_audio API in bindings.

 * @verbatim

   bindings:
   {
      clientExe.clientComponent.taf_audio -> tafAudioService.taf_audio
   }

   @endverbatim

 * In Component.cdef add the taf_audio interface.

 * @verbatim

   requires:
   {
    api:
    {
      taf_audio.api
    }
   }

   @endverbatim
 *
 *
 * @section c_taf_audio_play Audio playback
 *
 * To do playback of audio with a supported format (such as .wav / .amr), the following APIs
 * should be called in sequence.
 *
 * @verbatim

   OutRef = taf_audio_OpenSpeaker();
   LE_ERROR_IF((NULL == OutRef), "taf_audio_OpenSpeaker returns NULL!");

   OutputConnectorRef  = taf_audio_CreateConnector();
   LE_ERROR_IF((NULL == OutputConnectorRef), "OutputConnectorRef  is NULL!");

   FileRef = taf_audio_OpenPlayer();
   LE_ERROR_IF((NULL == FileRef), "OpenFilePlayback returns NULL!");

   @endverbatim
 *
 * @subsection c_taf_audio_AddMediaHandler MediaHandler and Media Events
 *
 * Handler for media events, such as error and media end.
 *
 * @verbatim

   MediaHandlerRef = taf_audio_AddMediaHandler(FileRef, MediaEventHandler, NULL);

   @endverbatim

 * @subsection c_connectors Connector and open file from location
 *
 * @verbatim

   res = taf_audio_Connect(OutputConnectorRef, OutRef);
   LE_ERROR_IF((LE_OK != res), "Failed on Output connector (res %s)!", LE_RESULT_TXT(res));

   res = taf_audio_Connect(OutputConnectorRef , FileRef);
   LE_ERROR_IF((LE_OK != res), "Playback failed on input connector!");

   if ((FileFd = open(FilePath, O_RDONLY)) == -1)
   {
       LE_ERROR("Open file %s failure: errno.%d (%s)", FilePath, errno, LE_ERRNO_TXT(errno));
       taf_audio_Disconnect(OutputConnectorRef, OutRef);
       taf_audio_Disconnect(OutputConnectorRef, FileRef);
       taf_audio_DeleteConnector(OutputConnectorRef);
       taf_audio_Close(OutRef);
       taf_audio_Close(FileRef);

       return LE_FAULT;
   }

   @endverbatim
 *
 * @subsection c_Play Play file from location
 *
 * @verbatim

   res = taf_audio_PlayFile(FileRef, FileFd);

   LE_ERROR_IF((LE_OK != res), "Playback failed...!");

   @endverbatim
 *
 * @subsection c_Mute_and_Unmute Mute and Unmute
 *
 * @verbatim

   // Mute and UnMute can be called only on active stream
   res = taf_audio_Mute(FileRef);
   res = taf_audio_Unmute(FileRef);

   @endverbatim
 *
 * @subsection c_Close_auio_playback Close and Delete connectors
 *
 * Delete and close the connectors when finished.
 *
 * @verbatim

   taf_audio_Disconnect(OutputConnectorRef, OutRef);
   taf_audio_Disconnect(OutputConnectorRef, FileRef);
   taf_audio_DeleteConnector(OutputConnectorRef);
   taf_audio_Close(OutRef);
   taf_audio_Close(FileRef);

   @endverbatim
 *
 * @section c_taf_audio_voicecall Audio voice call
 *
 * @subsection c_ECNR Echo Cancellation and Noise Reduction
 * This needs to be called before starting a voice call.
 *
 * EnableNoiseSuppressor and EnableEchoCanceller API's are handled in a single configuration.
 *
 * @verbatim

   if (LE_OK != (res = taf_audio_EnableNoiseSuppressor(AudioRef)))
   {
       LE_ERROR("Set EnableNoiseSuppressor failed (res.%d)", res);
   }

   if (LE_OK != ((res = taf_audio_EnableEchoCanceller(AudioRef)))
   {
       LE_ERROR("Set EnableEchoCanceller failed! (res.%d)", res);
   }

   @endverbatim
 *
 *
 * DisableEchoCanceller and DisableNoiseSuppressor APIs are handled in a single configuration.
 * This needs to be called before starting a voice call.
 *
 * @verbatim

   if (LE_OK != ((res = taf_audio_DisableEchoCanceller(AudioRef)))
   {
       LE_ERROR(" DisableEchoCanceller failed! (res.%d)", res);
   }

   if (LE_OK != ((res = taf_audio_DisableNoiseSuppressor(AudioRef)))
   {
       LE_ERROR(" DisableNoiseSuppressor failed! (res.%d)", res);
   }
   @endverbatim

 *
 * For a voice call, the OpenModemVoiceRx API with the slot ID should be called in sequence as shown in the
 * following example.
 *
 * @verbatim

   RxMdmRef = taf_audio_OpenModemVoiceRx(1);
   LE_ERROR_IF(( NULL == RxMdmRef), "taf_audio_OpenModemVoiceRx returns NULL!");

   OutRef = taf_audio_OpenSpeaker();
   LE_ERROR_IF((NULL == OutRef), "taf_audio_OpenSpeaker returns NULL!");

   @endverbatim
 *
 * @b NOTE: This also needs to be called for a voice call on SA525M device.
 *
 * @verbatim

   TxMdmRef = taf_audio_OpenModemVoiceTx(1);
   LE_ERROR_IF(( NULL == TxMdmRef), "taf_audio_OpenModemVoiceTx returns NULL!");

   InRef = taf_audio_OpenMic();
   LE_ERROR_IF((NULL == InRef), "taf_audio_OpenMic returns NULL!");

   @endverbatim

 * @subsection c_connectors_oncallhold Connector and open file from location when call is on hold
 * When a voice call is on hold there will be local file playback of audio.
 *
 * @verbatim

   OutputConnectorRef = taf_audio_CreateConnector();
   LE_ERROR_IF((NULL == OutputConnectorRef), "OutputConnectorRef is NULL!");

   taf_audio_Connect(OutputConnectorRef, OutRef);
   @endverbatim
 *
 * @b NOTE: This needs to be called when a voice call is on hold.
 *
 * @verbatim
   if ((FileFd = open(FilePath, O_RDONLY)) == -1)
   {
       LE_ERROR_IF((LE_OK != res), "Playback failed...!");
       return LE_FAULT;
   }
   res = taf_audio_PlayFile(FileRef, FileFd);

   LE_ERROR_IF((LE_OK != res), "Playback failed...!");

   @endverbatim

 *
 * @subsection c_Close Close and Delete connectors
 *
 * Delete and close the connectors when finished.
 *
 * @verbatim
   taf_audio_Disconnect(OutputConnectorRef, OutRef);
   taf_audio_Disconnect(OutputConnectorRef, FileRef);
   taf_audio_DeleteConnector(OutputConnectorRef);
   taf_audio_Close(OutRef);
   taf_audio_Close(FileRef);

   @endverbatim
 *
 * @section c_taf_audio_record Audio capture
 *
 * To capture audio in PCM format with 16 bits per sample resolution, the following APIs
 * should be called in sequence.
 *
 * @verbatim

   InRef = taf_audio_OpenMic();
   LE_ERROR_IF((NULL == InRef), "taf_audio_OpenMic returns NULL!");

   InputConnectorRef  = taf_audio_CreateConnector();
   LE_ERROR_IF((NULL == InputConnectorRef), "InputConnectorRef  is NULL!");

   FileRef = taf_audio_OpenRecorder();
   LE_ERROR_IF((NULL == FileRef), "OpenRecorder returns NULL!");

   res = taf_audio_Connect(InputConnectorRef, InRef);
   LE_ERROR_IF(res != LE_OK, "Failed to connect Mic on Input connector!");

   res = taf_audio_Connect(InputConnectorRef , FileRef);
   LE_ERROR_IF(res != LE_OK, "Failed to connect FileRecorder on input connector!");

   // Default channel number is 1, and records on LEFT channel.
   //Set to 2 for both LEFT & RIGHT channels
   res = taf_audio_SetSamplePcmChannelNumber(FileAudioRef, 2);
   LE_ERROR_IF(res != LE_OK, "Failed to set the channel number!");

   int AudioFileFd=open(AudioFilePath, O_CREAT | O_WRONLY, S_IRUSR | S_IWUSR);

   if(AudioFileFd != -1) {
       res = taf_audio_RecordFile(FileRef, AudioFileFd);
       LE_ERROR_IF(res != LE_OK, "Failed to record the file!");
   }

   @endverbatim
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------

/**
 * Reference type for audio stream.
 */
REFERENCE Stream;

/**
 * Reference type for audio connector.
 */
REFERENCE Connector;

DEFINE DTMF_MAXLEN   = (100);
DEFINE NO_FD = (-1);

/**
 * Closes the stream reference.
 */
FUNCTION Close
(
    Stream sRef IN ///< Audio stream reference.
);

/**
 * Creates a new connector.
 * @return Reference to the audio stream, NULL on error.
 */
FUNCTION Connector CreateConnector
(
);

/**
 * Deletes a connected connector.
 * @b NOTE: This function will not return if passed a bad reference.
 */
FUNCTION DeleteConnector
(
    Connector connRef IN ///< Connector reference.
);

/**
 * Connects a connector for an audio stream reference.
 * @return
 * - LE_OK Success.
 * - LE_FAULT  Failure.
 *
 * @b NOTE: This function will not return if passed a bad reference.
 */
FUNCTION le_result_t Connect
(
    Connector connRef IN, ///< Connector reference.
    Stream    sRef IN ///< Audio stream reference.
);

/**
 * Disconnects a connector for an audio stream reference.
 *
 * @b NOTE: This function will not return if passed a bad reference.
 */
FUNCTION Disconnect
(
    Connector connRef IN, ///< Connector reference.
    Stream    sRef IN ///< Audio stream reference.
);

/**
 * Opens an audio stream reference for speaker use.
 *
 * @return Reference to the audio stream, NULL on error.
 */
FUNCTION Stream OpenSpeaker
(
);

/**
 * Opens an audio stream reference for microphone use.
 *
 * @return Reference to an audio stream, NULL on error.
 */
FUNCTION Stream OpenMic
(
);

/**
 * Opens an audio stream reference for voice Rx.
 *
 * @return Reference to an audio stream, NULL on error.
 */
FUNCTION Stream OpenModemVoiceRx
(
uint32 slotId ///< Slot value
);

/**
 * Opens an audio stream reference for voice Tx.
 *
 * @return Reference to an audio stream, NULL on error.
 */
FUNCTION Stream OpenModemVoiceTx
(
uint32 slotId ///< Slot value.
);

/**
 * DTMF playback for inband.
 *
 * @b NOTE: Applicable only for voice streams.
 */
FUNCTION le_result_t PlayDtmf
(
    Stream  streamRef           IN, ///< Audio stream reference.
    string  dtmf[DTMF_MAXLEN]   IN, ///< DTMF data.
    uint32  duration            IN, ///< Duration to play.
    uint32  pause               IN  ///< Pause between tones.
);

/**
 * Mutes an audio stream.
 *
 * @return
 * - LE_OK    Success.
 * - LE_FAULT Failure.
 */
FUNCTION le_result_t Mute
(
    Stream streamRef IN ///< Audio stream reference.
);

/**
 * Unmutes an audio stream.
 *
 * @return
 * - LE_OK     Success.
 * - LE_FAULT  Failure.
 */
FUNCTION le_result_t Unmute
(
    Stream streamRef IN ///< Audio stream reference.
);

/**
 * Audio recording/playback events.
 */
ENUM MediaEvent
{
    MEDIA_ENDED,             ///< End of playback.
    MEDIA_NO_MORE_SAMPLES,   ///< End of sample.
    MEDIA_ERROR,             ///< Error notification.
    MEDIA_MAX                ///< Indicates the maximum value.
};

/**
 * Opens a stream for audio playback.
 *
 * @return Reference to an audio stream, NULL on error.
 */
FUNCTION Stream OpenPlayer
(
);

/**
* Plays a file on a playback stream.
*
* @return
* - LE_FAULT         Failure.
* - LE_BAD_PARAMETER Invalid stream reference.
* - LE_BUSY          Already active.
* - LE_OK            Success.
*/
FUNCTION le_result_t PlayFile
(
    Stream streamRef IN, ///< Audio stream reference.
    file fd  IN          ///< File descriptor.
);

/**
 * Opens the audio stream for recording.
 *
 * @return Reference to an audio stream, NULL on error.
 */
FUNCTION Stream OpenRecorder
(
);

/**
* Records a file on the recorder stream.
*
* @return
* - LE_FAULT         Failure.
* - LE_BAD_PARAMETER Invalid stream reference.
* - LE_BUSY          Already active.
* - LE_OK            Success.
*/
FUNCTION le_result_t RecordFile
(
    Stream streamRef IN, ///< Audio stream reference.
    file fd  IN          ///< File descriptor.
);

/**
 * Handler for audio stream event.
 */
HANDLER MediaHandler
(
    Stream     streamRef  IN, ///< Audio stream reference.
    MediaEvent event          ///< Media event parameters.
);

/**
 * This event provides information on player/recorder stream events.
 */
EVENT Media
(
    Stream       streamRef IN, ///< Audio stream reference.
    MediaHandler handler       ///< Media handler.
);

/**
 * Handler for DTMF decoding.
 */
HANDLER DtmfDetectorHandler
(
    Stream  streamRef  IN, ///< Audio stream reference.
    char    dtmf       IN  ///< DTMF detection.
);

/**
 * This event provides information on DTMF decoding for the specified streamRef.
 */
EVENT DtmfDetector
(
    Stream              streamRef IN, ///< Audio stream reference.
    DtmfDetectorHandler handler       ///< DTMF Handler.
);

/**
 * Stops the file playback or recording.
 *
 * @return
 * - LE_OK     Success.
 * - LE_FAULT  Failure.
 */
FUNCTION le_result_t Stop
(
    Stream streamRef IN ///< Audio stream reference.
);

/**
 * Sets the volume.
 *
 * @return
 * - LE_FAULT Failure.
 * - LE_OK    Success.
*/
FUNCTION le_result_t SetGain
(
    Stream streamRef IN, ///< Audio stream reference.
    int32  gain IN       ///< Set gain parameter.
);

/**
 * Gets the volume.
 *
 * @return
 * - LE_FAULT Failure.
 * - LE_OK    Success.
 */
FUNCTION le_result_t GetGain
(
    Stream streamRef IN, ///< Audio stream reference.
    int32  gain OUT ///< Gain parameter.
);

/**
 * Audio format.
 */
ENUM Format
{
    WAVE,          ///< Waveform.
    AMR,           ///< Adaptive multi rate.
    FORMAT_MAX     ///< Indicates the maximum value.
};

/**
 * AMR .
 */
ENUM AmrMode
{
    AMR_NONE,                ///< No modes
    AMR_NB_4_75_KBPS,        ///< 4.75 kbps
    AMR_NB_5_15_KBPS,        ///< 5.15 kbps
    AMR_NB_5_9_KBPS,         ///< 5.9  kbps
    AMR_NB_6_7_KBPS,         ///< 6.7  kbps
    AMR_NB_7_4_KBPS,         ///< 7.4  kbps
    AMR_NB_7_95_KBPS,        ///< 7.95 kbps
    AMR_NB_10_2_KBPS,        ///< 10.2 kbps
    AMR_NB_12_2_KBPS,        ///< 12.2 kbps
    AMR_WB_6_6_KBPS,         ///< 6.6  kbps
    AMR_WB_8_85_KBPS,        ///< 8.85 kbps
    AMR_WB_12_65_KBPS,       ///< 12.65 kbps
    AMR_WB_14_25_KBPS,       ///< 14.25 kbps
    AMR_WB_15_85_KBPS,       ///< 15.85 kbps
    AMR_WB_18_25_KBPS,       ///< 18.25 kbps
    AMR_WB_19_85_KBPS,       ///< 19.85 kbps
    AMR_WB_23_05_KBPS,       ///< 23.05 kbps
    AMR_WB_23_85_KBPS        ///< 23.85 kbps
};

/**
 * Enables noise suppression.
 *
 * @return
 * - LE_FAULT  Failure.
 * - LE_OK     Success.
*/
FUNCTION le_result_t EnableNoiseSuppressor
(
    Stream streamRef IN ///< Audio stream reference.
);

/**
 * Enables echo cancellation.
 *
 * @return
 * - LE_FAULT  Failure.
 * - LE_OK     Success.
*/
FUNCTION le_result_t EnableEchoCanceller
(
    Stream streamRef IN ///< Audio stream reference.
);

/**
 * Disables noise suppression.
 *
 * @return
 * - LE_FAULT  Failure.
 * - LE_OK     Success.
*/
FUNCTION le_result_t DisableNoiseSuppressor
(
    Stream streamRef IN ///< Audio stream reference.
);

/**
 * Sets the volume.
 *
 * @return
 * - LE_FAULT  Failure.
 * - LE_OK     Success.
*/
FUNCTION le_result_t DisableEchoCanceller
(
    Stream streamRef IN ///< Audio stream reference.
);

/**
 * Gets echo cancellation status.
 *
 * @return
 * - LE_FAULT  Failure.
 * - LE_OK     Success.
*/
FUNCTION le_result_t IsEchoCancellerEnabled
(
    Stream streamRef IN, ///< Audio stream reference.
    bool   status    OUT ///< Check for EchoCanceller flag.
);

/**
 * Gets noise suppression status.
 *
 * @return
 * - LE_FAULT  Failure.
 * - LE_OK     Success.
*/
FUNCTION le_result_t IsNoiseSuppressorEnabled
(
    Stream streamRef IN, ///< Audio stream reference.
    bool   status    OUT ///< Check for NoiseSuppressor flag.
);

//--------------------------------------------------------------------------------------------------
/**
 * I2S channel mode.
 */
//--------------------------------------------------------------------------------------------------
ENUM I2SChannel
{
    I2S_LEFT,     ///< Left channel.
    I2S_RIGHT,    ///< Right channel.
    I2S_MONO,     ///< Mono mode.
    I2S_STEREO,   ///< Stereo mode.
    I2S_REVERSE   ///< Reverse mode (left and right reversed).
};

/**
 * Opens an audio stream reference for I2S Rx interface use.
 *
 * @b NOTE: Set the sampling rate using taf_audio_SetSamplePcmSamplingRate after creating the stream
 *       reference and before connecting, otherwise the defalut sampling rate will be 16000.
 *
 * @return Reference to the audio stream, NULL on error.
 */
FUNCTION Stream OpenI2sRx
(
    I2SChannel mode  IN ///< The channel mode.
);

/**
 * Opens an audio stream reference for I2S Tx interface use.
 *
 * @b NOTE: Set the sampling rate using taf_audio_SetSamplePcmSamplingRate after creating the stream
 *       reference and before connecting, otherwise the defalut sampling rate will be 16000.
 *
 * @return Reference to the audio stream, NULL on error.
 */
FUNCTION Stream OpenI2sTx
(
    I2SChannel mode  IN ///< The channel mode.
);

/**
 * Opens an audio stream reference for PCM Rx interface use.
 *
 * @b NOTE: Set the sampling rate using taf_audio_SetSamplePcmSamplingRate after creating the stream
 *       reference and before connecting, otherwise the defalut sampling rate will be 16000.
 *
 * @return Reference to the audio stream, NULL on error.
 */
FUNCTION Stream OpenPcmRx
(
    uint32 timeslot  IN ///< The time slot number.
);

/**
 * Opens an audio stream reference for PCM Tx interface use.
 *
 * @b NOTE: Set the sampling rate using taf_audio_SetSamplePcmSamplingRate after creating the stream
 *       reference and before connecting, otherwise the defalut sampling rate will be 16000.
 *
 * @return Reference to the audio stream, NULL on error.
 */
FUNCTION Stream OpenPcmTx
(
    uint32 timeslot  IN ///< The time slot number.
);

/**
 * Sets the sampling rate of a stream reference.
 *
 * @return
 * - LE_OK            Succeeded.
 * - LE_FAULT         Failed.
 */
FUNCTION le_result_t SetSamplePcmSamplingRate
(
    Stream      streamRef   IN,     ///< Audio stream reference.
    uint32      rate        IN      ///< Sampling rate.
);

/**
 * Gets the sampling rate of the stream reference.
 *
 * @return
 * - LE_FAULT         Failed.
 * - LE_OK            Function succeeded.
 */
FUNCTION le_result_t GetSamplePcmSamplingRate
(
    Stream      streamRef   IN,     ///< Audio stream reference.
    uint32      rate        OUT     ///< Sampling rate.
);

/**
 * Sets the channel number for the stream reference.
 *
 * @return
 * - LE_FAULT         Failed.
 * - LE_OK            Succeeded.
 */
FUNCTION le_result_t SetSamplePcmChannelNumber
(
    Stream      streamRef IN,       ///< Audio stream reference.
    uint32      nbChannel IN        ///< Channel number.
);

/**
 * Gets the channel number of the recorder stream reference.
 *
 * @return
 * - LE_FAULT         Failed.
 * - LE_OK            Succeeded.
 */
FUNCTION le_result_t GetSamplePcmChannelNumber
(
    Stream      streamRef   IN,     ///< Audio stream reference.
    uint32      nbChannel   OUT     ///< Channel number.
);

/**
 * Sets the encoding format of a recorder stream reference.
 *
 * @return
 * - LE_FAULT         Failed.
 * - LE_OK            Succeeded.
 */
FUNCTION le_result_t SetEncodingFormat
(
    Stream          streamRef   IN,     ///< Audio stream reference.
    Format          format      IN      ///< Encoding format.
);

/**
 * Gets the encoding format of a recorder stream reference.
 *
 * @return
 * - LE_FAULT         Failed.
 * - LE_OK            Succeeded.
 *
 * @b NOTE: A client calling this function with either an invalid
 * streamRef or null out pointer parameter will be killed and the
 * function will not return.
 */
FUNCTION le_result_t GetEncodingFormat
(
    Stream          streamRef   IN,     ///< Audio stream reference.
    Format          format      OUT     ///< Encoding format.
);