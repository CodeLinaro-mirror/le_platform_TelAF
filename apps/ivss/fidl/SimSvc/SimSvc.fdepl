import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "platform:/plugin/org.genivi.commonapi.core/deployment/CommonAPI-4_deployment_spec.fdepl"
import "SimSvc.fidl"

define org.genivi.commonapi.core.deployment for typeCollection com.qualcomm.qti.telephony.SimSvcTypes
{
    enumeration PhoneIdT
    {
        EnumBackingType = UInt8
    }

    enumeration TelephonyResultT
    {
        EnumBackingType = UInt8
    }

    enumeration SimStateT
    {
        EnumBackingType = UInt8
    }

    enumeration ValueState
    {
        EnumBackingType = UInt8
    }
}

define org.genivi.commonapi.someip.deployment for interface com.qualcomm.qti.telephony.SimSvc
{
    SomeIpServiceID = 0xED81

    broadcast SimState
    {
        SomeIpEventID = 33169
        SomeIpEventGroups = { 33169 }
    }

    method GetImsi
    {
        SomeIpMethodID = 401
    }

    method GetState
    {
        SomeIpMethodID = 402
    }

    method GetIccid
    {
        SomeIpMethodID = 403
    }
}

define org.genivi.commonapi.someip.deployment for provider as Service
{
    instance com.qualcomm.qti.telephony.SimSvc
    {
        InstanceId = "telephony.SimSvc"

        SomeIpInstanceID = 1
    }
}