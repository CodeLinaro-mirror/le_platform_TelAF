maxThreads: 600
sandboxed: false
executables:
{
    tafECallIntTest = ( $TELAF_ROOT/apps/test/tafECallTest/tafECallIntTest/tafECallIntTestComponent )
}


processes:
{
    run:
    {
        ( tafECallIntTest )
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafECallIntTest.tafECallIntTestComponent.taf_ecall -> tafECallSvc.taf_ecall
    tafECallIntTest.tafECallIntTestComponent.taf_gnss -> tafLocationSvc.taf_gnss
    tafECallIntTest.tafECallIntTestComponent.taf_pos -> tafLocationSvc.taf_pos
    tafECallIntTest.tafECallIntTestComponent.taf_posCtrl -> tafLocationSvc.taf_posCtrl
}

