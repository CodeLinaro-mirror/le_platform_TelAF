    {
        le_appInfo.api
    }

    lib:
    {
        libComponent_taf_pa_keystore.so
        libComponent_taf_pa_keystoreDef.so
    }
}

provides:
{
    api:
    {
        taf_ks.api [manual-start]
    }
}
