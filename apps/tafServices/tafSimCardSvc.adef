sandboxed: false

executables:
{
        tafSimCardSvc = ( $TELAF_ROOT/components/tafSimCardSvc )
}
start: manual

processes:
{
        run:
        {
                (tafSimCardSvc)
        }

        faultAction: restart

        #if ${LE_CONFIG_SERVICES_WATCHDOG} = y
                maxWatchdogTimeout: 100000
        #else
                watchdogTimeout: never
        #endif
}

bindings:
{
}

extern:
{
        tafSimCardSvc.tafSimCardSvc.taf_sim
}

