API_VERSION = 1;
SERVING_VERSION = 1;

FUNCTION le_result_t MyCmd
(
    uint8 secs  IN         // Requested delay in seconds
) = 0;

HANDLER MyHdlr
(
    string evtMsg[100] IN  // Event message
);

EVENT MyEvt
(
    MyHdlr hdlr            // Registered handler
) = (1,2);

