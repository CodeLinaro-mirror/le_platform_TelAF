maxThreads: 600

username: telaf
startGroup: 20

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND
}

groups:
{
        system
        diag
        radio
        inet
        locclient
        shutdown
}

executables:
{
        tafMngdPMSvc = ( $TELAF_ROOT/apps/tafMngdServices/PM/Components/tafMngdPMSvc )
}

start: manual

processes:
{
        run:
        {
                (tafMngdPMSvc)
        }

        maxFileBytes: 8192K
        faultAction: stopApp
}

sandboxed: false

bindings:
{
    tafMngdPMSvc.tafMngdPMSvc.taf_pm -> tafPMSvc.taf_pm
    tafMngdPMSvc.tafMngdPMSvc.taf_gpio -> tafGpioSvc.taf_gpio
    tafMngdPMSvc.tafMngdPMSvc.taf_can -> tafCanSvc.taf_can
    tafMngdPMSvc.tafMngdPMSvc.taf_sms -> tafSMSSvc.taf_sms
    tafMngdPMSvc.tafMngdPMSvc.le_appInfo -> <root>.le_appInfo
    tafMngdPMSvc.tafMngdPMSvc.taf_rpcPm -> <telaf>.rpcServer_102_telaf_taf_pm
}

bundles:
{
    file:
    {
        [rw]    $TELAF_ROOT/apps/tafMngdServices/PM/Components/tafMngdPMSvc/config/tafMngdPMConfig.json   /
        [rw]    $TELAF_ROOT/apps/tafMngdServices/PM/Components/tafMngdPMSvc/config/tafMngdPMSvc.json   /
    }
}

// Directory in which configuration JSONs will be installed
requires:
{
    dir:
    {
        /data/ManagedServices /
    }
}

extern:
{
    tafMngdPMSvc.tafMngdPMSvc.taf_mngdPm
}
