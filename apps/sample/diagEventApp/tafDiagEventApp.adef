sandboxed: false
executables:
{
    tafDiagEventApp = ( diagEventAppComp )
}


processes:
{
    run:
    {
        (tafDiagEventApp)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }

    maxFileBytes: 8192K
}

start: manual

bindings:
{
    tafDiagEventApp.diagEventAppComp.taf_diagEvent -> tafDiagSvc.taf_diagEvent
    tafDiagEventApp.diagEventAppComp.taf_diagDTC -> tafDiagSvc.taf_diagDTC
    tafDiagEventApp.diagEventAppComp.taf_diag -> tafDiagSvc.taf_diag
}
