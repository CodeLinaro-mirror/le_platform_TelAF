username: telaf
maxThreads: 600
sandboxed: false
executables:
{
    tafeCallTest = ( tafeCallUnitTestComp )
}


processes:
{
    run:
    {
        (tafeCallTest)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafeCallTest.tafeCallUnitTestComp.taf_ecall -> tafECallSvc.taf_ecall
    tafeCallTest.tafeCallUnitTestComp.taf_radio -> tafRadioSvc.taf_radio
}

