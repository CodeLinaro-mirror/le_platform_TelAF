EXPORT_SYM uint32_t get_authentication_timeout()
{
    if (diagConf.auth_anti_conf.empty())
    {
        LE_ERROR("empty auth_anti_conf, return default value(60 seconds)");
        return 60; //Default value
    }
    // The struct member is 'int', so we cast it to the required 'uint32_t'.
    return static_cast<uint32_t>(diagConf.auth_anti_conf.begin()->second.delayTimerInvokingValueInit);
}


