sources:
{
    tafFSCrypt.c
}

cflags:
{
    -I${LEGATO_ROOT}/framework/liblegato
    -I$TELAF_PA_DEFAULT/include/keyStore
    -I$TELAF_PA_DEFAULT/include
}

requires:
{
    api:
    {
        taf_ks.api
    }

    lib:
    {
        libComponent_taf_pa_fscrypt.so
        libComponent_taf_pa_fscryptDef.so
    }
}

provides:
{
    api:
    {
        taf_fsc.api
    }
}

ldflags:
{
   -lssl
   -lcrypto
   -L$TELAF_DEFAULT_PA_LIB_DIR/lib
}
