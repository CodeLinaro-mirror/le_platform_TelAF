maxThreads: 300
groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafRadioSvc = ( $TELAF_ROOT/components/tafRadioSvc )
}

start: auto

processes:
{
    run:
    {
        (tafRadioSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
    tafRadioSvc.tafRadioSvc.taf_pm -> tafPMSvc.taf_pm
}

extern:
{
    tafRadioSvc.tafRadioSvc.taf_radio
}
