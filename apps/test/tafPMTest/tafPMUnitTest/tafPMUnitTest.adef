maxThreads: 600
sandboxed: false
executables:
{
    tafPMUnitTest = ( tafPMUnitTestComp )
}

processes:
{
    run:
    {
        proc1 = (tafPMUnitTest --proc1)
        proc2 = (tafPMUnitTest --proc2)
        proc3 = (tafPMUnitTest --proc3)
        proc4 = (tafPMUnitTest --proc4)
        proc5 = (tafPMUnitTest --proc5)
    }
    envVars:
    {
        LE_LOG_LEVEL = DEBUG
    }
}

start: manual

bindings:
{
    tafPMUnitTest.tafPMUnitTestComp.taf_pm -> tafPMSvc.taf_pm
}