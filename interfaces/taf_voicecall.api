//--------------------------------------------------------------------------------------------------
/**
 * @page c_tafvoicecall Voice Call Service
 *
 * @ref taf_voicecall_interface.h "API Reference"
 *
 * <HR>
 *
 * A voice call is needed for applications that want to establish a voice communication with
 *  a remote party.  The voice call can be over a mobile network, or over VoIP.
 *
 * @section taf_voicecall_binding IPC interfaces binding
 *
 * All the functions of this API are provided by the @b tafVoiceCallSvc application service.
 *
 * Here's a sample of how to bind to Voice Call services:
 * @verbatim
   bindings:
   {
       clientExe.clientComponent.taf_voicecall -> tafVoiceCallSvc.taf_voicecall
   }
   @endverbatim
 *
 * @section c_taf_vaoicecall_outgoing Starting a voice call
 *
 * A voice call can be started by using taf_voicecall_Start() with the destination identifier and sim slot No. passed as
 * parameters.
 * @verbatim
   myTafCallRef = taf_voicecall_Start(DestinationNum, Slot);
   if (!myTafCallRef)
   {
      res = taf_voicecall_GetEndCause(myTafCallRef, &reason);
      LE_ASSERT(res == LE_OK);
      LE_INFO("taf_voicecall_GetEndCause %d", reason);
      return LE_FAULT;
   }
   @endverbatim
 *
 * Before the voice call is started, an application registers a state handler using
 * taf_voicecall_AddStateHandler(). Once the voice call is established, the handler will be called
 *  indicating it's now connected. If the state of the voice call changes, then the handler will be
 *  called with the new state.
 * @verbatim
   tafVoiceCallHandlerRef = taf_voicecall_AddStateHandler((taf_voicecall_StateHandlerFunc_t)MyCallEventHandler, NULL);
   @endverbatim
 *
 * To hang up a voice call, an application can use taf_voicecall_End().
 *
 * Application must use taf_voicecall_Delete() to release @ref taf_voicecall_CallRef_t voice call
 *  reference object when it is no more used.
 *
 * <HR>
 *
 */
//--------------------------------------------------------------------------------------------------


USETYPES taf_types.api;

/**
 * use the one returned from start defined in le_voicecall.api
 */

REFERENCE Call;

/**
 * To support Legacy EVENT
 */
DEFINE EVENT_CONNECTED = 2 ;
DEFINE EVENT_TERMINATED = 3;
DEFINE EVENT_BUSY = 5;

/**
 * To support Legacy TERM
 */
DEFINE TERM_NETWORK_FAIL = 1 ;
DEFINE TERM_BAD_ADDRESS = 2 ;
DEFINE TERM_BUSY = 3 ;
DEFINE TERM_LOCAL_ENDED = 4 ;
DEFINE TERM_REMOTE_ENDED = 5 ;
DEFINE TERM_UNDEFINED = 6 ;

ENUM Event
{
    EVENT_ALERTING = 1,             ///< Alerting call, MO only
    EVENT_ACTIVE = 2 ,              ///< Active Call,Map to leagcy Connected
    EVENT_ENDED = 3 ,               ///< Call End
    EVENT_OFFLINE = 4 ,             ///< Not support
    EVENT_WAITING = 5,              ///< Waitingall, Map to leagcy busy
    EVENT_RESOURCE_BUSY = 6,        ///< Not support
    EVENT_CALL_END_FAILED = 7,      ///< Not support
    EVENT_CALL_ANSWER_FAILED = 8,   ///< Not support
    EVENT_INCOMING = 9,             ///< Incoming Call, not answered yet
    EVENT_ONHOLD = 10,              ///< On hold call
    EVENT_DIALING = 11,             ///< MO Call, dialing
    EVENT_CALL_HOLD_FAILED = 12,    ///< Not support
    EVENT_CALL_RESUME_FAILED = 13,  ///< Not support
};

ENUM CallEndCause
{
    END_NORMAL = 0,                 ///< Call Normal End
    END_NETWORK_FAIL = 1,           ///< Map to legacy NW FAIL
    END_UNOBTAINABLE_NUMBER = 2,    ///< Map to Legacy BAD ADDR
    END_BUSY = 3,                   ///< Remote busy
    END_LOCAL = 4,                  ///< Not supported
    END_REMOTE = 5,                 ///< Not supported
    END_UNDEFINED = 6,              ///< End cause undefined for telAF
    END_REJECTED = 7,               ///< Call get rejected,
    END_NORESPONSE = 8,             ///< remote no response

};


//-------------------------------------------------------------------------------------------------
/**
 * New APIs Avaiable in TelAF services.
 */
//-------------------------------------------------------------------------------------------------

/*
 * The user event handler
 */
HANDLER StateHandler
(
    Call reference IN,
    string identifer[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN,
    Event event IN
);

EVENT State
(
    StateHandler handler
);

//--------------------------------------------------------------------------------------------------
/**
 * Start a call according to given phone number and slot id.
 *
 * @return
 *      - Reference to the voice call
 *      - NULL if the voice call can not be processed
 */
 //--------------------------------------------------------------------------------------------------
FUNCTION Call Start
(
    string destinationID[taf_types.REMOTE_PARTY_NUM_MAX_BYTES] IN, ///< Destination phone number for
                                                                   ///< the call establishment
    uint8 phoneId                                                  ///< SIM slot id
);

//--------------------------------------------------------------------------------------------------
/**
 * Stop a call according to given reference ID.
 *
 * @return
 *      - LE_OK         on success
 *      - Others        Failure
 */
 //--------------------------------------------------------------------------------------------------
FUNCTION le_result_t End
(
    Call reference IN                                              ///< The call reference
);

//--------------------------------------------------------------------------------------------------
/**
 * Delete a call according to given call reference.
 *
 * @return
 *      - LE_OK         on success
 *      - Others        Failure
 */
 //--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Delete
(
    Call reference IN                                              ///< The call reference
);

//--------------------------------------------------------------------------------------------------
/**
 * Answer a incoming call. The call reference can be got from call state handler.
 *
 * @return
 *      - LE_OK         on success
 *      - Others        Failure
 */
 //--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Answer
(
    Call reference IN                                              ///< The call reference
);

//--------------------------------------------------------------------------------------------------
/**
 * Get the call end reason according to call reference. This call should be in END state.
 * The call should be on idle state when calling this API.
 *
 * @return
 *      - LE_OK         on success
 *      - Others        Failure
 */
 //--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetEndCause
(
    Call reference IN,                                             ///< The call reference
    CallEndCause cause OUT                                         ///< The end cause enumeration
);

//--------------------------------------------------------------------------------------------------
/**
 * Hold the active call. This call should be in ACTIVE state.
 *
 * @return
 *      - LE_OK         on success
 *      - Others        Failure
 */
 //--------------------------------------------------------------------------------------------------
FUNCTION le_result_t Hold
(
    Call reference IN                                              ///< The call reference
);

//--------------------------------------------------------------------------------------------------
/**
 * Resume the holding call. This call should be in HOLD state.
 *
 * @return
 *      - LE_OK         on success
 *      - Others        Failure
 */
 //--------------------------------------------------------------------------------------------------

FUNCTION le_result_t Resume
(
    Call reference IN                                              ///< The call reference
);


