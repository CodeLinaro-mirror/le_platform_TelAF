 */
//--------------------------------------------------------------------------------------------------
FUNCTION le_result_t GetPciScanMccMnc
(
    PlmnInformation plmnRef IN,   ///< PLMN information reference.
    string mccPtr[MCC_BYTES] OUT, ///< MCC.
    string mncPtr[MNC_BYTES] OUT  ///< MNC.
);

