policy_module(tafMngdConnSvc, 1.0)

# Framework definition for telaf
type telaf_tafMngdConnSvc_exec_t;
files_type(telaf_tafMngdConnSvc_exec_t);

type telaf_tafMngdConnSvc_t;

type telaf_tafMngdConnSvc_data_t;
files_type(telaf_tafMngdConnSvc_data_t);

init_telaf_app_domain(telaf_tafMngdConnSvc_t,telaf_tafMngdConnSvc_exec_t)

ifdef(`sa525m',`
    allow telaf_tafMngdConnSvc_exec_t telaf_admin_t:lnk_file {read};
')

# Allow update daemon to install/uninstall this service
telaf_admin_manage_all_files_perms(telaf_tafMngdConnSvc_data_t)
telaf_admin_manage_all_files_perms(telaf_tafMngdConnSvc_exec_t)

