maxThreads: 300

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND
}

groups:
{
        system
        diag
        radio
        inet
        locclient
}

sandboxed: false

executables:
{
    tafVoiceCallSvc = ( $TELAF_ROOT/components/tafVoiceCallSvc )
}

start: auto

processes:
{
    run:
    {
        (tafVoiceCallSvc)
    }

    maxFileBytes: 8192K
    faultAction: restart
}

bindings:
{
}

extern:
{
    tafVoiceCallSvc.tafVoiceCallSvc.taf_voicecall
}
