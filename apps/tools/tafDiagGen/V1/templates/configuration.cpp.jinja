}

EXPORT_SYM const SecurityLevel&
get_security_level(uint32_t did,
                    const std::string& session_name,
                    const std::string& direction)   // "R", "W" or "IO"
{
    const DiagnosticSession& ds = get_diagnostic_session(did, session_name);

    const std::map<std::string, SecurityLevel>* map_ptr = nullptr;

    if (direction == "R")  map_ptr = &ds.R;
    else if (direction == "W") map_ptr = &ds.W;
    else if (direction == "IO") map_ptr = &ds.IO;
    else {
        std::string msg = "Invalid direction \"" + direction + "\" – must be R, W or IO";
        LE_WARN("%s", msg.c_str());
        throw std::runtime_error(msg);
    }

    if (map_ptr->empty())
    {
        std::string msg = "No security‑level defined for direction " + direction +
                          " in session \"" + session_name + "\" (DID 0x" +
                          std::to_string(did) + ")";
        LE_WARN("%s", msg.c_str());
        throw std::runtime_error(msg);
    }

    return map_ptr->begin()->second;
}

EXPORT_SYM std::vector<std::string> get_roles_for_pattern(const std::string& pattern_name)
{
    std::vector<std::string> roles;
    try
    {
        const auto& pattern_entry = diagConf.exec_auth_pattern.at(pattern_name);

        if (pattern_entry.base) roles.push_back("base");
        if (pattern_entry.did_read_app) roles.push_back("did_read_app");
        if (pattern_entry.secured_configuration) roles.push_back("secured_configuration");
        if (pattern_entry.did_write) roles.push_back("did_write");
        if (pattern_entry.io_control) roles.push_back("io_control");
        if (pattern_entry.routine_control) roles.push_back("routine_control");
        if (pattern_entry.expert_read) roles.push_back("expert_read");

    }
    catch (const std::out_of_range& e)
    {
        LE_WARN("Execution authorization pattern '%s' not found.", pattern_name.c_str());
    }
    return roles;
}

