(
    uint8 enable OUT,       ///< Enable(1) or Disable(0)
    uint8 enabled911 OUT,   ///< enabled911 enable(1) or Disable(0)
    uint8 majorVersion OUT, ///< major version number
    uint8 minorVersion OUT  ///< minor version number
);

