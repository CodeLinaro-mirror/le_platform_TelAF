maxThreads: 600

username: telaf

startGroup: 2

groups:
{
        system
        diag
        radio
        inet
        locclient
}

capability:
{
        CAP_WAKE_ALARM
        CAP_NET_BIND_SERVICE
        CAP_NET_ADMIN
        CAP_BLOCK_SUSPEND

#if ${LE_CONFIG_TEST_COVERAGE} = y
        CAP_DAC_READ_SEARCH
        CAP_DAC_OVERRIDE
#endif
}

executables:
{
        tafAudioSvc = ( $TELAF_ROOT/components/tafAudioSvc )
}

start: auto

processes:
{
        run:
        {
                (tafAudioSvc)
        }

        maxFileBytes: 8192K
        faultAction: restart
}

sandboxed: false

bindings:
{
}

extern:
{
        tafAudioSvc.tafAudioSvc.taf_audio
}
