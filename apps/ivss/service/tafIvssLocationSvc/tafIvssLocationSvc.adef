maxThreads: 600
sandboxed: false

start: manual

username: telaf

capability:
{
    CAP_WAKE_ALARM
    CAP_NET_RAW
    CAP_IPC_LOCK
    CAP_SYS_NICE
    CAP_SYS_RESOURCE
    CAP_NET_ADMIN
#if ${LE_CONFIG_TEST_COVERAGE} = y
    CAP_DAC_READ_SEARCH
    CAP_DAC_OVERRIDE
#endif
}

executables:
{
    tafIvssLocationSvc = ( locationSvc )
}

processes:
{
    envVars:
    {
        VSOMEIP_CONFIGURATION = vsomeipRef.json
        COMMONAPI_CONFIG = commonapiRef.ini
    }

    run:
    {
        ( tafIvssLocationSvc )
    }
    maxFileBytes: 8192K
}

bindings:
{
    tafIvssLocationSvc.locationSvc.taf_locGnss -> tafLocationSvc.taf_locGnss
    tafIvssLocationSvc.locationSvc.taf_locPos -> tafLocationSvc.taf_locPos
    tafIvssLocationSvc.locationSvc.taf_locPosCtrl -> tafLocationSvc.taf_locPosCtrl
}
