/**
 * Maximum message size
 */
DEFINE MAX_MSG_SIZE = (276);

/**
* Minimum message size
*/
DEFINE MIN_MSG_SIZE = (200);

/**
 *  Handler to get notification for specific messages when there is updates
 *  from the modem.
 */
HANDLER MessageHandler
(
    uint8 message[MAX_MSG_SIZE]
);

/**
 * Callback to get result for sent message.
 */
HANDLER CallbackHandler
(
    uint8 messageId     IN,
    le_result_t result  IN
);

/**
 * Event to notify and send a message
 */
EVENT Message
(
    MessageHandler handler
);

/**
 * To send message to service which inturn sends commands to modem
 *
 *  LE_OK             Message sent successfully.
 *  LE_BAD_PARAMETER  Length of message is too long
 *
 */
FUNCTION le_result_t SendMessage
(
    uint8 message[MAX_MSG_SIZE]     IN,
    CallbackHandler callback        IN
);
